From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Fri, 5 Sep 2026 01:20:00 -0500
Subject: [PATCH] catalystwan: expose the vEdge Cloud certificate authority

---
diff --git a/plugins/modules/administration_settings.py b/plugins/modules/administration_settings.py
--- a/plugins/modules/administration_settings.py
+++ b/plugins/modules/administration_settings.py
@@ -206,6 +206,7 @@
 
 from catalystwan.endpoints.configuration_settings import (
     Certificate,
+    VEdgeCloud,
     Device,
     OnOffMode,
     Organization,
@@ -248,6 +249,22 @@
                 port=dict(type="str"),
             ),
         ),
+        vedge_cloud=dict(
+            # The VIRTUAL-edge certificate authority, which is a DIFFERENT
+            # setting from `certificates` above. `certificates` governs the
+            # CONTROLLERS (vManage/vBond/vSmart); this one governs vEdge Cloud
+            # devices, and vManage keeps them independently -- measured on a
+            # live 20.18.4 fabric whose controllers were already 'enterprise'
+            # while this still read 'cisco'.
+            type="dict",
+            aliases=["vedge_cloud_certificate_authorization"],
+            options=dict(
+                certificate_authority=dict(
+                    type="str",
+                    choices=["cisco", "manual", "enterprise"],
+                ),
+            ),
+        ),
         certificates=dict(
             type="dict",
             aliases=["cca", "controler_certificate_authorization"],
@@ -313,6 +330,7 @@
     modify_vbond = False
     modify_org = False
     modify_certificates = False
+    modify_vedge_cloud = False
     modify_enterprise_root_ca = False
     modify_smart_account_credentials = False
     modify_pnp_sync = False
@@ -359,6 +377,15 @@
         ).single_or_default()
         modify_certificates = True if certificates_data != certificates_payload else False
 
+    if module.params.get("vedge_cloud"):
+        vedge_cloud_payload = VEdgeCloud(
+            certificateauthority=module.params.get("vedge_cloud").get("certificate_authority")
+        )
+        vedge_cloud_data = module.get_response_safely(
+            module.session.endpoints.configuration_settings.get_vedge_cloud
+        ).single_or_default()
+        modify_vedge_cloud = True if vedge_cloud_data != vedge_cloud_payload else False
+
     if module.params.get("enterprise_root_ca"):
         if not HAS_ENTERPRISE_ROOT_CA_ENDPOINT:
             module.fail_json(
@@ -431,6 +458,15 @@
             response_key="certificates",
         )
 
+    if modify_vedge_cloud:
+        module.send_request_safely(
+            result,
+            action_name="Administration Settings: vEdge Cloud Certificate Authorization",
+            send_func=module.session.endpoints.configuration_settings.edit_vedge_cloud,
+            payload=vedge_cloud_payload,
+            response_key="vedge_cloud",
+        )
+
     if modify_enterprise_root_ca:
         module.send_request_safely(
             result,
-- 
2.51.0
