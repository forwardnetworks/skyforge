+
+{% for vs in loadbalancer.virtual_servers | default([]) %}
+slb virtual-server {{ vs.name }} {{ vs.vip }}
+{%   if vs.advertise | default(false) %}
+  redistribution-flagged
+{%   endif %}
+  port {{ vs.port }} {{ vs.protocol | default('tcp') }}
+    service-group {{ vs.pool }}
+{% endfor %}
diff --git a/netsim/ansible/templates/ospf/a10.j2 b/netsim/ansible/templates/ospf/a10.j2
new file mode 100644
index 0000000..ef48b47
--- /dev/null
+++ b/netsim/ansible/templates/ospf/a10.j2
@@ -0,0 +1,21 @@
+router ospf {{ ospf.process | default(1) }}
+{% if ospf.router_id is defined %}
+  router-id {{ ospf.router_id }}
+{% endif %}
+{% for intf in netlab_interfaces | default([]) if intf.ospf is defined and intf.ipv4 is defined %}
+  network {{ intf.ipv4 | ansible.utils.ipaddr('subnet') }} area {{ intf.ospf.area | default('0.0.0.0') }}
+{%   if intf.ospf.passive | default(false) %}
+  passive-interface ethernet {{ intf.ifindex }}
+{%   endif %}
+{% endfor %}
+{#
+    VIP redistribution. ACOS injects a VIP into a routing protocol only when
+    the protocol redistributes `vip`; `only-flagged` limits that to virtual
+    servers marked redistribution-flagged, which the loadbalancer template
+    renders from loadbalancer.virtual_servers[].advertise. Keyed off the same
+    attribute so the two halves cannot disagree.
+#}
+{% set _lb_vs = loadbalancer.virtual_servers|default([]) if loadbalancer is defined else [] %}
+{% if _lb_vs | selectattr('advertise','defined') | selectattr('advertise') | list %}
+  redistribute vip only-flagged
+{% endif %}
diff --git a/netsim/ansible/templates/ospf/panos.j2 b/netsim/ansible/templates/ospf/panos.j2
new file mode 100644
index 0000000..15d25c9
--- /dev/null
+++ b/netsim/ansible/templates/ospf/panos.j2
@@ -0,0 +1,68 @@
+{# PAN-OS OSPFv2, phase-2 of routing/panos.j2's phase-1 bootstrap note: the
+   virtual-router/protocol/ospf config tree, pushed as `set` commands the same
+   way every other panos template in this directory does (deploy-config/panos.yml
+   SSHes in, enters `configure`, pastes the rendered lines, `commit`s). Every
+   path segment below matches PAN-OS's own set-command convention 1:1 with its
+   XML config tree (network virtual-router <vr> protocol ospf ...), verified
+   against a real PAN-OS OSPF capture (configuration.txt) rather than guessed:
+   router-id / enable / area <id> type normal / area <id> interface <name>
+   enable / passive / metric / priority / hello-interval / dead-interval. #}
+{% set vr = panos_virtual_router | default('default') %}
+set network virtual-router {{ vr }} protocol ospf router-id {{ ospf.router_id }}
+set network virtual-router {{ vr }} protocol ospf enable yes
+{# Default-route knobs, rendered only when set (PAN-OS defaults:
+   reject-default-route yes, allow-redist-default-route no). Seed:
+   sjc-dc1in-panos-fw1 `ospf { reject-default-route no; }`, atl-dc1in-panos-fw1
+   additionally `allow-redist-default-route yes`. #}
+{% if ospf.reject_default_route is defined %}
+set network virtual-router {{ vr }} protocol ospf reject-default-route {{ 'yes' if ospf.reject_default_route else 'no' }}
+{% endif %}
+{% if ospf.allow_redist_default_route is defined %}
+set network virtual-router {{ vr }} protocol ospf allow-redist-default-route {{ 'yes' if ospf.allow_redist_default_route else 'no' }}
+{% endif %}
+{% for area_data in ospf.areas | default([]) %}
+set network virtual-router {{ vr }} protocol ospf area {{ area_data.area }} type normal
+{% endfor %}
+{% for intf in netlab_interfaces if intf.ospf.area is defined %}
+set network virtual-router {{ vr }} protocol ospf area {{ intf.ospf.area }} interface {{ intf.ifname }} enable yes
+set network virtual-router {{ vr }} protocol ospf area {{ intf.ospf.area }} interface {{ intf.ifname }} passive {{ 'yes' if intf.ospf.passive | default(false) else 'no' }}
+{% if intf.ospf.cost is defined %}
+set network virtual-router {{ vr }} protocol ospf area {{ intf.ospf.area }} interface {{ intf.ifname }} metric {{ intf.ospf.cost }}
+{% endif %}
+{% if intf.ospf.priority is defined %}
+set network virtual-router {{ vr }} protocol ospf area {{ intf.ospf.area }} interface {{ intf.ifname }} priority {{ intf.ospf.priority }}
+{% endif %}
+{% if intf.ospf.timers.hello is defined %}
+set network virtual-router {{ vr }} protocol ospf area {{ intf.ospf.area }} interface {{ intf.ifname }} hello-interval {{ intf.ospf.timers.hello }}
+{% endif %}
+{% if intf.ospf.timers.dead is defined %}
+set network virtual-router {{ vr }} protocol ospf area {{ intf.ospf.area }} interface {{ intf.ifname }} dead-interval {{ intf.ospf.timers.dead }}
+{% endif %}
+{% endfor %}
+{# Redistribution (ospf.import). PAN-OS models it as a virtual-router
+   redist-profile (source type, destination filter, priority, action) named by
+   protocol ospf export-rules (external path type), as in a real PAN-OS capture:
+     redist-profile P { filter { type static; destination [ ... ] } priority N; action { redist } }
+     ospf export-rules P { new-path-type ext-2 }
+   An import policy maps onto one profile: the permit entries' match.prefix
+   lists become the destination filter, and the first entry's sequence the
+   priority. Deny entries, and matches other than a prefix list, have no
+   redist-profile equivalent. With no policy, the profile has no destination
+   filter and redistributes every route of that type. #}
+{% for s_proto, s_data in ospf.import|default({})|dictsort if s_proto == 'static' %}
+{%   set pname = s_data.policy|default('nlo-' ~ s_proto) %}
+{%   set entries = routing.policy[s_data.policy]|default([]) if s_data.policy is defined else [] %}
+{%   set dests = [] %}
+{%   for e in entries if e.action|default('permit') == 'permit' and e.match.prefix is defined %}
+{%     for pe in routing._prefix.ipv4[e.match.prefix]|default([]) if pe.action|default('permit') == 'permit' and pe.ipv4 is defined %}
+{%       set _ = dests.append(pe.ipv4) %}
+{%     endfor %}
+{%   endfor %}
+set network virtual-router {{ vr }} protocol redist-profile {{ pname }} filter type {{ s_proto }}
+{%   if dests %}
+set network virtual-router {{ vr }} protocol redist-profile {{ pname }} filter destination [ {{ dests|join(' ') }} ]
+{%   endif %}
+set network virtual-router {{ vr }} protocol redist-profile {{ pname }} priority {{ entries[0].sequence|default(10) if entries else 10 }}
+set network virtual-router {{ vr }} protocol redist-profile {{ pname }} action redist
+set network virtual-router {{ vr }} protocol ospf export-rules {{ pname }} new-path-type ext-2
+{% endfor %}
