diff --git a/netsim/ansible/library/panos_admpwd_kne.py b/netsim/ansible/library/panos_admpwd_kne.py
new file mode 100644
index 0000000..cb6d8df
--- /dev/null
+++ b/netsim/ansible/library/panos_admpwd_kne.py
@@ -0,0 +1,349 @@
+#!/usr/bin/python
+from __future__ import annotations
+
+import os
+import pty
+import re
+import select
+import signal
+import time
+
+from ansible.module_utils.basic import AnsibleModule
+
+
+DOCUMENTATION = r'''
+---
+module: panos_admpwd_kne
+short_description: Promote PAN-OS admin password through a KNE runtime SSH endpoint
+description:
+  - Changes the PAN-OS admin password through the runtime SSH endpoint exposed by the KNE provider.
+  - This is used when PAN-OS is exposed through a Kubernetes NodePort and the upstream panos_admpwd module cannot target a non-default SSH port.
+options:
+  host:
+    description: KNE runtime host for the PAN-OS SSH endpoint.
+    required: true
+    type: str
+  port:
+    description: KNE runtime SSH port for the PAN-OS endpoint.
+    required: true
+    type: int
+  username:
+    description: PAN-OS admin username.
+    required: false
+    default: admin
+    type: str
+  old_password:
+    description: Factory password accepted by the first-login password-change prompt.
+    required: false
+    default: admin
+    type: str
+  new_password:
+    description: Desired password for the admin account.
+    required: true
+    type: str
+  key_filename:
+    description: SSH private key file used for first-login authentication when password auth is unavailable.
+    required: false
+    type: str
+  timeout:
+    description: Maximum seconds to wait for the positive password-changed signal.
+    required: false
+    default: 180
+    type: int
+author:
+  - The platform
+'''
+
+
+PROMPT_BYTES = 4096
+
+
+def scrub(text: str, *secrets: str) -> str:
+  for secret in secrets:
+    if secret:
+      text = text.replace(secret, '********')
+  return text
+
+
+def send(master: int, value: str) -> None:
+  os.write(master, (value + '\n').encode())
+
+
+def ssh_argv(module: AnsibleModule) -> list:
+  """The ssh invocation both the probe and the promotion use, so they cannot
+  drift in transport options — only in which password they answer with."""
+  port = int(module.params['port'])
+  key_filename = str(module.params.get('key_filename') or '').strip()
+  preferred_auth = 'publickey,keyboard-interactive,password' if key_filename else 'keyboard-interactive,password'
+  cmd = [
+    'ssh',
+    '-tt',
+    '-p', str(port),
+    '-o', f'PreferredAuthentications={preferred_auth}',
+    '-o', 'KbdInteractiveAuthentication=yes',
+    '-o', 'NumberOfPasswordPrompts=3',
+    '-o', f'PubkeyAuthentication={"yes" if key_filename else "no"}',
+    '-o', 'StrictHostKeyChecking=no',
+    '-o', 'UserKnownHostsFile=/dev/null',
+    '-o', 'HostKeyAlgorithms=+ssh-rsa',
+    '-o', 'LogLevel=ERROR',
+  ]
+  if key_filename:
+    cmd += ['-o', 'IdentitiesOnly=yes', '-i', key_filename]
+  cmd.append(f'{module.params["username"]}@{module.params["host"]}')
+  return cmd
+
+
+def already_promoted(module: AnsibleModule) -> tuple:
+  """Is the admin password ALREADY the configured one?
+
+  THIS IS WHAT MAKES THE MODULE IDEMPOTENT, and its absence is why refreshing
+  a lab from its template failed on every PAN-OS host after the first build.
+  The promotion below authenticates with old_password, which is the FACTORY
+  default. That works exactly once per device: after it succeeds the device's
+  password IS new_password, so every later run failed to log in, never saw the
+  "Password changed" signal, and fail_json'd. A task that can only ever succeed
+  once is not a task, it is a one-shot, and a nightly refresh would have gone
+  red on those hosts every night forever.
+
+  So ask the device its state before trying to change it: log in with the
+  password we WANT. Reaching a CLI prompt means the promotion already happened
+  and there is nothing to do. Being asked to change the password means we are
+  still on the factory credential and the promotion must run.
+
+  Returns (promoted, transcript). Any ambiguity returns False so the caller
+  falls through to the real promotion — this probe may never turn a broken
+  device into a reported success.
+  """
+  timeout = min(int(module.params['timeout']), 60)
+  new_password = module.params['new_password']
+  username = module.params['username']
+
+  pid, master = pty.fork()
+  if pid == 0:
+    # Exec the program ssh_argv NAMES rather than a second hard-coded 'ssh'.
+    # One source for both the program and its arguments is what lets a test
+    # point this at a scripted endpoint instead of a real appliance.
+    argv = ssh_argv(module)
+    os.execvp(argv[0], argv)
+
+  transcript = ''
+  sent_login = False
+  promoted = False
+  deadline = time.time() + timeout
+  try:
+    while time.time() < deadline:
+      wait_pid, _ = os.waitpid(pid, os.WNOHANG)
+      if wait_pid == pid:
+        break
+      ready, _, _ = select.select([master], [], [], 0.25)
+      if not ready:
+        continue
+      try:
+        chunk = os.read(master, PROMPT_BYTES).decode(errors='replace')
+      except OSError:
+        break
+      if not chunk:
+        continue
+      transcript += chunk
+      tail = transcript[-2048:]
+
+      if re.search(r'(?i)are you sure you want to continue connecting', tail):
+        send(master, 'yes')
+        continue
+      if re.search(r'(?i)(?:login|username)\s*:\s*$', tail):
+        send(master, username)
+        continue
+      # A forced-change dialog means we are still on the factory password.
+      # Answer nothing and leave: the promotion path owns that conversation.
+      if re.search(r'(?:Enter old password|Current password)\s*:', tail, re.I):
+        break
+      if not sent_login and re.search(r'password\s*:', tail, re.I):
+        send(master, new_password)
+        sent_login = True
+        continue
+      if sent_login and re.search(r'(?m)[>#]\s*$', tail):
+        promoted = True
+        send(master, 'exit')
+        break
+      if re.search(r'(?i)permission denied|authentication fail', tail):
+        break
+  finally:
+    try:
+      os.close(master)
+    except OSError:
+      pass
+    try:
+      os.kill(pid, signal.SIGTERM)
+    except ProcessLookupError:
+      pass
+    try:
+      os.waitpid(pid, 0)
+    except (ChildProcessError, OSError):
+      pass
+
+  return promoted, scrub(transcript, module.params['old_password'], new_password)
+
+
+def promote_password(module: AnsibleModule) -> tuple[bool,str]:
+  host = module.params['host']
+  port = int(module.params['port'])
+  username = module.params['username']
+  old_password = module.params['old_password']
+  new_password = module.params['new_password']
+  key_filename = str(module.params.get('key_filename') or '').strip()
+  timeout = int(module.params['timeout'])
+  preferred_auth = 'publickey,keyboard-interactive,password' if key_filename else 'keyboard-interactive,password'
+
+  cmd = [
+    'ssh',
+    '-tt',
+    '-p', str(port),
+    '-o', f'PreferredAuthentications={preferred_auth}',
+    '-o', 'KbdInteractiveAuthentication=yes',
+    '-o', 'NumberOfPasswordPrompts=3',
+    '-o', f'PubkeyAuthentication={"yes" if key_filename else "no"}',
+    '-o', 'StrictHostKeyChecking=no',
+    '-o', 'UserKnownHostsFile=/dev/null',
+    '-o', 'HostKeyAlgorithms=+ssh-rsa',
+    '-o', 'LogLevel=ERROR',
+  ]
+  if key_filename:
+    cmd += ['-o', 'IdentitiesOnly=yes', '-i', key_filename]
+  cmd.append(f'{username}@{host}')
+
+  pid, master = pty.fork()
+  if pid == 0:
+    os.execvp(cmd[0],cmd)
+
+  transcript = ''
+  sent_login = False
+  sent_old = False
+  sent_new = False
+  sent_confirm = False
+  changed = False
+  exited = False
+  deadline = time.time() + timeout
+
+  try:
+    while time.time() < deadline:
+      wait_pid,_ = os.waitpid(pid,os.WNOHANG)
+      if wait_pid == pid:
+        break
+
+      ready,_,_ = select.select([master],[],[],0.25)
+      if not ready:
+        continue
+
+      try:
+        chunk = os.read(master,PROMPT_BYTES).decode(errors='replace')
+      except OSError:
+        break
+      if not chunk:
+        continue
+
+      transcript += chunk
+      tail = transcript[-2048:]
+
+      if re.search(r'(?i)are you sure you want to continue connecting',tail):
+        send(master,'yes')
+        continue
+
+      if re.search(r'(?i)(?:login|username)\s*:\s*$',tail):
+        send(master,username)
+        continue
+
+      if not sent_old and re.search(r'(?:Enter old password|Current password)\s*:',tail,re.I):
+        send(master,old_password)
+        sent_old = True
+        continue
+
+      if not sent_new and re.search(r'(?:Enter new password|New password)\s*:',tail,re.I):
+        send(master,new_password)
+        sent_new = True
+        continue
+
+      if not sent_confirm and re.search(r'(?:Confirm password|Retype new password)\s*:',tail,re.I):
+        send(master,new_password)
+        sent_confirm = True
+        continue
+
+      if not sent_login and re.search(r"password\s*:",tail,re.I):
+        send(master,old_password)
+        sent_login = True
+        continue
+
+      if 'Password changed' in tail:
+        changed = True
+
+      if sent_confirm and re.search(r'(?m)[>#]\s*$',tail):
+        changed = True
+
+      if changed and not exited and re.search(r'(?m)[>#]\s*$',tail):
+        send(master,'exit')
+        exited = True
+        time.sleep(0.5)
+        try:
+          os.kill(pid,signal.SIGTERM)
+        except ProcessLookupError:
+          pass
+        break
+
+    if not changed:
+      module.fail_json(
+        msg='PAN-OS password promotion did not observe the Password changed signal',
+        transcript=scrub(transcript,old_password,new_password))
+
+    return True,scrub(transcript,old_password,new_password)
+  finally:
+    try:
+      os.close(master)
+    except OSError:
+      pass
+    try:
+      wait_pid,_ = os.waitpid(pid,os.WNOHANG)
+    except ChildProcessError:
+      wait_pid = pid
+    if wait_pid != pid:
+      try:
+        os.kill(pid,signal.SIGTERM)
+      except ProcessLookupError:
+        pass
+      time.sleep(0.5)
+      try:
+        wait_pid,_ = os.waitpid(pid,os.WNOHANG)
+      except ChildProcessError:
+        wait_pid = pid
+      if wait_pid != pid:
+        try:
+          os.kill(pid,signal.SIGKILL)
+        except ProcessLookupError:
+          pass
+
+
+def main() -> None:
+  module = AnsibleModule(
+    argument_spec={
+      'host': { 'required': True, 'type': 'str' },
+      'port': { 'required': True, 'type': 'int' },
+      'username': { 'required': False, 'type': 'str', 'default': 'admin' },
+      'old_password': { 'required': False, 'type': 'str', 'default': 'admin', 'no_log': True },
+      'new_password': { 'required': True, 'type': 'str', 'no_log': True },
+      'key_filename': { 'required': False, 'type': 'str' },
+      'timeout': { 'required': False, 'type': 'int', 'default': 180 },
+    },
+    supports_check_mode=False)
+
+  promoted, probe_transcript = already_promoted(module)
+  if promoted:
+    module.exit_json(
+      changed=False,
+      transcript=probe_transcript,
+      msg='PAN-OS admin password is already the configured one; nothing to promote')
+
+  changed,transcript = promote_password(module)
+  module.exit_json(changed=changed, transcript=transcript)
+
+
+if __name__ == '__main__':
+  main()
diff --git a/netsim/ansible/library/panos_cli_config_kne.py b/netsim/ansible/library/panos_cli_config_kne.py
new file mode 100644
index 0000000..444f528
--- /dev/null
+++ b/netsim/ansible/library/panos_cli_config_kne.py
@@ -0,0 +1,234 @@
+#!/usr/bin/python
+from __future__ import annotations
+
+import os
+import pty
+import re
+import select
+import signal
+import time
+
+from ansible.module_utils.basic import AnsibleModule
+
+
+DOCUMENTATION = r'''
+---
+module: panos_cli_config_kne
+short_description: Push set-format CLI configuration to PAN-OS over the KNE SSH endpoint
+description:
+  - Sends configuration-mode C(set) commands to PAN-OS over the runtime SSH endpoint the KNE provider
+    publishes, then commits. This is the deploy lane for netlab module templates (services, bgp, ...):
+    they render set-format CLI, and the Palo Alto Ansible collection has no modules for most of what
+    they configure (there is no module for C(deviceconfig system snmp-setting), for example), so the
+    rendered text is applied the way an operator would apply it.
+  - Same pty-driven ssh transport as C(panos_admpwd_kne), for the same reason - the upstream modules
+    cannot target a non-default SSH port, and sshpass is not part of the runtime image.
+options:
+  host:
+    description: KNE runtime host for the PAN-OS SSH endpoint.
+    required: true
+    type: str
+  port:
+    description: KNE runtime SSH port for the PAN-OS endpoint.
+    required: true
+    type: int
+  username:
+    required: false
+    default: admin
+    type: str
+  password:
+    required: true
+    type: str
+  lines:
+    description: Configuration-mode commands, one per entry. Blank lines and comments are ignored.
+    required: true
+    type: list
+    elements: str
+  commit:
+    description: Commit after the lines are applied. Ignored in op mode.
+    required: false
+    default: true
+    type: bool
+  mode:
+    description: C(configure) enters configuration mode, applies the lines and commits;
+      C(op) runs the lines as operational commands and returns the transcript -- the
+      autocommit gate reads C(show jobs all) this way.
+    required: false
+    default: configure
+    choices: [ configure, op ]
+    type: str
+  timeout:
+    description: Overall budget in seconds. A CLI commit blocks until the job finishes, so this must
+      cover it; a healthy commit on a quiet VM-Series measures well under a minute.
+    required: false
+    default: 300
+    type: int
+author:
+  - The platform
+'''
+
+PROMPT_BYTES = 4096
+# Config-mode errors PAN-OS prints instead of failing the session. Any of these
+# in the transcript is a failed apply even though every prompt came back.
+ERROR_RE = re.compile(r'(?i)invalid syntax|unknown command|validation error|server error|malformed')
+
+
+def scrub(text: str, *secrets: str) -> str:
+  for secret in secrets:
+    if secret:
+      text = text.replace(secret, '********')
+  return text
+
+
+def send(master: int, value: str) -> None:
+  os.write(master, (value + '\n').encode())
+
+
+def apply_config(module: AnsibleModule) -> tuple[bool, str]:
+  host = module.params['host']
+  port = int(module.params['port'])
+  username = module.params['username']
+  password = module.params['password']
+  raw_lines = module.params['lines'] or []
+  op_mode = str(module.params.get('mode') or 'configure') == 'op'
+  do_commit = bool(module.params['commit']) and not op_mode
+  timeout = int(module.params['timeout'])
+
+  lines = []
+  for raw in raw_lines:
+    line = str(raw or '').strip()
+    if line and not line.startswith('#'):
+      lines.append(line)
+  if not lines:
+    return False, ''
+
+  # The full session, sent one entry per prompt. scripting-mode keeps the CLI
+  # from echoing interactive furniture; pager off keeps long output from
+  # wedging the prompt detector.
+  queue = ['set cli scripting-mode on', 'set cli pager off']
+  if not op_mode:
+    queue.append('configure')
+  queue += lines
+  if do_commit:
+    queue.append('commit')
+  if not op_mode:
+    queue.append('exit')
+  queue.append('exit')
+
+  cmd = [
+    'ssh',
+    '-tt',
+    '-p', str(port),
+    '-o', 'PreferredAuthentications=keyboard-interactive,password',
+    '-o', 'KbdInteractiveAuthentication=yes',
+    '-o', 'NumberOfPasswordPrompts=3',
+    '-o', 'PubkeyAuthentication=no',
+    '-o', 'StrictHostKeyChecking=no',
+    '-o', 'UserKnownHostsFile=/dev/null',
+    '-o', 'HostKeyAlgorithms=+ssh-rsa',
+    '-o', 'LogLevel=ERROR',
+    f'{username}@{host}',
+  ]
+
+  pid, master = pty.fork()
+  if pid == 0:
+    os.execvp(cmd[0], cmd)
+
+  transcript = ''
+  sent_login = False
+  index = 0
+  committed = not do_commit
+  deadline = time.time() + timeout
+
+  try:
+    while time.time() < deadline:
+      wait_pid, _ = os.waitpid(pid, os.WNOHANG)
+      if wait_pid == pid:
+        break
+
+      ready, _, _ = select.select([master], [], [], 0.25)
+      if not ready:
+        continue
+      try:
+        chunk = os.read(master, PROMPT_BYTES).decode(errors='replace')
+      except OSError:
+        break
+      if not chunk:
+        continue
+
+      transcript += chunk
+      tail = transcript[-2048:]
+
+      if re.search(r'(?i)are you sure you want to continue connecting', tail):
+        send(master, 'yes')
+        continue
+      if not sent_login and re.search(r'password\s*:\s*$', tail, re.I):
+        send(master, password)
+        sent_login = True
+        continue
+
+      if 'Configuration committed successfully' in transcript:
+        committed = True
+
+      # A prompt at end-of-buffer means the previous command settled. Send the
+      # next one; when the queue empties the trailing exits close the session
+      # and waitpid above ends the loop.
+      if index < len(queue) and re.search(r'(?m)[>#]\s*$', tail):
+        send(master, queue[index])
+        index += 1
+        continue
+
+    return committed if do_commit else index >= len(queue), transcript
+  finally:
+    try:
+      os.close(master)
+    except OSError:
+      pass
+    try:
+      os.kill(pid, signal.SIGTERM)
+    except ProcessLookupError:
+      pass
+
+
+def main() -> None:
+  module = AnsibleModule(
+    argument_spec=dict(
+      host=dict(type='str', required=True),
+      port=dict(type='int', required=True),
+      username=dict(type='str', default='admin'),
+      password=dict(type='str', required=True, no_log=True),
+      lines=dict(type='list', elements='str', required=True),
+      mode=dict(type='str', default='configure', choices=['configure', 'op']),
+      commit=dict(type='bool', default=True),
+      timeout=dict(type='int', default=300),
+    ),
+    supports_check_mode=False,
+  )
+
+  wanted = [str(l or '').strip() for l in (module.params['lines'] or [])]
+  if not [l for l in wanted if l and not l.startswith('#')]:
+    module.exit_json(changed=False, msg='no configuration lines to apply')
+
+  ok, transcript = apply_config(module)
+  clean = scrub(transcript, str(module.params['password']))
+
+  if 'Commit failed' in clean:
+    # The device names its reason on the lines above this marker (captured
+    # live: "device is not in jumbo-frame mode but interface ... mtu is
+    # greater than 1500"). Waiting out the timeout here would bury that
+    # reason under a generic no-signal message.
+    module.fail_json(msg='PAN-OS commit failed on the device', transcript=clean[-4000:])
+  if ERROR_RE.search(clean):
+    module.fail_json(msg='PAN-OS rejected at least one configuration line', transcript=clean[-4000:])
+  if not ok:
+    module.fail_json(
+      msg='did not observe the commit-success signal before the timeout; '
+          'an EMPTY transcript means the SSH endpoint was never reached, '
+          'a non-empty one means the device stopped answering mid-session',
+      transcript=clean[-4000:],
+    )
+  module.exit_json(changed=True, transcript=clean[-4000:])
+
+
+if __name__ == '__main__':
+  main()
diff --git a/netsim/ansible/tasks/deploy-config/panos.yml b/netsim/ansible/tasks/deploy-config/panos.yml
new file mode 100644
index 0000000..775da00
--- /dev/null
+++ b/netsim/ansible/tasks/deploy-config/panos.yml
@@ -0,0 +1,36 @@
+#
+# PAN-OS module-config deploy lane: netlab renders a module template
+# (services, bgp, routing, ...) into configuration-mode set commands, and this
+# pushes them over the KNE SSH endpoint and commits -- the same transport and
+# module the initial lane uses, so PAN-OS has exactly ONE config mechanism.
+#
+# THIS FILE'S ABSENCE WAS A SILENT HOLE. It existed pre-consolidation, was
+# dropped from the 12-patch series, and every module template kept rendering
+# and then logged "Deploy services configuration: skipping" -- which is how
+# both demo-lab PAN-OS firewalls came up without SNMP and the collector's performance
+# validation reported 10/12 devices (2026-08-31). A rendered template with no
+# deploy script fails NOTHING; the miss surfaces two stages later as somebody
+# else's timeout.
+#
+# The empty-render guard stays even though nothing renders deliberately empty
+# any more: as of the single-transport port the firewall.policy, zonebased and
+# ipsec plugins render real set-command templates through this lane too (their
+# XML-API deploy.panos.yml task lists are deleted). A node that declares a
+# module with nothing to emit still must not open an SSH session to send
+# nothing.
+---
+- name: "panos: render {{ netsim_action }} from {{ config_template }}"
+  ansible.builtin.set_fact:
+    panos_deployed_config: "{{ lookup('template', config_template) }}"
+
+- name: "panos: deploy {{ netsim_action }} over the KNE SSH endpoint"
+  panos_cli_config_kne:
+    host: "{{ ansible_host }}"
+    port: "{{ panos_kne_ssh_port }}"
+    username: "{{ ansible_user }}"
+    password: "{{ ansible_password }}"
+    lines: "{{ panos_deployed_config.splitlines() }}"
+    commit: true
+    timeout: 300
+  when: not ansible_check_mode and ((panos_deployed_config | trim | length) > 0)
+  tags: [ print_action, always ]
diff --git a/netsim/ansible/tasks/panos/initial.yml b/netsim/ansible/tasks/panos/initial.yml
new file mode 100644
index 0000000..0aef208
--- /dev/null
+++ b/netsim/ansible/tasks/panos/initial.yml
@@ -0,0 +1,235 @@
+---
+# WAIT FOR THE DEVICE, NOT FOR THE POD.
+#
+# PAN-OS declares netlab_ready: [ ansible ], which -- with
+# ansible_connection: local -- proves the CONTROLLER is alive and says nothing
+# about the firewall. On a first boot the dataplane pod is Running and Ready
+# minutes before the management plane listens, so an ungated first task went
+# straight into "Connection refused" and failed the whole bring-up with 78 of
+# 80 pods healthy (demo-lab 2026-08-30: jfk-fw01 and lax-fw01, the only two
+# PAN-OS nodes).
+#
+# Everything below rides ONE transport: the KNE SSH endpoint. The XML API is
+# not used at all -- the password promotion, the autocommit gate and the
+# config push are all CLI-over-SSH, so SSH answering is the only readiness
+# that matters here.
+#
+# 25 minutes of budget: a cold PAN-OS VM takes 15-25 to answer. This is a WAIT
+# on a condition, not a retry of a failing task -- if the endpoint never comes
+# up the play still fails, with a message that names it rather than a bare
+# connection error.
+# The provider fills panos_kne_ssh_port from the live KNE service. If it is
+# missing, the promotion below would silently try to reach nothing, so say so
+# here instead of failing ten attempts later with an empty transcript.
+- name: Assert the KNE SSH endpoint for PAN-OS is known
+  ansible.builtin.assert:
+    that: panos_kne_ssh_port is defined and (panos_kne_ssh_port | int) > 0
+    fail_msg: >-
+      panos_kne_ssh_port is not set for {{ inventory_hostname }}: the KNE
+      provider did not publish an ssh service for this node, so the mandatory
+      password promotion has no endpoint to reach. Check the node's KNE
+      services in topology.pb.txt.
+
+- name: Wait for the PAN-OS SSH endpoint to accept connections
+  ansible.builtin.wait_for:
+    host: "{{ ansible_host }}"
+    port: "{{ panos_kne_ssh_port }}"
+    state: started
+    timeout: 1500
+    delay: 10
+    sleep: 10
+
+# PROMOTE THE PASSWORD BEFORE ANYTHING AUTHENTICATES.
+#
+# PAN-OS forces a password change at first login: it boots on the factory
+# admin/admin and refuses every API call until admin has been given a new
+# password over the console/SSH. panos_admpwd_kne drives those prompts through
+# the KNE SSH endpoint (the upstream panos_admpwd cannot target a non-default
+# port).
+#
+# The module SHIPPED but was never invoked by any playbook. The device file
+# advertised the promoted password, the API client used it, and the device had
+# never been told it -- so every PAN-OS node failed with
+#
+#   Create layer-3 interfaces: Failed connection: code: 403 Invalid Credential
+#
+# (demo-lab 2026-08-30, jfk-fw01 and lax-fw01). Idempotent by construction: once
+# the password is the configured one the old-password prompt never appears and
+# the module reports no change.
+# panos_kne_ssh_port, NOT ansible_port. The KNE provider publishes the SSH
+# service separately (kne.py: get_kne_service_by_name_or_port(['ssh'],[22]))
+# because ansible_port carries the API/httpapi port -- which is why this module
+# exists at all, per its own docs: "the upstream panos_admpwd module cannot
+# target a non-default SSH port".
+#
+# Getting this wrong does not look like a wrong port. The SSH session simply
+# produces nothing and the module reports
+#   "did not observe the Password changed signal", transcript: ""
+# An EMPTY transcript means we never reached the device; a non-empty one that
+# still fails means the device rejected the change. They are different bugs.
+- name: Promote the PAN-OS admin password off the factory default
+  panos_admpwd_kne:
+    host: "{{ ansible_host }}"
+    port: "{{ panos_kne_ssh_port }}"
+    username: "{{ ansible_user }}"
+    old_password: admin
+    new_password: "{{ ansible_password }}"
+    key_filename: "{{ ansible_ssh_private_key_file | default(omit) }}"
+    # POLL FINELY, DO NOT WAIT COARSELY. timeout is the budget for ONE attempt,
+    # and a device that is not up yet burns ALL of it before failing -- so at
+    # 300s + 30s delay each retry cost 5.5 MINUTES and the ceiling was 55.
+    #
+    # MEASURED on demo-lab 2026-09-08: jfk-fw01 retried at 16:35:28 and 16:41:03,
+    # exactly 5m35s apart, while lax-fw01 -- the same device type in the same
+    # lab -- completed the whole promotion in 8.1 SECONDS once it was ready.
+    # That gap is the entire problem: a READY device answers in single-digit
+    # seconds, so a 300s per-attempt budget buys nothing except discovering
+    # readiness up to five and a half minutes after it happened.
+    #
+    # The overall ceiling is deliberately NOT shortened -- a cold PAN-OS really
+    # can take many minutes, and cutting the budget would fail a slow but
+    # healthy device. 45s x 50 retries with a 10s delay holds a ~46 minute
+    # ceiling (was ~55) while detecting readiness within ~55s instead of ~330s.
+    timeout: 45
+  register: panos_pwd_promotion
+  until: panos_pwd_promotion is succeeded
+  retries: 50
+  delay: 10
+
+# THE AUTOCOMMIT GATE, OVER THE SAME SSH SESSION EVERYTHING ELSE USES.
+#
+# A cold PAN-OS refuses every user commit until its first-boot AutoCom job
+# finishes -- committing earlier returns "auto-commit not yet finished
+# successfully". Two prior gates watched the wrong signal or the wrong shape:
+# chassis-ready flips yes BEFORE AutoCom reaches FIN (r16 passed the gate and
+# still lost the commit), and the XML API answer turned out to be CDATA-wrapped
+# (r15 burned 30 minutes against a ready firewall). Reading the job table over
+# the CLI needs no API key and no separate API-port wait -- the whole
+# XML-API leg of this file existed only to feed that one poll.
+#
+# The table format is CAPTURED from a live device, not taken from docs:
+#
+#   Enqueued              Dequeued   ID  PositionInQ   Type     Status Result
+#   2026/08/30 18:43:54   18:43:54    2                AutoCom     FIN     OK
+#
+# Type/Status/Result are whitespace-separated columns on one row, so the match
+# is AutoCom\s+FIN (finished) and AutoCom\s+FIN\s+OK (succeeded). A healthy
+# VM-Series reaches FIN by ~T+15min from VM start; 30 minutes is that doubled.
+#
+# THE AutoCom ROW AGES OUT, AND THIS GATE IS NOT ONLY A FIRST-BOOT GATE.
+#
+# netlab initial runs on every reconfigure, not only on a fresh lab, and
+# PAN-OS's job table is BOUNDED: it keeps roughly the last 29 jobs and the
+# first-boot AutoCom is job 1 or 2. Captured from sjc-dc1in-panos-fw1 on
+# 2026-09-19 (demo-lab, reconfigure an internal task), the whole visible
+# table was
+#
+#   2026/09/18 22:50:16 ... 30 ... Commit  FIN  OK 22:51:30
+#   ... 27 more Commit rows ...
+#   2026/09/18 18:38:49 ...  3 ... Commit  FIN  OK 18:39:59
+#
+# -- no AutoCom row at all. A regex that cannot match spends every second of
+# the budget it is given: both DC firewalls ran the full 90 retries, 56
+# MINUTES, then failed the assert below, were dropped from the play, and
+# received NO initial and NO module configuration. The other 182 nodes had
+# finished at T+5min and sat idle for the rest. That is 86% of a 65-minute
+# reconfigure spent proving nothing about a device that was healthy.
+#
+# The fix is to name the OTHER shape the table can legitimately have, not to
+# widen the budget. PAN-OS refuses to queue any user commit until the
+# first-boot autocommit has finished successfully -- "Commit job was not
+# queued since auto-commit not yet finished successfully" is the device's own
+# refusal. So a `Commit ... FIN OK` row is PROOF that the autocommit already
+# finished and succeeded; it cannot exist otherwise.
+#
+# That inference is only safe while no AutoCom row is visible. A table that
+# shows BOTH a finished user commit and an AutoCom still in ACT/PEND is a
+# device whose autocommit is genuinely running (the captured
+# REAL_JOBS_RUNNING fixture in tests/test_panos_initial_gates.py is exactly
+# that shape), so the AutoCom row, when present, always wins.
+#
+# Absence alone proves nothing, which is why the second branch also demands a
+# POSITIVE match: an empty transcript, a refused login or a CLI that answered
+# nothing carries no Commit row either, so it keeps waiting exactly as before.
+#
+# Reboots cannot smuggle a stale table past this. Every KNE NOS VM boots from
+# an ephemeral KubeVirt containerDisk (patches/kne/0007, kubeVirtContainerDisk
+# Specs -- no PVC, no DataVolume for the root disk), so a restarted PAN-OS
+# starts with an empty job table in which AutoCom is job 1 and visible.
+- name: Wait for the PAN-OS first-boot autocommit job to finish
+  panos_cli_config_kne:
+    host: "{{ ansible_host }}"
+    port: "{{ panos_kne_ssh_port }}"
+    username: "{{ ansible_user }}"
+    password: "{{ ansible_password }}"
+    mode: op
+    lines: [ 'show jobs all' ]
+    timeout: 60
+  register: panos_autocommit_job
+  until: >-
+    panos_autocommit_job.transcript | default('') is search('AutoCom\s+FIN')
+    or (panos_autocommit_job.transcript | default('') is not search('AutoCom')
+        and panos_autocommit_job.transcript | default('') is search('Commit\s+FIN\s+OK'))
+  retries: 90
+  delay: 20
+  ignore_errors: true
+
+# ignore_errors, not failed_when: an exhausted `until` loop sets failed=True
+# itself, AFTER any failed_when is applied, so only ignore_errors lets the play
+# continue to the asserts that name the autocommit.
+- name: Assert the PAN-OS autocommit finished
+  ansible.builtin.assert:
+    that: >-
+      panos_autocommit_job.transcript | default('') is search('AutoCom\s+FIN')
+      or (panos_autocommit_job.transcript | default('') is not search('AutoCom')
+          and panos_autocommit_job.transcript | default('') is search('Commit\s+FIN\s+OK'))
+    fail_msg: >-
+      PAN-OS on {{ inventory_hostname }} never reported its first-boot
+      autocommit job (AutoCom) as finished within 30 minutes of the password
+      promotion, and its job table carries no finished user commit either, so
+      any commit we issue would be refused. The device is reachable and the
+      password is correct. A healthy VM-Series finishes its autocommit by
+      ~T+15min, so a genuine exhaustion here means the job is wedged -- read
+      `show jobs all` on the device.
+
+# FIN is not OK: a finished autocommit can have FAILED, and a failed autocommit
+# refuses user commits forever -- only `commit force` clears it. Different
+# repair from waiting, so it gets its own message.
+- name: Assert the PAN-OS autocommit succeeded
+  ansible.builtin.assert:
+    that: >-
+      panos_autocommit_job.transcript | default('') is search('AutoCom\s+FIN\s+OK')
+      or (panos_autocommit_job.transcript | default('') is not search('AutoCom')
+          and panos_autocommit_job.transcript | default('') is search('Commit\s+FIN\s+OK'))
+    fail_msg: >-
+      The first-boot autocommit on {{ inventory_hostname }} FINISHED but did
+      not report result OK: the device will refuse every normal commit until a
+      `commit force` clears the failed state. This is a device-side autocommit
+      failure, not a wait that ran out -- read `show jobs all` for the AutoCom
+      job's details before retrying the lab.
+
+# THE INITIAL CONFIG, RENDERED AND PUSHED LIKE EVERY OTHER NETLAB DEVICE.
+#
+# templates/initial/panos.j2 renders the complete day-1 baseline -- hostname,
+# ping management profile, per-interface IP/MTU/zone/vsys-import, virtual
+# router membership -- as configuration-mode set commands, and the module
+# applies them over SSH and commits. This REPLACES the collection's API
+# modules: they covered a subset of the template (no zones -- every commit
+# warned "Interface ethernet1/1 has no zone configuration"), needed an API key
+# the CLI does not, and split PAN-OS across two transports for no gain.
+#
+# Subinterfaces (layer3 units) and the loopback are covered too, every line
+# probe-verified on a live device before it entered the template.
+- name: Render the PAN-OS initial configuration
+  ansible.builtin.set_fact:
+    panos_initial_config: "{{ lookup('template', config_template) }}"
+
+- name: Apply and commit the PAN-OS initial configuration
+  panos_cli_config_kne:
+    host: "{{ ansible_host }}"
+    port: "{{ panos_kne_ssh_port }}"
+    username: "{{ ansible_user }}"
+    password: "{{ ansible_password }}"
+    lines: "{{ panos_initial_config.splitlines() }}"
+    commit: true
+    timeout: 300
diff --git a/netsim/ansible/tasks/panos/routing.yml b/netsim/ansible/tasks/panos/routing.yml
new file mode 100644
index 0000000..f98b314
--- /dev/null
+++ b/netsim/ansible/tasks/panos/routing.yml
@@ -0,0 +1,23 @@
+---
+- name: Configure PAN-OS static routes
+  loop: "{{ routing.static|default([]) }}"
+  loop_control:
+    loop_var: route
+    index_var: route_idx
+  when: route.ipv4 is defined
+  paloaltonetworks.panos.panos_static_route:
+    provider: "{{ panos_provider }}"
+    virtual_router: "{{ panos_virtual_router }}"
+    name: "{{ route.name|default('netlab-route-' ~ route_idx) }}"
+    destination: "{{ route.ipv4 }}"
+    interface: "{{ route.nexthop.intf|default(omit) }}"
+    nexthop: "{{ route.nexthop.ipv4|default(omit) }}"
+    nexthop_type: >-
+      {{ 'discard' if route.nexthop.discard is defined else
+         'next-vr' if route.nexthop.vrf is defined and route.nexthop.vrf is not none else
+         'ip-address' }}
+
+- name: Commit static routing configuration
+  when: routing.static|default([])|length > 0
+  paloaltonetworks.panos.panos_commit_firewall:
+    provider: "{{ panos_provider }}"
diff --git a/netsim/ansible/tasks/panos/security.yml b/netsim/ansible/tasks/panos/security.yml
new file mode 100644
index 0000000..435029a
--- /dev/null
+++ b/netsim/ansible/tasks/panos/security.yml
@@ -0,0 +1,15 @@
+---
+- name: "PAN-OS SSH apply: {{ netsim_action }} from {{ config_template }}"
+  delegate_to: localhost
+  ansible.builtin.expect:
+    command: >-
+      sshpass -p '{{ ansible_password }}'
+      ssh -o UserKnownHostsFile=/dev/null
+          -o StrictHostKeyChecking=no
+          {{ ansible_user }}@{{ ansible_host }}
+    responses:
+      '.*>':
+      - "configure\n"
+      - "{{ lookup('template', config_template) }}\ncommit\nexit\n"
+      '.*#': "exit\n"
+  tags: [ print_action, always ]
diff --git a/netsim/ansible/tasks/readiness-check/a10.yml b/netsim/ansible/tasks/readiness-check/a10.yml
new file mode 100644
index 0000000..f2d244f
--- /dev/null
+++ b/netsim/ansible/tasks/readiness-check/a10.yml
@@ -0,0 +1,28 @@
+# A10 vThunder (ACOS) readiness: SSH is not enough.
+#
+# vThunder accepts SSH (and even logs in) while its configuration subsystem is
+# still LOADING; a config push in that window fails on the first submode. The
+# `ssh` readiness step (connect-only, netlab_check_command: "") runs first and
+# proves the management plane; this step then proves what the deploy lane
+# actually needs -- enable mode with the blank enable password, and a
+# `configure terminal` session that opens and closes -- over the same
+# a10.acos_cli network_cli connection the deploy uses.
+#
+# Retry budget comes from a10_config_retries / a10_config_delay (device or
+# runtime group_vars) so the wait is declared data, not a deploy-time retry.
+---
+- name: "Wait for {{ inventory_hostname }} ACOS enable + configure terminal"
+  a10.acos_cli.acos_command:
+    commands:
+    - show version
+    - configure terminal
+    - end
+  become: "{{ ansible_become | default(true) }}"
+  register: a10_ready
+  until: a10_ready is succeeded
+  retries: "{{ a10_config_retries | default(30) }}"
+  delay: "{{ a10_config_delay | default(20) }}"
+
+- name: Confirm {{ inventory_hostname }} ACOS CLI is ready
+  debug:
+    msg: "Node {{ inventory_hostname }} is ready (ACOS enable + configure terminal)."
diff --git a/netsim/ansible/templates/bgp/panos.j2 b/netsim/ansible/templates/bgp/panos.j2
new file mode 100644
index 0000000..8c385ea
--- /dev/null
+++ b/netsim/ansible/templates/bgp/panos.j2
@@ -0,0 +1,191 @@
+{#
+  PAN-OS BGP, rendered from netlab's NATIVE bgp model (bgp.as, bgp.router_id,
+  bgp.neighbors, bgp.advertise) as configuration-mode `set` commands, deployed
+  over the KNE SSH endpoint by deploy-config/panos.yml -- the same single
+  transport the other panos module templates use.
+
+  PAN-OS is not a netlab-native BGP device upstream (there is no upstream
+  bgp/panos.j2), which is why this template hand-writes the virtual-router BGP
+  stanza. But every VALUE comes from the bgp module's own derivation, not from
+  any hand-authored per-node pack: the neighbor list, peer AS, local AS,
+  router-id and advertised prefixes are exactly what build_ebgp_sessions and
+  bgp.originate produced. A router with `module: [bgp]` + `bgp.as` peered over
+  a normal link to any bgp-capable neighbour gets its config from here with no sidecar and no custom config.
+
+  PAN-OS has no bare BGP `network` statement, so advertised prefixes are
+  originated the way PAN-OS itself does it: a discard static route per prefix,
+  a redistribution profile matching static, and a BGP export rule referencing
+  that profile -- driven by bgp.advertise (the resolved bgp.originate set).
+
+  local-address is the address of THIS node's interface facing each neighbour,
+  found by asking each local interface WHICH NODES IT FACES (intf.neighbors,
+  which netlab fills per link with {ifname, ipv4, node}); peer-address is the
+  neighbour's own interface address. No dot1Q sub-interface and no static ARP:
+  the peering /30 is already live on the physical interface from the netlab
+  link definition, so BGP's `local-address ip` alone selects the egress
+  interface.
+
+  DO NOT match on ifindex. This template used to pick the local interface with
+  `intf.ifindex == n.ifindex`, but n.ifindex is the interface index on the
+  NEIGHBOUR, not on this node -- the two only coincide by accident. On
+  demo-lab's sjc-dc1in-panos-fw1 its BGP neighbour's single lab
+  interface is index 1, so the PAN sourced the session from ITS index 1
+  (ethernet1/1, the DMZ_LB link, 10.254.1.14/30) instead of ethernet1/6
+  (169.254.10.2/30, the link the peer is actually on). The session then never
+  established: the peer sat in Connect, PAN-OS discarded the speaker's inbound
+  SYN, and nothing in the zone/security-policy layer explained it (proven
+  live 2026-09-16 -- an explicit allow rule for the exact matched application
+  changed nothing, because the peering was bound to the wrong interface).
+
+  DO NOT strip the CIDR mask off local-address ip, and DO NOT set
+  local-address interface and local-address ip in separate `set` commands.
+  PAN-OS's `local-address ip` leaf is a REFERENCE into the set of addresses
+  actually configured on `local-address interface`, keyed by the EXACT string
+  the interface's own address is configured with (mask included, e.g.
+  "169.254.10.2/30" -- "169.254.10.2" alone is "not a valid reference").
+  Because ip is validated against whichever interface is CURRENTLY bound,
+  changing interface and ip as two separate `set` lines is a dead end no
+  matter the order: setting interface first leaves the OLD ip as an invalid
+  reference against the NEW interface (rejected immediately, before the ip
+  line ever runs); setting ip first leaves the NEW ip an invalid reference
+  against the OLD interface. Confirmed live 2026-09-16 on sjc-dc1in-panos-fw1
+  by hand at the PAN-OS CLI: both orderings of two separate `set` commands
+  were rejected ("local-address -> ip '...' is not a valid reference"); one
+  `set ... local-address interface ethernet1/6 ip 169.254.10.2/30` command
+  (both leaves in the same edit) committed cleanly, and the session reached
+  Established within 69 seconds. That diagnostic edit was reverted by this
+  fix taking over the same config on the next netlab reconfigure -- netlab
+  remains the only producer of device config; nothing was left hand-pushed.
+
+  THIS TEMPLATE IS THE PAN-OS BGP LANE. Until patch 71 it was dead code: a
+  per-device task file (tasks/panos/bgp.yml, XML API via panos_bgp*) shadowed
+  it in deploy-module.yml's lookup, so nothing below ever reached a firewall --
+  live sjc-dc1in-panos-fw1 (2026-09-23) ran `install-route no`, no redist-rules
+  and advertised 0 prefixes while this file said `install-route yes`. Patch 71
+  deleted the task file; deploy-config/panos.yml now pushes this render over
+  the KNE SSH endpoint like every other PAN-OS module. The peer groups keep
+  the names the task file created (panos-ebgp / panos-ibgp) so a reconfigure
+  of a lab deployed by the old lane edits the same objects instead of
+  colliding with them.
+
+  ADVERTISEMENT IS REDISTRIBUTION. PAN-OS puts a route into BGP only through
+  `protocol bgp redist-rules <redist-profile>` (then, with no export policy,
+  advertises the whole loc-RIB). There is no `policy export ... match
+  redistribution-profile` -- pan-os-python's BgpPolicyRule has no such match,
+  and the export rule this template used to render named one. Two sources:
+    * bgp.originate -- discard static per prefix + redist-profile
+      nlb-advertise (type static, destination = exactly those prefixes)
+      + redist-rules. The discard static FLOATS (admin-dist 240, the PAN-OS
+      maximum): at the default static distance (10) it would beat an OSPF or
+      BGP route for the SAME prefix and blackhole it -- demo-lab's SJC
+      PAN originated 21 prefixes it also learns via OSPF (10.50.101.0/24 ...).
+      As an aggregate with no exact-match route it is still the active route
+      and is still redistributed. Prefixes the box already learns belong in
+      bgp.import, not originate.
+    * bgp.import (netlab's native redistribution) -- one redist-profile per
+      policy name (protocols importing with the same policy share it:
+      filter type [ connect ospf ]), destination filter from the policy's
+      permit prefix lists, priority from its first sequence, set-origin
+      incomplete. As the seed does it:
+        redist-profile Export_to_Amazon { filter { type [ connect ospf ] } priority 2; action { redist } }
+        bgp redist-rules Export_to_Amazon { address-family-identifier ipv4; enable yes; set-origin incomplete }
+  bgp.allow_redist_default_route renders allow-redist-default-route; unset, it
+  is rendered `yes` automatically when a redistributed destination is
+  0.0.0.0/0 (PAN-OS silently drops the default otherwise). bgp.install_route
+  renders install-route; unset, the device default (no) stays.
+#}
+{% if bgp.neighbors | default([]) %}
+{% set vr = panos_virtual_router | default('default') %}
+{% set all_dests = [] %}
+{% set adv = bgp.originate | default([]) %}
+{% for p in adv %}
+set network virtual-router {{ vr }} routing-table ip static-route "netlab-bgp-advertise-{{ loop.index }}" destination {{ p }}
+set network virtual-router {{ vr }} routing-table ip static-route "netlab-bgp-advertise-{{ loop.index }}" nexthop discard
+set network virtual-router {{ vr }} routing-table ip static-route "netlab-bgp-advertise-{{ loop.index }}" metric 254
+set network virtual-router {{ vr }} routing-table ip static-route "netlab-bgp-advertise-{{ loop.index }}" admin-dist 240
+{%   set _ = all_dests.append(p) %}
+{% endfor %}
+{% if adv %}
+set network virtual-router {{ vr }} protocol redist-profile "nlb-advertise" filter type [ static ]
+set network virtual-router {{ vr }} protocol redist-profile "nlb-advertise" filter destination [ {{ adv | join(' ') }} ]
+set network virtual-router {{ vr }} protocol redist-profile "nlb-advertise" priority 1
+set network virtual-router {{ vr }} protocol redist-profile "nlb-advertise" action redist
+{% endif %}
+{% set imp = bgp.import | default({}) %}
+{% set r_policy = routing.policy if routing is defined and routing.policy is defined else {} %}
+{% set pnames = [] %}
+{% for s_proto, s_data in imp | dictsort %}
+{%   set pn = s_data.policy | default('nlb-' ~ s_proto) %}
+{%   if pn not in pnames %}
+{%     set _ = pnames.append(pn) %}
+{%   endif %}
+{% endfor %}
+{% for pn in pnames %}
+{%   set types = [] %}
+{%   for s_proto, s_data in imp | dictsort if s_data.policy | default('nlb-' ~ s_proto) == pn %}
+{%     set _ = types.append('connect' if s_proto == 'connected' else s_proto) %}
+{%   endfor %}
+{%   set entries = r_policy[pn] if pn in r_policy else [] %}
+{%   set dests = [] %}
+{%   for e in entries if e.action | default('permit') == 'permit' and e.match.prefix is defined %}
+{%     for pe in routing._prefix.ipv4[e.match.prefix] | default([]) if pe.action | default('permit') == 'permit' and pe.ipv4 is defined %}
+{%       set _ = dests.append(pe.ipv4) %}
+{%       set _ = all_dests.append(pe.ipv4) %}
+{%     endfor %}
+{%   endfor %}
+set network virtual-router {{ vr }} protocol redist-profile "{{ pn }}" filter type [ {{ types | join(' ') }} ]
+{%   if dests %}
+set network virtual-router {{ vr }} protocol redist-profile "{{ pn }}" filter destination [ {{ dests | join(' ') }} ]
+{%   endif %}
+set network virtual-router {{ vr }} protocol redist-profile "{{ pn }}" priority {{ entries[0].sequence | default(10) if entries else 10 }}
+set network virtual-router {{ vr }} protocol redist-profile "{{ pn }}" action redist
+{% endfor %}
+set network virtual-router {{ vr }} protocol bgp router-id {{ bgp.router_id }}
+set network virtual-router {{ vr }} protocol bgp local-as {{ bgp.as }}
+{% if bgp.install_route is defined %}
+set network virtual-router {{ vr }} protocol bgp install-route {{ 'yes' if bgp.install_route else 'no' }}
+{% endif %}
+{% if bgp.allow_redist_default_route is defined %}
+set network virtual-router {{ vr }} protocol bgp allow-redist-default-route {{ 'yes' if bgp.allow_redist_default_route else 'no' }}
+{% elif '0.0.0.0/0' in all_dests %}
+set network virtual-router {{ vr }} protocol bgp allow-redist-default-route yes
+{% endif %}
+{% for pn in (['nlb-advertise'] if adv else []) + pnames %}
+set network virtual-router {{ vr }} protocol bgp redist-rules "{{ pn }}" address-family-identifier ipv4
+set network virtual-router {{ vr }} protocol bgp redist-rules "{{ pn }}" set-origin incomplete
+set network virtual-router {{ vr }} protocol bgp redist-rules "{{ pn }}" enable yes
+{% endfor %}
+{% for n in bgp.neighbors if n.ipv4 is defined and n.type in ['ebgp', 'ibgp'] %}
+{%   set pg = 'panos-ibgp' if n.type == 'ibgp' else 'panos-ebgp' %}
+{%   set local_if = namespace(ifname=None, ipv4=None) %}
+{%   for intf in interfaces | default([]) if intf.ipv4 is defined %}
+{%     for nb in intf.neighbors | default([]) if nb.node is defined and nb.node == n.name %}
+{%       set local_if.ifname = intf.ifname %}
+{%       set local_if.ipv4 = intf.ipv4 %}
+{%     endfor %}
+{%   endfor %}
+{%   if not local_if.ifname and n.type == 'ibgp' and loopback.ipv4 is defined %}
+{%     set local_if.ifname = loopback.ifname %}
+{%     set local_if.ipv4 = loopback.ipv4 %}
+{%   endif %}
+{%   if n.type == 'ibgp' %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" type ibgp export-nexthop {{ 'use-self' if bgp.next_hop_self | default(true) else 'original' }}
+{%   else %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" type ebgp remove-private-as yes
+{%   endif %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" enable yes
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" peer-as {{ n.as }}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" enable-mp-bgp no
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" address-family-identifier ipv4
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" subsequent-address-family-identifier unicast yes
+{%   if local_if.ifname and local_if.ipv4 %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" local-address interface {{ local_if.ifname }} ip {{ local_if.ipv4 }}
+{%   endif %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" peer-address ip {{ n.ipv4 }}
+{%   if n.multihop is defined %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" connection-options multihop {{ n.multihop }}
+{%   endif %}
+set network virtual-router {{ vr }} protocol bgp peer-group "{{ pg }}" peer "{{ n.name }}" enable yes
+{% endfor %}
+set network virtual-router {{ vr }} protocol bgp enable yes
+{% endif %}
diff --git a/netsim/ansible/templates/initial/a10.j2 b/netsim/ansible/templates/initial/a10.j2
