diff --git a/tests/test_a10_deploy_and_vip_advertise.py b/tests/test_a10_deploy_and_vip_advertise.py
new file mode 100644
index 0000000..dbd030f
--- /dev/null
+++ b/tests/test_a10_deploy_and_vip_advertise.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""
+A10 vThunder (ACOS):
+
+  * every module template the a10 device renders must be delivered -- when
+    deploy-config/a10.yml was missing, deploy-module.yml found the template,
+    found no deploy script and SKIPPED it, and the lab reported configured while
+    the vThunder ran its factory config. It is now delivered over netmiko, so
+    every module must map to the netmiko lane;
+  * loadbalancer.virtual_servers[].advertise renders BOTH halves of ACOS VIP
+    redistribution: `redistribution-flagged` on that virtual server and
+    `redistribute vip only-flagged` under router ospf. Unflagged VIPs stay
+    local, and a node with no flagged VIP gets no redistribution at all.
+"""
+
+import textwrap
+from pathlib import Path
+
+import pytest
+import yaml
+
+from netsim.augment import devices
+from netsim.cli import create
+from netsim.utils import log
+
+NETSIM = Path(__file__).resolve().parents[1] / 'netsim'
+
+
+def init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+def write_topology(tmp_path: Path, advertise: str) -> Path:
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent(f"""
+    provider: kne
+    plugin: [ loadbalancer ]
+    module: [ ospf ]
+    nodes:
+      lb:
+        device: a10
+        module: [ ospf ]              # real A10 labs list their modules too
+        ospf.router_id: 10.254.2.6
+        loadbalancer:
+          pools:
+          - name: web
+            members:
+            - {{ name: s1, address: 10.55.101.11, port: 80 }}
+          virtual_servers:
+          - {{ name: flagged_vip, vip: 210.140.140.140, port: 80, pool: web {advertise} }}
+          - {{ name: local_vip, vip: 210.140.140.141, port: 80, pool: web }}
+      r1: {{ device: iol }}
+    links: [ lb-r1 ]
+    """).strip() + '\n')
+  return topo_file
+
+
+def module_cfg(node: str, module: str) -> str:
+  return Path(f'node_files/{node}/{module}').read_text()
+
+
+def test_a10_vip_advertise_renders_flag_and_ospf_redistribution(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log()
+  create.run(['-o','config','-o','provider',str(write_topology(tmp_path,', advertise: true'))])
+
+  lb = module_cfg('lb','loadbalancer')
+  assert 'slb virtual-server flagged_vip 210.140.140.140\n  redistribution-flagged\n  port 80 tcp\n' in lb
+  assert 'slb virtual-server local_vip 210.140.140.141\n  port 80 tcp\n' in lb   # unflagged stays local
+  assert lb.count('redistribution-flagged') == 1
+
+  ospf = module_cfg('lb','ospf')
+  assert ospf.startswith('router ospf 1\n')
+  assert '  redistribute vip only-flagged\n' in ospf
+
+
+def test_a10_without_advertise_renders_no_redistribution(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log()
+  create.run(['-o','config','-o','provider',str(write_topology(tmp_path,''))])
+
+  assert 'redistribution-flagged' not in module_cfg('lb','loadbalancer')
+  ospf = module_cfg('lb','ospf')
+  assert 'router ospf 1' in ospf                                          # positive control: OSPF did render
+  assert 'redistribute vip' not in ospf
+
+
+def test_a10_advertise_must_be_a_bool(tmp_path: Path) -> None:
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(write_topology(tmp_path,', advertise: sometimes'))])
+
+
+def test_every_a10_module_template_is_delivered_over_netmiko(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log()
+  topology = create.run(['-o','config','-o','provider',str(write_topology(tmp_path,', advertise: true'))])
+  lb = topology.nodes.lb
+
+  assert devices.get_node_group_var(lb,'netlab_config_mode',topology.defaults) == 'netmiko'
+  modules = ['initial','ospf','loadbalancer']
+  for m in modules:
+    assert lb._node_config[m] == ':netmiko', m
+    assert Path(f'node_files/lb/{m}').exists(), m
+  assert set(lb.netlab_ansible_skip_module) >= set(modules)   # nothing left for the Ansible lane
+
+  device = yaml.safe_load((NETSIM / 'devices' / 'a10.yml').read_text())
+  assert device['group_vars']['netmiko_device_type'] == 'a10'
+  assert device['group_vars']['netmiko_save_command'] == 'write memory'
+  # The acos_config lane is retired, not dormant
+  assert not (NETSIM / 'ansible' / 'tasks' / 'deploy-config' / 'a10.yml').exists()
+  assert not (NETSIM / 'ansible' / 'tasks' / 'a10').exists()
+
+  templates = sorted(p.parent.name for p in (NETSIM / 'ansible' / 'templates').glob('*/a10.j2'))
+  assert {'initial','ospf','routing','services','loadbalancer'} <= set(templates)
+
+
+def test_a10_readiness_proves_the_cli_not_just_ssh() -> None:
+  device = yaml.safe_load((NETSIM / 'devices' / 'a10.yml').read_text())
+  assert device['group_vars']['netlab_ready'] == ['ssh','ansible']
+  ready = yaml.safe_load((NETSIM / 'ansible' / 'tasks' / 'readiness-check' / 'a10.yml').read_text())
+  probe = ready[0]
+  cmds = probe['a10.acos_cli.acos_command']['commands']
+  assert 'configure terminal' in cmds and cmds[-1] == 'end'
+  assert probe['until'] == 'a10_ready is succeeded'
+  assert 'a10_config_retries' in str(probe['retries'])
diff --git a/tests/test_netmiko_wait_until_ready.py b/tests/test_netmiko_wait_until_ready.py
new file mode 100644
index 0000000..b82f8c6
--- /dev/null
+++ b/tests/test_netmiko_wait_until_ready.py
@@ -0,0 +1,82 @@
+"""A device that reports "still loading" in its CLI prompt is waited for, not configured early.
+
+PLATFORM-SPECIFIC: A10 vThunder answers `hostname <name>` with "Unrecognized command" while its
+prompt reads `vThunder(LOADING)#`.
+"""
+import pytest
+from box import Box
+
+from netsim.cli.initial import netmiko as nm
+
+
+class _FakeConn:
+  def __init__(self, prompts):
+    self.prompts = list(prompts)
+    self.polls = 0
+    self.base_prompt_resets = 0
+
+  def find_prompt(self):
+    self.polls += 1
+    return self.prompts.pop(0) if len(self.prompts) > 1 else self.prompts[0]
+
+  def set_base_prompt(self):
+    self.base_prompt_resets += 1
+
+
+def _topology(**group_vars):
+  gv = {'netlab_check_retries': 3, 'netlab_check_delay': 7, **group_vars}
+  return Box({'provider': 'kne', 'defaults': {'provider': 'kne', 'devices': {'a10': {'group_vars': gv}}}}, box_dots=True)
+
+
+def _node():
+  return Box({'name': 'lb1', 'device': 'a10', 'provider': 'kne'}, box_dots=True)
+
+
+def test_waits_for_a_loading_prompt_then_proceeds() -> None:
+  conn = _FakeConn(['vThunder(LOADING)#', 'vThunder(LOADING)#', 'vThunder#'])
+  slept: list = []
+  topo = _topology(netmiko_not_ready_regexp=r'\(LOADING\)')
+  assert nm._wait_until_ready(conn, _node(), topo, sleep=slept.append) is conn
+  assert slept == [7, 7]               # waited twice, once per LOADING prompt
+  assert conn.base_prompt_resets == 1  # the prompt changed, so the session re-learns it
+
+
+def test_a_ready_device_is_not_delayed() -> None:
+  conn = _FakeConn(['vThunder#'])
+  slept: list = []
+  assert nm._wait_until_ready(conn, _node(), _topology(netmiko_not_ready_regexp=r'\(LOADING\)'), sleep=slept.append) is conn
+  assert slept == [] and conn.base_prompt_resets == 0
+
+
+def test_a_device_that_never_loads_fails_within_the_budget() -> None:
+  conn = _FakeConn(['vThunder(LOADING)#'])
+  slept: list = []
+  assert nm._wait_until_ready(conn, _node(), _topology(netmiko_not_ready_regexp=r'\(LOADING\)'), sleep=slept.append) is None
+  assert len(slept) == 3 and conn.polls == 4   # retries=3: four looks, three waits, then give up
+
+
+def test_a_device_with_no_declared_signal_is_untouched() -> None:
+  conn = _FakeConn(['anything(LOADING)#'])
+  assert nm._wait_until_ready(conn, _node(), _topology(), sleep=lambda s: pytest.fail('must not wait')) is conn
+  assert conn.polls == 0
+
+
+class _ClosedConn(_FakeConn):
+  def find_prompt(self):
+    self.polls += 1
+    raise OSError('Socket is closed')
+
+
+def test_a_closed_session_during_the_wait_is_reconnected() -> None:
+  dead, fresh = _ClosedConn(['x']), _FakeConn(['vThunder#'])
+  topo = _topology(netmiko_not_ready_regexp=r'\(LOADING\)')
+  assert nm._wait_until_ready(dead, _node(), topo, reconnect=lambda: fresh, sleep=lambda s: None) is fresh
+  assert dead.polls == 1 and fresh.polls == 1
+
+
+def test_a_session_that_cannot_be_reestablished_fails_within_the_budget() -> None:
+  dead = _ClosedConn(['x'])
+  slept: list = []
+  topo = _topology(netmiko_not_ready_regexp=r'\(LOADING\)')
+  assert nm._wait_until_ready(dead, _node(), topo, reconnect=lambda: None, sleep=slept.append) is None
+  assert len(slept) == 3 and dead.polls == 4
diff --git a/tests/test_panos_initial_gates.py b/tests/test_panos_initial_gates.py
new file mode 100644
index 0000000..56d3486
--- /dev/null
+++ b/tests/test_panos_initial_gates.py
@@ -0,0 +1,235 @@
+"""PAN-OS bring-up: one transport, ordered gates, and a deploy lane that exists.
+
+A cold PAN-OS lies about readiness three ways, and each gate in
+netsim/ansible/tasks/panos/initial.yml exists because a full 80-pod bring-up
+paid for it:
+
+  * the pod is Ready long before the mgmt plane listens  -> SSH-port wait
+  * the CLI answers but only to change the password      -> promotion
+  * the credentials work while the first-boot AutoCom
+    job still refuses every commit                       -> job-table gate
+
+Everything rides the KNE SSH endpoint -- the XML API is not used. Two prior
+gates watched the wrong signal (chassis-ready flips before AutoCom FIN) or the
+wrong shape (the API's CDATA answer), so the fixtures below are CAPTURED from
+a live device's CLI, never taken from documentation.
+
+And the deploy lane itself is pinned: tasks/deploy-config/panos.yml was
+silently dropped once, every module template kept rendering into a skip, and
+the miss surfaced two stages later as the collector's SNMP validation timing out on
+exactly the PAN-OS nodes.
+"""
+
+import re
+from pathlib import Path
+
+import pytest
+import yaml
+
+TASKS = Path(__file__).parent.parent / "netsim" / "ansible" / "tasks"
+INITIAL = TASKS / "panos" / "initial.yml"
+DEPLOY_LANE = TASKS / "deploy-config" / "panos.yml"
+
+FIN_RE = r"AutoCom\s+FIN"
+OK_RE = r"AutoCom\s+FIN\s+OK"
+
+# Captured raw from a live VM-Series CLI, 2026-08-30. Whitespace columns; the
+# newest job is listed first, so a finished user Commit precedes AutoCom and
+# the match must land on AutoCom's own row.
+REAL_JOBS_OK = """
+Enqueued              Dequeued           ID  PositionInQ                              Type                         Status Result Completed
+------------------------------------------------------------------------------------------------------------------------------------------
+2026/08/30 19:32:53   19:32:53            4                                         Commit                            FIN     OK 19:33:55
+2026/08/30 18:43:54   18:43:54            2                                        AutoCom                            FIN     OK 18:45:26
+"""
+REAL_JOBS_RUNNING = REAL_JOBS_OK.replace(
+    "AutoCom                            FIN     OK", "AutoCom                            ACT   PEND"
+)
+REAL_JOBS_FAILED = REAL_JOBS_OK.replace(
+    "AutoCom                            FIN     OK", "AutoCom                            FIN   FAIL"
+)
+
+# Captured from sjc-dc1in-panos-fw1 on 2026-09-19 (demo-lab reconfigure,
+# an internal task). PAN-OS's job table is BOUNDED -- it holds roughly the last 29
+# jobs -- so on a device that has been reconfigured a few dozen times the
+# first-boot AutoCom (job 1 or 2) has AGED OUT and the table is nothing but
+# user commits. The AutoCom-only gate could never match this shape and spent
+# its whole 90-retry budget, 56 minutes, on BOTH DC firewalls, which were then
+# dropped from the play and got no configuration at all.
+REAL_JOBS_AGED_OUT = """
+Enqueued              Dequeued           ID  PositionInQ                              Type                         Status Result Completed
+------------------------------------------------------------------------------------------------------------------------------------------
+2026/09/18 22:50:16   22:50:16           30                                         Commit                            FIN     OK 22:51:30
+2026/09/18 22:48:42   22:48:42           29                                         Commit                            FIN     OK 22:49:51
+2026/09/18 18:38:49   18:38:49            3                                         Commit                            FIN     OK 18:39:59
+"""
+
+# A device that answered nothing: an empty transcript must never read as ready,
+# and it is the shape a refused login or a dead CLI produces.
+NO_TRANSCRIPT = ""
+
+
+def evaluate(expression, transcript):
+  """Evaluate the gate's REAL expression text against a captured transcript.
+
+  Not a reimplementation -- the string comes straight out of initial.yml, so a
+  mirror of the logic cannot drift away from the file it is meant to pin. The
+  `search` test is Ansible's; Jinja2 supplies everything else (`default`,
+  `is not`), which is exactly what Ansible evaluates `until:` and `assert.that`
+  with.
+  """
+  import jinja2
+
+  env = jinja2.Environment()
+  env.tests["search"] = lambda value, pattern: re.search(pattern, value) is not None
+  rendered = env.from_string("{{ (" + expression + ") is true }}").render(
+      panos_autocommit_job={"transcript": transcript})
+  assert rendered in ("True", "False"), f"expression did not evaluate to a boolean: {rendered!r}"
+  return rendered == "True"
+
+
+@pytest.fixture(scope="module")
+def tasks():
+  return yaml.safe_load(INITIAL.read_text())
+
+
+def names(tasks):
+  return [t.get("name", "") for t in tasks]
+
+
+def index_of(tasks, needle):
+  for i, name in enumerate(names(tasks)):
+    if needle in name:
+      return i
+  raise AssertionError(f"no task matching {needle!r} in {names(tasks)}")
+
+
+def test_gates_precede_the_config_push_and_ride_one_transport(tasks):
+  ssh_known = index_of(tasks, "KNE SSH endpoint for PAN-OS is known")
+  ssh_wait = index_of(tasks, "SSH endpoint to accept connections")
+  promotion = index_of(tasks, "Promote the PAN-OS admin password")
+  jobwait = index_of(tasks, "autocommit job to finish")
+  fin_assert = index_of(tasks, "Assert the PAN-OS autocommit finished")
+  ok_assert = index_of(tasks, "Assert the PAN-OS autocommit succeeded")
+  push = index_of(tasks, "Apply and commit the PAN-OS initial configuration")
+
+  assert ssh_known < ssh_wait < promotion, "no endpoint, no wait; no wait, no promotion"
+  assert promotion < jobwait, "the job table needs the promoted password"
+  assert jobwait < fin_assert < ok_assert < push, "no config may be pushed during the autocommit"
+
+  text = INITIAL.read_text()
+  assert "panos_kne_ssh_port" in text, "every beat targets the KNE SSH endpoint"
+  # Scan CODE, not commentary: the file deliberately narrates the retired API
+  # lane's history in comments, and history is not a relic.
+  code = "\n".join(l for l in text.splitlines() if not l.lstrip().startswith("#"))
+  for api_relic in ("keygen", "panos_api_key", "chassis-ready", "port: 443",
+                    "panos_interface:", "panos_virtual_router:", "panos_commit_firewall:",
+                    "paloaltonetworks.panos."):
+    assert api_relic not in code, f"XML-API relic {api_relic!r} survived the single-transport rewrite"
+
+
+def test_autocommit_gate_matches_the_captured_cli_table(tasks):
+  gate = tasks[index_of(tasks, "autocommit job to finish")]
+  assert re.search(FIN_RE, REAL_JOBS_OK), "a finished autocommit must match"
+  assert not re.search(FIN_RE, REAL_JOBS_RUNNING), "ACT/PEND must not read as finished"
+  assert not re.search(FIN_RE, ""), "an absent transcript must not read as finished"
+  assert re.search(OK_RE, REAL_JOBS_OK), "a succeeded autocommit must pass the OK assert"
+  assert not re.search(OK_RE, REAL_JOBS_FAILED), "FIN with FAIL must NOT pass -- only commit force clears it"
+  assert FIN_RE.replace("\\", "\\\\") in gate["until"] or FIN_RE in gate["until"]
+  assert gate["retries"] >= 60, "budget: measured FIN-by-T+15min, doubled"
+  assert gate.get("ignore_errors") is True, "an exhausted until sets failed itself; only ignore_errors reaches the asserts"
+
+  ok = tasks[index_of(tasks, "Assert the PAN-OS autocommit succeeded")]
+  assert "AutoCom" in str(ok["ansible.builtin.assert"]["that"])
+
+
+def test_an_aged_out_autocommit_row_does_not_cost_the_whole_budget(tasks):
+  """The gate must recognise a device that is LONG past first boot.
+
+  netlab initial runs on every reconfigure, and PAN-OS's job table holds only
+  its last ~29 jobs, so the first-boot AutoCom row disappears once a lab has
+  been reconfigured a few dozen times. Measured on demo-lab an internal task
+  (2026-09-19): both DC firewalls ran all 90 retries -- 56 minutes, 86% of the
+  job -- then failed the assert and were dropped from the play unconfigured,
+  while the other 182 nodes had been finished since T+5min.
+
+  A finished user Commit is PROOF the autocommit finished successfully: PAN-OS
+  refuses to queue one otherwise ("Commit job was not queued since auto-commit
+  not yet finished successfully"). It is only proof while no AutoCom row is
+  visible, and only alongside a positive match -- absence on its own is what a
+  dead CLI also looks like.
+  """
+  gate = tasks[index_of(tasks, "autocommit job to finish")]
+  fin = tasks[index_of(tasks, "Assert the PAN-OS autocommit finished")]
+  succeeded = tasks[index_of(tasks, "Assert the PAN-OS autocommit succeeded")]
+
+  for what, expression in (
+      ("until", gate["until"]),
+      ("finished assert", fin["ansible.builtin.assert"]["that"]),
+      ("succeeded assert", succeeded["ansible.builtin.assert"]["that"]),
+  ):
+    assert evaluate(expression, REAL_JOBS_OK), f"{what}: a cold device that finished must pass"
+    assert evaluate(expression, REAL_JOBS_AGED_OUT), \
+        f"{what}: an aged-out table full of finished commits must not cost 56 minutes"
+    assert not evaluate(expression, REAL_JOBS_RUNNING), \
+        f"{what}: a VISIBLE AutoCom in ACT/PEND always wins -- a finished commit beside it must not pass"
+    assert not evaluate(expression, NO_TRANSCRIPT), \
+        f"{what}: absence proves nothing; an empty transcript must keep waiting"
+
+  assert not evaluate(succeeded["ansible.builtin.assert"]["that"], REAL_JOBS_FAILED), \
+      "FIN with FAIL still refuses every commit -- only commit force clears it"
+  assert evaluate(fin["ansible.builtin.assert"]["that"], REAL_JOBS_FAILED), \
+      "FIN with FAIL is FINISHED: it must reach the succeeded assert's own message, not the wait's"
+
+
+def test_initial_push_uses_the_rendered_template_and_commits(tasks):
+  push = tasks[index_of(tasks, "Apply and commit the PAN-OS initial configuration")]
+  mod = push["panos_cli_config_kne"]
+  assert mod["commit"] is True
+  assert "panos_initial_config" in str(mod["lines"])
+  render = tasks[index_of(tasks, "Render the PAN-OS initial configuration")]
+  assert "config_template" in str(render["ansible.builtin.set_fact"]), \
+      "the initial baseline comes from templates/initial/panos.j2, netlab's own resolution"
+
+
+def test_the_module_deploy_lane_exists_and_guards_empty_renders():
+  """The lane's ABSENCE was a silent hole: templates rendered, then 'skipping',
+  and the miss surfaced two stages later as the collector's SNMP validation timeout.
+  The empty-render guard keeps the XML-API custom configs (firewall.policy,
+  nat, ipsec render deliberately-empty templates here) from double-applying."""
+  lane = yaml.safe_load(DEPLOY_LANE.read_text())
+  deploy = None
+  for task in lane:
+    if "panos_cli_config_kne" in task:
+      deploy = task
+  assert deploy is not None, "the lane must push through the same module as initial"
+  assert deploy["panos_cli_config_kne"]["commit"] is True
+  when = str(deploy.get("when"))
+  assert "trim" in when and "length" in when, "empty renders must deploy nothing"
+
+
+def test_the_cli_module_ships_with_the_lane():
+  mod = TASKS.parent / "library" / "panos_cli_config_kne.py"
+  assert mod.exists(), "the deploy lane and initial.yml both invoke this module"
+  text = mod.read_text()
+  assert "no_log=True" in text, "the password parameter must never reach the log"
+  assert "Configuration committed successfully" in text, "commit success is detected by the device's own phrase"
+
+
+def test_no_xml_api_task_lists_remain_in_the_plugin_dirs():
+  """The single-transport port: firewall.policy, zonebased and ipsec render
+  set-command templates pushed by deploy-config/panos.yml, all verified against
+  a live device (grammar probes + full commit on demo-lab jfk-fw01, 2026-08-31 --
+  including the one real grammar surprise, the ipsec-crypto-profile's SCALAR
+  dh-group). A deploy.panos.yml reappearing means someone reintroduced the
+  XML API lane; an emptied template means a module silently stopped rendering."""
+  extra = Path(__file__).parent.parent / "netsim" / "extra"
+  for plugin in ("firewall/policy", "firewall/zonebased", "ipsec", "nat"):
+    d = extra / plugin
+    assert not (d / "deploy.panos.yml").exists(), f"{plugin}: the XML-API task list is back"
+    tpl = d / "panos.j2"
+    assert tpl.exists(), f"{plugin}: panos.j2 is missing"
+    code = "\n".join(
+        l for l in tpl.read_text().splitlines() if l.strip() and not l.strip().startswith(("{#", "#"))
+    )
+    assert "set " in code, f"{plugin}: panos.j2 emits no set commands"
