diff --git a/netsim/ansible/templates/initial/panos.j2 b/netsim/ansible/templates/initial/panos.j2
new file mode 100644
index 0000000..0783e39
--- /dev/null
+++ b/netsim/ansible/templates/initial/panos.j2
@@ -0,0 +1,80 @@
+{% set vr_name = panos_virtual_router | default('default') %}
+{% set panos_mgmt_if = mgmt_if | default('mgmt') %}
+
+set deviceconfig system hostname {{ inventory_hostname | replace("_","-") }}
+
+set network profiles interface-management-profile netlab-ping ping yes
+
+{# LLDP. Global enable plus per-physical-interface `layer3 lldp enable yes`,
+   the exact seed syntax (demo-lab sjc-dc1in-panos-fw1 configuration.txt:
+   `lldp { enable yes; }` under each ethernet's layer3, and a top-level
+   `lldp { enable yes; }`). Without this the device never sources or is
+   sourced by any LLDP-derived adjacency, dropping every neighbor link a
+   collector infers from LLDP alone -- physical-port protocol, so it is set
+   on physical interfaces only, never on a VLAN subinterface. #}
+set network lldp enable yes
+
+{% for intf in interfaces | default([]) if intf.ifname != panos_mgmt_if and '.' not in intf.ifname %}
+{%   set zone_name = intf.firewall.zone | default(intf.panos_zone | default('netlab')) %}
+set network interface ethernet {{ intf.ifname }} layer3
+set network interface ethernet {{ intf.ifname }} layer3 interface-management-profile netlab-ping
+set network interface ethernet {{ intf.ifname }} layer3 lldp enable yes
+{%   if intf.ipv4 is defined %}
+set network interface ethernet {{ intf.ifname }} layer3 ip {{ intf.ipv4 }}
+{%   endif %}
+{%   set intf_mtu = intf.mtu | default(mtu | default(0)) | int %}
+{#   MTU only up to 1500. Anything larger needs the device-wide jumbo-frame
+     mode, which PAN-OS will not enable without a REBOOT -- the commit fails
+     with "device is not in jumbo-frame mode but interface ethernet1/1 mtu is
+     greater than 1500 ... Commit failed" (captured live, demo-lab 2026-08-31,
+     fabric MTU 8950). The retired API lane never set MTU at all, so the
+     device default (1500) is exactly the behaviour every certified run had.
+     If PAN-OS jumbo is ever needed, the fix is jumbo-frame mode plus a
+     managed reboot in the bring-up, not this line. #}
+{%   if intf_mtu > 0 and intf_mtu <= 1500 %}
+set network interface ethernet {{ intf.ifname }} layer3 mtu {{ intf_mtu }}
+{%   endif %}
+set network virtual-router {{ vr_name }} interface {{ intf.ifname }}
+{# NO `set vsys ... import`: VM-Series is single-vsys and the `set vsys`
+   subtree does not exist there -- a live device answers every such line with
+   "Invalid syntax." (demo-lab jfk-fw01/lax-fw01, 2026-08-31, first run of this
+   template against real hardware; the retired API lane imported through the
+   panos_interface module's vsys parameter instead). Zone membership imports
+   the interface into the vsys implicitly. #}
+set zone "{{ zone_name }}" network layer3 {{ intf.ifname }}
+{% endfor %}
+{# NO memberless zone creation: `set zone X network layer3` with no interface
+   is not a complete set statement and the device rejects it ("Invalid
+   syntax.", same capture). Zones referenced only by policy and bound to no
+   interface are created by the firewall.policy deploy lane when it writes the
+   rules, which is the only place that knows they are needed. #}
+
+{#
+  SUBINTERFACES. `layer3 units <parent>.<tag>` under the parent interface --
+  every line below was accepted verbatim by a live VM-Series (probe, demo-lab
+  jfk-fw01, 2026-08-31) before this block existed. Same zone/VR/mgmt-profile
+  treatment as physical interfaces, same implicit vsys import via the zone.
+#}
+{% for intf in interfaces | default([]) if intf.ifname != panos_mgmt_if and '.' in intf.ifname %}
+{%   set parent = intf.ifname.split('.')[0] %}
+{%   set tag = intf.ifname.split('.')[1] %}
+{%   set zone_name = intf.firewall.zone | default(intf.panos_zone | default('netlab')) %}
+set network interface ethernet {{ parent }} layer3 units {{ intf.ifname }} tag {{ tag }}
+set network interface ethernet {{ parent }} layer3 units {{ intf.ifname }} interface-management-profile netlab-ping
+{%   if intf.ipv4 is defined %}
+set network interface ethernet {{ parent }} layer3 units {{ intf.ifname }} ip {{ intf.ipv4 }}
+{%   endif %}
+set network virtual-router {{ vr_name }} interface {{ intf.ifname }}
+set zone "{{ zone_name }}" network layer3 {{ intf.ifname }}
+{% endfor %}
+{#
+  LOOPBACK. `loopback units <name> ip <addr>` -- probe-verified like the
+  subinterfaces. VR membership but NO zone, matching the retired API lane
+  (panos_loopback_interface took vr and vsys only); a loopback that needs a
+  zone can declare one the day a topology wants it.
+#}
+{% if loopback is defined and loopback.ipv4 is defined %}
+set network interface loopback units {{ loopback.ifname }} ip {{ loopback.ipv4 }}
+set network interface loopback units {{ loopback.ifname }} comment "netlab loopback"
+set network virtual-router {{ vr_name }} interface {{ loopback.ifname }}
+{% endif %}
