+  #   does not support module services
+  #
+  # Declared GLOBALLY, not under a provider key: add_device_module_support skips
+  # a device already present in a module's supported_on map, so a provider-scoped
+  # declaration can be silently ignored depending on registration order. Same
+  # shape 0038 used for the Viptela pair.
+  #
+  # server.snmp is deliberately ABSENT. Versa does not take an SNMP agent over
+  # this CLI, and the collector collects these with versa_director_api. Claiming server.snmp would
+  # make the fleet-wide attribute look renderable here and invite someone to
+  # emit syntax the NOS rejects.
+  services:
+    dns:
+      transport_vrf: false
+  sdwan:
+    types: [ controller ]
