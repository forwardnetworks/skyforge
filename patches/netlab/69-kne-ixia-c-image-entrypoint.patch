From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 5 Nov 2026 04:10:01 -0600
Subject: [PATCH] kne: ixia-c controller and traffic engine run their own image
 entrypoint

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/netsim/providers/kne.py b/netsim/providers/kne.py
index b1a5cf0..756369d 100644
--- a/netsim/providers/kne.py
+++ b/netsim/providers/kne.py
@@ -368,7 +368,11 @@ KNE_PRE_STARTUP_BOOTSTRAP_HOOKS: dict = {
   'cisco_sdwan-controller': (lambda node, topology: add_viptela_credentials(node,topology),),
   'cisco_sdwan-validator':  (lambda node, topology: add_viptela_credentials(node,topology),),
   'cisco_sdwan-manager':    (lambda node, topology: add_viptela_credentials(node,topology),),
-  'keysight_ixia-c-traffic-engine': (lambda node, topology: add_ixia_c_engine_env(node,topology),),
+  'keysight_ixia-c-controller': (lambda node, topology: add_ixia_c_entrypoint(node,topology),),
+  'keysight_ixia-c-traffic-engine': (
+    lambda node, topology: add_ixia_c_entrypoint(node,topology),
+    lambda node, topology: add_ixia_c_engine_env(node,topology),
+  ),
   'eos': (lambda node, topology: add_eos_bootstrap(node,topology),),
   'iosxr': (lambda node, topology: add_iosxr_bootstrap(node,topology),),
   'sros': (lambda node, topology: add_sros_bootstrap(node,topology),),
@@ -993,6 +997,27 @@ def add_viptela_credentials(node: Box, topology: Box) -> None:
   node.kne.env.VIPTELA_FACTORY_PASS = str(
     topology.get('sdwan.api_factory_password','') or 'admin')
 
+# What each ixia-c image runs as its OWN entrypoint, copied from the image
+# config (crane config): controller `Entrypoint: ./bin/controller`, engine
+# `Cmd: ./entrypoint.sh`. KNE gives every HOST node `sleep 2000000000000` as
+# its container command unless the topology sets one (topo/node/host/host.go),
+# and a container command REPLACES the image entrypoint -- so without these the
+# pods reach Running and never serve a thing (measured 2026-11-05: port 8443
+# refused on the controller). The controller refuses to start without
+# --accept-eula (measured: exit 1, "EULA must be accepted"); the owner has
+# approved this OTG lane, which is the acceptance.
+KNE_IXIA_C_COMMAND: dict = {
+  'keysight_ixia-c-controller': ['./bin/controller','--accept-eula'],
+  'keysight_ixia-c-traffic-engine': ['./entrypoint.sh'],
+}
+
+def add_ixia_c_entrypoint(node: Box, topology: Box) -> None:
+  """Run the ixia-c image's own entrypoint instead of KNE's HOST `sleep`."""
+  command = KNE_IXIA_C_COMMAND.get(node.device)
+  if not command:
+    return
+  node.kne.command = list(command)
+
 def add_ixia_c_engine_env(node: Box, topology: Box) -> None:
   """Give an ixia-c traffic engine the three settings that make it affordable.
 
diff --git a/netsim/templates/provider/kne/topology.pb.txt.j2 b/netsim/templates/provider/kne/topology.pb.txt.j2
