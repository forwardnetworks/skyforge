+def test_session_queue_for_a_lane_is_unchanged_and_commit_only_sends_just_the_commit():
+    cli = _module()
+    # today's lane session: lines, commit, leave configure mode, leave
+    assert cli.build_queue(["set a b", "set c d"], op_mode=False, do_commit=True) == [
+        "set cli scripting-mode on", "set cli pager off", "configure", "set a b", "set c d", "commit", "exit", "exit"]
+    # a staged lane: the same session without the commit
+    assert cli.build_queue(["set a b"], op_mode=False, do_commit=False) == [
+        "set cli scripting-mode on", "set cli pager off", "configure", "set a b", "exit", "exit"]
+    # the single commit: no set lines, just the commit
+    assert cli.build_queue([], op_mode=False, do_commit=True) == [
+        "set cli scripting-mode on", "set cli pager off", "configure", "commit", "exit", "exit"]
+    # op mode (the autocommit gate) is untouched
+    assert cli.build_queue(["show jobs all"], op_mode=True, do_commit=False) == [
+        "set cli scripting-mode on", "set cli pager off", "show jobs all", "exit"]
