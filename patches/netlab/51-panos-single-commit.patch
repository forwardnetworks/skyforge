+def test_the_flag_is_decided_only_in_the_playbook_that_owns_the_final_commit():
+    """netlab config / reload playbooks reach the same PAN-OS lanes. They must never see the flag, or they would
+    stage configuration nothing commits."""
+    for playbook in sorted(ANSIBLE.glob("*.ansible")):
+        text = playbook.read_text()
+        if playbook.name == "initial-config.ansible":
+            assert "panos_commit_deferred" in text and "tasks/panos/commit-pending.yml" in text
+        else:
+            assert "panos_commit_deferred" not in text, playbook.name
+    for lane in (TASKS / "panos" / "initial.yml", TASKS / "panos" / "routing.yml", TASKS / "deploy-config" / "panos.yml"):
+        assert "panos_commit_deferred | default(false)" in lane.read_text(), f"{lane.name}: undefined must mean per-lane commit"
+
+
+def _module():
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("panos_cli_config_kne_under_test", ANSIBLE / "library" / "panos_cli_config_kne.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
