@@ -50,24 +54,37 @@ def get_device_attribute(node: Box, attr: str, defaults: Box) -> typing.Optional
     if attr in devdata[provider]:        # Including the attribute we're looking for?
       pvalue = devdata[provider][attr]   # Get the provider value
       if not isinstance(pvalue,dict):    # Provider-specific value is not a dictionary
-        return pvalue                    # No chance of merging, return it
+        return (pvalue,False)            # No chance of merging, return it
   elif provider == 'kne' and 'clab' in devdata and attr in devdata.clab:
     pvalue = devdata.clab[attr]
     if not isinstance(pvalue,dict):
-      return pvalue
+      return (pvalue,False)
 
   value = devdata.get(attr,None)         # Non-specific device data
   if isinstance(value,Box) and isinstance(pvalue,Box):
-    # SKYFORGE-SPECIFIC: the merged table is the same for every node of this device type and provider; every caller still
-    # gets a copy of its own, as it always did (python-box creates keys when a missing one is read)
-    return fastbox.copy_box(memo.memo('device_attr',(id(defaults),devtype,provider,attr),(defaults,value,pvalue),lambda: value+pvalue,watch=(value,pvalue)))
+    # SKYFORGE-SPECIFIC: the merged table is the same for every node of this device type and provider
+    return (memo.memo('device_attr',(id(defaults),devtype,provider,attr),(defaults,value,pvalue),lambda: value+pvalue,watch=(value,pvalue)),True)
 
   if provider in devdata and attr in devdata[provider]:          # Do we have a provider-specific value?
-    return pvalue                        # Provider-specific dictionary overriding non-dictionary device value
+    return (pvalue,False)                # Provider-specific dictionary overriding non-dictionary device value
   if provider == 'kne' and 'clab' in devdata and attr in devdata.clab and pvalue is not None:
-    return pvalue
+    return (pvalue,False)
+
+  return (value,False)                   # Return whatever the device value is
 
-  return value                           # Return whatever the device value is
+def get_device_attribute(node: Box, attr: str, defaults: Box) -> typing.Optional[typing.Any]:
+  value,shared = _device_attribute(node,attr,defaults)
+  # SKYFORGE-SPECIFIC: every caller still gets a merged table of its own, as it always did (python-box creates keys
+  # when a missing one is read, and callers may modify what they get)
+  return fastbox.copy_box(value) if shared else value
+
+def get_device_attribute_readonly(node: Box, attr: str, defaults: Box) -> typing.Optional[typing.Any]:
+  """
+  SKYFORGE-SPECIFIC: get_device_attribute for callers that only READ the result with .get() and `in`. The value may
+  be shared with every other node of the device type: never modify it, and never read a missing key with attribute
+  or [] access (python-box would create it). Saves a copy of the table per call.
+  """
+  return _device_attribute(node,attr,defaults)[0]
 
