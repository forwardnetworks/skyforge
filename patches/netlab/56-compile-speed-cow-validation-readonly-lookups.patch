       log.fatal('netlab fastbox: add differs from Box.__add__')
   return result
 
+def _fill_deep(b: Box, src: dict, cfg0: dict, opts0: dict, ns: tuple, proto: Box) -> None:
+  """Like _fill, but a source BoxList is re-created as well: the result equals Box(src.to_dict()) for a Box source"""
+  safe = b._box_config['__safe_keys']
+  for k,v in dict.items(src):
+    if v is src:
+      raise _Slow('self reference')
+    if k.__class__ is str and ('.' in k or '[' in k):
+      raise _Slow(f'dotted key {k!r}')
+    if k.__class__ is str:
+      sk = _safe_str.get(k)
+      if sk is None:
+        sk = _safe_str[k] = proto._safe_attr(k)
+    else:
+      ck = (k.__class__,k)
+      sk = _safe_cache.get(ck)
+      if sk is None:
+        sk = _safe_cache[ck] = proto._safe_attr(k)
+    safe[sk] = k
+    if isinstance(v,_SCALARS):
+      dict.__setitem__(b,k,v)
+    elif isinstance(v,dict):
+      child = _new_box(cfg0,ns + (k,))
+      _fill_deep(child,v,cfg0,opts0,ns + (k,),proto)
+      dict.__setitem__(b,k,child)
+    elif isinstance(v,list):
+      dict.__setitem__(b,k,_make_list_deep(v,cfg0,opts0,ns + (k,),proto))
+    else:
+      dict.__setitem__(b,k,v)
+
+def _make_list_deep(src: list, cfg0: dict, opts0: dict, ns: tuple, proto: Box) -> BoxList:
+  bl = BoxList(**_child_options(opts0,ns))
+  for x in src:
+    if x is src:
+      raise _Slow('self reference')
+    if isinstance(x,dict):
+      child = _new_box(cfg0,ns)
+      _fill_deep(child,x,cfg0,opts0,ns,proto)
+      list.append(bl,child)
+    elif isinstance(x,list):
+      list.append(bl,_make_list_deep(x,cfg0,opts0,ns,proto))
+    else:
+      list.append(bl,x)
+  return bl
+
+def _deep_copy_fast(src: Box) -> Box:
+  _ensure_proto()
+  result = _new_box(_cfg0,())
+  _fill_deep(result,src,_cfg0,_opts0,(),_proto)
+  return result
+
+def deep_copy(src: Box) -> Box:
+  """
+  SKYFORGE-SPECIFIC: same result as get_box(src.to_dict()) -- a completely independent copy -- in one pass,
+  without building the intermediate plain dictionary.
+  """
+  if not enabled() or type(src) is not Box:
+    return Box(src.to_dict(),**_OPTS)
+  try:
+    result = _deep_copy_fast(src)
+  except _Slow:
+    return from_plain(to_dict(src))
+  if VERIFY:
+    expected = Box(src.to_dict(),**_OPTS)
+    if not same_structure(result,expected,check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: deep_copy differs from get_box(to_dict())')
+  return result
+
+
+def _set_item_fast(b: Box, key: typing.Any, value: typing.Any) -> None:
+  """Raw: what Box.__setitem__ / __convert_and_store do for a standard Box and a plain key; raises _Slow"""
+  _ensure_proto()
+  ns = b._box_config['box_namespace'] + (key,)
+  if isinstance(value,_SCALARS) or value is None:
+    stored = value
+  elif isinstance(value,dict):
+    if value is b:
+      raise _Slow('self reference')
+    stored = _new_box(_cfg0,ns)
+    _fill(stored,value,_cfg0,_opts0,ns,_proto)
+  elif isinstance(value,BoxList):
+    value.box_options.update(_child_options(_opts0,ns))
+    stored = value
+  elif isinstance(value,list):
+    stored = _make_list(value,_cfg0,_opts0,ns,_proto)
+  else:
+    stored = value
+  if key.__class__ is str:
+    sk = _safe_str.get(key)
+    if sk is None:
+      sk = _safe_str[key] = _proto._safe_attr(key)
+  else:
+    ck = (key.__class__,key)
+    sk = _safe_cache.get(ck)
+    if sk is None:
+      sk = _safe_cache[ck] = _proto._safe_attr(key)
+  b._box_config['__safe_keys'][sk] = key
+  dict.__setitem__(b,key,stored)
+
+def set_item(b: Box, key: typing.Any, value: typing.Any) -> None:
+  """
+  SKYFORGE-SPECIFIC: same result as b[key] = value (python-box re-creates a dictionary value as a Box, keeps a BoxList
+  and updates its options, makes a plain list a BoxList), without python-box's per-key conversion.
+  """
+  if not enabled() or type(b) is not Box or (isinstance(key,str) and ('.' in key or '[' in key)) or not _is_standard(b):
+    b[key] = value
+    return
+  try:
+    _set_item_fast(b,key,value)
+  except _Slow:
+    b[key] = value
+
+def set_reference(b: Box, key: str, value: typing.Any) -> None:
+  """
+  SKYFORGE-SPECIFIC: store `value` under `key` WITHOUT python-box's conversion (b[key] = value would copy a dictionary).
+  Only for a Box that is about to be copied as a whole (append_box, set_item, copy_box): the copy re-creates the value
+  exactly as an assignment would have, so the end result is the same and one copy is saved.
+  """
+  if not enabled() or type(b) is not Box or not isinstance(key,str) or '.' in key or '[' in key or not _is_standard(b):
+    b[key] = value
+    return
+  sk = _safe_str.get(key)
+  if sk is None:
+    sk = _safe_str[key] = _proto._safe_attr(key)
+  b._box_config['__safe_keys'][sk] = key
+  dict.__setitem__(b,key,value)
+
+def set_list(b: Box, key: typing.Any, value: list) -> None:
+  """
+  SKYFORGE-SPECIFIC: same result as b[key] = value for a plain list (python-box makes it a BoxList and re-creates every
+  dictionary in it), without python-box's per-item conversion. Anything unusual goes through python-box.
+  """
+  if not enabled() or type(b) is not Box or type(value) is not list or not isinstance(key,str) or '.' in key or '[' in key \
+     or not _is_standard(b):
+    b[key] = value
+    return
+  try:
+    bl = _make_list(value,_cfg0,_opts0,b._box_config['box_namespace'] + (key,),_proto)
+  except _Slow:
+    b[key] = value
+    return
+  sk = _safe_str.get(key)
+  if sk is None:
+    sk = _safe_str[key] = _proto._safe_attr(key)
+  b._box_config['__safe_keys'][sk] = key
+  dict.__setitem__(b,key,bl)
+  if VERIFY:
+    check = Box(**_OPTS)
+    object.__setattr__(check,'_box_config',dict(b._box_config,__safe_keys=dict(b._box_config['__safe_keys'])))
+    check[key] = value
+    if not same_structure(dict.__getitem__(b,key),dict.__getitem__(check,key),check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: set_list differs from python-box')
+
+def append_box(bl: BoxList, item: typing.Any) -> None:
+  """
+  SKYFORGE-SPECIFIC: same result as bl.append(item) (python-box re-creates a dictionary item as a Box configured by
+  the list's options), without python-box's per-key conversion. Anything unusual goes through python-box.
+  """
+  if not enabled() or type(bl) is not BoxList or type(item) not in (dict,Box):
+    bl.append(item)
+    return
+  _ensure_proto()
+  opts = bl.box_options
+  ns = opts.get('box_namespace',())
+  if opts.get('box_class',None) is not Box or not isinstance(ns,tuple) or \
+     {k:v for k,v in opts.items() if k != 'box_namespace'} != {k:v for k,v in _opts0.items() if k != 'box_namespace'}:
+    bl.append(item)
+    return
+  try:
+    child = _new_box(_cfg0,ns)
+    _fill(child,item,_cfg0,_opts0,ns,_proto)
+  except _Slow:
+    bl.append(item)
+    return
+  list.append(bl,child)
+  if VERIFY:
+    check = BoxList(**opts)
+    check.append(item)
+    if not same_structure(child,check[0],check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: append_box differs from python-box')
+
 def shallow(src: Box) -> Box:
   """
   A new top-level Box with the configuration and keys of `src` whose VALUES ARE THE SAME OBJECTS (no conversion).
@@ -322,6 +501,33 @@ def _run_self_test() -> bool:
     fast_add.merge_update(Box(other,**_OPTS))
     if not same_structure(fast_add,b2 + Box(other,**_OPTS),check_config=True):
       return False
+    b1, b2 = Box(_sample(),**_OPTS), Box(_sample(),**_OPTS)
+    if not same_structure(_deep_copy_fast(b1),Box(b2.to_dict(),**_OPTS),check_config=True):
