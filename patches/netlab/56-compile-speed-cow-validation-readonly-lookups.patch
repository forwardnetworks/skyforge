-  if not n_features:                     # SKYFORGE-SPECIFIC: nothing to merge, so this is just features.copy() (python-box
-    return fastbox.copy_box(features)    # ... builds that through its slow generic conversion; the result is the same)
+  if not n_features:                     # SKYFORGE-SPECIFIC: nothing to merge, so this is just features.copy() (one copy
