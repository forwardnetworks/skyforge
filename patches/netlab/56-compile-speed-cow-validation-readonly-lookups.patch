-_private_tables: typing.Dict[int,typing.Any] = {}         # id -> weakref of the merged tables handed to validations
+_private_tables: typing.Dict[int,typing.Any] = {}         # id -> (weakref, copied namespaces) of the tables handed out
+
+def cow_namespace(attributes: Box, atlist: str) -> typing.Any:
+  """
+  SKYFORGE-SPECIFIC copy-on-write. A validation gets its own top-level attribute table whose namespaces are shared
+  with the cached merged table (see resolve_attributes). The only change validation ever makes to that table is
+  stripping the _required flags of a secondary namespace (strip_secondary_namespace); copy that namespace into the
+  table first, so the validation sees exactly what a full private copy would show and the shared namespaces stay
+  untouched.
+  """
+  entry = _private_tables.get(id(attributes))
+  if entry is None or entry[0]() is not attributes or atlist in entry[1]:
+    return attributes[atlist]
+  entry[1].add(atlist)
+  shared = dict.__getitem__(attributes,atlist)
+  if isinstance(shared,Box):
+    dict.__setitem__(attributes,atlist,fastbox.copy_subtree(shared,(atlist,)))
+  return attributes[atlist]
+
+def strip_secondary_namespace(attributes: Box, atlist: str) -> dict:
+  """
+  What get_valid_attributes does with a secondary namespace that has a no_propagate list: take the attributes not in
+  that list and strip their _required flags -- in place, so the table it was given keeps the stripped flags
+  (the uncached code behaves that way, and later validations with the same table depend on it)
+  """
+  add_attr = cow_namespace(attributes,atlist)               # SKYFORGE-SPECIFIC: about to be modified, see cow_namespace
+  add_attr = { k:v for k,v in add_attr.items() if not k in attributes[f'{atlist}_no_propagate'] }
+  remove_required_flag(add_attr)
+  return add_attr
+
+def resolve_private(attributes: Box, entry: tuple, attr_list: typing.List[str]) -> tuple:
+  """
+  SKYFORGE-SPECIFIC: resolve_attributes for a table handed out by resolve_attributes (a recursive validation reuses
+  the merged table of its caller). The table is fully determined by the cached table it was made from and the set of
+  namespaces it has copied and stripped so far, so the namespaces and the valid-attribute table computed for it can
+  be remembered on exactly that key. A computation strips more namespaces in the table as a side effect; on a hit
+  the same namespaces are stripped again here, so the table ends up exactly as the computation would leave it.
+  """
+  _ref,stripped,base = entry
+
+  def compute() -> tuple:
+    before = set(stripped)
+    ns = get_attribute_namespaces(attributes,attr_list)
+    valid = get_valid_attributes(attributes,ns)
+    return (ns,valid,frozenset(stripped - before))
+
+  ns,valid,side_effects = memo.memo(
+    'validate_private',
+    (id(base),frozenset(stripped),tuple(attr_list)),
+    (base,),
+    compute)
+  for atlist in side_effects:                               # replay (a no-op when compute just ran)
+    if atlist not in stripped:
+      strip_secondary_namespace(attributes,atlist)
+  return (attributes,ns,valid)
 
 def resolve_attributes(
       attributes: Box,
@@ -738,9 +791,9 @@ def resolve_attributes(
     # No copy is made: the caller's own table is used (and modified) in place, exactly as before. A table that this
     # function handed out is private to one validation and different every time, so it is computed in place. A shared
     # table (the module attribute definitions) is stripped only the first time, so the answer can be remembered.
-    ref = _private_tables.get(id(attributes))
-    if ref is not None and ref() is attributes:
-      return compute()
