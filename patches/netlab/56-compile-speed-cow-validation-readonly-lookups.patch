+    if not same_structure(target1.nl,target2.nl,check_config=True) or not same_structure(target1,target2,check_config=True):
+      return False
+    t1, t2 = Box(_sample(),**_OPTS), Box(_sample(),**_OPTS)
+    src = Box(_sample(),**_OPTS)
+    for k, v in (('v1', src.h), ('v2', [src.d, {'q': src.h}]), ('v3', 7), ('v4', src.d), (5, {'w': [src.d]}), ('v5', None)):
+      _set_item_fast(t1,k,v)
