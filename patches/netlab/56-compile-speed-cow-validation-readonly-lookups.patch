+    if not same_structure(t1,t2,check_config=True) or t1._box_config['__safe_keys'] != t2._box_config['__safe_keys']:
+      return False
     sh = shallow(Box(_sample(),**_OPTS))
     if not same_structure(sh,Box(_sample(),**_OPTS)):
       return False
