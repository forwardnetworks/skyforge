From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:00 +0000
Subject: [PATCH] devices: F5 BIG-IP (f5)

---
diff --git a/docs/platforms.md b/docs/platforms.md
index c5fec46..7632027 100644
--- a/docs/platforms.md
+++ b/docs/platforms.md
@@ -31,6 +31,7 @@
 | Cumulus Linux 5.x (NVUE) [❗](caveats-cumulus-nvue) | cumulus_nvue | minimal |
 | Dell OS10 [❗](caveats-os10) | dellos10     | full          |
 | Extreme Networks EXOS [❗](caveats-exos) | exos | minimal  |
+| F5 BIG-IP VE | f5 | minimal |
 | Fortinet FortiOS [❗](caveats-fortios) | fortios | minimal  |
 | FRRouting (FRR) [❗](caveats-frr) | frr     | full          |
 | [Generic Linux host](generic-linux-devices) | linux | full          |
diff --git a/netsim/ansible/templates/initial/f5.j2 b/netsim/ansible/templates/initial/f5.j2
new file mode 100644
index 0000000..6a77b22
--- /dev/null
+++ b/netsim/ansible/templates/initial/f5.j2
@@ -0,0 +1 @@
+{# BIG-IP VE day-0 is handled by containerlab/vrnetlab. Keep netlab initial config empty for now. #}
diff --git a/netsim/devices/f5.yml b/netsim/devices/f5.yml
new file mode 100644
index 0000000..bec98aa
--- /dev/null
+++ b/netsim/devices/f5.yml
@@ -0,0 +1,35 @@
+---
+description: F5 BIG-IP VE load balancer
+support:
+  level: minimal
+interface_name: 1.{ifindex}
+mgmt_if: mgmt
+role: host
+clab:
+  image: vrnetlab/f5_bigip-ve
+  build: https://containerlab.dev/manual/kinds/f5_bigipve/
+  node:
+    kind: f5_bigip-ve
+    env:
+      PASSWORD: Labl@b!234
+      F5_NEW_PASSWORD: Labl@b!234
+  interface:
+    name: eth{ifindex}
+group_vars:
+  ansible_user: admin
+  ansible_ssh_pass: Labl@b!234
+  ansible_connection: ssh
+  ansible_network_os: f5
+  netlab_device_type: f5
+  netlab_ready: [ ssh ]
+  netlab_check_command: show sys version
+  netlab_check_retries: 180
+external:
+  image: none
+graphite.icon: server
+features:
+  initial:
+    roles: [ host ]
+  loadbalancer: {}
+kne:
+  interface.name: eth{ifindex}
-- 
2.56.0

