diff --git a/netsim/templates/provider/kne/iosxr/netlab-config.j2 b/netsim/templates/provider/kne/iosxr/netlab-config.j2
new file mode 100644
index 0000000..1227e59
--- /dev/null
+++ b/netsim/templates/provider/kne/iosxr/netlab-config.j2
@@ -0,0 +1,57 @@
+#!/bin/bash
+#
+# The platform XRd config wrapper: vendor netlab-config.sh + an XR BOOT-READINESS
+# GATE in front of the first apply.
+#
+# This is netsim/templates/provider/kne/iosxr/netlab-config.j2 as carried by
+# patches/netlab/01-kne-provider (it used to be a /etc/netlab/templates shadow of the
+# vendor file; Phase 0 folded it into the patch series).
+# Every iosxr `sh`-mode fragment execs through this wrapper via its
+# `#!/config/netlab/netlab-config.sh` shebang.
+#
+# WHY THE GATE (isolated 2026-08-14, docs/xrd-config-replace-proof-20260814.md
+# and memory reference-xrd-single-node-sigbus-is-boot-context-not-config-or-node):
+# netlab initial execs the first fragment ~30-60s after XRd pod start, while XR
+# is still processing its own startup config. /pkg/bin/config then either hits
+# the interactive "Would you like to proceed in configuration mode? [no]" gate
+# (non-terminal stdin -> "Unable to read from a non-terminal device") or
+# SIGBUSes outright. ztp's internal retry budget (6 tries x 5s ~= 30s) is far
+# shorter than XR's boot settle (~2-5 min), so the apply could NEVER win the
+# race. A bare pod accepts every apply at ~3 min post-start.
+#
+# The gate polls the PROVEN readiness probe (the same xrenv+xr_cli invocation
+# the config-replace contract captured running config with) until the CLI
+# answers, bounded at 8 minutes -- XR settles in 2-5. Once XR is up the probe
+# succeeds on the first try, so later fragments pay one xr_cli call each.
+# iosxr-scoped by construction: only iosxr fragments carry this shebang.
+source /pkg/bin/ztp_helper.sh
+
+readonly SKYFORGE_XR_BOOT_GATE="skyforge-xr-boot-readiness-gate"
+gate_deadline=480   # seconds; XR boots in 2-5 min, hard-fail at 8
+gate_interval=10
+gate_ready=0
+while [ "${SECONDS}" -lt "${gate_deadline}" ]; do
+  # Ready means the CLI ANSWERS: exit 0 AND non-empty output. A settled XR
+  # prints either the configured hostname line or an explicit no-such-item
+  # notice; a still-booting one errors out or prints nothing.
+  gate_out="$(/pkg/bin/xrenv /pkg/bin/xr_cli -n "show running-config hostname" 2>/dev/null)"
+  if [ "$?" -eq 0 ] && [ -n "${gate_out}" ]; then
+    gate_ready=1
+    break
+  fi
+  sleep "${gate_interval}"
+done
+if [ "${gate_ready}" -ne 1 ]; then
+  # LOUD, NAMED failure on BOTH streams: netlab's kne deploy_node_config
+  # captures stdout+stderr into the FatalError it reports per module.
+  echo "${SKYFORGE_XR_BOOT_GATE}: XR CLI did not answer 'show running-config hostname' within ${gate_deadline}s; refusing to apply ${1:-<no fragment>}" >&2
+  echo "${SKYFORGE_XR_BOOT_GATE}: XR CLI did not answer within ${gate_deadline}s; config apply refused"
+  exit 1
+fi
+
+tail -n +2 $1 > /tmp/config.conf # strip first line since config is rejected when shebang is present
+if grep -vE '^\s*(!|$)' /tmp/config.conf >/dev/null; then
+  xrapply /tmp/config.conf
+else
+  echo "No configuration to apply"
+fi
diff --git a/netsim/templates/provider/kne/iosxr/xrd-bootstrap.j2 b/netsim/templates/provider/kne/iosxr/xrd-bootstrap.j2
