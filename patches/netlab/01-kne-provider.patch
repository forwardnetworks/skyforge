+def test_kne_eos_isis_keeps_default_hello_padding(
+  tmp_path: Path,
+  monkeypatch: pytest.MonkeyPatch,
+) -> None:
+  # The KNE fabric link MTU (link_mtu, currently 1370) is sized for the overlay
+  # (overlay_mtu_headroom) and clamped onto the L2 interface MTU, so full-MTU
+  # padded ISIS hellos traverse the link. The earlier "isis hello padding
+  # disabled" workaround is therefore removed — default padding (ON) is kept so
+  # ISIS detects MTU mismatches loudly instead of masking them.
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ isis ]
+defaults.device: eos
+
+nodes:
+  r1:
+    device: eos
+    netlab_config_mode: sh
+  r2:
+    device: eos
+    netlab_config_mode: sh
+
+links:
+- r1-r2
+""")
+
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  isis_text = Path('node_files/r1/isis').read_text()
+  assert 'interface Ethernet1\n! r1 -> r2\n  isis enable Gandalf\n' in isis_text
+  assert 'isis hello padding disabled' not in isis_text
+
