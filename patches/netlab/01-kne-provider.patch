+# FORTIOS BOOTS ITS WHOLE CONFIG, AND RECONFIGURES OVER NETMIKO.
+#
+# The KNE provider puts the WHOLE rendered config into the FortiGate's
+# cloud-init user_data, and FortiOS reads that exactly once, at first boot of a
+# factory disk. So the runtime defaults declare it startup_only: at bring-up the
+# Ansible replay is duplication and is skipped. A reconfigure render (the
+# runtime sets NETLAB_KNE_RECONFIGURE) delivers over netmiko instead
+# (netlab_reconfigure_mode), because the running device will never re-read the
+# regenerated user_data. The boot payload itself must not depend on which
+# render it is.
+def _render_fortios(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch,
+      startup_only: bool,
+      reconfigure: bool) -> tuple[Box, bytes]:
+  tmp_path.mkdir(parents=True,exist_ok=True)
+  monkeypatch.chdir(tmp_path)
+  if reconfigure:
+    monkeypatch.setenv('NETLAB_KNE_RECONFIGURE','1')
+  else:
+    monkeypatch.delenv('NETLAB_KNE_RECONFIGURE',raising=False)
+  topo_file = write_topology(tmp_path,f"""
+provider: kne
+defaults.devices.fortios.features.initial.startup_only: {startup_only}
+defaults.devices.fortios.kne.group_vars.netlab_config_mode: startup
+defaults.devices.fortios.kne.group_vars.netlab_reconfigure_mode: netmiko
+module: [ ospf ]
+
+nodes:
+  fw1:
+    device: fortios
+  fw2:
+    device: fortios
+
+links:
+- fw1-fw2
+""")
+
+  init_log()
+  topology = create.run(['-o','config','-o','provider',str(topo_file)])
+  return topology, Path('node_files/fw1/startup-config').read_bytes()
+
+
+def test_kne_fortios_bringup_skips_the_replay_its_user_data_already_carried(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch) -> None:
+  topology, user_data = _render_fortios(tmp_path,monkeypatch,startup_only=True,reconfigure=False)
+  fw1 = topology.nodes.fw1
+
+  assert devices.get_node_group_var(fw1,'netlab_config_mode',topology.defaults) == 'startup'
+  assert fw1.kne.config_file == 'user_data'
+  # The payload IS the whole config: initial and the ospf module ...
+  assert b'config router ospf' in user_data
+  # ... so every module it carries is skipped by the Ansible lane ...
+  assert set(fw1.get('netlab_ansible_skip_module',[])) >= {'initial','ospf'}
+  # ... and nothing is sent over netmiko at bring-up.
+  assert ':netmiko' not in fw1.get('_node_config',{}).values()
+
+
