+def load_kubectl_json(cmd: list[str]) -> dict:
+  output = external_commands.run_command(
+             cmd,
+             check_result=True,
+             ignore_errors=True,
+             return_stdout=True)
+  if not isinstance(output,str) or not output:
+    return {}
+
+  try:
+    return json.loads(output)
+  except Exception:
+    return {}
