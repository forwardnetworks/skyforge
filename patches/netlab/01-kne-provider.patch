+# FORTIOS ZONES MUST EXIST BEFORE THE FIRST POLICY THAT NAMES ONE.
+#
+# firewall/zonebased/fortios.j2 was a dummy and the zones were left to a REST
+# task list (deploy.fortios.yml) that the custom-config deploy lookup never
+# finds (it searches extra/firewall.zonebased/). So no zone was ever created
+# and every firewall.policy rule naming one failed on the box, live on
+# demo-lab 2026-09-23: `node_check_object fail! for name LB_DMZ ...
+# Command fail. Return code -651`. The zones now render as CLI, in the
+# user_data and in the netmiko reconfigure, ahead of the first policy.
+_FORTIOS_ZONEBASED_TOPOLOGY = """
+provider: kne
+# zonebased listed FIRST on purpose: its deploy order must not depend on it.
+plugin: [ firewall.zonebased, firewall.policy ]
+defaults.devices.fortios.features.initial.startup_only: True
+defaults.devices.fortios.kne.group_vars.netlab_config_mode: startup
+
+nodes:
+  fw:
+    device: fortios
+    firewall.zonebased:
+      default_policy: {default_policy}
+      default_rules:
+      - {{ from_zone: trusted, to_zone: trusted, action: permit }}
+      - {{ from_zone: trusted, to_zone: untrusted, action: permit }}
+      - {{ from_zone: untrusted, to_zone: trusted, action: deny }}
+    firewall.policy:
+      rules:
+      - {{ name: web-in, action: permit, from_zone: untrusted, to_zone: dmz, services: [ HTTP ]{sequence} }}
+      - {{ name: ssh-in, action: permit, from_zone: untrusted, to_zone: trusted, services: [ SSH ] }}
+  h1:
+    device: linux
+  h2:
+    device: linux
+  h3:
+    device: linux
+
+links:
+- fw:
+    firewall.zone: trusted
+  h1:
+- fw:
+    firewall.zone: untrusted
+  h2:
+- fw:
+    firewall.zone: dmz
+  h3:
+"""
+
+
+def _render_fortios_zonebased(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch,
+      default_policy: str = 'deny',
+      sequence: str = '') -> Box:
+  monkeypatch.chdir(tmp_path)
+  monkeypatch.delenv('NETLAB_KNE_RECONFIGURE',raising=False)
+  topo_file = write_topology(tmp_path,_FORTIOS_ZONEBASED_TOPOLOGY.format(
+    default_policy=default_policy,sequence=sequence))
+  init_log()
+  return create.run(['-o','config','-o','provider',str(topo_file)])
+
+
+def _zone_block(text: str) -> str:
+  start = text.index('config system zone\n')
+  return text[start:text.index('\nend\n',start) + len('\nend\n')]
+
+
+def test_kne_fortios_zonebased_renders_zones_before_the_first_policy(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch) -> None:
+  topology = _render_fortios_zonebased(tmp_path,monkeypatch)
+  zonebased = Path('node_files/fw/firewall.zonebased').read_text()
+  policy = Path('node_files/fw/firewall.policy').read_text()
+  user_data = Path('node_files/fw/startup-config').read_text()
+
+  # Deploy order is policy -> zonebased whatever the plugin list says, so the
+  # specific rules land above the zone catch-alls.
+  config = topology.nodes.fw.config
+  assert config.index('firewall.policy') < config.index('firewall.zonebased')
+
+  zones = _zone_block(zonebased)
+  assert 'edit "trusted"\nset intrazone allow\nset interface "port2"\nnext\n' in zones
+  assert 'edit "untrusted"\nset intrazone deny\nset interface "port3"\nnext\n' in zones
+  assert 'edit "dmz"\nset intrazone deny\nset interface "port4"\nnext\n' in zones
+  # firewall.policy carries the same zone block ahead of its first policy ...
+  assert _zone_block(policy) == zones
+  assert policy.index('config system zone') < policy.index('config firewall policy')
+  # ... and so does the boot payload, before the first srcintf naming a zone.
+  assert user_data.index('config system zone') < user_data.index('set srcintf "untrusted"')
+
+
+def test_kne_fortios_zonebased_default_rules_take_their_own_ids_below_the_policy_rules(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch) -> None:
+  _render_fortios_zonebased(tmp_path,monkeypatch)
+  zonebased = Path('node_files/fw/firewall.zonebased').read_text()
+
+  # index 1 and 2 of default_rules (index 0 is intra-zone: it is the zone's
+  # `intrazone allow`, not a policy). Never `edit 0` (CLI: allocate a new ID,
+  # a duplicate on every replay) and never firewall.policy's 10/20.
+  assert 'edit 10010\nset name "trusted->untrusted (default)"\nset srcintf "trusted"\nset dstintf "untrusted"\nset action accept\n' in zonebased
+  assert 'edit 10020\nset name "untrusted->trusted (default)"\nset srcintf "untrusted"\nset dstintf "trusted"\nset action deny\n' in zonebased
+  assert '\nedit 0\n' not in zonebased and '\nedit 10\n' not in zonebased and '\nedit 20\n' not in zonebased
+  assert 'set service "ALL"' in zonebased and 'set schedule "always"' in zonebased
+  # Catch-alls below the last firewall.policy rule (sequence 20), in order.
+  assert zonebased.rstrip().endswith('move 10010 after 20\nmove 10020 after 10010\nend')
+  assert 'default-policy permit-all' not in zonebased
+
