+# A 137 inside this fraction of the ceiling is treated as an external kill worth
+# one more attempt; at or beyond it, the device is wedged and 137 is just how it
+# said so. 10% of 600s = 60s, comfortably above the 1-2s kills measured while
+# still refusing anything that looks like a real hang.
+KNE_EXEC_TRANSIENT_KILL_FRACTION = 0.10
+
+def capture_kne_pod_forensics(cmd: list[str]) -> tuple[str, bool | None]:
+  """Read the pod state a 124/137 exec failure is ALWAYS explained by, NOW.
+
+  WHY THIS IS INLINE AND NOT A NOTE TELLING THE READER TO GO LOOK.
+  The message this feeds used to end with "check the pod for restartCount > 0
+  and lastState.terminated". By the time anyone reads it that pod is gone: a
+  failed bring-up tears its namespace down, so the one field that distinguishes
+  "the container restarted underneath us" from "something else SIGKILLed the
+  exec" is unrecoverable. Measured 2026-08-28 on demo-lab: three runs of
+  the same 50-node topology failed 22, then 3, then 0 nodes with exit 137, and
+  the cause could not be established from any stored evidence because every pod
+  had already been deleted. Telling the reader to inspect a deleted object is
+  not a diagnostic.
+
+  Best-effort by construction: this runs inside an already-failing path, so it
+  never raises, never retries, and is bounded well under the caller's ceiling.
+  An empty string means "could not read it", which is reported as such rather
+  than rendered as healthy.
+  """
+  namespace = ''
+  pod = ''
+  try:
+    args = list(cmd or [])
+    for idx,tok in enumerate(args):
+      if tok in ('-n','--namespace') and idx + 1 < len(args):
+        namespace = str(args[idx + 1]).strip()
+      elif str(tok).startswith('--namespace='):
+        namespace = str(tok).split('=',1)[1].strip()
+    # The pod is the first bare argument after the kubectl verb -- everything
+    # before it is a flag, a flag value, or the `timeout` wrapper.
+    verb_idx = -1
+    for idx,tok in enumerate(args):
+      if tok in ('exec','logs','cp'):
+        verb_idx = idx
+        break
+    if verb_idx >= 0:
+      skip = False
+      for tok in args[verb_idx + 1:]:
+        tok = str(tok)
+        if skip:
+          skip = False
+          continue
+        if tok == '--':
+          break
+        if tok in ('-n','--namespace','-c','--container'):
+          skip = True
+          continue
+        if tok.startswith('-'):
+          continue
+        pod = tok.strip()
+        break
+  except Exception:
+    return ('', None)
+  if not namespace or not pod:
+    return ('', None)
+  jsonpath = ('{.status.phase}'
+              '|{.status.containerStatuses[0].restartCount}'
+              '|{.status.containerStatuses[0].lastState.terminated.reason}'
+              '|{.status.containerStatuses[0].lastState.terminated.exitCode}'
+              '|{.status.containerStatuses[0].lastState.terminated.finishedAt}'
+              '|{.status.containerStatuses[0].state.running.startedAt}')
+  try:
+    probe = subprocess.run(
+             ['kubectl','get','pod','-n',namespace,pod,'-o',f'jsonpath={jsonpath}'],
+             capture_output=True,check=False,timeout=15)
+    raw = (probe.stdout or b'').decode('utf-8','replace').strip()
+  except Exception:
+    return ('', None)
+  if not raw:
+    return ('', None)
+  parts = (raw.split('|') + [''] * 6)[:6]
+  phase,restarts,reason,exit_code,finished,started = [p.strip() for p in parts]
+  detail = f'pod phase={phase or "?"} restartCount={restarts or "0"}'
+  if reason or exit_code:
+    detail += f' lastState.terminated(reason={reason or "?"} exitCode={exit_code or "?"}'
+    if finished:
+      detail += f' finishedAt={finished}'
+    detail += ')'
+  else:
+    detail += ' lastState.terminated=<none: the container never died, so the SIGKILL came from outside it>'
+  if started:
+    detail += f' runningSince={started}'
+  # container_died is the RETRY PREDICATE, not decoration. None means "could not
+  # tell", which must never be read as "fine to retry".
+  container_died = bool(reason or exit_code)
+  return (detail, container_died)
+
+def run_kubectl_with_retries(cmd: list[str], retries: int = KNE_KUBECTL_OP_RETRIES) -> tuple[int, str, str]:
+  attempts = max(1,retries)
+  bounded_cmd = cmd
+  if KNE_KUBECTL_OP_TIMEOUT > 0 and cmd and cmd[0] != 'timeout':
+    bounded_cmd = ['timeout','-k',str(KNE_KUBECTL_OP_KILL_GRACE),str(KNE_KUBECTL_OP_TIMEOUT)] + cmd
+  last_stdout = ''
+  last_stderr = ''
+  for attempt in range(1,attempts + 1):
+    # Measured per ATTEMPT, so the reported duration is this exec's, never a sum.
+    op_started = time.time()
+    status_raw = external_commands.run_command(
+                  bounded_cmd,
+                  ignore_errors=True,
+                  check_result=True,
+                  return_exitcode=True)
+    status = status_raw if isinstance(status_raw,int) else 1
+    (last_stdout,last_stderr) = external_commands.get_captured_output()
+    last_stdout = last_stdout or ''
+    last_stderr = last_stderr or ''
+    if status == 0:
+      return (0,last_stdout,last_stderr)
+    if status in (124,137):
+      # Neither is retried: re-running the same exec re-burns the ceiling per
+      # attempt (4 x 600s of one node starving the deploy pool) for a result the
+      # first attempt already proved.
+      #
+      # 124 AND 137 ARE NOT THE SAME EVENT, and calling both "hit the ceiling"
+      # cost a whole investigation on 2026-08-18.
+      #   124 = OUR `timeout` fired. The exec really did outlive the ceiling.
+      #   137 = the process died on SIGKILL. That is usually the REMOTE end --
+      #         e.g. the container restarted underneath the exec -- and it can
+      #         happen far short of the ceiling. Run 42600 reported "exceeded
+      #         the 900s ceiling" for an exec that lasted 127 SECONDS, while the
+      #         pod showed restartCount 1 and lastState.terminated exitCode 143.
+      #         The message sent the reader to the timeout layer; the fault was
+      #         a container restart.
+      # Report the MEASURED duration either way, so the claim can always be
+      # checked against the clock rather than trusted.
+      elapsed = int(time.time() - op_started)
+      if status == 124:
+        why = (f'kubectl operation exceeded the {KNE_KUBECTL_OP_TIMEOUT}s ceiling '
+               f'(exit 124, ran {elapsed}s); not retried — a timed-out exec means the '
+               'remote end is wedged, not that the API blinked')
+      else:
+        why = (f'kubectl operation was SIGKILLed (exit 137, ran {elapsed}s of a '
+               f'{KNE_KUBECTL_OP_TIMEOUT}s ceiling); not retried. If it ran well short '
+               'of the ceiling this is the REMOTE end dying, not our deadline — check '
+               'the pod for restartCount > 0 and lastState.terminated before looking '
+               'at any timeout')
+      # CAPTURE THE ANSWER, DO NOT POINT AT IT. The pod is deleted with its
+      # namespace when the bring-up fails, so this is the only moment the
+      # question can still be answered.
+      forensics,container_died = capture_kne_pod_forensics(cmd)
+      if forensics:
+        why += f' | POD STATE AT FAILURE: {forensics}'
+      else:
+        why += ' | POD STATE AT FAILURE: could not be read (pod already gone or kubectl refused)'
+
+      # A 137 THAT DIED FAR SHORT OF THE CEILING IS TRANSIENT, AND RETRYING IT IS
+      # NEARLY FREE.
+      #
+      # The blanket "neither 124 nor 137 is retried" was right about 124 and wrong
+      # about 137, on its own stated reasoning: 124 means OUR timeout fired, so a
+      # retry burns another full ceiling on a device already proven wedged. A 137
+      # is the process being SIGKILLed, which this comment already notes "can
+      # happen far short of the ceiling" -- and a retry then costs the ELAPSED
+      # time, not the ceiling. Measured 2026-08-28 on iol-load-c: 2s of a 600s
+      # ceiling, so the ceiling argument buys nothing.
+      #
+      # Three conditions, because a 137 is not always transient:
+      #   * it must be a 137 (124 keeps the old behaviour exactly),
+      #   * it must have died in a small fraction of the ceiling -- a 137 AT the
+      #     ceiling is a wedged device wearing a different exit code,
+      #   * and the CONTAINER MUST NOT HAVE DIED. If lastState.terminated is
+      #     populated the device really restarted underneath us, and retrying
+      #     papers over a genuine fault. `None` (unreadable) does NOT qualify:
+      #     an unknown is not a yes.
+      transient_kill = (
+        status == 137
+        and container_died is False
+        and KNE_KUBECTL_OP_TIMEOUT > 0
+        and elapsed <= max(5,int(KNE_KUBECTL_OP_TIMEOUT * KNE_EXEC_TRANSIENT_KILL_FRACTION))
+      )
+      if transient_kill and attempt < attempts:
+        print(f'{why} | RETRYING: the container never died and this burned {elapsed}s of '
+              f'{KNE_KUBECTL_OP_TIMEOUT}s, so the kill came from outside the device '
+              f'(attempt {attempt} of {attempts})',
+              file=sys.stderr)
+        last_stderr = (last_stderr + '\n' if last_stderr else '') + why
+        time.sleep(KNE_KUBECTL_OP_RETRY_DELAY)
+        continue
+
+      last_stderr = (last_stderr + '\n' if last_stderr else '') + why
+      return (status,last_stdout,last_stderr)
+    if attempt < attempts:
+      time.sleep(KNE_KUBECTL_OP_RETRY_DELAY)
+
+  return (status,last_stdout,last_stderr)
+
+def stream_file_into_pod(
+      namespace: str,
+      node_name: str,
+      source_path: str,
+      target_path: str,
+      make_executable: bool = False) -> tuple[int, str, str]:
+  try:
+    payload = pathlib.Path(source_path).read_bytes()
+  except Exception as ex:
+    return (1,'',f'failed to read {source_path}: {ex}')
+
+  shell_cmd = f'cat > {shlex.quote(target_path)}'
+  if make_executable:
+    shell_cmd += f' && chmod 755 {shlex.quote(target_path)}'
+
+  try:
+    result = subprocess.run(
+              ['kubectl','exec','-i','-n',namespace,node_name,'--','sh','-c',shell_cmd],
+              input=payload,
+              capture_output=True,
+              check=False)
+  except Exception as ex:
+    return (1,'',str(ex))
+
+  stdout = result.stdout.decode(errors='replace') if isinstance(result.stdout,bytes) else str(result.stdout or '')
+  stderr = result.stderr.decode(errors='replace') if isinstance(result.stderr,bytes) else str(result.stderr or '')
+  return (result.returncode,stdout,stderr)
+
+def update_runtime_inventory(topology: Box) -> None:
+  if not pathlib.Path('hosts.yml').exists():
+    return
+
+  try:
+    inventory = Box().from_yaml(filename='hosts.yml',default_box=True,box_dots=True)
+  except Exception:
+    return
+
+  for node_name,node_data in topology.nodes.items():
+    for group_data in inventory.values():
+      if not isinstance(group_data,Box) or 'hosts' not in group_data:
+        continue
+      if node_name not in group_data.hosts:
+        continue
+      if 'ansible_host' in node_data:
+        group_data.hosts[node_name].ansible_host = node_data.ansible_host
+      if 'ansible_port' in node_data:
+        group_data.hosts[node_name].ansible_port = node_data.ansible_port
+      if 'ansible_httpapi_port' in node_data:
+        group_data.hosts[node_name].ansible_httpapi_port = node_data.ansible_httpapi_port
+      if 'sros_grpc_port' in node_data:
+        group_data.hosts[node_name].sros_grpc_port = node_data.sros_grpc_port
+      if 'panos_kne_ssh_port' in node_data:
+        group_data.hosts[node_name].panos_kne_ssh_port = node_data.panos_kne_ssh_port
+      if 'netmiko_port' in node_data:
+        group_data.hosts[node_name].netmiko_port = node_data.netmiko_port
+
+  pathlib.Path('hosts.yml').write_text(inventory.to_yaml())
+
+# --- Multi-access (shared-medium) segment support ----------------------------
+#
+# The KNE/meshnet dataplane is strictly point-to-point: every KNE link is an
+# a_node/a_int <-> z_node/z_int pair. netlab, however, natively models LANs (a
+# link with more than two member interfaces gets type "lan" and a shared
+# subnet). Bridge that gap at the EXPORT layer: for every multi-access link,
+# synthesize a hidden bridge NODE (a privileged HOST-vendor container that
+# enslaves its data interfaces into a Linux kernel bridge at boot) plus one
+# point-to-point KNE link per member interface. meshnet and the KNE
+# controllers only ever see p2p links, so nothing changes below this layer.
+# Two-member links keep the existing direct p2p path (no regression).
+#
+# What the user writes (netlab YAML):
+#   links:
+#   - r1-r2                  # plain p2p, unchanged
+#   - r1:                    # >2 members -> netlab type "lan"
+#     r2:
+#     r3:
+#     h1:
+#
+# What comes out (KNE textproto): one extra node "br-<linkindex>" (vendor
+# HOST, image from defaults.kne.bridge_image -> image_overrides.linux ->
+# devices.linux.kne.image -> alpine fallback) with data interfaces eth1..ethN
+# (one per member, in member order, member MTU mirrored), plus N p2p links
+# member-ifaceK <-> br-<linkindex>:ethK.
+#
+# Known limits:
+#   * spanning-tree is disabled on the synthesized bridge -- do not create
+#     loops between multi-access segments;
+#   * no VLAN trunking / VLAN-aware bridging across the segment yet (frames
+#     are flooded/learned flat, tagged frames pass through untouched);
+#   * the bridge node is hidden from netlab inventory/config management: no
+#     mgmt IP, no ansible inventory entry, not part of the runtime manifest
+#     node set (it never becomes a the collector device).
+
+KNE_BRIDGE_NAME_PREFIX = 'br'
+KNE_BRIDGE_FALLBACK_IMAGE = 'alpine:3.20'
+
+def kne_link_is_multi_access(link: Box) -> bool:
+  if link.get('type',None) in augment_links.VIRTUAL_INTERFACE_TYPES:
+    return False
+  return len(link.get('interfaces',[])) > 2
+
+def get_kne_bridge_name(link: Box) -> str:
+  return dns_1035_name(f'{KNE_BRIDGE_NAME_PREFIX}-{link.linkindex}',KNE_BRIDGE_NAME_PREFIX)
+
+def get_kne_bridge_image(topology: Box) -> str:
+  for path in (
+        'kne.bridge_image',
+        'providers.kne.bridge_image',
+        'kne.image_overrides.linux',
+        'devices.linux.kne.image'):
+    image = str(topology.defaults.get(path,None) or '').strip()
+    if image:
+      return image
+  return KNE_BRIDGE_FALLBACK_IMAGE
+
+def kne_bridge_boot_command(interfaces: list) -> list:
+  '''Boot command for the synthesized bridge node: wait for the meshnet-created
+  data interfaces, build a kernel bridge (STP off), enslave every data
+  interface, mirror member MTUs, then idle. Written against busybox sh
+  (iproute2 `ip` with brctl fallback) and free of double quotes so the
+  rendered textproto string needs no escaping.'''
+  ports = ' '.join([ str(entry['key']) for entry in interfaces ])
+  mtu_cmds = ''.join([
+    f"ip link set dev {entry['key']} mtu {entry['mtu']} 2>/dev/null || true; "
+      for entry in interfaces if normalize_interface_mtu(entry.get('mtu',None)) is not None
+  ])
+  script = (
+    f"PORTS='{ports}'; "
+    'while true; do ok=1; '
+    'for i in $PORTS; do test -d /sys/class/net/$i || ok=0; done; '
+    'test $ok -eq 1 && break; sleep 1; done; '
+    'ip link add name br0 type bridge 2>/dev/null || brctl addbr br0 2>/dev/null || true; '
+    'echo 0 > /sys/class/net/br0/bridge/stp_state 2>/dev/null || brctl stp br0 off 2>/dev/null || true; '
+    # A Linux bridge defaults group_fwd_mask=0, which silently drops the whole
+    # IEEE 802.1D reserved multicast range (01:80:c2:00:00:00-0F) -- including
+    # LLDP (...0e). Same defect fixed for KubeVirt's k6t-* bridges in
+    # components/vm-bridge-agent; this bridge is a plain container netns we
+    # already control at boot, so no external agent is needed here. 0x4000 =
+    # bit 14 = the LLDP multicast address only.
+    'echo 0x4000 > /sys/class/net/br0/bridge/group_fwd_mask 2>/dev/null || true; '
+    'for i in $PORTS; do '
+    'ip link set dev $i master br0 2>/dev/null || brctl addif br0 $i 2>/dev/null || true; '
+    'ip link set dev $i up; '
+    'done; '
+    + mtu_cmds +
+    'ip link set dev br0 up; '
+    'while true; do sleep 3600; done'
+  )
+  return ['/bin/sh','-c',script]
+
+def build_kne_bridge_interface_entries(link: Box) -> list:
+  entries: list = []
+  for idx,intf in enumerate(link.interfaces,start=1):
+    entry = { 'key': f'eth{idx}', 'name': f'eth{idx}' }
+    mtu = normalize_interface_mtu(intf.get('mtu',None)) if 'mtu' in intf else None
+    if mtu is not None:
+      entry['mtu'] = mtu
+    entries.append(entry)
+  return entries
+
+def build_kne_bridge_entries(topology: Box) -> list:
+  bridges: list = []
+  image = get_kne_bridge_image(topology)
+  for link in topology.get('links',[]):
+    if not kne_link_is_multi_access(link):
+      continue
+    interfaces = build_kne_bridge_interface_entries(link)
+    bridges.append(get_box({
+      'name': get_kne_bridge_name(link),
+      'vendor': 'HOST',
+      'model': 'host',
+      'os': 'linux',
+      'image': image,
+      'command': kne_bridge_boot_command(interfaces),
+      'interfaces': interfaces,
+      'linkindex': link.linkindex,
+    }))
+  return bridges
+
+def build_kne_link_entries(topology: Box) -> list:
+  kne_links: list = []
+  for link in topology.get('links',[]):
+    if link.get('type',None) in augment_links.VIRTUAL_INTERFACE_TYPES:
+      continue
+    if len(link.interfaces) < 2:
+      continue
+    if kne_link_is_multi_access(link):
+      bridge_name = get_kne_bridge_name(link)
+      for idx,intf in enumerate(link.interfaces,start=1):
+        kne_links.append({
+          'a_node': get_kne_node_name(topology.nodes[intf.node]),
+          'a_int': interface_key(topology.nodes[intf.node],intf,topology),
+          'z_node': bridge_name,
+          'z_int': f'eth{idx}',
+        })
+      continue
+    a_intf = link.interfaces[0]
+    z_intf = link.interfaces[1]
+    kne_links.append({
+      'a_node': get_kne_node_name(topology.nodes[a_intf.node]),
+      'a_int': interface_key(topology.nodes[a_intf.node],a_intf,topology),
+      'z_node': get_kne_node_name(topology.nodes[z_intf.node]),
+      'z_int': interface_key(topology.nodes[z_intf.node],z_intf,topology),
+    })
+
+  return kne_links
+
+def add_kne_mgmt_interface_entry(node: Box, node_intf_map: dict) -> None:
+  # Author the out-of-band management interface (pod eth0 -> NOS management
+  # ifname) as an explicit KNE interface-map entry for devices whose NOS builds
+  # its management interface from that map. This is the single source of truth
+  # for the management interface in netlab; the entry is translated faithfully
+  # downstream (KNE CR intfmapping -> EosIntfMapping.json ManagementIntf) so the
+  # NOS actually creates Management0. It adds no meshnet link and does not
+  # change NumInterfaces: KNE excludes pod eth0 from meshnet wiring and derives
+  # the interface count from the meshnet links, not this map.
+  if node.device not in KNE_ETH0_MGMT_DEVICES:
+    return
+  mgmt_key = KNE_MGMT_KERNEL_DEVICE
+  if mgmt_key in node_intf_map:
+    # A data link already claimed eth0 (does not happen for eos, whose data
+    # links start at eth1). Never clobber a real link mapping.
+    return
+  mgmt_ifname = get_kne_mgmt_ifname(node)
+  if not mgmt_ifname:
+    return
+  node_intf_map[mgmt_key] = {
+    'key': mgmt_key,
+    'name': mgmt_ifname,
+  }
+
+def build_kne_interface_map(topology: Box) -> dict:
+  node_interfaces: dict = { node.name: {} for node in topology.nodes.values() }
+  for link in topology.get('links',[]):
+    if link.get('type',None) in augment_links.VIRTUAL_INTERFACE_TYPES:
+      continue
+    for intf in link.interfaces:
+      entry = {
+        'key': interface_key(topology.nodes[intf.node],intf,topology),
+        'name': intf.ifname,
+      }
+      mtu = normalize_interface_mtu(intf.get('mtu',None)) if 'mtu' in intf else None
+      if mtu is not None:
+        entry['mtu'] = mtu
+      node_interfaces[intf.node][entry['key']] = entry
+
+  for node in topology.nodes.values():
+    add_kne_mgmt_interface_entry(node,node_interfaces[node.name])
+
+  return {
+    node_name: sorted(intf_data.values(),key=interface_sort_key)
+      for node_name,intf_data in node_interfaces.items()
+  }
+
+# IPv6 minimum link MTU (RFC 8200). The overlay-edge MTU is never floored below
+# this so IPv6-enabled interfaces stay legal regardless of the headroom setting.
+KNE_MIN_OVERLAY_MTU = 1280
+
+def get_kne_link_mtu(topology: Box) -> int | None:
+  return normalize_interface_mtu(topology.defaults.get('providers.kne.link_mtu',None))
+
+def get_kne_device_link_mtu(topology: Box) -> dict:
+  '''Per-device interface-MTU ceilings, keyed by netlab device name.
+
+  Some NOS impose a media-MTU limit BELOW the global underlay link_mtu (e.g.
+  containerized IOS-XR / XRd caps media MTU at 9000, and the iosxr config
+  template emits media MTU = interface_mtu + 14, so the interface MTU must stay
+  <= 8986). Those devices cannot accept the fabric link_mtu (9214 -> media
+  9228) and netlab initial-config apply dies on the out-of-range value before
+  anything else runs. This map lets apply_kne_link_mtu clamp such devices down
+  to a legal ceiling while every other NOS keeps the full jumbo link_mtu. The
+  cap is expressed as the INTERFACE (L3) MTU; each NOS template adds its own
+  media/L2 delta on top.'''
+  raw = topology.defaults.get('providers.kne.device_link_mtu',None)
+  caps: dict = {}
+  if isinstance(raw,dict):
+    for dev,val in raw.items():
+      norm = normalize_interface_mtu(val)
+      if norm is not None:
+        caps[dev] = norm
+  return caps
+
+def get_kne_overlay_headroom(topology: Box) -> int | None:
+  return normalize_interface_mtu(topology.defaults.get('providers.kne.overlay_mtu_headroom',None))
+
+def kne_overlay_edge_mtu(link_mtu: int, headroom: int | None) -> int | None:
+  '''Return the MTU for interfaces that carry pre-encap overlay payload, or None
+  when no headroom is configured. = link_mtu - headroom, floored at the IPv6 min.'''
+  if headroom is None or headroom <= 0:
+    return None
+  return max(link_mtu - headroom, KNE_MIN_OVERLAY_MTU)
+
+def kne_intf_is_overlay_edge(intf: Box) -> bool:
+  '''True when an interface carries un-encapsulated overlay payload (a bridged or
+  IRB access port, or an access/native VLAN member). Such interfaces must reserve
+  room for the NOS's own overlay header (VXLAN/MPLS/GRE/...). Routed underlay
+  transport interfaces return False. Detection is intentionally positive-only:
+  anything we cannot confidently classify as overlay keeps link_mtu, so this can
+  never shrink a fabric link and re-create a blackhole.'''
+  mode = intf.get('_vlan_mode',None)
+  if mode in ('bridge','irb'):
+    return True
+  vlan = intf.get('vlan',None)
+  if isinstance(vlan,dict) and (vlan.get('access',None) or vlan.get('native',None)):
+    return True
+  return False
+
+def kne_link_is_overlay_edge(link: Box) -> bool:
+  '''A link is an overlay-edge (access) segment if ANY of its interfaces carries
+  overlay payload. All interfaces on such a link share the same L2 broadcast
+  domain, so every endpoint must reserve the same overlay headroom -- including
+  plain hosts (e.g. linux) whose own interface has no VLAN metadata. This avoids
+  an asymmetric pair (leaf access port at edge MTU, host side at link_mtu) that
+  would silently blackhole frames between the two MTUs.'''
+  for intf in link.get('interfaces',[]):
+    if kne_intf_is_overlay_edge(intf):
+      return True
+  return False
+
+def kne_device_initial_features(node: Box, topology: Box) -> Box:
+  '''features.initial for a node, or an empty Box when it declares no device.
+
+  Synthetic/partial nodes reach this hook in unit tests and in half-built
+  topologies; get_device_attribute indexes defaults.devices by the device name
+  and raises on an absent one, so ask only when there is a name to ask about.'''
+  if not node.get('device',None):
+    return Box({},default_box=True)
+  return devices.get_device_features(node,topology.defaults).get('initial',Box({},default_box=True))
+
+def kne_device_mtu_ceiling(node: Box, topology: Box, device_caps: dict) -> int | None:
+  '''The largest interface MTU this node's NOS will actually accept.
+
+  DERIVED, never enumerated. netlab already publishes every device's own limit
+  as features.initial.max_mtu, and netlab enforces it in augment.nodes.cleanup_mtu
+  -- but that runs during augment, long before this provider hook writes the
+  fabric link_mtu, so its guard never sees the value we write. Nothing downstream
+  re-checks it, and a NOS over its ceiling does not fail: it accepts the config
+  line and DISCARDS it in silence.
+
+  Cisco IOL is the case that cost us. max_mtu 1500; `mtu 8950` was rendered onto
+  every lab interface in startup.cfg; no error anywhere; running-config kept no
+  mtu line at all and `show interfaces` reported MTU 1500 -- while the linux /
+  vJunos / cEOS ends of those same links stayed at 8950 and blackholed every
+  frame over 1500 with no ICMP, because the IOL end is an L2 switch. Reading the
+  ceiling off the device declaration fixes the whole class, not just IOL:
+  ioll2 (parent: iol), iosvl2 (4700), eos (9194) and srlinux (9500) are all
+  below an 8950 fabric and were all being handed a value they cannot take.
+
+  providers.kne.device_link_mtu remains an OVERRIDE, for ceilings TIGHTER than
+  the device declares -- iosxr declares 9216 but its template adds a +14 media
+  delta on top of the interface MTU, so 4470 is the usable figure. Whichever of
+  the two is smaller wins.'''
+  ceilings = []
+  cap = device_caps.get(node.get('device',None))
+  if cap is not None:
+    ceilings.append(cap)
+  declared = normalize_interface_mtu(kne_device_initial_features(node,topology).get('max_mtu',None))
+  if declared is not None:
+    ceilings.append(declared)
+  return min(ceilings) if ceilings else None
+
+def kne_sync_use_ip_mtu(node: Box, intf: Box, topology: Box) -> None:
+  '''Re-run netlab's physical-vs-IP MTU decision for a value written after augment.
+
+  augment.nodes.cleanup_mtu sets intf._use_ip_mtu when the interface MTU is below
+  the device's min_phy_mtu; that flag is what makes ios.j2 emit `ip mtu N` rather
+  than a bare `mtu N`. It ran before this hook, so it judged an MTU we have since
+  changed, and the flag it left behind is stale in both directions.
+
+  On IOL this is not cosmetic. min_phy_mtu is 1501 and max_mtu is 1500, so EVERY
+  legal value needs the flag: emit a bare `mtu 1500` and IOL discards it exactly
+  as silently as it discarded `mtu 8950`, leaving the same asymmetric link.'''
+  min_phy = normalize_interface_mtu(kne_device_initial_features(node,topology).get('min_phy_mtu',None))
+  mtu = normalize_interface_mtu(intf.get('mtu',None))
+  if min_phy is None or mtu is None:
+    return
+  if mtu < min_phy:
+    intf._use_ip_mtu = True
+  else:
+    intf.pop('_use_ip_mtu',None)
+
+def apply_kne_link_mtu(topology: Box) -> None:
+  link_mtu = get_kne_link_mtu(topology)
+  if link_mtu is None:
+    return
+
+  edge_mtu = kne_overlay_edge_mtu(link_mtu,get_kne_overlay_headroom(topology))
+  device_caps = get_kne_device_link_mtu(topology)
+
+  for link in topology.get('links',[]):
+    if link.get('type',None) in augment_links.VIRTUAL_INTERFACE_TYPES:
+      continue
+    target = link_mtu
+    if edge_mtu is not None and kne_link_is_overlay_edge(link):
+      target = edge_mtu
+    # Lower the ENTIRE link to the smallest per-device ceiling among the nodes
+    # attached to it. Both ends of a link must keep a matching MTU (an
+    # asymmetric link breaks OSPF/IS-IS neighbor formation and PMTUD), so a
+    # single MTU-capped device (e.g. XRd, media <= 9000) pulls its neighbors
+    # down to the same value rather than leaving a mismatch.
+    for intf in link.interfaces:
+      node = topology.nodes.get(intf.node,None)
+      if node is None:
+        continue
+      dev_cap = kne_device_mtu_ceiling(node,topology,device_caps)
+      if dev_cap is not None and dev_cap < target:
+        target = dev_cap
+    for intf in link.interfaces:
+      node = topology.nodes.get(intf.node,None)
+      if node is None or devices.get_provider(node,topology.defaults) != 'kne':
+        continue
+      intf_mtu = normalize_interface_mtu(intf.get('mtu',None))
+      if intf_mtu is None or intf_mtu > target:
+        intf.mtu = target
+      kne_sync_use_ip_mtu(node,intf,topology)
+      for node_intf in node.get('interfaces',[]):
+        same_interface = (
+          node_intf.get('ifindex',None) == intf.get('ifindex',None) or
+          node_intf.get('ifname',None) == intf.get('ifname',None))
+        same_link = node_intf.get('linkindex',None) == link.get('linkindex',None)
+        if not same_interface or not same_link:
+          continue
+        node_intf_mtu = normalize_interface_mtu(node_intf.get('mtu',None))
+        if node_intf_mtu is None or node_intf_mtu > target:
+          node_intf.mtu = target
+        kne_sync_use_ip_mtu(node,node_intf,topology)
+
+def run_kne_hooks(node: Box, topology: Box, hooks: tuple) -> None:
+  for hook in hooks:
+    hook(node,topology)
+
+def ceos_identity_seed(node: Box, topology: Box) -> str:
+  topo_name = str(topology.get('name','topology') or 'topology')
+  return f'{topo_name}/{node.name}'
+
+def ceos_deterministic_serial(node: Box, topology: Box) -> str:
+  seed = ceos_identity_seed(node,topology).encode('utf-8')
+  return hashlib.sha256(seed).hexdigest()[:32].upper()
+
+def ceos_deterministic_system_mac(node: Box, topology: Box) -> str:
+  seed = ('ceos-mac/' + ceos_identity_seed(node,topology)).encode('utf-8')
+  digest = hashlib.sha256(seed).digest()
+  mac = bytearray(digest[:6])
+  mac[0] = (mac[0] | 0x02) & 0xfe
+  return f'{mac[0]:02x}{mac[1]:02x}.{mac[2]:02x}{mac[3]:02x}.{mac[4]:02x}{mac[5]:02x}'
+
+def kne_management_return_cidrs(topology: Box) -> str:
+  cidrs = topology.defaults.get('kne.management_return_cidrs',None)
+  if cidrs is None:
+    cidrs = topology.defaults.get('providers.kne.management_return_cidrs',None)
+  if cidrs is None:
+    cidrs = os.environ.get('NETLAB_KNE_MANAGEMENT_RETURN_CIDRS','')
+
+  if isinstance(cidrs,str):
+    values = [ item.strip() for item in cidrs.split(',') ]
+  elif isinstance(cidrs,list):
+    values = [ str(item).strip() for item in cidrs ]
+  else:
+    values = []
+
+  return ','.join([ item for item in values if item ])
+
+def adjust_iol_node_data(kne_data: Box, node: Box) -> None:
+  '''Give every IOL node its own IOL APPLICATION ID.
+
+  IOL derives its interface MACs from that id: aabb.cc00.<id><port>0. The id
+  exists because IOL was built to run many instances on ONE host, where it
+  disambiguates both the NetIO socket namespace and the MAC space. We run one
+  IOL per pod in its own netns, so the socket half is pod-private and the id
+  looked irrelevant -- and the image hardcoded local-app 1 for every node.
+
+  The L2 domain the veths share is NOT pod-private. Every IOL node therefore
+  owned the identical MAC set {aabb.cc00.0110, ...0120, ...0130}, and IOS drops
+  a frame whose source MAC matches any interface it owns. Result: EVERY
+  IOL-to-IOL adjacency on the platform was dead -- ARP requests from both ends,
+  never a single reply -- while IOL-to-cEOS worked, because cEOS MACs never
+  collide with IOL's set. Proven 2026-08-17 by tcpdump on the segment bridge in
+  deployment vrfrepro2: three nodes, all transmitting as aa:bb:cc:00:01:10,
+  zero replies. It survived undetected because the collector collects over
+  MANAGEMENT, so a lab with a dead fabric still syncs, collects and validates.
+
+  node.id is netlab's own per-topology node ordinal (augment/nodes.py), so it
+  is unique within the lab -- which is exactly the scope a MAC must be unique
+  in -- stable across reruns, and already bounded by defaults.const.MAX_NODE_ID.
+  Clamped to 1..255 because the id occupies one byte of the MAC; a topology
+  bigger than that would silently re-collide, so it fails loudly instead.
+  '''
+  kne_data.env = kne_data.get('env',Box(default_box=True,box_dots=True))
+  node_id = int(node.get('id',0) or 0)
+  if node_id < 1 or node_id > 255:
+    log.error(
+      f'Cannot assign a unique IOL application id to node {node.name}: node id {node_id} is outside 1..255',
+      more_data=[
+        'IOL encodes the application id in one byte of every interface MAC (aabb.cc00.<id><port>0).',
+        'Two IOL nodes sharing an id share their MACs, and IOS silently drops frames whose',
+        'source MAC it also owns -- the adjacency looks up/up and passes no traffic.',
+      ],
+      category=log.FatalError,
+      module='kne')
+    return
+  kne_data.env.IOL_RUNNER_LOCAL_APP = str(node_id)
+
+def adjust_eos_node_data(kne_data: Box, node: Box, topology: Box, cfg_mode: str) -> None:
+  kne_data.env = kne_data.get('env',Box(default_box=True,box_dots=True))
+  kne_data.env.pop('CLAB_MGMT_VRF',None)
+  kne_data.env.INTFTYPE = eos_intftype(node,topology)
+  kne_data.env.ETBA = '1'
+  kne_data.env.MAPETH0 = '1'
+  kne_data.env.MGMT_INTF = 'eth0'
+  mgmt_return_cidrs = kne_management_return_cidrs(topology)
+  if mgmt_return_cidrs:
+    kne_data.env.SKYFORGE_MGMT_RETURN_CIDRS = mgmt_return_cidrs
+    mgmt_return_mtu = normalize_interface_mtu(
+      os.environ.get('NETLAB_KNE_MANAGEMENT_RETURN_MTU','') or topology.defaults.get('providers.kne.link_mtu',None))
+    if mgmt_return_mtu is not None:
+      kne_data.env.SKYFORGE_MGMT_RETURN_MTU = str(mgmt_return_mtu)
+  if not kne_data.env.get('SERIALNUMBER',None):
+    kne_data.env.SERIALNUMBER = str(node.get('eos.serialnumber',None) or ceos_deterministic_serial(node,topology))
+  if not kne_data.env.get('SYSTEMMACADDR',None):
+    kne_data.env.SYSTEMMACADDR = str(node.get('eos.systemmacaddr',None) or ceos_deterministic_system_mac(node,topology))
+
+  if cfg_mode not in ('sh','cp_sh'):
+    return
+
+  desired_retries = devices.get_node_group_var(node,'netlab_check_retries',topology.defaults)
+  current_retries = kne_data.get('netlab_check_retries',0)
+  if isinstance(desired_retries,int) and desired_retries > current_retries:
+    kne_data.netlab_check_retries = desired_retries
+
+def adjust_csrx_node_data(kne_data: Box, node: Box, topology: "Box | None" = None) -> None:
+  node.netlab_config_mode = node.get('netlab_config_mode','startup') or 'startup'
+  requested_image = str(kne_data.get('image',None) or node.get('box','') or '').strip()
+  if not requested_image or requested_image == 'csrx:23.4R1.9':
+    requested_image = 'contrailk8sdayone/csrx:latest'
+  kne_data.image = requested_image
+  node.box = kne_data.image
+  kne_data.config_path = '/config'
+  kne_data.config_file = 'juniper.conf'
+  kne_data.env = kne_data.get('env',Box(default_box=True,box_dots=True))
+  if not kne_data.env.get('CSRX_ROOT_PASSWORD',None):
+    # The container sets root's password from this env at boot; netlab then
+    # logs in as root with the device's ansible_ssh_pass. ONE credential, read
+    # from the device data, so the two cannot drift -- this used to be the
+    # literal 'kne123' against a device file that says clab123.
+    root_pw = None
+    if topology is not None:
+      root_pw = devices.get_node_group_var(node,'ansible_ssh_pass',topology.defaults)
+    kne_data.env.CSRX_ROOT_PASSWORD = str(root_pw or 'kne123')
+  if not kne_data.env.get('CSRX_JUNOS_CONFIG',None):
+    kne_data.env.CSRX_JUNOS_CONFIG = '/config/juniper.conf'
+  if not kne_data.env.get('CSRX_PORT_NUM',None):
+    kne_data.env.CSRX_PORT_NUM = str(node.get('kne.env.CSRX_PORT_NUM',len(node.get('interfaces',[])) + 1))
+
+  cfg_items = kne_data.get('config_templates',[])
+  if cfg_items:
+    kne_data.config_templates = [
+      item for item in cfg_items
+        if config_template_source(item) not in ('hosts','netlab-config')
+    ]
+
+def adjust_panos_node_data(kne_data: Box, disable_startup_for_node: bool) -> None:
+  if disable_startup_for_node:
