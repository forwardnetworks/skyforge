+  topo_file = write_topology(tmp_path,"""
+provider: kne
+defaults.devices.iol.features.initial.startup_only: True
+defaults.devices.iol.kne.group_vars.netlab_config_mode: startup
+
+nodes:
+  r1:
+    device: iol
