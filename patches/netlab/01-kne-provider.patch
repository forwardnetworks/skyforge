+def get_kne_service_port_data(services: dict, service_name: str, mgmt_service: Box | None) -> dict:
+  if not isinstance(mgmt_service,Box):
+    return {}
+
+  mgmt_names = [ str(name or '').strip().lower() for name in mgmt_service.get('names',[]) ]
+  mgmt_names += [ str(mgmt_service.get('name','') or '').strip().lower() ]
+  mgmt_name_set = set(filter(None,mgmt_names))
+  mgmt_ports = {
+    normalize_port_value(mgmt_service.get('outside',0)),
+    normalize_port_value(mgmt_service.get('inside',0)),
+  }
+  mgmt_ports.discard(0)
+
+  for svc in services.get('items',[]):
+    if svc.get('metadata',{}).get('name') != service_name:
+      continue
+    for port_data in svc.get('spec',{}).get('ports',[]):
+      port_name = str(port_data.get('name','') or '').strip().lower()
+      service_port = normalize_port_value(port_data.get('port',0))
+      target_port = normalize_port_value(port_data.get('targetPort',0))
+      if port_name in mgmt_name_set or service_port in mgmt_ports or target_port in mgmt_ports:
+        return port_data
+
+  return {}
+
+def get_kne_nodeport(services: dict, service_name: str, mgmt_service: Box | None) -> int:
+  port_data = get_kne_service_port_data(services,service_name,mgmt_service)
+  return normalize_port_value(port_data.get('nodePort',0))
+
+def get_kne_service_cluster_port(services: dict, service_name: str, mgmt_service: Box | None) -> int:
+  port_data = get_kne_service_port_data(services,service_name,mgmt_service)
+  return normalize_port_value(port_data.get('port',0))
+
+def get_kne_service_port(services: dict, service_name: str, svc: Box | None, cluster: bool) -> int:
+  # The port that pairs with the address family in use: the service port with
+  # the ClusterIP, the NodePort with a node address. Never mix them.
+  if cluster:
+    return get_kne_service_cluster_port(services,service_name,svc)
+  return get_kne_nodeport(services,service_name,svc)
+
+def get_kne_service_cluster_ip(services: dict, service_name: str) -> str:
+  for svc in services.get('items',[]):
+    if svc.get('metadata',{}).get('name') != service_name:
+      continue
+    cluster_ip = str(svc.get('spec',{}).get('clusterIP','') or '').strip()
+    if cluster_ip and cluster_ip.lower() != 'none':
+      return cluster_ip
+
+  return ''
+
+def running_in_kubernetes() -> bool:
+  return bool(str(os.environ.get('KUBERNETES_SERVICE_HOST','') or '').strip())
+
+def get_kne_runtime_host(nodes: dict) -> str:
+  for node in nodes.get('items',[]):
+    for addr in node.get('status',{}).get('addresses',[]):
+      if addr.get('type') == 'InternalIP' and addr.get('address'):
+        return addr['address']
+
+  return ''
+
+def get_kne_pod_node(pods: dict, pod_name: str) -> str:
+  for pod in pods.get('items',[]):
+    if pod.get('metadata',{}).get('name') == pod_name:
+      return pod.get('spec',{}).get('nodeName','')
+
+  return ''
+
+def get_kne_node_ip(nodes: dict, node_name: str) -> str:
+  for node in nodes.get('items',[]):
+    if node.get('metadata',{}).get('name') != node_name:
+      continue
+    for addr in node.get('status',{}).get('addresses',[]):
+      if addr.get('type') == 'InternalIP' and addr.get('address'):
+        return addr['address']
+
+  return ''
