+def test_kubectl_exec_reads_the_output_the_real_run_command_captured(monkeypatch: pytest.MonkeyPatch) -> None:
+  # Runs the REAL external_commands.run_command (only subprocess.run is faked), so the provider has to read the
+  # captured output through whatever API upstream's run_command writes it with. Every other test in this file
+  # fakes run_command itself, which is how patch 01 kept reading CAPTURED_STDOUT after upstream (ff52463be9)
+  # replaced the module globals with a thread-local: all tests passed and every `netlab initial` died.
+  from netsim.providers.kne import run_kubectl_with_retries
+  init_log()
+  calls: list[list[str]] = []
+
+  def fake_subprocess_run(cmd: list[str], **kwargs: object) -> CompletedProcess:
+    calls.append(list(cmd))
+    return CompletedProcess(cmd,0,stdout='the stdout',stderr='the stderr')
+
+  monkeypatch.setattr(external_commands.subprocess,'run',fake_subprocess_run)
+  rc, out, err = run_kubectl_with_retries(['kubectl','get','pods'],retries=1)
+  assert (rc,out,err) == (0,'the stdout','the stderr')
+  assert calls
+
+  def failing_subprocess_run(cmd: list[str], **kwargs: object) -> CompletedProcess:
+    return CompletedProcess(cmd,3,stdout='partial',stderr='boom')
+
+  monkeypatch.setattr(external_commands.subprocess,'run',failing_subprocess_run)
+  rc, out, err = run_kubectl_with_retries(['kubectl','get','pods'],retries=1)
+  assert rc == 3 and out == 'partial' and 'boom' in err
+
