diff --git a/netsim/ansible/templates/initial/cat8000v-kne.j2 b/netsim/ansible/templates/initial/cat8000v-kne.j2
new file mode 100644
index 0000000..a3d6064
--- /dev/null
+++ b/netsim/ansible/templates/initial/cat8000v-kne.j2
@@ -0,0 +1,197 @@
+{#
+  Catalyst 8000V day-0 on the KNE provider.
+
+  TWO DEVICES SHARE THIS MODEL. A cat8000v with no SD-WAN role is a plain
+  IOS-XE router and gets the stock day-0 (ios.j2, unchanged, via the include
+  at the bottom). A cat8000v that the sdwan module has made a fabric EDGE gets
+  a CONTROLLER-MODE bootstrap instead: the cloud-init document Cisco documents
+  for virtual platforms, named ciscosdwan_cloud_init.cfg on the day-0 disk.
+
+  WHY A BOOTSTRAP AND NOT A CONFIG. A C8000V boots AUTONOMOUS unless it finds
+  this file at first boot (searched on bootflash, USB, CDROM0 and CDROM1 --
+  Cisco SD-WAN onboarding guide, "mode change with a bootstrap file"), and an
+  autonomous router is not a WAN edge no matter what it is configured with.
+  Measured on demo-lab 2026-08-31: four cat8000v edges, every one collected by
+  the collector as a healthy IOS-XE router, none of them known to the fabric. The
+  file is what changes the MODE; the config inside it is what the device then
+  runs in that mode.
+
+  THE FOUR THINGS THE DEVICE LOOKS FOR are vinitparam otp, uuid, vbond and org.
+  uuid BECOMES the chassis number of a virtual device; otp is what it presents
+  to the validator on its first DTLS session; both must match a pair the
+  manager's vEdge list holds, and the sdwan module mints that pair once
+  (_push_edge_identity) for this template AND the onboarding roster. rcc: true
+  with the ca-certs section installs the fabric's enterprise root CA, the same
+  anchor the controllers carry.
+
+  THE CONFIG HALF IS IOS-XE SD-WAN SYNTAX, not classic IOS. Controller mode
+  keeps management in VRF Mgmt-intf (Cisco's own generated bootstrap does),
+  and the transport interface needs BOTH halves to be a WAN interface: the
+  Tunnel<N> in the IOS block and the tunnel-interface under `sdwan`. Without
+  the second the device counts the interface but forms no control connection
+  (the same finding as the controllers' overlay, see cisco_sdwan.cloudconfig.j2).
+
+  RENDERED BY netlab create, so pure Jinja2 plus the filters netlab registers
+  (ansible.utils.ipaddr is one; ios.j2 relies on it too).
+#}
+{% if sdwan.fabric_role | default('') == 'edge' %}
+Content-Type: multipart/mixed; boundary="==BOUNDARY=="
+MIME-Version: 1.0
+
+--==BOUNDARY==
+Content-Type: text/cloud-config; charset="us-ascii"
+MIME-Version: 1.0
+Content-Transfer-Encoding: 7bit
+Content-Disposition: attachment; filename="cloud-config"
+
+#cloud-config
+vinitparam:
+ - otp : {{ sdwan.token }}
+ - vbond : {{ sdwan.vbond_address }}
+ - uuid : {{ sdwan.chassis }}
+ - org : {{ sdwan.organization }}
+ - rcc : true
+{% if sdwan.root_ca_pem is defined and sdwan.root_ca_pem %}
+ca-certs:
+  remove-defaults: false
+  trusted:
+  - |
+{{ sdwan.root_ca_pem | trim | indent(4, true) }}
+{% endif %}
+--==BOUNDARY==
+Content-Type: text/cloud-boothook; charset="us-ascii"
+MIME-Version: 1.0
+Content-Transfer-Encoding: 7bit
+Content-Disposition: attachment; filename="config-{{ sdwan.chassis }}.txt"
+
+#cloud-boothook
+hostname {{ inventory_hostname }}
+!
+no ip domain lookup
+ip domain name netlab.local
+!
+username admin privilege 15 secret 0 {{ sdwan.declared_password | default('admin') }}
+enable secret 0 {{ sdwan.declared_password | default('admin') }}
+aaa new-model
+aaa authentication login default local
+aaa authorization exec default local
+crypto key generate rsa modulus 2048
+ip ssh version 2
+!
+vrf definition Mgmt-intf
+ address-family ipv4
+ exit-address-family
+!
+system
+ system-ip {{ sdwan.system_ip }}
+ site-id {{ sdwan.site_id }}
+ organization-name "{{ sdwan.organization }}"
+ vbond {{ sdwan.vbond_address }} port 12346
+!
+interface {{ mgmt.ifname | default('GigabitEthernet1') }}
+ description management
+ vrf forwarding Mgmt-intf
+ ip address dhcp
+ no shutdown
+!
+{#
+  THE ONLY FILE CHANNEL INTO A CONTROLLER-MODE EDGE. Its leaf certificate has
+  to land on bootflash:sdwan/ before `request platform software sdwan
+  certificate install` can take it (measured 2026-09-06: the command accepts
+  only local files; `copy` on 17.18 has no `vrf` keyword, and tclsh is
+  refused in controller mode). `copy http://...` therefore has to source from
+  the management interface, which lives in VRF Mgmt-intf -- and that is a
+  configuration line, so it belongs here, in day-0, not in the lane.
+#}
+ip http client source-interface {{ mgmt.ifname | default('GigabitEthernet1') }}
+!
+{% for t in sdwan.transport_interfaces | default([]) %}
+interface {{ t.ifname }}
+ description transport {{ t.color | default('default') }}
+ ip address {{ t.ipv4 | ansible.utils.ipaddr('address') }} {{ t.ipv4 | ansible.utils.ipaddr('netmask') }}
+{% if t.mtu is defined and t.mtu | int <= 1500 %}
+{#- Day-0 is CVAC, NOT vManage, so the template-model restriction that bans
+    `ip mtu` from the service template does not apply here. The DEVICE ceiling
+    still does: `ip mtu` cannot exceed the L2 MTU, which is 1500 on a cat8000v
+    (measured: Gi1/2/3 all "MTU 1500 bytes"). Above that the line is refused,
+    and on this path a refusal is dropped in SILENCE -- which is why netlab
+    0057 appeared to work here for so long while never taking effect. -#}
+ ip mtu {{ t.mtu }}
+{% endif %}
+ no shutdown
+!
+interface Tunnel{{ loop.index }}
+ ip unnumbered {{ t.ifname }}
+ tunnel source {{ t.ifname }}
+ tunnel mode sdwan
+ no shutdown
+!
+{% if t.gateway is defined and t.gateway %}
+ip route 0.0.0.0 0.0.0.0 {{ t.gateway }}
+!
+{% endif %}
+{% endfor %}
+sdwan
+{% for t in sdwan.transport_interfaces | default([]) %}
+ interface {{ t.ifname }}
+{% if t.nat is defined and t.nat %}
+{#- DIA: NAT lives entirely under the SD-WAN interface hierarchy on a
+    controller-mode edge, not classic `ip nat outside` -- there is no ACL/ip
+    nat pool model here, the VRF-scoped `ip nat route vrf N 0.0.0.0/0 global`
+    in the service template is what actually selects which traffic uses it.
+    Source: cisco.catalystwan's own cisco_vpn_interface feature-template
+    schema (vendor/ansible_collections/cisco/catalystwan/plugins/
+    module_utils/feature_templates/cisco_vpn_interface.py) models a VPN0
+    interface's NAT purely as `nat: bool` + `nat_choice: Interface` (this
+    edge's own address, no pool) -- there is no separate ACL/pool config to
+    author for the single-outside-interface case this lane covers.
+
+    `overload` is NOT implied by nat_choice: Interface -- measured live,
+    2026-09-20: `nat / direction outside` alone reached the device (present
+    in running-config, `show ip nat translations` responded instead of
+    erroring) but translated nothing, 0 entries under real LHR->Internet
+    traffic. The collection's own test fixture
+    (playbooks/tests/test_feature_templates.yml) sets nat_choice: Interface
+    and overload: true as two INDEPENDENT fields on the same interface,
+    never one implying the other -- PAT (many inside hosts, one outside
+    address) has to be requested explicitly. #}
+  nat
+   direction outside
+   overload
+  exit
+{% endif %}
+  tunnel-interface
+   encapsulation ipsec
+   color {{ t.color | default('default') }}
+   allow-service all
+   allow-service sshd
+   allow-service netconf
+  exit
+ exit
+{% endfor %}
+!
+{% if services.server.snmp is defined %}
+{#
+  SNMP AGENT, INSIDE THE BOOTHOOK. netlab's KNE provider appends every module
+  fragment (services, routing, ...) to this file AFTER the closing MIME
+  boundary, where CVAC never reads it -- so the `snmp-server community` line
+  services/cat8000v.j2 renders has never reached a controller-mode edge.
+  Measured on demo-lab 2026-09-12: all four cat8000v edges silent on UDP/161
+  from inside the lab namespace while a cEOS neighbour answered, and the
+  rendered startup-config carried the line on the far side of the boundary.
+  the collector's SNMP performance gate then held the whole lab DEGRADED on
+  jfk-vedge01. Rendering it HERE is the day-0 management contract every other
+  NOS gets from the services module; it is management setup, not overlay
+  state, and the service-side lane's read-back-and-graft keeps it because it
+  is part of the running configuration vManage holds.
+#}
+snmp-server community {{ services.server.snmp.community | default('skyforge') }} RO
+!
+{% endif %}
+line vty 0 4
+ transport input ssh
+!
+--==BOUNDARY==--
+{% else %}
+{% include 'ios.j2' %}
+{% endif %}
diff --git a/netsim/ansible/templates/initial/linux-kne.j2 b/netsim/ansible/templates/initial/linux-kne.j2
new file mode 100644
index 0000000..3cf9856
--- /dev/null
+++ b/netsim/ansible/templates/initial/linux-kne.j2
@@ -0,0 +1,242 @@
+{% from "initial/linux/create-bond.j2" import create_bond_dev %}
+{#
+  WARM-RECONFIGURE IDEMPOTENCY CONTRACT (proven live on quick-fleet8/app 2026-08-14):
+  this script is RE-EXECUTED on running hosts (kne deploy_node_config runs `sh <target>`;
+  linux is an honest replace-refusal, so reconfigure re-applies additively). The old
+  `ip addr del` + `ip addr add` cycle exits 0 on re-run but SILENTLY WIPES every static
+  route through that subnet's gateway: deleting the address drops the connected route and
+  the kernel garbage-collects the static routes behind it. `ip addr replace` is a kernel
+  no-op when the address is already present -- no route churn, no window, same day-0 result.
+  Do NOT reintroduce del/add here; netlab_runtime_test.py pins this as a text contract.
+#}
+
+{% macro ifconfig(intf) %}
+{% if intf.ipv4 is defined %}
+{%   if intf.ipv4 is string %}
+ip addr replace {{ intf.ipv4 }} dev {{ intf.ifname }}
+{%   elif '_unnumbered_peer' in intf %}
+ip addr replace {{ intf._parent_ipv4 }} peer {{ intf._unnumbered_peer }} dev {{ intf.ifname }}
+{%   endif %}
+{% endif %}
+sysctl -w net.ipv6.conf.{{ intf.ifname.replace('.','/') }}.disable_ipv6={{ '0' if intf.ipv6 is defined else '1' }}
+{% if intf.ipv6|default(false) is string %}
+ip -6 addr replace {{ intf.ipv6 }} dev {{ intf.ifname }}
+{% endif %}
+{% if intf.mtu is defined %}
+target_mtu="{{ intf.mtu }}"
+current_mtu="$(ip -o link show dev {{ intf.ifname }} 2>/dev/null | sed -n 's/.* mtu \([0-9][0-9]*\).*/\1/p' | head -n 1)"
+if [ -n "$current_mtu" ] && [ "$current_mtu" -lt "$target_mtu" ] 2>/dev/null; then
+  target_mtu="$current_mtu"
+fi
+ip link set dev {{ intf.ifname }} mtu "$target_mtu"
+{% endif %}
+{% if intf.shutdown|default(False) %}
+ip link set dev {{ intf.ifname }} down
+{% endif %}
+{% endmacro %}
+
+### One-Shot configuration (non-Ubuntu VM or container)
+#
+# Fail LOUDLY: the kne deploy loop reads this script's exit status. The old template
+# only enabled errexit as a side effect of the first del/add toggle; now that the
+# toggles are gone, declare it explicitly so a failed config command still fails the
+# deploy instead of exiting 0 over corrupted state. Every command below either must
+# succeed on the linux images we run (proven by 4 days of deployed fleet labs that
+# ran the tail of this script under errexit) or carries its own `|| true`.
+set -e
+#
+# Send ARP requests from a sane source IP address
+sysctl -w net.ipv4.conf.all.arp_announce=2
+
+#
+# Enable or disable IPv4 and IPv6 forwarding
+#
+{#
+   IP forwarding is controlled with the 'netlab_ip_forwarding' group variable. If that
+   variable is not set, the IP forwarding is controlled by the node 'role' (which is
+   assumed to be 'host' when missing
+#}
+{% set pkt_fwd = "1" if netlab_ip_forwarding|default(role|default("host") == "router") else "0" %}
+sysctl -w net.ipv4.ip_forward={{ pkt_fwd }}
+sysctl -w net.ipv6.conf.all.forwarding={{ pkt_fwd }}
+{% if loopback is defined %}
+{{ ifconfig(loopback) }}
+{% endif %}
+
+#
+# MANAGEMENT ROUTING
+#
+# netlab is about to move this host's DEFAULT route to the lab gateway
+# (features.initial.mgmt_vrf is declared for linux, so roles/host.py emits
+# 0.0.0.0/0 via the data-plane gateway instead of per-pool statics). That is
+# what makes a missing lab route fail LOUDLY here instead of leaking out the
+# management interface and dying somewhere far away.
+#
+# Everything that must keep using management therefore needs an EXPLICIT
+# route, installed before that default moves.
+#
+# Deliberately NOT a VRF. Enslaving eth0 into one was measured on a live lab:
+# inbound management worked, and outbound broke completely -- an unbound
+# socket cannot egress through an l3mdev-enslaved device, and BusyBox has no
+# `ip vrf exec` to bind one. Host-originated collection, DNS and fetches all
+# stayed dead. eth0 stays in the main table.
+#
+# The gateway is read from the pod's existing default route, which is still
+# present at this point; the CIDR list is configuration (skyforge_mgmt_cidrs),
+# so a cluster with different ranges needs no template change.
+#
+{% set mgmt_cidrs = skyforge_mgmt_cidrs|default([]) %}
+{% if mgmt_cidrs %}
+mgmt_gw="$(ip -4 route show default dev eth0 2>/dev/null | awk '{print $3; exit}')"
+if [ -n "$mgmt_gw" ]; then
+{%   for cidr in mgmt_cidrs %}
+  ip route replace {{ cidr }} via "$mgmt_gw" dev eth0
+{%   endfor %}
+  echo "management routes: {{ mgmt_cidrs|join(' ') }} via $mgmt_gw dev eth0"
+else
+  # No management default to learn the gateway from. Say so: the default route
+  # is about to point at the lab, and without these routes this host will be
+  # unreachable for management.
+  echo "WARNING: no management gateway found on eth0; management routes NOT installed"
+fi
+{% endif %}
+
+#
+# Interface addressing, create any bond devices
+#
+{% for intf in interfaces if intf.type in ['lan','p2p','stub','loopback','lag','bond'] %}
+{%   if intf.type in ['loopback','stub','lag','bond'] %}
+if [ ! -e /sys/class/net/{{ intf.ifname }} ]; then
+  if [ ! -e /sys/devices/virtual/net/{{ intf.ifname }} ]; then
+{%   if intf.type in ['lag','bond'] %}
+{{     create_bond_dev(intf,node_provider) }}
+{%   else %}
+    ip link add {{ intf.ifname }} type dummy
+{%   endif %}
+  fi
+fi
+{%   endif %}
+ip link set dev {{ intf.ifname }} up
+{{ ifconfig(intf) }}
+{% endfor %}
+
+# Keep the baked-in SSH contract available even though KNE HOST nodes override
+# the container command with `sleep ...` and bypass the image entrypoint.
+if command -v usermod >/dev/null 2>&1 && command -v mkpasswd >/dev/null 2>&1; then
+  usermod -p "$(mkpasswd -m sha512 -S skyforge admin)" root || true
+elif command -v chpasswd >/dev/null 2>&1; then
+  echo 'root:admin' | chpasswd || true
+fi
+
+# Self-host SSH startup for KNE HOST nodes. The pod entrypoint never runs in
+# this model, so the initial config script must own host keys and sshd.
+if command -v ssh-keygen >/dev/null 2>&1; then
+  ssh-keygen -A >/dev/null 2>&1 || true
+fi
+if [ -x /usr/sbin/sshd ]; then
+  cat >/tmp/sshd_config.skyforge <<'EOF'
+Port 22
+ListenAddress 0.0.0.0
+Protocol 2
+PasswordAuthentication yes
+PermitRootLogin yes
+PubkeyAuthentication yes
+PermitEmptyPasswords no
+ChallengeResponseAuthentication no
+KbdInteractiveAuthentication no
+PidFile /tmp/sshd.skyforge.pid
+AuthorizedKeysFile .ssh/authorized_keys
+Subsystem sftp internal-sftp
+EOF
+  pkill -f '/usr/sbin/sshd -f /tmp/sshd_config.skyforge' >/dev/null 2>&1 || true
+  nohup /usr/sbin/sshd -f /tmp/sshd_config.skyforge >/var/log/netlab-sshd.log 2>&1 &
+fi
+
+# Emit deterministic background traffic so attached switches build ARP/MAC state
+# even when nobody is logged into the host.
+if command -v ip >/dev/null 2>&1; then
+cat >/tmp/netlab-host-activity-targets <<'EOF'
+{% for intf in interfaces if intf.ifname is defined %}
+{%   if intf.gateway is defined and intf.gateway.ipv4 is defined and intf.gateway.ipv4 is string %}
+{{ intf.ifname }} {{ intf.gateway.ipv4.split('/')[0] }}
+{%   endif %}
+{%   for ngb in intf.neighbors|default([]) %}
+{%     if ngb.ipv4 is defined and ngb.ipv4 is string %}
+{{ intf.ifname }} {{ ngb.ipv4.split('/')[0] }}
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+EOF
+
+cat >/tmp/netlab-host-activity.sh <<'EOF'
+#!/bin/sh
+set -eu
+
+emit_unicast_probe() {
+  probe_if="$1"
+  probe_ip="$2"
+
+  [ -n "${probe_if}" ] || return 0
+  [ -n "${probe_ip}" ] || return 0
+
+  # Unicast ARP/ICMP to the gateway or attached router makes both data sources
+  # the collector needs deterministic: adjacent MAC tables and L3 ARP tables.
+  if command -v arping >/dev/null 2>&1; then
+    arping -I "${probe_if}" -c 1 "${probe_ip}" >/dev/null 2>&1 || true
+  fi
+  ping -n -q -c 1 -W 1 -I "${probe_if}" "${probe_ip}" >/dev/null 2>&1 || true
+}
+
+first_usable_ipv4() {
+  command -v python3 >/dev/null 2>&1 || return 0
+  python3 - "$1" <<'PY' 2>/dev/null || true
+import ipaddress
+import sys
+
+try:
+    iface = ipaddress.ip_interface(sys.argv[1])
+    network = iface.network
+    if network.version != 4:
+        raise ValueError("not ipv4")
+    for host in network.hosts():
+        if host != iface.ip:
+            print(host)
+            break
+except Exception:
+    pass
+PY
+}
+
+while true; do
+  ip -o -4 addr show scope global up | while read -r _ ifname _ cidr brd_key brd _; do
+    ip_addr="${cidr%%/*}"
+    [ -n "${ip_addr}" ] || continue
+
+    if command -v arping >/dev/null 2>&1; then
+        arping -U -I "${ifname}" -c 1 "${ip_addr}" >/dev/null 2>&1 || true
+    fi
+
+    if [ -s /tmp/netlab-host-activity-targets ]; then
+      while read -r target_if target_ip _; do
+        [ "${target_if:-}" = "${ifname}" ] || continue
+        emit_unicast_probe "${ifname}" "${target_ip:-}"
+      done </tmp/netlab-host-activity-targets
+    fi
+
+    fallback_target="$(first_usable_ipv4 "${cidr}")"
+    if [ -n "${fallback_target:-}" ] && [ "${fallback_target}" != "${ip_addr}" ]; then
+      emit_unicast_probe "${ifname}" "${fallback_target}"
+    fi
+
+    if [ "${brd_key:-}" = "brd" ] && [ -n "${brd:-}" ] && [ "${brd}" != "0.0.0.0" ]; then
+      ping -n -q -c 1 -W 1 -b -I "${ifname}" "${brd}" >/dev/null 2>&1 || true
+    fi
+  done || true
+
+  sleep "${NETLAB_HOST_ACTIVITY_INTERVAL:-60}"
+done
+EOF
+chmod +x /tmp/netlab-host-activity.sh
+pkill -f '/tmp/netlab-host-activity.sh' >/dev/null 2>&1 || true
+nohup /tmp/netlab-host-activity.sh >/var/log/netlab-host-activity.log 2>&1 &
+fi
