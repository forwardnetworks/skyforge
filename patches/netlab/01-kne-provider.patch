+# ---------------------------------------------------------------------------
+# Overlay-aware link MTU clamping (EVPN/VXLAN blackhole fix)
+# ---------------------------------------------------------------------------
+
+def test_kne_overlay_edge_mtu_reserves_headroom() -> None:
+  # link_mtu - headroom, floored at the IPv6 minimum
+  assert kne_overlay_edge_mtu(1370, 90) == 1280
+  assert kne_overlay_edge_mtu(9000, 90) == 8910
+  # floor: never below the IPv6 minimum even with a huge headroom
+  assert kne_overlay_edge_mtu(1370, 500) == KNE_MIN_OVERLAY_MTU
+  # no/zero headroom disables the reservation entirely
+  assert kne_overlay_edge_mtu(1370, None) is None
+  assert kne_overlay_edge_mtu(1370, 0) is None
+
+
+def test_kne_intf_overlay_edge_detection() -> None:
+  # bridged / IRB access ports carry pre-encap overlay payload
+  assert kne_intf_is_overlay_edge(Box({'_vlan_mode': 'bridge'}))
+  assert kne_intf_is_overlay_edge(Box({'_vlan_mode': 'irb'}))
+  # access / native VLAN membership without an explicit mode
+  assert kne_intf_is_overlay_edge(Box({'vlan': {'access': 'red'}}))
+  assert kne_intf_is_overlay_edge(Box({'vlan': {'native': 'blue'}}))
+  # routed underlay transport is NOT overlay edge
+  assert not kne_intf_is_overlay_edge(Box({'_vlan_mode': 'route'}))
+  assert not kne_intf_is_overlay_edge(Box({'ipv4': '10.0.0.1/30'}))
+  assert not kne_intf_is_overlay_edge(Box({}))
+
+
+def _mtu_topology() -> Box:
+  # link 1: l1<->l2 routed underlay (no VLAN) -> stays link_mtu
+  # link 2: l1 bridged access <-> h1 PLAIN host interface (no VLAN metadata)
+  #         the host side must still be clamped via link-level detection
+  return Box({
+    'defaults': {'providers': {'kne': {'link_mtu': 1370, 'overlay_mtu_headroom': 90}}},
+    'nodes': {
+      'l1': {'interfaces': [
+        {'ifname': 'Ethernet1', 'linkindex': 1, 'ipv4': '10.0.0.1/30'},
+        {'ifname': 'Ethernet3', 'linkindex': 2, '_vlan_mode': 'bridge'},
+      ]},
+      'h1': {'interfaces': [
+        {'ifname': 'eth1', 'linkindex': 2},
+      ]},
+    },
+    'links': [
