+# PAN-OS BGP: THE TEMPLATE IS THE LANE, AND ADVERTISEMENT IS REDISTRIBUTION.
+#
+# Live sjc-dc1in-panos-fw1 (2026-09-23): `install-route no`, no redist-rules,
+# rib-out 0 -- the seed advertised 25 prefixes. bgp/panos.j2 already said
+# install-route yes, but tasks/panos/bgp.yml shadowed it (deploy-module.yml
+# resolves <device>/<module>.yml before deploy-config/<device>.yml), so the
+# template never ran; and its export rule matched a `redistribution-profile`
+# PAN-OS BGP policy does not have. The seed's mechanism is
+# `protocol bgp redist-rules <redist-profile>`.
+_PANOS_BGP_TOPOLOGY = """
+provider: kne
+module: [ ospf ]
+nodes:
+  fw:
+    device: panos
+    module: [ routing, bgp, ospf ]
+    bgp:
+      as: 65000
+      router_id: 38.142.8.226
+      {bgp_extra}
+    ospf:
+      router_id: 10.254.0.10
+      {ospf_extra}
+    routing:
+      static:
+      - {{ ipv4: 0.0.0.0/0, nexthop.ipv4: 10.254.1.13 }}
+      prefix:
+        Default_to_VPC: [ {{ ipv4: 0.0.0.0/0 }} ]
+      policy:
+        Export_to_Amazon: [ {{ sequence: 2, action: permit }} ]
+        Default_to_VPC: [ {{ sequence: 10, match.prefix: Default_to_VPC }} ]
+  core: {{ device: iol, module: [ ospf ] }}
+  spk: {{ device: iol, module: [ bgp ], bgp.as: 64521 }}
+links:
+- {{ fw: {{}}, core: {{}}, prefix.ipv4: 10.254.1.12/30 }}
+- {{ fw: {{}}, spk: {{}}, prefix.ipv4: 169.254.10.0/30 }}
+"""
+
+_SEED_BGP = """install_route: true
+      import:
+        connected: { policy: Export_to_Amazon }
+        ospf: { policy: Export_to_Amazon }
+        static: { policy: Default_to_VPC }"""
+
+_VR = 'set network virtual-router default protocol '
+
+
+def _render_panos(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, bgp_extra: str = '', ospf_extra: str = '') -> Box:
+  monkeypatch.chdir(tmp_path)
+  monkeypatch.delenv('NETLAB_KNE_RECONFIGURE',raising=False)
+  init_log(raise_error=True)
+  topo = write_topology(tmp_path,_PANOS_BGP_TOPOLOGY.format(bgp_extra=bgp_extra,ospf_extra=ospf_extra))
+  create.run(['-o','config','-o','provider',str(topo)])
+  nf = tmp_path / 'node_files' / 'fw'
+  return Box(bgp=(nf / 'bgp').read_text(),ospf=(nf / 'ospf').read_text())
+
+
+def test_panos_bgp_import_renders_the_seed_redistribution(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  cfg = _render_panos(tmp_path,monkeypatch,bgp_extra=_SEED_BGP).bgp
+  lines = cfg.splitlines()
+  # seed: redist-profile Export_to_Amazon { filter { type [ connect ospf ] } priority 2; action { redist } }
+  assert _VR + 'redist-profile "Export_to_Amazon" filter type [ connect ospf ]' in lines
+  assert _VR + 'redist-profile "Export_to_Amazon" priority 2' in lines
+  assert _VR + 'redist-profile "Export_to_Amazon" action redist' in lines
+  assert not any('"Export_to_Amazon" filter destination' in l for l in lines)   # match-all policy
+  # seed: Default_to_VPC { filter { type static; destination 0.0.0.0/0 } priority 10 }
+  assert _VR + 'redist-profile "Default_to_VPC" filter type [ static ]' in lines
+  assert _VR + 'redist-profile "Default_to_VPC" filter destination [ 0.0.0.0/0 ]' in lines
+  assert _VR + 'redist-profile "Default_to_VPC" priority 10' in lines
+  # seed: bgp redist-rules { <P> { address-family-identifier ipv4; enable yes; set-origin incomplete } }
+  for pn in ('Export_to_Amazon','Default_to_VPC'):
+    for leaf in ('address-family-identifier ipv4','set-origin incomplete','enable yes'):
+      assert f'{_VR}bgp redist-rules "{pn}" {leaf}' in lines
+  # seed: install-route yes; allow-redist-default-route yes (0.0.0.0/0 is redistributed)
+  assert _VR + 'bgp install-route yes' in lines
+  assert _VR + 'bgp allow-redist-default-route yes' in lines
+  # No export policy: PAN-OS BGP policy has no redistribution-profile match.
+  assert 'policy export' not in cfg and 'redistribution-profile' not in cfg
+  # Peer on the link the neighbour is on, in the group the old lane created.
+  assert (_VR + 'bgp peer-group "panos-ebgp" peer "spk" local-address interface ethernet1/2 '
+          'ip 169.254.10.1/30') in lines
+  assert lines[-1] == _VR + 'bgp enable yes'
+
+
+def test_panos_bgp_knobs_unset_leave_the_device_defaults(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
