+def test_kne_viptela_day0_enables_management_and_admin_credentials(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch,
+      device: str) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,f"""
+provider: kne
+
+nodes:
+  n1:
+    device: {device}
+""")
+
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  provider_text = Path('topology.pb.txt').read_text()
+  assert 'file: "node_files/n1/startup-config"' in provider_text
+
+  # On KNE the Viptela day-0 is a cloud-init document that seeds ConfD's init
+  # file (cisco_sdwan.cloudconfig.j2), not a CLI transcript. Outside a fabric
+  # -- no sdwan module -- it still configures the admin user, the management
+  # VPN and eth0 on DHCP, so the wizard never fires and the node is reachable;
+  # it carries NO fabric identity, and must not invent one.
+  startup_config = Path('node_files/n1/startup-config').read_text()
+  assert startup_config.startswith('#cloud-config')
+  assert '/etc/confd/init/zcloud.xml' in startup_config
+  assert '<personality>vsmart</personality>' in startup_config
+  assert '<host-name>n1</host-name>' in startup_config
+  assert '<name>admin</name>' in startup_config
+  assert '<password>admin</password>' in startup_config
+  assert '<vpn-id>512</vpn-id>' in startup_config
+  assert '<if-name>eth0</if-name>' in startup_config
+  assert '<dhcp-client>true</dhcp-client>' in startup_config
+  assert '<system-ip>' not in startup_config
+  assert '<vbond>' not in startup_config
+  assert '<organization-name>' not in startup_config
+
