+def inventory_host_data(inventory: Box, node_name: str) -> Box:
+  for group_data in inventory.values():
+    if not isinstance(group_data,Box) or 'hosts' not in group_data:
+      continue
+    if node_name in group_data.hosts:
+      return group_data.hosts[node_name]
+  raise AssertionError(f'host {node_name} not found in inventory')
