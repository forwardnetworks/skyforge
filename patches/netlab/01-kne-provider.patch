+# A10 SLB HEALTH MONITORS BIND WHERE THE SEED BINDS THEM.
+#
+# demo-lab (2026-09-23): both SJC A10 VIPs read Down live while ICMP to
+# every member worked -- the loadbalancer template rendered no health-check at
+# all, so ACOS fell back to its default L4 TCP handshake on each member port,
+# which nothing listens on. The seed (sjc-dc1-a10-lb1_shared,configuration.txt)
+# binds `ping` on the server, on the server port and on the DC2 service group,
+# disables the server-level check on srv_10.254.1.14, and declares two named
+# monitors. The 0/tcp service on the DC2 group IS the seed (`port 0 tcp`,
+# `member ... 0`), not a template bug.
+_A10_LB_MONITOR_TOPOLOGY = """
+provider: kne
+plugin: [ loadbalancer ]
+nodes:
+  lb:
+    device: a10
+    loadbalancer:
+      monitors:
+      - {{ name: webfarm_check, type: http, port: 80, url: /index.php }}
+      - {{ name: hm_act_l4_slb_vip_80, type: ping, interval: 10 }}
+      - {{ name: tcp8080, type: tcp, port: 8080, interval: 10, timeout: 5 }}
+      pools:
+      - name: sg_act_l4_slb_vip_80_TCP
+        {pool80}
+        members:
+        - {{ name: srv_10.50.101.11, address: 10.50.101.11, port: 80 }}
+        - {{ name: srv_10.50.101.42, address: 10.50.101.42, port: 80, monitor: tcp8080 }}
+      - name: sg_act_l4_slb_vip_DC2_80_TCP
+        {pooldc2}
+        members:
+        - {{ name: srv_10.254.1.14, address: 10.254.1.14, port: 0 {srv14} }}
+        - {{ name: srv_10.51.101.11, address: 10.51.101.11, port: 0 }}
+      virtual_servers:
+      - {{ name: act_l4_slb_vip, vip: 110.240.240.240, port: 80, pool: sg_act_l4_slb_vip_80_TCP, advertise: true }}
+      - {{ name: act_l4_slb_vip_DC2, vip: 110.240.240.241, port: 0, pool: sg_act_l4_slb_vip_DC2_80_TCP, advertise: true }}
+  r1:
+    device: iol
+links: [ lb-r1 ]
+"""
+
+_A10_SEED_BINDINGS = dict(
+  pool80='server_monitor: ping\n        member_monitor: ping',
+  pooldc2='monitor: ping\n        server_monitor: ping\n        member_monitor: ping',
+  srv14=', server_monitor: none')
+
+
+def _render_a10_lb(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, **kw: str) -> str:
+  monkeypatch.chdir(tmp_path)
+  monkeypatch.delenv('NETLAB_KNE_RECONFIGURE',raising=False)
+  init_log(raise_error=True)
+  args = dict(pool80='protocol: tcp',pooldc2='protocol: tcp',srv14='')
+  args.update(kw)
+  create.run(['-o','config','-o','provider',str(write_topology(tmp_path,_A10_LB_MONITOR_TOPOLOGY.format(**args)))])
+  return (tmp_path / 'node_files' / 'lb' / 'loadbalancer').read_text()
+
+
+def test_a10_lb_health_monitors_render_the_seed_bindings(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  cfg = _render_a10_lb(tmp_path,monkeypatch,**_A10_SEED_BINDINGS)
+
+  # Named monitors, declared before anything references them. ICMP is the
+  # ACOS default method: no `method` line, exactly like the seed.
+  assert 'health monitor webfarm_check\n  method http port 80 url GET /index.php\n' in cfg
+  assert 'health monitor hm_act_l4_slb_vip_80\n  interval 10\n' in cfg
+  assert 'health monitor tcp8080\n  method tcp port 8080\n  interval 10 timeout 5\n' in cfg
+  assert cfg.index('health monitor tcp8080') < cfg.index('slb server')
+
+  # Server-level and port-level `ping`, straight from the pool defaults.
+  assert ('slb server srv_10.50.101.11 10.50.101.11\n  health-check ping\n'
+          '  port 80 tcp\n    health-check ping\n') in cfg
+  # A member's own monitor overrides the pool's member_monitor.
+  assert ('slb server srv_10.50.101.42 10.50.101.42\n  health-check ping\n'
+          '  port 80 tcp\n    health-check tcp8080\n') in cfg
+  # Seed: srv_10.254.1.14 disables the server check, keeps the port ping.
+  assert ('slb server srv_10.254.1.14 10.254.1.14\n  health-check-disable\n'
+          '  port 0 tcp\n    health-check ping\n') in cfg
+  # Service-group binding only where the seed has one (DC2), and the 0/tcp
+  # service is rendered as declared.
+  assert ('slb service-group sg_act_l4_slb_vip_DC2_80_TCP tcp\n  health-check ping\n'
+          '  member srv_10.254.1.14 0\n') in cfg
+  assert 'slb service-group sg_act_l4_slb_vip_80_TCP tcp\n  member srv_10.50.101.11 80\n' in cfg
+  assert '  port 0 tcp\n    service-group sg_act_l4_slb_vip_DC2_80_TCP\n' in cfg
+
+
