+from pathlib import Path
+
+
+def test_sros_readiness_handles_post_license_reboot_contract() -> None:
+    readiness = (
+        Path(__file__).parents[1]
+        / "netsim"
+        / "ansible"
+        / "tasks"
+        / "readiness-check"
+        / "sros.yml"
+    ).read_text()
+
+    assert "admin system license activate now" in readiness
+    assert "admin reboot now" in readiness
+    assert 'admin system license activate now\\ny' not in readiness
+    assert "failed_when: false" in readiness
+    assert "module: shell" in readiness
+    assert "Wait for SR OS SSH to drop for post-license activation" in readiness
+    assert "sros_license_reboot_drop.rc != 0" in readiness
+    assert "sros_license_reboot_pause" not in readiness
+    assert "pause:" not in readiness
+    assert "sros_valid_license_out.rc == 0 and 'valid license record'" in readiness
+    assert readiness.index("admin system license activate now") < readiness.index("nokia.grpc.gnmi")
