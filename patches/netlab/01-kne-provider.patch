+def test_kne_sros_readiness_verifies_grpc_and_cannot_pass_on_a_rejection() -> None:
+  import re
+  import yaml
+  tasks = yaml.safe_load((Path(__file__).parents[1] / 'netsim/ansible/tasks/readiness-check/sros.yml').read_text())
+  text = yaml.safe_dump(tasks)
+  # The classic re-enable that MD-CLI rejected while the task reported `changed`
+  # is gone; nothing in readiness configures the device any more.
+  assert 'no shutdown' not in text
+  assert not [ t for t in tasks if 'Enable SR OS gRPC' in t.get('name','') ]
+
+  verify = [ t for t in tasks if t.get('register') == 'sros_grpc_state_out' ]
+  assert len(verify) == 1
+  verify_task = verify[0]
+  assert 'info /state system grpc oper-state' in verify_task['local_action']['cmd']
+  for key in ('until','failed_when'):
+    assert 'oper-state up' in verify_task[key]
+    assert 'MINOR|MAJOR|CRITICAL|Error' in verify_task[key]
+
+  # Evaluate the task's own regexes against real transcripts.
+  err_re = re.search(r"search\('([^']*MINOR[^']*)'\)", verify_task['failed_when']).group(1)
+  up_re = re.search(r"search\('([^']*oper-state up[^']*)'\)", verify_task['failed_when']).group(1)
+  assert re.search(err_re, SROS_MD_REJECTS_CLASSIC)
+  assert not re.search(err_re, SROS_MD_GRPC_UP)
+  assert re.search(up_re, SROS_MD_GRPC_UP)
+  assert not re.search(up_re, SROS_MD_GRPC_UP.replace('oper-state up','oper-state down'))
+
+  names = [ t.get('name','') for t in tasks ]
+  tcp = [ i for i,n in enumerate(names) if n.startswith('Wait for gNMI (TCP') ]
+  gnmi = [ i for i,n in enumerate(names) if n.startswith('Wait for SR OS gNMI state tree') ]
+  verify_i = names.index(verify_task['name'])
+  assert tcp and gnmi and verify_i < tcp[0] < gnmi[0]
+  assert tasks[tcp[0]]['local_action']['port'] == '{{ sros_grpc_port }}'
+
