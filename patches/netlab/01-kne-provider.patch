diff --git a/netsim/ansible/tasks/deploy-config/asa.yml b/netsim/ansible/tasks/deploy-config/asa.yml
index 6910d2b..7f2cfa6 100644
--- a/netsim/ansible/tasks/deploy-config/asa.yml
+++ b/netsim/ansible/tasks/deploy-config/asa.yml
@@ -1,5 +1,26 @@
+# The rendered config is delivered TWICE on this platform: once pre-boot as
+# the day-0 ISO (netlab_config_mode: startup), and again here over SSH so the
+# deploy can claim per-node evidence and serve reconfigure. `crypto key
+# generate` is imperative, not config: day-0 creates the SSH host key, and by
+# the time ansible can CONNECT that key necessarily exists -- replaying the
+# line makes ASA refuse (noconfirm variant) or prompt to the command timeout
+# (bare variant). Both measured 2026-08-28 on probe 5e3ee4ef.
+#
+# The filter COMMENTS the line in a replay copy and feeds asa_config the FILE,
+# not a line list: src parsing is indentation-aware, and a first attempt that
+# pushed `lines:` flattened submode context, so ` service-type admin` arrived
+# at (config)# and died with "% Invalid input" -- the parent
+# `username ... attributes` submode had been lost.
+- name: "asa_config: prepare replay copy without the imperative keygen"
+  ansible.builtin.copy:
+    content: "{{ lookup('file', config_template) | regex_replace('(?m)^crypto key generate', '! day-0 only: crypto key generate') }}"
+    dest: "/tmp/asa-replay-{{ inventory_hostname }}.cfg"
+    mode: "0600"
+  delegate_to: localhost
+  become: no
+
 - name: "asa_config: deploying {{ netsim_action }} from {{ config_template }}"
   asa_config:
-    src: "{{ config_template }}"
+    src: "/tmp/asa-replay-{{ inventory_hostname }}.cfg"
   tags: [print_action, always]
   become: yes
diff --git a/netsim/ansible/tasks/deploy-config/ios.yml b/netsim/ansible/tasks/deploy-config/ios.yml
