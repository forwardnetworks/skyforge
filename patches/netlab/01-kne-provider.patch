+KNE_RUNTIME_INVENTORY_RETRIES = 12
+KNE_RUNTIME_INVENTORY_DELAY = 5
+KNE_KUBECTL_OP_RETRIES = 4
+KNE_KUBECTL_OP_RETRY_DELAY = 1.0
+
+# HARD CEILING on every kubectl operation this provider runs, enforced with GNU
+# `timeout -k` around the kubectl argv itself.
+#
+# Deploy fans out one thread per node (deploy.py ThreadPoolExecutor) and each
+# fragment runs through run_kubectl_with_retries, which had NO deadline at any
+# layer: a `kubectl exec` whose remote script wedges — or whose output stream is
+# held open by a child the script left behind — blocks its thread FOREVER.
+#
+# MEASURED 2026-08-17, demo-lab-v2 (65 nodes, run 40804): every cEOS and IOL node's
+# `services` fragment exec hung at once, all ~32 pool threads starved, the run
+# went silent for 23.5 minutes and was killed by the job budget with zero
+# per-node evidence ("device config was NOT applied ... no per-node device-config
+# evidence"). The fragments themselves re-ran in ~1s each afterwards; the content
+# was never the problem. A ceiling turns that shape into a NAMED per-node failure
+# the run can survive and report.
+#
+# CEILING, and it is CONTAINMENT -- it does not measure anything.
+#
+# The IOL wrapper's own contract is gate 120 + grace 10 + driver 420 + grace 10
+# = 560s, so 600s leaves 40s for kubectl exec setup and stream attach.
+#
+# I raised this to 900s on 2026-08-18 believing a fragment had legitimately
+# taken 581s. THAT NUMBER WAS WRONG -- it came from subtracting one node's
+# fragment START from a DIFFERENT node's fragment FINISH. The real durations in
+# run 42467 were 600.005s and 600.006s: the ceiling exactly, twice, which is
+# what a ceiling looks like when it fires and never what work looks like.
+#
+# Measured properly, the work is invariant and fast:
+#   initial   ~19s      (19.29s in the "slow" run, 19.99s in a fast one)
+#   services  1.3-2.8s
+# What varies is whether `kubectl exec` ever RETURNS after the wrapper has
+# already printed "fragment applied" and exited 0. Raising the ceiling
+# therefore bought nothing: the 900s verification failed at 902s, moving the
+# same hang 300s later and delaying every genuine failure by five minutes.
+#
+# Back to 600s. The hang is a leaked child holding the exec's output stream
+# (deploy/build/kne-iol/entrypoint.sh's own boot probe leaves a ppid-1 attach
+# owning /tmp/iol-console.lock for the pod's lifetime) and it must be fixed
+# THERE, not accommodated here.
+KNE_KUBECTL_OP_TIMEOUT = int(os.environ.get('SKYFORGE_KNE_KUBECTL_OP_TIMEOUT','600') or 0)
+KNE_KUBECTL_OP_KILL_GRACE = 10
+
+# BULKHEAD on the CONFIG FRAGMENT exec, which is the only long, console-bound
+# kubectl op on this path.
+#
+# Deploy fans out one thread per node, so a 65-node topology opens 65 device
+# consoles at once. For console-transport devices (IOL) that is 65 simultaneous
+# attach chains against a per-node exclusive lock, and every chain that gets
+# killed mid-flight can leave an orphan holding that lock -- a failure that
+# SELF-PERPETUATES into later runs (see the stale-attach sweep note in
+# templates/iol/netlab-config.j2: two orphans were still holding locks 1h33m
+# later, and every subsequent boot gate on those pods timed out).
+#
+# MEASURED 2026-08-17: six consecutive bring-ups of a bare TWO-node IOL topology
+# failed at the 600s ceiling while labs were being created and torn down
+# concurrently; the same topology completed in 69s once the cluster was quiet.
+# CPU was 9-25% throughout, so this is contention for a serialized per-node
+# resource, not for compute.
+#
+# This bounds how many consoles we drive at once. It does NOT fix the orphan
+# leak (that belongs in the attach chain) and does not pretend to: it reduces
+# how many chains can be in flight to be orphaned, and keeps a wedged node from
+# consuming the whole pool for the full KNE_KUBECTL_OP_TIMEOUT. 0 disables.
+KNE_CONFIG_EXEC_PARALLELISM = int(os.environ.get('SKYFORGE_KNE_CONFIG_EXEC_PARALLELISM','12') or 0)
+_kne_config_exec_semaphore = threading.Semaphore(KNE_CONFIG_EXEC_PARALLELISM) if KNE_CONFIG_EXEC_PARALLELISM > 0 else None
+
+
+@contextlib.contextmanager
+def kne_config_exec_slot(node_name: str, mod_name: str):
+  """Hold a bulkhead slot for one config-fragment exec (no-op when disabled)."""
+  if _kne_config_exec_semaphore is None:
+    yield
+    return
+  waited_from = time.time()
+  with _kne_config_exec_semaphore:
+    waited = time.time() - waited_from
+    # Only report a wait that a human would notice; a quiet run stays quiet.
+    if waited >= 5:
+      log.info(
+        f'config exec bulkhead: {node_name}/{mod_name} waited {waited:.0f}s for one of '
+        f'{KNE_CONFIG_EXEC_PARALLELISM} slots')
+    yield
+def dns_1035_name(value: str, prefix: str = 'n') -> str:
+  value = value.lower()
+  value = re.sub(r'[^a-z0-9-]+','-',value)
+  value = value.strip('-')
+  if not value:
+    value = prefix
+  if not value[0].isalpha():
+    value = f'{prefix}-{value}'
+  value = value[:63].rstrip('-')
+  if not value:
+    value = prefix
+  if not value[0].isalpha():
+    value = prefix
+  return value
+
+def get_kne_node_name(node: Box) -> str:
+  return dns_1035_name(node.name)
+
+def get_kne_runtime_topology_name() -> str:
+  value = str(os.environ.get('NETLAB_KNE_TOPOLOGY_NAME','') or '').strip()
+  if not value:
+    return ''
+  return dns_1035_name(value,'topo')
+
+def get_kne_topology_name(topology: Box) -> str:
+  runtime_name = get_kne_runtime_topology_name()
+  if runtime_name:
+    return runtime_name
+  return dns_1035_name(topology.name,'topo')
+
+def startup_config_path(node: Box) -> str:
+  return f'node_files/{node.name}/startup-config'
+
+def get_node_startup_config(node: Box) -> str:
+  kne_data = node.get('kne',None)
+  if not isinstance(kne_data,Box):
+    return ''
+
+  for key in ('startup_config_source','startup_config','startup-config'):
+    startup_cfg = kne_data.get(key,None)
+    if isinstance(startup_cfg,str) and startup_cfg:
+      return startup_cfg
+
+  return ''
+
+def get_node_config_mode(node: Box, topology: Box) -> str:
+  if node.get('_kne_boot_config_mode',None):     # A reconfigure render moved delivery to another mode (see
+    return node._kne_boot_config_mode            # add_default_config_mode); the device still BOOTS this one
+  cfg_mode = devices.get_node_group_var(node,'netlab_config_mode',topology.defaults)
+  if cfg_mode:
+    if cfg_mode == 'startup' and sros_preserve_image_startup(node,topology):
+      return 'none'
+    return cfg_mode
+
+  features = devices.get_device_features(node,topology.defaults)
+  supported = features.get('initial.config_mode',[])
+  if len(supported) == 1 and supported[0] in ('sh','cp_sh'):
+    return supported[0]
+
+  if sros_preserve_image_startup(node,topology):
+    return 'none'
+
+  return 'startup'
+
+def sros_preserve_image_startup(node: Box, topology: Box) -> bool:
+  if node.device != 'sros':
+    return False
+  if get_node_startup_config(node):
+    return False
+  if get_templates_with_mode(node,'startup'):
+    return False
+  return True
+
+# NETLAB STARTUP-CONFIG MODE MEANS THE WHOLE CONFIGURATION, and this set must
+# not quietly redefine it.
+#
+# `netlab_config_mode: startup` is netlab's contract that a device boots its
+# ENTIRE rendered configuration -- every module -- as its startup config. For
+# iol and ioll2 that is the only lane there is: the exec/console lane was
+# retired 2026-08-28 after every IOL incident on record lived in it, and there
+# is no post-boot apply. That startup config is not a day-0 bootstrap; it is
+# the running config, delivered at boot.
+#
+# Patch 0064 added `services` here on the day-0 reasoning ("day-0 is the
+# basics; everything else is pushed afterwards over the management path"). That
+# reasoning is right for a DAY-0 PAYLOAD and wrong for startup-config mode, and
+# the two had been conflated. MEASURED 2026-09-11 on demo-lab run 136222: the
+# services module was carved out of all 39 IOL/IOL-L2 boot configs, and since
+# nothing delivers anything to an IOL after boot, none of them got a flow
+# exporter, an snmp community or a syslog host. Ansible's PLAY RECAP named
+# exactly four hosts -- the four ASAs, which still have an SSH lane. The
+# runtime correctly reported 39 nodes "unexplained" and the collector reported 11
+# devices missing from its snapshot.
+#
+# So: only `sdwan` is excluded from startup-config assembly. That one is a
+# different mechanism, not a day-0 rule -- on an SD-WAN edge vManage OWNS the
+# running configuration and pushes it through templates, and a startup config
+# the appliance rejects costs the entire SD-WAN bootstrap. The owner's day-0
+# rule ("just management setup") governs genuine day-0 payloads -- the
+# cloud-init and CVAC seeds -- which is what the sdwan exclusion protects.
+#
+# Like the sdwan case, this suppresses ONLY the startup-config assembly for
+# that one module. For every module that IS in the startup config, the kne
+# provider adds it to netlab_ansible_skip_module (see the iol/ioll2 block
+# below), so a device in startup mode is not configured twice.
+NON_STARTUP_CONFIG_MODULES = { 'sdwan' }
+
+def startup_config_modules(node: Box, topology: Box) -> list:
+  module_list = ['initial']
+  if devices.get_device_attribute(node,'features.initial.normalize',topology.defaults):
+    module_list = ['normalize'] + module_list
+
+  module_list += node.get('module',[]) + node.get('config',[])
+  skip_config = set(node.get('skip_config',[])) | NON_STARTUP_CONFIG_MODULES
+  return [ module for module in module_list if module not in skip_config ]
+
+def ordered_startup_template_sources(node: Box, topology: Box) -> list:
+  startup_items = get_templates_with_mode(node,'startup')
+  startup_list = [ item.source for item in startup_items ] if startup_items else startup_config_modules(node,topology)
+
+  # IOL ifstate snippets end with "end". Keep ifstate as the final startup
+  # fragment so it can still bring interfaces up without terminating the rest.
+  if node.device in ('iol','ioll2'):
+    ifstate = [ item for item in startup_list if str(item).strip() == 'ifstate' ]
+    startup_list = [ item for item in startup_list if str(item).strip() != 'ifstate' ] + ifstate
+
+  return startup_list
+
+def sanitize_startup_fragment(node: Box, fragment: str, is_final: bool) -> str:
+  if node.device not in ('iol','ioll2') or is_final:
+    return fragment
+
+  lines = fragment.rstrip('\n').splitlines()
+  if lines and lines[-1].strip().lower() == 'end':
+    lines = lines[:-1]
+  return '\n'.join(lines)
+
+# VM-backed devices that keep pod eth0 for management/default CNI and must
+# start data links at eth1 in the KNE topology contract.
+#
+# THIS SET IS LOAD-BEARING FOR MESHNET, NOT JUST FOR ADDRESSING. kne's
+# topo/node/node.go GetNodeLinks() unconditionally skips the interface literally
+# named "eth0" ("Found mgmt interface ignoring for Meshnet"). A device missing
+# from this set therefore gets its FIRST data link authored onto eth0, kne drops
+# that link from the device's own meshnet Topology CR, and the PEER's spec is
+# then left holding a link UID that exists nowhere -- `kne create` aborts the
+# whole topology with "could not find peer for node <peer> pod <peer> link UID
+# <n>" before a single pod is created. The failure names the peer, not the
+# device that is actually miswired, and it scales with the topology, so it reads
+# like a large-fleet meshnet problem. Measured 2026-08-15 on the 67-node demo-lab
+# import: cdg-acc-sw01 (vjunos-switch) took its cdg-lan-pc01 link on eth0 and
+# killed bring-up for all 71 nodes.
+KNE_RESERVED_ETH0_DEVICES = {
+  'asav',
+  'csrx',
+  'iosxr',
+  # vJunos ships fxp0 as out-of-band management on the first vNIC, exactly like
+  # asav's Management0/0. Its netlab device definition has no ifindex offset, so
+  # without this entry ge-0/0/0 lands on pod eth0.
+  'vjunos-router',
+  'vjunos-switch',
+  # vSRX 3.0 (same family, same "no ifindex offset" shape) replaced csrx
+  # 2026-08-26 but was never added here -- csrx stayed in the set, vsrx's own
+  # entry was simply missed. Found live 2026-09-13/14 bringing up demo-lab
+  # 1.3: both vSRX firewalls took their first data link on eth0, kne dropped it
+  # from each node's own meshnet Topology CR, and the PEER on the other end of
+  # that link failed bring-up with "could not find peer ... link UID N" --
+  # exactly the species of bug this set exists to prevent (see the vjunos-switch
+  # incident above). vsrx had no other real KNE deploy in this repo to have
+  # caught it sooner.
+  'vsrx',
+}
+
+# Devices whose NOS builds its out-of-band management interface from the KNE
+# interface map (pod eth0 -> NOS management ifname). For these devices netlab
+# authors an explicit eth0 entry in the KNE topology so the management
+# interface has a single source of truth here: the entry flows unchanged into
+# the vendor CR's intfmapping (e.g. CEosLabDevice .spec.intfmapping) and on
+# into the NOS mapping file (e.g. EosIntfMapping.json -> ManagementIntf), which
+# is what actually makes the NOS create Management0. This is deliberately NOT
+# the KNE_RESERVED_ETH0_DEVICES set: those devices keep eth0 for the default
+# CNI/data offset and do not map eth0 to a NOS management interface.
+KNE_ETH0_MGMT_DEVICES = {
+  'eos',
+}
+
+# Kernel network device KNE wires the management plane onto. KNE treats pod
+# eth0 as the management interface and explicitly excludes it from meshnet
+# wiring (kne topo/node/node.go GetNodeLinks skips "eth0"), so an eth0 entry in
+# the interface map never adds a meshnet link and never increments the
+# CEosLabDevice NumInterfaces / init-wait interface tally (Arista's KNE node
+# builder derives NumInterfaces from the meshnet link count, not the
+# interface-map length).
+KNE_MGMT_KERNEL_DEVICE = 'eth0'
+
+def interface_key(node: Box, intf: Box, topology: Box) -> str:
+  """Kernel (pod netns) interface name for a wired link endpoint.
+
+  ALWAYS eth{ifindex} (plus the reserved-eth0 bump for NOS whose first vNIC is
+  out-of-band management). This is meshnet's name for the veth it creates in
+  the pod, NOT the name the NOS shows: meshnet renames the link with netlink,
+  so the value has to be a legal Linux interface name.
+
+  DO NOT reach for kne.interface.name here. Those declarations are copied from
+  containerlab, where the host-side veth IS named after the NOS interface, and
+  several of them cannot be a kernel name at all -- iol declares
+  Ethernet{ifindex // 4}/{ifindex % 4} and srsim declares
+  1/{ifindex}/c{ifindex}/1. Honouring them produced
+
+      failed to rename link koko2056836565 -> Ethernet0/2: invalid argument
+
+  and left 63 of demo-lab's 79 pods stuck in Init forever (2026-08-30). It also
+  silently rewired ~26 other devices whose declarations carry containerlab
+  offsets (cat8000v eth{ifindex-1}, the junos family eth{ifindex+1}).
+
+  cEOS is the one device that must AGREE with a declaration rather than follow
+  it, because INTFTYPE tells the container which prefix to expect. eos.yml
+  declares eth, eos_intftype reads that declaration, and this function produces
+  eth -- test_kne_eos_intftype_matches_kernel_name pins that they cannot drift.
+  """
+  ifindex = intf.ifindex
+  if node.device in KNE_RESERVED_ETH0_DEVICES:
+    ifindex += 1
+  return f'eth{ifindex}'
+
+def interface_sort_key(entry: Box) -> int:
+  match = re.search(r'(\d+)$',str(entry['key']))
+  return int(match.group(1)) if match else 0
+
+def get_kne_mgmt_ifname(node: Box) -> str:
+  return node.get('mgmt.ifname','')
+
+def get_kne_services(node: Box) -> list:
+  return [ Box(service) for service in KNE_SERVICE_MAP.get(node.device,[]) ]
+
+def mapping_supports_startup_config(mapping: dict) -> bool:
+  return bool(mapping.get('config_path',None) and mapping.get('config_file',None))
+
+def normalize_port_value(value: object) -> int:
+  if isinstance(value,bool):
+    return 0
+  if isinstance(value,int):
+    return value if value > 0 else 0
+  if isinstance(value,str):
+    value = value.strip()
+    if value.isdigit():
+      port = int(value)
+      return port if port > 0 else 0
+  return 0
+
+def get_kne_service_by_name_or_port(node: Box, names: list[str], ports: list[int]) -> Box | None:
+  services = [ Box(service) for service in node.get('kne.services',get_kne_services(node)) ]
+  name_set = { name for name in names if name }
+  port_set = { port for port in ports if port > 0 }
+  for service in services:
+    aliases = [ str(alias or '').strip().lower() for alias in service.get('names',[]) ]
+    aliases += [ str(service.get('name','') or '').strip().lower() ]
+    outside = normalize_port_value(service.get('outside',0))
+    inside = normalize_port_value(service.get('inside',0))
+    if name_set.intersection(set(filter(None,aliases))):
+      return service
+    if outside in port_set or inside in port_set:
+      return service
+  return None
+
+def get_kne_mgmt_service(node: Box, topology: Box) -> Box | None:
+  if node.device == 'panos':
+    mgmt_service = get_kne_service_by_name_or_port(node,['https'],[443])
+    if mgmt_service:
+      return mgmt_service
+
+  conn = str(
+    devices.get_node_group_var(node,'ansible_connection',topology.defaults) or
+    node.get('ansible_connection','') or '').strip().lower()
+  if conn == 'httpapi':
+    http_port = normalize_port_value(
+      devices.get_node_group_var(node,'ansible_httpapi_port',topology.defaults) or
+      node.get('ansible_httpapi_port',0))
+    mgmt_service = get_kne_service_by_name_or_port(node,['httpapi','http','https'],[http_port,80,443])
+    if mgmt_service:
+      return mgmt_service
+
+  if conn == 'netconf':
+    mgmt_service = get_kne_service_by_name_or_port(node,['netconf'],[830])
+    if mgmt_service:
+      return mgmt_service
+
+  return get_kne_service_by_name_or_port(node,['ssh'],[22])
+
+def kne_config_template_items(node: Box) -> list:
+  cfg_files = node.get('kne.config_templates',[])
+  if not cfg_files:
+    return []
+
+  path = f'nodes.{node.name}.kne.config_templates'
+  if isinstance(cfg_files,(dict,Box)):
+    items = []
+    for source,target in cfg_files.items():
+      item = filemaps.normalize_item(key=source,value=target,path=path,module='kne')
+      if item:
+        items.append(Box(item,default_box=True,box_dots=True))
+    return items
+
+  if isinstance(cfg_files,list):
+    if all(isinstance(item,(dict,Box)) and config_template_source(item) for item in cfg_files):
+      return [ item if isinstance(item,Box) else Box(item,default_box=True,box_dots=True) for item in cfg_files ]
+
+    items = []
+    for cfg_item in cfg_files:
+      if isinstance(cfg_item,str):
+        item = filemaps.normalize_item(line=cfg_item,path=path,module='kne')
+        if item:
+          items.append(Box(item,default_box=True,box_dots=True))
+        continue
+      if isinstance(cfg_item,(dict,Box)):
+        if 'source' in cfg_item:
+          items.append(cfg_item if isinstance(cfg_item,Box) else Box(cfg_item,default_box=True,box_dots=True))
+          continue
+        if len(cfg_item) == 1:
+          source,target = next(iter(cfg_item.items()))
+          item = filemaps.normalize_item(key=source,value=target,path=path,module='kne')
+          if item:
+            items.append(Box(item,default_box=True,box_dots=True))
+    return items
+
+  if isinstance(cfg_files,str):
+    item = filemaps.normalize_item(line=cfg_files,path=path,module='kne')
+    return [Box(item,default_box=True,box_dots=True)] if item else []
+
+  return []
+
+def get_templates_with_mode(node: Box, mode: str) -> list:
+  return [ item for item in kne_config_template_items(node) if item.get('mode',None) == mode ]
+
+def normalize_kne_filemaps(node: Box) -> None:
+  if 'kne.config_templates' in node:
+    filemaps.normalize_file_mapping(node,f'nodes.{node.name}','kne.config_templates','kne')
+
+def add_config_filemaps(node: Box, topology: Box) -> None:
+  skip_config = node.get('skip_config',[])
+  for kw in ('_daemon_config','_node_config'):
+    if kw not in node:
+      continue
+
+    if skip_config:
+      add_config = { k:v for k,v in node[kw].items() if k.replace('@','.') not in skip_config }
+    else:
+      add_config = node[kw]
+    node.kne.config_templates = add_config + node.kne.config_templates
+
+def eos_intftype(node: Box, topology: Box) -> str:
+  """Return the cEOS interface-name prefix, derived from the device definition.
+
+  SINGLE SOURCE OF TRUTH. The prefix used to be the bare literal 'eth', written
+  here twice AND declared a third time as kne.interface.name in
+  netsim/devices/eos.yml. Nothing kept the three in agreement.
+
+  That is not hypothetical: netlab 26.08 upstream renamed cEOS interfaces
+  eth -> et, and our fork overrides it back to eth in eos.yml -- an override that
+  arrived as collateral inside an SR OS commit (bb93ef3854), not as a decision.
+  If a future rebase drops that override but leaves these literals, KNE wires
+  'et1' while the container is told INTFTYPE=eth, and the interfaces simply do
+  not line up.
+
+  eos.yml declares it once, under the kne: block. KNE is a provider in its own
+  right and reads NOTHING from clab: a device it supports declares what it needs
+  under kne:, so upstream is free to change its containerlab metadata without
+  silently rewiring our labs.
+  """
+  name = devices.get_device_attribute(node,'kne.interface.name',topology.defaults)
+  prefix = str(name or '').split('{')[0].strip()
+  if not prefix:
+    log.error(
+      f'Cannot derive the cEOS interface prefix for node {node.name}: '
+      f'kne.interface.name is {name!r} in the device definition',
+      category=log.IncorrectValue,
+      module='kne')
+    return 'eth'
+  return prefix          # same declaration kne_kernel_ifprefix reads for the wired link names
+
+def add_viptela_credentials(node: Box, topology: Box) -> None:
+  """Tell the KNE serial injector which password day-0 is about to declare.
+
+  These images FORCE a password change on the very first console login ("You
+  must set an initial admin password"), and the injector answers it. Until now
+  it answered with a KNE-side constant, admin -- which is fine for a vSmart or
+  vBond and IMPOSSIBLE for a vManage: that appliance refuses to keep the factory
+  value ("USER0002: Password for admin user cannot be configured to
+  default/last password", measured live). So the one box whose password most
+  needs to change was the one the injector could not change it on.
+
+  The transition used to happen afterwards, over vManage's REST API, and could
+  not be made to work in general: while the box still holds the factory
+  password every /dataservice/* answers 302 -> passwordReset.html on an
+  otherwise valid session, so the API lane had to perform the transition that
+  unblocked its own session. Answering the forced prompt with the declared value
+  removes the transition rather than sequencing around it.
+
+  BOTH values are passed, because the injector needs them for different things:
+  it LOGS IN with the factory password and SETS the declared one. Collapsing
+  them into one variable is what made this look like a single value in the first
+  place.
+
+  The declared value is resolved by the sdwan module (sdwan.declared_password)
+  so that day-0's `aaa` stanza, this env, and the API lane's login all read one
+  source. If the sdwan module is not enabled there is nothing to pass and the
+  injector keeps its own defaults -- a Viptela node still boots, it simply keeps
+  the factory credential.
+
+  RESOLVED INDEPENDENTLY, not read off the node. These hooks run inside the KNE
+  provider's transform, which happens BEFORE the sdwan module pushes its overlay
+  facts -- so node.sdwan.declared_password is still unset here even though it is
+  present by the time day-0 renders. Depending on that ordering silently yields
+  None and the injector quietly keeps answering with the factory password, which
+  is precisely the failure this function exists to remove. Resolve from the two
+  sources that are stable at any point in the transform instead, and keep this
+  in step with _push_overlay_facts in netsim/modules/sdwan.py.
+  """
+  if not node.get('sdwan',None):
+    return
+
+  declared = (
+    str(topology.get('sdwan.api_password','') or '')
+    or str(topology.get(
+        f'defaults.devices.{node.device}.group_vars.ansible_password','') or '')
+  )
+  if not declared:
+    return
+
+  node.kne.env = node.kne.get('env',Box(default_box=True,box_dots=True))
+  node.kne.env.VIPTELA_PASS = str(declared)
+  node.kne.env.VIPTELA_FACTORY_PASS = str(
+    topology.get('sdwan.api_factory_password','') or 'admin')
+
+def add_ixia_c_engine_env(node: Box, topology: Box) -> None:
+  """Give an ixia-c traffic engine the three settings that make it affordable.
+
+  MEASURED on node-d 2026-09-05, booting the engine image directly:
+
+    Ixia port 1 = DPDK port 0 - Driver af_packet
+    KNI: Can not open /dev/kni -> [KNI] Will proceed without Kni
+    Bound server to endpoint - tcp://*:5555
+
+  af_packet means NO DPDK. OPT_NO_HUGEPAGES means no hugepage reservation. The
+  probe pod ran with an EMPTY securityContext, so no privilege is needed
+  either. Those three are exactly what would have made a traffic engine
+  unaffordable on Talos, and none of them is required.
+
+  ARG_IFACE_LIST names the DATA interface. eth0 is management and must never
+  be claimed -- the engine would be fighting the path it is reached over -- so
+  the list is built from the node's real data interfaces rather than hardcoded.
+  A node with no data link gets no ARG_IFACE_LIST at all, which is honest: an
+  engine with nothing attached has no port to offer.
+  """
+  if node.device != 'keysight_ixia-c-traffic-engine':
+    return
+
+  node.kne.env = node.kne.get('env',Box(default_box=True,box_dots=True))
+  node.kne.env.OPT_NO_HUGEPAGES = 'Yes'
+  node.kne.env.OPT_LISTEN_PORT = '5555'
+
+  data_ifs = [
+    intf.ifname for intf in node.get('interfaces',[])
+    if intf.get('ifname') and intf.get('ifname') != node.get('mgmt_if','eth0')
+  ]
+  if data_ifs:
+    node.kne.env.ARG_IFACE_LIST = 'virtual@af_packet,' + ','.join(data_ifs)
+
+def add_eos_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'eos':
+    return
+
+  node.kne.env = node.kne.get('env',Box(default_box=True,box_dots=True))
+  node.kne.env.pop('CLAB_MGMT_VRF',None)
+  node.kne.env.INTFTYPE = eos_intftype(node,topology)
+  node.kne.env.ETBA = '1'
+  node.kne.env.MAPETH0 = '1'
+  node.kne.env.MGMT_INTF = 'eth0'
+
+  if get_node_config_mode(node,topology) not in ('sh','cp_sh'):
+    return
+
+  desired_retries = devices.get_node_group_var(node,'netlab_check_retries',topology.defaults)
+  current_retries = node.get('netlab_check_retries',0)
+  if isinstance(desired_retries,int) and desired_retries > current_retries:
+    node.netlab_check_retries = desired_retries
+  bootstrap_cfg = Box(default_box=True,box_dots=True)
+  bootstrap_cfg['ceos-bootstrap'] = ':startup'
+  node.kne.config_templates = bootstrap_cfg + node.kne.config_templates
+
+def add_iosxr_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'iosxr':
+    return
+
+  if get_node_config_mode(node,topology) not in ('sh','cp_sh'):
+    return
+
+  bootstrap_cfg = Box(default_box=True,box_dots=True)
+  bootstrap_cfg['xrd-bootstrap'] = ':startup'
+  # THE INTERPRETER, not just the scripts. Every sh-mode config netlab renders
+  # for this device starts with the shebang declared in iosxr.yml:
+  #
+  #   #!/config/netlab/netlab-config.sh
+  #
+  # The clab lane ships that helper (clab.node.config_templates declares it);
+  # the KNE lane never did, so the shebang pointed at a file that was never
+  # rendered and never staged. Exec'ing a script whose INTERPRETER is missing
+  # fails with ENOENT naming THE SCRIPT, not the interpreter:
+  #
+  #   exec /config/netlab/01-initial.sh: no such file or directory (exit 255)
+  #
+  # which reads exactly like the config script itself is absent. It is not --
+  # it was cp'd successfully moments earlier. Six IOS-XR PEs failed every
+  # bring-up this way while the cEOS nodes beside them configured fine (eos
+  # uses an inline netlab_config_wrapper whose interpreter, /usr/bin/FastCli,
+  # is IN the image). Staged as a plain sh config so it is copied but never
+  # executed: 'netlab-config' is not in deploy_list, so the exec loop skips it.
+  bootstrap_cfg['netlab-config'] = '/config/netlab/netlab-config.sh:sh'
+  node.kne.config_templates = bootstrap_cfg + node.kne.config_templates
+
+def add_sros_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'sros':
+    return
+
+  if get_node_config_mode(node,topology) != 'startup':
+    return
+
+  # Explicit SR OS startup-config opt-in. Keep the rendered file parser-safe;
+  # the default KNE path preserves the image-local cf3:\config.cfg startup.
+  bootstrap_cfg = Box(default_box=True,box_dots=True)
+  bootstrap_cfg['sros-bootstrap'] = ':startup'
+  node.kne.config_templates = bootstrap_cfg + node.kne.config_templates
+
+def sros_variant_contract(node: Box, topology: Box) -> tuple[str, str]:
+  kne_data_p = devices.get_provider_data(node, topology.defaults)
+  kne_node_p = kne_data_p.get('node', Box(default_box=True, box_dots=True))
+  variant = str(kne_node_p.get('type', '') or '').strip()
+  if not variant:
+    variant = 'sr-1'
+
+  variants = kne_data_p.get('variant_contracts', Box(default_box=True, box_dots=True))
+  timos_line = ''
+  if isinstance(variants, (dict, Box)):
+    contract = variants.get(variant, None)
+    if isinstance(contract, (dict, Box)):
+      timos_line = str(contract.get('timos_line', '') or '').strip()
+
+  if not timos_line and variant != 'sr-1':
+    log.fatal(f'SR OS variant {variant} is not declared in the KNE variant contract', 'kne')
+
+  if not timos_line:
+    timos_line = 'chassis=sr-1 slot=A card=cpm-1 slot=1 mda/1=me12-100gb-qsfp28'
+
+  return variant, timos_line
+
+def sros_version_from_image(node: Box) -> tuple[int, str]:
+  image_version = str(node.get('box_version', '') or '').strip()
+  if not image_version:
+    image = str(node.get('box', '') or '').strip()
+    # The tag is read from the LAST path segment only, after dropping any
+    # digest. A registry host:port colon is never in that segment (mirror
+    # registries embed a port, e.g. registry.example.com:3300/ns/vr-sros:22.10.R2,
+    # and reading it would make major=3300 -> the wrong bootstrap profile). A
+    # pinned `name:tag@sha256:...` ref still carries its tag -- the runtime
+    # defaults pin SR OS exactly that way (sros:22.10.R2-eve-l1@sha256:...), and
+    # reading it as "no version" hid the release from every consumer below
+    # (22.10 has no `log syslog hostname`; see templates/services/sros.j2). A
+    # bare digest ref (.../vr-sros@sha256:...) carries no version and gives 0.
+    last = image.split('@', 1)[0].rsplit('/', 1)[-1]
+    if ':' in last:
+      image_version = last.rsplit(':', 1)[1].strip()
+
+  match = re.match(r'^(?P<major>\d+)(?:\.(?P<minor>\d+))?(?:\.(?P<patch>[A-Za-z0-9-]+))?', image_version)
+  if not match:
+    return 0, image_version
+
+  return int(match.group('major') or 0), image_version
+
+def sros_bootstrap_profile(node: Box, topology: Box) -> str:
+  kne_data_p = devices.get_provider_data(node, topology.defaults)
+  kne_node_p = kne_data_p.get('node', Box(default_box=True, box_dots=True))
+  variant = str(kne_node_p.get('type', '') or '').strip()
+  profile = ''
+
+  variants = kne_data_p.get('variant_contracts', Box(default_box=True, box_dots=True))
+  if isinstance(variants, (dict, Box)):
+    contract = variants.get(variant, None)
+    if isinstance(contract, (dict, Box)):
+      profile = str(contract.get('bootstrap_profile', '') or '').strip()
+
+  if not profile:
+    major, _ = sros_version_from_image(node)
+    profile = 'model-driven' if major >= 23 else 'classic'
+
+  return profile
+
+# SR OS CLI TRANSCRIPTS ARE THE ONLY TRUTH A BOOTSTRAP OVER SSH GETS.
+#
+# The device answers every command inside ONE interactive session, so the
+# session exits 0 whether it applied a line or rejected it. A bootstrap judged
+# by the exit status alone cannot fail -- and one did not: the gNMI readiness
+# enable (tasks/readiness-check/sros.yml) sent classic `no shutdown` lines to a
+# device the post-start bootstrap had already switched to model-driven, got
+# `MINOR: MGMT_CORE #2201: Unknown element - 'no'` for each, and reported
+# `changed` (measured 2026-09-30, vr-sros 22.10 KubeVirt pair). Three things are
+# read from the transcript instead:
+#
+#   * the CLI ENGINE, from the prompt: MD-CLI prompts `A:admin@n1#` (user@host,
+#     under a `[/]` context line); classic prompts `A:n1#`. It is read from the
+#     device, not inferred from the image: the image tag is gone once defaults
+#     pin a digest, and a device that was bootstrapped once is model-driven
+#     whatever its image booted as.
+#   * REJECTED LINES: SR OS reports them as `MINOR:`/`MAJOR:`/`CRITICAL:` in both
+#     engines, and classic also prints `Error:`.
+#   * the POSTCONDITION: `info /state system grpc oper-state` = `up`.
+SROS_MD_CLI_PROMPT_RE = re.compile(r'^\s*[A-D]:[^\s@#]+@[^\s#]+#', re.M)
+SROS_CLASSIC_CLI_PROMPT_RE = re.compile(r'^\s*\*?[A-D]:[^\s@#]+#', re.M)
+SROS_CLI_ERROR_RE = re.compile(r'^\s*(?:MINOR|MAJOR|CRITICAL|Error):.*$', re.M)
+SROS_GRPC_OPER_UP_RE = re.compile(r'^\s*oper-state up\s*$', re.M)
+
+def sros_cli_engine(output: str) -> str:
+  """'model-driven', 'classic', or '' when no SR OS prompt is in the transcript."""
+  text = (output or '').replace('\r', '')
+  if SROS_MD_CLI_PROMPT_RE.search(text):
+    return 'model-driven'
+  if SROS_CLASSIC_CLI_PROMPT_RE.search(text):
+    return 'classic'
+  return ''
+
+def sros_cli_errors(output: str) -> list[str]:
+  return [ line.strip() for line in SROS_CLI_ERROR_RE.findall((output or '').replace('\r', '')) ]
+
+def sros_bootstrap_lines(node: Box, topology: Box, profile: str = '') -> list[str]:
+  """The management bootstrap vrnetlab's launch.py applies (SROS_CL_COMMON_CFG /
+  SROS_MD_COMMON_CFG), in the syntax of the CLI engine the device runs.
+
+  `profile` is the engine read from the device (sros_cli_engine); without it the
+  render-time guess (sros_bootstrap_profile) is used."""
+  system_name = node.name.replace('_','-')
+  profile = profile or sros_bootstrap_profile(node, topology)
+
+  if profile == 'model-driven':
+    # MD-CLI only configures inside a configuration mode, and a candidate is
+    # applied by `commit` -- a bare `/configure ...` from operational mode is
+    # rejected. vrnetlab does the same (scrapli acquire_priv("configuration"),
+    # then commit + quit-config). The NETCONF enable is version specific, as in
+    # vrnetlab's get_version_specific_config: `netconf listen admin-state`
+    # from 24.3, `netconf admin-state` before (22.10 MD rejects `listen`).
+    major, _ = sros_version_from_image(node)
+    netconf_enable = (
+      '/configure system management-interface netconf listen admin-state enable' if major >= 24 else
+      '/configure system management-interface netconf admin-state enable')
+    return [
+      'environment more false',
+      'edit-config private',
+      f'/configure system name {system_name}',
+      '/configure system security aaa local-profiles profile administrative netconf base-op-authorization lock true',
+      '/configure system security aaa local-profiles profile "administrative" netconf base-op-authorization kill-session true',
+      '/configure system login-control ssh inbound-max-sessions 30',
+      '/configure system grpc admin-state enable',
+      '/configure system grpc allow-unsecure-connection',
+      '/configure system grpc gnmi auto-config-save true',
+      '/configure system grpc rib-api admin-state enable',
+      '/configure system management-interface netconf auto-config-save true',
+      netconf_enable,
+      '/configure system management-interface snmp packet-size 9216',
+      '/configure system management-interface snmp streaming admin-state enable',
+      '/configure system security user-params local-user user "admin" access console true',
+      '/configure system security user-params local-user user "admin" access ftp true',
+      '/configure system security user-params local-user user "admin" access netconf true',
+      '/configure system security user-params local-user user "admin" access grpc true',
+      '/configure system security snmp community "public" access-permissions r',
+      '/configure system security snmp community "public" version v2c',
+      '/configure system management-interface configuration-save configuration-backups 5',
+      '/configure system management-interface configuration-save incremental-saves false',
+      'commit',
+      'quit-config',
+    ]
+
+  return [
+    'environment no more',
+    f'/configure system name {system_name}',
+    '/configure system security profile "administrative" netconf base-op-authorization lock',
+    '/configure system login-control ssh inbound-max-sessions 30',
+    '/configure system management-interface yang-modules no base-r13-modules',
+    '/configure system netconf auto-config-save',
+    '/configure system netconf no shutdown',
+    '/configure system grpc allow-unsecure-connection',
+    '/configure system grpc gnmi auto-config-save',
+    '/configure system grpc gnmi no shutdown',
+    '/configure system grpc rib-api no shutdown',
+    '/configure system grpc no shutdown',
+    '/configure system security profile "administrative" netconf base-op-authorization kill-session',
+    '/configure system security profile "administrative" netconf base-op-authorization lock',
+    '/configure system snmp packet-size 9216',
+    '/configure system snmp streaming no shutdown',
+    '/configure system snmp no shutdown',
+    '/configure system security user "admin" access netconf',
+    '/configure system security user "admin" access console',
+    '/configure system security user "admin" access grpc',
+    '/configure system security user "admin" access ftp',
+    '/configure system security snmp community "public" r version v2c',
+    '/configure system management-interface configuration-mode model-driven',
+  ]
+
+# Both bootstrap profiles leave the device model-driven (the classic one switches
+# it, as vrnetlab does for 19-22), so the postcondition is read in MD-CLI: the
+# gRPC server must be operationally up.
+#
+# NOT `admin save`. vrnetlab persists the bootstrap, but on the KubeVirt vr-sros
+# 22.10 image it fails (`MINOR: MGMT_CORE #2501: Configuration save failed -
+# Could not complete save`, cf3 with 700 MB free; measured 2026-09-30), and a
+# KubeVirt containerDisk is rebuilt from the image on every VM start anyway, so
+# a save would not outlive the VMI. The license-activation reboot branch in
+# readiness-check/sros.yml (non-image-local licenses only) therefore comes back
+# without this bootstrap, and its gRPC verification fails loudly rather than
+# silently.
+SROS_BOOTSTRAP_VERIFY_LINES = [
+  'environment more false',
+  'info /state system grpc oper-state',
+]
+
+def _sros_transcript_tail(output: str, lines: int = 25) -> str:
+  text = (output or '').replace('\r', '').strip()
+  return '\n'.join(text.splitlines()[-lines:])
+
+def bootstrap_sros_post_start(node: Box, topology: Box) -> None:
+  host = str(node.get('ansible_host', '') or '').strip()
+  if not host:
+    return
+
+  user = str(
+    devices.get_node_group_var(node, 'ansible_user', topology.defaults) or
+    node.get('ansible_user', 'admin') or
+    'admin'
+  ).strip()
+  password = str(
+    devices.get_node_group_var(node, 'ansible_ssh_pass', topology.defaults) or
+    node.get('ansible_ssh_pass', '') or
+    user
+  )
+  ssh_args = shlex.split(str(devices.get_node_group_var(node, 'netlab_ssh_args', topology.defaults) or ''))
+  port_value = node.get('ansible_port', 22)
+  try:
+    port = int(port_value)
+  except Exception:
+    port = 22
+
+  ssh_cmd = [
+    'sshpass',
+    '-e',
+    'ssh',
+    '-tt',
+    '-o',
+    'ConnectTimeout=5',
+    '-o',
+    'StrictHostKeyChecking=no',
+    *ssh_args,
+    '-o',
+    'UserKnownHostsFile=/dev/null',
+    '-p',
+    str(port),
+    f'{user}@{host}',
+  ]
+
+  def session(lines: list[str]) -> tuple[int, str]:
+    payload = '\n'.join(lines + ['logout']) + '\n'
+    try:
+      result = subprocess.run(
+        ssh_cmd,
+        input=payload,
+        text=True,
+        capture_output=True,
+        env={ **os.environ, 'SSHPASS': password },
+        check=False,
+        timeout=180,
+      )
+    except subprocess.TimeoutExpired as ex:
+      out = ex.stdout.decode(errors='replace') if isinstance(ex.stdout, bytes) else (ex.stdout or '')
+      return 124, out
+    return result.returncode, (result.stdout or '') + (result.stderr or '')
+
+  retries = 60
+  delay = 5
+
+  # 1. Wait for an SR OS CLI and read which engine it runs.
+  engine = ''
+  output = ''
+  for attempt in range(1, retries + 1):
+    rc, output = session([])
+    engine = sros_cli_engine(output) if rc == 0 else ''
+    if engine:
+      break
+    if attempt < retries:
+      time.sleep(delay)
+  if not engine:
+    log.fatal(
+      f'SR OS post-start bootstrap failed for {node.name}: no SR OS CLI prompt over SSH '
+      f'{host}:{port} after {retries} attempts; last transcript:\n{_sros_transcript_tail(output)}',
+      module='kne')
+
+  # 2. Apply the bootstrap in that engine's syntax. A rejected line is a failure.
+  lines = sros_bootstrap_lines(node, topology, profile=engine)
+  apply_attempts = 5
+  errors: list[str] = []
+  for attempt in range(1, apply_attempts + 1):
+    rc, output = session(lines)
+    errors = sros_cli_errors(output)
+    if rc == 0 and not errors and sros_cli_engine(output):
+      break
+    if attempt < apply_attempts:
+      time.sleep(delay)
+  else:
+    log.fatal(
+      f'SR OS post-start bootstrap ({engine} CLI) failed for {node.name}: '
+      + (f'the device rejected {len(errors)} line(s): {"; ".join(errors)}' if errors else f'ssh exit {rc}')
+      + f'\nlast transcript:\n{_sros_transcript_tail(output)}',
+      module='kne')
+
+  # 3. Persist it and prove the gRPC server is operationally up.
+  for attempt in range(1, retries + 1):
+    rc, output = session(SROS_BOOTSTRAP_VERIFY_LINES)
+    errors = sros_cli_errors(output)
+    if rc == 0 and not errors and sros_cli_engine(output) == 'model-driven' and SROS_GRPC_OPER_UP_RE.search(output.replace('\r','')):
+      log.print_verbose(f'SR OS post-start bootstrap completed for {node.name} ({engine} CLI at start; gRPC oper-state up)')
+      return
+    if attempt < retries:
+      time.sleep(delay)
+
+  log.fatal(
+    f'SR OS post-start bootstrap for {node.name} applied cleanly ({engine} CLI) but the gRPC server '
+    f'is not operationally up in model-driven mode after {retries} checks'
+    + (f'; the device rejected: {"; ".join(errors)}' if errors else '')
+    + f'\nlast transcript:\n{_sros_transcript_tail(output)}',
+    module='kne')
+
+def is_linux_lineage(node: Box, topology: Box) -> bool:
+  """linux and every device that INHERITS from it.
+
+  ONE DEFINITION for "this is a linux-class host node", used by every KNE
+  code path that must treat such nodes alike: the namespace-exec config lane
+  and the `sh <script>` invocation that survives a noexec /tmp. It used to be
+  spelled as the literal `node.device == 'linux'` in each place, so a device
+  derived from linux silently fell out of every one of them: first
+  Ansible/SSH against an image with no sshd, then "exec: /tmp/netlab-initial.sh:
+  permission denied" (both measured 2026-09-13).
+
+  netlab consumes `parent:` at load, so lineage is read the way the template
+  finder reads it: the inherited ansible_network_os. OTG (parent: unknown,
+  netlab_initial: never) does not match and keeps its own path.
+  """
+  return devices.get_node_group_var(node,'ansible_network_os',topology.defaults) == 'linux'
+
+def add_default_config_mode(node: Box, topology: Box) -> None:
+  if node.device == 'sros':
+    return
+
+  cfg_mode = get_node_config_mode(node,topology)
+  # LINUX-LINEAGE HOST NODES take the namespace-exec (`:ns`) config lane: every
+  # module -- initial, modules, custom `config:` -- is rendered to a shell script
+  # and executed inside the container by the KNE provider (kubectl exec), never
+  # pushed over Ansible/SSH. That is what lets a linux node start sshd FROM its
+  # config instead of needing sshd to receive it.
+  #
+  # Membership is is_linux_lineage() -- one derived rule, not a name list.
+  if is_linux_lineage(node,topology):
+    mod_list = ['initial'] + node.get('module',[]) + node.get('config',[])
+    for m in mod_list:
+      append_to_list(node,'netlab_ansible_skip_module',m)
+      node.kne.config_templates[m.replace('.','@')] = ':ns'
+    return
+
+  # A device that boots its config cannot take a change that way while it is
+  # running. On a reconfigure render its delivery moves to the mode the defaults
+  # declare in netlab_reconfigure_mode (for example netmiko). netlab's deploy
+  # dispatches on the node's netlab_config_mode, so the node gets that mode; the
+  # boot mode is kept aside so the day-0 is rendered exactly as at bring-up.
+  reconfigure_mode = get_node_reconfigure_mode(node,topology)
+  if reconfigure_mode:
+    node._kne_boot_config_mode = cfg_mode
+    node.netlab_config_mode = reconfigure_mode
+    cfg_mode = reconfigure_mode
+
+  if cfg_mode == 'startup':
+    return
+
+  d_features = devices.get_device_features(node,topology.defaults)
+  if cfg_mode not in d_features.get('initial.config_mode',[]):
+    log.error(
+      f'Configuration mode {cfg_mode} is not valid for device {node.device} (node {node.name})',
+      module='kne',
+      category=log.IncorrectValue)
+    return
+
+  mod_list = ['normalize'] if d_features.initial.get('normalize',False) else []
+  mod_list += ['initial'] + node.get('module',[]) + node.get('config',[])
+  node_cfg = node.get('_node_config',{}) + node.get('_daemon_config',{})
+  node_cfg_path = devices.get_node_group_var(node,'netlab_config_path',topology.defaults)
+  for idx,m in enumerate(mod_list,start=1):
+    append_to_list(node,'netlab_ansible_skip_module',m)
+    m = m.replace('.','@')
+    if m in node_cfg:
+      continue
+
+    file_target = ''                              # netmiko sends the file over SSH, nothing is mapped
+    if cfg_mode in ('sh','cp_sh'):
+      cfg_path = node_cfg_path or '/etc/config/'
+      file_target = f'{cfg_path}{idx:02d}-{m}.sh'
+    node._node_config[m] = f'{file_target}:{cfg_mode}'
+
+def add_startup_config(node: Box, topology: Box) -> None:
+  mapping = KNE_NODE_MAP.get(node.device,{})
+  if not mapping_supports_startup_config(mapping):
+    return
+
+  startup_cfg = get_node_startup_config(node)
+  if is_linux_lineage(node,topology) and not startup_cfg and not get_templates_with_mode(node,'startup'):
+    return
+  if get_node_config_mode(node,topology) != 'startup' and not get_templates_with_mode(node,'startup') and not startup_cfg:
+    return
+
+  if startup_cfg:
+    # REFUSE a USER-SUPPLIED startup-config. netlab is the only producer of
+    # device configuration, and this key let a topology hand a node a finished
+    # file that replaced every line netlab renders -- undocumented, and
+    # unvalidated because netsim/providers/kne.yml declares no attributes:
+    # block, so even a typo in the key was silently ignored.
+    #
+    # THE DISCRIMINATOR MATTERS, and getting it wrong broke every
+    # startup-config device once already. netlab writes this same key itself
+    # three lines below, with the node's own output path, so "the key is set"
+    # does NOT mean "a user set it". A user's value is anything that is not
+    # startup_config_path(node) -- the exact test the iol/ioll2 branch below
+    # already makes for the same reason.
+    #
+    # The supported ways to supply configuration are netlab's own, and they are
+    # inputs to its renderer rather than a replacement for it:
+    #   config:       Jinja2 custom-configuration templates
+    #   configlets:   the same templates embedded in the topology (files plugin)
+    #   skip_config:  the items NOT to deploy; with module: [] that is
+    #                 "my config and nothing else", without a second renderer
+    if startup_cfg != startup_config_path(node):
+      log.error(
+        f'node {node.name}: kne.startup_config is not supported -- it would replace every line '
+        f'netlab renders with an unvalidated file, and netlab is the only producer of device '
+        f'configuration. Use `config:` with a Jinja2 template, or `configlets:` to embed one in '
+        f'the topology; add `skip_config: [ initial ]` and `module: []` for yours and nothing else.',
+        category=log.IncorrectValue,
+        module='kne')
+      return
+    node.kne.pop('startup-config',None)
+    node.kne.startup_config_source = startup_cfg
+  node.kne.startup_config = startup_config_path(node)
+  # DEVICES WHOSE DAY-0 CARRIES THE WHOLE CONFIG MUST NOT ALSO BE PUSHED IT.
+  #
+  # startup_config_path() is written from startup_config_modules(), i.e. the
+  # concatenation of EVERY rendered module file -- initial, services and each
+  # declared module. For the devices below the platform then hands that exact
+  # file to the appliance before it boots, so the ansible lane afterwards
+  # re-sends config the device already has.
+  #
+  # asav joined this list on 2026-09-09. It cost ~895s per ASA on demo-lab, twice,
+  # and the duplication was kept by decision 38cb0aed on the premise that
+  # "day-0 delivers management+ssh only ... the REAL config is ansible's job".
+  # That premise does not hold:
+  #   - kubeVirtASAvBootstrapUserData (patches/kne/0023) takes the WHOLE
+  #     startup_config byte slice; its only check is that it is non-empty.
+  #     There is no filtering and no management/ssh subsetting.
+  #   - the commit justified it via `netlab_initial: always`, which is read in
+  #     exactly one place -- ansible/reload-config.ansible, the RELOAD playbook.
+  #     It has no bearing on `netlab initial`.
+  #   - templates/initial/asa.j2 says so itself, in the comment explaining why
+  #     `crypto key generate rsa` needs `noconfirm`: "the ansible initial replay
+  #     of this same file".
+  #
+  # DAY-0-ONLY IS A DEVICE FEATURE, not a name list. A device that declares
+  # features.initial.startup_only boots its WHOLE rendered config from
+  # startup_config_path() and has no post-boot apply lane, so pushing it again
+  # over Ansible is pure duplication -- skip the Ansible modules for it. iol and
+  # ioll2 declare it (IOL boots `-c config` natively, no exec/ssh driver). The
+  # classification lives on the netlab DEVICE DEFINITION so adding a day0-only
+  # NOS is a device-def change, never a provider edit. A RECONFIGURE of such a
+  # device can still be delivered post-boot when the defaults declare
+  # netlab_reconfigure_mode (see get_node_reconfigure_mode); bring-up never is.
+  #
+  # asav deliberately does NOT declare startup_only. Its day-0 is applied by the
+  # ASA's CVAC at boot, and CVAC REJECTS the `router bgp / address-family` block
+  # mid-apply ("the context ... was destroyed by another session"), so a routed
+  # ASA (a DC firewall carrying eBGP to a leaf) would come up with no dynamic
+  # routing and no route back to its servers. So asav rides the native
+  # Ansible-over-SSH lane like every other VM (cisco.asa asa_config,
+  # network_cli): the day-0 still boots (startup_config_path is written above,
+  # unconditionally) and brings mgmt/SSH up, and `netlab initial` then replays
+  # the full config on the SETTLED device where the BGP block applies cleanly
+  # with no CVAC race. (asav was briefly forced day0-only on 2026-09-09 to save
+  # the ~895s replay; that traded correctness for speed and is reverted.)
+  #
+  # The other startup-mode devices (the three cisco_sdwan roles, csrx) deliver
+  # day-0 by a serial injector / cloud-init seed whose payload is NOT
+  # startup_config_path(); they do not declare startup_only and are handled by
+  # their own path, not here.
+  #
+  # RECONFIGURE IS UNAFFECTED: ASA has no whole-config replace primitive
+  # (NETLAB_CONFIG_REPLACE_REFUSALS) and uses the SSH lane for a warm
+  # reconfigure -- the same lane that now also carries its initial config.
+  #
+  # FortiOS is startup_only too: the KNE provider puts its WHOLE rendered
+  # config into the cloud-init user_data (generate_fortios_bootstrap), which the
+  # FortiGate reads once, at first boot of a factory disk. A running FortiGate
+  # never re-reads it, so its reconfigure is delivered over netmiko
+  # (netlab_reconfigure_mode), the same way as iol's.
+  d_features = devices.get_device_features(node,topology.defaults)
+  initial_features = d_features.get('initial',{})
+  if initial_features.get('startup_only',False) and get_node_config_mode(node,topology) == 'startup':
+    startup_source = get_node_startup_config(node)
+    if startup_source and startup_source != startup_config_path(node):
+      return
+
+    for module in startup_config_modules(node,topology):
+      append_to_list(node,'netlab_ansible_skip_module',module)
+
+# NETLAB_KNE_RECONFIGURE marks a render of a topology whose devices are ALREADY
+# RUNNING (a warm reconfigure), as opposed to a bring-up. It only matters to
+# startup-config nodes whose defaults declare netlab_reconfigure_mode (see
+# get_node_reconfigure_mode): their boot payload cannot carry a change to a
+# running device, so a reconfigure render delivers it post-boot instead. The
+# The platform runtime sets it in its config (reconfigure) mode only, next to
+# NETLAB_KNE_NAMESPACE.
+def kne_reconfigure_render() -> bool:
+  return str(os.environ.get('NETLAB_KNE_RECONFIGURE','') or '').strip().lower() in ('1','true','yes')
+
+# netlab_reconfigure_mode (a group variable) names the mode a RECONFIGURE render
+# delivers config in for a node that boots its config in startup mode, for
+# example netmiko for IOS. It only applies to a reconfigure render of a startup
+# node: bring-up still boots the whole config, and a node already delivered
+# post-boot (sh, netmiko, Ansible) keeps its own mode. Without it a startup
+# node has no post-boot lane and its reconfigure is the caller's business.
+def get_node_reconfigure_mode(node: Box, topology: Box) -> str:
+  if not kne_reconfigure_render():
+    return ''
+  if get_node_config_mode(node,topology) != 'startup':
+    return ''
+  mode = devices.get_node_group_var(node,'netlab_reconfigure_mode',topology.defaults)
+  return mode if isinstance(mode,str) and mode != 'startup' else ''
+
+def add_panos_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'panos':
+    return
+
+  node.kne.config_path = '/config'
+  node.kne.config_file = 'init-cfg.txt'
+  node.kne.startup_config = startup_config_path(node)
+
+def add_fortios_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'fortios':
+    return
+
+  node.kne.config_path = '/config'
+  node.kne.config_file = 'user_data'
+  node.kne.startup_config = startup_config_path(node)
+  # The cloud-init user_data carries the WHOLE rendered config
+  # (generate_fortios_bootstrap: every startup_config_modules() file), so on
+  # KNE FortiOS is a startup-config device (netlab_config_mode: startup and
+  # features.initial.startup_only in the runtime defaults): the boot applies
+  # everything and the Ansible modules are skipped. FortiOS reads user_data
+  # ONCE, at first boot of a factory disk, so a re-rendered user_data never
+  # reaches a running FortiGate; its reconfigure goes over netmiko
+  # (netlab_reconfigure_mode, netmiko_device_type fortinet). See
+  # add_startup_config and get_node_reconfigure_mode.
+
+def generate_startup_config(node: Box, topology: Box) -> None:
+  startup_source = get_node_startup_config(node)
+  if not startup_source:
+    return
+
+  startup_path = startup_config_path(node)
+  startup_text = ''
+  source_path = pathlib.Path(startup_source)
+  if startup_source != startup_path and source_path.exists():
+    startup_text = source_path.read_text()
+    if startup_text and not startup_text.endswith('\n'):
+      startup_text += '\n'
+  else:
+    startup_parts = []
+    startup_list = ordered_startup_template_sources(node,topology)
+    startup_files = []
+    for module in startup_list:
+      module_file = pathlib.Path('node_files') / node.name / module
+      if not module_file.exists():
+        continue
+      startup_files.append(module_file)
+
+    for idx,module_file in enumerate(startup_files):
+      startup_parts.append(
+        sanitize_startup_fragment(
+          node,
+          module_file.read_text(),
+          idx == len(startup_files) - 1).rstrip('\n'))
+
+    startup_text = "\n".join([ part for part in startup_parts if part ])
+    if startup_text:
+      startup_text += "\n"
+
+  pathlib.Path(startup_path).parent.mkdir(parents=True,exist_ok=True)
+  pathlib.Path(startup_path).write_text(startup_text)
+
+  if not log.QUIET:
+    log.status_created()
+    print(f"startup configuration for {node.name}",flush=True)
+
+def generate_panos_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'panos':
+    return
+
+  hostname = get_kne_node_name(node)
+  init_cfg = "\n".join([
+    'type=dhcp-client',
+    f'hostname={hostname}',
+    'panorama-server=',
+    'panorama-server-2=',
+    'tplname=',
+    'dgname=',
+    'vm-auth-key=',
+    'plugin-op-commands=',
+    'dhcp-send-hostname=yes',
+    '',
+  ])
+
+  startup_path = pathlib.Path(startup_config_path(node))
+  startup_path.parent.mkdir(parents=True,exist_ok=True)
+  startup_path.write_text(init_cfg)
+
+  if not log.QUIET:
+    log.status_created()
+    print(f"PAN-OS bootstrap init-cfg.txt for {node.name}",flush=True)
+
+def fortios_bootstrap_password(node: Box, topology: Box) -> str:
+  password = str(node.get('ansible_password','') or '').strip()
+  if password:
+    return password
+
+  try:
+    password = str(topology.defaults.devices.fortios.group_vars.ansible_password or '').strip()
+  except Exception:
+    password = ''
+  return password or 'admin'
+
+def generate_fortios_bootstrap(node: Box, topology: Box) -> None:
+  if node.device != 'fortios':
+    return
+
+  hostname = get_kne_node_name(node)
+  password = fortios_bootstrap_password(node,topology)
+  config_parts = [
+    "\n".join([
+      'config system global',
+      f'set hostname {hostname}',
+      'end',
+      'config system admin',
+      'edit admin',
+      f'set password {password}',
+      'end',
+      'config system interface',
+      'edit port1',
+      'set mode dhcp',
+      'set allowaccess ping http https ssh',
+      'next',
+      'end',
+    ])
+  ]
+  for module in startup_config_modules(node,topology):
+    module_file = pathlib.Path('node_files') / node.name / module
+    if not module_file.exists():
+      continue
+    module_text = module_file.read_text().strip()
+    if module_text:
+      config_parts.append(module_text)
+
+  config_body = "\n\n".join(config_parts)
+  boundary = '===============0740947994048919689=='
+  user_data = "\n".join([
+    f'Content-Type: multipart/mixed; boundary="{boundary}"',
+    'MIME-Version: 1.0',
+    '',
+    f'--{boundary}',
+    'Content-Type: text/plain; charset="us-ascii"',
+    'MIME-Version: 1.0',
+    'Content-Transfer-Encoding: 7bit',
+    'Content-Disposition: attachment; filename="config"',
+    '',
+    config_body,
+    f'--{boundary}--',
+    '',
+  ])
+
+  startup_path = pathlib.Path(startup_config_path(node))
+  startup_path.parent.mkdir(parents=True,exist_ok=True)
+  startup_path.write_text(user_data)
+
+  if not log.QUIET:
+    log.status_created()
+    print(f"FortiOS bootstrap user_data for {node.name}",flush=True)
+
+def config_target_directory(target: str) -> str:
+  return str(pathlib.PurePosixPath(target).parent)
