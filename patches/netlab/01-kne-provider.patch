+  when: netlab_device_type != 'ioll2'
   ios_config:
     src: "{{ config_template }}"
   tags: [ print_action, always ]
diff --git a/netsim/ansible/tasks/deploy-config/nxos.yml b/netsim/ansible/tasks/deploy-config/nxos.yml
index 3782e7e..638c7f3 100644
--- a/netsim/ansible/tasks/deploy-config/nxos.yml
+++ b/netsim/ansible/tasks/deploy-config/nxos.yml
@@ -1,3 +1,20 @@
+# Strip the day-0-delivered SSH bring-up lines from the config BEFORE nxos_config
+# re-applies it. n9kv's day-0 startup-config (kne bootstrap) already ran
+# "feature ssh" + "ssh key rsa 2048 force" to bring SSHv2 up at boot; nxos_config
+# connects OVER that ssh session, so re-issuing them forces an ssh restart that
+# NX-OS refuses ("Can't disable/re-enable ssh:Current user is logged in through
+# ssh"), failing the whole initial-config apply. The lines are rendered once and
+# shared by the day-0 AND this re-apply, so we cannot drop them from the template
+# (day-0 needs them) -- we strip them here, at apply time, on the control host. A
+# non-initial config module simply has no such lines (the regexp matches nothing).
+- name: "Strip day-0 ssh setup from {{ netsim_action }} re-apply (avoid feature-ssh re-toggle over the live ssh session)"
+  delegate_to: localhost
+  ansible.builtin.replace:
+    path: "{{ config_template }}"
+    regexp: '(?m)^[ \t]*((?:no )?feature ssh|ssh key rsa [0-9]+ force)[ \t]*$'
+    replace: '! skyforge: ssh setup delivered by day-0; not re-applied over ssh'
+  tags: [ always ]
+
 - name: "nxos_config: deploying {{ netsim_action }} from {{ config_template }}"
   nxos_config:
     src: "{{ config_template }}"
diff --git a/netsim/ansible/tasks/deploy-config/sros.yml b/netsim/ansible/tasks/deploy-config/sros.yml
index 819f203..2078a9b 100644
--- a/netsim/ansible/tasks/deploy-config/sros.yml
+++ b/netsim/ansible/tasks/deploy-config/sros.yml
@@ -2,8 +2,11 @@
 - name: Generate gNMI YAML configuration
   set_fact: yaml_config={{ lookup('template',config_template) }}
 
-- name: Update {{ netsim_action }} node configuration from gNMI template {{ config_template  }}
-  when: d|default([],True) != [] or u|default([],True) != [] or r|default([],True) != []
+# Apply each gNMI op separately. SR OS has been sensitive to batched mixed
+# prefix updates on the initial day0 payload, so keep the transaction shape
+# narrow and explicit.
+- name: Update {{ netsim_action }} node configuration delete entries from gNMI template {{ config_template }}
+  when: d|default([],True) != []
   vars:
     cfg: "{{ yaml_config | from_yaml }}"
     d: "{{ cfg.delete if 'delete' in cfg and cfg.delete is not string else [] }}"
@@ -13,12 +16,42 @@
     ansible_gnmi_encoding: JSON
     ansible_port: "{{ sros_grpc_port }}"
   nokia.grpc.gnmi_config:
-    # prefix: configure
-    delete: "{{ d }}"
-    replace: "{{ r }}"
-    update: "{{ u }}"
-  register: gnmi_set_result
+    delete: "{{ [ item | to_json | from_json ] }}"
+  loop: "{{ d }}"
+  loop_control:
+    label: "{{ item }}"
   tags: [ print_action, always ]
 
-- debug: var=gnmi_set_result
-  when: ansible_verbosity > 0
+- name: Update {{ netsim_action }} node configuration replace entries from gNMI template {{ config_template }}
+  when: r|default([],True) != []
+  vars:
+    cfg: "{{ yaml_config | from_yaml }}"
+    d: "{{ cfg.delete if 'delete' in cfg and cfg.delete is not string else [] }}"
+    u: "{{ cfg.updates if 'updates' in cfg and cfg.updates is not string else [] }}"
+    r: "{{ cfg.replace if 'replace' in cfg and cfg.replace is not string else [] }}"
+    ansible_connection: nokia.grpc.gnmi
+    ansible_gnmi_encoding: JSON
+    ansible_port: "{{ sros_grpc_port }}"
+  nokia.grpc.gnmi_config:
+    replace: "{{ [ item | to_json | from_json ] }}"
+  loop: "{{ r }}"
+  loop_control:
+    label: "{{ item.path | default('replace') }}"
+  tags: [ print_action, always ]
+
+- name: Update {{ netsim_action }} node configuration update entries from gNMI template {{ config_template }}
+  when: u|default([],True) != []
+  vars:
+    cfg: "{{ yaml_config | from_yaml }}"
+    d: "{{ cfg.delete if 'delete' in cfg and cfg.delete is not string else [] }}"
+    u: "{{ cfg.updates if 'updates' in cfg and cfg.updates is not string else [] }}"
+    r: "{{ cfg.replace if 'replace' in cfg and cfg.replace is not string else [] }}"
+    ansible_connection: nokia.grpc.gnmi
+    ansible_gnmi_encoding: JSON
+    ansible_port: "{{ sros_grpc_port }}"
+  nokia.grpc.gnmi_config:
+    update: "{{ [ item | to_json | from_json ] }}"
+  loop: "{{ u }}"
+  loop_control:
+    label: "{{ item.path | default('update') }}"
+  tags: [ print_action, always ]
diff --git a/netsim/ansible/tasks/readiness-check/fortios-kne.yml b/netsim/ansible/tasks/readiness-check/fortios-kne.yml
new file mode 100644
index 0000000..9bc157e
--- /dev/null
+++ b/netsim/ansible/tasks/readiness-check/fortios-kne.yml
@@ -0,0 +1,30 @@
+# FortiOS on KNE is ready when its CLI answers over SSH -- the lane netmiko
+# delivers a reconfigure over. Without this file the readiness play found no
+# script for fortios-kne and SKIPPED the wait, and netmiko does not retry.
+#
+# NOT ansible_port: the KNE provider sets ansible_port to the node's MANAGEMENT
+# SERVICE port, which for FortiOS is HTTP 80 (httpapi). The first live run
+# (demo-lab 2026-09-22) waited 600 s on :80. The provider publishes the SSH
+# service port as netmiko_port, so the wait probes the port netmiko will use.
+---
+- name: Wait for the FortiGate SSH server
+  delegate_to: localhost
+  ansible.builtin.wait_for:
+    host: "{{ ansible_host }}"
+    port: "{{ netmiko_port | default(22) }}"
+    timeout: "{{ (netlab_check_retries | default(60) | int) * (netlab_check_delay | default(10) | int) }}"
+    sleep: 5
+    state: started
+
+- name: Wait for the FortiOS CLI to answer
+  delegate_to: localhost
+  ansible.builtin.command: >-
+    sshpass -p '{{ ansible_ssh_pass }}'
+    ssh -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no
+        -p {{ netmiko_port | default(22) }}
+        {{ ansible_user }}@{{ ansible_host }} 'get system status'
+  register: fortios_status
+  changed_when: false
+  retries: "{{ netlab_check_retries | default(60) }}"
+  delay: "{{ netlab_check_delay | default(10) }}"
+  until: fortios_status.rc == 0 and fortios_status.stdout is search('Version:')
diff --git a/netsim/ansible/tasks/readiness-check/sros.yml b/netsim/ansible/tasks/readiness-check/sros.yml
index 2887308..6e519a7 100644
--- a/netsim/ansible/tasks/readiness-check/sros.yml
+++ b/netsim/ansible/tasks/readiness-check/sros.yml
@@ -1,14 +1,176 @@
-- name: Check that required plugin exists, use 'netlab install grpc' to install it
-  vars:
-    ansible_connection: nokia.grpc.gnmi
-  nokia.grpc.gnmi_config:
-    prefix: test-plugin
+- name: Check if 'sshpass' is installed for SR OS license readiness
+  local_action:
+    module: shell
+    cmd: which sshpass
+  changed_when: False
+  run_once: True
+  any_errors_fatal: True
+
+- name: Check for 'timeout' command for SR OS license readiness
+  local_action:
+    module: shell
+    cmd: which timeout || echo "FAILED"
+  changed_when: False
+  register: sros_have_timeout
+
+- name: Resolve SR OS license source mode for readiness flow
+  set_fact:
+    sros_license_source_is_image_local: "{{
+      (license_source_mode | default('') | lower()) == 'image-local'
+    }}"
+
+- name: Wait for SR OS license record or post-license reboot state on {{ ansible_host }}
+  local_action:
+    module: shell
+    cmd: |
+      {{ 'timeout -k 10s 20s' if "FAILED" not in sros_have_timeout.stdout else '' }} \
+      sh -c 'printf "environment no more\nshow system license\nlogout\n" | sshpass -e \
+      ssh -tt -o StrictHostKeyChecking=no {{ netlab_ssh_args|default('') }} \
+          -o UserKnownHostsFile=/dev/null {{ ansible_user }}@{{ ansible_host }}'
+  environment:
+    SSHPASS: "{{ ansible_ssh_pass }}"
+  changed_when: False
+  register: sros_license_out
+  until: sros_license_out.rc == 0
+  retries: "{{ netlab_check_retries | default(60) }}"
+  delay: "{{ netlab_check_delay | default(5) }}"
+
+- name: Activate SR OS license when the initial probe is not yet valid
+  local_action:
+    module: shell
+    cmd: |
+      {{ 'timeout -k 10s 30s' if "FAILED" not in sros_have_timeout.stdout else '' }} \
+      sh -c 'printf "environment no more\nadmin system license activate now\nlogout\n" | sshpass -e \
+      ssh -tt -o StrictHostKeyChecking=no {{ netlab_ssh_args|default('') }} \
+          -o UserKnownHostsFile=/dev/null {{ ansible_user }}@{{ ansible_host }}'
+  environment:
+    SSHPASS: "{{ ansible_ssh_pass }}"
+  changed_when: True
+  failed_when: false
+  register: sros_license_reboot_out
+  when: >
+    sros_license_out.rc == 0 and
+    'valid license record' not in sros_license_out.stdout and
+    not sros_license_source_is_image_local
+
+- name: Wait for SR OS SSH to drop for post-license activation on {{ ansible_host }}
+  local_action:
+    module: shell
+    cmd: |
+      {{ 'timeout -k 10s 20s' if "FAILED" not in sros_have_timeout.stdout else '' }} \
+      sh -c 'printf "admin reboot now\nlogout\n" | sshpass -e \
+      ssh -tt -o StrictHostKeyChecking=no {{ netlab_ssh_args|default('') }} \
+          -o UserKnownHostsFile=/dev/null {{ ansible_user }}@{{ ansible_host }}'
+  environment:
+    SSHPASS: "{{ ansible_ssh_pass }}"
+  changed_when: False
+  failed_when: false
+  register: sros_license_reboot_drop
+  until: sros_license_reboot_drop.rc != 0
+  retries: "{{ sros_license_reboot_drop_retries | default(60) }}"
+  delay: "{{ sros_license_reboot_drop_delay | default(5) }}"
+  when:
+    - sros_license_out.rc == 0
+    - "'valid license record' not in sros_license_out.stdout"
+    - not sros_license_source_is_image_local
+
+- name: Wait for SR OS valid license record on {{ ansible_host }}
+  local_action:
+    module: shell
+    cmd: |
+      {{ 'timeout -k 10s 20s' if "FAILED" not in sros_have_timeout.stdout else '' }} \
+      sh -c 'printf "environment no more\nshow system license\nlogout\n" | sshpass -e \
+      ssh -tt -o StrictHostKeyChecking=no {{ netlab_ssh_args|default('') }} \
+          -o UserKnownHostsFile=/dev/null {{ ansible_user }}@{{ ansible_host }}'
+  environment:
+    SSHPASS: "{{ ansible_ssh_pass }}"
+  changed_when: False
+  register: sros_valid_license_out
+  until: sros_valid_license_out.rc == 0 and 'valid license record' in sros_valid_license_out.stdout
+  retries: "{{ sros_license_reboot_retries | default(60) }}"
+  delay: "{{ sros_license_reboot_delay | default(5) }}"
+  when:
+    - sros_license_out.rc == 0
+    - "'valid license record' not in sros_license_out.stdout"
+    - not sros_license_source_is_image_local
 
-- name: Wait up to 180s for gNMI(TCP {{sros_grpc_port}}) to be ready on {{ ansible_host }}
+# gRPC IS ENABLED BY THE POST-START BOOTSTRAP, NOT HERE -- this proves it.
+#
+# The KNE provider's post-start bootstrap (bootstrap_sros_post_start) reads the
+# CLI engine the device runs, applies vrnetlab's management bootstrap in that
+# engine's syntax, switches a classic device to model-driven, saves, and fails
+# `netlab up` unless `/state system grpc oper-state` is up. On clab, vrnetlab's
+# launch.py does the same before the container is healthy.
+#
+# This task used to RE-ENABLE gRPC over SSH with classic commands (`... no
+# shutdown`). By the time it ran the device was model-driven, so MD-CLI rejected
+# every line (`MINOR: MGMT_CORE #2201: Unknown element - 'no'`) and the task
+# still reported `changed`: its only test was the ssh exit status, which is 0
+# whatever the device says. Measured 2026-09-30 on a vr-sros 22.10 KubeVirt pair.
+# It now only READS the device: the gRPC server must be operationally up in
+# model-driven mode, and a rejected command fails the task.
+- name: Verify the SR OS gRPC server is operationally up on {{ ansible_host }}
+  local_action:
+    module: shell
+    cmd: |
+      {{ 'timeout -k 10s 30s' if "FAILED" not in sros_have_timeout.stdout else '' }} \
+      sh -c 'printf "environment more false\ninfo /state system grpc oper-state\nlogout\n" | sshpass -e \
+      ssh -tt -o StrictHostKeyChecking=no {{ netlab_ssh_args|default('') }} \
+          -o UserKnownHostsFile=/dev/null {{ ansible_user }}@{{ ansible_host }}'
+  environment:
+    SSHPASS: "{{ ansible_ssh_pass }}"
+  changed_when: False
+  register: sros_grpc_state_out
+  until: >-
+    sros_grpc_state_out.rc == 0 and
+    sros_grpc_state_out.stdout is not search('(?m)^\s*(MINOR|MAJOR|CRITICAL|Error):') and
+    sros_grpc_state_out.stdout is search('(?m)^\s*oper-state up\s*$')
+  failed_when: >-
+    sros_grpc_state_out.rc != 0 or
+    sros_grpc_state_out.stdout is search('(?m)^\s*(MINOR|MAJOR|CRITICAL|Error):') or
+    sros_grpc_state_out.stdout is not search('(?m)^\s*oper-state up\s*$')
+  retries: "{{ netlab_check_retries | default(30) }}"
+  delay: "{{ netlab_check_delay | default(5) }}"
+
+# Upstream's own check, kept: the device can be up while the path to it is not.
+# A KubeVirt VM is reached through the pod IP only on the ports its masquerade
+# interface DNATs; 57400 was missing from that list, so gRPC was `oper-state up`
+# in the guest and refused at the pod (2026-09-30). Probing the TCP port on the
+# address netlab will use separates "no route to the gNMI port" from "gNMI
+# answered wrongly" instead of letting a gNMI retry loop time out on either.
+- name: Wait for gNMI (TCP {{ sros_grpc_port }}) to accept connections on {{ ansible_host }}
   local_action:
     module: wait_for
     port: "{{ sros_grpc_port }}"
     host: "{{ ansible_host }}"
-    connect_timeout: 60
-    timeout: 180
+    # Bounded on purpose: the device already reported gRPC up, so this waits
+    # only for the listener to settle. A missing path does not heal with time.
+    connect_timeout: 10
+    timeout: "{{ sros_grpc_port_wait | default(300) }}"
     sleep: 5
+    msg: >-
+      SR OS reports gRPC oper-state up, but TCP {{ ansible_host }}:{{ sros_grpc_port }} does not
+      accept connections from the netlab runner: the gNMI path (service / NAT / masquerade port
+      list) does not reach the device.
+
+- name: Check that required plugin exists, use 'netlab install grpc' to install it
+  vars:
+    ansible_connection: nokia.grpc.gnmi
+    ansible_port: "{{ sros_grpc_port }}"
+  nokia.grpc.gnmi_config:
+    prefix: test-plugin
+
+- name: Wait for SR OS gNMI state tree to respond on {{ ansible_host }}
+  vars:
+    ansible_connection: nokia.grpc.gnmi
+    ansible_gnmi_encoding: JSON
+    ansible_port: "{{ sros_grpc_port }}"
+  nokia.grpc.gnmi_get:
+    type: STATE
+    prefix: /state
+    path:
+    - system
+  register: sros_gnmi_ready
+  until: sros_gnmi_ready is succeeded
+  retries: "{{ netlab_check_retries | default(60) }}"
+  delay: "{{ netlab_check_delay | default(5) }}"
diff --git a/netsim/ansible/tasks/readiness-check/ssh.yml b/netsim/ansible/tasks/readiness-check/ssh.yml
