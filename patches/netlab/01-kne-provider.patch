diff --git a/tests/test_kne_interface_naming.py b/tests/test_kne_interface_naming.py
new file mode 100644
index 0000000..ab1db16
--- /dev/null
+++ b/tests/test_kne_interface_naming.py
@@ -0,0 +1,164 @@
+"""KNE kernel interface names must stay legal, and must agree with INTFTYPE.
+
+Both halves of this file exist because of one outage-shaped bug (2026-08-30):
+interface_key was changed to honour kne.interface.name, which is right for
+cEOS and wrong for everything whose declaration was copied from containerlab.
+meshnet renames the pod-side veth with netlink, so the name has to be a legal
+Linux interface name -- and iol declares Ethernet{ifindex // 4}/{ifindex % 4}.
+The rename failed with EINVAL and 63 of demo-lab's 79 pods sat in Init forever.
+"""
+
+import re
+import textwrap
+from argparse import Namespace
+from pathlib import Path
+
+import pytest
+
+from box import Box
+
+from netsim.cli import create, load_snapshot
+from netsim.providers import kne
+from netsim.augment import devices
+from netsim.utils import log
+from netsim.utils import read as _read
+
+
+def init_log(raise_error: bool = False) -> None:
+    log.init_log_system(header=False)
+    log.set_flag(quiet=True, raise_error=raise_error, warning=False, logging=False, verbose=0)
+
+
+def _kernel_name_is_legal(name: str) -> bool:
+    # Linux: IFNAMSIZ is 16 including the NUL, and '/' is never allowed.
+    return bool(name) and "/" not in name and len(name) <= 15
+
+
+@pytest.mark.parametrize("ifindex", [1, 2, 4, 5, 12])
+def test_interface_key_is_always_a_legal_kernel_name(ifindex: int) -> None:
+    """Every device, not just the ones we happened to boot."""
+    for device in ("iol", "ioll2", "eos", "cat8000v", "panos", "srsim", "linux"):
+        node = Box({"device": device}, default_box=True, box_dots=True)
+        intf = Box({"ifindex": ifindex}, default_box=True, box_dots=True)
+        name = kne.interface_key(node, intf, Box({}, default_box=True, box_dots=True))
+        assert _kernel_name_is_legal(name), (
+            f"{device} ifindex={ifindex} produced {name!r}, which meshnet cannot "
+            f"rename a link to (netlink returns EINVAL and the pod never leaves Init)"
+        )
+        assert re.fullmatch(r"eth\d+", name), (
+            f"{device} ifindex={ifindex} produced {name!r}; the KNE lane names pod "
+            f"links eth<N> and nothing else -- a NOS-shaped name here is the bug"
+        )
+
+
+def test_reserved_eth0_devices_start_at_eth1() -> None:
+    """NOS whose first vNIC is out-of-band management must not take eth0."""
+    for device in sorted(kne.KNE_RESERVED_ETH0_DEVICES):
+        node = Box({"device": device}, default_box=True, box_dots=True)
+        intf = Box({"ifindex": 0}, default_box=True, box_dots=True)
+        assert kne.interface_key(node, intf, Box({}, default_box=True, box_dots=True)) == "eth1"
+
+
+def test_eos_intftype_matches_kernel_name() -> None:
+    """cEOS is told a prefix; the links must be named with the same one.
+
+    INTFTYPE comes from the eos.yml declaration and the wired names come from
+    interface_key. They are computed independently, so nothing but a test stops
+    them drifting -- and when they drifted (INTFTYPE=et, links ethN) every
+    interface stayed down while tcpdump showed the frames arriving.
+    """
+    topology = Box({"defaults": _read.read_yaml("package:topology-defaults.yml")},
+                   default_box=True, box_dots=True)
+    node = Box({"device": "eos", "name": "s1"}, default_box=True, box_dots=True)
+    intf = Box({"ifindex": 1}, default_box=True, box_dots=True)
+
+    prefix = kne.eos_intftype(node, topology)
+    wired = kne.interface_key(node, intf, topology)
+    assert wired.startswith(prefix), (
+        f"cEOS is told INTFTYPE={prefix!r} but its links are named {wired!r}: "
+        f"the container creates interfaces with one name and meshnet wires the other"
+    )
+
+
+# Every KubeVirt-backed device NOT in kne.KNE_RESERVED_ETH0_DEVICES, with why.
+#
+# "KubeVirt-backed" alone does not predict membership in that set (checked
+# 2026-09-14, after vsrx shipped with this exact bug live): panos, a10,
+# fortios, dellos10, cat8000v, nxos, sros, versa-director, versa-flexvnf and
+# the cisco_sdwan-* devices are ALL KubeVirt-backed too and are correctly
+# excluded -- so this cannot be derived automatically without individually
+# verifying each device's first data link never lands on pod eth0. Until
+# someone does that (a real test, not a guess) and either moves a device into
+# KNE_RESERVED_ETH0_DEVICES or removes its entry here with the verifying
+# test's name, it stays UNVERIFIED: known, tracked, and not silently exposed
+# to the class of bug that broke vsrx.
+#
+# A device is removed from this dict only by adding it to
+# KNE_RESERVED_ETH0_DEVICES, or by a comment naming the test that verified it
+# safe.
+KUBEVIRT_ETH0_TRIAGE = {
+    'a10': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'panos': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'fortios': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'dellos10': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'cat8000v': (
+        'UNVERIFIED and SUSPECT -- interface_key\'s own docstring already names '
+        'cat8000v\'s kne.interface.name (eth{ifindex-1}) as one of the '
+        'containerlab-copied declarations that caused the 2026-08-30 demo-lab '
+        'Init-forever incident when honoured directly; it has never been tested '
+        'against THIS specific bug (first data link landing on eth0).'
+    ),
+    'nxos': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'sros': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'versa-director': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'versa-flexvnf': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'cisco_sdwan-controller': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'cisco_sdwan-manager': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+    'cisco_sdwan-validator': 'UNVERIFIED -- no known incident, not yet tested against this bug',
+}
+
+
+def test_kubevirt_devices_have_a_documented_eth0_decision(
+        tmp_path: Path,
+        monkeypatch: pytest.MonkeyPatch) -> None:
+    """Every KubeVirt-backed device must be triaged for the eth0-reservation bug.
+
+    KNE_RESERVED_ETH0_DEVICES is hand-maintained (see its own comment and
+    test_reserved_eth0_devices_start_at_eth1 above) -- nothing forced a device
+    newly onboarded onto a KubeVirt image to be added to it. vsrx replaced
+    csrx (2026-08-26), was never added, and hit exactly this bug bringing up
+    demo-lab (2026-09-13/14): its first data link landed on pod eth0,
+    kne dropped it from that node's own meshnet Topology CR, and the link's
+    OTHER endpoint failed bring-up with "could not find peer ... link UID N".
+
+    This does not try to derive membership automatically -- KubeVirt-backed-
+    ness alone does not predict it (see KUBEVIRT_ETH0_TRIAGE's own comment).
+    It only refuses to let a NEW KubeVirt device go undecided: it must be
+    either in KNE_RESERVED_ETH0_DEVICES or explicitly triaged below.
+    """
+    monkeypatch.chdir(tmp_path)
+    topo_file = Path(tmp_path / 'topology.yml')
+    topo_file.write_text(textwrap.dedent("""
+        provider: kne
+        nodes:
+          probe:
+            device: linux
+    """).strip() + '\n')
+
+    init_log()
+    create.run([str(topo_file)])
+    snapshot = load_snapshot(Namespace(snapshot='netlab.snapshot.pickle'))
+
+    kubevirt_devices = {
+        name for name, data in snapshot.defaults.devices.items()
+        if '/kubevirt/' in str(Box(data, default_box=True, box_dots=True).kne.image)
+    }
+    undocumented = kubevirt_devices - kne.KNE_RESERVED_ETH0_DEVICES - set(KUBEVIRT_ETH0_TRIAGE)
+    assert not undocumented, (
+        f"KubeVirt device(s) {sorted(undocumented)} have no eth0-reservation "
+        f"decision recorded. Add to kne.KNE_RESERVED_ETH0_DEVICES if the "
+        f"first data link must skip eth0, or to KUBEVIRT_ETH0_TRIAGE above "
+        f"with why not -- this is exactly the class of bug that shipped a "
+        f"broken vsrx to demo-lab; do not let a new device repeat it "
+        f"silently."
+    )
diff --git a/tests/test_kne_netmiko.py b/tests/test_kne_netmiko.py
new file mode 100644
index 0000000..c891471
--- /dev/null
+++ b/tests/test_kne_netmiko.py
@@ -0,0 +1,197 @@
+#!/usr/bin/env python3
+
+import textwrap
+from pathlib import Path
+
+import pytest
+from box import Box
+
+from netsim.augment import devices
+from netsim.cli import create
+from netsim.utils import log
+from netsim.utils import netmiko as _netmiko
+
+
+def write_topology(tmp_path: Path, topology: str) -> Path:
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent(topology).strip() + '\n')
+  return topo_file
+
+
+def init_log() -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=False,warning=False,logging=False,verbose=0)
+
+
+def test_kne_netmiko_mode_maps_every_module_to_netmiko(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent("""
+    provider: kne
+    defaults.devices.iosv.warnings.paramiko_50: False   # the host's paramiko is not under test
+    module: [ ospf ]
+    nodes:
+      r1: { device: iosv, netlab_config_mode: netmiko }
+      r2: { device: iosv }
+    links: [ r1-r2 ]
+    """).strip() + '\n')
+
+  init_log()
+  topology = create.run(['-o','none',str(topo_file)])
+  r1 = topology.nodes.r1
+  # netmiko sends the rendered file over SSH: no in-container script target
+  assert { 'initial', 'ospf' } <= set(r1._node_config)
+  assert set(r1._node_config.values()) == { ':netmiko' }
+  assert set(r1.netlab_ansible_skip_module) == set(r1._node_config)
+  # Control: without the mode the node keeps the Ansible lane
+  assert '_node_config' not in topology.nodes.r2
+  assert not topology.nodes.r2.get('netlab_ansible_skip_module',[])
+
+
+def test_netmiko_connects_where_ansible_does() -> None:
+  topology = Box({ 'defaults': { 'provider': 'kne', 'devices': { 'iosv': { 'group_vars': {} } } } },box_dots=True)
+  node = Box({
+    'name': 'r1', 'device': 'iosv', 'provider': 'kne',
+    'mgmt': { 'ipv4': '192.168.121.101' },
+    'netmiko_device_type': 'cisco_ios', 'ansible_user': 'vagrant', 'ansible_ssh_pass': 'vagrant',
+  },box_dots=True)
+  assert _netmiko.prepare_params(node,topology)['host'] == '192.168.121.101'
+  assert 'port' not in _netmiko.prepare_params(node,topology)
+
+  node.ansible_host = '10.96.4.7'           # a provider publishing the node behind a Service/NodePort
+  node.ansible_port = 30022
+  params = _netmiko.prepare_params(node,topology)
+  assert params['host'] == '10.96.4.7'
+  assert params['port'] == 30022
+
+  node.netmiko_port = 22                    # an httpapi device: ansible_port is not its SSH port
+  assert _netmiko.prepare_params(node,topology)['port'] == 22
+
+
+# netmiko does not save the configuration, and A10's driver cannot save_config().
+# netmiko_save_command saves it after a clean push, honours netlab_save_config,
+# and a save that the device rejects fails the node instead of reading green.
+class _FakeConnection:
+  def __init__(self, save_output: str = 'Building configuration...\n[OK]') -> None:
+    self.sent: list = []
+    self.save_output = save_output
+
+  def send_config_from_file(self, cfg_file: str, error_pattern: str = '') -> None:
+    self.sent.append(('config',cfg_file))
+
+  def set_base_prompt(self) -> None:
+    pass
+
+  def send_command(self, command: str) -> str:
+    self.sent.append(('command',command))
+    return self.save_output
+
+
+def _netmiko_deploy(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, conn: _FakeConnection, **group_vars: object) -> Box:
+  from netsim.cli.initial import netmiko as initial_netmiko
+  tmp_path.mkdir(parents=True,exist_ok=True)
+  monkeypatch.chdir(tmp_path)
+  Path('node_files/lb').mkdir(parents=True)
+  Path('node_files/lb/initial').write_text('hostname lb\n')
+  topology = Box({ 'defaults': { 'provider': 'kne', 'devices': { 'a10': { 'group_vars': {
+    'netmiko_error_regexp': [ '% Invalid input' ], **group_vars } } } } },box_dots=True)
+  node = Box({ 'name': 'lb', 'device': 'a10', 'provider': 'kne', '_node_config': { 'initial': ':netmiko' }, '_deploy': {} },box_dots=True)
+  monkeypatch.setattr(initial_netmiko._netmiko,'check_netmiko',lambda n: True)
+  monkeypatch.setattr(initial_netmiko._netmiko,'prepare_params',lambda n,t: { 'session_log': 'netmiko.log' })
+  monkeypatch.setattr(initial_netmiko._netmiko,'connect',lambda n,p: conn)
+  monkeypatch.setattr(initial_netmiko._netmiko,'has_commit',lambda c: False)
+  init_log()
+  initial_netmiko.deploy(node,topology,['initial'])
+  return node
+
+
+def test_netmiko_save_command_runs_after_a_clean_push(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  conn = _FakeConnection()
+  node = _netmiko_deploy(tmp_path,monkeypatch,conn,netmiko_save_command='write memory')
+  assert conn.sent == [ ('config','node_files/lb/initial'), ('command','write memory') ]
+  assert node._deploy.success == [ 'initial' ]
+  assert not node._deploy.get('failed',None)
+
+
+def test_netmiko_save_command_honours_netlab_save_config(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  conn = _FakeConnection()
+  _netmiko_deploy(tmp_path,monkeypatch,conn,netmiko_save_command='write memory',netlab_save_config=False)
+  assert ('command','write memory') not in conn.sent
+  # Control: without a save command nothing extra is sent either (upstream behaviour)
+  conn = _FakeConnection()
+  _netmiko_deploy(tmp_path / 'plain',monkeypatch,conn)
+  assert conn.sent == [ ('config','node_files/lb/initial') ]
+
+
+def test_netmiko_rejected_save_fails_the_node(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  conn = _FakeConnection(save_output="write memory\n% Invalid input detected at '^' marker.")
+  node = _netmiko_deploy(tmp_path,monkeypatch,conn,netmiko_save_command='write memory')
+  assert node._deploy.failed == [ 'save' ]
+
+
+# STARTUP FIRST, NETMIKO FOR RECONFIGURE. A device that boots its whole config
+# (iol) cannot take a change that way while it is running, so a reconfigure
+# render delivers it in the mode netlab_reconfigure_mode declares. The day-0 and
+# the KNE topology must not depend on which render it is.
+def _render_iol(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, reconfigure: bool, reconfigure_mode: str) -> tuple:
+  tmp_path.mkdir(parents=True,exist_ok=True)
+  monkeypatch.chdir(tmp_path)
+  if reconfigure:
