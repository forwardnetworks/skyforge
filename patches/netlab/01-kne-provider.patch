+def _bridge_node_block(provider_text: str, bridge_name: str) -> str:
+  # Slice the textproto block for one node out of the rendered topology.
+  marker = f'name: "{bridge_name}"'
+  assert marker in provider_text
+  start = provider_text.index(marker)
+  end = provider_text.find('\nnodes: {', start)
+  if end < 0:
+    end = provider_text.find('\nlinks: {', start)
+  assert end > start
+  return provider_text[start:end]
+
