+
+  provider_text = Path('topology.pb.txt').read_text()
+
+  # The 4-member LAN (linkindex 2) synthesizes a hidden HOST-vendor bridge node.
+  assert 'name: "br-2"' in provider_text
+  bridge_block = _bridge_node_block(provider_text,'br-2')
+  assert 'vendor: HOST' in bridge_block
+  assert 'model: "host"' in bridge_block
+  assert 'os: "linux"' in bridge_block
+  assert 'command: "/bin/sh"' in bridge_block
+  assert 'brctl addbr br0' in bridge_block
+  assert 'stp' in bridge_block
+  # one bridge port per member, in member order, with the segment MTU mirrored
+  for port in ('eth1','eth2','eth3','eth4'):
+    assert f'key: "{port}"' in bridge_block
+  assert 'key: "eth5"' not in bridge_block
+  assert 'mtu: 1370' in bridge_block
+
+  # 1 direct p2p link + 4 member<->bridge p2p links; no multi-endpoint links
+  assert provider_text.count('a_node:') == 5
+  # p2p link r1<->r2 is untouched (no regression)
+  assert 'a_node: "r1"\n  a_int: "eth1"\n  z_node: "r2"\n  z_int: "eth1"' in provider_text
+  # LAN members hang off the synthesized bridge with deterministic port numbering
+  assert 'a_node: "r1"\n  a_int: "eth2"\n  z_node: "br-2"\n  z_int: "eth1"' in provider_text
+  assert 'a_node: "r2"\n  a_int: "eth2"\n  z_node: "br-2"\n  z_int: "eth2"' in provider_text
+  assert 'a_node: "r3"\n  a_int: "eth1"\n  z_node: "br-2"\n  z_int: "eth3"' in provider_text
+  assert 'a_node: "h1"\n  a_int: "eth1"\n  z_node: "br-2"\n  z_int: "eth4"' in provider_text
+
+  # the snapshot textproto matches the rendered provider file, and the bridge
+  # never shows up as a managed netlab node (hidden from inventory/manifest)
+  snapshot = load_snapshot(Namespace(snapshot='netlab.snapshot.pickle'))
+  assert snapshot.kne.definition.topologyTextProto == provider_text
+  assert 'name: "br-2"' in snapshot.kne.definition.topologyTextProto
+  assert 'br-2' not in snapshot.nodes
+  assert 'br-2' not in snapshot.kne.nodeMeta
