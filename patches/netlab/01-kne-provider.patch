+def test_kne_startup_only_device_stays_skipped_on_a_reconfigure_render(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch) -> None:
+  # NETLAB_KNE_RECONFIGURE alone opens no lane. A startup_only device (iol)
+  # that declares no netlab_reconfigure_mode has no post-boot lane; its
+  # reconfigure is the runtime's business, never an Ansible replay.
+  monkeypatch.chdir(tmp_path)
