+def test_kne_eos_authors_management_interface_as_source_of_truth(tmp_path: Path) -> None:
+  # A 4-node eos ring: every node has two data links (eth1, eth2) and must also
+  # get an explicit management interface entry eth0 -> Management0. Prove the
+  # management interface is authored here (single source of truth) without ever
+  # (a) adding a meshnet link or (b) changing the meshnet interface count that
+  # KNE turns into CEosLabDevice.NumInterfaces and the init-wait tally.
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+
+nodes:
+  s1:
+    device: eos
+  s2:
+    device: eos
+  s3:
+    device: eos
+  s4:
+    device: eos
+
+links:
+- s1-s2
+- s2-s3
+- s3-s4
+- s4-s1
+""")
+  topology = load_transform(topo_file)
+
+  intf_map = build_kne_interface_map(topology)
+  links = build_kne_link_entries(topology)
+
+  for node_name in ('s1','s2','s3','s4'):
+    by_key = { entry['key']: entry['name'] for entry in intf_map[node_name] }
+    # management interface authored on eth0, derived from node.mgmt.ifname
+    assert by_key.get('eth0') == 'Management0', by_key
+    assert by_key['eth0'] == topology.nodes[node_name].mgmt.ifname
+    # data links remain on eth1/eth2 and are unchanged
+    assert by_key.get('eth1') == 'Ethernet1', by_key
+    assert by_key.get('eth2') == 'Ethernet2', by_key
+    # exactly one management entry + two data entries
+    assert len(intf_map[node_name]) == 3, intf_map[node_name]
+
+  # (a) meshnet wiring is untouched: still four p2p links, none of them touch
+  # eth0 (the management/CNI interface).
+  assert len(links) == 4
+  for link in links:
+    assert link['a_int'] != 'eth0'
+    assert link['z_int'] != 'eth0'
+
+  # (b) NumInterfaces contract. Arista's KNE node builder sets
+  # CEosLabDevice.NumInterfaces = len(GetNodeLinks(node)), and GetNodeLinks
+  # skips pod eth0. So the per-node meshnet-link count (the value that becomes
+  # NumInterfaces, and drives init-wait's NumInterfaces+1 tally) must equal the
+  # number of NON-eth0 interface-map entries -- i.e. adding eth0 did not change
+  # it.
+  meshnet_links_per_node: dict = { name: 0 for name in ('s1','s2','s3','s4') }
+  for link in links:
+    meshnet_links_per_node[link['a_node']] += 1
+    meshnet_links_per_node[link['z_node']] += 1
+  for node_name in ('s1','s2','s3','s4'):
+    data_entries = [ e for e in intf_map[node_name] if e['key'] != 'eth0' ]
+    assert meshnet_links_per_node[node_name] == len(data_entries) == 2
+
+  # And the rendered textproto shows the management interface as an interface
+  # block, never as a link endpoint.
+  provider_text = render_kne_topology_textproto(topology)
+  assert provider_text.count('key: "eth0"') == 4
+  assert provider_text.count('name: "Management0"') == 4
+  assert 'a_int: "eth0"' not in provider_text
+  assert 'z_int: "eth0"' not in provider_text
+
+
+def test_kne_non_eos_devices_do_not_get_management_interface_entry(tmp_path: Path) -> None:
+  # Gating proof: KNE_ETH0_MGMT_DEVICES is an eos-only allowlist, so every
+  # non-eos device is excluded at the first gate. Devices that reserve eth0 for
+  # the default CNI/data offset, or that derive NumInterfaces from the
+  # interface-map length (sros/Nokia), must NOT get a synthetic management
+  # entry or their interface accounting would break. iol and sros stand in for
+  # the non-eos families here -- both are upstream-netlab devices, so this test
+  # stays hermetic against pristine vendor/netlab; skyforge-only devices such
+  # as asac reach the same not-in-allowlist early return but are registered via
+  # the runtime defaults.yml (not present in this vendored pytest harness).
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+
+nodes:
+  hub:
+    device: eos
+  a:
+    device: iol
+  b:
+    device: sros
+
+links:
+- hub-a
+- hub-b
+""")
+  topology = load_transform(topo_file)
+  intf_map = build_kne_interface_map(topology)
+
+  hub_keys = { entry['key']: entry['name'] for entry in intf_map['hub'] }
+  assert hub_keys.get('eth0') == 'Management0'
+
+  for node_name in ('a','b'):
+    keys = { entry['key'] for entry in intf_map[node_name] }
+    names = { entry['name'] for entry in intf_map[node_name] }
+    assert 'eth0' not in keys, (node_name, intf_map[node_name])
+    assert 'Management0' not in names, (node_name, intf_map[node_name])
+
