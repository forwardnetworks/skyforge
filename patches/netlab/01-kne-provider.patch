+def config_template_source(item: object) -> str:
+  if isinstance(item,str):
+    return item.strip()
+  if isinstance(item,(dict,Box)):
+    return str(item.get('source',getattr(item,'source',None)) or '').strip()
+  return str(getattr(item,'source',item) or '').strip()
+
+def config_template_parts(item: object) -> tuple[str, str | None]:
+  source = config_template_source(item)
+  if isinstance(item,str):
+    return source, None
+
+  if isinstance(item,(dict,Box)):
+    mode = item.get('mode',getattr(item,'mode',None))
+  else:
+    mode = getattr(item,'mode',None)
+    if hasattr(item,'get'):
+      mode = item.get('mode',mode)
+
+  return source, str(mode).strip() if mode else None
+
+def build_kne_node_data(node: Box, topology: Box, node_interfaces: list) -> Box:
+  kne_data = Box(default_box=True,box_dots=True)
+  kne_data.update(node.get('kne',{}))
+
+  mapping = KNE_NODE_MAP[node.device]
+  kne_data.name = get_kne_node_name(node)
+  kne_data.vendor = mapping['vendor']
+  kne_data.model = mapping['model']
+  kne_data.os = mapping['os']
+  kne_data.image = str(node.box)
+  defaults_kne = topology.defaults.get('kne',Box(default_box=True,box_dots=True))
+  image_overrides = defaults_kne.get('image_overrides',Box(default_box=True,box_dots=True))
+  # The override map is the platform DEFAULT for a device type. A node whose
+  # author explicitly chose an image (nodes.<n>.image / kne.image — stamped
+  # _box_explicit by augment/nodes.py) keeps that choice: per-node version
+  # selection is how device upgrades are expressed, and a default must never
+  # beat an explicit choice.
+  #
+  # EXCEPT bare refs. Blueprints in the wild carry legacy shorthand like
+  # `image: ceos:4.36.0.1F` — no registry host, unpullable on this substrate.
+  # The overlay used to clobber those silently, which is what made them
+  # harmless; honouring them (2026-08-21, fleet8 reconfigure) sent the bare
+  # ref straight into the image-contract gate and failed the whole runtime
+  # job. An explicit choice wins only when it is FULLY QUALIFIED (its first
+  # path segment names a registry: contains a dot or a port). A bare ref is
+  # treated as the legacy shorthand it is: the platform default governs, and
+  # we say so.
+  def _image_fully_qualified(ref: str) -> bool:
+    first = str(ref).split('/', 1)[0]
+    return ('/' in str(ref)) and ('.' in first or ':' in first)
+
+  if node.device in image_overrides and image_overrides[node.device]:
+    if node.get('_box_explicit',False) and _image_fully_qualified(kne_data.image):
+      pass  # author's fully-qualified choice wins
+    else:
+      if node.get('_box_explicit',False):
+        log.info(f'node {node.name}: bare image ref {kne_data.image} is legacy shorthand; the platform pin for {node.device} governs','kne')
+      kne_data.image = str(image_overrides[node.device])
+  kne_data.services = get_kne_services(node)
+  kne_data.interfaces = node_interfaces
+  kne_data.labels = kne_data.get('labels', Box(default_box=True, box_dots=True))
+  if node.device == 'sros':
+    variant, _ = sros_variant_contract(node, topology)
+    bootstrap_profile = sros_bootstrap_profile(node, topology)
+    major, image_version = sros_version_from_image(node)
+    kne_data.labels['kne/sros-variant'] = variant
+    kne_data.labels['kne/sros-bootstrap-profile'] = bootstrap_profile
+    if major:
+      kne_data.labels['kne/sros-version-major'] = str(major)
+    if image_version:
+      kne_data.labels['kne/sros-version'] = image_version
+    kne_data['sros_bootstrap_profile'] = bootstrap_profile
+  resource_constraints = defaults_kne.get('resource_constraints',Box(default_box=True,box_dots=True))
+  if node.device in resource_constraints and isinstance(resource_constraints[node.device],(dict,Box)):
+    kne_data.constraints = kne_data.get('constraints',Box(default_box=True,box_dots=True))
+    for c_key in ('cpu','memory','ephemeral-storage'):
+      if c_key in resource_constraints[node.device] and resource_constraints[node.device][c_key]:
+        if c_key not in kne_data.constraints:
+          kne_data.constraints[c_key] = str(resource_constraints[node.device][c_key])
+    # hugepages-* (e.g. hugepages-2Mi) flows through VERBATIM: the key is a
+    # case-sensitive Kubernetes extended-resource name and the value a quantity.
+    # A pod that does not REQUEST hugepages is invisible to the scheduler's
+    # hugepage accounting, so a NOS that faults hugepage-backed memory at boot
+    # (XRd's /pkg/bin/config) SIGBUSes on pool-drained nodes instead of the pod
+    # pending. Downstream, the kne_cli node builders translate hugepages-*
+    # constraints into container requests+limits (k8s mandates limits==requests
+    # for hugepages).
+    for c_key in sorted(resource_constraints[node.device]):
+      if not str(c_key).startswith('hugepages-'):
+        continue
+      if resource_constraints[node.device][c_key] and c_key not in kne_data.constraints:
+        kne_data.constraints[c_key] = str(resource_constraints[node.device][c_key])
+
+  disable_startup_cfg = defaults_kne.get('disable_startup_config',[])
+  try:
+    disable_startup_set = { str(item) for item in list(disable_startup_cfg) }
+  except Exception:
+    disable_startup_set = set()
+  disable_startup_for_node = bool(kne_data.get('disable_startup_config',False)) or node.device in disable_startup_set
+  if disable_startup_for_node:
+    kne_data.pop('startup_config',None)
+    kne_data.pop('startup-config',None)
+    kne_data.pop('config_path',None)
+    kne_data.pop('config_file',None)
+
+  cfg_mode = get_node_config_mode(node,topology)
+  for adjuster in KNE_NODE_DATA_ADJUSTERS.get(node.device,()):
+    adjuster(kne_data,node,topology,cfg_mode,disable_startup_for_node)
+
+  if mapping_supports_startup_config(mapping) and not disable_startup_for_node:
+    startup_cfg = get_node_startup_config(node)
+    needs_startup_mount = bool(startup_cfg or cfg_mode == 'startup' or get_templates_with_mode(node,'startup'))
+    if node.device != 'sros':
+      needs_startup_mount = True
+    if needs_startup_mount:
+      kne_data.config_path = mapping['config_path']
+      kne_data.config_file = mapping['config_file']
+    if startup_cfg:
+      kne_data.pop('startup-config',None)
+      kne_data.startup_config_source = startup_cfg
+      kne_data.startup_config = startup_config_path(node)
+    elif cfg_mode == 'startup' or get_templates_with_mode(node,'startup'):
+      kne_data.startup_config = startup_config_path(node)
+
+  return kne_data
+
+def build_kne_render_node_data(node: Box, topology: Box, node_interfaces: list) -> Box:
+  if isinstance(node.get('kne',None),Box) and 'config_templates' in node.kne:
+    return build_kne_node_data(node,topology,node_interfaces)
+
+  render_node = get_box(node.to_dict())
+  render_node.kne = Box(default_box=True,box_dots=True)
+  render_node.kne.config_templates = Box(default_box=True,box_dots=True)
+  add_default_config_mode(render_node,topology)
+  run_kne_hooks(render_node,topology,KNE_PRE_STARTUP_BOOTSTRAP_HOOKS.get(render_node.device,()))
+  add_config_filemaps(render_node,topology)
+  normalize_kne_filemaps(render_node)
+  add_startup_config(render_node,topology)
+  run_kne_hooks(render_node,topology,KNE_POST_STARTUP_BOOTSTRAP_HOOKS.get(render_node.device,()))
+  return build_kne_node_data(render_node,topology,node_interfaces)
+
+def normalize_interface_mtu(value: object) -> int | None:
+  if isinstance(value,bool):
+    return None
+  if isinstance(value,int):
+    return value if value > 0 else None
+  if isinstance(value,str):
+    value = value.strip()
+    if value.isdigit():
+      mtu = int(value)
+      return mtu if mtu > 0 else None
+  return None
+
+def render_kne_topology_textproto(topology: Box) -> str:
+  search_path = _files.get_search_path('kne',pkg_path_component='templates/provider/kne')
+  topo_data = get_box(topology.to_dict())
+  topo_data.kne_name = str(topo_data.get('kne_name',get_kne_topology_name(topology)) or get_kne_topology_name(topology))
+  topo_data.kne_links = [
+    get_box(link) if not isinstance(link,Box) else link
+      for link in topo_data.get('kne_links',build_kne_link_entries(topology))
+  ]
+  topo_data.kne_bridges = [
+    get_box(bridge) if not isinstance(bridge,Box) else bridge
+      for bridge in topo_data.get('kne_bridges',build_kne_bridge_entries(topology))
+  ]
+  node_interfaces = build_kne_interface_map(topology)
+  for node_name,node in topology.nodes.items():
+    if devices.get_provider(node,topology.defaults) != 'kne':
+      continue
+    topo_data.nodes[node_name].kne = build_kne_render_node_data(
+      node,
+      topology,
+      node_interfaces.get(node_name,[]))
+  return templates.render_template(
+    data=topo_data,
+    j2_file='topology.pb.txt.j2',
+    extra_path=search_path)
+
+def build_kne_snapshot_metadata(topology: Box) -> dict:
+  node_meta: dict = {}
+  node_interfaces = build_kne_interface_map(topology)
+  for node_name,node in topology.nodes.items():
+    if devices.get_provider(node,topology.defaults) != 'kne':
+      continue
+    kne_data = build_kne_render_node_data(
+      node,
+      topology,
+      node_interfaces.get(node_name,[]))
+    node_meta[node_name] = {
+      'kneName': str(kne_data.get('name',get_kne_node_name(node)) or get_kne_node_name(node)),
+      'image': str(kne_data.get('image',node.get('box','')) or '').strip(),
+    }
+
+  metadata = {
+    'contract': _KNE_CONTRACT,
+    'provider': 'kne',
+    'runtimeBackend': _KNE_RUNTIME_BACKEND,
+    'topologyNamespace': get_kne_topology_name(topology),
+    'definition': {
+      'topologyTextProto': render_kne_topology_textproto(topology)
+    },
+    'nodeMeta': node_meta,
+  }
+  if topology.get('sdwan.inventory',None):
+    metadata['sdwan'] = {'inventory': topology.sdwan.inventory}
+    if topology.get('sdwan.lifecycle',None):
+      metadata['sdwan']['lifecycle'] = topology.sdwan.lifecycle
+    if topology.get('sdwan.capacity',None):
+      metadata['sdwan']['capacity'] = topology.sdwan.capacity
+  return metadata
+
+def save_runtime_snapshot(topology: Box) -> None:
+  snapshot_file = pathlib.Path('netlab.snapshot.pickle')
+  if not snapshot_file.exists():
+    return
+
+  topodict = topology_cleanup.cleanup_topology(topology).to_dict()
+  topodict['kne'] = build_kne_snapshot_metadata(topology)
+  topodict['_netlab_version'] = __version__
+  try:
+    with snapshot_file.open(mode='wb') as output:
+      pickle.dump(topodict,output)
+  except Exception as ex:
+    log.error(
+      f'Cannot update runtime snapshot file {snapshot_file}',
+      more_data=[ str(ex) ],
+      module='kne')
+
+class KNE(_Provider):
+
+  def augment_runtime_snapshot(self, topology: Box, snapshot: dict) -> None:
+    snapshot['kne'] = build_kne_snapshot_metadata(topology)
+
+  # THE FABRIC MTU MUST LAND BEFORE THE DEVICE QUIRKS RUN, not after.
+  #
+  # This was the first statement of post_transform, four lines too late in
+  # netsim/augment/main.py: quirks.process_quirks() fires before
+  # providers.execute('post_transform'). netlab's own Junos quirk
+  # (netsim/devices/junos.py set_junos_mtu) reads intf.mtu and derives
+  # intf._junos_mtu_with_headers = mtu + 14; the template then emits a
+  # device-level `mtu 8964` and SUPPRESSES the family-level `mtu` exactly when
+  # that variable is set. Because the MTU was not on the interface yet the
+  # quirk never fired, the guard fell through, and the config carried
+  #
+  #     family inet { address ...; mtu 8950; }
+  #
+  # with no device MTU under it. JunOS answers that with
+  #
+  #     Family MTU 8950 is too large relative to device MTU 1514
+  #     mgd: error: configuration check-out failed
+  #
+  # and refuses the ENTIRE commit, so the box boots as Amnesiac -- no hostname,
+  # no admin user, no sshd -- and the collector reads it as unreachable. Four vJunos
+  # nodes in demo-lab sat in that state from the day the fabric contract moved to
+  # 8950. Below 1500 a bare family MTU is legal on its own, which is why the
+  # bug could not show itself before.
+  #
+  # Setting _junos_mtu_with_headers from here instead would work and would be
+  # wrong: it forks netlab's quirk, including its 22-byte flexible-VLAN
+  # variant, and the copy would drift. Run before the quirk and the quirk stays
+  # the single owner of the Junos MTU rule.
+  def pre_quirks(self, topology: Box) -> None:
+    apply_kne_link_mtu(topology)
+
+  def post_transform(self, topology: Box) -> None:
+    for node in topology.nodes.values():
+      if devices.get_provider(node,topology.defaults) != 'kne':
+        continue
+      node.kne = node.get('kne',Box(default_box=True,box_dots=True))
+      node.kne.config_templates = node.kne.get('config_templates',Box(default_box=True,box_dots=True))
+      if node.device == 'sros':
+        major, image_version = sros_version_from_image(node)
+        node.kne['sros_bootstrap_profile'] = sros_bootstrap_profile(node, topology)
+        if major:
+          node.kne['sros_version_major'] = major
+        if image_version:
+          node.kne['sros_version'] = image_version
+      if node.device == 'csrx':
+        adjust_csrx_node_data(node.kne,node,topology)
+      add_default_config_mode(node,topology)
+      run_kne_hooks(node,topology,KNE_PRE_STARTUP_BOOTSTRAP_HOOKS.get(node.device,()))
+      add_config_filemaps(node,topology)
+      normalize_kne_filemaps(node)
+      add_startup_config(node,topology)
+      run_kne_hooks(node,topology,KNE_POST_STARTUP_BOOTSTRAP_HOOKS.get(node.device,()))
+
+  def pre_output_transform(self, topology: Box) -> None:
+    _Provider.pre_output_transform(self,topology)
+
+    for node in topology.nodes.values():
+      if node.device not in KNE_NODE_MAP:
+        log.error(
+          f'Node {node.name} uses unsupported device {node.device} with the kne provider',
+          category=log.IncorrectValue,
+          module='kne')
+      validate_mgmt_ip(node,required=True,provider='kne',mgmt=topology.addressing.mgmt)
+
+    kne_node_names = { get_kne_node_name(node) for node in topology.nodes.values() }
+    for link in topology.links:
+      if kne_link_is_multi_access(link):
+        # Multi-access (LAN) links are legal: they are expanded into a
+        # synthesized bridge node plus per-member p2p links at export time.
+        bridge_name = get_kne_bridge_name(link)
+        if bridge_name in kne_node_names:
+          log.error(
+            f'Synthesized bridge node name {bridge_name} for multi-access link '
+            f'{link.get("name","unnamed link")} collides with an existing node name; '
+            'rename that node',
+            category=log.IncorrectValue,
+            module='kne')
+        continue
+      if len(link.interfaces) != 2 or link.node_count != 2:
+        log.error(
+          f'KNE provider supports only point-to-point and multi-access LAN links '
+          f'(found {link.get("name","unnamed link")})',
+          category=log.IncorrectValue,
+          module='kne')
+
+  def transform(self, topology: Box) -> None:
+    _Provider.transform(self,topology)
+
+    topology.kne_name = get_kne_topology_name(topology)
+    topology.kne_links = build_kne_link_entries(topology)
+    topology.kne_bridges = build_kne_bridge_entries(topology)
+    node_interfaces = build_kne_interface_map(topology)
+    for node in topology.nodes.values():
+      node.kne = build_kne_node_data(
+        node,
+        topology,
+        node_interfaces.get(node.name,[]))
+
+  def post_configuration_create(self, topology: Box) -> None:
+    for node in topology.nodes.values():
+      if devices.get_provider(node,topology.defaults) != 'kne':
+        continue
+
+      generator = KNE_STARTUP_CONFIG_GENERATORS.get(node.device,generate_startup_config)
+      generator(node,topology)
+
+  def post_start_lab(self, topology: Box) -> None:
+    if is_dry_run():
+      return
+
+    namespace = get_kne_topology_name(topology)
+    kne_nodes = [ node for node in topology.nodes.values() if devices.get_provider(node,topology.defaults) == 'kne' ]
+    changed = False
+    refreshed_nodes: set[str] = set()
+
+    for _ in range(KNE_RUNTIME_INVENTORY_RETRIES):
+      services = load_kubectl_json(['kubectl','-n',namespace,'get','svc','-o','json'])
+      pods = load_kubectl_json(['kubectl','-n',namespace,'get','pods','-o','json'])
+      nodes = load_kubectl_json(['kubectl','get','nodes','-o','json'])
+
+      refreshed_nodes = set()
+      for node in kne_nodes:
+        service_name = f'service-{get_kne_node_name(node)}'
+        mgmt_service = get_kne_mgmt_service(node,topology)
+        if mgmt_service is None:
+          continue
+        runtime_host = ''
+        runtime_port = 0
+        pod_node = get_kne_pod_node(pods,get_kne_node_name(node))
+        if running_in_kubernetes():
+          runtime_host = get_kne_service_cluster_ip(services,service_name)
+          if runtime_host:
+            runtime_port = get_kne_service_cluster_port(services,service_name,mgmt_service)
+            if not runtime_port:
+              runtime_host = ''
+        # ONE ADDRESS FAMILY PER NODE. Every other service port (gNMI, SSH)
+        # must be read from the same family ansible_host came from: service
+        # ports belong with the ClusterIP, NodePorts with a node address. Asking
+        # running_in_kubernetes() again per port broke that whenever an
+        # in-cluster runner fell back to the NodePort (no ClusterIP): SR OS got
+        # ansible_host=<node IP> with sros_grpc_port=57400, a port no node
+        # listens on.
+        use_cluster_ports = bool(runtime_host)
+        if not runtime_host:
+          node_port = get_kne_nodeport(services,service_name,mgmt_service)
+          if not node_port:
+            continue
+          runtime_port = node_port
+          if pod_node:
+            runtime_host = get_kne_node_ip(nodes,pod_node)
+          if not runtime_host:
+            runtime_host = get_kne_runtime_host(nodes)
+        if not runtime_host:
+          continue
+        node.kne.runtime_node = pod_node or ''
+        node.ansible_host = runtime_host
+        node.ansible_port = runtime_port
+        conn = str(
+          devices.get_node_group_var(node,'ansible_connection',topology.defaults) or
+          node.get('ansible_connection','') or '').strip().lower()
+        if conn == 'httpapi':
+          node.ansible_httpapi_port = runtime_port
+        if node.device == 'sros':
+          gnmi_service = get_kne_service_by_name_or_port(node,['gnmi','gnoi','gnsi'],[57400])
+          gnmi_port = get_kne_service_port(services,service_name,gnmi_service,use_cluster_ports)
+          if gnmi_port:
+            node.sros_grpc_port = gnmi_port
+          bootstrap_sros_post_start(node,topology)
+        # When the management service is not SSH (httpapi FortiOS, https PAN-OS),
+        # ansible_port above is that service's port, so the SSH lanes get the
+        # SSH service port of their own: netmiko_port for netlab's netmiko
+        # deploy, panos_kne_ssh_port for the PAN-OS bootstrap tasks.
+        ssh_service = get_kne_service_by_name_or_port(node,['ssh'],[22])
+        ssh_port = 0
+        if ssh_service is not None and (ssh_service != mgmt_service or node.device == 'panos'):
+          ssh_port = get_kne_service_port(services,service_name,ssh_service,use_cluster_ports)
+        if ssh_port and ssh_service != mgmt_service:
+          node.netmiko_port = ssh_port
+        if ssh_port and node.device == 'panos':
+          node.panos_kne_ssh_port = ssh_port
+        refreshed_nodes.add(node.name)
+        changed = True
+
+      if len(refreshed_nodes) == len(kne_nodes):
+        break
+
+      time.sleep(KNE_RUNTIME_INVENTORY_DELAY)
+
+    if not changed:
+      return
+
+    update_runtime_inventory(topology)
+    save_runtime_snapshot(topology)
+
+  def deploy_node_config(self, node: Box, topology: Box, deploy_list: list) -> None:
+    cfg_files = kne_config_template_items(node)
+    if not cfg_files:
+      return
+
+    namespace = get_kne_topology_name(topology)
+    node_name = get_kne_node_name(node)
+    shell_cfgs = []
+    for cfg_item in cfg_files:
+      mod_name, f_type = config_template_parts(cfg_item)
+      if not mod_name:
+        continue
+
+      if f_type == 'startup':
+        if mod_name in deploy_list:
+          append_to_list(node._deploy,'startup',mod_name)
+        continue
+
+      if f_type == 'ns':
+        if mod_name not in deploy_list:
+          continue
+        # clab namespace-side scripts (target omitted, mode=ns) can be run
+        # directly in the KNE pod namespace. Assign a deterministic in-pod
+        # target and treat them as shell scripts.
+        cfg_item.mode = 'sh'
+        if not cfg_item.get('target',''):
+          safe_mod_name = str(mod_name).replace('.','-')
+          cfg_item.target = f'/tmp/netlab-{safe_mod_name}.sh'
+        shell_cfgs.append(cfg_item)
+        continue
+
+      if f_type not in ('sh','cp_sh'):
+        continue
+
+      shell_cfgs.append(cfg_item)
+
+    for cfg_item in shell_cfgs:
+      mod_name = cfg_item.source
+      if not cfg_item.target:
+        log.error(
+          f'Internal error: shell script for module {mod_name} does not have a target path',
+          more_data = [f'node: {node.name} / device: {node.device}'],
+          category=log.FatalError,
+          module='kne')
+        append_to_list(node._deploy,'failed',mod_name)
+        break
+
+      target_dir = config_target_directory(cfg_item.target)
+      if target_dir not in ('','.'):
+        mkdir_cmd = ['kubectl','exec','-n',namespace,node_name,'--','mkdir','-p',target_dir]
+        (mkdir_status,mkdir_stdout,mkdir_stderr) = run_kubectl_with_retries(mkdir_cmd)
+        if mkdir_status != 0:
+          details = [f'Executed command: {" ".join(mkdir_cmd)}']
+          if mkdir_stdout.strip():
+            details.append(f'stdout: {mkdir_stdout.strip()}')
+          if mkdir_stderr.strip():
+            details.append(f'stderr: {mkdir_stderr.strip()}')
+          log.error(
+            f'Cannot create directory {target_dir} on node {node.name}',
+            category=log.FatalError,
+            more_data=details,
+            skip_header=True,
+            module='initial')
+          append_to_list(node._deploy,'failed',mod_name)
+          break
+
+      copy_cmd = [
+        'kubectl','cp',
+        f'node_files/{node.name}/{cfg_item.source}',
+        f'{namespace}/{node_name}:{cfg_item.target}'
+      ]
+      (cp_status,cp_stdout,cp_stderr) = run_kubectl_with_retries(copy_cmd)
+      if cp_status != 0:
+        source_path = f'node_files/{node.name}/{cfg_item.source}'
+        (stream_status,stream_stdout,stream_stderr) = stream_file_into_pod(
+          namespace,
+          node_name,
+          source_path,
+          cfg_item.target,
+          make_executable=True)
+        if stream_status != 0:
+          details = [f'Executed command: {" ".join(copy_cmd)}']
+          if cp_stdout.strip():
+            details.append(f'kubectl cp stdout: {cp_stdout.strip()}')
+          if cp_stderr.strip():
+            details.append(f'kubectl cp stderr: {cp_stderr.strip()}')
+          details.append(
+            'Fallback command: kubectl exec -i '
+            f'-n {namespace} {node_name} -- sh -c '
+            f'"cat > {shlex.quote(cfg_item.target)} && chmod 755 {shlex.quote(cfg_item.target)}"')
+          if stream_stdout.strip():
+            details.append(f'fallback stdout: {stream_stdout.strip()}')
+          if stream_stderr.strip():
+            details.append(f'fallback stderr: {stream_stderr.strip()}')
+          log.error(
+            f'Cannot copy configuration file {cfg_item.source} into pod {node_name} as {cfg_item.target}',
+            category=log.FatalError,
+            module='kne',
+            more_data=details,
+            skip_header=True)
+          append_to_list(node._deploy,'failed',mod_name)
+          break
+
+    else:
+      for cfg_item in shell_cfgs:
+        mod_name = cfg_item.source
+        if mod_name not in deploy_list:
+          continue
+
+        config_cmd = ['kubectl','exec','-n',namespace,node_name,'--']
+        if is_linux_lineage(node,topology):
+          # Some Kubernetes runtimes mount /tmp with noexec, and an image may
+          # land the copied script without an execute bit. Running it via `sh`
+          # keeps every linux-class host's day0 compatible without relaxing
+          # container mounts. Lineage, not the literal name: a linux-derived
+          # device hit "exec:
+          # /tmp/netlab-initial.sh: permission denied" when this said == 'linux'.
+          config_cmd.extend(['sh',cfg_item.target])
+        else:
+          config_cmd.append(cfg_item.target)
+        log.info(f'Executing {mod_name} configuration for node {node.name}')
+        with kne_config_exec_slot(node.name, mod_name):
+          (status,run_stdout,run_stderr) = run_kubectl_with_retries(config_cmd)
+        if status == 0:
+          append_to_list(node._deploy,'success',mod_name)
+          continue
+
+        printout = ''
+        if run_stdout:
+          stdout = run_stdout.strip(" \n") + "\n"
+          printout += '  ' + strings.wrap_error_message(stdout,indent=2)
+        if run_stderr:
+          stderr = run_stderr.strip(" \n") + "\n"
+          printout += '  ' + strings.wrap_error_message(stderr,indent=2)
+        if printout:
+          strings.print_colored_text(txt=printout,color='bright_black')
+        details = [f'Executed command: {" ".join(config_cmd)}']
+        if run_stdout.strip():
+          details.append(f'stdout: {run_stdout.strip()}')
+        if run_stderr.strip():
+          details.append(f'stderr: {run_stderr.strip()}')
+        log.error(
+          f'{mod_name} configuration in namespace {namespace} failed for node {node.name}',
+          category=log.FatalError,
+          more_data=details,
+          skip_header=True,
+          module='initial')
+        append_to_list(node._deploy,'failed',mod_name)
+        break
