+def test_kne_deploy_node_config_retries_transient_kubectl_failures(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+
+nodes:
+  r1:
+    device: eos
+    netlab_config_mode: sh
+  r2:
+    device: iol
+
+links:
+- r1-r2
+  """)
+
+  init_log()
+  topology = create.run(['-o','config','-o','provider',str(topo_file)])
+  provider = cast(KNE,get_provider_module(topology,'kne'))
+
+  commands: list[list[str]] = []
+  failures_left: dict[tuple[str,...],int] = {}
+  namespace = dns_1035_name(topology.name,'topo')
+  node_name = dns_1035_name(topology.nodes.r1.name)
+  mkdir_cmd = ('kubectl','exec','-n',namespace,node_name,'--','mkdir','-p','/mnt/flash')
+  cp_cmd = ('kubectl','cp','node_files/r1/initial',f'{namespace}/{node_name}:/mnt/flash/02-initial.sh')
+  run_cmd = ('kubectl','exec','-n',namespace,node_name,'--','/mnt/flash/02-initial.sh')
+  failures_left[mkdir_cmd] = 1
+  failures_left[cp_cmd] = 1
+  failures_left[run_cmd] = 1
+
+  def fake_run_command(cmd: list[str], **kwargs: object) -> int:
+    commands.append(unwrap_kubectl(cmd))
+    external_commands.set_captured_output()
+    if kwargs.get('return_exitcode',False):
+      key = tuple(unwrap_kubectl(cmd))
+      if failures_left.get(key,0) > 0:
+        failures_left[key] = failures_left[key] - 1
+        external_commands.set_captured_output('','transient transport error')
+        return 1
+      return 0
+    return True  # type: ignore[return-value]
+
+  monkeypatch.setattr(external_commands,'run_command',fake_run_command)
+  provider.deploy_node_config(topology.nodes.r1,topology,['initial'])
+
+  assert commands.count(list(mkdir_cmd)) >= 2
+  assert commands.count(list(cp_cmd)) == 2
+  assert commands.count(list(run_cmd)) == 2
+  assert 'failed' not in topology.nodes.r1.get('_deploy',{})
+  assert 'initial' in topology.nodes.r1.get('_deploy.success',[])
+
