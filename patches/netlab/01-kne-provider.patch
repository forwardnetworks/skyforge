+def pinned_image(topology: Box, device: str) -> str:
+  """The image netlab resolves for `device` on the KNE provider from the
+  DEFAULTS IN FORCE -- the runtime's digest pins when run-tests.sh mirrors
+  components/server/netlab/runtime/defaults.yml into HOME, upstream's vendor
+  box against a bare checkout. Asserting a literal here pinned the test to one
+  of those worlds and read red in the other for a reason that was never a
+  defect. node.box must be THIS value: the platform default, nothing invented."""
+  probe = Box({'device': device, 'provider': 'kne'})
+  image = devices.get_device_attribute(probe,'image',topology.defaults)
+  if not image:
+    image = topology.defaults.devices[device].get('clab',{}).get('image','')
+  assert image, f'no image for {device} in the defaults under test'
+  return str(image)
+
+
+KUBECTL_CEILING = ['timeout','-k',str(KNE_KUBECTL_OP_KILL_GRACE),str(KNE_KUBECTL_OP_TIMEOUT)]
+
+def unwrap_kubectl(cmd: list[str]) -> list[str]:
+  """Strip the `timeout -k <grace> <ceiling>` prefix run_kubectl_with_retries
+  puts on every kubectl argv, and PROVE it was there. Tests assert the kubectl
+  argv underneath; the ceiling is a contract of its own (exit 124 is not
+  retried) and this is where its presence is checked."""
+  assert cmd[:len(KUBECTL_CEILING)] == KUBECTL_CEILING, cmd
+  return list(cmd[len(KUBECTL_CEILING):])
+
