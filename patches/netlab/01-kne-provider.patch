diff --git a/netsim/templates/provider/kne/eos/initial.j2 b/netsim/templates/provider/kne/eos/initial.j2
new file mode 100644
index 0000000..5dc02f6
--- /dev/null
+++ b/netsim/templates/provider/kne/eos/initial.j2
@@ -0,0 +1,169 @@
+hostname {{ inventory_hostname.replace("_","-") }}
+username {{ ansible_user|default('admin') }} privilege 15 secret {{ ansible_password|default(ansible_ssh_pass|default('admin')) }}
+!
+logging monitor debugging
+aaa authorization exec default local
+!
+lldp run
+{# cEOS-lab exposes L3 routing ONLY with >=1 Ethernet data port. KNE derives
+   CLAB_INTFS from the node's data links, so a link-less node boots CLAB_INTFS=0
+   with Ma0 only and `ip routing` is rejected:
+     % Unavailable command (not supported on this hardware platform)
+   which fails `netlab initial` outright. Proven by A/B on the same image and
+   the same EOS_PLATFORM=ceoslab, differing only in interface count; the
+   negative branch (`no ip routing`) IS accepted on that platform.
+   Guard on `interfaces` (data-plane only, empty for a link-less node), NOT on
+   `netlab_interfaces` -- outputs/common.py builds the latter as
+   [loopback] + interfaces, so it is non-empty here and the guard would pass
+   VACUOUSLY on exactly the shape that fails. #}
+{% if af.ipv4|default(False) and role != 'host' and interfaces|default([])|length > 0 %}
+ip routing
+{% else %}
+no ip routing
+{% endif %}
+{% if af.ipv6|default(False) and role != 'host' and interfaces|default([])|length > 0 %}
+ipv6 unicast-routing
+{% else %}
+no ipv6 unicast-routing
+{% endif %}
+!
+{% if vrfs is defined %}
+{% include 'eos.vrf.j2' %}
+{% endif %}
+!
+{% for hname,hdata in hosts.items() if 'ipv4' in hdata and hname != inventory_hostname %}
+ip host {{ hname|replace('_','') }} {{ hdata.ipv4|join (' ') }}
+{% endfor %}
+{% for hname,hdata in hosts.items() if 'ipv6' in hdata and hname != inventory_hostname %}
+ipv6 host {{ hname|replace('_','') }} {{ hdata.ipv6[0] }}
+{% endfor %}
+{% if mtu is defined %}
+!
+interface defaults
+ mtu {{ mtu }}
+{% endif %}
+!
+{# NO DEFAULT. netlab already knows this name, and it is PROVIDER-SCOPED:
+   netsim/devices/eos.yml says `mgmt_if: Management1` at device level and
+   `mgmt_if: Management0` inside the clab provider block. Every cEOS we run is
+   the clab case, so a device-level default is wrong for all of them.
+
+   This line used to read `mgmt.ifname|default('Management1')`. When the render
+   context did not carry mgmt.ifname it silently produced Management1, cEOS
+   rejected `interface Management1`, and the two lldp lines below then executed
+   at GLOBAL config level -- `% Invalid input at line 156` -- which aborted
+   `configure replace` at line 1 on 16 of 40 devices in fleet40 on 2026-08-10.
+
+   A default that invents a plausible-but-wrong interface name is the same
+   defect class as the eth1-on-ARISTA one: the guess is indistinguishable from
+   a real answer until a device refuses it. Fail at RENDER instead, where the
+   message can name the cause and nothing has been touched yet.
+
+   NO FILTER HERE, DELIBERATELY, AND THIS IS THE SECOND FIX.
+   The first attempt used `| mandatory(...)`. That is an ANSIBLE filter. This
+   template is rendered by TWO different Jinja environments:
+     netlab initial -> Ansible's templar         (mandatory EXISTS)
+     netlab create  -> netsim/utils/templates.py (mandatory DOES NOT)
+   So `netlab initial` configured 125/125 nodes and looked like proof, while
+   the very next `netlab create` died with "No filter named 'mandatory'" on
+   every eos node. A filter that exists in only one of two render paths splits
+   behaviour silently, and the passing path is the loud one.
+   None is needed: netlab builds its env with undefined=filters.j2_Undefined,
+   a StrictUndefined subclass, and Ansible's templar is strict too -- so a bare
+   {{ mgmt.ifname }} ALREADY raises at render in both when it is unset. Do not
+   reintroduce a filter here, and note that netlab's `fail()` global is the
+   mirror-image trap: netlab-only, absent from Ansible. #}
+interface {{ mgmt.ifname }}
+ no lldp transmit
+ no lldp receive
+!
+{% for l in netlab_interfaces %}
+interface {{ l.ifname }}
+{% if l.virtual_interface is not defined or l.type in ['lag'] %}
+ no switchport
+{% endif %}
+{% if l.virtual_interface is not defined and netlab_phy_control|default(true) is false %}
+ platform tfa phy control-frame disabled
+{% endif %}
+{% if l.vrf is defined %}
+ vrf {{ l.vrf }}
+{% endif %}
+{% if l.mtu is defined %}
+ mtu {{ l.mtu }}
+{% endif %}
+{#
+    TCP MSS clamp (PMTUD-blackhole fix for MPLS-VPN over the meshnet fabric).
+    Single source of truth: providers.kne.tcp_mss_clamp (defaults.yml), delivered
+    here via the eos group_vars. EOS clamps per routed interface only (not L2/
+    switchport, loopback, VXLAN or mgmt), so this is scoped to real (non-virtual)
+    wires carrying an IP family. `egress` rewrites the MSS in transiting TCP SYNs
+    leaving the fabric port. A new NOS replicates this one block in its template.
+#}
+{% if tcp_mss_clamp is defined and l.virtual_interface is not defined %}
+{%   if 'ipv4' in l %}
+ tcp mss ceiling ipv4 {{ tcp_mss_clamp }} egress
+{%   endif %}
+{%   if 'ipv6' in l %}
+ tcp mss ceiling ipv6 {{ tcp_mss_clamp }} egress
+{%   endif %}
+{% endif %}
+{% if l.name is defined %}
+ description {{ l.name }}{{ " ["+l.role+"]" if l.role is defined else "" }}
+{% elif l.type|default("") == "stub" %}
+ description Stub interface
+{% endif %}
+{#
+    Set interface IPv4 addresses
+#}
+{% if 'ipv4' in l %}
+{%   if l.ipv4 is sameas True %}
+ ip address unnumbered {{ l._parent_intf }}
+{%   elif l.ipv4 is string and l.ipv4|ansible.utils.ipv4 %}
+ ip address {{ l.ipv4 }}
+{%   else %}
+! Invalid IPv4 address {{ l.ipv4 }}
+{%   endif %}
+{% endif %}
+{#
+    Set interface IPv6 addresses
+#}
+{% if 'ipv6' in l %}
+{%   if role == 'router' %}
+{%     if l.ra.disable|default(false) is true %}
+ ipv6 nd ra disabled all
+{%     else %}
+ ipv6 nd ra interval 5
+{%       if 'ra' in l and l.ipv6 is string %}
+{%         if l.ra.slaac|default(true) is false %}
+ ipv6 nd prefix {{ l.ipv6|ansible.utils.ipaddr(0) }} no-autoconfig
+{%         endif %}
+{%         if l.ra.onlink|default(true) is false %}
+ ipv6 nd prefix {{ l.ipv6|ansible.utils.ipaddr(0) }} no-onlink
+{%         endif %}
+{%       endif %}
+{%       if l.ra.dhcp|default(false) == 'all' %}
+ ipv6 nd managed-config-flag
+{%       endif %}
+{%       if l.ra.dhcp|default(false) == 'other' %}
+ ipv6 nd other-config-flag
+{%       endif %}
+{%     endif %}
+{%   elif role == 'host' %}
+ ipv6 nd ra rx accept default-route
+{%   endif %}
+{%   if l.ipv6 is sameas True %}
+ ipv6 enable
+{%   elif l.ipv6 is string and l.ipv6|ansible.utils.ipv6 %}
+ ipv6 address {{ l.ipv6 }}
+{%   else %}
+! Invalid IPv6 address {{ l.ipv6 }}
+{%   endif %}
+{% endif %}
+{% if l.mac_address is defined %}
+ mac-address {{ l.mac_address }}
+{% endif %}
+{% if l.virtual_interface is not defined and not l.shutdown|default(False) %}
+ no shutdown
+{% endif %}
+!
+{% endfor %}
