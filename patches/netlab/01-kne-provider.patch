+# Transcripts captured from a vr-sros 22.10 KubeVirt node on 2026-09-30 (the
+# EULA banner trimmed). A fresh boot answers in classic CLI as `A:vSIM#`; after
+# the post-start bootstrap switches it, MD-CLI answers as `A:admin@n1#` under a
+# `[/]` context line.
+SROS_MD_REJECTS_CLASSIC = """
+ to support@nokia.com.
+
+
+[/]
+A:admin@n1# environment no more
+                        ^^
+MINOR: MGMT_CORE #2201: Unknown element - 'no'
+
+[/]
+A:admin@n1# /configure system grpc no shutdown
+                                   ^^
+MINOR: MGMT_CORE #2201: Unknown element - 'no'
+
+[/]
+A:admin@n1# logout
+"""
+
+SROS_CLASSIC_PROBE = """
+ to support@nokia.com.
+
+
+A:vSIM# logout
+"""
+
+SROS_MD_GRPC_UP = """
+[/]
+A:admin@n1# environment more false
+
+[/]
+A:admin@n1# info /state system grpc oper-state
+    oper-state up
+
+[/]
+A:admin@n1# logout
+"""
+
+
+class FakeSrosDevice:
+  """Answers ssh sessions the way an SR OS node does: echoes each line after a
+  prompt of the engine it runs, rejects the other engine's syntax, and reports
+  gRPC state. The classic bootstrap's last line switches it to model-driven."""
+
+  def __init__(self, engine: str, grpc_up: bool = True, reject: tuple[str, ...] = ()) -> None:
+    self.engine = engine
+    self.grpc_up = grpc_up
+    self.reject = reject
+    self.sessions: list[str] = []
+
+  def prompt(self) -> str:
+    return '[/]\nA:admin@r1# ' if self.engine == 'model-driven' else 'A:r1# '
+
+  def run(self, cmd: list[str], **kwargs: object) -> CompletedProcess[str]:
+    payload = str(kwargs.get('input', ''))
+    self.sessions.append(payload)
+    out = [' to support@nokia.com.', '']
+    for line in payload.splitlines():
+      out.append(self.prompt() + line)
+      if self.engine == 'model-driven' and (' no ' in f' {line} ' or line.endswith(' no')):
+        out.append("MINOR: MGMT_CORE #2201: Unknown element - 'no'")
+      elif self.engine == 'classic' and (line.startswith('edit-config') or line.endswith(' true')):
+        out.append('Error: Bad command.')
+      elif any(r in line for r in self.reject):
+        out.append('MINOR: MGMT_CORE #2203: Invalid element - currently not allowed')
+      elif line == 'info /state system grpc oper-state':
+        out.append('    oper-state ' + ('up' if self.grpc_up else 'down'))
+      if line.endswith('configuration-mode model-driven'):
+        self.engine = 'model-driven'
+    return CompletedProcess(cmd, 0, stdout='\n'.join(out) + '\n', stderr='')
+
+
+def sros_bootstrap_node(tmp_path: Path, box: str = 'vrnetlab/vr-sros:22.10.R2') -> tuple[Box, Box]:
+  topo_file = write_topology(tmp_path,f"""
+provider: kne
+
+nodes:
+  r1:
+    device: sros
+    box: {box}
+""")
+  topology = load_transform(topo_file)
+  node = topology.nodes.r1
+  node.ansible_host = '100.64.0.21'
+  node.ansible_port = 22
+  return node, topology
+
+
+def test_kne_sros_cli_engine_is_read_from_the_prompt() -> None:
+  assert sros_cli_engine(SROS_MD_REJECTS_CLASSIC) == 'model-driven'
+  assert sros_cli_engine(SROS_MD_GRPC_UP.replace('\n','\r\n')) == 'model-driven'
+  assert sros_cli_engine(SROS_CLASSIC_PROBE) == 'classic'
+  assert sros_cli_engine('*A:n1# /configure system name n1\n') == 'classic'
+  assert sros_cli_engine(' to support@nokia.com.\n') == ''      # banner only: no CLI yet
+  assert sros_cli_engine('') == ''
+
