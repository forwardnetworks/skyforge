+def test_kne_resource_constraints_emit_hugepages_for_declared_device(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  # hugepages-* is a case-sensitive Kubernetes extended-resource name; the
+  # provider must carry it VERBATIM from defaults.kne.resource_constraints into
+  # the node constraints and the rendered textproto, and only for the device
+  # that declared it. Without the request the scheduler does no hugepage
+  # accounting and a NOS that faults hugepage-backed memory at boot (XRd)
+  # SIGBUSes on pool-drained nodes instead of the pod pending.
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+
+defaults.kne.resource_constraints.iosxr:
+  cpu: 1
+  memory: 2Gi
+  hugepages-2Mi: 512Mi
+
+nodes:
+  xr1:
+    device: iosxr
+  r1:
+    device: eos
+    netlab_config_mode: sh
+
+links:
+- xr1-r1
+""")
+
+  init_log()
+  create.run(['-o','provider',str(topo_file)])
+
+  provider_text = Path('topology.pb.txt').read_text()
+  node_blocks = { }
+  for block in provider_text.split('nodes: {')[1:]:
+    for line in block.splitlines():
+      line = line.strip()
+      if line.startswith('name: "'):
+        node_blocks[line.split('"')[1]] = block
+        break
+
+  xr_block = node_blocks['xr1']
+  assert 'key: "hugepages-2Mi"' in xr_block
+  assert 'value: "512Mi"' in xr_block
+  # cpu/memory siblings from the same declaration ride along
+  assert 'key: "cpu"' in xr_block
+  assert 'key: "memory"' in xr_block
+
+  # the co-tenant eos node must NOT inherit iosxr's declaration
+  assert 'hugepages' not in node_blocks['r1']
+  assert provider_text.count('key: "hugepages-2Mi"') == 1
+
+
+def _iol_fabric_topology() -> Box:
+  '''iol router -- ioll2 switch -- linux host, on an 8950 fabric, plus an
+  uncapped eos<->linux link as the untouched control.
+
+  defaults.devices carries the REAL upstream declarations (netsim/devices/iol.yml
+  min_phy_mtu 1501 / max_mtu 1500; ioll2.yml inherits them via parent: iol), so
+  this fixture stays honest if upstream moves them.'''
+  return Box({
+    'defaults': {
+      'providers': {'kne': {'link_mtu': 8950, 'device_link_mtu': {'iosxr': 4470}}},
+      'devices': {
+        'iol':    {'features': {'initial': {'min_mtu': 68, 'min_phy_mtu': 1501, 'max_mtu': 1500}}},
+        'ioll2':  {'features': {'initial': {'min_mtu': 68, 'min_phy_mtu': 1501, 'max_mtu': 1500}}},
+        'iosxr':  {'features': {'initial': {'max_mtu': 9216}}},
+        'eos':    {'features': {'initial': {'max_mtu': 9194}}},
+        'linux':  {'features': {'initial': {}}},
+      },
+    },
+    'nodes': {
+      'r1':  {'device': 'iol',   'interfaces': [{'ifname': 'Ethernet0/1', 'linkindex': 1, 'ipv4': '10.0.0.1/30'}]},
+      'sw1': {'device': 'ioll2', 'interfaces': [
+        {'ifname': 'Ethernet0/1', 'linkindex': 1, 'ipv4': '10.0.0.2/30'},
+        {'ifname': 'Ethernet0/2', 'linkindex': 2, 'ipv4': '10.0.1.1/30'}]},
+      'h1':  {'device': 'linux', 'interfaces': [
+        {'ifname': 'eth1', 'linkindex': 2, 'ipv4': '10.0.1.2/30'},
+        {'ifname': 'eth2', 'linkindex': 3, 'ipv4': '10.0.2.2/30'}]},
+      'x1':  {'device': 'eos',   'interfaces': [
+        {'ifname': 'Ethernet3', 'linkindex': 3, 'ipv4': '10.0.2.1/30'},
+        {'ifname': 'Ethernet4', 'linkindex': 4, 'ipv4': '10.0.3.1/30'}]},
+      'xr1': {'device': 'iosxr', 'interfaces': [{'ifname': 'GigabitEthernet0/0/0/0', 'linkindex': 4, 'ipv4': '10.0.3.2/30'}]},
+    },
+    'links': [
+      {'linkindex': 1, 'interfaces': [
+        {'node': 'r1', 'ifname': 'Ethernet0/1'}, {'node': 'sw1', 'ifname': 'Ethernet0/1'}]},
+      {'linkindex': 2, 'interfaces': [
+        {'node': 'sw1', 'ifname': 'Ethernet0/2'}, {'node': 'h1', 'ifname': 'eth1'}]},
+      {'linkindex': 3, 'interfaces': [
+        {'node': 'h1', 'ifname': 'eth2'}, {'node': 'x1', 'ifname': 'Ethernet3'}]},
+      {'linkindex': 4, 'interfaces': [
+        {'node': 'x1', 'ifname': 'Ethernet4'}, {'node': 'xr1', 'ifname': 'GigabitEthernet0/0/0/0'}]},
+    ],
+  }, default_box=True, box_dots=True)
+
+
+def test_apply_kne_link_mtu_honours_declared_device_max_mtu(monkeypatch: pytest.MonkeyPatch) -> None:
+  '''An IOL link must land on 1500 at BOTH ends, from the device's own declaration.
+
+  Regression for the defect found live on demo-lab 2026-09-08: `mtu 8950` was
+  rendered onto every IOL interface, IOL DISCARDED the line without an error
+  (running-config kept no mtu line, show interfaces reported 1500) and the linux
+  end of the same link stayed at 8950 -- a silent blackhole for everything over
+  1500, with no ICMP because the IOL end is an L2 switch. Without the fix every
+  interface below is 8950.'''
+  from netsim.providers import kne as kne_mod
+  monkeypatch.setattr(kne_mod.devices, 'get_provider', lambda node, defaults: 'kne')
+
+  topo = _iol_fabric_topology()
+  apply_kne_link_mtu(topo)
+
+  # iol <-> ioll2: both ends down to the declared ceiling
+  assert topo.nodes.r1.interfaces[0].mtu == 1500
+  assert topo.nodes.sw1.interfaces[0].mtu == 1500
+  # ioll2 <-> linux: the PEER is pulled down too, which is what closes the
+  # asymmetry -- the linux side is what actually blackholed traffic.
+  assert topo.nodes.sw1.interfaces[1].mtu == 1500
+  assert topo.nodes.h1.interfaces[0].mtu == 1500
+  # a link with no capped device is untouched
+  assert topo.nodes.h1.interfaces[1].mtu == 8950
+  assert topo.nodes.x1.interfaces[0].mtu == 8950
+
+
+def test_apply_kne_link_mtu_sets_use_ip_mtu_for_iol(monkeypatch: pytest.MonkeyPatch) -> None:
+  '''IOL needs `ip mtu 1500`, never a bare `mtu 1500`.
+
+  augment.nodes.cleanup_mtu sets _use_ip_mtu when intf.mtu < min_phy_mtu, and that
+  flag is what makes ios.j2 emit `ip mtu N`. It runs during augment, before this
+  provider hook writes link_mtu, so it judged a value we have since changed. IOL
+  declares min_phy_mtu 1501 and max_mtu 1500, so EVERY legal value needs the flag:
+  emit a bare `mtu 1500` and IOL discards it as silently as it discarded 8950.'''
+  from netsim.providers import kne as kne_mod
+  monkeypatch.setattr(kne_mod.devices, 'get_provider', lambda node, defaults: 'kne')
+
+  topo = _iol_fabric_topology()
+  apply_kne_link_mtu(topo)
+
+  assert topo.nodes.r1.interfaces[0]._use_ip_mtu is True
+  assert topo.nodes.sw1.interfaces[0]._use_ip_mtu is True
+  assert topo.nodes.sw1.interfaces[1]._use_ip_mtu is True
+  # devices above their min_phy_mtu (or declaring none) must NOT get the flag
+  assert '_use_ip_mtu' not in topo.nodes.h1.interfaces[0]
+  assert '_use_ip_mtu' not in topo.nodes.x1.interfaces[1]
+
+
+def test_apply_kne_link_mtu_override_still_beats_declaration(monkeypatch: pytest.MonkeyPatch) -> None:
