+def test_panos_bgp_originate_is_redistributed_not_exported(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  cfg = _render_panos(tmp_path,monkeypatch,bgp_extra='originate: [ 10.50.0.0/16 ]').bgp
+  lines = cfg.splitlines()
+  assert 'set network virtual-router default routing-table ip static-route "netlab-bgp-advertise-1" nexthop discard' in lines
+  # Floats: a discard at the default static distance would blackhole an
+  # OSPF-learned route for the same prefix.
+  assert 'set network virtual-router default routing-table ip static-route "netlab-bgp-advertise-1" admin-dist 240' in lines
+  assert _VR + 'redist-profile "nlb-advertise" filter destination [ 10.50.0.0/16 ]' in lines
+  assert _VR + 'bgp redist-rules "nlb-advertise" enable yes' in lines
+  assert 'policy export' not in cfg
+
+
+def test_panos_bgp_has_one_lane_the_template() -> None:
+  tasks = Path(__file__).resolve().parents[1] / 'netsim' / 'ansible' / 'tasks'
+  assert not (tasks / 'panos' / 'bgp.yml').exists(), \
+    'tasks/panos/bgp.yml shadows templates/bgp/panos.j2 in deploy-module.yml'
+  assert (tasks / 'deploy-config' / 'panos.yml').exists()
+
+
+@pytest.mark.parametrize('attr',[
+  'bgp.install_route: true',
+  'bgp.allow_redist_default_route: true',
+  'ospf.reject_default_route: false',
+])
+def test_default_route_knobs_need_the_device_feature(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, attr: str) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log(raise_error=True)
+  topo = write_topology(tmp_path,f"""
+provider: kne
+module: [ bgp, ospf ]
+bgp.as: 65000
+nodes:
+  r1: {{ device: iol, {attr} }}
+  r2: {{ device: iol }}
+links: [ r1-r2 ]
+""")
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(topo)])
+  # The FEATURE refuses it, not the schema: the attribute is valid netlab.
+  assert f'does not support {attr.split(":")[0]}' in '\n'.join(log._ERROR_LOG)
