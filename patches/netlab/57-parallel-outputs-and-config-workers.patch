       for cfg_item in n_data.get(f'{n_provider}.config_templates',[]):
@@ -85,7 +104,7 @@ class ConfigurationFiles(_TopologyOutput):
             (node_files / cfg_path).chmod(0o755)
 
       if n_name in unprovisioned:
-        continue
