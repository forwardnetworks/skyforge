       mod_list = ['initial']
       if devices.get_device_attribute(n_data,'features.initial.normalize',topology.defaults):
@@ -109,3 +128,11 @@ class ConfigurationFiles(_TopologyOutput):
       if not log.VERBOSE and create_list:
         strings.print_colored_text(strings.pad_err_code('CONFIG',10),'green')
         print(f"{n_name}: {','.join(create_list)}")
+
+    # SKYFORGE-SPECIFIC (patch 57): render the nodes in forked workers when the lab is big enough (exact same files,
+    # same console lines in the same order); otherwise the original loop.
+    if parallel_config.usable(topology):
