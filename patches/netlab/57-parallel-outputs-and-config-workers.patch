diff --git a/netsim/outputs/parallel_config.py b/netsim/outputs/parallel_config.py
new file mode 100644
index 0000000..bb9532a
--- /dev/null
+++ b/netsim/outputs/parallel_config.py
@@ -0,0 +1,76 @@
+#
+# SKYFORGE-SPECIFIC (patch 57): render node configuration files in forked workers.
+#
+# The node loop in outputs/config.py is independent per node except for one piece of shared state: the list of
+# "shared" config templates already written. The parent computes, for every node, exactly the shared_list the
+# sequential loop would have had on reaching that node, then hands contiguous chunks of nodes to workers. Each worker
+# writes its nodes' files; its console lines, errors and warnings are replayed in chunk order (utils/forkrun.py), so
+# the files, the CONFIG lines and the exit status are the same as the sequential loop.
+#
+# Used only when the lab has at least SKYFORGE_NETLAB_PARALLEL_CONFIG_MIN nodes (default 64), forking is safe, and
+# SKYFORGE_NETLAB_PARALLEL_OUTPUTS is not 0. Workers: SKYFORGE_NETLAB_CONFIG_WORKERS (default min(8, CPUs)).
+#
+import os
+import shutil
+import tempfile
+import typing
+
+from box import Box
+
+from ..utils import forkrun
+
+
+def _workers() -> int:
+  try:
+    want = int(os.environ.get('SKYFORGE_NETLAB_CONFIG_WORKERS', '0'))
+  except ValueError:
+    want = 0
+  cpus = len(os.sched_getaffinity(0)) if hasattr(os, 'sched_getaffinity') else (os.cpu_count() or 1)
+  return max(1, want if want > 0 else min(8, cpus))
+
+
+def usable(topology: Box) -> bool:
+  if os.environ.get('SKYFORGE_NETLAB_PARALLEL_OUTPUTS', '1') == '0' or not forkrun.fork_ok():
+    return False
+  try:
+    min_nodes = int(os.environ.get('SKYFORGE_NETLAB_PARALLEL_CONFIG_MIN', '64'))
+  except ValueError:
+    min_nodes = 64
+  return len(topology.nodes) >= min_nodes and _workers() > 1
+
+
+def run(topology: Box, one_node: typing.Callable, shared_sources: typing.Callable) -> None:
+  names = list(topology.nodes.keys())
+  shared: list = []                             # simulate the sequential loop's shared_list
+  start_state = {}
+  for n_name in names:
+    start_state[n_name] = list(shared)
+    for src in shared_sources(topology.nodes[n_name]):
+      if src not in shared:
+        shared.append(src)
+
+  w = min(_workers(), len(names))
+  size = -(-len(names) // w)
+  chunks = [ names[i:i + size] for i in range(0, len(names), size) ]
+
+  def chunk_fn(chunk: list) -> typing.Callable[[], None]:
+    def fn() -> None:
+      for n_name in chunk:
+        one_node(n_name, topology.nodes[n_name], list(start_state[n_name]))
+    return fn
+
+  with tempfile.TemporaryDirectory(prefix='netlab-config-') as tmpdir:
+    pids = [ forkrun.start(chunk_fn(c), tmpdir, f'c{i}') for i, c in enumerate(chunks) ]
+    results = [ forkrun.collect(pid, tmpdir, f'c{i}', 'config worker') for i, pid in enumerate(pids) ]
+    if all(forkrun.clean(r) for r in results):
+      for r in results:
+        forkrun.replay(r, exit_on_error=False)  # the output loop checks errors after the module, as before
+      return
+
+  # A worker logged something (an error, a warning, a hint). What netlab prints once per process can only be printed
+  # right by this process: start the node files again and render every node here, exactly as the original loop does.
+  if os.path.exists('node_files'):
+    shutil.rmtree('node_files')
+  shared_list: list = []
+  for n_name in names:
+    one_node(n_name, topology.nodes[n_name], shared_list)
diff --git a/netsim/utils/forkrun.py b/netsim/utils/forkrun.py
new file mode 100644
index 0000000..5197afe
--- /dev/null
+++ b/netsim/utils/forkrun.py
@@ -0,0 +1,128 @@
+#
+# SKYFORGE-SPECIFIC (patch 57): run pieces of 'netlab create' in forked workers while keeping the console output,
+# the error/warning logs and the exit behaviour exactly as if they had run one after the other in this process.
+#
+# A task is a zero-argument callable. Each one runs with fd 1/2 redirected to files; what it printed, the errors and
+# warnings it logged and any exception it raised are collected, then replay() feeds them back IN TASK ORDER.
+#
+import gc
+import os
+import pickle
+import sys
+import threading
+import typing
+
+from . import log
+
+
+def fork_ok() -> bool:
+  """Forking is only safe from a single-threaded process."""
+  return hasattr(os, 'fork') and threading.active_count() == 1
+
+
+def run_captured(fn: typing.Callable[[], None], tmpdir: str, tag: str) -> dict:
+  out_path, err_path = os.path.join(tmpdir, f'{tag}.out'), os.path.join(tmpdir, f'{tag}.err')
+  n_err, n_warn = len(log._ERROR_LOG), len(log._WARNING_LOG)
+  header = log._error_header_printed
+  sys.stdout.flush()
+  sys.stderr.flush()
+  saved = (os.dup(1), os.dup(2))
+  saved_streams = (sys.stdout, sys.stderr)
+  result: dict = {'exc': None}
+  with open(out_path, 'wb') as fo, open(err_path, 'wb') as fe:
+    os.dup2(fo.fileno(), 1)
+    os.dup2(fe.fileno(), 2)
+    # The python-level streams too: something (a test harness, a wrapper) may have pointed sys.stdout at a file
+    # object that does not go through fd 1, and output written there would bypass the capture and lose its order.
+    sys.stdout = open(1, 'w', encoding=getattr(saved_streams[0], 'encoding', None) or 'utf-8', closefd=False)
+    sys.stderr = open(2, 'w', encoding=getattr(saved_streams[1], 'encoding', None) or 'utf-8', closefd=False)
+    try:
+      fn()
+    except BaseException as ex:                   # SystemExit from log.fatal, ErrorAbort under RAISE_ON_ERROR, bugs
+      result['exc'] = ex
+    finally:
+      sys.stdout.flush()
+      sys.stderr.flush()
+      sys.stdout, sys.stderr = saved_streams
+      os.dup2(saved[0], 1)
+      os.dup2(saved[1], 2)
+      os.close(saved[0])
+      os.close(saved[1])
+  result['errors'] = log._ERROR_LOG[n_err:]
+  result['warnings'] = log._WARNING_LOG[n_warn:]
+  result['header'] = log._error_header_printed and not header
+  result['out'], result['err'] = out_path, err_path
+  # Taken back out: the caller re-adds them at this task's place in the order (replay)
+  del log._ERROR_LOG[n_err:]
+  del log._WARNING_LOG[n_warn:]
+  log._error_header_printed = header
+  return result
+
+
+def start(fn: typing.Callable[[], None], tmpdir: str, tag: str) -> int:
+  """Fork a worker that runs fn captured and writes its result file. Returns the pid."""
+  sys.stdout.flush()
+  sys.stderr.flush()
+  gc.freeze()                                   # the child's collector must not walk (and so copy) the parent's pages
+  pid = os.fork()
+  if pid:
+    return pid
+  gc.disable()                                  # short-lived worker: no cyclic collection of the inherited heap
+  code = 0
+  try:
+    result = run_captured(fn, tmpdir, tag)
+    exc = result['exc']
+    if exc is not None:
+      try:
+        pickle.dumps(exc)
+      except Exception:
+        result['exc'] = RuntimeError(f'{type(exc).__name__}: {exc}')
+    with open(os.path.join(tmpdir, f'{tag}.result'), 'wb') as f:
+      pickle.dump(result, f)
+  except BaseException:
+    code = 70
+  finally:
+    os._exit(code)
+
+
+def collect(pid: int, tmpdir: str, tag: str, what: str) -> dict:
+  _, status = os.waitpid(pid, 0)
+  gc.unfreeze()
+  rpath = os.path.join(tmpdir, f'{tag}.result')
+  if not os.path.exists(rpath):
+    log.fatal(f'{what}: worker died (wait status {status})', module='create')
+  with open(rpath, 'rb') as f:
+    return pickle.load(f)
+
+
+def clean(result: dict) -> bool:
+  """A task that logged nothing, wrote nothing to stderr and raised nothing.
+
+  Only a clean task's captured output can be replayed as is: netlab prints some things once per process (the
+  'Errors encountered' header, documentation hints, repeated warnings), and a worker that started from a copy of this
+  process cannot know whether an earlier task printed them. Callers re-run an unclean task in this process instead."""
+  if result.get('exc') is not None or result['errors'] or result['warnings'] or result['header']:
+    return False
+  return os.path.getsize(result['err']) == 0
+
+
+def replay(result: dict, exit_on_error: bool = True) -> None:
+  """Print what the task printed, re-add its errors/warnings, re-raise its exception, then check for errors."""
+  for path, stream in ((result['out'], sys.stdout), (result['err'], sys.stderr)):
+    with open(path, 'rb') as f:
+      data = f.read()
+    if data:
+      stream.flush()
+      if hasattr(stream, 'buffer'):
+        stream.buffer.write(data)
+      else:
+        stream.write(data.decode(getattr(stream, 'encoding', None) or 'utf-8', errors='replace'))
+      stream.flush()
+  log._ERROR_LOG.extend(result['errors'])
+  log._WARNING_LOG.extend(result['warnings'])
+  if result['header']:
+    log._error_header_printed = True
+  if result.get('exc') is not None:
+    raise result['exc']
+  if exit_on_error:
+    log.exit_on_error()
