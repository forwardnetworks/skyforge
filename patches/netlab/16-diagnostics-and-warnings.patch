diff --git a/netsim/modules/evpn.py b/netsim/modules/evpn.py
index a20a89e..4640dd3 100644
--- a/netsim/modules/evpn.py
+++ b/netsim/modules/evpn.py
@@ -584,6 +584,31 @@ def remove_vlan_ebgp_neighbors(node: Box,topology: Box) -> None:
       if 'neighbors' in bgp:
         bgp.neighbors = [ ngb for ngb in bgp.neighbors if '_must_remove' not in ngb ]
 
+"""
+Warn about OSPF running on the SVI of an EVPN-controlled VLAN
+
+PLATFORM-SPECIFIC: netlab enables every routing protocol on every interface, including the IRB SVI of a VXLAN-extended VLAN
+(see "Interactions with Routing Protocols" in the EVPN module documentation). The VTEPs then form OSPF adjacencies across
+their own VXLAN tunnel and learn each other's VTEP loopback through it: recursive routing. The tunnel black-holes, the
+adjacency dies, the route falls back to the underlay, the adjacency re-forms: hosts lose traffic every 30-40 seconds.
+This runs in node_cleanup, after the OSPF module decided which interfaces carry OSPF and which are passive.
+"""
+def check_svi_ospf(node: Box, topology: Box) -> None:
+  evpn_vlans = node.get('evpn.vlans',[])
+  if not evpn_vlans:
+    return
+  bad = [ intf for intf in node.get('interfaces',[])
+            if intf.get('type') == 'svi' and intf.get('vlan.name') in evpn_vlans
+              and isinstance(intf.get('ospf'),Box) and not intf.ospf.get('passive',False) ]
+  if not bad:
+    return
+  names = ', '.join(sorted({ intf.vlan.name for intf in bad }))
+  log.warning(
+    text=f'Node {node.name} runs OSPF on the IRB SVI of EVPN-controlled VLAN(s) {names}; OSPF adjacencies will form across the VXLAN tunnel',
+    module='evpn',
+    flag='svi_ospf',
+    hint='svi_ospf')
+
 """
 Check whether the node supports the evpn.transport setting used in lab topology
 """
@@ -676,3 +701,4 @@ class EVPN(_Module):
 
   def node_cleanup(self, node: Box, topology: Box) -> None:
     remove_vlan_ebgp_neighbors(node,topology)
+    check_svi_ospf(node,topology)
