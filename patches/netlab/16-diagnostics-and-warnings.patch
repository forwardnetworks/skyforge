diff --git a/netsim/augment/plugin.py b/netsim/augment/plugin.py
index 09c10dc..a6dff4f 100644
--- a/netsim/augment/plugin.py
+++ b/netsim/augment/plugin.py
@@ -18,6 +18,48 @@ from ..utils import sort as _sort
 from . import config
 
 
+def plugin_for_global_key(key: str) -> typing.Optional[str]:
+  """
+  PLATFORM-SPECIFIC (error-path hint helper): the bundled plugin whose defaults declare 'key' as a
+  global (top-level) topology attribute, or None. Reads the plugin defaults files directly because
+  this is called when plugin defaults were NOT merged, which is exactly the case being diagnosed.
+  """
+  import yaml                                           # error path only, keep the import local
+  base = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),'extra')
+  try:
+    names = sorted(os.listdir(base))
+  except OSError:
+    return None
+  for name in names:
+    dfile = os.path.join(base,name,'defaults.yml')
+    if not os.path.isfile(dfile):
+      continue
+    try:
+      with open(dfile,'r') as fh:
+        gattr = (yaml.safe_load(fh) or {}).get('attributes',{}).get('global',{})
+    except (OSError,yaml.YAMLError,AttributeError):
+      continue
+    if isinstance(gattr,dict) and key in gattr:
+      return name
+  return None
+
+def unloaded_plugin_hints(topology: Box) -> typing.List[str]:
+  """
+  PLATFORM-SPECIFIC: hints for every top-level key that belongs to a bundled plugin the topology did
+  not enable (plugin: [ ... ]). The key is accepted by nobody else, and netlab's own complaint about
+  it (or about the groups/nodes the plugin would have created) never names the missing plugin.
+  """
+  loaded = topology.get('plugin',[])
+  loaded = [ loaded ] if isinstance(loaded,str) else (loaded if isinstance(loaded,list) else [])
+  hints: typing.List[str] = []
+  for key in list(topology.keys()):
+    if key in ('defaults','plugin','module','groups','nodes','links','vlans','vrfs','addressing'):
+      continue
+    pname = plugin_for_global_key(key)
+    if pname and pname not in loaded:
+      hints.append(f"The topology has a '{key}' block, which belongs to the '{pname}' plugin, but the plugin is not enabled: add 'plugin: [ {pname} ]'")
+  return hints
+
 def merge_plugin_defaults(defaults: typing.Optional[Box], topology: Box) -> None:
   '''
   merge_plugin_defaults: Merge plugin defaults with topology defaults
