diff --git a/netsim/extra/fabric/__init__.py b/netsim/extra/fabric/__init__.py
index b33cb97..63f955b 100644
--- a/netsim/extra/fabric/__init__.py
+++ b/netsim/extra/fabric/__init__.py
@@ -1,3 +1,4 @@
+import re
 import typing
 
 from box import Box
@@ -182,6 +183,46 @@ def debug_fabric(topology: Box, groups: Box, nodes: Box, links: list) -> None:
   print('=' * 80)
   print(strings.get_yaml_string(links))
 
+'''
+PLATFORM-SPECIFIC: warn about a hand-declared node whose name is a near miss of a generated fabric node
+
+The plugin names its nodes from fabric.leaf.name / fabric.spine.name and puts them in its role groups (leafs, spines). A topology
+that declares a node by the role word and the node's number (<group>N or <singular>N, any case, optional - or _) creates a NEW
+node outside those groups, so the group modules, VLANs and parameters never reach it, and it sits beside the generated node with
+that number. Nothing else reports it. The role words and the numbers come from the groups and nodes the plugin just generated.
+'''
+def check_near_miss_names(topology: Box, groups: Box, fabric_nodes: Box) -> None:
+  nodes = topology.get('nodes',None)
+  if isinstance(nodes,dict):
+    declared = list(nodes.keys())
+  elif isinstance(nodes,list):
+    declared = [ n if isinstance(n,str) else n.get('name') for n in nodes if isinstance(n,(str,dict)) ]
+  else:
+    return
+
+  by_role: dict = {}                                        # role word -> { counter: generated node name }
+  for g_name,g_data in groups.items():
+    words = { g_name.lower(), g_name.lower().rstrip('s') }
+    counters = { fabric_nodes[m]._fabric_count: m for m in g_data.get('members',[]) if m in fabric_nodes }
+    for w in words:
+      if w:
+        by_role[w] = counters
+
+  for name in declared:
+    if not isinstance(name,str) or name in fabric_nodes:
+      continue
+    m = re.match(r'^([A-Za-z]+)[-_]?(\d+)$',name)
+    if not m:
+      continue
+    candidate = by_role.get(m.group(1).lower(),{}).get(int(m.group(2)))
+    if not candidate:
+      continue
+    log.warning(
+      text=f'Node {name} looks like the fabric node {candidate}, but it is a separate node outside the fabric groups (the fabric plugin generates {candidate} itself)',
+      module=_config_name,
+      flag='node_name',
+      more_hints=[ f'Use the generated name {candidate} (nodes: {{ {candidate}: ... }} adds parameters to it), or set fabric.leaf.name / fabric.spine.name to the name template you want' ])
+
 '''
 The fabric is generated during plugin initialization phase
 '''
@@ -199,9 +240,19 @@ def topology_expand(topology: Box) -> None:
         log.IncorrectType,'fabric')
       return
 
+  # PLATFORM-SPECIFIC: 'groups: { leafs: }' is a null value and netlab core treats it as an empty group
+  # (groups.py creates the empty dict); the plugin runs BEFORE that, so give it the same reading instead
+  # of crashing in the member merge below ("'NoneType' object has no attribute 'members'").
+  if isinstance(topology.get('groups'),dict):
+    for g_name in list(topology.groups.keys()):
+      if topology.groups[g_name] is None:
+        topology.groups[g_name] = {}
+
   # Create the fabric groups, nodes and links
   (grp,nodes,links) = generate_fabric(topology,l_cnt,s_cnt)
 
+  check_near_miss_names(topology,grp,nodes)
+
   if topology.get('fabric.debug',None):                     # Dump the fabric data for debugging purposes
     debug_fabric(topology,grp,nodes,links)
 
diff --git a/netsim/extra/firewall/zonebased/__init__.py b/netsim/extra/firewall/zonebased/__init__.py
index 3f61b43..59bbe4f 100644
--- a/netsim/extra/firewall/zonebased/__init__.py
+++ b/netsim/extra/firewall/zonebased/__init__.py
@@ -34,6 +34,27 @@ def check_fortios_policy_ids(node: Box) -> None:
           category=log.IncorrectValue,
           module=_config_name)
 
+# PLATFORM-SPECIFIC: `firewall.zonebased.rules` is accepted by the attribute schema on every device that
+# declares the plugin, but only the panos template renders it (fortios, vsrx and vyos render
+# `default_rules` and nothing else). The rules were dropped without a word, and the lab came up
+# without the rule the author wrote. `firewall.policy.rules` is the typed, rendered path for specific rules.
+def check_unrendered_rules(node: Box, topology: Box) -> None:
+  rules = node.get('firewall.zonebased.rules',[])
+  if not rules:
+    return
+  features = devices.get_device_features(node,topology.defaults)
+  if 'firewall.zonebased_rules' in features:
+    return
+  renderers = sorted(d for d,ddata in topology.defaults.devices.items()
+                       if ddata.get('features.firewall.zonebased_rules',False) is True)
+  log.warning(
+    text=f"Node {node.name}({node.device}) sets firewall.zonebased.rules, which {node.device} does not render: the {len(rules)} rule(s) will be silently ignored",
+    module=_config_name,
+    flag='rules_not_rendered',
+    more_hints=[
+      f"Devices that render firewall.zonebased.rules: {', '.join(renderers) or 'none'}",
+      "Use firewall.policy.rules for specific rules: it is a module-level attribute with its own per-device renderers (see the firewall.policy plugin documentation)" ])
+
 def check_rule(node: Box, def_rule: Box, rule_idx: int) -> None:
     global _config_name
     for z_direction in [ 'from_zone', 'to_zone' ]:
@@ -80,6 +101,8 @@ def post_transform(topology: Box) -> None:
                                          node.get('firewall.zonebased.default_policy','deny') == 'permit'):
             check_fortios_policy_ids(node)
 
+        check_unrendered_rules(node,topology)
+
         # now check that zones defined in rules are defined
         for rule_idx,def_rule in enumerate(node.get('firewall.zonebased.default_rules', [])):
             check_rule(node,def_rule,rule_idx)
