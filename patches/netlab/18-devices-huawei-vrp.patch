+    'os': 'vrp',
+  },
+  'huawei_ne40v': {
+    'vendor': 'HUAWEI',
+    'model': 'ne40v',
+    'os': 'vrp',
+  },
   'iosxr': {
     'vendor': 'CISCO',
     'model': 'xrd',
@@ -281,6 +293,12 @@ KNE_SERVICE_MAP: dict = {
     { 'outside': 22, 'inside': 22, 'name': 'ssh', 'names': ['ssh'] },
     { 'outside': 443, 'inside': 443, 'name': 'https', 'names': ['https','httpapi'] },
   ],
+  'huawei_ce12800': [
+    { 'outside': 22, 'inside': 22, 'name': 'ssh', 'names': ['ssh'] },
+  ],
+  'huawei_ne40v': [
+    { 'outside': 22, 'inside': 22, 'name': 'ssh', 'names': ['ssh'] },
+  ],
   'iosxr': [
     { 'outside': 22, 'inside': 22, 'name': 'ssh', 'names': ['ssh'] },
     { 'outside': 9339, 'inside': 57400, 'name': 'gnmi', 'names': ['gnmi','gnoi','gnsi'] },
@@ -756,6 +774,12 @@ KNE_RESERVED_ETH0_DEVICES = {
   # incident above). vsrx had no other real KNE deploy in this repo to have
   # caught it sooner.
   'vsrx',
+  # Huawei VRP (CE12800, NE40V): ifindex_offset is 0 (GE1/0/0, Ethernet1/0/0 are ifindex 0),
+  # so without this entry the first data link lands on pod eth0, which KNE excludes from
+  # wiring. With the bump port N is pod ethN+1: KNE patch 0085 renders the VM NICs as mgmt,
+  # placeholder, eth1, eth2, ... and ethN lands on port N-1 (measured: tcpdump + ping).
+  'huawei_ce12800',
+  'huawei_ne40v',
 }
 
 # Devices whose NOS builds its out-of-band management interface from the KNE
diff --git a/tests/test_huawei_vrp_day0.py b/tests/test_huawei_vrp_day0.py
new file mode 100644
index 0000000..2202ec9
--- /dev/null
+++ b/tests/test_huawei_vrp_day0.py
@@ -0,0 +1,123 @@
+"""Huawei VRP day-0 (PLATFORM-SPECIFIC): the rendered initial config is the CONFIGURATION part
+only (sysname, LLDP on CE, loopback, data ports, commit). Reachability and AAA belong to the KNE
+console bootstrap and must not be in it, because the netmiko lane cannot push them to a VM that
+already has SSH (see the template header for the four measured failures).
+"""
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).parent.parent
+
+# Lines the KNE console bootstrap (patch 0086, kubevirt_huawei_console.go) owns. The day-0 netmiko
+# push must NOT contain them: each one stalls or errors on a VM that already has SSH
+# (measured 2026-11-19 with netmiko 4.8.0 huawei_vrpv8 against CE12800 and NE40V VMs).
+BOOTSTRAP_OWNED = [
+  r"^undo user-security-policy enable$",
+  r"^undo dcn$",
+  r"^y$",
+  r"^ip vpn-instance ",
+  r"^interface (MEth0/0/0|GigabitEthernet0/0/0)$",
+  r"^ip route-static ",
+  r"^aaa$",
+  r"^ *local-user ",
+  r"^ *undo local-user policy",
+  r"^user-interface vty",
+  r"^stelnet server enable$",
+  r"^ssh authentication-type",
+  r"^rsa local-key-pair create$",
+]
+
+
+def render(tmp_path: Path, device: str, extra: str = "") -> str:
+  topo = f"""
+provider: kne
+defaults.device: {device}
+nodes:
+  n1:
+    loopback.ipv4: 10.255.0.1/32
+  n2:
+links: [ n1-n2 ]
+{extra}
+"""
+  (tmp_path / "topology.yml").write_text(topo)
+  env = dict(os.environ, PYTHONPATH=str(ROOT))
+  code = "import sys; from netsim.cli import main; sys.argv[0]='netlab'; main()"
+  for args in (["create", "topology.yml"], ["initial", "-o", "out"]):
+    r = subprocess.run([sys.executable, "-c", code, *args], cwd=tmp_path, env=env,
+                       capture_output=True, text=True)
+    assert r.returncode == 0, r.stdout + r.stderr
+  return (tmp_path / "out" / "n1.initial.cfg").read_text()
+
+
+@pytest.mark.parametrize("device", ["huawei_ce12800", "huawei_ne40v"])
+def test_day0_has_no_bootstrap_owned_lines(tmp_path, device):
+  cfg = render(tmp_path, device)
+  for pat in BOOTSTRAP_OWNED:
+    assert not re.search(pat, cfg, re.M), (pat, cfg)
+  assert "Admin@123" not in cfg  # the lab password is the bootstrap's, not a pushed line
+
+
+@pytest.mark.parametrize("device", ["huawei_ce12800", "huawei_ne40v"])
+def test_day0_starts_with_the_node_name(tmp_path, device):
+  """The bootstrap names the VM after the node; this line repeats the same name, so netmiko's
+  login-time base prompt (<n1>) is still the prompt after the closing commit."""
+  assert render(tmp_path, device).splitlines()[0] == "sysname n1"
+
+
+def test_ce_data_port_is_routed_before_addressing(tmp_path):
+  cfg = render(tmp_path, "huawei_ce12800")
+  m = re.search(r"^interface GE1/0/0\n undo portswitch\n ip address 10\.\d+\.\d+\.\d+ 30\n undo shutdown\n quit\n", cfg, re.M)
+  assert m, cfg
+  assert "interface LoopBack0\n ip address 10.255.0.1 32\n quit\n" in cfg
+
+
+@pytest.mark.parametrize("device,port", [("huawei_ce12800", "GE1/0/"), ("huawei_ne40v", "Ethernet1/0/")])
+def test_port_n_is_pod_link_ethN_plus_1(tmp_path, device, port):
+  """Port 0 (netlab ifindex 0) is KNE pod link eth1, port 1 is eth2: KNE 0085 renders the VM NICs
+  as mgmt, placeholder, eth1, eth2, ... so ethN lands on port N-1. pod eth0 is the management
+  plane and KNE never wires it, so a first link on eth0 would be silently dropped."""
+  render(tmp_path, device, "")
+  pb = (tmp_path / "topology.pb.txt").read_text()
+  assert re.findall(r'a_int: "(eth\d+)"', pb) == ["eth1"], pb
+  cfg = (tmp_path / "out" / "n1.initial.cfg").read_text()
+  assert f"interface {port}0\n" in cfg and f"interface {port}1\n" not in cfg
+
+
+def test_ce_lldp_is_enabled_and_ne_has_no_lldp_line(tmp_path):
+  assert "lldp enable\n" in render(tmp_path, "huawei_ce12800")
+  assert "lldp" not in render(tmp_path, "huawei_ne40v")
+
+
+def test_ne_addresses_are_replaced_so_a_rerun_is_idempotent(tmp_path):
+  """NE40V answers a repeated `ip address` with `Error: The address already exists.` (netmiko then
+  aborts the whole push), and `undo ip address` first is silent on a port with no address. CE
+  re-runs clean, so it does not get the extra line."""
+  ne = render(tmp_path, "huawei_ne40v")
+  assert "interface LoopBack0\n undo ip address\n ip address 10.255.0.1 32\n" in ne
+  assert ne.count(" undo ip address\n ip address") == 2
+  (tmp_path / "ce").mkdir()
+  ce = render(tmp_path / "ce", "huawei_ce12800")
+  assert "undo ip address" not in ce
+
+
+def test_ne_data_port_is_not_portswitched_and_uses_port_zero(tmp_path):
+  cfg = render(tmp_path, "huawei_ne40v")
+  assert "interface Ethernet1/0/0\n undo shutdown\n undo ip address\n ip address" in cfg
+  assert "portswitch" not in cfg
+
+
+@pytest.mark.parametrize("device", ["huawei_ce12800", "huawei_ne40v"])
+def test_ends_with_commit_after_the_last_interface_block(tmp_path, device):
+  lines = render(tmp_path, device).rstrip().splitlines()
+  assert lines[-1] == "commit" and lines[-2] == " quit"
+
+
+def test_unvalidated_modules_are_refused(tmp_path):
+  with pytest.raises(AssertionError) as ex:
+    render(tmp_path, "huawei_ne40v", "module: [ ospf ]")
+  assert "does not support module ospf" in str(ex.value)
