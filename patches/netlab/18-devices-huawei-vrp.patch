From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] devices: Huawei VRP (CloudEngine CE12800, NE40E) on KubeVirt

---
diff --git a/netsim/ansible/templates/initial/huawei_vrp.j2 b/netsim/ansible/templates/initial/huawei_vrp.j2
new file mode 100644
index 0000000..ae6ba97
--- /dev/null
+++ b/netsim/ansible/templates/initial/huawei_vrp.j2
@@ -0,0 +1,69 @@
+{#
+  Huawei VRP day-0 (CE12800 and NE40V). PLATFORM-SPECIFIC; our own text.
+
+  This is the CONFIGURATION part only. Reachability is not configured here: a fresh VRP VM boots
+  as <HUAWEI> with no address, user or SSH host key, so netlab could not reach it to push anything,
+  and VRP has no cloud-init. KNE patch 0086 types the console bootstrap (kubevirt_huawei_console.go:
+  sysname = node name, management port + route, the lab user (ansible_user / ansible_ssh_pass),
+  vty, stelnet, RSA host key, and on NE `undo user-security-policy enable` + `undo dcn`) BEFORE
+  netlab connects. Those lines are deliberately absent here, each for a measured reason (netmiko
+  4.8.0 huawei_vrpv8, send_config_from_file with its default per-line prompt wait on a real VM):
+    * `undo dcn` asks `Continue? [Y/N]:`; netmiko waits for a prompt that never comes (ReadTimeout).
+    * `rsa local-key-pair create` on a VM that already has the key asks `Confirm to replace them?`.
+    * `local-user <name> password ...` on an existing user asks `Please enter old password:`.
+    * re-applying the management `ip address` is `Error: The address already exists.`
+  The VM already carries the node name, so the netmiko base prompt learned at login
+  (`<ce1>`) is the one the VM keeps after the closing `commit` ([~ce1]); a sysname change inside
+  the candidate does not move the prompt (it shows the RUNNING name until `commit`), but a
+  `commit` that renames it does, and then the wait for `ce1` would be a wait for the old name.
+  `sysname` below is therefore the same name the bootstrap set (idempotent).
+
+  Everything is staged in the candidate and made live by the single `commit` at the end (VRP has
+  a two-phase commit; prompts [~host] clean, [*host] pending).
+
+  CE12800 vs NE40V (both measured):
+    CE  data ports GE1/0/N are SWITCHPORTS and shut by default -> `undo portswitch` before
+        `ip address`, `undo shutdown`; LLDP is off by default.
+    NE  data ports Ethernet1/0/N are routed and up.
+#}
+{% set ce = netlab_device_type == 'huawei_ce12800' %}
+sysname {{ inventory_hostname }}
+{% if ce %}
+{#  UNVERIFIED on a CE VM: `lldp enable` is not in any capture (the CE image has LLDP off by
+    default; NE has it on). Standard VRP syntax. #}
+lldp enable
+{% endif %}
+{% if loopback is defined and loopback.ipv4 is defined and loopback.ipv4 is string and loopback.ipv4|ansible.utils.ipv4 %}
+{#  UNVERIFIED on a VM: LoopBack<N> exists on the NE40V (an `ip address unnumbered interface
+    LoopBack<N>` line is in its default config) but no loopback was created in a capture. #}
+interface {{ loopback.ifname }}
+{% if not ce %}
+ undo ip address
+{% endif %}
+ ip address {{ loopback.ipv4|ansible.utils.ipaddr('address') }} {{ loopback.ipv4|ansible.utils.ipaddr('prefix') }}
+ quit
+{% endif %}
+{% for l in interfaces|default([]) if l.ifname != mgmt.ifname %}
+interface {{ l.ifname }}
+{%   if not ce %}
+{{ ' shutdown' if l.shutdown|default(False) else ' undo shutdown' }}
+{%   endif %}
+{%   if ce and l.type|default('') != 'loopback' %}
+ undo portswitch
+{%   endif %}
+{%   if 'ipv4' in l and l.ipv4 is string and l.ipv4|ansible.utils.ipv4 %}
+{%     if not ce %}
+ undo ip address
+{%     endif %}
+ ip address {{ l.ipv4|ansible.utils.ipaddr('address') }} {{ l.ipv4|ansible.utils.ipaddr('prefix') }}
+{%   elif 'ipv4' in l %}
+{#   unnumbered / DHCP are not declared in features.initial.ipv4, so netlab refuses them earlier #}
+{%   endif %}
+{#   Order as proven: NE40V `undo shutdown` then address; CE `undo portswitch`, address, then
+     `undo shutdown`. #}
+{%   if ce %}
+{{ ' shutdown' if l.shutdown|default(False) else ' undo shutdown' }}
+{%   endif %}
+ quit
+{% endfor %}
+commit
diff --git a/netsim/ansible/templates/services/huawei_vrp.j2 b/netsim/ansible/templates/services/huawei_vrp.j2
new file mode 100644
index 0000000..7431ebd
--- /dev/null
+++ b/netsim/ansible/templates/services/huawei_vrp.j2
@@ -0,0 +1,3 @@
+{# Huawei VRP: no services sub-feature (dns, syslog, snmp, flow) is declared in the device
+   features, so there is nothing to render. The file exists because the platform hands every
+   node the services module and netlab requires a template for each module it runs. #}
diff --git a/netsim/devices/huawei_ce12800.yml b/netsim/devices/huawei_ce12800.yml
new file mode 100644
index 0000000..43ed925
--- /dev/null
+++ b/netsim/devices/huawei_ce12800.yml
@@ -0,0 +1,27 @@
+---
+description: Huawei CloudEngine CE12800 (VRP 8)
+parent: huawei_vrp
+support:
+  level: minimal
+  caveats:
+  - Day-0 (management, AAA, SSH, IPv4 interface addressing) only; routing protocols, VLAN and VRF are not declared until captured on the device
+  - Data ports GE1/0/0..9 are switchports (and shut) by default; the template runs `undo portswitch` before addressing
+interface_name: GE1/0/{ifindex}
+mgmt_if: MEth0/0/0
+clab:
+  image: registry.example.com/skyforge/kubevirt/huawei-ce12800:v200r005c10
+  build: https://containerlab.dev/manual/kinds/vr-vrp/
+  interface:
+    name: eth{ifindex+1}
+group_vars:
+  netlab_device_type: huawei_ce12800
+  ansible_user: admin
+  # Must equal the user/password the KNE console bootstrap (patch 0086, kubevirt_huawei_console.go)
+  # creates before netlab connects. Lab credential for an ephemeral VM. VRP's local-user password policy wants upper + lower +
+  # digit + special, which this satisfies.
+  ansible_ssh_pass: "Admin@123"
+  ansible_password: "Admin@123"
+kne:
+  # Documentation only: the KNE provider names pod links eth{ifindex} and bumps by one for devices in
+  # KNE_RESERVED_ETH0_DEVICES (these two are), i.e. port N = pod eth{N+1} (KNE 0085: ethN = port N-1).
+  interface.name: eth{ifindex+1}
diff --git a/netsim/devices/huawei_ne40v.yml b/netsim/devices/huawei_ne40v.yml
new file mode 100644
index 0000000..9e03328
--- /dev/null
+++ b/netsim/devices/huawei_ne40v.yml
@@ -0,0 +1,29 @@
+---
+description: Huawei NE40E virtual router (NE40V, VRP 8)
+parent: huawei_vrp
+support:
+  level: minimal
+  caveats:
+  - Day-0 (management, AAA, SSH, IPv4 interface addressing) only; routing protocols and VRF are not declared until captured on the device
+  - Data ports Ethernet1/0/0..9 are routed ports with automatic .4094 DCN sub-interfaces; management is GigabitEthernet0/0/0 in the __MGMT_VPN__ VPN instance
+interface_name: Ethernet1/0/{ifindex}
+mgmt_if: GigabitEthernet0/0/0
+clab:
+  image: registry.example.com/skyforge/kubevirt/huawei-ne40v:v800r011c00
+  build: https://containerlab.dev/manual/kinds/vr-vrp/
+  interface:
+    name: eth{ifindex+1}
+group_vars:
+  netlab_device_type: huawei_ne40v
+  # `admin` is a reserved name on NE40E.
+  ansible_user: labadmin
+  # Must equal the user/password the KNE console bootstrap (patch 0086, kubevirt_huawei_console.go)
+  # creates before netlab connects. Lab credential for an ephemeral VM. VRP's local-user password policy wants upper + lower +
+  # digit + special, which this satisfies.
+  ansible_ssh_pass: "Admin@123"
+  ansible_password: "Admin@123"
+  netlab_mgmt_vrf: __MGMT_VPN__
+kne:
+  # Documentation only: the KNE provider names pod links eth{ifindex} and bumps by one for devices in
+  # KNE_RESERVED_ETH0_DEVICES (these two are), i.e. port N = pod eth{N+1} (KNE 0085: ethN = port N-1).
+  interface.name: eth{ifindex+1}
diff --git a/netsim/devices/huawei_vrp.yml b/netsim/devices/huawei_vrp.yml
new file mode 100644
index 0000000..ef49809
--- /dev/null
+++ b/netsim/devices/huawei_vrp.yml
@@ -0,0 +1,55 @@
+---
+# Huawei VRP (abstract parent). PLATFORM-SPECIFIC: lives only in the platform patch series.
+#
+# Naming: upstream netlab has no Huawei device (no netsim/devices entry, no docs page), so
+# there is no netlab name to follow. containerlab's (vrnetlab) kind is `huawei_vrp`; that is
+# the name of this shared definition, and the two concrete platforms carry the model name
+# (huawei_ce12800 / huawei_ne40v) the way csr/cat8000v hang off ios.
+#
+# What the two platforms share, proven on the console of both images (VRP 8.180): prompts
+# ([~host] clean, [*host] uncommitted candidate), the two-phase commit model (every template
+# ends with `commit`), the error format, the AAA/vty/stelnet day-0 sequence.
+description: Huawei VRP (parent device)
+docname: Huawei VRP
+_meta_device: True
+template: true
+loopback_interface_name: LoopBack{ifindex}
+ifindex_offset: 0
+role: router
+group_vars:
+  # No Ansible network OS exists for VRP in the runtime (no Huawei collection is vendored): the
+  # value only names the template set (templates/<module>/huawei_vrp.j2); config is delivered
+  # with netmiko (huawei_vrpv8) and, on the platform, by the netlab-go scrapligo lane.
+  ansible_network_os: huawei_vrp
+  ansible_connection: network_cli
+  netlab_config_mode: netmiko
+  netlab_console_connection: ssh
+  netlab_ready: [ ssh ]
+  # ansible_user / ansible_ssh_pass are set in each child device (the platform user differs: CE admin,
+  # NE labadmin) -- the platform's defaults generator reads a credential per device file.
+  # VRP boots slowly (CE ~2 min, NE ~3.5 min to the CLI prompt); same budget idea as c8000v.
+  netlab_check_retries: 120
+  netlab_check_delay: 5
+  # VRP 8.x host keys are ssh-dss, ssh-rsa, ecdsa-sha2-nistp521 only: ssh-rsa works but is not required (measured).
+  netlab_ssh_args: "-o KexAlgorithms=+diffie-hellman-group14-sha1 -o PubkeyAcceptedKeyTypes=+ssh-rsa -o HostKeyAlgorithms=+ssh-rsa"
+clab:
+  node:
+    kind: huawei_vrp
+  group_vars:
+    netlab_ready: [ ssh ]
+features:
+  initial:
+    # Only what the console captures prove: IPv4 interface addressing and loopbacks.
+    # No IPv6, unnumbered, MTU or ra claims until they are captured on a device.
+    roles: [ router ]
+    config_mode: [ netmiko ]
+  # The platform hands every node the services module; with no sub-feature declared (no DNS, syslog,
+  # SNMP, flow) it renders nothing for VRP and refuses an author who asks for those.
+  services: true
+  netmiko:
+    # netmiko's huawei_vrpv8 driver knows the two-phase commit; VRP error lines start "Error:"
+    # (and are preceded by a caret line), which is what the day-0 captures show.
+    device_type: huawei_vrpv8
+    error_regexp:
+    - '^Error:'
+    - '^\s*Error:'
diff --git a/netsim/providers/kne.py b/netsim/providers/kne.py
index c5dd557..68ae9d8 100644
--- a/netsim/providers/kne.py
+++ b/netsim/providers/kne.py
@@ -68,6 +68,18 @@ KNE_NODE_MAP: dict = {
     'model': 'panos',
     'os': 'panos',
   },
+  # Huawei VRP (KubeVirt VMs). The vendor string is a KNE topology-proto enum value: the KNE
+  # series must carry Vendor HUAWEI (patches/kne) before a lab with these nodes can be created.
+  'huawei_ce12800': {
+    'vendor': 'HUAWEI',
