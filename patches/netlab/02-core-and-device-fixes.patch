diff --git a/netsim/ansible/tasks/readiness-check/junos.yml b/netsim/ansible/tasks/readiness-check/junos.yml
index c1d0311..8458674 100644
--- a/netsim/ansible/tasks/readiness-check/junos.yml
+++ b/netsim/ansible/tasks/readiness-check/junos.yml
@@ -3,6 +3,26 @@
     junos_phy_iflist: >-
       {{ interfaces|rejectattr('virtual_interface','defined') }}
 
+# Junos devices declare netlab_ready: [ ansible ] with ansible_connection: netconf,
+# so the FIRST thing the readiness check does is open a NETCONF session. On a cold
+# VM (vsrx measured 2026-09-15: pod RUNNING at 17:28:34, check at 17:29:51) the SSH
+# daemon answers before the startup config has committed `system services netconf
+# ssh`, and junos_command fails the connect outright -- "Could not open socket to
+# <host>:830" -- 31s in, on the FIRST attempt. The wait_for/retries below never
+# applies: it retries the COMMAND RESULT, not the transport. Wait for the NETCONF
+# port itself first, from the controller, within the device's own declared budget
+# (netlab_check_retries * netlab_check_delay; junos base = 60 * 10 = 600s).
+- name: Wait for NETCONF ({{ ansible_host }}:{{ ansible_port|default(830) }}) to accept connections
+  ansible.builtin.wait_for:
+    host: "{{ ansible_host }}"
+    port: "{{ ansible_port|default(830) }}"
+    timeout: "{{ (netlab_check_retries|default(60)|int) * (netlab_check_delay|default(10)|int) }}"
+    delay: 0
+  delegate_to: localhost
+  vars:
+    ansible_connection: local
+  when: junos_phy_iflist is ansible.builtin.truthy
+
 - name: Wait for first interface ({{ junos_phy_iflist[0].junos_interface }})
   junos_command:
     commands:
