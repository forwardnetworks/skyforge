--- /dev/null
+++ b/tests/test_plugin_sort_extra_config.py
@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""sort_extra_config() must not depend on Python's per-process string-hash seed.
+
+Found 2026-10-02 by the Skyforge render oracle: rendering the same commit twice through the same
+image reordered group_vars netlab_custom_config, because the function collected the names in a
+set(). The seed is fixed at interpreter start, so each case runs in a subprocess.
+"""
+import os
+import subprocess
+import sys
+
+SCRIPT = r"""
+import sys
+from box import Box
+from netsim.augment import plugin
+topo = Box({'nodes': {
+    'a': {'config': ['zeta', 'alpha', 'mike']},
+    'b': {'config': ['mike', 'bravo', 'yankee']},
+    'c': {},
+    'd': {'config': ['charlie', 'alpha', 'xray']},
+}}, default_box=True, box_dots=True)
+print(','.join(plugin.sort_extra_config(topo)))
+"""
+
+
+def _run(seed: str) -> str:
+    env = dict(os.environ, PYTHONHASHSEED=seed)
+    out = subprocess.run([sys.executable, "-c", SCRIPT], env=env, capture_output=True, text=True, check=True)
+    return out.stdout.strip()
+
+
+def test_sort_extra_config_is_hash_seed_independent():
+    results = {seed: _run(seed) for seed in ("0", "1", "2", "3", "7", "42", "1337", "31337")}
+    assert len(set(results.values())) == 1, results
+
+
+NODE_ORDERS = (
+    ("zeta", "alpha", "mike"),
+    ("mike", "bravo", "yankee"),
+    ("charlie", "alpha", "xray"),
+)
+
+
+def _keeps_every_node_order(names: list) -> bool:
+    return all(
+        names.index(before) < names.index(after)
+        for order in NODE_ORDERS
+        for before, after in zip(order, order[1:])
+    )
+
+
+def test_sort_extra_config_keeps_every_node_order():
+    # The contract: if a node lists config A before config B, A is applied before B.
+    for seed in ("0", "5", "42"):
+        names = _run(seed).split(",")
+        assert sorted(names) == sorted({n for order in NODE_ORDERS for n in order}), names
+        assert _keeps_every_node_order(names), (seed, names)
+
+
+def test_sort_extra_config_is_first_seen_order():
+    # Dependency layers, and first-seen order inside each layer. Plain first-seen order
+    # (zeta,alpha,mike,bravo,yankee,charlie,xray) is NOT a valid answer: node d needs
+    # charlie before alpha.
+    assert not _keeps_every_node_order("zeta,alpha,mike,bravo,yankee,charlie,xray".split(","))
+    assert _run("5") == "zeta,charlie,alpha,mike,xray,bravo,yankee"
