diff --git a/netsim/ansible/templates/initial/eos.j2 b/netsim/ansible/templates/initial/eos.j2
index 420bf9e..5a45a0a 100644
--- a/netsim/ansible/templates/initial/eos.j2
+++ b/netsim/ansible/templates/initial/eos.j2
@@ -106,9 +106,32 @@ interface {{ l.ifname }}
 {% if l.mac_address is defined %}
  mac-address {{ l.mac_address }}
 {% endif %}
-{% if l.virtual_interface is not defined and not l.shutdown|default(False) %}
+{% if l.virtual_interface is not defined %}
 !
+{#
+  EMIT THE ADMIN STATE EXPLICITLY, BOTH WAYS.
+
+  This used to render ` no shutdown` when the interface was up and NOTHING when
+  shutdown was true, which is only correct on a platform whose interfaces come
+  up admin-down and only on a COLD boot. EOS interfaces default to ENABLED, so
+  omitting a line never disabled anything -- and on a warm reconfigure, dropping
+  a line from the rendered config cannot undo what the device is already
+  running, whether the apply is a `configure terminal` merge or a `configure
+  replace` onto this file.
+
+  Result: `shutdown: true` on an interface was silently a no-op on EOS, while
+  bgp neighbour shutdown worked, because that renders a real command.
+  Reported 2026-09-03.
+
+  ios.j2, nxos.j2, iosxr.j2, asa.j2, arubacx.j2 and dellos10.j2 already emit the
+  explicit form, and junos/vyos/sros/routeros7/csrx emit their own disable
+  syntax; EOS and the IOL ifstate templates were the outliers.
+#}
+{%   if l.shutdown|default(False) %}
+ shutdown
+{%   else %}
  no shutdown
+{%   endif %}
 {% endif %}
 !
 {% endfor %}
diff --git a/netsim/ansible/templates/initial/ios.j2 b/netsim/ansible/templates/initial/ios.j2
index 3a040e8..b560219 100644
--- a/netsim/ansible/templates/initial/ios.j2
+++ b/netsim/ansible/templates/initial/ios.j2
@@ -2,17 +2,43 @@
 hostname {{ inventory_hostname }}
 !
 no ip domain lookup
+ip domain name netlab.local
 logging buffered 256000
+no logging console
+no logging monitor
+username admin privilege 15 secret admin
+enable secret admin
+crypto key generate rsa modulus 2048
+ip ssh version 2
+ip ssh time-out 60
+ip ssh authentication-retries 3
 {% from '_debug_commands.j2' import enable_debugging %}
 {{ enable_debugging(ios.debug,prefix='do debug') }}
 !
 lldp run
+{#
+  CDP is OFF by default, as upstream has it (#3807). netlab_cdp_enable -- a
+  group variable modelled on netlab_lldp_enable -- turns it on for labs whose
+  consumer discovers links over CDP (the collector reads CDP neighbours).
+#}
+{% if netlab_cdp_enable|default(False) %}
+cdp run
+{% else %}
 no cdp run
+{% endif %}
 !
 {% if services.dns._no_hosts is not defined %}
 {%   for hname,hdata in hosts.items() if hname != inventory_hostname %}
 {%     set ipv6_addr = hdata.ipv6|default([]) if netlab_device_type not in ['iosvl2','ioll2'] else [] %}
-{%     set addr_list = hdata.ipv4|default([]) + ipv6_addr %}
+{#     IOS/IOLL2: one address per family only. A multi-address 'ip host' line is
+       rejected on these platforms and fails the whole initial config. #}
+{%     set addr_list = [] %}
+{%     if hdata.ipv4 is defined and hdata.ipv4 %}
+{%       set addr_list = addr_list + [ hdata.ipv4[0] ] %}
+{%     endif %}
+{%     if ipv6_addr %}
+{%       set addr_list = addr_list + [ ipv6_addr[0] ] %}
+{%     endif %}
 {%     if addr_list %}
 ip host {{ hname }} {{ addr_list|join (' ') }}
 {%     endif %}
@@ -35,6 +61,17 @@ no ipv6 unicast-routing
 {% include 'ios.vrf.j2' +%}
 !
 {% endif %}
+{% if netlab_device_type in ['ios','iosvl2','csr','iol','ioll2','cat8000v'] %}
+{# The name is a device group var (netlab_mgmt_vrf) so the services templates can put the
+   syslog host and flow exporter in the same VRF; the literal stays as the fallback for
+   platforms that never declared it. #}
+vrf definition {{ netlab_mgmt_vrf|default('MGMT') }}
+ description Management interface
+ !
+ address-family ipv4
+ exit-address-family
+!
+{% endif %}
 {% if vlans is defined %}
 {% include [ netlab_device_type ~ '.vlan.j2', 'ios.vlan.j2' ] +%}
 !
@@ -50,9 +87,50 @@ interface {{ loopback.ifname }}
 {%   endif %}
 {% endif %}
 !
-interface {{ mgmt.ifname|default('GigabitEthernet0/0') }}
+{# No `|default()`: mgmt.ifname is resolved by netlab per device AND provider (eos: Management1
+   at device level, Management0 in the clab block), and a plausible-but-wrong literal is only
+   discovered when the device refuses it at line 1 of `configure replace`. The name is NOT
+   filtered with `mandatory` either: that is an ANSIBLE filter and this file is also rendered
+   by netlab's own Jinja env, which has no such filter. Both envs use a strict Undefined, so a
+   bare {{ mgmt.ifname }} already fails at render when it is unset. #}
+interface {{ mgmt.ifname }}
  no lldp transmit
  no lldp receive
+{# ORDER MATTERS ON THE L2 IMAGE. A switchport rejects `vrf forwarding`; on ioll2 (and
+   iosvl2) the port must be routed FIRST. With the VRF line ahead of `no switchport` the
+   binding was silently dropped and Ethernet0/0 stayed in the global table -- which nobody
+   noticed while only inbound SSH/SNMP used it, and which surfaced the moment the exporter
+   said `destination ... vrf MGMT` (demo-lab lhr-acc-sw01, 2026-09-12: config carried
+   the route and the VRF, `show run int e0/0` had no vrf forwarding, exporter "No FIB"). #}
+{% if netlab_device_type in ['ioll2','iosvl2'] %}
+ no switchport
+{% endif %}
+{# cat8000v IS in this list (since 2026-09-14). With Gi1 in the GLOBAL table the DHCP default
+   (AD 254) loses to any default the LAB hands the router -- an ISP's default-originate, an
+   iBGP default from the RR (AD 200), an OSPF default -- and the reply to every management SSH
+   SYN leaves through the data plane instead of back to the masquerade gateway. Measured
+   2026-09-14 on a 9-node c8000v lab: exactly the five nodes that learned a BGP default timed
+   out on :22 (guest healthy, Gi1 up with 10.0.2.2, sshd LISTENing). Same fault the collector saw as
+   CONNECTION_TIMEOUT on a hackweek lab. iol/csr were always in the VRF; the controller-mode
+   edge boothook uses Mgmt-intf; autonomous c8000v was the one IOS shape left in the global
+   table. #}
+{% if netlab_device_type in ['ios','iosvl2','csr','iol','ioll2','cat8000v'] %}
+ vrf forwarding {{ netlab_mgmt_vrf|default('MGMT') }}
+{% endif %}
+{% if netlab_device_type in ['iol','ioll2'] %}
+ ip address 169.254.100.2 255.255.255.252
+ no shutdown
+{% endif %}
+{% if netlab_device_type == 'cat8000v' %}
+{# On the native KubeVirt lane nobody else configures management. vrnetlab's
+   launch.py used to DHCP GigabitEthernet1 before the NOS ever saw traffic;
+   without this stanza the CVAC-applied day-0 leaves Gi1 unassigned and
+   administratively down, the masquerade DNAT has no backend, and every
+   c8000v is unreachable on :22 -- the collector reports CONNECTION_TIMEOUT on a
+   fully configured router. KubeVirt masquerade serves 10.0.2.2 via DHCP. #}
+ ip address dhcp
+ no shutdown
+{% endif %}
 !
 {% for l in interfaces|default([]) %}
 interface {{ l.ifname }}
@@ -136,6 +214,20 @@ interface {{ l.ifname }}
 {% if l.mac_address is defined %}
  mac-address {{ l.mac_address }}
 {% endif %}
+{# CDP PER INTERFACE, only with netlab_cdp_enable (the global `cdp run` above); this makes each
+   data interface's CDP state explicit as well. `cdp enable` is the IOS default
+   and never shows in the running config, so this changes nothing a collector
+   sees -- it exists because of a live observation (a change-review baseline lab,
+   2026-09): after a post-boot global
+   `cdp run`, `show cdp interface` stayed empty until every interface was given
+   `cdp enable` by hand. Loopbacks reject the command (IOS), SVIs/tunnels are
+   virtual, and dot1Q sub-interfaces inherit from the parent, so all of those
+   are skipped. The management interface is not in `interfaces` and is left
+   alone. NOT YET PROVEN LIVE from this template: proof is `show cdp interface`
+   and `show cdp neighbors` on a booted cat8000v and iol. #}
+{% if netlab_cdp_enable|default(False) and l.virtual_interface is not defined and l.type|default('') != 'vlan_member' %}
+ cdp enable
+{% endif %}
 {%   if l.shutdown|default(False) %}
  shutdown
 {%   else %}
@@ -148,8 +240,16 @@ interface {{ l.ifname }}
 !
 {{ extra_module_initial(['dhcp']) }}
 !
+line con 0
+ exec-timeout 0 0
+ privilege level 15
+!
 line vty 0 4
  exec-timeout 0 0 
+ length 0
+ privilege level 15
+ login local
+ transport input ssh
 !
 no banner exec
 no banner login
diff --git a/netsim/ansible/templates/initial/linux/vanilla-ifconfig.j2 b/netsim/ansible/templates/initial/linux/vanilla-ifconfig.j2
index 5dfdaa8..0c2c95e 100644
--- a/netsim/ansible/templates/initial/linux/vanilla-ifconfig.j2
+++ b/netsim/ansible/templates/initial/linux/vanilla-ifconfig.j2
@@ -17,7 +17,12 @@ set -e
 ip -6 addr add {{ intf.ipv6 }} dev {{ intf.ifname }}
 {% endif %}
 {% if intf.mtu is defined %}
-ip link set dev {{ intf.ifname }} mtu {{ intf.mtu }}
+target_mtu="{{ intf.mtu }}"
+current_mtu="$(ip -o link show dev {{ intf.ifname }} 2>/dev/null | sed -n 's/.* mtu \([0-9][0-9]*\).*/\1/p' | head -n 1)"
+if [ -n "$current_mtu" ] && [ "$current_mtu" -lt "$target_mtu" ] 2>/dev/null; then
+  target_mtu="$current_mtu"
+fi
+ip link set dev {{ intf.ifname }} mtu "$target_mtu"
 {% endif %}
 {% if intf.shutdown|default(False) %}
 ip link set dev {{ intf.ifname }} down
diff --git a/netsim/ansible/templates/initial/nxos.j2 b/netsim/ansible/templates/initial/nxos.j2
index f50b582..5a90d8e 100644
--- a/netsim/ansible/templates/initial/nxos.j2
+++ b/netsim/ansible/templates/initial/nxos.j2
@@ -3,12 +3,44 @@
 #}
 hostname {{ 'nxos-' if inventory_hostname|length == 1 else '' }}{{ inventory_hostname }}
 !
+feature bash-shell
+!
 no ip domain-lookup
 !
 feature lldp
+{# n9kv first boot (KubeVirt/CVAC) does NOT ship with an SSH host key and does
+   not auto-generate one on "feature ssh". The prior "no feature ssh" tore down
+   the default SSH state and the subsequent key-gen raced the re-enable, so
+   "feature ssh" failed with "no ssh key configured, cannot enable ssh" and the
+   management plane never opened. Enable ssh (default key present) then force a
+   fresh 2048-bit RSA key -- proven to bring SSHv2 up unattended on n9kv. #}
+feature ssh
+ssh key rsa 2048 force
+feature nxapi
+feature telnet
+feature netconf
+feature grpc
+feature scp-server
+!
+{# n9kv (KubeVirt/CVAC) enforces the secure password standard on first boot: a
+   startup-config "username ... password <pw>" with a password shorter than 8
+   chars is REJECTED, so the account is never created. With no valid admin
+   password in the bootstrap file, n9kv falls back to the interactive "System
+   Admin Account Setup" dialog on the serial console -> SSH/mgmt never come up
+   and netlab cannot connect. Disabling the strength check lets netlab's
+   (short, image-default) admin/vagrant credentials apply so the switch
+   auto-provisions unattended. role network-admin grants the privileges the
+   accounts need (a role-less user cannot drive config). #}
+no password strength-check
+{# CDP off unless netlab_cdp_enable (see initial/ios.j2) #}
+{% if netlab_cdp_enable|default(False) %}
+cdp enable
+{% else %}
 no cdp enable
+{% endif %}
 !
-username vagrant password vagrant
+username admin password admin role network-admin
+username vagrant password vagrant role network-admin
 !
 {% if services.dns._no_hosts is not defined %}
 {%   for hname,hdata in hosts.items() if 'ipv4' in hdata and hname != inventory_hostname %}
@@ -27,16 +59,21 @@ feature interface-vlan
 interface {{ mgmt.ifname|default('GigabitEthernet0/0') }}
  no lldp transmit
  no lldp receive
+ ip address dhcp
+ no shutdown
+!
+line vty
+ exec-timeout 0
 !
 {% for l in netlab_interfaces %}
 interface {{ l.ifname }}
 {% if l.shutdown|default(False) %}
  shutdown
 {% endif %}
-{% if l.virtual_interface is not defined %}
+{% if l.virtual_interface is not defined and l.lag is not defined %}
