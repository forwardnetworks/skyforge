diff --git a/tests/test_eigrp_redistribution.py b/tests/test_eigrp_redistribution.py
new file mode 100644
index 0000000..6b79b9a
--- /dev/null
+++ b/tests/test_eigrp_redistribution.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from netsim import augment
+from netsim.cli import create
+from netsim.utils import log
+from netsim.utils import read as _read
+
+
+def init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+@pytest.fixture(autouse=True)
+def _reset_log_after_test():
+  # These tests leave netlab's module-global error log and flags set on purpose; reset them so a later
+  # test module that calls log.exit_on_error() (test_initial_overlap_lanes) does not inherit the errors.
+  yield
+  log.init_log_system(header=False)
+  log.set_flag(raise_error=False)
+
+
+def write_topology(tmp_path: Path, topology: str) -> Path:
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent(topology).strip() + '\n')
+  return topo_file
+
+
+@pytest.mark.parametrize('device',['iol','nxos'])
+def test_kne_renders_native_bgp_eigrp_redistribution(
+      tmp_path: Path,
+      monkeypatch: pytest.MonkeyPatch,
+      device: str) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,f"""
+provider: kne
+
+routing:
+  prefix:
+    eigrp_to_bgp:
+    - {{ sequence: 10, action: permit, ipv4: 10.99.10.0/24 }}
+    - {{ sequence: 20, action: permit, ipv4: 10.99.20.0/24 }}
+    atm_cidrs:
+    - {{ sequence: 10, action: permit, ipv4: 10.99.10.0/24 }}
+    - {{ sequence: 20, action: permit, ipv4: 10.99.20.0/24 }}
+  policy:
+    eigrp_to_bgp:
+    - {{ sequence: 10, action: permit, match: {{ prefix: eigrp_to_bgp }} }}
+    atm_from_sdwan:
+    - {{ sequence: 10, action: permit, match: {{ prefix: atm_cidrs }} }}
+    - {{ sequence: 20, action: deny }}
+
+nodes:
+  core:
+    device: {device}
+    module: [ bgp, eigrp, routing ]
+    bgp:
+      as: 65010
+      import:
+        eigrp: {{ policy: eigrp_to_bgp }}
+    eigrp:
+      as: 100
+      import:
+        bgp:
+          policy: atm_from_sdwan
+          metric:
+            bandwidth: 100000
+            delay: 100
+            reliability: 255
+            load: 1
+            mtu: 1500
+  branch:
+    device: {device}
+    module: [ eigrp ]
+    eigrp.as: 100
+  edge:
+    device: {device}
+    module: [ bgp ]
+    bgp.as: 65100
+
+links:
+- core-branch
+- core-edge
+""")
+
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+  startup = Path('node_files/core/startup-config').read_text()
+
+  assert 'ip prefix-list eigrp_to_bgp-ipv4 seq 100 permit 10.99.10.0/24' in startup
+  assert 'route-map eigrp_to_bgp-ipv4 permit 10' in startup
+  assert 'match ip address prefix-list eigrp_to_bgp-ipv4' in startup
+  assert 'redistribute eigrp 100 route-map eigrp_to_bgp-ipv4' in startup
+
+  if device == 'iol':
+    assert 'redistribute bgp 65010 metric 100000 100 255 1 1500 route-map atm_from_sdwan-ipv4' in startup
+  else:
+    assert 'route-map atm_from_sdwan-eigrp-ipv4 permit 10' in startup
+    assert 'set metric 100000 100 255 1 1500' in startup
+    assert 'redistribute bgp 65010 route-map atm_from_sdwan-eigrp-ipv4' in startup
+
+  provider_text = Path('topology.pb.txt').read_text()
+  assert f'model: "{device}"' in provider_text
+  assert 'file: "node_files/core/startup-config"' in provider_text
+
+
+def test_eigrp_import_requires_composite_metric(tmp_path: Path) -> None:
+  topo_file = write_topology(tmp_path,"""
+module: [ bgp, eigrp ]
+defaults.device: iol
+provider: kne
+bgp.as: 65000
+eigrp.as: 100
+nodes:
+  r1:
+    eigrp.import: [ bgp ]
+  r2:
+links: [ r1-r2 ]
+""")
+
+  init_log(raise_error=True)
+  topology = _read.load(str(topo_file),relative_topo_name=True,user_defaults=[])
+  try:
+    augment.main.transform(topology)
+  except log.ErrorAbort:
+    assert 'requires an EIGRP composite metric' in '\n'.join(log.get_error_log())
+  else:
+    raise AssertionError('EIGRP import without a composite metric was accepted')
