+{{         routemap.common_route_map_entry(p_entry,match_af) }}
+{%         if p_entry.action|default('permit') != 'deny' %}
+  set metric {{ metric(data) }}
+{%         endif %}
+{%-      endcall %}
+{%     else %}
+route-map {{ pname }} permit 10
+  set metric {{ metric(data) }}
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+!
 feature eigrp
 !
 router eigrp {{ eigrp.as }}
 {% if eigrp.router_id is defined %}
  router-id {{ eigrp.router_id }}
 {% endif %}
+{% if 'ipv4' in eigrp.af %}
+{%   for source,data in eigrp.import|default({})|dictsort %}
+ redistribute {{ source }}{% if source == 'bgp' %} {{ bgp.as }}{% endif %} route-map {{ policy_name(source,data,'ipv4') }}
+{%   endfor %}
+{% endif %}
 {% if 'ipv6' in eigrp.af %}
  address-family ipv6 unicast
+{%   for source,data in eigrp.import|default({})|dictsort %}
+  redistribute {{ source }}{% if source == 'bgp' %} {{ bgp.as }}{% endif %} route-map {{ policy_name(source,data,'ipv6') }}
+{%   endfor %}
 {% endif %}
 !
