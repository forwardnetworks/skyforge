+{% import "templates/routing/_route_map_ios.j2" as routemap with context %}
+{% macro metric(data) -%}
+{{ data.metric.bandwidth }} {{ data.metric.delay }} {{ data.metric.reliability }} {{ data.metric.load }} {{ data.metric.mtu }}
