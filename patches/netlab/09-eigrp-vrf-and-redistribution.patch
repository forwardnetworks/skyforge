diff --git a/docs/module/eigrp.md b/docs/module/eigrp.md
index d20cfaa..8008434 100644
--- a/docs/module/eigrp.md
+++ b/docs/module/eigrp.md
@@ -10,6 +10,7 @@ Supported features:
 * EIGRP AS number
 * Unnumbered point-to-point interfaces (Cisco IOS-XE only)
 * Passive interfaces
+* Route import (redistribution) from BGP
 
 ## Global Parameters
 
@@ -18,6 +19,32 @@ Supported features:
 ## Node Parameters
 
 * **eigrp.as** -- per-node EIGRP AS number (default: 1 -- inherited from global defaults)
+* **eigrp.import** -- routes to import into EIGRP. The source protocol is the
+  dictionary key; an optional **policy** selects a routing policy. Every import
+  must include an EIGRP composite **metric** with **bandwidth**, **delay**,
+  **reliability**, **load**, and **mtu** values.
+
+The following example redistributes BGP routes into EIGRP through a routing
+policy and redistributes EIGRP routes into BGP through another policy:
+
+```
+module: [ bgp, eigrp, routing ]
+bgp:
+  as: 65000
+  import:
+    eigrp: { policy: eigrp_to_bgp }
+eigrp:
+  as: 100
+  import:
+    bgp:
+      policy: bgp_to_eigrp
+      metric:
+        bandwidth: 100000
+        delay: 100
+        reliability: 255
+        load: 1
+        mtu: 1500
+```
 
 ```{tip}
 The EIGRP configuration module is automatically removed from a node that does not run EIGRP on any non-loopback interface. In that case, _netlab_ generates a warning that can be turned off by setting **‌defaults.eigrp.warnings.inactive** to **‌False**.
@@ -215,4 +242,4 @@ links:
 - r1
 - r2
 - s1
-```
\ No newline at end of file
+```
diff --git a/netsim/ansible/templates/eigrp/ios.j2 b/netsim/ansible/templates/eigrp/ios.j2
index 089ba01..48dcec4 100644
--- a/netsim/ansible/templates/eigrp/ios.j2
+++ b/netsim/ansible/templates/eigrp/ios.j2
@@ -3,8 +3,21 @@
 Configure IPv4 EIGRP
 
 #}
-{% if eigrp.af.ipv4 is defined %}
-router eigrp {{ eigrp.as }}
+{% import "templates/routing/_redistribute.ios.j2" as redistribute with context %}
+{% set vrf_eigrp = (vrfs|default({})).items()|selectattr('1.eigrp','defined')|list %}
+{% set has_global = eigrp is defined and eigrp.af.ipv4 is defined %}
+{% if has_global or vrf_eigrp %}
+{#
+  A single `router eigrp <AS>` container holds both the global (no-VRF)
+  address-family and one `address-family ipv4 vrf <name> autonomous-system
+  <as>` block per VRF -- this is real Cisco IOS classic-mode EIGRP-in-VRF
+  syntax (verified against the seed's own capture: a csw NO-ENG box's
+  `router eigrp 100` / `address-family ipv4 vrf NO-ENG autonomous-system 100`
+  / network / passive-interface / `exit-address-family`), NOT a separate
+  `router eigrp <as> vrf <name>` per VRF the way `router ospf` works.
+#}
+router eigrp {{ eigrp.as if has_global else vrf_eigrp[0][1].eigrp.as }}
+{% if has_global %}
 {% if eigrp.router_id is defined %}
  eigrp router-id {{ eigrp.router_id }}
 {% endif %}
@@ -17,14 +30,37 @@ router eigrp {{ eigrp.as }}
 {% if mgmt.ifname|default("") %}
  passive-interface {{ mgmt.ifname }}
 {% endif %}
+{% if eigrp.import is defined %}
+{{ redistribute.config(eigrp,af='ipv4',t_proto='eigrp') }}
+{% endif %}
+{% endif %}
+{% for vname,vdata in vrf_eigrp %}
+ !
+ address-family ipv4 vrf {{ vname }} autonomous-system {{ vdata.eigrp.as }}
+{% if vdata.eigrp.router_id is defined %}
+  eigrp router-id {{ vdata.eigrp.router_id }}
+{% endif %}
+{% for l in vdata.eigrp.interfaces|default([]) if 'ipv4' in l and l.ipv4 is string %}
+  network {{ l.ipv4|ansible.utils.ipaddr('address') }} 0.0.0.0
+{% endfor %}
+{% for l in vdata.eigrp.interfaces|default([]) if l.eigrp.passive|default(False) %}
+  passive-interface {{ l.ifname }}
+{% endfor %}
+{% if vdata.eigrp.import is defined %}
+{{ redistribute.config(vdata.eigrp,af='ipv4',t_proto='eigrp',vrf=vname) }}
+{% endif %}
+ exit-address-family
+{% endfor %}
 !
 {% endif %}
 {#
 
-Configure IPv6 EIGRP - totally separate configuration
+Configure IPv6 EIGRP - totally separate configuration. VRF-scoped IPv6 EIGRP
+is not modeled: no seed evidence for it in this blueprint, and inventing the
+syntax without a real capture to verify against would be a guess, not a fix.
 
 #}
-{% if eigrp.af.ipv6 is defined %}
+{% if eigrp is defined and eigrp.af.ipv6 is defined %}
 ipv6 router eigrp {{ eigrp.as }}
 {% if eigrp.router_id is defined %}
  eigrp router-id {{ eigrp.router_id }}
@@ -33,6 +69,9 @@ ipv6 router eigrp {{ eigrp.as }}
 {% for l in netlab_interfaces|default([]) if 'eigrp' in l and l.eigrp.passive %}
