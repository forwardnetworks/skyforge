+# This value is the declarative meshnet fabric contract. It MUST equal
+# skyforge.kne.meshnet.fabricMTU in the chart: koko applies it to both
+# same-node veth wires and cross-node VXLAN interfaces, while netlab applies
+# it to the NOS-facing routed interfaces.
+#
+# link_mtu is the UNDERLAY/transport ceiling: it is the largest frame a
+# routed fabric link (leaf<->spine) can carry. Routed/underlay interfaces are
+# clamped to this value. The safe fleet default remains 1450: a 1500-byte
+# IPv4 underlay minus Ethernet(14)+IPv4(20)+UDP(8)+VXLAN(8) overhead.
+#
+# overlay_mtu_headroom reserves room for the NOS's OWN overlay encapsulation
+# (EVPN VXLAN, MPLS/SR labels, GRE, IPsec, ...) on top of the fabric. Any
+# interface that carries pre-encap overlay payload (bridged/IRB access ports
+# and host/CE links) is clamped to (link_mtu - overlay_mtu_headroom), floored
+# at the IPv6 minimum (1280). 90B of headroom covers VXLAN(50)/MPLS/GRE/IPsec
+# and moderate SRv6; exotic stacking (deep classic-SRv6 SID lists,
+# tunnel-in-tunnel) PMTUDs cleanly rather than blackholing.
+# The jumbo target is 8950 (9000-byte underlay minus the same 50 bytes). Flip
+# both declarative values atomically only after eligible nodes advertise
+# skyforge.example.com/meshnet-fabric-mtu=8950 and every L2 hop is
+# validated. At >1450, taskengine restricts cross-node placement to nodes
+# carrying the exact label; otherwise it pins the whole lab to one node.
+#
+# FLIPPED TO 8950 on 2026-08-12, with that precondition MET, not assumed:
+#   - mgmt05 (the single Cisco Nexus 3048TP-1GE every node hangs off) now
+#     carries a system-wide network-qos jumbo policy.
+#   - All four nodes run eno1 at MTU 9000, persisted in machine config.
+#   - Full-mesh DF-set 8972 (9000 on the wire) passes in EVERY direction,
+#     16/16 pairs, including node-a.
+#   - All four advertise meshnet-fabric-mtu=8950 + meshnet-underlay-interface=eno1.
+# Do NOT read the switch's CDP MTU TLV as confirmation: on NX-OS it tracks
+# the L2 port setting and still reports 1500 under a network-qos policy.
+# This MUST stay equal to skyforge.kne.meshnet.fabricMTU in the chart; they
+# were raised in the same change.
+link_mtu: 8950
+overlay_mtu_headroom: 90
+    # Per-device INTERFACE (L3) MTU ceilings for NOS whose media MTU caps BELOW
+    # the global jumbo link_mtu above. apply_kne_link_mtu lowers a link to the
+    # smallest ceiling among its attached devices (both ends stay symmetric so
+    # OSPF/IS-IS adjacency + PMTUD hold); devices not listed keep link_mtu.
+    #   iosxr (XRd): the containerized IOS-XR control plane rejects any media
+    #     MTU > 9000 ("valid media MTU range is from 64 to 9000"). netlab's
+    #     iosxr initial template emits media MTU = interface_mtu + 14 (its L2
+    #     kludge), so the interface MTU must stay <= 8986 to land media == 9000.
+    #     Without this, link_mtu 9214 -> "mtu 9228" and `netlab initial` dies on
+    #     the very first interface, before the XRd dataplane/VRF-netns (and thus
+    #     patches/kne/0017) is ever reached. 8986 keeps XRd jumbo (media 9000)
+    #     while EOS/etc. keep 9214. Enforced by patches/netlab/0006.
+    # ⚠️ MEASURED 2026-08-13 -- XRd's own error text LIES about its limit.
+    # XRd reports "valid media MTU range is from 64 to 9000" and then CRASHES
+    # applying much above ~4500: /pkg/bin/config dies with SIGBUS partway
+    # through `netlab initial`, retries 5-6 times, then FatalError. Cisco
+    # documents no maximum; netlab's caveats page records none for iosxr
+    # either (CSR1000v is capped there at 1500).
+    #
+    # One variable, same host/image/digest. interface -> rendered media (+14):
+    #   1500 -> 1514 applies    5000 -> 5014 SIGBUS
+    #   4000 -> 4014 applies    6000 -> 6014 SIGBUS
+    #   4500 -> 4514 applies    8000 -> 8014 SIGBUS
+    #        (highest proven)   8950 -> 8964 SIGBUS  <- the fleet value
+    #
+    # True ceiling is between 4500 and 5000; 4500 is the largest PROVEN
+    # value. Do NOT raise it toward 9000 on the strength of XRd's error
+    # text -- that is exactly what 8986 was, and it made every jumbo XRd
+    # lab fail to configure from 2026-08-12 until this change.
+device_link_mtu:
+  iosxr: 4470
+# tcp_mss_clamp is the TCP MSS ceiling endpoints are forced down to so they
+# never emit a segment the fabric silently blackholes. The MTU clamp above
+# only sizes the *interface* MTU; it cannot stop an MPLS-VPN transit LSR from
+# PMTUD-blackholing a full-MTU TCP segment once label-stack (+meshnet VXLAN)
+# overhead pushes the on-wire frame past the underlay. MSS clamping is the
+# standard fix and is the single source of truth for every per-NOS clamp line.
+#
+# Derivation, anchored once and referenced by each NOS's group_vars below so
+# it stays correct if link_mtu changes:
+#   tcp_mss_clamp = link_mtu - 40 (IPv4+TCP headers) - 20 (MPLS label stack
+#   + margin) = 1450 - 60 = 1390.
+# If you change link_mtu, update this value with it (same contract as
+# overlay_mtu_headroom). netlab has no native MSS knob, so the clamp is
+# emitted by Skyforge's own per-NOS templates (templates/eos/initial.j2,
+# templates/initial/<nos>.j2); a new NOS adds one clamp line referencing
+# {{ tcp_mss_clamp }}, which reaches the template via that NOS's group_vars.
+tcp_mss_clamp: &tcp_mss_clamp 1390
