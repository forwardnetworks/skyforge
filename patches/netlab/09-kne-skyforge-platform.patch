+def test_kne_ixia_c_nodes_run_the_image_entrypoint_not_the_host_sleep(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  # KNE gives a HOST node `sleep 2000000000000` unless the topology carries a
+  # command; a container command replaces the image entrypoint, so an OTG
+  # controller/engine without one never serves. A non-OTG linux host must stay
+  # untouched (KNE's own default applies there).
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+
+nodes:
+  ctl:
+    device: keysight_ixia-c-controller
+  eng:
+    device: keysight_ixia-c-traffic-engine
+  h1:
+    device: linux
+links: [ ctl-eng, eng-h1 ]
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+  text = Path('topology.pb.txt').read_text()
+  ctl = _node_block(text,'ctl')
+  assert 'command: "./bin/controller"' in ctl and 'command: "--accept-eula"' in ctl
+  assert 'sleep' not in ctl
+  eng = _node_block(text,'eng')
+  assert 'command: "./entrypoint.sh"' in eng
+  assert 'key: "OPT_NO_HUGEPAGES"' in eng            # the env hook still runs beside the command hook
+  assert 'command:' not in _node_block(text,'h1')
+
+
+def test_kne_ixia_c_engine_disables_dpdk_core_pinning(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  # The engine image pins DPDK lcores to fixed cores by default and PANICs in
+  # rte_eal_init ("Cannot set affinity") inside a pod with a restricted cpuset.
+  # entrypoint.sh honours OPT_NO_PINNING only as the exact string "Yes".
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+
+nodes:
+  ctl:
+    device: keysight_ixia-c-controller
+  eng:
+    device: keysight_ixia-c-traffic-engine
+  h1:
+    device: linux
+links: [ ctl-eng, eng-h1 ]
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+  text = Path('topology.pb.txt').read_text()
+  eng = _node_block(text,'eng')
+  assert 'key: "OPT_NO_PINNING"' in eng
+  assert re.search(r'key: "OPT_NO_PINNING"\s+value: "Yes"',eng)
+  assert 'OPT_NO_PINNING' not in _node_block(text,'ctl')
+  assert 'OPT_NO_PINNING' not in _node_block(text,'h1')
