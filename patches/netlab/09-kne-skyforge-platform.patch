From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] kne: Skyforge platform defaults, day-0 shims, Caldera agent
 env, config-exec bulkhead, boot-config mode, ixia-c entrypoint and engine
 pinning, netmiko parameters as device features

---
diff --git a/netsim/ansible/templates/initial/asa.j2 b/netsim/ansible/templates/initial/asa.j2
index e23b815..38dc225 100644
--- a/netsim/ansible/templates/initial/asa.j2
+++ b/netsim/ansible/templates/initial/asa.j2
@@ -1,6 +1,64 @@
+{#
+  ASAv KubeVirt day-0. KNE presents this rendered config as a SATA CD-ROM
+  containing the exact root filename /day0-config before the VM boots.
+#}
+{% set login_user = ansible_user|default('admin') %}
+{% set login_password = ansible_ssh_pass|default(ansible_password|default('CiscoAsa1!')) %}
+{% set enable_password = ansible_become_password|default(login_password) %}
+console serial
+!
 hostname {{ inventory_hostname }}
 domain-name lab.local
 !
+enable password {{ enable_password }}
+username {{ login_user }} password {{ login_password }} privilege 15
+username {{ login_user }} attributes
+ service-type admin
+aaa authentication ssh console LOCAL
+aaa authentication http console LOCAL
+aaa authorization exec LOCAL auto-enable
+!
+interface Management0/0
+ management-only
+ nameif management
+ security-level 0
+ ip address dhcp setroute
+ no shutdown
+!
+! management-only IS LOAD-BEARING, not hygiene. Without it Management0/0 is an
+! ordinary data interface and its DHCP `setroute` default lands in the DATA
+! routing table at distance 1. The moment a topology gives the ASA a static
+! default of its own -- `route outside 0.0.0.0 0.0.0.0 <gw>`, which is what a
+! firewall between a site and its WAN edge always has -- there are two
+! distance-1 defaults on two interfaces, the ASA refuses the second, and since
+! the static one is already in the config at boot it is DHCP's that loses.
+! Replies to SSH from the pod network then leave via `outside` into nowhere.
+!
+! MEASURED 2026-09-11 on demo-lab run 135463, the first bring-up after routing
+! reached the ASA (netlab 0069/0070): cdg-fw01, with no static default,
+! answered SSH; jfk-dc-fw01, byte-identical here but carrying the DC's default
+! route, timed out on port 22 and failed the deploy with
+! "SSH server did not start in time". Same image, same boot, same day-0 block
+! -- the only difference was one static route.
+!
+! With management-only the DHCP default goes into the ASA's separate
+! MANAGEMENT-ONLY routing table, the static default into the data table, and
+! both coexist. That is the ASA's own design for out-of-band management, which
+! is exactly what pod eth0 is here. to-the-box traffic (SSH, HTTP) is what a
+! management-only interface exists to carry, so nothing that worked is lost.
+!
+! noconfirm: day-0 generates this key at first boot, and the ansible initial
+! replay of this same file then hits ASA's "keypair already exists, replace?
+! [yes/no]" prompt -- which cliconf cannot answer, so the task hangs to the
+! command timeout (measured 2026-08-28, probe 5e3ee4ef: "timeout value 60
+! seconds reached ... crypto key generate rsa modulus 4096").
+crypto key generate rsa modulus 4096 noconfirm
+ssh version 2
+ssh 0.0.0.0 0.0.0.0 management
+ssh key-exchange group dh-group14-sha1
+http server enable
+http 0.0.0.0 0.0.0.0 management
+!
 ! `name <ip> <hostname>` aliases REMOVED 2026-09-09.
 !
 {% if loopback is defined %}
diff --git a/netsim/ansible/templates/initial/ios.j2 b/netsim/ansible/templates/initial/ios.j2
index b560219..e8d8ff0 100644
--- a/netsim/ansible/templates/initial/ios.j2
+++ b/netsim/ansible/templates/initial/ios.j2
@@ -12,9 +12,14 @@ crypto key generate rsa modulus 2048
 ip ssh version 2
 ip ssh time-out 60
 ip ssh authentication-retries 3
+{# PHASE 0 (byte-identity shim, patches/netlab/RESURRECT.md #1): the /etc/netlab shadow of
+   this file never rendered the debug block for iol/ioll2/ios/iosv/csr, only cat8000v did.
+   Phase 0 A4 removes the guard, one image at a time. #}
+{% if netlab_device_type == 'cat8000v' %}
 {% from '_debug_commands.j2' import enable_debugging %}
 {{ enable_debugging(ios.debug,prefix='do debug') }}
 !
+{% endif %}
 lldp run
 {#
   CDP is OFF by default, as upstream has it (#3807). netlab_cdp_enable -- a
@@ -27,6 +32,11 @@ cdp run
 no cdp run
 {% endif %}
 !
+{# PHASE 0 (byte-identity shim, RESURRECT.md #2 and #3): upstream's form (honours
+   services.dns._no_hosts; ONE address per family, because a multi-address `ip host` line is
+   rejected on these platforms) is what cat8000v renders today. The /etc/netlab shadow
+   rendered every address and ignored _no_hosts for the rest of the IOS family. #}
+{% if netlab_device_type == 'cat8000v' %}
 {% if services.dns._no_hosts is not defined %}
 {%   for hname,hdata in hosts.items() if hname != inventory_hostname %}
 {%     set ipv6_addr = hdata.ipv6|default([]) if netlab_device_type not in ['iosvl2','ioll2'] else [] %}
@@ -44,6 +54,21 @@ ip host {{ hname }} {{ addr_list|join (' ') }}
 {%     endif %}
 {%   endfor %}
 {% endif %}
+{% else %}
+{% for hname,hdata in hosts.items() if hname != inventory_hostname %}
+{%   set ipv6_addr = hdata.ipv6|default([]) if netlab_device_type not in ['iosvl2','ioll2'] else [] %}
+{%   set addr_list = [] %}
+{%   if hdata.ipv4 is defined and hdata.ipv4 %}
+{%     set addr_list = addr_list + hdata.ipv4 %}
+{%   endif %}
+{%   if ipv6_addr %}
+{%     set addr_list = addr_list + [ ipv6_addr[0] ] %}
+{%   endif %}
+{%   if addr_list %}
+ip host {{ hname }} {{ addr_list|join (' ') }}
+{%   endif %}
+{% endfor %}
+{% endif %}
 !
 {% if af.ipv4|default(False) or role != 'host' %}
 ip routing
@@ -73,7 +98,13 @@ vrf definition {{ netlab_mgmt_vrf|default('MGMT') }}
 !
 {% endif %}
 {% if vlans is defined %}
+{# PHASE 0 shim, RESURRECT.md #6: per-device vlan templates (iol/ioll2/iosvl2/csr) were unreachable
+   under the shadow; only cat8000v resolved its own. #}
+{% if netlab_device_type == 'cat8000v' %}
 {% include [ netlab_device_type ~ '.vlan.j2', 'ios.vlan.j2' ] +%}
+{% else %}
+{% include 'ios.vlan.j2' +%}
+{% endif %}
 !
 {% endif %}
 !
@@ -132,6 +163,17 @@ interface {{ mgmt.ifname }}
  no shutdown
 {% endif %}
 !
+{% if netlab_device_type in ['iol','ioll2'] %}
+{# THE MANAGEMENT VRF NEEDS A WAY OUT. Inbound (SSH, SNMP polls) always worked: the wrapper
+   NATs from 169.254.100.1, on-link, so replies need no route. Anything the device ORIGINATES
+   toward the platform -- the flow exporter, syslog -- resolves 198.19.255.x in this VRF, which
+   held only the connected /30. MEASURED on demo-lab lhr-dis-rt01 (2026-09-12): `show flow
+   exporter statistics` "No FIB: 22, Successfully sent: 0"; syslog "started" with nothing
+   delivered. 169.254.100.1 is the IOL wrapper's side of the management veth (ARP: the
+   wrapper's MAC), the same next hop every IOL has. #}
+ip route vrf {{ netlab_mgmt_vrf|default('MGMT') }} 0.0.0.0 0.0.0.0 169.254.100.1
+!
+{% endif %}
 {% for l in interfaces|default([]) %}
 interface {{ l.ifname }}
 {% if l.type == 'vlan_member' and l.vlan.access_id is defined %}
@@ -159,6 +201,22 @@ interface {{ l.ifname }}
  mtu {{ l.mtu }}
 {%   endif %}
 {% endif %}
+{#
+    TCP MSS clamp (PMTUD-blackhole fix for MPLS-VPN over the meshnet fabric).
+    Single source of truth: providers.kne.tcp_mss_clamp, delivered here via the device
+    group_vars. `ip tcp adjust-mss` rewrites the MSS in TCP SYNs traversing the interface
+    (bidirectional) and applies on routed interfaces only, so this is scoped to real
+    (non-virtual) wires with an IP family. NOTE (RESURRECT.md #5): nothing sets the
+    `tcp_mss_clamp` variable today, so this renders nothing on any device.
+#}
+{% if tcp_mss_clamp is defined and l.virtual_interface is not defined %}
+{%   if 'ipv4' in l %}
+ ip tcp adjust-mss {{ tcp_mss_clamp }}
+{%   endif %}
+{%   if 'ipv6' in l %}
+ ipv6 tcp adjust-mss {{ tcp_mss_clamp }}
+{%   endif %}
+{% endif %}
 {#
     Set interface addresses: IPv4
 #}
@@ -236,10 +294,13 @@ interface {{ l.ifname }}
 !
 {% endfor %}
 !
+{# PHASE 0 shim, RESURRECT.md #4: never rendered for the non-cat8000v IOS family. #}
+{% if netlab_device_type == 'cat8000v' %}
 ! Configure DHCP client - has to be done before routing protocol config, but after generic interface config
 !
 {{ extra_module_initial(['dhcp']) }}
 !
+{% endif %}
 line con 0
  exec-timeout 0 0
  privilege level 15
diff --git a/netsim/ansible/templates/initial/vjunos-router.j2 b/netsim/ansible/templates/initial/vjunos-router.j2
new file mode 100644
index 0000000..966b3d6
--- /dev/null
+++ b/netsim/ansible/templates/initial/vjunos-router.j2
@@ -0,0 +1,175 @@
+{#
+    vJunos day-0 (router and switch share this body).
+
+    Same shape as initial/asa.j2: a KubeVirt VM NOS whose day-0 file IS its
+    whole configuration, so this template owns the whole file. vJunos runs in
+    startup config mode on the KNE lane -- upstream declares
+    `config_mode: [startup]` for the junos family under `clab` only
+    (netsim/devices/junos.yml), which never reaches KNE, but
+    get_node_config_mode() falls through to 'startup' anyway.
+
+    WHY WE OWN IT RATHER THAN INCLUDING junos.j2. The image is the vendor qcow2
+    with every vrnetlab layer dropped (defaults.yml, patches/kne/0029), and
+    vrnetlab's launch.py was the only thing that ever created a login on this
+    NOS: Junos ships no user, no sshd and no fxp0 address, and netlab's junos
+    templates emit none because on the containerlab lane vrnetlab supplied
+    them -- which is why netlab's own vjunos-*.yml hardcodes admin/admin@123.
+    Measured 2026-08-28 on demo-lab: four vJunos booting a correct config
+    with no account to log into, CONNECTION_TIMEOUT from the collector on all four.
+
+    Including junos.j2 cannot supply the rest: the including template's own
+    directory becomes the include root, so junos.j2's nested `junos/hosts.j2`
+    is unresolvable (there is no top-level netsim/ansible/templates/junos, only
+    initial/junos/). Owning the file also keeps ONE `system` block instead of
+    concatenating a second one onto netlab's.
+
+    The interface/hosts/lldp bodies below track netsim/ansible/templates/
+    initial/junos.j2 and initial/junos/{hosts,lldp}.j2 as of netlab
+    f97ba3b8. The two conditional sub-templates ARE included, by their
+    initial/ path, because they carry no nested includes of their own.
+#}
+system {
+  host-name {{ inventory_hostname }};
+  static-host-mapping {
+{% for k,v in hostvars.items() if k != inventory_hostname %}
+{%   if v.loopback.ipv4 is defined %}
+    {{ k|replace('_','') }} inet {{ v.loopback.ipv4|ansible.utils.ipaddr('address') }};
+{%   elif v.interfaces|default([]) and v.interfaces[0].ipv4|default(False) is string %}
+    {{ k|replace('_','') }} inet {{ v.interfaces[0].ipv4|ansible.utils.ipaddr('address') }};
+{%   endif %}
+{% endfor %}
+  }
+{#
+    THE LOGIN. Ported from vrnetlab juniper/vjunos{switch,router}/docker/
+    init.conf (byte-identical between the two models). Credentials come from
+    ansible_user / ansible_ssh_pass so they follow netlab's own declaration.
+    `plain-text-password-value` is the config-FILE spelling; Junos hashes it on
+    the boot-time commit.
+#}
+  root-authentication {
+    plain-text-password-value "{{ ansible_ssh_pass|default('admin@123') }}";
+  }
+  login {
+    user {{ ansible_user|default('admin') }} {
+      class super-user;
+      authentication {
+        plain-text-password-value "{{ ansible_ssh_pass|default('admin@123') }}";
+      }
+    }
+  }
+  services {
+    ssh {
+      root-login allow;
+    }
+    netconf {
+      ssh;
+    }
+  }
+{#
+    management-instance keeps fxp0 in the mgmt_junos routing instance, so the
+    management default route cannot leak into the lab's own routing table.
+#}
+  management-instance;
+}
+
+{% if vrfs is defined %}
+{% include 'initial/junos.vrf.j2' %}
+{% endif %}
+{% if vlans is defined %}
+{% include 'initial/junos.vlan.j2' %}
+{% endif %}
+
+interfaces {
+{#
+    fxp0 IS the management address, statically, exactly as vrnetlab's init.conf
+    set {MGMT_IP_IPV4}. DHCP does NOT work here, and the reason is worth keeping:
+    this image is a Linux wrapper running the Junos RE nested behind its own
+    br-ext bridge, and the WRAPPER's dhclient consumes the single lease KubeVirt
+    masquerade offers ("bound to 10.0.2.2"). The RE is left with no address, so
+    nothing answers on 22/830 even though sshd is listening on both.
+
+    10.0.2.2/24 via 10.0.2.1 are KubeVirt masquerade constants: masquerade NATs
+    inbound traffic to 10.0.2.2 and gateways at 10.0.2.1 (the default
+    10.0.2.0/24 -- our VMIs never override the masquerade cidr), so the RE must
+    hold exactly this address to receive it.
+
+    Verified 2026-08-29 on a real KubeVirt vJunos VM: fxp0.0 up at 10.0.2.2/24,
+    ping to 10.0.2.1 in mgmt_junos at 0% loss, and SSH-2.0-OpenSSH_7.5 returned
+    on both 22 and 830 from a separate pod.
+#}
+  fxp0 {
+    unit 0 {
+      family inet {
+        address 10.0.2.2/24;
+      }
+    }
+  }
+{#
+# MTU is handled outside the main interface loop: it applies only to the master
+# interface, and the value is computed by the junos device quirks.
+#}
+{% for l in interfaces|default([]) %}
+{%   if l._junos_mtu_with_headers is defined %}
+  {{ l.junos_interface }} {
+    mtu {{ l._junos_mtu_with_headers }};
+  }
+{%   endif %}
+{% endfor %}
+
+{% for l in netlab_interfaces %}
+  {{ l.ifname }} {
+{% if l.name is defined %}
+    description "{{ l.name }}{{ " ["+l.role+"]" if l.role is defined else "" }}";
+{% elif l.type|default("") == "stub" %}
+    description "Stub interface"
+{% endif %}
+
+{% if l.bandwidth is defined %}
+      bandwidth {{ l.bandwidth * 1000 }};
+{% endif %}
+{% if l.shutdown|default(False) %}
+      disable;
+{% endif %}
+{% if 'ipv4' in l %}
+      family inet {
+{%   if l.ipv4 == True %}
+        unnumbered-address lo0.0;
+{%   elif l.ipv4|ansible.utils.ipv4 %}
+        address {{ l.ipv4 }};
+{%   else %}
+! Invalid IPv4 address {{ l.ipv4 }}
+{%   endif %}
+{%   if l.mtu is defined and l._junos_mtu_with_headers is not defined %}
+        mtu {{ l.mtu }};
+{%   endif %}
+      }
+{% endif %}
+{% if 'ipv6' in l %}
+      family inet6 {
+{%   if l.ipv6 is string %}
+        address {{ l.ipv6 }};
+{%   endif %}
+{%   if l.mtu is defined and l._junos_mtu_with_headers is not defined %}
+        mtu {{ l.mtu }};
+{%   endif %}
+      }
+{% endif %}
+  }
+{% endfor %}
+}
+{% include 'initial/junos/lldp.j2' %}
+
+{#
+    management-instance puts fxp0 in the mgmt_junos routing instance, so the
+    management default route has to live there too -- it is not inherited from
+    inet.0. Without it the RE answers only on-subnet.
+#}
+routing-instances {
+  mgmt_junos {
+    routing-options {
+      static {
+        route 0.0.0.0/0 next-hop 10.0.2.1;
+      }
+    }
+  }
+}
