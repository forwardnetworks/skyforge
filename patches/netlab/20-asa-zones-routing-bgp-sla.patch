From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:00 +0000
Subject: [PATCH] asa: security zones, static routes, redistribution, BGP
 address family, SLA monitor

---
diff --git a/netsim/ansible/templates/bgp/asa.j2 b/netsim/ansible/templates/bgp/asa.j2
index ff50f3a..ff93e0c 100644
--- a/netsim/ansible/templates/bgp/asa.j2
+++ b/netsim/ansible/templates/bgp/asa.j2
@@ -20,4 +20,12 @@ router bgp {{ bgp.as }}
 {%   for n in bgp.neighbors if n[af] is defined %}
 {{ bgpcfg.neighbor_af(n,n[af],bgp) }}
 {%   endfor %}
+{#
+    Close every family. Without exit-address-family a CVAC day-0 load leaves the parser in BGP
+    address-family sub-mode, so every following global command (same-security-traffic, the NAT
+    objects and rules) is swallowed or rejected. Measured on demo-lab jfk-dc-fw01 2026-09-13:
+    BGP 179 refused, the DC firewall had no route back to its servers. The device's own export
+    closes each family the same way.
+#}
+  exit-address-family
 {% endfor %}
diff --git a/netsim/ansible/templates/initial/asa.j2 b/netsim/ansible/templates/initial/asa.j2
index 29beb07..e23b815 100644
--- a/netsim/ansible/templates/initial/asa.j2
+++ b/netsim/ansible/templates/initial/asa.j2
@@ -1,13 +1,7 @@
 hostname {{ inventory_hostname }}
 domain-name lab.local
 !
-{% if not netlab_initial_reload|default(False) %}
-{%   for k,v in hostvars.items() if k != inventory_hostname and v.af.ipv4|default(False) %}
-{%     if v.loopback.ipv4 is defined %}
-name {{ v.loopback.ipv4|ansible.utils.ipaddr('address') }} {{ k }}
-{%     endif %}
-{%   endfor %}
-{% endif %}
+! `name <ip> <hostname>` aliases REMOVED 2026-09-09.
 !
 {% if loopback is defined %}
 interface {{ loopback.ifname }}
@@ -20,6 +14,57 @@ interface {{ loopback.ifname }}
 {%   endif %}
 {% endif %}
 !
+! Inherited from upstream's asa.j2, this looped over ALL of hostvars -- the whole
+! lab, not this ASA's neighbours -- emitting one line per node with a loopback.
+! On a 67-node demo-lab that is ~60 lines per ASA, growing O(fleet size) on every
+! ASA in every topology.
+!
+! They are display aliases and nothing consumes them: initial/asa.j2 was the only
+! ASA template that touched hostvars at all, and bgp/asa.j2, ospf/asa.j2 and
+! isis/asa.j2 each emit literal addresses. Their only effect is `show` output
+! readability, and they are parsed at boot out of the day-0 ISO.
+!
+{#
+   SAME-SECURITY-TRAFFIC is a NODE-level switch, and it belongs HERE, in the
+   template that actually renders (netlab patch 0068 originally added it to a
+   /etc/netlab shadow copy of this file and never to this one, so it reached no
+   device until Phase 0 folded the shadow into this patch).
+
+   MEASURED 2026-09-11 on demo-lab (run 139186, image r89): the rendered
+   `initial` for cdg-fw01 carried the zone names and levels (this file) and no
+   same-security-traffic (the patch), and the ASA's own packet-tracer for
+   inside -> corporate answered DROP acl-drop. Both zones are level 100 and the
+   ASA denies equal-level traffic unless this line is present; CDG's LAN reaches
+   the SD-WAN overlay only by crossing it.
+
+   The firewall.policy plugin cannot emit it either: it returns early for a
+   zone with no rules, and cdg-fw01 is exactly that -- the switch and no ACL,
+   because the source lab has none there. Emitted at node level so the
+   declaration reaches the device without inventing permit-any rules.
+#}
+{% if ((firewall|default({})).policy|default({})).same_security_traffic|default(False) %}
+same-security-traffic permit inter-interface
+!
+{% endif %}
+{#
+   PROTOCOL INSPECTION (firewall.policy.inspect). The ASA's factory config
+   already carries `policy-map global_policy / class inspection_default` bound
+   by `service-policy global_policy global`; re-entering it and adding
+   `inspect icmp` is additive. Without ICMP inspection the return half of a
+   ping/traceroute from a high-security interface is a NEW flow arriving on
+   the low-security side and is dropped unless an ACL permits it -- so the
+   source's `inspect icmp` is the difference between "traceroute shows every
+   hop" and "* * * past the firewall".
+#}
+{% set _inspect = ((firewall|default({})).policy|default({})).inspect|default([]) %}
+{% if _inspect %}
+policy-map global_policy
+ class inspection_default
+{%   for eng in _inspect %}
+  inspect {{ eng|replace('-',' ') }}
+{%   endfor %}
+!
+{% endif %}
 {% for l in interfaces|default([]) %}
 interface {{ l.ifname }}
 {%   if l.shutdown|default(False) %}
@@ -28,21 +73,26 @@ interface {{ l.ifname }}
  no shutdown
 {%   endif %}
 {%   if not netlab_initial_reload|default(False) %}
- nameif {{ l.ifname }}
+{#
+   nameif IS the ASA's zone: firewall.policy binds its ACLs to this name and
+   the nat plugin writes `nat (<nameif>,<nameif>)`. Set it here rather than in
+   a plugin template -- renaming an interface later makes the ASA discard the
+   configuration attached to the old name, the bound ACL included. With no zone
+   declared the interface keeps its own name, which is the previous behaviour.
+#}
+{%     set nameif = l.firewall.zone if (l.firewall is defined and l.firewall.zone is defined) else l.ifname %}
+ nameif {{ nameif }}
+{%     if l.firewall is defined and l.firewall.security_level is defined %}
+ security-level {{ l.firewall.security_level }}
+{%     endif %}
 {%     if l.name is defined %}
  description {{ l.name }}{{ " ["+l.role+"]" if l.role is defined else "" }}
 {%     elif l.type|default("") == "stub" %}
  description Stub interface
 {%     endif %}
-{#
-    Set interface addresses: IPv4
-#}
 {%     if 'ipv4' in l %}
  ip address {{ l.ipv4|ansible.utils.ipaddr('address') }} {{ l.ipv4|ansible.utils.ipaddr('netmask') }}
 {%     endif %}
-{#
-    Set interface addresses: IPv6
-#}
 {%     if 'ipv6' in l %}
 {%       if l.ipv6 == True %}
  ipv6 enable
@@ -50,13 +100,45 @@ interface {{ l.ifname }}
  ipv6 address {{ l.ipv6|upper }}
 {%       endif %}
 {%     endif %}
-!
+{%     if l.mtu is defined %}
 {#
-    Set MTU
+   `mtu` on the ASA takes the NAMEIF, not the interface name, and it is a
+   GLOBAL command. This read `mtu {{ l.ifname }}` and worked only for as long
+   as nameif happened to equal the interface name. The moment an interface
+   declared firewall.zone, nameif became the zone and the box answered
+   "ERROR: % Invalid input detected" on a fleet-wide 8950 MTU -- measured on
+   jfk-dc-fw01. Both now read the same variable.
 #}
-{%     if l.mtu is defined %}
-mtu {{ l.ifname }} {{ l.mtu }}
+mtu {{ nameif }} {{ l.mtu }}
+{%     endif %}
+{#
+   ASA HAS NEITHER CDP NOR LLDP. (History: this block was first added to the vendor
+   copy and never rendered, because a /etc/netlab shadow of this file beat it --
+   CONFIRMED 2026-10-02 on demo-lab atl-bldg1-fw01, `show sla monitor
+   configuration` EMPTY across a fresh rebuild. The shadow is gone; this is the
+   only copy.)
+
+   `sla monitor` is the built-in substitute: a real, continuous ICMP echo
+   across the link, refreshing ARP and generating flow-exportable traffic
+   entirely from ASA's own CLI, so the collector's ARP/flow-based link inference has
+   something to see even with zero real traffic.
+
+   GATED to point-to-point links only (exactly one neighbor with a real IPv4
+   address): a stub/routed-but-neighborless interface has nothing to ping, and
+   a multi-neighbor broadcast segment has no single "the peer" to target.
+
+   `num-packets` is REJECTED by ASA 9.24 right after `type echo` (live
+   2026-10-02: "Invalid input" at `num-packets 1`); the default is already 1
+   packet, so it is not configured. `timeout`/`frequency` are accepted.
+#}
+{%     set _sla_neighbors = l.neighbors|default([])|selectattr('ipv4', 'defined')|list %}
+{%     if _sla_neighbors|length == 1 %}
+sla monitor {{ l.ifindex + 1 }}
+ type echo protocol ipIcmpEcho {{ _sla_neighbors[0].ipv4|ansible.utils.ipaddr('address') }} interface {{ nameif }}
+ timeout 1000
+ frequency 5
+sla monitor schedule {{ l.ifindex + 1 }} life forever start-time now
 {%     endif %}
-!
 {%   endif %}
+!
 {% endfor %}
diff --git a/netsim/ansible/templates/ospf/asa.ospfv2.j2 b/netsim/ansible/templates/ospf/asa.ospfv2.j2
index 8ad6ec8..34b6342 100644
--- a/netsim/ansible/templates/ospf/asa.ospfv2.j2
+++ b/netsim/ansible/templates/ospf/asa.ospfv2.j2
@@ -21,6 +21,15 @@ router ospf {{ ospf_pid }}
     if dfd.type|default('') %} metric-type {{ dfd.type.replace('e','') }}{% endif %}{%
     if dfd.cost|default(0) %} metric {{ dfd.cost }}{% endif +%}
 {% endif %}
+{#
+    REDISTRIBUTION. Without this the ASA can speak OSPF but cannot inject
+    anything into it, so a firewall that is the only path between a site and
+    its WAN edge advertises nothing and the site is unreachable from the
+    overlay. MEASURED on demo-lab: jfk-dc-fw01's source configuration carries
+    `route Null0 172.21.0.0/16` plus `redistribute static route-map static_to_ospf`
+    into OSPF 1. Upstream #3934 added the shared ASA macro; this series extends it
+    with the route-map (routing/asa.j2 renders match-only route-maps).
+#}
 {% if ospf_data.import is defined %}
 {{   redistribute.config(ospf_data,t_proto='ospf',ospf_pid=ospf_pid) }}
 {% endif %}
diff --git a/netsim/ansible/templates/ospf/asav.j2 b/netsim/ansible/templates/ospf/asav.j2
new file mode 100644
index 0000000..a8e0ea6
--- /dev/null
+++ b/netsim/ansible/templates/ospf/asav.j2
@@ -0,0 +1,9 @@
+{#
+  Same reason as routing/asav.j2: `ansible_network_os: asa` selects ospf/asa.j2
+  at deploy time, but the capability projection stat-s
+  templates/ospf/<device-ancestor>.j2 and asav has no parent -- so without this
+  file the catalog reported OSPF as declared-but-rendering-nothing on asav,
+  which was never true. Pre-existing; fixed here because 0069 is the change that
+  made the lie visible.
+#}
+{% include 'ospf/asa.j2' %}
diff --git a/netsim/ansible/templates/routing/_redistribute.asa.j2 b/netsim/ansible/templates/routing/_redistribute.asa.j2
index 0b2b03c..4c8102d 100644
--- a/netsim/ansible/templates/routing/_redistribute.asa.j2
+++ b/netsim/ansible/templates/routing/_redistribute.asa.j2
@@ -1,5 +1,5 @@
 {#
-   Route redistribution for Cisco ASA (no routing policies)
+   Route redistribution for Cisco ASA (a policy renders as `route-map <name>`, match-only, see routing/asa.j2)
    OSPF is not redistributed into IPv6 BGP (no OSPFv3 support)
 #}
 {% macro config(pdata,af='ipv4',t_proto='',ospf_pid=1) -%}
@@ -10,6 +10,6 @@
 {%     elif s_proto == 'ospf' %}
 {%       set sp_config = sp_config + ' ' + ospf_pid|string + ' match internal external 1 external 2' %}
 {%     endif %}
-  redistribute {{ sp_config }}{{ ' subnets' if t_proto == 'ospf' else '' }}
+  redistribute {{ sp_config }}{{ ' subnets' if t_proto == 'ospf' else '' }}{% if 'policy' in s_data %} route-map {{ s_data.policy }}{% endif +%}
 {%   endfor %}
 {%- endmacro %}
diff --git a/netsim/ansible/templates/routing/asa.j2 b/netsim/ansible/templates/routing/asa.j2
index b43e7ab..803ab47 100644
--- a/netsim/ansible/templates/routing/asa.j2
+++ b/netsim/ansible/templates/routing/asa.j2
@@ -1,22 +1,115 @@
 {#
-   ASA static routes need the outgoing interface (nameif == ifname in the initial template),
-   so only directly-connected next hops and discard routes can be configured
+  ROUTE-MAPS AND THE ACLS THEY MATCH.
+
+  The ASA does not have prefix-lists. A route-map matches a STANDARD ACL:
+
+      access-list <name> standard permit <network> <mask>
+      route-map <name> permit <seq>
+       match ip address <name>
+
+  netlab models the filter as routing.prefix (a prefix list) referenced from
+  routing.policy[].match.prefix, so the prefix list is rendered AS an ACL of the
+  same name and the route-map matches it by that name. It reads the routing
+  module's per-AF expansion (routing._prefix.ipv4): since #3845 an entry in
+  routing.prefix carries a LIST of prefixes, and _prefix holds exactly one per
+  entry, in upstream's sequence order.
+
+  MATCH-PREFIX ONLY. `set` attributes (local-pref, MED, weight, prepend,
+  communities) are BGP path attributes the ASA does not offer on a route-map
+  used for redistribution, and they are declared unsupported on this device
+  rather than silently dropped -- a route-map that matches correctly and sets
+  nothing is the shape that looks right and does the wrong thing.
+
+  WHY THIS EXISTS AT ALL: without the filter, `redistribute static` on
+  jfk-dc-fw01 injects BOTH of its statics into OSPF -- the 172.21/16 aggregate
+  AND the default route via `outside` -- and the default would then propagate to
+  every site over OMP. The source filters for exactly that reason.
 #}
-{% for sr_data in routing.static|default([]) if 'intf' in sr_data.nexthop or 'discard' in sr_data.nexthop %}
+{% for pfx_name,pfx_list in routing._prefix.ipv4|default({})|dictsort %}
+{%   for pfx in pfx_list %}
+access-list {{ pfx_name }} standard {{ pfx.action|default('permit') }} {{
+  pfx.ipv4|ansible.utils.ipaddr('network') }} {{
+  pfx.ipv4|ansible.utils.ipaddr('netmask') }}
+{%   endfor %}
+{% endfor %}
+{% for pol_name,pol_list in routing.policy|default({})|dictsort %}
+{%   for p in pol_list %}
+route-map {{ pol_name }} {{ p.action|default('permit') }} {{ p.sequence|default(loop.index * 10) }}
+{%     if p.match.prefix is defined %}
+ match ip address {{ p.match.prefix }}
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+{#
+  STATIC ROUTES ON AN ASA -- PRIMITIVES ONLY.
+
+  This template deliberately implements `routing.static` and NOTHING ELSE. The
+  routing module's other halves (policy/route-maps, prefix-lists, as-path lists,
+  communities, ACLs) are a large surface with ASA-specific syntax that differs
+  from IOS in more places than it matches, and none of it is needed to give a
+  firewall a route. Declaring only what is implemented is what keeps
+  `check_optional_features` honest: a topology asking this device for a route-map
+  is REFUSED with the feature named, rather than compiling clean and rendering
+  nothing.
+
+  ASA STATIC SYNTAX IS NOT IOS SYNTAX, and the differences are load-bearing:
+
+    route <nameif> <network> <mask> <gateway> [distance]
+
+  * The first argument is the INTERFACE NAME (`outside`, `inside`), not an
+    optional interface. There is no form without it. That is why this template
+    resolves the nexthop to the interface that reaches it -- and why it needs
+    netlab 0068, which made `nameif` the ZONE rather than the physical port. On
+    the old behaviour every route would have named `GigabitEthernet0/0`.
+  * THERE IS NO Null0. IOS writes a discard route as `ip route ... Null0`; the
+    ASA's nearest equivalent is a route to its own interface address, which
+    blackholes by ARP failure rather than by design. A discard route is
+    therefore REFUSED here rather than silently rendered as something that
+    behaves differently -- see features.routing.static.discard: false.
+  * VRFs arrived only in 9.5+ and are not modelled here at all.
+#}
+{% for sr_data in routing.static|default([]) if 'ipv4' in sr_data %}
 {%   if loop.first %}
 !
 ! Static routes
 !
 {%   endif %}
-{%   set sr_intf = 'Null0' if 'discard' in sr_data.nexthop else sr_data.nexthop.intf %}
-{%   if 'ipv4' in sr_data %}
-route {{ sr_intf }} {{
-    sr_data.ipv4|ansible.utils.ipaddr('network') }} {{
-    sr_data.ipv4|ansible.utils.ipaddr('netmask') }}{{
-    '' if 'discard' in sr_data.nexthop else ' ' + sr_data.nexthop.ipv4 }}
-{%   endif %}
-{%   if 'ipv6' in sr_data %}
-ipv6 route {{ sr_intf }} {{ sr_data.ipv6 }}{{
-    '' if 'discard' in sr_data.nexthop else ' ' + sr_data.nexthop.ipv6 }}
+{%-  set nh = sr_data.nexthop %}
+{%-  set nh_if = namespace(name='') %}
+{#
+   Which interface reaches this next hop? netlab RESOLVES IT ALREADY when the
+   route names a node -- `nexthop.intf` is the local ifname, and the IOS template
+   uses the same field. Prefer that over re-deriving it; fall back to matching
+   the next hop against a connected subnet only when netlab did not resolve one.
+#}
+{%-  if nh.intf is defined %}
+{%-    for l in interfaces|default([]) if l.ifname == nh.intf %}
+{%-      set nh_if.name = (l.firewall|default({})).zone|default(l.ifname) %}
+{%-    endfor %}
+{%-  else %}
+{%-    for l in interfaces|default([]) if 'ipv4' in l and nh.ipv4 is defined %}
+{%-      if l.ipv4|ansible.utils.ipaddr('network') == (nh.ipv4 + '/' + (l.ipv4|ansible.utils.ipaddr('prefix')|string))|ansible.utils.ipaddr('network') %}
+{%-        set nh_if.name = (l.firewall|default({})).zone|default(l.ifname) %}
+{%-      endif %}
+{%-    endfor %}
+{%-  endif %}
+{#
+   DISCARD ROUTES ARE REAL ASA SYNTAX. 0069 refused them, on my assumption that
+   the ASA has no Null0. It does, and the source lab uses it:
+       route Null0 172.21.0.0 255.255.0.0 1
+   That aggregate is the whole reason this platform needs redistribution -- it is
+   what gets advertised, and there is nothing else to advertise it.
+#}
+{%   if 'discard' in nh %}
+route Null0 {{
+  sr_data.ipv4|ansible.utils.ipaddr('network') }} {{
+  sr_data.ipv4|ansible.utils.ipaddr('netmask') }} 1
+{%   elif nh.ipv4 is defined and nh_if.name %}
+route {{ nh_if.name }} {{
+  sr_data.ipv4|ansible.utils.ipaddr('network') }} {{
+  sr_data.ipv4|ansible.utils.ipaddr('netmask') }} {{ nh.ipv4 }}
+{%   else %}
+! SKIPPED static route to {{ sr_data.ipv4 }}: the ASA needs the nameif of the
+! interface that reaches the next hop, and no connected subnet contains {{ nh.ipv4|default('(no ipv4 nexthop)') }}
 {%   endif %}
 {% endfor %}
diff --git a/netsim/ansible/templates/routing/asav.j2 b/netsim/ansible/templates/routing/asav.j2
new file mode 100644
index 0000000..28dd60a
--- /dev/null
+++ b/netsim/ansible/templates/routing/asav.j2
@@ -0,0 +1,17 @@
+{#
+  asav RENDERS THROUGH routing/asa.j2 -- `ansible_network_os: asa` is what
+  selects the template at deploy time, and that is the file with the config in
+  it.
+
+  THIS FILE EXISTS SO THE CATALOG DOES NOT LIE. The device-capability projection
+  (internal/netlabdefaultsgen) decides `renders_config` by stat-ing
+  templates/<module>/<device-ancestor>.j2 walking the device's PARENT CHAIN --
+  and asav has no parent, so it looks for `asav.j2` and never for `asa.j2`.
+  Without this file the catalog reports routing as declared-but-rendering-
+  nothing on asav, which is precisely the "declared-but-unrendered plugin is a
+  silent no-op rather than a capability" case that projection exists to flag.
+  The platform assistant reads that catalog to decide what is authorable.
+
+  services/ keeps an asa.j2 and an asav.j2 side by side for the same reason.
+#}
+{% include 'routing/asa.j2' %}
diff --git a/netsim/devices/asav.yml b/netsim/devices/asav.yml
index 7ffe320..7a5be2c 100644
--- a/netsim/devices/asav.yml
+++ b/netsim/devices/asav.yml
@@ -66,11 +66,52 @@ features:
     error_regexp: "^ERROR: %.*"
     ssh_ready:
       command: show version
+  # ROUTING -- PRIMITIVES ONLY, and the omissions are declarations rather than
+  # oversights. `static` is implemented (routing/asa.j2); policy, prefix lists,
+  # as-path lists and communities are NOT, so a topology that asks for one is
+  # refused by name instead of compiling clean and rendering nothing.
+  #
+  # THE ASA DOES HAVE Null0, and this comment used to say the opposite. 0069
+  # declared discard: false on my assertion that it does not -- reasoning from
+  # IOS rather than from the device -- and 0070 corrected the declaration after
+  # reading the source lab, which writes `route Null0 172.21.0.0 255.255.0.0 1`.
+  # The comment is corrected here too: a note asserting the reverse of the
+  # declaration three lines below it is worse than no note at all.
+  # inter_vrf/vrf: false -- VRFs are not modelled on this platform here.
+  routing:
+    static:
+      vrf: false
+      inter_vrf: false
+      # THE ASA HAS Null0 and the source lab uses it:
+      #   route Null0 172.21.0.0 255.255.0.0 1
+      # 0069 declared this false on my assumption that it does not. Corrected
+      # against the EVE export rather than against my memory.
+      discard: true
+      # upstream #3935: warn on indirect next hops (the ASA route needs an
+      # outgoing interface) and keep one next hop per route
+      caveats: true
+      max_nexthop: 1
+    # PREFIX LISTS RENDER AS STANDARD ACLS here -- the ASA has no prefix-list,
+    # and a route-map matches an ACL by name. Declared so a topology can express
+    # the source's static_to_ospf filter.
+    prefix: true
+    policy:
+      # MATCH ONLY. The `set` attributes are BGP path attributes the ASA does
+      # not offer on a redistribution route-map; declaring them would promise
+      # config that silently does nothing.
+      match:
+        prefix: true
   ospf:
     caveats:
       core: caveats-asav
     unnumbered: false
-    import: [ bgp, connected, static, no_policy ]
+    # REDISTRIBUTION INTO OSPF. demo-lab's jfk-dc-fw01 needs `redistribute static
+    # route-map static_to_ospf` to put the DC's 172.21/16 (a Null0 aggregate, as
+    # in the source lab) into OSPF and from there into OMP. Upstream #3934 added
+    # [ bgp, connected, static, no_policy ]; no_policy is dropped here because
+    # routing/asa.j2 renders the (match-only) route-map and the shared ASA
+    # redistribute macro carries it.
+    import: [ bgp, connected, static ]
     # ospf.default (default-information originate) -- ospf/asa.ospfv2.j2
     # already renders it (always/metric/metric-type). Only the feature flag
     # was missing, so _routing.default_route_adjust rejected it upstream of
@@ -83,11 +124,6 @@ features:
     priority: true
     timers: true
   nat: true
-  routing:
-    static:
-      caveats: true
-      discard: true
-      max_nexthop: 1
 libvirt:
   image: cisco/asav
   create_template: asav.xml.j2
-- 
2.56.0

