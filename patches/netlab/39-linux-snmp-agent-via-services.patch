From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sat, 3 Oct 2026 12:00:00 +0000
Subject: [PATCH] linux: SNMP agent through the services module
 (services.server.snmp), like every other NOS

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/netsim/ansible/templates/services/linux.j2 b/netsim/ansible/templates/services/linux.j2
index 32a2b67..3af375a 100644
--- a/netsim/ansible/templates/services/linux.j2
+++ b/netsim/ansible/templates/services/linux.j2
@@ -1,2 +1,40 @@
 #!/bin/sh
+{#
+  SKYFORGE-SPECIFIC (patch 39): the SNMP agent of a linux host, delivered like the services of every other NOS.
+
+  `services.server.snmp` is set on every node by the platform defaults (community `skyforge`, the community
+  the collector's collectors poll with), so a linux host answers SNMP exactly like a cEOS does. A node opts out with
+  `services.server.snmp: false`. A linux image without net-snmp (any non-Skyforge image) is skipped with a note,
+  never an error: the services script must not fail a lab over a missing optional daemon.
+
+  The script runs inside the pod (the linux namespace-exec lane) at day 0 AND again on every warm reconfigure,
+  so it is idempotent: it rewrites the config and signals a running snmpd to reload instead of starting a second
+  one. The community lives only in the 0600 config file; the script never prints it.
+#}
 # Syslog configuration comes here (eventually)
+{% if services.server.snmp is defined %}
+if command -v snmpd >/dev/null 2>&1; then
+  mkdir -p /etc/snmp /var/log
+  ( umask 077
+    {
+      echo "agentAddress udp:161"
+      echo "rocommunity {{ services.server.snmp.community|default('skyforge') }} default"
+      echo "sysName $(hostname)"
+      echo "sysDescr Skyforge linux host (skyforge-linux-host)"
+{%   if services.server.snmp.location is defined %}
+      echo "sysLocation {{ services.server.snmp.location }}"
+{%   endif %}
+{%   if services.server.snmp.contact is defined %}
+      echo "sysContact {{ services.server.snmp.contact }}"
+{%   endif %}
+      echo "dontLogTCPWrappersConnects yes"
+    } > /etc/snmp/snmpd.conf )
+  if [ -s /run/snmpd.pid ] && kill -0 "$(cat /run/snmpd.pid)" 2>/dev/null; then
+    kill -HUP "$(cat /run/snmpd.pid)"
+  else
+    snmpd -C -c /etc/snmp/snmpd.conf -p /run/snmpd.pid -Lf /var/log/snmpd.log
+  fi
+else
+  echo "services: snmpd is not installed in this image; SNMP agent not started" >&2
+fi
+{% endif %}
diff --git a/netsim/devices/linux.yml b/netsim/devices/linux.yml
index 683b849..fda0c1b 100644
--- a/netsim/devices/linux.yml
+++ b/netsim/devices/linux.yml
@@ -26,6 +26,7 @@ features:
   services:
     dns:
       transport_vrf: false
+    server.snmp: True              # Skyforge: patch 39, services/linux.j2 (net-snmp in the skyforge-linux-host image)
 libvirt:
   image: bento/ubuntu-24.04
   create_image: netlab/linux
diff --git a/tests/test_kne_provider.py b/tests/test_kne_provider.py
index 9ecbcdc..da3462c 100644
--- a/tests/test_kne_provider.py
+++ b/tests/test_kne_provider.py
@@ -1861,6 +1861,60 @@ nodes:
   assert 'SKYFORGE_CALDERA' not in _node_block(text,'h1')
 
 
+def _linux_services_script(tmp_path: Path, node_yaml: str) -> str:
+  topo_file = write_topology(tmp_path,f"""
+provider: kne
+module: [ services ]
+
+nodes:
+  h1:
+    device: linux
+{node_yaml}
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+  return Path('node_files/h1/services').read_text()
+
+
+def test_kne_linux_services_script_configures_snmpd_read_only(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  text = _linux_services_script(tmp_path,"""    services:
+      server:
+        snmp: { community: lab-ro-7, location: "rack 3" }
+""")
+  assert text.startswith('#!/bin/sh')
+  assert 'rocommunity lab-ro-7 default' in text
+  assert 'sysLocation rack 3' in text
+  assert 'sysName $(hostname)' in text and 'Skyforge linux host' in text
+  assert 'agentAddress udp:161' in text
+  assert 'rwcommunity' not in text and 'rwuser' not in text and 'createUser' not in text
+  assert 'umask 077' in text                          # the config carrying the community is not world-readable
+  # idempotent on a warm reconfigure: reload a running daemon, start one otherwise
+  assert 'kill -HUP' in text and 'snmpd -C -c /etc/snmp/snmpd.conf' in text
+  # the community is written to the file and never echoed to the console
+  assert text.count('lab-ro-7') == 1
+  # a missing daemon is a note, not a failure
+  assert 'command -v snmpd' in text and 'not installed' in text
+
+
+def test_kne_linux_snmp_default_is_the_forward_community(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  text = _linux_services_script(tmp_path,"""    services:
+      server:
+        snmp: true
+""")
+  assert 'rocommunity skyforge default' in text
+
+
+def test_kne_linux_snmp_can_be_disabled_per_node(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  text = _linux_services_script(tmp_path,"""    services:
+      server:
+        snmp: false
+""")
+  assert 'snmpd' not in text and 'rocommunity' not in text
+
+
 def test_kne_ioll2_uses_distinct_image_contract(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
   monkeypatch.chdir(tmp_path)
   topo_file = write_topology(tmp_path,"""
