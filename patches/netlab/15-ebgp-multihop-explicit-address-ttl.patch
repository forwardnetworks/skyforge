+      intf.bgp.multihop = session_ttl
       if 'vrf' in intf:
         intf.bgp._vrf = intf.vrf
       intf._mh_bgp_session = True
-      intf._phantom_link = True
-      intf.ifname = f'_ebgp_multihop_{s.linkindex}'
 
   topology.links.extend(sessions)
 
@@ -191,7 +235,38 @@ def fix_vrf_loopbacks(ndata: Box, topology: Box) -> None:
       ngb._source_intf = lb
 
     else:
-      ngb._source_intf = ndata.loopback
+      src_intf = multihop_source_interface(ndata,ngb)
+      if src_intf is not None:
+        ngb._source_intf = src_intf
+      # An explicit session address that no interface owns: leave update-source alone
+
+'''
+multihop_source_interface -- the interface a multihop session is sourced from
+
+* Loopback (as always) for a session built from the node loopback
+* For an explicit session address, the node interface that owns that address
+  (or None if no interface does -- the device will pick its egress interface)
+'''
+def multihop_source_interface(ndata: Box, ngb: Box) -> typing.Optional[Box]:
+  phantom = [ intf for intf in ndata.interfaces if intf.get('ifindex',None) == ngb.get('ifindex',None) ]
+  if not phantom or not phantom[0].get('_mh_explicit',False):
+    return ndata.loopback
+
+  for af in ('ipv4','ipv6'):
+    if af not in phantom[0]:
+      continue
+    addr = ipaddress.ip_interface(phantom[0][af]).ip
+    for intf in ndata.interfaces:
+      if intf.get('_phantom_link',False) or not isinstance(intf.get(af,None),str):
+        continue
+      if ipaddress.ip_interface(intf[af]).ip == addr:
+        return intf
+  if 'loopback' in ndata:
+    for af in ('ipv4','ipv6'):
+      if af in phantom[0] and isinstance(ndata.loopback.get(af,None),str) and \
+         ipaddress.ip_interface(ndata.loopback[af]).ip == ipaddress.ip_interface(phantom[0][af]).ip:
+        return ndata.loopback
+  return None
 
 '''
 post_transform processing:
@@ -204,8 +279,26 @@ def post_transform(topology: Box) -> None:
   global _config_name
   for ndata in topology.nodes.values():
     if ebgp_multihop_sessions(ndata,topology):
+      set_local_multihop(ndata)
       fix_vrf_loopbacks(ndata,topology)
 
+'''
+set_local_multihop -- a neighbor's TTL comes from the LOCAL session endpoint
+
+The BGP module copies the REMOTE endpoint's bgp.* interface attributes into the neighbor
+(build_ebgp_sessions: extra_data = ngb_ifdata.bgp + extra_data). For a two-sided session both
+endpoints carry the same bgp.multihop, so nobody noticed. A one-sided session's remote endpoint
+is `bgp: False` and carries nothing, so the local TTL has to come from the local phantom
+interface -- which is where this plugin put it.
+'''
+def set_local_multihop(ndata: Box) -> None:
+  for ngb in _bgp.neighbors(ndata,vrf=True,select=['ebgp','localas_ibgp']):
+    if 'multihop' in ngb:
+      continue
+    for intf in ndata.interfaces:
+      if intf.get('_mh_bgp_session',False) and intf.get('ifindex',None) == ngb.get('ifindex',None):
+        ngb.multihop = intf.bgp.multihop
+
 '''
 Cleanup: remove interfaces and links with _phantom_link flag
