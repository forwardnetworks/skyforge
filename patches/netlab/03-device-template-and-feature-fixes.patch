diff --git a/netsim/ansible/templates/vlan/iosxr.j2 b/netsim/ansible/templates/vlan/iosxr.j2
new file mode 100644
index 0000000..9ee7b26
--- /dev/null
+++ b/netsim/ansible/templates/vlan/iosxr.j2
@@ -0,0 +1,21 @@
+{#
+   Routed VLANs on IOS XRv / XRd.
+
+   The device declares no svi_interface_name, so the vlan module has already
+   rejected every bridged or IRB VLAN before this template renders: XRd
+   Control Plane forwards through an L3-only Linux dataplane with no L2VPN
+   bridge-domains. What is left is:
+
+   * a routed access VLAN on a physical interface -- the interface keeps the
+     VLAN's IP address (rendered by the initial template) and needs nothing
+     from here;
+   * a routed VLAN on a trunk -- a dot1q subinterface whose addresses the
+     initial template renders; this template supplies the encapsulation.
+
+   Mirrors the routed half of vlan/cisco8000v.j2.
+#}
+{% for ifdata in interfaces if ifdata.vlan.access_id is defined and ifdata.type == 'vlan_member' %}
+interface {{ ifdata.ifname }}{{ ifdata._xr_native_subif|default('') }}
+ encapsulation dot1Q {{ ifdata.vlan.access_id }}
+!
+{% endfor %}
