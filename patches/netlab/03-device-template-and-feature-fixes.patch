+++ b/netsim/providers/clab.yml
@@ -65,6 +65,13 @@ attributes:
       restart-policy: str
       network-mode: str
       exec: { type: list, _subtype: str }
+      # SR OS emulates a chassis, so its card/MDA layout is data, not an image
+      # property: devices/sros.yml sets clab.node.hardware and the vr-sros
+      # startup template renders it. _keys is an EXPLICIT allowlist -- an
+      # attribute the device defaults set but this list omits is rejected as
+      # "Incorrect node attribute 'hardware' in nodes.<n>.clab", so declaring
+      # it here is what makes the device default legal at all.
+      hardware: list
   interface:
     name: str
   link:
