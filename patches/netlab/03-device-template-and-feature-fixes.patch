@@ -12,7 +21,15 @@ no cdp run
 {% if services.dns._no_hosts is not defined %}
 {%   for hname,hdata in hosts.items() if hname != inventory_hostname %}
 {%     set ipv6_addr = hdata.ipv6|default([]) if netlab_device_type not in ['iosvl2','ioll2'] else [] %}
-{%     set addr_list = hdata.ipv4|default([]) + ipv6_addr %}
+{#     IOS/IOLL2: one address per family only. A multi-address 'ip host' line is
+       rejected on these platforms and fails the whole initial config. #}
+{%     set addr_list = [] %}
+{%     if hdata.ipv4 is defined and hdata.ipv4 %}
+{%       set addr_list = addr_list + [ hdata.ipv4[0] ] %}
+{%     endif %}
