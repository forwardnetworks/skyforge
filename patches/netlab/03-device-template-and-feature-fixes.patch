 {%     endif %}
@@ -35,6 +52,17 @@ no ipv6 unicast-routing
 {% include 'ios.vrf.j2' +%}
 !
 {% endif %}
+{% if netlab_device_type in ['ios','iosvl2','csr','iol','ioll2','cat8000v'] %}
+{# The name is a device group var (netlab_mgmt_vrf) so the services templates can put the
+   syslog host and flow exporter in the same VRF; the literal stays as the fallback for
+   platforms that never declared it. #}
+vrf definition {{ netlab_mgmt_vrf|default('MGMT') }}
+ description Management interface
+ !
+ address-family ipv4
+ exit-address-family
+!
+{% endif %}
 {% if vlans is defined %}
 {% include [ netlab_device_type ~ '.vlan.j2', 'ios.vlan.j2' ] +%}
 !
@@ -50,9 +78,50 @@ interface {{ loopback.ifname }}
 {%   endif %}
 {% endif %}
 !
-interface {{ mgmt.ifname|default('GigabitEthernet0/0') }}
+{# No `|default()`: mgmt.ifname is resolved by netlab per device AND provider (eos: Management1
+   at device level, Management0 in the clab block), and a plausible-but-wrong literal is only
+   discovered when the device refuses it at line 1 of `configure replace`. The name is NOT
+   filtered with `mandatory` either: that is an ANSIBLE filter and this file is also rendered
+   by netlab's own Jinja env, which has no such filter. Both envs use a strict Undefined, so a
+   bare {{ mgmt.ifname }} already fails at render when it is unset. #}
+interface {{ mgmt.ifname }}
  no lldp transmit
  no lldp receive
+{# ORDER MATTERS ON THE L2 IMAGE. A switchport rejects `vrf forwarding`; on ioll2 (and
+   iosvl2) the port must be routed FIRST. With the VRF line ahead of `no switchport` the
+   binding was silently dropped and Ethernet0/0 stayed in the global table -- which nobody
+   noticed while only inbound SSH/SNMP used it, and which surfaced the moment the exporter
+   said `destination ... vrf MGMT` (demo-lab lhr-acc-sw01, 2026-09-12: config carried
+   the route and the VRF, `show run int e0/0` had no vrf forwarding, exporter "No FIB"). #}
+{% if netlab_device_type in ['ioll2','iosvl2'] %}
+ no switchport
+{% endif %}
+{# cat8000v IS in this list (since 2026-09-14). With Gi1 in the GLOBAL table the DHCP default
+   (AD 254) loses to any default the LAB hands the router -- an ISP's default-originate, an
+   iBGP default from the RR (AD 200), an OSPF default -- and the reply to every management SSH
+   SYN leaves through the data plane instead of back to the masquerade gateway. Measured
+   2026-09-14 on a 9-node c8000v lab: exactly the five nodes that learned a BGP default timed
+   out on :22 (guest healthy, Gi1 up with 10.0.2.2, sshd LISTENing). Same fault the collector saw as
+   CONNECTION_TIMEOUT on a hackweek lab. iol/csr were always in the VRF; the controller-mode
+   edge boothook uses Mgmt-intf; autonomous c8000v was the one IOS shape left in the global
+   table. #}
+{% if netlab_device_type in ['ios','iosvl2','csr','iol','ioll2','cat8000v'] %}
+ vrf forwarding {{ netlab_mgmt_vrf|default('MGMT') }}
+{% endif %}
+{% if netlab_device_type in ['iol','ioll2'] %}
+ ip address 169.254.100.2 255.255.255.252
+ no shutdown
+{% endif %}
+{% if netlab_device_type == 'cat8000v' %}
+{# On the native KubeVirt lane nobody else configures management. vrnetlab's
+   launch.py used to DHCP GigabitEthernet1 before the NOS ever saw traffic;
+   without this stanza the CVAC-applied day-0 leaves Gi1 unassigned and
+   administratively down, the masquerade DNAT has no backend, and every
+   c8000v is unreachable on :22 -- the collector reports CONNECTION_TIMEOUT on a
+   fully configured router. KubeVirt masquerade serves 10.0.2.2 via DHCP. #}
+ ip address dhcp
+ no shutdown
+{% endif %}
 !
 {% for l in interfaces|default([]) %}
 interface {{ l.ifname }}
@@ -148,8 +217,16 @@ interface {{ l.ifname }}
 !
 {{ extra_module_initial(['dhcp']) }}
 !
+line con 0
+ exec-timeout 0 0
+ privilege level 15
+!
 line vty 0 4
  exec-timeout 0 0 
+ length 0
+ privilege level 15
+ login local
+ transport input ssh
 !
 no banner exec
 no banner login
