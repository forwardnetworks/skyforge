From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:00 +0000
Subject: [PATCH] utils/filters: sha512_crypt for Junos encrypted passwords

---
diff --git a/netsim/utils/filters.py b/netsim/utils/filters.py
index 619bad8..a09abb0 100644
--- a/netsim/utils/filters.py
+++ b/netsim/utils/filters.py
@@ -11,6 +11,7 @@
 # identifies them as Jinja2 filters
 #
 
+import re
 import typing
 
 import netaddr
@@ -191,10 +192,51 @@ def bi_merge(d1: typing.Any, d2: typing.Any) -> dict:
   result = get_box(d1) + get_box(d2)
   return result.to_dict()
 
+"""
+sha512crypt a value for a Junos-style `encrypted-password` directive.
+
+Skyforge-specific: this renderer registers only a hand-picked filter set (see
+BUILTIN_FILTERS below), not ansible-playbook's full filter_plugins path, so
+Ansible's own `password_hash` filter is NOT available here even though
+passlib is installed in the runtime image. vSRX day-0
+(initial/vsrx.j2) needs one: that image boots into Junos FIPS mode
+unconditionally, and FIPS-mode Junos accepts `plain-text-password-value` at
+commit but never produces a working login from it -- proven live and
+reproduced on a bare factory image outside Skyforge entirely. rounds
+defaults to 5000 (glibc's traditional sha512crypt count) so passlib omits
+the `$6$rounds=N$` segment, matching the exact wire shape verified working;
+raising rounds changes the shape and would need its own verification.
+"""
+# crypt's salt alphabet is exactly [./0-9A-Za-z] (glibc crypt(3), POSIX). A
+# netlab inventory_hostname routinely contains '-' (every demo-lab node:
+# "atl-bldg2-fw02") or '_', neither of which is valid -- passlib raises
+# "invalid characters in sha512_crypt salt" rather than silently coping.
+# Measured 2026-09-16: this exact filter passed on node "fw1" (clean, no
+# fix needed) and failed netlab create outright on "atl-bldg2-fw02" the
+# first time it was asked to render a realistic hostname -- one example is
+# not the distribution. Sanitize by mapping every invalid character to '.'
+# (itself a valid salt character): deterministic, always valid, and still
+# distinct per differing hostname for this filter's actual purpose (a
+# stable salt so re-renders of the same node do not look like a password
+# change), not a security boundary.
+_SHA512_CRYPT_SALT_INVALID = re.compile(r'[^./0-9A-Za-z]')
+
+def bi_sha512_crypt(secret: typing.Any, salt: str = '', rounds: int = 5000) -> str:
+  try:
+    from passlib.hash import sha512_crypt
+  except ImportError as exc:                    # name the dependency at the point of use:
+    raise RuntimeError(                         # a bare ModuleNotFoundError surfaces as an
+      "the sha512_crypt template filter needs the 'passlib' package "
+      "(pip install passlib); it hashes Junos encrypted-password values") from exc
+  salt = _SHA512_CRYPT_SALT_INVALID.sub('.', salt) if salt else salt
+  scheme = sha512_crypt.using(rounds=rounds, salt=salt) if salt else sha512_crypt.using(rounds=rounds)
+  return scheme.hash(str(secret))
+
 BUILTIN_FILTERS: dict = {
   'combine': bi_merge,
   'difference': bi_difference,
   'flatten': bi_flatten,
   'to_yaml': bi_yaml,
-  'to_nice_yaml': bi_yaml
+  'to_nice_yaml': bi_yaml,
+  'sha512_crypt': bi_sha512_crypt
 }
-- 
