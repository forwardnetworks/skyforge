+# ---------------------------------------------------------------------------
+# THE SERVICE SIDE RENDERED, per site protocol, against the shapes demo-lab
+# runs: EIGRP at JFK (the edge speaks EIGRP 16 to the core), OSPF + iBGP
+# behind two reflectors at LHR, OSPF alone at CDG / JFK-DC. These render the
+# very template the manager's lane renders (sdwan_service_vpn.cli.j2) from the
+# intent the module derived, and assert on the EMITTED overlay.
+# ---------------------------------------------------------------------------
+import importlib.util
+import jinja2
+
+LANE_DIR = Path(__file__).resolve().parent.parent / "netsim" / "ansible" / "tasks" / "cisco_sdwan-manager"
+
+
+def render_overlay(edge: Box) -> str:
+  env = jinja2.Environment(loader=jinja2.FileSystemLoader(str(LANE_DIR / "templates")), trim_blocks=True, lstrip_blocks=True)
+  # The lane hands the template a plain dict (JSON round-trip), where an absent
+  # key is `undefined`, not an empty Box. Render the same way.
+  return env.get_template("sdwan_service_vpn.cli.j2").render(edge=edge.to_dict())
+
+
+def lane_helper():
+  spec = importlib.util.spec_from_file_location("sdwan_service_vpn", LANE_DIR / "files" / "sdwan_service_vpn.py")
+  mod = importlib.util.module_from_spec(spec)
+  spec.loader.exec_module(mod)
+  return mod
+
+
+EIGRP_SITE_YAML = """
+provider: kne
+sdwan:
+  organization: lab
+
+nodes:
+  transport:
+    device: iol
+  vmanage:
+    device: cisco_sdwan-manager
+    module: [ sdwan ]
+    sdwan: { type: manager, site_id: 1, system_ip: 10.255.2.1 }
+  vsmart:
+    device: cisco_sdwan-controller
+    module: [ sdwan ]
+    sdwan: { type: controller, site_id: 1, system_ip: 10.255.1.1 }
+  core:
+    device: ioll2
+    module: [ eigrp ]
+    eigrp.as: 16
+  fw:
+    device: iol
+  edge1:
+    device: cat8000v
+    module: [ sdwan, eigrp ]
+    eigrp.as: 16
+    sdwan:
+      type: controller
+      site_id: 101
+      system_ip: 10.255.0.101
+      service_vpn: 200
+  # The validator every Viptela day-0 points at (`vbond <addr>`); the module
+  # refuses a Cisco fabric without one, by name. Listed after the nodes whose
+  # inventory order the assertions rely on.
+  vbond:
+    device: cisco_sdwan-validator
+    module: [ sdwan ]
+
+links:
+- vmanage:
+  transport:
+  sdwan.role: transport
+- vsmart:
+  transport:
+  sdwan.role: transport
+- edge1:
+  transport:
+  sdwan.role: transport
+- vbond:
+  transport:
+  sdwan.role: transport
+- [ edge1, core ]
+- edge1:
+    eigrp: false
+  fw:
+"""
+
+
+def test_sdwan_service_vpn_eigrp_site_renders_named_mode_from_the_eigrp_module(tmp_path: Path) -> None:
+  topology = load_transform(write_topology(tmp_path, EIGRP_SITE_YAML))
+  edge = topology.nodes.edge1
+  svc = edge.sdwan.service
+
+  # The AS and the interface facts are netlab's eigrp module's, not literals.
+  assert svc.eigrp["as"] == 16 and svc.eigrp.redistribute_omp is True
+  assert svc.omp.advertise == [ "connected", "static", "eigrp" ]
+  to_core = next(i for i in svc.interfaces if i.neighbors == [ "core" ])
+  to_fw = next(i for i in svc.interfaces if i.neighbors == [ "fw" ])
+  assert "eigrp" in to_core and "eigrp" not in to_fw           # eigrp: false took it out of the process
+  assert "eigrp" in svc.loopback                                 # the loopback is in, as on every netlab router
+  assert "router eigrp sdwan" in [ "/".join(p) for p in svc.owned_blocks ]
+
+  # THE EMITTED OVERLAY: named mode, VRF address family under the module's AS,
+  # OMP redistributed with a composite metric, network statements for exactly
+  # the interfaces that carry eigrp, and the OMP side advertising eigrp.
+  cfg = render_overlay(topology.nodes.vmanage.sdwan.onboarding.edges[0])
+  assert "router eigrp sdwan\n address-family ipv4 unicast vrf 200 autonomous-system 16\n" in cfg
+  assert "   redistribute omp metric 1000000 100 255 1 1500\n" in cfg
+  assert f"  network {to_core.address} 0.0.0.0\n" in cfg
+  assert f"  network {svc.loopback.address} 0.0.0.0\n" in cfg
+  assert f"  network {to_fw.address} 0.0.0.0\n" not in cfg
+  assert f"interface {to_fw.ifname}\n" in cfg and "vrf forwarding 200" in cfg   # ...but it IS in the VRF
+  assert "   advertise eigrp\n" in cfg
+  assert "router ospf" not in cfg and "router bgp" not in cfg
+
+  # THE FAR END AGREES: the core runs EIGRP 16 with a network statement on the
+  # very address the edge peers with, so the adjacency the overlay expects
+  # has a partner on the site.
+  core = topology.nodes.core
+  core_link = next(i for i in core.interfaces if any(n.node == "edge1" for n in i.neighbors))
+  assert core.eigrp["as"] == 16 and "eigrp" in core_link
+  assert core_link.ipv4.split("/")[0] != to_core.address
+  assert ipaddress_network(core_link.ipv4) == ipaddress_network(to_core.ipv4)
+
+
+def ipaddress_network(cidr: str) -> str:
+  import ipaddress
+  return str(ipaddress.ip_interface(cidr).network)
+
+
+def test_sdwan_service_vpn_ibgp_client_is_sourceable_from_the_vrf_loopback(tmp_path: Path) -> None:
+  # LHR's shape: an iBGP client of a reflector, OSPF between them. The source
+  # lab peers the vEdge to the reflectors' link addresses; netlab's iBGP
+  # primitive rides loopbacks. That is sourceable only if the loopback the
+  # session is sourced from lives IN the service VRF and the IGP carries it
+  # -- otherwise `update-source Loopback0` in `address-family ipv4 vrf 200`
+  # names an interface in another table and the session never forms.
+  topology = load_transform(write_topology(tmp_path, SERVICE_SIDE_YAML))
+  edge = topology.nodes.vmanage.sdwan.onboarding.edges[0]
+  svc = edge.service
+  cfg = render_overlay(edge)
+
+  for n in svc.bgp.neighbors:
+    assert n.type == "ibgp" and n.update_source == svc.loopback.ifname
+    assert f"  neighbor {n.ipv4} update-source {svc.loopback.ifname}\n" in cfg
+  # The loopback is an OWNED block of the overlay, in the VRF, in OSPF area 0:
+  lo = cfg.split(f"interface {svc.loopback.ifname}\n", 1)[1].split("!\n", 1)[0]
+  assert " vrf forwarding 200\n" in lo and f" ip address {svc.loopback.address} 255.255.255.255\n" in lo
+  assert f" ip ospf {svc.ospf.process} area {svc.loopback.ospf.area}\n" in lo
+  assert [ f"interface {svc.loopback.ifname}" ] in svc.owned_blocks
+  # ...and the reflector on the far end sources ITS side from its loopback and
+  # carries the edge's loopback in the same OSPF area, so both ends can reach
+  # each other's source address.
+  rr = topology.nodes.rr
+  rr_session = next(n for n in rr.bgp.neighbors if n.name == "edge1")
+  assert rr_session.type == "ibgp" and rr_session.ipv4 == svc.loopback.address
+  rr_link = next(i for i in rr.interfaces if any(n.node == "edge1" for n in i.neighbors))
+  assert str(rr.loopback.ospf.area) == svc.loopback.ospf.area and str(rr_link.ospf.area) == svc.interfaces[0].ospf.area
+  # The seam is BGP both ways; OSPF stays intra-area with no seam.
+  assert "  redistribute omp\n" in cfg.split("router bgp", 1)[1]
+  assert "redistribute omp" not in cfg.split("router ospf", 1)[1].split("!\n", 1)[0]
+  assert "   advertise bgp\n" in cfg and "advertise ospf external" not in cfg
+
+
+def test_sdwan_service_vpn_ospf_site_redistributes_both_ways(tmp_path: Path) -> None:
+  # CDG / JFK-DC's shape: OSPF alone. OMP into OSPF on the edge, OSPF external
+  # into OMP (intra-area is advertised by default), area and network type on
+  # the interface as the link declares them.
+  yaml = SERVICE_SIDE_YAML.replace("module: [ sdwan, ospf, bgp ]\n    bgp.as: 65001\n", "module: [ sdwan, ospf ]\n")
+  yaml = yaml.replace("- [ edge1, rr ]\n", "- edge1:\n    ospf.network_type: broadcast\n  rr:\n    ospf.network_type: broadcast\n")
+  topology = load_transform(write_topology(tmp_path, yaml))
+  edge = topology.nodes.vmanage.sdwan.onboarding.edges[0]
+  cfg = render_overlay(edge)
+  ospf = cfg.split("router ospf 200 vrf 200\n", 1)[1].split("!\n", 1)[0]
+  assert " redistribute omp\n" in ospf
+  assert "   advertise ospf external\n" in cfg
+  site = next(i for i in edge.service.interfaces if i.neighbors == [ "rr" ])
+  block = cfg.split(f"interface {site.ifname}\n", 1)[1].split("!\n", 1)[0]
+  assert " ip ospf 200 area 0.0.0.0\n" in block and " ip ospf network broadcast\n" in block
+  far = next(i for i in topology.nodes.rr.interfaces if any(n.node == "edge1" for n in i.neighbors))
+  assert far.ospf.network_type == "broadcast" and str(far.ospf.area) == site.ospf.area
+
+
+def test_sdwan_service_readback_judges_both_witnesses() -> None:
+  # The lane's helper decides `routed` from the CONTROLLER's table, asked per
+  # expected prefix, and names the failing witness. Offline, with the same
+  # fakes the helper's own self-test uses, plus the shapes that cost demo-lab
+  # three runs: a windowed controller table and a refused query parameter.
+  h = lane_helper()
+  assert h.selftest()["selftest"] == "ok"
+
+  expected = [ "10.0.0.42/32", "10.1.0.56/30" ]
+  ok = h.judge_routing(expected, { "10.0.0.42/32", "10.1.0.56/30" }, { "10.0.0.42/32": "connected", "10.1.0.56/30": "connected" }, [ "10.255.1.1:vsmart:up" ])
+  assert ok["routed"] is True and ok["reason"] == ""
+  # The controller's window shows five other prefixes: not routed, and the
+  # reason says the edge DID advertise -- so the next look goes to the
+  # controller, not the edge.
+  sent = h.judge_routing(expected, set(), { p: "connected" for p in expected }, [ "10.255.1.1:vsmart:up" ])
+  assert sent["routed"] is False and sent["missing"] == expected and "controller's received table" in sent["reason"]
+  # The edge advertises nothing and its OMP peer is down: the reason says so.
+  silent = h.judge_routing(expected, set(), {}, [ "10.255.1.1:vsmart:down" ])
+  assert silent["not_advertised"] == expected and "no OMP peer is up" in silent["reason"]
+
+  class Window:
+    """vManage that honours vpn-id but not prefix, and windows the bare query to 5 rows."""
+    def __init__(self) -> None:
+      self.urls: list = []
+    def get_data(self, url: str) -> list:
+      self.urls.append(url)
+      if "prefix=" in url:
+        raise RuntimeError("400 Bad Request")
+      table = [ { "vpn-id": "200", "prefix": f"10.0.0.{i}/32", "originator": "10.255.0.100" } for i in (4, 5, 6, 7, 10) ]
+      table += [ { "vpn-id": "200", "prefix": p, "originator": "10.255.0.101" } for p in expected ]
+      return table if "vpn-id=" in url else table[:5]
+  fake = Window()
+  rows, how, errs = h._omp_rows(fake, "routes/received", "10.255.1.1", 200, expected[0])
+  assert how == "vpn" and errs and "400" in errs[0]
+  assert h._routes_from(rows, "10.255.0.101", 200) == set(expected)
+  # NEGATIVE CONTROL: the bare window alone would have missed both.
+  assert h._routes_from(fake.get_data("/x?deviceId=10.255.1.1"), "10.255.0.101", 200) == set()
+
+
+def test_sdwan_service_readback_reports_both_witnesses_end_to_end(monkeypatch) -> None:
+  # The whole read-back, offline: vManage windows the controller's table to
+  # five rows and honours vpn-id but not prefix; edge A advertises its
+  # prefixes, edge B's OMP peer is down. A must come back ROUTED-able within
+  # one attempt, B PUSHED-but-not-routed with the reason naming the peer, and
+  # the poll must stop at the budget, not before B had its chance.
+  h = lane_helper()
+  expected_a = [ "10.0.0.62/32", "10.1.0.208/30" ]
+  expected_b = [ "10.0.0.42/32" ]
+
+  class Session:
+    def __init__(self) -> None:
+      self.urls: list = []
+    def get_data(self, url: str) -> list:
+      self.urls.append(url)
+      if "prefix=" in url:
+        raise RuntimeError("400 Bad Request: prefix")
+      if "/omp/peers" in url:
+        if "deviceId=10.255.0.103" in url:
+          return [ { "peer": "10.255.1.1", "type": "vsmart", "state": "up" } ]
+        return [ { "peer": "10.255.1.1", "type": "vsmart", "state": "down" } ]
+      if "/routes/advertised" in url:
+        if "deviceId=10.255.0.103" in url:
+          return [ { "vpn-id": "200", "prefix": p, "protocol": "connected", "to-peer": "10.255.1.1" } for p in expected_a ] + \
+                 [ { "vpn-id": "200", "prefix": "10.0.0.54/32", "protocol": "bgp", "to-peer": "10.255.1.1" } ]
+        return []
+      # the controller's received table: many low site prefixes, then A's
+      table = [ { "vpn-id": "200", "prefix": f"10.0.0.{i}/32", "originator": "10.255.0.100" } for i in (4, 5, 6, 7, 10) ]
+      table += [ { "vpn-id": "200", "prefix": p, "originator": "10.255.0.103" } for p in expected_a ]
+      return table if "vpn-id=" in url else table[:5]
+    def close(self) -> None:
+      pass
+
+  session = Session()
+  monkeypatch.setattr(h, "_session", lambda creds: session)
+  monkeypatch.setattr(h, "_find_device", lambda s, e: object())
+  monkeypatch.setattr(h, "_device_facts", lambda d: { "hostname": "x" })
+  monkeypatch.setattr(h, "_running_config", lambda s, d: "vrf definition 200\n rd 1:200\n!\nrouter bgp 65023\n!\n")
+  slept: list = []
+  monkeypatch.setattr(h.time, "sleep", lambda n: slept.append(n))
+
+  doc = h.readback({
+    "credentials": {}, "controller_system_ips": [ "10.255.1.1" ], "poll_seconds": 1, "poll_interval": 15,
+    "edges": [
+      { "name": "lhr", "chassis": "A", "system_ip": "10.255.0.103", "vpn": 200, "owned_blocks": [ [ "vrf definition 200" ], [ "router bgp 65023" ] ], "expect_prefixes": expected_a },
+      { "name": "jfk", "chassis": "B", "system_ip": "10.255.0.101", "vpn": 200, "owned_blocks": [ [ "vrf definition 200" ] ], "expect_prefixes": expected_b },
+    ],
+  })
+  by = { e["name"]: e for e in doc["edges"] }
+  a, b = by["lhr"], by["jfk"]
+  assert a["config_ok"] and b["config_ok"]
+  assert a["omp"]["routed"] is True and a["omp"]["seen"] == expected_a and a["omp"]["advertised"] == expected_a
+  assert a["omp"]["site_prefixes"] == [ "10.0.0.54/32(bgp)" ] and a["omp"]["peers"] == [ "10.255.1.1:vsmart:up" ]
+  assert a["omp"]["controller_query"] == "vpn" and any("400" in e for e in a["omp"]["errors"])
+  assert b["omp"]["routed"] is False and b["omp"]["not_advertised"] == expected_b
+  assert "no OMP peer is up" in b["omp"]["reason"] and "10.255.1.1:vsmart:down" in b["omp"]["reason"]
+  # Polled to the budget for B (config landed, never routed), then stopped.
+  assert b["omp"]["attempts"] >= 2 and slept, (b["omp"]["attempts"], slept)
+  # Every controller read was narrowed at least to the VPN -- never the bare window.
+  received = [ u for u in session.urls if "/routes/received" in u ]
+  assert received and all("vpn-id=200" in u for u in received), received
+
+
+# ---------------------------------------------------------------------------
+# DAY-0 CARRIES THE SNMP AGENT INSIDE THE BOOTHOOK. The KNE provider appends
+# every module fragment (services, routing, ...) AFTER the closing MIME
+# boundary of the CVAC document, where the appliance never reads it -- so the
+# services module's `snmp-server community` never reached a controller-mode
+# edge (measured on demo-lab 2026-09-12: all four cat8000v edges silent on 161).
+# This renders the edge's real startup-config and asserts on POSITION, not
+# presence: the line the boothook owns comes before `--==BOUNDARY==--`.
+# ---------------------------------------------------------------------------
+SNMP_EDGE_YAML = """
+provider: kne
+sdwan:
+  organization: lab
+
+groups:
+  all:
+    module: [ services ]
+    services:
+      server:
+        snmp:
+          community: skyforge
+
+nodes:
+  transport:
+    device: iol
+  vmanage:
+    device: cisco_sdwan-manager
+    module: [ sdwan ]
+    sdwan: { type: manager, site_id: 1, system_ip: 10.255.2.1 }
+  vsmart:
+    device: cisco_sdwan-controller
+    module: [ sdwan ]
+    sdwan: { type: controller, site_id: 1, system_ip: 10.255.1.1 }
+  edge1:
+    device: cat8000v
+    module: [ sdwan ]
+    sdwan:
+      type: controller
+      site_id: 101
+      system_ip: 10.255.0.101
+  vbond:
+    device: cisco_sdwan-validator
+    module: [ sdwan ]
+
+links:
+- vmanage:
+  transport:
+  sdwan.role: transport
+- vsmart:
+  transport:
+  sdwan.role: transport
+- edge1:
+  transport:
+  sdwan.role: transport
+- vbond:
+  transport:
+  sdwan.role: transport
+"""
+
+
+def test_sdwan_edge_day0_carries_snmp_inside_the_boothook(tmp_path: Path, monkeypatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path, SNMP_EDGE_YAML)
+  init_log()
+  create.run(['-o', 'config', '-o', 'provider', str(topo_file)])
+  startup = Path('node_files/edge1/startup-config').read_text()
+  close = startup.index('--==BOUNDARY==--')
+  first_snmp = startup.find('snmp-server community skyforge RO')
+  assert first_snmp != -1, "the edge day-0 renders no SNMP agent at all"
+  assert first_snmp < close, (
+    "snmp-server sits after the closing MIME boundary, where CVAC never reads it -- "
+    "the edge would boot without an SNMP agent"
+  )
+  # The bootstrap is still the controller-mode document, not a classic IOS one.
+  assert startup.startswith('Content-Type: multipart/mixed')
+  assert 'tunnel mode sdwan' in startup[:close]
+
+
+def test_sdwan_edge_day0_snmp_community_is_the_declared_one(tmp_path: Path, monkeypatch) -> None:
+  # CONTROL for the test above. The runtime defaults switch the services module
+  # on fleet-wide, so "no snmp at all" cannot be rendered under them; instead
+  # prove the line is READ from the topology, not a constant in the template:
+  # a different community must appear inside the boothook and the default must not.
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path, SNMP_EDGE_YAML.replace("community: skyforge", "community: nms-only"))
+  init_log()
+  create.run(['-o', 'config', '-o', 'provider', str(topo_file)])
+  startup = Path('node_files/edge1/startup-config').read_text()
+  boothook = startup[:startup.index('--==BOUNDARY==--')]
+  assert 'snmp-server community nms-only RO' in boothook
+  assert 'snmp-server community skyforge RO' not in boothook
