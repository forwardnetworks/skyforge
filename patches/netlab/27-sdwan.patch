+# ---------------------------------------------------------------------------
+# THE SERVICE SIDE (netlab 0053). An edge that declares sdwan.service_vpn gets
+# every non-transport, non-management data interface and its loopback in that
+# VPN, the site protocol from its own netlab modules, and the seam to OMP by
+# the source-lab rule (BGP if present, else OSPF, else EIGRP). Nothing of it
+# reaches the startup-config; it rides the manager's roster.
+# ---------------------------------------------------------------------------
+SERVICE_SIDE_YAML = """
+provider: kne
+sdwan:
+  organization: lab
+
+nodes:
+  transport:
+    device: iol
+  vmanage:
+    device: cisco_sdwan-manager
+    module: [ sdwan ]
+    sdwan: { type: manager, site_id: 1, system_ip: 10.255.2.1 }
+  vsmart:
+    device: cisco_sdwan-controller
+    module: [ sdwan ]
+    sdwan: { type: controller, site_id: 1, system_ip: 10.255.1.1 }
+  rr:
+    device: iol
+    module: [ ospf, bgp ]
+    bgp.as: 65001
+    bgp.rr: true
+  edge1:
+    device: cat8000v
+    module: [ sdwan, ospf, bgp ]
+    bgp.as: 65001
+    sdwan:
+      type: controller
+      site_id: 101
+      system_ip: 10.255.0.101
+      service_vpn: 200
+  # The validator every Viptela day-0 points at (`vbond <addr>`); the module
+  # refuses a Cisco fabric without one, by name. Listed after the nodes whose
+  # inventory order the assertions rely on.
+  vbond:
+    device: cisco_sdwan-validator
+    module: [ sdwan ]
+
+links:
+- vmanage:
+  transport:
+  sdwan.role: transport
+- vsmart:
+  transport:
+  sdwan.role: transport
+- edge1:
+  transport:
+  sdwan.role: transport
+- vbond:
+  transport:
+  sdwan.role: transport
+- [ edge1, rr ]
+"""
+
+
+def test_sdwan_service_vpn_derives_the_site_side_with_a_bgp_seam(tmp_path: Path) -> None:
+  topology = load_transform(write_topology(tmp_path, SERVICE_SIDE_YAML))
+  edge = topology.nodes.edge1
+  svc = edge.sdwan.service
+
+  assert svc.vpn == 200
+  # The transport interface is NOT in the VPN; the site link and the loopback are.
+  transport_ifnames = { t.ifname for t in edge.sdwan.transport_interfaces }
+  assert [ i.ifname for i in svc.interfaces ] and all(i.ifname not in transport_ifnames for i in svc.interfaces)
+  assert svc.interfaces[0].neighbors == [ "rr" ]
+  assert svc.interfaces[0].netmask == "255.255.255.252" and svc.interfaces[0].wildcard == "0.0.0.3"
+  assert svc.interfaces[0].ospf.area == "0.0.0.0"
+  assert svc.loopback.ifname == "Loopback0" and svc.loopback.netmask == "255.255.255.255"
+
+  # BGP is the seam: OMP into BGP, BGP into OMP, OSPF stays intra-area.
+  assert svc.bgp["as"] == 65001 and svc.bgp.redistribute_omp is True
+  assert svc.ospf.process == 200 and svc.ospf.redistribute_omp is False
+  assert svc.omp.advertise == [ "connected", "static", "bgp" ]
+  # The reflector session netlab built rides the loopbacks, as a client.
+  assert [ (n.name, n.type, n.update_source) for n in svc.bgp.neighbors ] == [ ("rr", "ibgp", "Loopback0") ]
+  assert svc.bgp.neighbors[0].ipv4 == topology.nodes.rr.loopback.ipv4.split("/")[0]
+
+  # The blocks the intent owns, and the prefixes the edge itself originates.
+  owned = [ "/".join(p) for p in svc.owned_blocks ]
+  assert "vrf definition 200" in owned and "router bgp 65001" in owned and "router ospf 200 vrf 200" in owned
+  assert "sdwan/omp/address-family ipv4 vrf 200" in owned
+  assert svc.omp.expect_prefixes == sorted([ svc.interfaces[0].prefix, svc.loopback.prefix ])
+
+  # NOTHING OF IT REACHES THE STARTUP-CONFIG: the routing modules are skipped.
+  assert set(edge.skip_config) >= { "sdwan", "ospf", "bgp" }
+
+  # It rides the manager's roster, which is what the delivery stage reads.
+  roster = topology.nodes.vmanage.sdwan.onboarding.edges
+  assert roster[0].name == "edge1" and roster[0].service.vpn == 200
+  assert roster[0].service.bgp["as"] == 65001
+
+
+def test_sdwan_service_vpn_ospf_alone_is_the_seam(tmp_path: Path) -> None:
