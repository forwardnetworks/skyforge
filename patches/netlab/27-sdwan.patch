diff --git a/netsim/devices/cisco_sdwan-controller.yml b/netsim/devices/cisco_sdwan-controller.yml
new file mode 100644
index 0000000..4ab7174
--- /dev/null
+++ b/netsim/devices/cisco_sdwan-controller.yml
@@ -0,0 +1,42 @@
+---
+description: Cisco SD-WAN Controller
+parent: unknown
+interface_name: eth{ifindex}
+mgmt_if: eth0
+clab:
+  # containerlab models the SD-WAN control plane as ONE kind with a
+  # per-appliance type, which is what netlab passes through here.
+  node:
+    kind: cisco_sdwan
+    type: controller
+  image: registry.example.com/skyforge/kubevirt/cisco_sdwan-controller:20.7.1-kne-r1
+group_vars:
+  ansible_user: admin
+  ansible_ssh_pass: admin
+  ansible_password: admin
+  netlab_device_type: cisco_sdwan-controller
+  ansible_network_os: viptela
+  ansible_connection: network_cli
+features:
+  # STATIC ROUTES, for one declaration only: `routing.static` with a default
+  # route toward the site/DC exit, which the sdwan module renders into VPN 0
+  # of this appliance's day-0 (initial/cisco_sdwan.cloudconfig.j2). The
+  # routing module never configures a Viptela appliance over Ansible -- these
+  # nodes are outside the netlab-initial limit (day-0 arrives on the boot
+  # disk) -- so this registers the upstream attribute, not a config path.
+  routing:
+    static:
+      vrf: False
+      inter_vrf: False
+      discard: False
+  # See services/cisco_sdwan-controller.j2 and the identical note on cisco_sdwan_edge.yml.
+  # Global (not provider-scoped) so supported_on registration cannot be skipped;
+  # server.snmp deliberately absent -- vSmart is collected with
+  # cisco_sdwan_vsmart_ssh, and its snmp_config template was already a no-op.
+  services:
+    dns:
+      transport_vrf: false
+  sdwan:
+    types: [ controller, validator ]
+kne:
+  node.type: controller
diff --git a/netsim/devices/cisco_sdwan-manager.yml b/netsim/devices/cisco_sdwan-manager.yml
new file mode 100644
index 0000000..9bc3652
--- /dev/null
+++ b/netsim/devices/cisco_sdwan-manager.yml
@@ -0,0 +1,55 @@
+---
+description: Cisco SD-WAN Manager
+parent: unknown
+interface_name: eth{ifindex}
+mgmt_if: eth0
+clab:
+  # containerlab models the SD-WAN control plane as ONE kind with a
+  # per-appliance type, which is what netlab passes through here.
+  node:
+    kind: cisco_sdwan
+    type: manager
+  image: registry.example.com/skyforge/kubevirt/cisco_sdwan-manager:20.7.1-kne-r1
+group_vars:
+  ansible_user: admin
+  # CONTAINERLAB DEFAULT. admin/admin is what containerlab/vrnetlab ships for
+  # this device and what every other consumer expects; this file follows it
+  # rather than inventing a Skyforge-specific literal, which is unupstreamable
+  # and drifts from the rest of the fleet.
+  #
+  # NOTE: vManage 20.7.1 was observed refusing to KEEP the factory value
+  # (USER0002 "Password for admin user cannot be configured to default/last
+  # password"). If that reproduces, the declared value belongs in the
+  # deployment layer that owns per-lab credentials -- NOT hardcoded here.
+  ansible_ssh_pass: admin
+  ansible_password: admin
+  netlab_device_type: cisco_sdwan-manager
+  ansible_network_os: viptela
+  # LOCAL, not network_cli. network_cli refuses unknown network_os at task
+  # setup, so a viptela host can never appear in an ansible play at all --
+  # and the manager MUST: its sdwan module lane drives the vManage REST API
+  # (delegated uri calls, no device connection). PAN-OS/A10 precedent.
+  ansible_connection: local
+features:
+  # STATIC ROUTES, for one declaration only: `routing.static` with a default
+  # route toward the site/DC exit, which the sdwan module renders into VPN 0
+  # of this appliance's day-0 (initial/cisco_sdwan.cloudconfig.j2). The
+  # routing module never configures a Viptela appliance over Ansible -- these
+  # nodes are outside the netlab-initial limit (day-0 arrives on the boot
+  # disk) -- so this registers the upstream attribute, not a config path.
+  routing:
+    static:
+      vrf: False
+      inter_vrf: False
+      discard: False
+  # See services/cisco_sdwan-manager.j2 and the identical note on cisco_sdwan-controller.yml.
+  # Global (not provider-scoped) so supported_on registration cannot be skipped;
+  # server.snmp deliberately absent -- vManage is not collected by the collector as a
+  # device at all (it is an endpoint), so there is no SNMP agent to configure.
+  services:
+    dns:
+      transport_vrf: false
+  sdwan:
+    types: [ manager ]
+kne:
+  node.type: manager
