+#!/bin/sh
+# One interactive SSH session against an SD-WAN appliance or edge CLI.
+#
+#   SSHPASS=<password> sdwan_cli_session.sh <user@host> <cmd> [<cmd>...]
+#
+# Each argument is typed as one line and followed by a pause; an argument of
+# the form "sleep:N" only pauses. The session ends with `exit`. Output comes
+# back with carriage returns stripped and the SSH banner lines removed.
+#
+# WHY A SCRIPT AND NOT A MODULE. The Viptela CLI (vManage/vBond/vSmart) is a
+# ConfD shell that refuses ansible's network_cli ("network os viptela is not
+# supported", proved on vbond, run 74032), and a controller-mode C8000V is an
+# IOS-XE exec whose SD-WAN `request` commands PROMPT (organization-unit twice
+# for a CSR, a destination filename for `copy`). Typing lines with pauses over
+# a forced pty is what a person does at that console, and it is what was
+# measured to work on 2026-09-06 (scratch lab sdwan-edge01). The password never
+# appears on a command line: sshpass reads SSHPASS from the environment.
+set -u
+target="$1"; shift
+{
+  sleep 6
+  for c in "$@"; do
+    case "$c" in
+      sleep:*) sleep "${c#sleep:}" ;;
+      *) printf '%s\n' "$c"; sleep 5 ;;
+    esac
+  done
+  printf 'exit\n'
+  sleep 1
+} | sshpass -e ssh -tt \
+      -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
+      -o ConnectTimeout=20 -o PreferredAuthentications=password,keyboard-interactive \
+      -o PubkeyAuthentication=no -o LogLevel=ERROR \
+      "$target" 2>&1 | tr -d '\r' | LC_ALL=C grep -avE '^(Last login|Welcome to Viptela|User admin last logged|admin connected from)'
+exit 0
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_cli_wait_prompt.sh b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_cli_wait_prompt.sh
new file mode 100755
index 0000000..1f7e45f
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_cli_wait_prompt.sh
@@ -0,0 +1,64 @@
+#!/bin/sh
+# Wait for ONE appliance's CLI to reach a prompt.
+#
+#   SSHPASS=<pw> sdwan_cli_wait_prompt.sh <user@host> <tries> <delay-seconds>
+#
+# WHY A SCRIPT AND NOT `until:`. The three appliances are probed concurrently
+# as one async job each, so the retry has to live INSIDE the job -- an ansible
+# `until:` around an async fire would retry the FIRING, not the probing. Same
+# reason, and the same shape, as sdwan_edge_wait_serial.sh beside it.
+#
+# WHY THIS EXISTS AT ALL. The probe it replaces was a single task with a
+# `loop:` and an `until:`, and ansible applies retries PER LOOP ITEM: the
+# appliances were waited for one after another. Measured on demo-lab
+# (2026-09-07, run 94000, from the runtime stage markers in Loki), the stage
+# that contains it -- "sdwan fabric onboarding (vManage API)" -- took 33m01s
+# of a 53m40s bring-up, 62% of the whole run, while `netlab initial` took
+# 18m11s and the SD-WAN service side took 34 seconds. Three appliances at
+# 20 retries x 15s is up to ~26 minutes of that, spent in series, waiting.
+# Concurrently it is the slowest one, not the sum.
+#
+# The probe is the CLI itself, not a port check: a listening sshd that cannot
+# get to a prompt would pass a TCP test and fail every `request vedge add`.
+# The prompt character is the proof -- an ssh failure prints its own error to
+# the same stream and never contains one.
+#
+# SELF-CONTAINED ON PURPOSE. Ansible's `script` module copies THIS FILE ALONE
+# to the target, so a sibling helper in the repo is not beside it at run time.
+#
+# Prints the LAST session's output whatever happens, and always exits 0: the
+# caller decides what silence means, and a reader that fails is a second thing
+# to debug at the moment something else already is.
+set -u
+target="$1"; tries="${2:-20}"; delay="${3:-15}"
+
+session() {
+  {
+    sleep 4
+    printf 'show clock\n'
+    sleep 3
+    printf 'exit\n'
+    sleep 1
+  } | sshpass -e ssh -tt \
+        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
+        -o ConnectTimeout=20 -o PreferredAuthentications=password,keyboard-interactive \
+        -o PubkeyAuthentication=no -o LogLevel=ERROR \
+        "$target" 2>&1 | tr -d '\r' \
+    | LC_ALL=C grep -avE '^(Last login|Welcome to Viptela|User admin last logged|admin connected from)'
+}
+
+out=""
+i=1
+while [ "$i" -le "$tries" ]; do
+  out="$(session)"
+  if printf '%s' "$out" | LC_ALL=C grep -qF '#'; then
+    printf '%s\n' "$out"
+    printf 'sdwan-appliance-prompt-attempts: %s\n' "$i"
+    exit 0
+  fi
+  i=$((i + 1))
+  [ "$i" -le "$tries" ] && sleep "$delay"
+done
+printf '%s\n' "$out"
+printf 'sdwan-appliance-prompt-attempts: %s (no prompt)\n' "$tries"
+exit 0
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_edge_readback.py b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_edge_readback.py
new file mode 100644
index 0000000..ce454c3
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_edge_readback.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python3
+"""Read back whether each WAN edge actually joined the fabric.
+
+WHY THIS EXISTS. Everything the lane does for an edge is what the manager was
+TOLD: a board identity authorised, a validity flag flipped, a list pushed. None
+of that is the edge being in the fabric. The only first-hand evidence is the
+CONTROLLER's control-connection table -- a `vedge` peer whose system-ip is the
+edge's, `state: up` -- which is also exactly what the collector's Viptela collector
+reads from the vSmart (`show control connections`, ViptelaSmartCliDevice) to
+decide whether the host "reports any guest". Judging by the same table means
+the lane's verdict and the collector's cannot disagree.
+
+THIS USES THE SDK, NOT HAND-ROLLED REST. The session is the one the collection
+itself builds (create_manager_session, module_utils/vmanage_module.py); the
+calls are the SDK's own endpoint classes, quoted from source rather than
+remembered:
+
+  catalystwan/endpoints/monitoring/device_details.py
+    MonitoringDeviceDetails.list_all_devices          GET /device
+  catalystwan/endpoints/configuration_device_inventory.py
+    ConfigurationDeviceInventory.get_device_details   GET /system/device/{category}
+
+and the control-connection table through the session's own request method,
+because the SDK declares no typed endpoint for it (enumerated: nothing under
+/device/control). session.get() is the SDK's ManagerSession method, not a
+requests call; the path is the one vManage's own UI reads.
+
+REPORTING, NOT DECIDING. Prints one JSON document and always exits 0. The lane
+decides what a NOT_PROVEN edge means (today: it is reported, never hidden, and
+the runtime persists it for Skyforge to gate the collector's device typing on). A
+reader that can itself fail is a second thing to debug at the moment the fabric
+is the first.
+
+Input (path in argv[1]):
+  {"credentials": {url, username, password, port},
+   "edges": [{name, chassis, system_ip, site_id}],
+   "controller_system_ips": ["10.255.1.1"],
+   "poll_seconds": 600, "poll_interval": 15}
+"""
+
+import json
+import sys
+import time
+
+
+def _load(path):
+    with open(path, "r") as fh:
+        return json.load(fh)
+
+
+def _session(creds):
+    from catalystwan.session import create_manager_session
+
+    return create_manager_session(
+        url=str(creds.get("url", "")),
+        username=str(creds.get("username", "")),
+        password=str(creds.get("password", "")),
+        port=int(creds.get("port", 443) or 443),
+    )
+
+
+def _control_connections(session, controller_ip):
+    resp = session.get("/dataservice/device/control/connections", params={"deviceId": controller_ip})
+    body = resp.json() if hasattr(resp, "json") else {}
+    return list((body or {}).get("data") or [])
+
+
+def _vedge_list(session):
+    try:
+        resp = session.get("/dataservice/system/device/vedges")
+        body = resp.json() if hasattr(resp, "json") else {}
+        return list((body or {}).get("data") or [])
+    except Exception as exc:  # noqa: BLE001 - evidence, never a verdict
+        return [{"error": str(exc)}]
+
+
+def _judge(edges, conns_by_controller, vedges):
+    verdicts = []
+    for edge in edges:
+        sys_ip = str(edge.get("system_ip", "") or "")
+        chassis = str(edge.get("chassis", "") or "")
+        peers = []
+        for ctrl_ip, conns in conns_by_controller.items():
+            for c in conns:
+                if str(c.get("peer-type", "")) != "vedge":
+                    continue
+                if str(c.get("system-ip", "")) != sys_ip:
+                    continue
+                peers.append({
+                    "controller": ctrl_ip,
+                    "state": str(c.get("state", "")),
+                    "protocol": str(c.get("protocol", "")),
+                    "public_ip": str(c.get("public-ip", "")),
+                    "remote_color": str(c.get("remote-color", "")),
+                    "uptime": str(c.get("uptime", "")),
+                })
+        listed = [
+            {
+                "validity": str(v.get("validity", "")),
+                "device_state": str(v.get("deviceState", "")),
+                "cert_install_status": str(v.get("certInstallStatus", v.get("vedgeCertificateState", ""))),
+                "system_ip": str(v.get("system-ip", v.get("configuredSystemIP", ""))),
+                "device_model": str(v.get("deviceModel", "")),
+            }
+            for v in vedges
+            if str(v.get("chasisNumber", v.get("uuid", ""))) == chassis
+        ]
+        up = [p for p in peers if p["state"] == "up"]
+        verdicts.append({
+            "name": edge.get("name", ""),
+            "chassis": chassis,
+            "system_ip": sys_ip,
+            "verdict": "PROVEN" if up else "NOT_PROVEN",
+            "control_connections": peers,
+            "vedge_list": listed,
+        })
+    return verdicts
+
+
+def main() -> int:
+    if len(sys.argv) < 2:
+        print(json.dumps({"error": "no input file argument", "edges": []}))
+        return 0
+    try:
+        payload = _load(sys.argv[1])
+    except Exception as exc:  # noqa: BLE001
+        print(json.dumps({"error": f"could not read input {sys.argv[1]}: {exc}", "edges": []}))
+        return 0
+
+    edges = list(payload.get("edges") or [])
+    controllers = [str(x) for x in (payload.get("controller_system_ips") or []) if str(x)]
+    budget = int(payload.get("poll_seconds", 600) or 600)
+    interval = max(5, int(payload.get("poll_interval", 15) or 15))
+    if not edges:
+        print(json.dumps({"edges": [], "note": "no edges in the roster"}))
+        return 0
+
+    try:
+        session = _session(payload.get("credentials") or {})
+    except Exception as exc:  # noqa: BLE001
+        print(json.dumps({"error": f"manager session failed: {exc}", "edges": [
+            {"name": e.get("name", ""), "chassis": e.get("chassis", ""), "system_ip": e.get("system_ip", ""),
+             "verdict": "NOT_PROVEN", "control_connections": [], "vedge_list": []} for e in edges]}))
+        return 0
+
+    deadline = time.time() + budget
+    verdicts = []
+    polls = 0
+    last_error = ""
+    while True:
+        polls += 1
+        conns = {}
+        for ctrl in controllers:
+            try:
+                conns[ctrl] = _control_connections(session, ctrl)
+            except Exception as exc:  # noqa: BLE001
+                last_error = f"{ctrl}: {exc}"
+                conns[ctrl] = []
+        verdicts = _judge(edges, conns, _vedge_list(session))
+        if all(v["verdict"] == "PROVEN" for v in verdicts) or time.time() >= deadline:
+            break
+        time.sleep(interval)
+
+    out = {"edges": verdicts, "polls": polls, "controllers": controllers}
+    if last_error:
+        out["last_error"] = last_error
+    try:
+        session.close()
+    except Exception:  # noqa: BLE001
+        pass
+    print(json.dumps(out))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_edge_wait_serial.sh b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_edge_wait_serial.sh
new file mode 100755
index 0000000..69ee486
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_edge_wait_serial.sh
@@ -0,0 +1,60 @@
+#!/bin/sh
+# Ask ONE edge for its certificate serial until it has one.
+#
+#   SSHPASS=<pw> sdwan_edge_wait_serial.sh <user@host> <tries> <delay-seconds>
+#
+# WHY A SCRIPT AND NOT `until:`. The staged lane fires every edge's read
+# concurrently as one async job each, so the retry has to live INSIDE the job
+# -- an ansible `until:` around an async fire would retry the FIRING, not the
+# reading.
+#
+# The install is not instantaneous and its duration is not ours to predict: on
+# demo-lab the install SUCCEEDED while a fixed 12s wait was still counting, so
+# the show was swallowed and the lane saw no serial at all (netlab 0046).
+# Asking again until the device answers is a measurement; a fixed sleep is a
+# guess about someone else's machine.
+#
+# SELF-CONTAINED ON PURPOSE. Ansible's `script` module copies THIS FILE ALONE
+# into a temporary directory on the target and runs it there, so a sibling
+# helper next to it in the repo is not next to it at run time: calling
+# ../sdwan_cli_session.sh would be a file-not-found at the exact moment this
+# is meant to be measuring something. The session is therefore opened here.
+#
+# Prints the LAST session's output whatever happens, and always exits 0: the
+# caller decides what a missing serial means, and a reader that fails is a
+# second thing to debug at the moment something else already is.
+set -u
+target="$1"; tries="${2:-10}"; delay="${3:-15}"
+
+session() {
+  {
+    sleep 6
+    printf 'terminal length 0\n'
+    sleep 2
+    printf 'show sdwan certificate serial\n'
+    sleep 5
+    printf 'exit\n'
+    sleep 1
+  } | sshpass -e ssh -tt \
+        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
+        -o ConnectTimeout=20 -o PreferredAuthentications=password,keyboard-interactive \
+        -o PubkeyAuthentication=no -o LogLevel=ERROR \
+        "$target" 2>&1 | tr -d '\r' \
+    | LC_ALL=C grep -avE '^(Last login|Welcome to Viptela|User admin last logged|admin connected from)'
+}
+
+out=""
+i=1
+while [ "$i" -le "$tries" ]; do
+  out="$(session)"
+  if printf '%s' "$out" | LC_ALL=C grep -qE 'serial number: [0-9A-Fa-f]{8,}'; then
+    printf '%s\n' "$out"
+    printf 'sdwan-edge-serial-attempts: %s\n' "$i"
+    exit 0
+  fi
+  i=$((i + 1))
+  [ "$i" -le "$tries" ] && sleep "$delay"
+done
+printf '%s\n' "$out"
+printf 'sdwan-edge-serial-attempts: %s (no serial)\n' "$tries"
+exit 0
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_install_activity.py b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_install_activity.py
new file mode 100644
index 0000000..9e9eaba
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/files/sdwan_install_activity.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Read what vManage actually did with each certificate install.
+
+WHY THIS EXISTS. The install-proof gate can only say "status=Not Installed".
+That is the device's summary, not a reason, and the lane has now spent two
+separate investigations theorising over it -- once blaming CA trust, once
+blaming an empty OU. vManage records the reason in exactly one place and
+nowhere else:
+
+    GET /dataservice/device/action/status/<task_id>  ->  data[].activity
+
+install_signed_certificate returns that task id and never polls it (it routes
+through send_request_safely), so the reason has always been available and never
+been read. This script reads it.
+
+THIS USES THE SDK, NOT HAND-ROLLED REST, and the call below is copied from the
+SDK's own code rather than guessed. catalystwan/api/task_status_api.py:161 does
+exactly:
+
+    ConfigurationDashboardStatus(self.session).find_status(self.task_id)
+
+find_status is decorated @get("/device/action/status/{task_id}") and returns
+TaskData, whose `.data` is a List[SubTaskData], each carrying
+`activity: List[str]`, `status`, and `current_activity`. The session comes from
+create_manager_session -- the same call the collection's own
+module_utils/vmanage_module.py makes.
+
+An earlier draft of this file reached for `session.api.task_status`. That
+accessor does not exist; it was invented from the module name. Checking it
+against the SDK is what caught it, and is why the call above is quoted from
+source rather than remembered.
+
+It is a script rather than a task because the cisco.catalystwan collection has
+NO module for this endpoint -- all 29 of its modules were enumerated and none
+exposes task/action status, and there is no generic request module to borrow.
+Writing raw REST here would have been the easy alternative and the wrong one.
+
+REPORTING, NOT DECIDING. It prints JSON and always exits 0. Whether a run fails
+is the lane's decision; this only makes the failure legible. A reader that can
+itself fail becomes a second thing to debug at the exact moment something else
+is already broken.
+"""
+
+import json
+import sys
+
+
+def main() -> int:
+    # INPUT IS A FILE PATH IN argv[1], not stdin: ansible's `script` module has no
+    # stdin parameter (run 78562 failed with "Unsupported parameters"), and argv
+    # would expose the credential in the process table.
+    if len(sys.argv) < 2:
+        print(json.dumps({"error": "no input file argument", "results": []}))
+        return 0
+    try:
+        with open(sys.argv[1], "r") as fh:
+            payload = json.load(fh)
+    except Exception as exc:  # noqa: BLE001 - report, never raise
+        print(json.dumps({"error": f"could not read input {sys.argv[1]}: {exc}", "results": []}))
+        return 0
+
+    creds = payload.get("credentials") or {}
+    task_ids = payload.get("task_ids") or []
+    results = []
+
+    try:
+        from catalystwan.endpoints.configuration_dashboard_status import (
+            ConfigurationDashboardStatus,
+        )
+        from catalystwan.session import create_manager_session
+    except Exception as exc:  # noqa: BLE001
+        print(json.dumps({"error": f"catalystwan SDK unavailable: {exc}", "results": []}))
+        return 0
+
+    session = None
+    try:
+        session = create_manager_session(
+            url=creds.get("url"),
+            username=creds.get("username"),
+            password=creds.get("password"),
+            port=creds.get("port", 443),
+        )
+        for entry in task_ids:
+            name = entry.get("name", "?")
+            task_id = entry.get("task_id")
+            if not task_id:
+                results.append({"name": name, "task_id": None,
+                                "activity": ["no install task id was returned for this device"]})
+                continue
+            try:
+                data = ConfigurationDashboardStatus(session).find_status(task_id)
+            except Exception as exc:  # noqa: BLE001
+                results.append({"name": name, "task_id": task_id,
+                                "activity": [f"could not read task status: {exc}"]})
+                continue
+            # Flatten every sub-task's activity lines plus its status fields.
+            # Report ALL of them: "one of three failed" and "all three failed"
+            # have different causes, and a first-only reader hides that.
+            for sub in (getattr(data, "data", None) or []):
+                results.append({
+                    "name": name,
+                    "task_id": task_id,
+                    "status": getattr(sub, "status", None),
+                    "current_activity": getattr(sub, "current_activity", None),
+                    "activity": list(getattr(sub, "activity", None) or []),
+                })
+    except Exception as exc:  # noqa: BLE001
+        print(json.dumps({"error": f"session failed: {exc}", "results": results}))
+        return 0
+    finally:
+        try:
+            if session is not None:
+                session.close()
+        except Exception:  # noqa: BLE001
+            pass
+
+    print(json.dumps({"error": None, "results": results}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
