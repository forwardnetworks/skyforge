+def test_sdwan_service_vpn_refuses_a_second_vpn(tmp_path: Path) -> None:
+  yaml = SERVICE_SIDE_YAML + """- edge1:
+  rr:
+  sdwan.vpn: 300
+"""
+  init_log(raise_error=True)
+  topology = _read.load(str(write_topology(tmp_path, yaml)), relative_topo_name=True, user_defaults=[])
+  try:
