diff --git a/tests/test_sdwan.py b/tests/test_sdwan.py
new file mode 100644
index 0000000..3cf8e79
--- /dev/null
+++ b/tests/test_sdwan.py
@@ -0,0 +1,900 @@
+import textwrap
+from argparse import Namespace
+from pathlib import Path
+
+from box import Box
+
+from netsim import augment
+from netsim.cli import create, load_snapshot
+from netsim.utils import log
+from netsim.utils import read as _read
+
+
+CATALYST_SYSTEM_YAML = """
+name: sdwan-two-branch
+provider: kne
+sdwan:
+  system: catalyst
+  profile: minimum-lab
+  organization: se-lab
+  system_ip_pool: 10.255.0.0/24
+  control_plane:
+    attach: transport
+  edges:
+    attach: transport
+    defaults:
+      site_id_start: 101
+      transport_color: public-internet
+    members:
+      branch1: {}
+      branch2: {}
+  trust:
+    mode: enterprise-ca
+    bundle_ref: catalyst-lab-trust
+nodes:
+  transport:
+    device: iol
+"""
+
+
+def init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=False, raise_error=raise_error, warning=False, logging=False, verbose=0)
+
+
+def write_topology(tmp_path: Path, topology: str) -> Path:
+  topo_file = tmp_path / "topology.yml"
+  topo_file.write_text(textwrap.dedent(topology).strip() + "\n")
+  return topo_file
+
+
+def load_transform(topology_file: Path) -> Box:
+  init_log()
+  topology = _read.load(str(topology_file), relative_topo_name=True, user_defaults=[])
+  log.exit_on_error()
+  augment.main.transform(topology)
+  log.exit_on_error()
+  return topology
+
+
+def test_sdwan_assigns_roles_and_inventory(tmp_path: Path) -> None:
+  topo_file = write_topology(
+    tmp_path,
+    """
+provider: kne
+sdwan:
+  organization: lab
+  inventory:
+    name: cisco-sdwan
+
+nodes:
+  # A plain transport router is NOT in the sdwan module. It carries the
+  # tunnels; it is not a member of the fabric.
+  transport:
+    device: iol
+  vsmart:
+    device: cisco_sdwan-controller
+    module: [ sdwan ]
+  edge1:
+    device: cat8000v
+    module: [ sdwan ]
+    sdwan:
+      type: controller
+      site_id: 101
+      system_ip: 10.255.0.101
+  # The validator every Viptela day-0 points at (`vbond <addr>`); the module
+  # refuses a Cisco fabric without one, by name. Listed after the nodes whose
+  # inventory order the assertions rely on.
+  vbond:
+    device: cisco_sdwan-validator
+    module: [ sdwan ]
+
+links:
+- vsmart:
+  transport:
+  sdwan.role: transport
+- edge1:
+  transport:
+  sdwan.role: transport
+- vbond:
+  transport:
+  sdwan.role: transport
+""",
+  )
+
+  topology = load_transform(topo_file)
+
+  # A plain device holds no type at all -- there is no underlay type.
+  assert not topology.nodes.transport.get("sdwan.type", "")
+  assert topology.nodes.vsmart.sdwan.type == "controller"
+  # containerlab spells a managed c8000v `controller`; `edge` is the derived
+  # FABRIC role, which is what the inventory carries.
+  assert topology.nodes.edge1.sdwan.type == "controller"
+
+  inventory = topology.sdwan.inventory
+  assert inventory.name == "cisco-sdwan"
+  assert inventory.vendor == "cisco"
+  assert inventory.type == "cisco_sdwan"
+  assert inventory.collect_from == "vsmart"
+  assert inventory.nodes[0].node == "vsmart"
+  assert inventory.nodes[0].vendor_os == "cisco_sdwan_controller"
+  assert inventory.nodes[1].node == "edge1"
+  # A managed c8000v collects as an SD-WAN edge, not as plain IOS-XE.
+  assert inventory.nodes[1].vendor_os == "cisco_sdwan_edge"
+
+
+def test_catalyst_system_generates_shape_lifecycle_trust_and_capacity(tmp_path: Path) -> None:
+  topology = load_transform(write_topology(tmp_path, CATALYST_SYSTEM_YAML))
+
+  assert list(topology.nodes) == [
+    "transport",
+    "sdwan_manager",
+    "sdwan_controller",
+    "sdwan_validator",
+    "branch1",
+    "branch2",
+  ]
+  assert topology.nodes.sdwan_manager.device == "cisco_sdwan-manager"
+  assert topology.nodes.sdwan_controller.device == "cisco_sdwan-controller"
+  assert topology.nodes.sdwan_validator.device == "cisco_sdwan-validator"
+  assert topology.nodes.branch1.device == "cat8000v"
+  assert topology.nodes.branch1.sdwan.site_id == 101
+  assert topology.nodes.branch2.sdwan.site_id == 102
+  assert topology.nodes.branch1.sdwan.system_ip == "10.255.0.101"
+  assert len(topology.links) == 1
+  assert {intf.node for intf in topology.links[0].interfaces} == set(topology.nodes)
+
+  lifecycle = topology.sdwan.lifecycle.phases
+  assert [phase.name for phase in lifecycle] == [
+    "controllers-admitted",
+    "controllers-trusted",
+    "edges-admitted",
+    "fabric-ready",
+  ]
+  assert lifecycle[2].requires == ["controllers-trusted"]
+  assert lifecycle[1].probes[0].success == (
+    "certificate-valid && services-ready && controllers-connected"
+  )
+  assert lifecycle[3].probes[0].success.endswith("omp-up")
+
+  manager_bundle = topology.nodes.sdwan_manager.kne.bootstrap_bundles[0]
+  assert manager_bundle.secret_name == "catalyst-lab-trust"
+  assert "wan-edge-serials.json" in manager_bundle.required_keys
+  assert not any("BEGIN " in str(item) for item in manager_bundle.required_keys)
+  assert topology.sdwan.capacity.reservation == {
+    "cpu": "30",
+    "memory": "56Gi",
+    "ephemeral-storage": "651Gi",
+  }
+  assert topology.nodes.sdwan_manager.kne.constraints["ephemeral-storage"] == "525Gi"
+
+
+def test_system_selection_interface_is_vendor_neutral() -> None:
+  catalyst = _read.read_yaml(string=textwrap.dedent(CATALYST_SYSTEM_YAML))
+  versa_text = CATALYST_SYSTEM_YAML.replace(
+    "system: catalyst", "system: versa"
+  ).replace(
+    "bundle_ref: catalyst-lab-trust", "bundle_ref: versa-lab-trust"
+  )
+  versa = _read.read_yaml(string=textwrap.dedent(versa_text))
+
+  catalyst.sdwan.system = "<system>"
+  versa.sdwan.system = "<system>"
+  catalyst.sdwan.trust.bundle_ref = "<trust-ref>"
+  versa.sdwan.trust.bundle_ref = "<trust-ref>"
+  assert catalyst == versa
+
+
+def test_versa_system_is_parked_on_licensing(tmp_path: Path) -> None:
+  versa_yaml = CATALYST_SYSTEM_YAML.replace(
+    "system: catalyst", "system: versa"
+  ).replace(
+    "bundle_ref: catalyst-lab-trust", "bundle_ref: versa-lab-trust"
+  )
+  topo_file = write_topology(tmp_path, versa_yaml)
+  init_log(raise_error=True)
+  topology = _read.load(str(topo_file), relative_topo_name=True, user_defaults=[])
+  try:
+    augment.main.transform(topology)
+  except log.ErrorAbort:
+    assert "Versa SD-WAN system is parked" in "\n".join(log.get_error_log())
+  else:
+    raise AssertionError("Versa system expanded despite unresolved licensing")
+
+
+def test_sdwan_builds_versa_inventory(tmp_path: Path) -> None:
+  topo_file = write_topology(
+    tmp_path,
+    """
+provider: kne
+sdwan:
+  vendor: versa
+  inventory:
+    name: versa-sdwan
+
+nodes:
+  director:
+    device: versa-director
+    module: [ sdwan ]
+  branch:
+    device: versa-flexvnf
+    module: [ sdwan ]
+
+links:
+- director:
+  branch:
+  sdwan.role: transport
+""",
+  )
+
+  topology = load_transform(topo_file)
+
+  inventory = topology.sdwan.inventory
+  assert inventory.name == "versa-sdwan"
+  assert inventory.vendor == "versa"
+  assert inventory.type == "versa_sdwan"
+  assert inventory.collect_from == "director"
+  assert inventory.nodes[0].node == "director"
+  assert inventory.nodes[0].vendor_os == "versa_director"
+  assert inventory.nodes[1].node == "branch"
+  assert inventory.nodes[1].vendor_os == "versa_flexvnf"
+
+
+def test_sdwan_rejects_iol_edge_role(tmp_path: Path) -> None:
+  topo_file = write_topology(
+    tmp_path,
+    """
+provider: kne
+
+nodes:
+  edge1:
+    device: iol
+    module: [ sdwan ]
+    sdwan.type: edge
+""",
+  )
+
+  init_log(raise_error=True)
+  topology = _read.load(str(topo_file), relative_topo_name=True, user_defaults=[])
+  try:
+    augment.main.transform(topology)
+  except log.ErrorAbort:
+    errors = "\n".join(log.get_error_log())
+    # iol declares no sdwan feature at all, so the refusal lands one level
+    # earlier than a type check: it is not an SD-WAN device.
+    assert "does not support module sdwan" in errors
+  else:
+    raise AssertionError("IOL edge role was accepted")
+
+
+def test_sdwan_rejects_mismatched_vendor_device(tmp_path: Path) -> None:
+  topo_file = write_topology(
+    tmp_path,
+    """
+provider: kne
+sdwan:
+  vendor: versa
+
+nodes:
+  edge1:
+    device: cat8000v
+    module: [ sdwan ]
+    sdwan.type: controller
+""",
+  )
+
+  init_log(raise_error=True)
+  topology = _read.load(str(topo_file), relative_topo_name=True, user_defaults=[])
+  try:
+    augment.main.transform(topology)
+  except log.ErrorAbort:
+    errors = "\n".join(log.get_error_log())
+    assert "belongs to cisco SD-WAN, not versa" in errors
+  else:
+    raise AssertionError("mismatched SD-WAN vendor device was accepted")
+
+
+def test_sdwan_fabric_mode_requires_cisco_roles(tmp_path: Path) -> None:
+  topo_file = write_topology(
+    tmp_path,
+    """
+provider: kne
+module: [ sdwan ]
+sdwan:
+  fabric: true
+
+nodes:
+  vmanage:
+    device: cisco_sdwan-manager
+  vsmart:
+    device: cisco_sdwan-controller
+  edge1:
+    device: cat8000v
+""",
+  )
+
+  init_log(raise_error=True)
+  topology = _read.load(str(topo_file), relative_topo_name=True, user_defaults=[])
+  try:
+    augment.main.transform(topology)
+  except log.ErrorAbort:
+    errors = "\n".join(log.get_error_log())
+    assert "missing a validator node" in errors
+  else:
+    raise AssertionError("incomplete Cisco SD-WAN fabric was accepted")
+
+
+def test_kne_snapshot_exports_sdwan_inventory(tmp_path: Path, monkeypatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(
+    tmp_path,
+    """
+provider: kne
+sdwan:
+  inventory:
+    name: cisco-sdwan
+
+nodes:
+  vsmart:
+    device: cisco_sdwan-controller
+    module: [ sdwan ]
+  # A bare cat8000v is a plain IOS-XE router. It joins the fabric only by
+  # declaring the containerlab type that boots it managed.
+  edge1:
+    device: cat8000v
+    module: [ sdwan ]
+    sdwan.type: controller
+  # Every Viptela node's day-0 carries `vbond <addr>`; without a validator the
+  # module refuses the topology by name (no vbond target). Listed LAST so the
+  # inventory order the assertions below rely on is unchanged.
+  vbond:
+    device: cisco_sdwan-validator
+    module: [ sdwan ]
+
+links:
+- vsmart:
+  edge1:
+  vbond:
+  sdwan.role: transport
+""",
+  )
+
+  init_log()
+  create.run([str(topo_file)])
+  snapshot = load_snapshot(Namespace(snapshot="netlab.snapshot.pickle"))
+
+  assert snapshot.kne.sdwan.inventory.name == "cisco-sdwan"
+  assert snapshot.kne.sdwan.inventory.vendor == "cisco"
+  assert snapshot.kne.sdwan.inventory.collect_from == "vsmart"
+  assert snapshot.kne.sdwan.inventory.nodes[0].node == "vsmart"
