+# SD-WAN metadata default settings and attributes
+#
+---
+vendor: cisco
+fabric: false
+transport_vpn: 0
+hooks: [ normalize ]
+
+no_propagate:
+  api_password:
+  api_factory_password:
+  vendor:
+  system:
+  profile:
+  organization:
+  fabric:
+  system_ip_pool:
+  site_id_pool:
+  transport_vpn:
+  service_vpns:
+  colors:
+  controllers:
+  control_plane:
+  edges:
+  trust:
+  lifecycle:
+  capacity:
+  inventory:
+
+attributes:
+  global:
+    system: { type: str, valid_values: [ catalyst, versa ] }
+    profile: { type: str, valid_values: [ minimum-lab ] }
+    vendor: { type: str, valid_values: [ cisco, versa ] }
+    organization: str
+    # The credential the fabric's API lane uses. Declared here so ONE value
+    # covers netlab's device login, the KNE serial injector's answer to the
+    # forced first-boot prompt, and vManage's REST onboarding -- the drift
+    # between those three is what produced a password that existed only in a
+    # single operator's head (2026-08-31).
+    #
+    # Default is unset: the lane then uses the device's ansible_password
+    # (admin, matching containerlab). Set this ONLY when the appliance forces a
+    # change away from the factory value, which vManage does behind its
+    # passwordReset gate.
+    api_password: str
+    api_factory_password: str
+    fabric: bool
+    system_ip_pool: { type: ipv4, use: prefix }
+    site_id_pool: { type: int, min_value: 1 }
+    transport_vpn: { type: int, min_value: 0 }
+    service_vpns:
+      type: list
+      make_list: True
+      _subtype: { type: int, min_value: 1 }
+    colors:
+      type: list
+      make_list: True
+      _subtype: str
+    controllers:
+      manager: node_id
+      controller: node_id
+      validator: node_id
+    control_plane:
+      attach: node_id
+    edges:
+      attach: node_id
+      device: str
+      defaults:
+        site_id_start: { type: int, min_value: 1 }
+        transport_color: str
+      members:
+        type: dict
+        _subtype:
+          device: str
+          site_id: { type: int, min_value: 1 }
+          system_ip: { type: ipv4, use: address }
+    trust:
+      mode: str
+      bundle_ref: str
+      # The fabric's enterprise root CA, PEM, PUBLIC HALF ONLY.
+      #
+      # This is the one thing day-0 carries beyond identity, and it is here
+      # because nothing else can carry it. A full AST enumeration of the SDK
+      # (1025 endpoints across 125 files) matched ZERO endpoints for chain,
+      # trust, anchor, bundle, push or distribute; the only root-CA operations
+      # are get/edit_enterprise_root_ca, which store the CA on vManage and
+      # never reach a device. install_signed_cert installs the device's OWN
+      # LEAF, not a trust anchor. Measured on a live rig after doing everything
+      # the SDK offers: `show certificate root-ca-cert | include skyforge`
+      # returned nothing on both controllers.
+      #
+      # So the device has to be handed the anchor out of band, and day-0 over
+      # the serial console is the only channel that exists before certificates
+      # work. The injector places this PEM and runs `request root-cert-chain
+      # install`; see the initial/cisco_sdwan-*.j2 templates.
+      #
+      # NEVER THE PRIVATE KEY. Only the certificate belongs in a rendered
+      # artefact -- the key stays where signing happens. A day-0 file is a
+      # Kubernetes Secret that netlab writes to disk on the runner; treating it
+      # as a place for signing material would put the fabric's CA key in every
+      # node_files directory and every snapshot.
+      root_ca_pem: str
+      # WHERE THE SIGNING MATERIAL LIVES ON THE RUNNER. Paths only -- the key
+      # itself is deployment material that the platform mounts, and it never
+      # appears in the topology, in a rendered artefact or in git.
+      #
+      # The lane READS these and refuses to run if they are absent. It used to
+      # generate a CA on the fly instead, which is stable only for as long as
+      # the pod it lands on: a second run minted a second CA while the devices
+      # still trusted the first, and the mismatch surfaced at certificate
+      # install as "root-ca-chain unable to validate the certificate" -- a trust
+      # error naming neither of the two CAs involved.
+      ca_cert_path: str
+      ca_key_path: str
+    lifecycle: { type: dict }
+    capacity: { type: dict }
+    inventory: { type: dict }
+  node:
+    type: { type: str, valid_values: [ manager, controller, validator, analytics, edge ] }
+    site_id: { type: int, min_value: 1 }
+    system_ip: { type: ipv4, use: address }
+    # WAN-EDGE BOARD IDENTITY, for a VIRTUAL edge (cat8000v in controller mode).
+    #
+    # A virtual edge has no SUDI: its chassis number and one-time token are
+    # whatever its bootstrap says they are (vinitparam uuid/otp), and the
+    # fabric admits it only if a controller holds the SAME pair in its vEdge
+    # list. Cisco's PnP portal mints these; a lab has no portal, so the pair
+    # is authorised on the manager with `request vedge add chassis-num <uuid>
+    # serial-num <token>` (present on vManage 20.18.4 and vBond, measured
+    # 2026-09-06) and the SAME pair is rendered into the edge's day-0.
+    #
+    # Both default to DETERMINISTIC values derived by the module (see
+    # _push_overlay_facts), so a re-render is byte-stable and a re-driven
+    # onboarding authorises the identity the device already carries. Set
+    # them explicitly to carry a portal-issued identity instead.
+    chassis: str
+    token: str
+    transport:
+      type: list
+      make_list: True
+      _subtype: _sdwan_transport
+    service_vpns:
+      type: dict
+      _keytype: int
+      _subtype:
+        interfaces:
+          type: list
+          make_list: True
+          _subtype: str
+    # THE SERVICE SIDE OF A WAN EDGE, day-1.
+    #
+    # An edge with only VPN 0 and VPN 512 is enrolled and routes nothing: the
+    # site behind it is unreachable over the overlay because no service VRF
+    # exists to carry it. `service_vpn` names the VPN every OTHER addressed
+    # data interface of the edge lands in -- every interface that is neither
+    # transport nor management, which netlab already knows from the links --
+    # so the author never names an interface. A link can pin a different VPN
+    # with `sdwan.vpn` (below).
+    #
+    # NOT DAY-0. The CVAC bootstrap (initial/cat8000v-kne.j2) is deliberately
+    # untouched by this: the day-0 was hard fought and stays what it is. The
+    # service side is rendered by the sdwan module into the MANAGER's
+    # onboarding intent and delivered by vManage as a CLI template, after the
+    # edge has been admitted (tasks/cisco_sdwan-manager/sdwan_service_vpns.yml).
+    # The routing protocol the site speaks comes from the edge's own netlab
+    # modules (ospf / bgp / eigrp): netlab computes areas, neighbours and
+    # router-ids the way it does for every other router; the module keeps
+    # those modules OUT of the edge's startup-config (skip_config) and
+    # renders them into the service VRF instead.
+    service_vpn: { type: int, min_value: 1 }
+  link:
+    role: { type: str, valid_values: [ transport, service, management ] }
+    color: str
+    # The service VPN this link's edge interface belongs to. Implies
+    # role: service. Overrides the node's service_vpn for this link.
+    vpn: { type: int, min_value: 1 }
+    # DIA (Direct Internet Access): this edge's own transport interface NATs
+    # its service VPN's traffic out, instead of only carrying the SD-WAN
+    # tunnels. Meaningful on role: transport only; a role: service interface
+    # never sets this itself (see _edge_service_intent, which derives
+    # service.nat from the edge's transport interfaces).
+    nat: bool
+  interface:
+    role: { type: str, valid_values: [ transport, service, management ] }
+    color: str
+    vpn: { type: int, min_value: 1 }
+    nat: bool
+
+_top:
+  attributes:
+    _sdwan_transport:
+      interface: str
+      color: str
+      public_ip: bool
+
+features:
+  types: Supported SD-WAN node types
+
+warnings:
+  inactive: True
