@@ -0,0 +1,823 @@
+#!/usr/bin/env python3
+"""The service side of a WAN edge, delivered through vManage: prepare and read back.
+
+WHY THIS EXISTS. A controller-mode C8000V takes its configuration from what
+vManage attaches to it, and vManage attaches WHOLE configurations: a CLI
+template is the entire running configuration of the device, not a fragment.
+So "add a service VRF" means "the configuration the device runs today, plus
+the service VRF", and the only honest source for "what the device runs today"
+is vManage's own copy of the running configuration -- the same thing its UI
+offers as "Load running config from reachable device" when a CLI template is
+built by hand. This script does that step with the SDK, grafts the overlay
+netlab rendered for the edge, and writes the file the collection's
+cli_templates module takes. After the attach it reads back, again from
+vManage, what the device actually runs, what the controller's OMP table carries
+for it (asked per expected prefix -- the unfiltered table is a WINDOW, see
+_omp_rows) and what the edge itself advertises, because an attach task's
+"success" is what vManage was TOLD, not what the site can reach.
+
+THIS USES THE SDK, NOT HAND-ROLLED REST. The session is the one the collection
+builds (create_manager_session); the running configuration comes from the
+SDK's own CLITemplate.load_running (GET /template/config/running/{uuid}); the
+device is found through session.api.devices.get(); the OMP tables are read
+on the paths the SDK's own OmpAPI uses (get_received_routes,
+get_advertised_routes, get_omp_peers: /device/omp/routes/received,
+/device/omp/routes/advertised, /device/omp/peers, all ?deviceId=), through
+the session's get_data, because the SDK's dataclasses for them keep only
+protocol and peer and this needs the prefix, the VPN and the originator.
+
+IDEMPOTENT BY CONSTRUCTION. The overlay names the blocks it OWNS (paths of
+block headers: `vrf definition 200`, `interface GigabitEthernet2`,
+`router ospf 200 vrf 200`, `sdwan / omp / address-family ipv4 vrf 200`, ...).
+Those are stripped from the running configuration before the overlay is
+grafted -- so on a second run, where the running configuration already
+carries them, the result is the same file, the collection's own diff finds
+no change, and nothing is pushed. A CHANGED overlay replaces its blocks
+rather than stacking beside them. Interface blocks are merged rather than
+replaced (the device's `negotiation auto` and friends survive); only the
+address-family lines this lane authors are owned there.
+
+REPORTING, NOT DECIDING. Every subcommand prints one JSON document and exits 0;
+the lane decides what a missing device or an unmerged block means, in the same
+way the admission read-back is reported and judged there. A reader that can
+itself fail is a second thing to debug at the moment the fabric is the first.
+
+Usage:
+  sdwan_service_vpn.py prepare  <input.json>
+  sdwan_service_vpn.py readback <input.json>
+  sdwan_service_vpn.py selftest
+
+prepare input:
+  {"credentials": {url, username, password, port}, "out_dir": "/tmp/...",
+   "edges": [{name, chassis, system_ip, overlay_file, owned_blocks}]}
+readback input:
+  {"credentials": {...},
+   "edges": [{name, chassis, system_ip, vpn, owned_blocks, expect_prefixes}],
+   "controller_system_ips": ["10.255.1.1"], "poll_seconds": 300, "poll_interval": 15}
+"""
+
+import json
+import os
+import re
+import sys
+import time
+import traceback
+
+# ---------------------------------------------------------------- config tree
+#
+# IOS configuration as a tree of blocks by indentation (one space per level in
+# IOS-XE's own rendering, and in ours). `!` lines are separators, not config,
+# and are dropped on parse and re-emitted between top-level blocks. `exit`
+# lines inside the `sdwan` block ARE kept: controller-mode IOS-XE renders them
+# and its parser expects them, so they stay exactly where they were.
+
+DROP_LINE = re.compile(r"^(Building configuration|Current configuration|end\s*$)")
+
+# Children of an INTERFACE block this lane authors. Everything else in the
+# block (negotiation auto, mtu, ...) belongs to the device and survives.
+OWNED_INTERFACE_CHILD = re.compile(
+    r"^(no )?(description\b|vrf forwarding\b|ip address\b|shutdown\b|ip ospf\b|ip router\b)"
+)
+
+
+class Node:
+    __slots__ = ("header", "children")
+
+    def __init__(self, header):
+        self.header = header
+        self.children = []
+
+    def find(self, header):
+        for c in self.children:
+            if c.header == header:
+                return c
+        return None
+
+
+def parse(text):
+    root = Node("")
+    stack = [(-1, root)]
+    for raw in text.splitlines():
+        line = raw.rstrip()
+        if not line.strip():
+            continue
+        stripped = line.strip()
+        if stripped.startswith("!") or DROP_LINE.match(stripped):
+            continue
+        indent = len(line) - len(line.lstrip(" "))
+        node = Node(stripped)
+        while stack and stack[-1][0] >= indent:
+            stack.pop()
+        stack[-1][1].children.append(node)
+        stack.append((indent, node))
+    return root
+
+
+def _emit(node, depth, out):
+    out.append(" " * depth + node.header)
+    for c in node.children:
+        _emit(c, depth + 1, out)
+
+
+def serialize(root):
+    out = []
+    for c in root.children:
+        _emit(c, 0, out)
+        if c.children:
+            out.append("!")
+    return "\n".join(out) + "\n"
+
+
+def _first_word(header):
+    return header.split(" ", 1)[0]
+
+
+def strip_owned(root, owned_blocks):
+    """Remove the blocks the overlay owns. Interface blocks keep their unowned lines."""
+    removed = []
+    for path in owned_blocks:
+        parents = [root]
+        for i, header in enumerate(path):
+            last = i == len(path) - 1
+            nxt = []
+            for p in parents:
+                for c in list(p.children):
+                    if c.header != header:
+                        continue
+                    if not last:
+                        nxt.append(c)
+                    elif header.startswith("interface "):
+                        before = len(c.children)
+                        c.children = [k for k in c.children if not OWNED_INTERFACE_CHILD.match(k.header)]
+                        if before != len(c.children):
+                            removed.append("/".join(path))
+                    else:
+                        p.children.remove(c)
+                        removed.append("/".join(path))
+            parents = nxt
+    return removed
+
+
+def _insert_top_level(root, node):
+    """Place a new top-level block where IOS expects its kind, not at the end.
+
+    `vrf definition` before the interfaces that reference it, interfaces after
+    the last interface, routers after the last interface/router and before
+    `sdwan`; a kind the base has none of goes after the last interface, and
+    anything else at the end.
+    """
+    kind = _first_word(node.header)
+    idx = None
+    for i, c in enumerate(root.children):
+        if _first_word(c.header) == kind:
+            idx = i
+    if idx is None and kind == "router":
+        for i, c in enumerate(root.children):
+            if _first_word(c.header) in ("interface", "router"):
+                idx = i
+    if idx is None:
+        root.children.append(node)
+    else:
+        root.children.insert(idx + 1, node)
+
+
+def _insert_child(parent, node):
+    """Under a container, insert before a trailing `exit` so the block stays closed."""
+    if parent.children and parent.children[-1].header == "exit":
+        parent.children.insert(len(parent.children) - 1, node)
+    else:
+        parent.children.append(node)
+
+
+def graft(base, overlay, depth=0):
+    for onode in overlay.children:
+        match = base.find(onode.header)
+        if match is None:
+            if depth == 0:
+                _insert_top_level(base, onode)
+            else:
+                _insert_child(base, onode)
+        else:
+            graft(match, onode, depth + 1)
+
+
+def merge(running_text, overlay_text, owned_blocks):
+    base = parse(running_text)
+    removed = strip_owned(base, owned_blocks)
+    graft(base, parse(overlay_text))
+    return serialize(base), removed
+
+
+def has_path(root, path):
+    nodes = [root]
+    for header in path:
+        nodes = [c for n in nodes for c in n.children if c.header == header]
+        if not nodes:
+            return False
+    return True
+
+
+# ---------------------------------------------------------------- the SDK side
+
+
+def _load(path):
+    with open(path, "r") as fh:
+        return json.load(fh)
+
+
+def _session(creds):
+    from catalystwan.session import create_manager_session
+
+    return create_manager_session(
+        url=str(creds.get("url", "")),
+        username=str(creds.get("username", "")),
+        password=str(creds.get("password", "")),
+        port=int(creds.get("port", 443) or 443),
+    )
+
+
+def _find_device(session, edge):
+    """The vManage device record for an edge: by chassis (its uuid), then hostname.
+
+    An edge admitted through `request vedge add` carries its chassis as the
+    device uuid; the record exists in /device once its first control
+    connection to vManage is up. Absent means "not visible to vManage yet",
+    which the lane reports as NOT_ATTEMPTED with this reason.
+    """
+    devices = session.api.devices.get()
+    chassis = str(edge.get("chassis", "") or "")
+    name = str(edge.get("name", "") or "")
+    found = None
+    if chassis:
+        found = devices.filter(uuid=chassis).single_or_default()
+    if found is None and name:
+        found = devices.filter(hostname=name).single_or_default()
+    return found
+
+
+def _running_config(session, device):
+    from catalystwan.api.templates.cli_template import CLITemplate
+
+    tpl = CLITemplate(template_name="", template_description="", device_model="vedge-C8000V")
+    cfg = tpl.load_running(session, device)
+    return "\n".join(cfg.ioscfg)
+
+
+def _device_facts(device):
+    return {
+        "hostname": str(getattr(device, "hostname", "") or ""),
+        "uuid": str(getattr(device, "uuid", "") or ""),
+        "model": str(getattr(device, "model", "") or ""),
+        "reachability": str(getattr(getattr(device, "reachability", ""), "value", getattr(device, "reachability", "")) or ""),
+        "system_ip": str(getattr(device, "local_system_ip", "") or getattr(device, "id", "") or ""),
+    }
+
+
+def prepare(inp):
+    out_dir = str(inp.get("out_dir", "") or "/tmp/sdwan-service")
+    os.makedirs(out_dir, mode=0o700, exist_ok=True)
+    results = []
+    session = None
+    session_error = ""
+    try:
+        session = _session(inp.get("credentials", {}))
+    except Exception as exc:  # noqa: BLE001 - evidence, never a verdict
+        session_error = f"no vManage session: {exc}"
+
+    # EVERY path below must append exactly one entry. Anything raised BEFORE
+    # the per-edge try -- a malformed element, a non-dict input -- used to
+    # escape to the top-level handler, which turns the whole run into
+    # {"error": ...} with exit 0, and the Ansible reader only looks at
+    # .edges. Four edges in, zero out, no reason anywhere. Guard it here so a
+    # bad element costs one edge and names itself.
+    raw_edges = inp.get("edges", []) if isinstance(inp, dict) else []
+    for index, edge in enumerate(raw_edges):
+        if not isinstance(edge, dict):
+            results.append({
+                "name": f"#{index}", "ok": False, "config_file": "",
+                "reason": f"input edge #{index} is a {type(edge).__name__}, not an object",
+            })
+            continue
+        name = str(edge.get("name", "") or "")
+        entry = {"name": name, "ok": False, "reason": "", "config_file": ""}
+        if session is None:
+            entry["reason"] = session_error
+            results.append(entry)
+            continue
+        try:
+            device = _find_device(session, edge)
+            if device is None:
+                entry["reason"] = (
+                    "vManage lists no device with this chassis or hostname; an edge is visible to "
+                    "template attach only once its control connection to vManage is up"
+                )
+                results.append(entry)
+                continue
+            entry["device"] = _device_facts(device)
+            running = _running_config(session, device)
+            with open(str(edge.get("overlay_file", "")), "r") as fh:
+                overlay = fh.read()
+            merged, removed = merge(running, overlay, edge.get("owned_blocks", []) or [])
+            path = os.path.join(out_dir, f"{name}.cfg")
+            with open(path, "w") as fh:
+                fh.write(merged)
+            os.chmod(path, 0o600)
+            entry.update({
+                "ok": True,
+                "config_file": path,
+                "base_lines": len(running.splitlines()),
+                "merged_lines": len(merged.splitlines()),
+                "replaced_blocks": removed,
+                "already_carried": bool(removed),
+            })
+        except Exception as exc:  # noqa: BLE001
+            entry["reason"] = f"{type(exc).__name__}: {exc}"
+        results.append(entry)
+
+    try:
+        if session is not None:
+            session.close()
+    except Exception:  # noqa: BLE001
+        pass
+    # input_edges is what makes "the helper was handed nothing" distinguishable
+    # from "the helper dropped everything" without the input file, which is
+    # written no_log and deleted before anything can read it back.
+    return {"edges": results, "input_edges": len(raw_edges), "session_error": session_error}
+
+
+def _omp_query(session, path, params):
+    """One OMP real-time query; rows or [{"error": ...}], never an exception."""
+    query = "&".join(f"{k}={v}" for k, v in params.items() if v not in ("", None))
+    try:
+        items = session.get_data(f"/dataservice/device/omp/{path}?{query}")
+    except Exception as exc:  # noqa: BLE001
+        return [{"error": f"{path}?{query}: {exc}"}]
+    return list(items or [])
+
+
+def _omp_rows(session, path, device_ip, vpn, prefix=""):
+    """OMP rows for one device, narrowed on the server when vManage lets us.
+
+    THE CONTROLLER'S RECEIVED TABLE IS A WINDOW, NOT THE TABLE. Three demo-lab
+    runs (131674, 136222, 137827) read the vSmart's received routes unfiltered
+    and every one of them came back with the five numerically LOWEST prefixes
+    of VPN 200 -- 10.0.0.4-7/32 and 10.0.0.10/32 in two runs, 10.0.0.10/32 and
+    10.0.0.15-18/32 in the third -- whichever edge had originated them, and
+    never a connected /30 or a loopback above 10.0.0.10. So three edges whose
+    configuration had landed read as omp_seen=[] and the one whose site
+    loopbacks sorted lowest read as half-routed. An unfiltered real-time
+    query is evidence of the first page, nothing more.
+
+    So ask for LESS: the real-time API takes the show command's own keys
+    (`show omp routes vpn N <prefix>`) as query parameters. Narrow to the VPN
+    and, when asked, to the one prefix, and fall back a step at a time when
+    vManage refuses a parameter -- an old vManage that ignores an unknown key
+    returns the same window as before, which is no worse than today. Every
+    row returned carries which filter produced it, so the evidence line can
+    say whether the answer came from a narrowed query or from the window.
+    """
+    attempts = [{"deviceId": device_ip, "vpn-id": vpn, "prefix": prefix}]
+    if prefix:
+        attempts.append({"deviceId": device_ip, "vpn-id": vpn})
+    attempts.append({"deviceId": device_ip})
+    errors = []
+    for params in attempts:
+        rows = _omp_query(session, path, params)
+        if rows and all(isinstance(r, dict) and "error" in r for r in rows):
+            errors.extend(r["error"] for r in rows)
+            continue
+        narrowed = "prefix" if params.get("prefix") else ("vpn" if params.get("vpn-id") not in ("", None) else "none")
+        return [r for r in rows if isinstance(r, dict)], narrowed, errors
+    return [], "none", errors
+
+
+def _rows_for_vpn(rows, vpn):
+    return [r for r in rows if str(r.get("vpn-id", "")) in ("", str(vpn))]
+
+
+def _routes_from(items, system_ip, vpn):
+    """Prefixes the controller holds for VPN `vpn` that this edge originated."""
+    seen = set()
+    for it in items:
+        if not isinstance(it, dict) or "error" in it:
+            continue
+        origin = str(it.get("originator", "") or it.get("tloc-ip", "") or it.get("from-peer", "") or "")
+        if origin != system_ip:
+            continue
+        if str(it.get("vpn-id", "")) not in ("", str(vpn)):
+            continue
+        prefix = str(it.get("prefix", "") or "")
+        if prefix:
+            seen.add(prefix)
+    return seen
+
+
+def _advertised_by(items, vpn):
+    """prefix -> protocol, for what the edge itself advertises into OMP for `vpn`."""
+    out = {}
+    for it in _rows_for_vpn(items, vpn):
+        prefix = str(it.get("prefix", "") or "")
+        if prefix:
+            out[prefix] = str(it.get("protocol", "") or "")
+    return out
+
+
+def _peer_states(items):
+    return sorted(
+        f"{it.get('peer', '') or it.get('peer-ip', '')}:{it.get('type', '')}:{it.get('state', '')}"
+        for it in items if isinstance(it, dict) and "error" not in it
+    )
+
+
+def judge_routing(expected, seen_on_controller, advertised_by_edge, peers):
+    """The routing verdict for one edge, from both witnesses.
+
+    ROUTED needs the CONTROLLER to carry every prefix the edge originates --
+    that is what the far sites will route on. The edge's own advertised table
+    is the second witness: it separates "the edge never sent it" (the service
+    VRF is not in OMP: peer down, VRF not advertised, interface down) from
+    "the edge sent it and the controller does not list it" (the window, a
+    policy, or the controller itself). The reason names which.
+    """
+    expected = sorted(str(p) for p in expected)
+    seen = set(seen_on_controller)
+    adv = dict(advertised_by_edge)
+    missing = [p for p in expected if p not in seen]
+    not_advertised = [p for p in expected if p not in adv]
+    routed = bool(expected) and not missing
+    if routed:
+        reason = ""
+    elif not expected:
+        reason = "the intent expects no prefix from this edge, so nothing can prove it routed"
+    elif not_advertised:
+        up = [p for p in peers if p.endswith(":up")]
+        reason = (
+            f"the edge does not advertise {', '.join(not_advertised)} into OMP"
+            + (f" (OMP peers up: {', '.join(up)})" if up else f" (no OMP peer is up: {', '.join(peers) or 'none listed'})")
+        )
+    else:
+        reason = (
+            f"the edge advertises {', '.join(missing)} but the controller's received table does not list them from it"
+        )
+    return {
+        "routed": routed,
+        "missing": missing,
+        "not_advertised": not_advertised,
+        "reason": reason,
+    }
+
+
+def readback(inp):
+    edges = list(inp.get("edges", []))
+    controllers = [str(x) for x in inp.get("controller_system_ips", []) or []]
+    budget = int(inp.get("poll_seconds", 300) or 300)
+    interval = int(inp.get("poll_interval", 15) or 15)
+    results = {e.get("name"): {"name": e.get("name"), "config_ok": False, "missing_blocks": [], "reason": ""} for e in edges}
+
+    try:
+        session = _session(inp.get("credentials", {}))
+    except Exception as exc:  # noqa: BLE001
+        for r in results.values():
+            r["reason"] = f"no vManage session: {exc}"
+        return {"edges": list(results.values())}
+
+    # The configuration half: what the device runs, as vManage reads it.
+    for edge in edges:
+        r = results[edge.get("name")]
+        try:
+            device = _find_device(session, edge)
+            if device is None:
+                r["reason"] = "vManage lists no device with this chassis or hostname"
+                continue
+            r["device"] = _device_facts(device)
+            tree = parse(_running_config(session, device))
+            missing = [ "/".join(p) for p in (edge.get("owned_blocks", []) or []) if not has_path(tree, p) ]
+            r["missing_blocks"] = missing
+            r["config_ok"] = not missing
+        except Exception as exc:  # noqa: BLE001
+            r["reason"] = f"{type(exc).__name__}: {exc}"
+
+    # The routing half, polled, because an adjacency that has just come up
+    # needs a moment before OMP carries it. Two witnesses per edge, every
+    # attempt: what the controller RECEIVED from this edge for the VPN (asked
+    # per expected prefix, so a windowed table cannot hide one), and what the
+    # edge itself ADVERTISES for the VPN plus its OMP peer states. Bounded by
+    # poll_seconds; stops early once every edge is routed or cannot be.
+    started = time.time()
+    deadline = started + budget
+    attempts = 0
+    while True:
+        attempts += 1
+        pending = False
+        for edge in edges:
+            r = results[edge.get("name")]
+            expected = sorted(str(p) for p in (edge.get("expect_prefixes", []) or []))
+            sys_ip = str(edge.get("system_ip", "") or "")
+            vpn = edge.get("vpn", "")
+            seen = set()
+            errors = []
+            narrowed = set()
+            controller_rows = 0
+            for ip in controllers:
+                for prefix in expected:
+                    rows, how, errs = _omp_rows(session, "routes/received", ip, vpn, prefix)
+                    errors.extend(errs)
+                    narrowed.add(how)
+                    controller_rows += len(rows)
+                    seen |= _routes_from(rows, sys_ip, vpn)
+            # The edge's own advertised table, asked per expected prefix for
+            # the same reason (a site with many low-numbered loopbacks would
+            # push the edge's own /32 out of a window), then once bare for
+            # what the site sends beyond them.
+            advertised = {}
+            adv_how = "none"
+            if sys_ip:
+                for prefix in expected:
+                    rows, how, errs = _omp_rows(session, "routes/advertised", sys_ip, vpn, prefix)
+                    errors.extend(errs)
+                    adv_how = how
+                    advertised.update(_advertised_by(rows, vpn))
+                rows, _how, errs = _omp_rows(session, "routes/advertised", sys_ip, vpn)
+                errors.extend(errs)
+                for prefix, proto in _advertised_by(rows, vpn).items():
+                    advertised.setdefault(prefix, proto)
+            peer_rows = _omp_query(session, "peers", {"deviceId": sys_ip}) if sys_ip else []
+            errors.extend(p["error"] for p in peer_rows if isinstance(p, dict) and "error" in p)
+            peers = _peer_states(peer_rows)
+            verdict = judge_routing(expected, seen, advertised, peers)
+            r["omp"] = {
+                "controllers": controllers,
+                "expected": expected,
+                "seen": sorted(seen & set(expected)),
+                "missing": verdict["missing"],
+                "not_advertised": verdict["not_advertised"],
+                # What the site sends through the edge beyond its own prefixes,
+                # with the protocol it arrived by -- the IGP/EGP seam's proof.
+                "site_prefixes": sorted(f"{p}({proto})" if proto else p for p, proto in advertised.items() if p not in expected),
+                "advertised": sorted(p for p in advertised if p in expected),
+                "peers": peers,
+                "routed": verdict["routed"],
+                "reason": verdict["reason"],
+                "attempts": attempts,
+                "waited_seconds": int(time.time() - started),
+                "controller_query": ",".join(sorted(narrowed)) or "none",
+                "controller_rows": controller_rows,
+                "edge_query": adv_how,
+                "errors": sorted(set(errors)),
+            }
+            if not verdict["routed"] and r.get("config_ok"):
+                pending = True
+        if not pending or time.time() >= deadline:
+            break
+        time.sleep(interval)
+
+    try:
+        session.close()
+    except Exception:  # noqa: BLE001
+        pass
+    return {"edges": list(results.values())}
+
+
+# ---------------------------------------------------------------- self-test
+
+SELFTEST_BASE = """Building configuration...
+
+Current configuration : 4 bytes
+!
+version 17.18
+hostname cdg-vedge01
+!
+vrf definition Mgmt-intf
+ address-family ipv4
+ exit-address-family
+!
+username admin privilege 15 secret 9 REDACTED
+!
+interface GigabitEthernet1
+ description management
+ vrf forwarding Mgmt-intf
+ ip address dhcp
+ negotiation auto
+!
+interface GigabitEthernet2
+ no ip address
+ negotiation auto
+!
+interface GigabitEthernet3
+ description transport biz-internet
+ ip address 10.1.0.205 255.255.255.252
+ negotiation auto
+!
+interface Tunnel1
+ ip unnumbered GigabitEthernet3
+ tunnel source GigabitEthernet3
+ tunnel mode sdwan
+!
+ip route 0.0.0.0 0.0.0.0 10.1.0.206
+!
+sdwan
+ interface GigabitEthernet3
+  tunnel-interface
+   encapsulation ipsec
+   color biz-internet
+  exit
+ exit
+ omp
+  no shutdown
+  graceful-restart
+  address-family ipv4
+   advertise bgp
+   advertise connected
+   advertise static
+  !
+  address-family ipv6
+   advertise bgp
+  !
+ !
+!
+line vty 0 4
+ transport input ssh
+!
+end
+"""
+
+SELFTEST_OVERLAY = """vrf definition 200
+ rd 1:200
+ address-family ipv4
+  route-target export 1:200
+  route-target import 1:200
+ exit-address-family
+!
+interface Loopback0
+ vrf forwarding 200
+ ip address 10.0.0.10 255.255.255.255
+ ip ospf 200 area 0.0.0.0
+!
+interface GigabitEthernet2
+ description service VPN 200 to cdg-fw01
+ vrf forwarding 200
+ ip address 10.1.0.162 255.255.255.252
+ ip ospf 200 area 0.0.0.0
+ ip ospf network broadcast
+ no shutdown
+!
+router ospf 200 vrf 200
+ router-id 10.0.0.10
+ redistribute omp
+!
+sdwan
+ omp
+  address-family ipv4 vrf 200
+   advertise connected
+   advertise static
+   advertise ospf external
+  !
+ !
+!
+"""
+
+SELFTEST_OWNED = [
+    ["vrf definition 200"],
+    ["interface Loopback0"],
+    ["interface GigabitEthernet2"],
+    ["router ospf 200 vrf 200"],
+    ["sdwan", "omp", "address-family ipv4 vrf 200"],
+]
+
+
+def selftest():
+    merged, removed = merge(SELFTEST_BASE, SELFTEST_OVERLAY, SELFTEST_OWNED)
+    tree = parse(merged)
+    tops = [c.header for c in tree.children]
+    assert removed == ["interface GigabitEthernet2"], removed          # only the bare interface had owned lines
+    assert tops.count("vrf definition 200") == 1, tops
+    assert tops.index("vrf definition 200") == tops.index("vrf definition Mgmt-intf") + 1, tops
+    assert tops.index("router ospf 200 vrf 200") < tops.index("sdwan"), tops
+    assert tops.index("interface Loopback0") > tops.index("interface Tunnel1"), tops
+    gi2 = tree.find("interface GigabitEthernet2")
+    heads = [c.header for c in gi2.children]
+    assert "no ip address" not in heads and "negotiation auto" in heads, heads
+    assert heads.index("vrf forwarding 200") < heads.index("ip address 10.1.0.162 255.255.255.252"), heads
+    omp = tree.find("sdwan").find("omp")
+    afs = [c.header for c in omp.children if c.header.startswith("address-family")]
+    assert afs.count("address-family ipv4 vrf 200") == 1, afs
+    sd = [c.header for c in tree.find("sdwan").children]
+    assert sd[:2] == ["interface GigabitEthernet3", "exit"], f"sdwan block lost its exits: {sd}"
+    assert sd[-1] == "omp", sd
+    assert "username admin privilege 15 secret 9 REDACTED" in tops, "base lines must survive"
+    for p in SELFTEST_OWNED:
+        assert has_path(tree, p), p
+    # IDEMPOTENT: merging the merged output again with the same overlay is a no-op.
+    again, removed2 = merge(merged, SELFTEST_OVERLAY, SELFTEST_OWNED)
+    assert again == merged, "second merge changed the file"
+    assert sorted(removed2) == sorted("/".join(p) for p in SELFTEST_OWNED), removed2
+    # A CHANGED overlay replaces, never stacks.
+    changed = SELFTEST_OVERLAY.replace("advertise ospf external\n", "").replace("redistribute omp\n", "")
+    third, _ = merge(merged, changed, SELFTEST_OWNED)
+    t3 = parse(third)
+    assert [c.header for c in t3.children].count("router ospf 200 vrf 200") == 1
+    assert not has_path(t3, ["router ospf 200 vrf 200", "redistribute omp"])
+    assert not has_path(t3, ["sdwan", "omp", "address-family ipv4 vrf 200", "advertise ospf external"])
+    # NEGATIVE CONTROL: an owned block the device lacks is reported missing.
+    assert not has_path(parse(SELFTEST_BASE), ["vrf definition 200"])
+
+    # THE ROUTING JUDGEMENT, both witnesses. Routed only when the CONTROLLER
+    # carries every expected prefix; the reason names which witness failed.
+    exp = ["10.0.0.10/32", "10.1.0.160/30"]
+    ok = judge_routing(exp, {"10.0.0.10/32", "10.1.0.160/30", "10.0.0.4/32"}, {"10.0.0.10/32": "connected"}, ["10.255.1.1:vsmart:up"])
+    assert ok["routed"] and ok["missing"] == [] and ok["reason"] == "", ok
+    sent = judge_routing(exp, {"10.0.0.10/32"}, {"10.0.0.10/32": "connected", "10.1.0.160/30": "connected"}, ["10.255.1.1:vsmart:up"])
+    assert not sent["routed"] and sent["missing"] == ["10.1.0.160/30"] and "controller's received table" in sent["reason"], sent
+    silent = judge_routing(exp, set(), {}, ["10.255.1.1:vsmart:down"])
+    assert not silent["routed"] and silent["not_advertised"] == exp and "no OMP peer is up" in silent["reason"], silent
+    assert not judge_routing([], set(), {}, [])["routed"], "no expectation can never be routed"
+
+    # THE NARROWED QUERY FALLS BACK, a step at a time, and says what it asked.
+    class _Refuses:
+        """A vManage that refuses `prefix=` and windows the unfiltered table."""
+        def __init__(self):
+            self.calls = []
+        def get_data(self, url):
+            self.calls.append(url)
+            if "prefix=" in url:
+                raise RuntimeError("400 Bad Request")
+            rows = [{"vpn-id": "200", "prefix": f"10.0.0.{i}/32", "originator": "10.255.0.100"} for i in (4, 5, 6, 7, 10)]
+            if "vpn-id=" in url:
+                rows.append({"vpn-id": "200", "prefix": "10.1.0.160/30", "originator": "10.255.0.100"})
+            return rows
+    fake = _Refuses()
+    rows, how, errs = _omp_rows(fake, "routes/received", "10.255.1.1", 200, "10.1.0.160/30")
+    assert how == "vpn" and len(errs) == 1 and "400" in errs[0], (how, errs)
+    assert "10.1.0.160/30" in _routes_from(rows, "10.255.0.100", 200), rows
+    assert [u.count("&") for u in fake.calls] == [2, 1], fake.calls   # prefix+vpn, then vpn; never the bare window
+    class _Blind:
+        def get_data(self, url):
+            raise RuntimeError("503")
+    rows, how, errs = _omp_rows(_Blind(), "routes/received", "10.255.1.1", 200, "10.1.0.160/30")
+    assert rows == [] and how == "none" and len(errs) == 3, (how, errs)
+    assert _advertised_by([{"vpn-id": "200", "prefix": "172.21.0.0/16", "protocol": "ospf-external"},
+                           {"vpn-id": "0", "prefix": "0.0.0.0/0", "protocol": "static"}], 200) == {"172.21.0.0/16": "ospf-external"}
+    assert _peer_states([{"peer": "10.255.1.1", "type": "vsmart", "state": "up"}, {"error": "x"}]) == ["10.255.1.1:vsmart:up"]
+    return {"selftest": "ok", "merged_lines": len(merged.splitlines()), "top_level": tops}
+
+
+def main(argv):
+    if len(argv) < 2:
+        print(json.dumps({"error": "usage: sdwan_service_vpn.py prepare|readback <input.json> | selftest"}))
+        return 0
+    cmd = argv[1]
+
+    # THIS PROGRAM'S STDOUT IS ITS PROTOCOL. The caller parses it as one JSON
+    # object and nothing else may write there.
+    #
+    # It did, and it cost a full lab run. ciscoconfparse (imported underneath
+    # catalystwan's CLITemplate) emits a loguru banner on import:
+    #
+    #   <ansi>2026-09-08 01:32:10.701 | INFO | ciscoconfparse...:701 -
+    #   As of version 1.9.17 and later, `ignore_blank_lines=True` is only
+    #   honored when `factory=True`{"edges": [{"name": "site1-edge01", ...
+    #
+    # The document was CORRECT and complete -- it just no longer started at
+    # byte 0, so the reader's `startswith('{')` guard discarded all of it and
+    # every edge came back NOT_ATTEMPTED (run 96240).
+    #
+    # Rather than chase whichever library prints next, take stdout away from
+    # all of them: point it at stderr for the duration of the work, and only
+    # restore the real one to emit the document. A library that wants to talk
+    # is still heard -- on the stream meant for talking.
+    real_stdout = sys.stdout
+    sys.stdout = sys.stderr
+    try:
+        if cmd == "selftest":
+            doc = selftest()
+        elif cmd == "prepare":
+            doc = prepare(_load(argv[2]))
+        elif cmd == "readback":
+            doc = readback(_load(argv[2]))
+        else:
+            doc = {"error": f"unknown subcommand {cmd}"}
+    except Exception as exc:  # noqa: BLE001 - evidence, never a verdict
+        # KEEP THE SHAPE. The Ansible reader consumes .edges and nothing else,
+        # so an {"error": ...} document with no edges key renders as `edges=[]`
+        # -- identical on the wire to "the helper was handed nothing" and to
+        # "stdout never arrived". Three different failures, one indistinguish-
+        # able line. Carry an empty edges list and the traceback so the caller
+        # can tell them apart.
+        doc = {
+            "error": f"{type(exc).__name__}: {exc}",
+            "traceback": traceback.format_exc(),
+            "edges": [],
+        }
+    sys.stdout = real_stdout
+    print(json.dumps(doc))
+    # AND on stderr. stdout is the thing that goes missing when the script
+    # module hands this file to /bin/sh (patch 0048, demo-lab run 86401: rc=2,
+    # empty stdout, traceback on stderr). A failure that only ever names
+    # itself on the channel that disappeared cannot be diagnosed.
+    if doc.get("error"):
+        print(f"sdwan-service-helper-error: {doc['error']}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/sdwan.yml b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan.yml
new file mode 100644
index 0000000..d210340
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan.yml
@@ -0,0 +1,863 @@
+#
+# SD-WAN fabric onboarding, driven through the VENDOR'S OWN collection.
+#
+# WHY THERE IS NO REST IN THIS FILE
+# =================================
+# This lane used to be ~480 lines of hand-written `uri` calls: a two-step form
+# login, a CSRF token, cookie juggling, and a set of endpoint paths and payload
+# shapes reverse-engineered from a running vManage. Every one of those was a
+# private contract we had guessed at, re-derived on each version bump, and got
+# wrong in ways that reported success -- vManage answers a BAD login with its
+# login page and HTTP 200, so a "working" lane could be logging in to nothing.
+#
+# cisco.catalystwan is the vendor's supported surface over the same API, and it
+# carries the parts that were most expensive to learn by hand:
+#   * session establishment, CSRF and re-auth
+#   * read-before-write, so re-running is not a destructive act
+#   * TASK POLLING -- the API returns a task id and a 200 means QUEUED, not
+#     done. Reading the 200 as success reports a green install over a
+#     certificate the device rejected.
+#
+# NOTHING HERE LOGS INTO A CONTROLLER. Every task is a statement to vManage
+# about the fabric; vManage owns SD-WAN device configuration, and a second
+# controller writing device config would fight it.
+#
+# EVERY CALL IS DELEGATED TO THE ANSIBLE HOST. The vManage node's own connection
+# is local; the API lives on HTTPS 443 and is reached from the runner.
+#
+# WHAT DAY-0 OWNS INSTEAD
+# =======================
+# Two things deliberately do NOT happen here, because they cannot:
+#
+#   THE PASSWORD TRANSITION. While the box holds the factory password every
+#   /dataservice/* answers 302 -> passwordReset.html on an otherwise valid
+#   session, so no session-based lane can perform the transition that unblocks
+#   its own session. vManage also refuses to KEEP the factory value ("USER0002:
+#   Password for admin user cannot be configured to default/last password").
+#   The serial injector now answers the forced first-boot prompt with the
+#   declared password, which removes the problem rather than sequencing around
+#   it.
+#
+#   THE ROOT CA. The SDK has no endpoint that pushes a trust anchor to a device
+#   -- 1025 endpoints across 125 files, zero matches for chain/trust/anchor/
+#   bundle/push/distribute. get/edit_enterprise_root_ca store the CA ON VMANAGE;
+#   install_signed_cert installs the device's OWN LEAF. Measured: after doing
+#   everything the SDK offers, `show certificate root-ca-cert` held no trace of
+#   our CA on either controller. Day-0 carries it (see
+#   initial/cisco_sdwan.rootca.j2) and carries nothing else.
+#
+---
+- name: "Resolve the vManage API endpoint and the fabric CA from netlab's own facts"
+  set_fact:
+    sdwan_api_host: "{{ (ansible_host | default(mgmt.ipv4 | default(''))) | string | regex_replace('/.*$', '') }}"
+    sdwan_api_user: "{{ ansible_user | default('admin') }}"
+    # ONE credential. Day-0 declares it, the serial injector sets it, and this
+    # reads the same value -- see sdwan.declared_password in the sdwan module.
+    # There is no factory fallback here on purpose: if the box still holds the
+    # factory password then day-0 did not complete, and quietly logging in with
+    # it would paper over that and leave a fabric nobody can administer.
+    sdwan_api_password: "{{ sdwan.declared_password | default(sdwan.api_password | default(ansible_password | default('admin'))) }}"
+    # THE FABRIC CA. Supplied WITH THE DEPLOYMENT, never minted here.
+    #
+    # This lane used to generate a CA on the fly with `openssl req ... creates:`.
+    # That is stable only for as long as the filesystem it lands on, and the
+    # netlab runner is EPHEMERAL -- so a second run produced a second CA while
+    # the devices still trusted the first. The devices then hold a chain from
+    # one CA and vManage signs with another, and the failure surfaces at
+    # certificate install as "root-ca-chain unable to validate the certificate":
+    # a trust error that names neither of the two CAs involved.
+    sdwan_ca_crt: "{{ sdwan.trust.ca_cert_path | default('/skyforge-secrets/sdwan-ca/ca.crt') }}"
+    sdwan_ca_key: "{{ sdwan.trust.ca_key_path | default('/skyforge-secrets/sdwan-ca/ca.key') }}"
+    # THE CADENCE IS 60s AND MUST STAY 60s. The readiness probe is an
+    # AUTHENTICATED call, and every attempt establishes a NEW session. vManage
+    # rate-limits session creation: probing every 10s for 30 minutes earned
+    #   ManagerHTTPError('429 Client Error: Too Many Requests for url:
+    #   .../dataservice/client/server')
+    # on a fresh boot -- the probe locked itself out of the appliance it was
+    # waiting for, and then could not tell that from "still booting". Measured
+    # 2026-09-01. Slow and few beats fast and many.
+    #
+    # THE BUDGET IS 60 MINUTES, AND THE OLD 30 WAS 20.7.1's NUMBER.
+    # The retired comment here read "MEASURED: isServerReady flipped true at
+    # T+20.5 min on a fresh 20.7.1 boot". That measurement does not transfer.
+    # 20.7.1 shipped TWO layers -- an OS disk plus a pre-made data qcow2 -- so
+    # its /opt/data arrived populated. 20.18.4 ships ONE, and the KubeVirt
+    # `data` volume is an emptyDisk (kne patches/0032), so on EVERY boot the
+    # appliance starts with a blank /opt/data and container-manager must unpack
+    # extra-packages.tar.gz and load all_containers_bundle.tar before dockerd
+    # can start and 443 can listen.
+    #
+    # MEASURED 2026-09-08 (run 98094, 7-node sdwan-service, 20.18.4-kne-r1, 16
+    # vCPU): the run failed here, and the appliance had still not served its
+    # API at T+55 min. Earlier runs on the SAME image cleared 30 minutes. So
+    # first-boot time is not a constant and 30 minutes sits inside its range,
+    # which makes the old budget a coin flip that fails a run in which
+    # everything else worked.
+    #
+    # SAID PLAINLY: this budget is NOT claimed to rescue that particular boot.
+    # At T+55m its data.qcow2 had been FLAT for 8 minutes across three samples
+    # (21317 -> 21325 MiB) at a steady 1.6 of 16 cores, with the guest console
+    # silent since T+4m after a burst of "Cannot connect to the Docker daemon".
+    # That is a boot that stopped making progress, not a slow one, and no
+    # timeout fixes it. 60 minutes is sized for the OTHER population -- boots
+    # that are genuinely slow because the cluster's disks are contended -- and
+    # deliberately not larger, because minutes spent waiting on a wedged
+    # appliance are minutes wasted.
+    #
+    # 60 x 60s = 60 min. The arithmetic that bounds it is demo-lab, the largest
+    # consumer: deployTimeoutSeconds 7200 (120 min), `netlab initial` measured
+    # at 18m11s, onboarding + service ~3 min => ~81 min, ~39 min of headroom.
+    # Raising this costs nothing when the appliance is quick: the loop exits on
+    # the first success.
+    #
+    # THE REAL FIX IS NOT A BIGGER TIMEOUT. Persist or pre-seed /opt/data so the
+    # unpack happens once instead of on every boot, and the whole population --
+    # slow and wedged alike -- goes away. Until then, this budget plus the
+    # witnesses named in the failure message below.
+    sdwan_api_ready_retries: "{{ sdwan.api_ready_retries | default(60) }}"
+    sdwan_api_ready_delay: "{{ sdwan.api_ready_delay | default(60) }}"
+
+- name: "Read the fabric onboarding intent netlab rendered"
+  set_fact:
+    sdwan_intent: "{{ lookup('template', config_template) | from_json }}"
+
+- name: "Refuse to onboard a fabric with no validator address"
+  fail:
+    msg: >
+      SD-WAN onboarding has no vbond address. Every device in the fabric must
+      dial the SAME validator, so there is nothing safe to configure without
+      it. The sdwan module derives this from the validator node's transport
+      address -- check that the topology has a validator and that it has one.
+  when: not sdwan_intent.vbond_address
+
+- name: "Build the manager credential the collection takes"
+  set_fact:
+    sdwan_manager_credentials:
+      url: "{{ sdwan_api_host }}"
+      username: "{{ sdwan_api_user }}"
+      password: "{{ sdwan_api_password }}"
+      port: 443
+  no_log: true
+
+- name: "Onboard the fabric"
+  delegate_to: localhost
+  block:
+  # READINESS IS AN AUTHENTICATED CALL THAT THE LANE ACTUALLY NEEDS TO WORK,
+  # and the budget lives here in Ansible rather than in a module.
+  #
+  # NOT wait_for_api_server. It takes timeout_seconds and appears to own the
+  # wait; it does not. Its tenacity retry fires only on (NewConnectionError,
+  # TimeoutError, requests ConnectionError, UnauthorizedAccessError), while
+  # create_manager_session raises catalystwan ManagerRequestException -- MRO
+  # RequestException -> OSError -> CatalystwanException, which is NOT a requests
+  # ConnectionError. So tenacity re-raises on the first attempt and the module's
+  # own except clause misses it too. Measured 2026-09-01 on a HEALTHY box:
+  # wait_for_api_server failed 30 consecutive times while devices_info, with the
+  # SAME credentials against the SAME address, returned the full controller
+  # inventory. A readiness probe that fails on a ready appliance is worse than
+  # no probe, because the lane then blames a 30-minute boot for a live API.
+  #
+  # devices_info is the honest gate: it is a collection module (so no
+  # hand-written REST enters this lane), and its success proves the three things
+  # the next task actually depends on -- the appliance answers, THE CREDENTIAL
+  # WORKS, and the device inventory is being served. wait_for_api_server proved
+  # only the first, when it worked at all.
+  #
+  # cisco.catalystwan.api_ready, the vendor's suggested replacement, waits with
+  # ansible.builtin.uri. That is precisely the hand-written REST this lane exists
+  # to remove, so it is deliberately not used.
+  #
+  # A REFUSED CONNECTION IN THE FIRST MINUTES IS EXPECTED, NOT A FAILURE.
+  # vManage serves plain HTML on 443 long before the application answers. On
+  # 20.18.4 the wait is much longer than 20.7.1's measured T+20.5 min because
+  # its /opt/data is blank on every boot -- see the budget note in the vars
+  # block above for the measurement and the arithmetic.
+  - name: "Wait for the vManage API to answer an authenticated call"
+    cisco.catalystwan.devices_info:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_category: controllers
+    register: sdwan_ready
+    # KEY OFF `devices`, NOT `failed`. failed_when: false STAMPS failed=false on
+    # EVERY result, so `until: not failed` is satisfied on the first attempt no
+    # matter what the appliance did -- the loop never loops and the assertion
+    # below can never fire. Measured: this gate passed instantly against a
+    # vManage whose API was still down, and the very next task died on
+    # "Connection refused ... /j_security_check". devices_info sets `devices`
+    # ONLY when the call actually returned an inventory, so that is the honest
+    # signal. (Same trap as the enrolment check further down, which is why that
+    # one keys off msg.)
+    until: sdwan_ready.devices is defined
+    retries: "{{ sdwan_api_ready_retries | int }}"
+    delay: "{{ sdwan_api_ready_delay | int }}"
+    # The module FAILS (rather than returning false) while the appliance is not
+    # listening, so the loop has to be allowed to keep going. The assertion below
+    # is what turns "never became ready" into a loud failure -- without it,
+    # failed_when:false would let a fabric that never booted read as a pass.
+    failed_when: false
+
+  - name: "Fail loudly if vManage never served its API"
+    fail:
+      msg: >
+        vManage did not answer an authenticated API call within
+        {{ (sdwan_api_ready_retries | int) * (sdwan_api_ready_delay | int) }}s
+        on {{ sdwan_api_host }}. Refusal for the first HALF HOUR is normal on
+        20.18.4: its /opt/data is an ephemeral empty disk, so every boot
+        re-unpacks the container bundle before dockerd can start and 443 can
+        listen. Refusal for the WHOLE window is not normal.
+
+        FOUR causes look identical from here, so do not guess -- read the
+        witnesses, in this order:
+
+        1. STILL UNPACKING (by far the most common). The appliance is fine and
+           this budget was too small. Witness, on the KubeVirt launcher pod:
+             kubectl -n <lab-ns> exec virt-launcher-vmanage-<id> -c compute -- \
+               stat -c %s /var/run/libvirt/empty-disks/data.qcow2
+           Sample it TWICE a few minutes apart. Growing => unpacking, and the
+           only fix is more budget or a pre-seeded /opt/data. The serial console
+           at /var/run/kubevirt-private/*/virt-serial0-log says the same thing
+           from the guest side ("Cannot connect to the Docker daemon ...").
+           CPU alone does NOT distinguish this from a hang.
+        2. WRONG CREDENTIAL. Check day-0 set the password this lane uses
+           ({{ sdwan_api_user }}) and that the vmanage serial injector reached
+           "day-0 applied and committed".
+        3. HTTP 429, too many session attempts. Only possible if the probe
+           cadence was lowered below 60s; it is 60s by default for this reason.
+        4. GENUINELY DEAD. TCP :22 refused as well as :443.
+    when: sdwan_ready.devices is not defined
+
+  - name: "Say the API is up"
+    debug:
+      msg: >-
+        vManage API ready on {{ sdwan_api_host }}:
+        {{ sdwan_ready.devices | default([], true) | length }} controller(s) already in
+        its inventory
+
+  # -------------------------------------------------------------------------
+  # THE FABRIC CA. Read, never created. The private key is deployment material
+  # that the platform mounts onto the runner; it is not in git, not in the
+  # topology and not in any rendered artefact. Only the CERTIFICATE travels into
+  # day-0.
+  # -------------------------------------------------------------------------
+  - name: "Check the deployment supplied a fabric CA"
+    stat:
+      path: "{{ item }}"
+    register: sdwan_ca_stat
+    loop:
+      - "{{ sdwan_ca_crt }}"
+      - "{{ sdwan_ca_key }}"
+    loop_control:
+      label: "{{ item }}"
+
+  - name: "Refuse to mint a CA behind the deployment's back"
+    fail:
+      msg: >
+        The fabric CA is missing on this runner
+        ({{ sdwan_ca_stat.results | rejectattr('stat.exists') | map(attribute='item') | join(', ') }}).
+        This lane deliberately does NOT generate one: the CA must be stable for
+        the life of the fabric, and a runner-generated CA lasts only as long as
+        this pod. Generating one here would let the devices trust an anchor
+        vManage does not sign with, which surfaces later as
+        "root-ca-chain unable to validate the certificate" and names neither CA.
+        The deployment is responsible for creating the CA once and mounting it.
+    when: sdwan_ca_stat.results | rejectattr('stat.exists') | list | length > 0
+
+  - name: "Read the fabric CA certificate"
+    slurp:
+      src: "{{ sdwan_ca_crt }}"
+    register: sdwan_ca_pem
+  # -------------------------------------------------------------------------
+  # FABRIC SETTINGS, IN TWO CALLS -- and the split is forced, not stylistic.
+  #
+  # administration_settings writes in a FIXED internal order, whatever order the
+  # arguments are given in: organization, then validator, then CERTIFICATES,
+  # then ENTERPRISE ROOT CA. vManage refuses `certificateSigning: enterprise`
+  # while no enterprise root CA is configured, so a single call can never
+  # succeed on a fresh fabric: the certificates PUT fails and the CA PUT it
+  # depends on is never reached.
+  #
+  # Measured live 2026-09-01, and the error names neither cause:
+  #   Could not perform 'Administration Settings: Controller Cerfificate
+  #   Authorization' action. Manager error: message='Failed to update setting'
+  #   details='Unknown error' code='CERT0007'
+  #
+  # So: anchor first, mode second.
+  # -------------------------------------------------------------------------
+  - name: "Set organization, validator and the enterprise root CA"
+    cisco.catalystwan.administration_settings:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      org: "{{ sdwan_intent.organization }}"
+      validator:
+        domain_ip: "{{ sdwan_intent.vbond_address }}"
+        port: "12346"
+      enterprise_root_ca: "{{ sdwan_ca_pem.content | b64decode }}"
+    register: sdwan_settings_ca
+
+  # certificate_signing MUST be enterprise. The stock setting is "cisco", which
+  # reaches Cisco's cloud PKI -- unavailable in an air-gapped lab, so nothing
+  # can ever go valid on the default.
+  #
+  # validity_period and retrieve_interval are deliberately NOT passed, and the
+  # collection must not add them: vManage 20.18.4 rejects BOTH for non-"cisco"
+  # signing -- "Unexpected key validityPeriod/retrieveInterval found" (MAINT0002).
+  # Only the bare certificateSigning is accepted; measured 200 on a live 20.18.4.
+  - name: "Switch certificate signing to the enterprise CA"
+    cisco.catalystwan.administration_settings:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      certificates:
+        certificate_signing: enterprise
+    register: sdwan_settings_signing
+
+  - name: "Say what the fabric settings ended up as"
+    debug:
+      msg: >-
+        root CA: {{ sdwan_settings_ca.msg | default('applied') }};
+        signing: {{ sdwan_settings_signing.msg | default('applied') }}
+
+  # -------------------------------------------------------------------------
+  # CERTIFICATES AND ENROLMENT, IN THE VENDOR'S ORDER.
+  #
+  # cisco.catalystwan's own onboarding_controllers role does: vManage's OWN
+  # CSR -> sign -> install FIRST, then for each controller: add -> CSR -> sign
+  # -> install, one device at a time. This lane used to enrol everything and
+  # then sign everything from one inventory read. Two facts make the order
+  # load-bearing, both read from the collection's code:
+  #
+  #   * install_signed_cert is DEVICE-BLIND. The module posts the PEM alone
+  #     (device_ip is accepted and never read on that path); vManage binds the
+  #     certificate to an OUTSTANDING CSR. Back-to-back installs against one
+  #     manager are therefore a race for one binding, and the one that landed
+  #     in the hand test was vManage's own.
+  #   * devices_controllers defaults generate_csr to TRUE and the vendor never
+  #     overrides it: enrolment itself opens the certificate workflow. This
+  #     lane passed false, so the device record was created with no CSR context
+  #     for a later install to bind to.
+  #
+  # Measured 2026-09-01 on a live 20.7.1: with the old order, vManage's leaf
+  # went Installed/valid and both controllers stayed "Not Installed" with
+  # vmanage_connection_state=None, all three CSRs healthy at 1212 bytes.
+  #
+  # "Sign whatever vManage lists as not Installed" after each step is what makes
+  # the per-device interleave fall out naturally: before any enrolment that set
+  # is exactly the manager; after enrolling one controller it is exactly that
+  # controller.
+  # -------------------------------------------------------------------------
+  - name: "Read vManage's inventory before any enrolment (it holds only the manager)"
+    cisco.catalystwan.devices_info:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_category: controllers
+    register: sdwan_inv0
+
+  - name: "Certificate-sign the MANAGER first, as the vendor role does"
+    include_tasks: sdwan_sign_controller.yml
+    loop: "{{ sdwan_inv0.devices | default([]) | rejectattr('cert_install_status', 'equalto', 'Installed') | list }}"
+    loop_control:
+      loop_var: sdwan_target
+      label: "{{ sdwan_target.host_name | default(sdwan_target.uuid, true) }} ({{ sdwan_target.device_ip | default('?') }})"
+
+  # device_ip is the TRANSPORT address, and that is not a detail: under KNE the
+  # management address resolves to a Service ClusterIP (198.19.x) reachable from
+  # the cluster and NOT from the lab network the controllers sit on. Enrolment
+  # went from working to HTTP 400 the one time that was "tidied up". The
+  # collection documents the same constraint in its own argspec.
+  #
+  # The credential is THE TARGET'S, carried in the roster -- vManage uses this
+  # pair to log into the box being enrolled. hostname is passed because the
+  # vendor passes it and because its absence is exactly why the inventory used
+  # to read host_name=None for every controller.
+  - name: "Enrol and certificate-sign each controller, one at a time"
+    include_tasks: sdwan_enrol_and_sign.yml
+    loop: "{{ sdwan_intent.controllers }}"
+    loop_control:
+      loop_var: sdwan_ctrl
+      label: "{{ sdwan_ctrl.name }} ({{ sdwan_ctrl.personality }} {{ sdwan_ctrl.address }})"
+
+  - name: "Read vManage's controller inventory after enrolment"
+    cisco.catalystwan.devices_info:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_category: controllers
+    register: sdwan_controllers
+
+  - name: "Refuse to continue with a fabric vManage does not know about"
+    fail:
+      msg: >
+        vManage's controller inventory holds {{ sdwan_controllers.devices | default([], true) | length }}
+        device(s) after enrolling {{ sdwan_intent.controllers | length }} controller(s)
+        plus the manager. Enrolment reported no failure, which means the devices
+        were accepted and then dropped -- check that each controller's day-0
+        committed a personality and a system-ip.
+    when: (sdwan_controllers.devices | default([], true)) | length < (sdwan_intent.controllers | length) + 1
+
+  # THE STEP THIS LANE NEVER CALLED. Signing a controller's certificate does not
+  # by itself make the fabric treat it as valid: the vEdge list carries a
+  # per-chassis validity flag, and a controller whose entry says invalid forms
+  # no control connections however good its certificate is. Measured: flipping
+  # this is what moved vsmart to validity=valid.
+  #
+  # NO failed_when: false HERE. This step is load-bearing and its failure is
+  # exactly the silent one that leaves a fully certified fabric forming no
+  # control connections.
+  #
+  # `| default(x, true)` -- the two-argument form -- because devices_info dumps
+  # its models WITHOUT by_alias, so `chasis_number` is always PRESENT and may be
+  # null. Jinja's one-argument default() only fires on UNDEFINED, so the
+  # one-argument form would pass null into a required suboption.
+  #
+  # wait_for_completed: false -- THE WAIT MEASURES NOTHING AND COSTS 300s.
+  # The module's arg spec defaults wait_for_completed to TRUE (collection
+  # 0.3.2, plugins/modules/devices_certificates.py:145), which routes this
+  # through execute_action_safely -> catalystwan Task.wait_for_completed
+  # (timeout_seconds=300, interval_seconds=5 -> tenacity
+  # stop_after_attempt(60), wait_fixed(5)). A vEdge-list validity change
+  # produces NO sub-tasks on /dataservice/device/action/status/<id>, and that
+  # poller's own check_status returns "keep retrying" on an EMPTY task list --
+  # so it burns all 60 attempts and then computes its verdict as
+  # `all([])`, which is True. It cannot fail, and it cannot pass for a reason.
+  #
+  # MEASURED, run 95482 (5-node sdwan-edge01, Loki). 300.5s is exactly
+  # 59 x 5s of tenacity sleep plus 60 fast status polls, and IT IS PAID PER
+  # LOOP ITEM:
+  #   this task, 3 controllers   23:38:37.486 -> 23:53:49.081  911.6s
+  #                              911.6 - 3 x 300.5 = 10.1s of actual API work
+  #   the edge copy, 1 edge      23:57:39.614 -> 00:02:40.089  300.5s
+  # 1202s of a 2295s bring-up -- 52% of the whole run -- spent polling a task
+  # that does not exist. It also explains demo-lab: 33m01s of "sdwan fabric
+  # onboarding" there is ~7 x 300.5s for its controllers and edges.
+  #
+  # NOTHING IS WEAKENED. A vManage that REFUSES the change still raises
+  # ManagerHTTPError, which execute_action_safely turns into fail_json on
+  # either setting. What is dropped is a verdict that was already vacuous.
+  # The push below still waits (its task DOES report sub-tasks -- 9s measured
+  # on the same run), and "Read the controllers back and prove every
+  # certificate installed" is the real device-side gate.
+  - name: "Mark each controller valid in the vEdge list"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      wait_for_completed: false
+      change_vedge_list_validity:
+        chasis_number: "{{ item.chasis_number | default(item.uuid, true) }}"
+        serial_number: "{{ item.serial_number | default(omit, true) }}"
+        validity: valid
+    loop: "{{ sdwan_controllers.devices | default([], true) }}"
+    loop_control:
+      label: "{{ item.host_name | default(item.uuid, true) }} ({{ item.device_ip | default('?') }})"
+    register: sdwan_validity
+
+  # Nothing the fabric has been told so far is in force on the devices until the
+  # lists are pushed. TWO pushes, not one: send_to_controllers distributes the
+  # vEdge list, send_to_vbond (save_vsmart_list) is what tells the VALIDATOR
+  # which vSmarts exist. Without the second, the validator accepts no vSmart
+  # connection and the fabric stays empty with every certificate valid.
+  # BOTH PUSHES STILL WAIT, deliberately. Unlike the validity change above,
+  # these two file a task vManage actually reports sub-tasks for: measured on
+  # run 95482, "Push the certificate list to the fabric" completed in 9s, so
+  # the wait is cheap AND it is the only thing that proves the distribution
+  # landed. Do not "optimise" these the way the validity loop was optimised --
+  # the reason that one is safe to drop is that its poll returns nothing, and
+  # that is a statement about THAT endpoint, not about waiting in general.
+  - name: "Push the vSmart list to the validator"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      send_to_vbond: true
+      wait_for_completed: true
+
+  - name: "Push the certificate list to the fabric"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      send_to_controllers: true
+      wait_for_completed: true
+
+  # THE DEVICE-SIDE VERDICT. Everything above is what vManage was TOLD; this is
+  # what it now holds. install_signed_certificate does NOT poll (it routes
+  # through send_request_safely, which returns as soon as the task is queued),
+  # so without this read-back a certificate the device rejected reads as a
+  # successful install -- the precise failure the deleted `until:` loop existed
+  # to catch.
+  - name: "Read the controllers back and prove every certificate installed"
+    cisco.catalystwan.devices_info:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_category: controllers
+    register: sdwan_final
+    until: >-
+      (sdwan_final.devices | default([], true) | length > 0) and
+      (sdwan_final.devices | default([], true)
+         | rejectattr('cert_install_status', 'equalto', 'Installed')
+         | list | length == 0)
+    retries: 30
+    delay: 10
+    failed_when: false
+
+  # ASK VMANAGE WHY, BEFORE FAILING.
+  #
+  # The gate above can only report "status=Not Installed" -- the device's
+  # summary, not a reason. Two separate investigations have now theorised over
+  # that summary and both were wrong: one blamed CA trust, one blamed an empty
+  # OU. vManage records the actual reason in exactly one place,
+  # GET /dataservice/device/action/status/<id> -> data[].activity, and
+  # install_signed_certificate returns that id without ever polling it. The
+  # reason has been available all along and has never been read.
+  #
+  # This reads it through the catalystwan SDK (the collection ships no module
+  # for that endpoint -- all 29 were checked). The script never fails the play:
+  # a reader that can itself break becomes a second thing to debug at the exact
+  # moment something else already is.
+  # The id lives at response.install_signed_cert.id in each recorded reply.
+  # Walked explicitly rather than with a filter chain: `msg` is '' and
+  # `response` can be {} on a device whose install was never accepted, and a
+  # map(attribute=...) over that raises instead of reporting the gap.
+  - name: "Collect the install task id vManage returned for each controller"
+    set_fact:
+      sdwan_install_task_ids: >-
+        {% set out = [] %}
+        {%- for r in (sdwan_install_reports | default([])) -%}
+        {%- set _ = out.append({
+              'name': r.get('name', '?'),
+              'task_id': ((r.get('response') or {}).get('install_signed_cert') or {}).get('id')
+            }) -%}
+        {%- endfor -%}
+        {{ out }}
+
+  # THE PAYLOAD GOES VIA A FILE, NOT stdin. Ansible's `script` module accepts
+  # only _raw_params/chdir/cmd/creates/executable/removes -- passing `stdin:`
+  # makes the task fail with "Unsupported parameters", which is exactly what
+  # happened on run 78562: the reader never executed and its failure MASKED the
+  # certificate result it was written to explain. Measured, not theorised.
+  #
+  # Not argv either: the credential would be visible in the process table.
+  - name: "Stage the credential for the install-activity reader"
+    copy:
+      content: "{{ { 'credentials': sdwan_manager_credentials,
+                     'task_ids': sdwan_install_task_ids } | to_json }}"
+      dest: "/tmp/sdwan-install-activity-input.json"
+      mode: "0600"
+    delegate_to: localhost
+    changed_when: false
+    no_log: true            # THIS task holds the credential
+
+  - name: "Ask vManage what it actually did with each certificate"
+    script: "files/sdwan_install_activity.py /tmp/sdwan-install-activity-input.json"
+    register: sdwan_activity
+    changed_when: false
+    failed_when: false
+    # NO no_log HERE. This task's output is the whole point of the patch, and
+    # no_log censored it on run 78562 ("the output has been hidden due to the
+    # fact that 'no_log: true' was specified"), hiding the reason twice over.
+
+  - name: "Remove the staged credential"
+    file:
+      path: "/tmp/sdwan-install-activity-input.json"
+      state: absent
+    delegate_to: localhost
+    changed_when: false
+
+  - name: "Fail loudly on any controller whose certificate did not install"
+    fail:
+      msg: >
+        certificate NOT installed after 300s on:
+        {% for d in sdwan_uninstalled %}{{ d.host_name | default(d.uuid, true) }}
+        ({{ d.device_ip | default('?') }}, status={{ d.cert_install_status | default('unknown') }}){% if not loop.last %}, {% endif %}{% endfor %}.
+        What vManage returned for each install:
+        {{ sdwan_install_reports | default([]) }}
+        .
+        WHAT VMANAGE SAID THE REASON WAS (read from
+        /dataservice/device/action/status/<id> -> data[].activity, which is the
+        only place it records one):
+        {{ (sdwan_activity.stdout | default('') | trim) or 'the reason reader produced no output -- see the task above' }}
+        .
+        Each reply above carries an install TASK id.
+        That is where "System organization name [ x ] does not match with cert
+        subject's OUs [ y ]" appeared on 2026-09-02, after five runs had blamed
+        CA trust.
+        DO NOT ASSUME A CAUSE FROM THIS MESSAGE. The reply above is the only
+        first-hand evidence of what the manager did with the certificate; read
+        it before theorising. This message used to assert a CA-trust mismatch,
+        which it had never measured -- on 2026-09-02 every controller had
+        `root-ca-chain-status Installed` and the fabric CA present in
+        `show certificate root-ca-cert`, while `show certificate installed` was
+        EMPTY: the leaf never reached the device at all.
+        Worth checking on the device, in this order:
+        `show certificate installed` (empty = the leaf never arrived),
+        `show control local-properties` (number-active-wan-interfaces 0 = no
+        control plane can form), and only then the CA at {{ sdwan_ca_crt }}.
+    vars:
+      sdwan_uninstalled: >-
+        {{ sdwan_final.devices | default([], true)
+           | rejectattr('cert_install_status', 'equalto', 'Installed')
+           | list }}
+    when: sdwan_uninstalled | length > 0
+
+# ---------------------------------------------------------------------------
+# THE WAN EDGES. Controllers above are ENROLLED: vManage logs into each one.
+# An edge is AUTHORISED: the manager is handed the chassis/token pair the
+# edge's day-0 carries, the pair is marked valid and pushed to the validator
+# and controller, and the edge -- already booted in controller mode from the
+# netlab-rendered ciscosdwan_cloud_init.cfg -- dials in by itself. The lane
+# then READS BACK the controller's control-connection table and says, per
+# edge, PROVEN or NOT_PROVEN. "Submitted" is not a verdict and is never one
+# here.
+#
+# The pair enters over the manager's CLI (`request vedge add`), the one door
+# 20.18.4 leaves open to a virtual platform -- see sdwan_authorize_edge.yml.
+# ---------------------------------------------------------------------------
+- name: "Admit the WAN edges"
+  delegate_to: localhost
+  when: (sdwan_intent.edges | default([]) | length) > 0
+  block:
+  # THE LEAF TRAVELS BY HTTP FROM THIS RUNNER. A controller-mode edge can only
+  # install a certificate from bootflash:, and the one file channel into it
+  # is `copy http://` sourced from its management VRF (day-0 sets the
+  # source-interface). Pod addresses are reachable from the VM through
+  # KubeVirt's masquerade, so the runner serves a private directory for the
+  # duration of the edge phase and nothing else.
+  - name: "Serve the edges' leaves from this runner for the edge phase"
+    set_fact:
+      sdwan_edge_cert_dir: "/tmp/sdwan-edge-certs"
+      sdwan_edge_cert_port: "{{ sdwan.edge_cert_port | default(8088) }}"
+      sdwan_runner_ip: "{{ lookup('pipe', 'hostname -i') | trim | split(' ') | first }}"
+
+  - name: "Create the served directory"
+    file:
+      path: "{{ sdwan_edge_cert_dir }}"
+      state: directory
+      mode: "0755"
+    changed_when: false
+
+  - name: "Start the leaf server (background, torn down below)"
+    shell: >-
+      nohup python3 -m http.server {{ sdwan_edge_cert_port }} --directory {{ sdwan_edge_cert_dir }}
+      --bind {{ sdwan_runner_ip }} > /tmp/sdwan-edge-certs.log 2>&1 &
+      echo $! > /tmp/sdwan-edge-certs.pid
+    changed_when: false
+
+  # The edges are independent, so by default they are admitted CONCURRENTLY,
+  # in stages (sdwan_admit_edges.yml). The serial path -- one include per
+  # edge, ~10 minutes each because of the console waits -- is kept behind
+  # sdwan.edge_parallel: false as the escape hatch.
+  - name: "Admit every edge concurrently: CSR -> sign -> install -> serial -> authorise"
+    include_tasks: sdwan_admit_edges.yml
+    when: sdwan.edge_parallel | default(true)
+
+  - name: "Admit each edge in turn (escape hatch: sdwan.edge_parallel = false)"
+    include_tasks: sdwan_authorize_edge.yml
+    loop: "{{ sdwan_intent.edges if not (sdwan.edge_parallel | default(true)) else [] }}"
+    loop_control:
+      loop_var: sdwan_edge
+      label: "{{ sdwan_edge.name }} ({{ sdwan_edge.chassis | default('?') }} system-ip {{ sdwan_edge.system_ip | default('?') }})"
+
+  - name: "Stop the leaf server"
+    shell: "kill $(cat /tmp/sdwan-edge-certs.pid) 2>/dev/null; rm -f /tmp/sdwan-edge-certs.pid"
+    changed_when: false
+    failed_when: false
+
+  # Same step the controllers need (see "Mark each controller valid"): the
+  # vEdge list carries a per-chassis validity flag, and an entry that says
+  # invalid forms no control connection however good the identity is.
+  - name: "Read the WAN edge list the manager now holds"
+    cisco.catalystwan.devices_info:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_category: vedges
+    register: sdwan_vedges
+
+  # The NMS inventory learns an edge only once it has ATTACHED (measured: the
+  # CLI door feeds each appliance's own control list; /system/device/vedges
+  # stayed empty until the edge's first successful DTLS session, then showed it
+  # valid/READY/certinstalled on its own). So this marks whatever is present
+  # and is not a gate; the gate is the read-back below.
+  #
+  # wait_for_completed: false -- the comment directly above already says this
+  # step "is not a gate; the gate is the read-back below", and yet the module
+  # default made it block for the full catalystwan task timeout.
+  # MEASURED, run 95482: 23:57:39 -> 00:02:40, 300.5s for ONE edge. See the
+  # controller copy of this task for why the poll can never return anything.
+  - name: "Mark each authorised edge valid in the vEdge list"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      wait_for_completed: false
+      change_vedge_list_validity:
+        chasis_number: "{{ item.chasis_number | default(item.uuid, true) }}"
+        serial_number: "{{ item.serial_number | default(omit, true) }}"
+        validity: valid
+    loop: >-
+      {{ sdwan_vedges.devices | default([], true)
+         | selectattr('chasis_number', 'defined')
+         | selectattr('chasis_number', 'in', sdwan_intent.edges | map(attribute='chassis') | list)
+         | list }}
+    loop_control:
+      label: "{{ item.chasis_number | default(item.uuid, true) }}"
+
+  - name: "Push the vEdge list to the validator and the controller"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      send_to_controllers: true
+      wait_for_completed: true
+
+  # THE VERDICT. Read from the CONTROLLER's control-connection table, which is
+  # the same table the collector's Viptela collector judges the fabric by. Polled,
+  # because an edge that has just been authorised needs its next DTLS attempt
+  # to the validator before it can appear there; the budget is the edge's
+  # own retry cadence, not a guess about the manager.
+  - name: "Stage the credential for the edge read-back"
+    copy:
+      content: "{{ { 'credentials': sdwan_manager_credentials,
+                     'edges': sdwan_intent.edges,
+                     'controller_system_ips': sdwan_intent.controllers
+                        | selectattr('personality', 'equalto', 'vsmart')
+                        | map(attribute='system_ip') | list,
+                     'poll_seconds': sdwan.edge_readback_seconds | default(600),
+                     'poll_interval': 15 } | to_json }}"
+      dest: "/tmp/sdwan-edge-readback-input.json"
+      mode: "0600"
+    changed_when: false
+    no_log: true            # THIS task holds the credential and the tokens
+
+  - name: "Read back which edges the controller actually sees"
+    script: "files/sdwan_edge_readback.py /tmp/sdwan-edge-readback-input.json"
+    register: sdwan_edge_readback
+    changed_when: false
+    failed_when: false
+
+  # A BROKEN READER REPORTS ABSENCE, and absence is indistinguishable from a
+  # clean result. On demo-lab (run 86401) this script had no shebang, so the
+  # `script` module handed it to /bin/sh: rc=2, EMPTY stdout, the traceback on
+  # stderr -- and the merge below then died on from_json(''), after all four
+  # edges had been authorised. The reader now says what it returned, always.
+  - name: "Say what the read-back itself returned"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=readback rc={{ sdwan_edge_readback.rc | default('none') }}
+        stdout_bytes={{ (sdwan_edge_readback.stdout | default('')) | length }}
+        stderr={{ (sdwan_edge_readback.stderr | default('')) | regex_replace('\s+', ' ') | trim | truncate(200) or 'none' }}
+
+  - name: "Remove the staged credential"
+    file:
+      path: "/tmp/sdwan-edge-readback-input.json"
+      state: absent
+    changed_when: false
+
+  # THE VERDICT, AND WHY. The read-back decides PROVEN from the controller's
+  # own table; an edge that never got as far as the controller has a REASON
+  # recorded by sdwan_authorize_edge.yml's rescue, and that reason is what
+  # someone reading the ConfigMap tomorrow actually needs. Merged here so the
+  # file carries both halves and every edge in the roster appears exactly
+  # once, whether it was admitted, refused, or never attempted.
+  # A REASON BELONGS TO A REFUSAL. The controller's own table is the verdict:
+  # an edge whose control connection is up is PROVEN even if some step earlier
+  # in this run stumbled, and hanging that stumble on it as a 'reason' reads
+  # like a caveat on a result that does not have one.
+  - name: "Keep the edge verdicts, with the reason any edge was not admitted"
+    set_fact:
+      sdwan_edge_verdicts: >-
+        {#- default('{}', true) -- the two-argument form -- because the failure was an
+            EMPTY string, not an undefined one: `default('{}')` only fires on undefined,
+            so from_json('') raised inside task-args finalization and killed the run. -#}
+        {%- set readback_note = 'rc=' ~ (sdwan_edge_readback.rc | default('none')) ~ ' stderr=' ~ ((sdwan_edge_readback.stderr | default('')) | regex_replace('\s+', ' ') | trim | truncate(160) or 'none') -%}
+        {%- set raw = ((sdwan_edge_readback.stdout | default('', true)) | trim) or '{}' -%}
+        {%- set parsed = raw | from_json if raw.startswith('{') else {} -%}
+        {%- set judged = parsed.edges | default([], true) -%}
+        {%- set reasons = sdwan_edge_reasons | default({}) -%}
+        {%- set by_name = {} -%}
+        {%- for v in judged -%}{%- set _ = by_name.update({v.name: v}) -%}{%- endfor -%}
+        {%- set out = [] -%}
+        {%- for e in sdwan_intent.edges -%}
+        {%-   set v = by_name.get(e.name, {'name': e.name, 'chassis': e.chassis | default(''),
+                                           'system_ip': e.system_ip | default(''),
+                                           'verdict': 'NOT_PROVEN', 'control_connections': [], 'vedge_list': []}) -%}
+        {%-   set fallback = reasons.get(e.name, v.get('reason', '')) -%}
+        {%-   set fallback = fallback or ('the read-back produced no verdict: ' ~ readback_note) if not judged else fallback -%}
+        {%-   set v = v | combine({'reason': fallback if v.verdict != 'PROVEN' else ''}) -%}
+        {%-   set _ = out.append(v) -%}
+        {%- endfor -%}
+        {{ out }}
+
+  # THE SERVICE SIDE, day-1, for the edges just PROVEN. Runs after the verdict
+  # so it never touches an edge that has not enrolled, and it folds its own
+  # per-edge verdict (PUSHED / REFUSED / NOT_ATTEMPTED / NOT_PROVEN, read back
+  # from vManage's copy of the running configuration and the controller's OMP
+  # table) into the same list under `service`. Non-fatal by construction, like
+  # everything above it. See sdwan_service_vpns.yml.
+  - name: "Deliver the service side of the proven edges through vManage"
+    include_tasks: sdwan_service_vpns.yml
+
+  # PERSISTED FOR THE RUNTIME. netlab.py reads this file after the play and
+  # carries it into the onboarding results ConfigMap, which is what Skyforge
+  # gates the collector's edge device typing on. The path is a contract with
+  # components/server/netlab/runtime/netlab.py. The `service` half of each
+  # entry is carried in the file, and so are two ADDITIVE top-level keys a
+  # reader can pick up without parsing it: `service_verdict` (ROUTED / PUSHED
+  # / REFUSED / NOT_PROVEN / NOT_ATTEMPTED) and `routed` (true only when the
+  # controller carries the edge's own prefixes). The runtime keeps the
+  # admission keys it knows today; carrying these two onto the deployment
+  # condition text is the server-side follow-up this file is shaped for.
+  - name: "Write the per-edge verdicts for the runtime"
+    copy:
+      content: >-
+        {%- set out = [] -%}
+        {%- for v in sdwan_edge_verdicts | default([]) -%}
+        {%-   set _ = out.append(v | combine({'service_verdict': (v.service | default({})).verdict | default('NOT_ATTEMPTED'),
+                                              'routed': (v.service | default({})).routed | default(false)})) -%}
+        {%- endfor -%}
+        {{ { 'edges': out } | to_json }}
+      dest: "/tmp/skyforge-sdwan-edges.json"
+      mode: "0644"
+    changed_when: false
+
+  - name: "Say what the controller sees, per edge"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=readback device={{ item.name }}
+        chassis={{ item.chassis }} system_ip={{ item.system_ip }}
+        verdict={{ item.verdict }}
+        control_connections={{ item.control_connections | length }}
+        vedge_list={{ item.vedge_list }}
+        service={{ (item.service | default({})).verdict | default('NOT_ATTEMPTED') }}
+        routed={{ (item.service | default({})).routed | default(false) }}
+    loop: "{{ sdwan_edge_verdicts }}"
+    loop_control:
+      label: "{{ item.name }}={{ item.verdict }}/{{ (item.service | default({})).verdict | default('NOT_ATTEMPTED') }}"
+
+# THE SUMMARY NAMES BOTH HALVES. "N PROVEN" is the control plane only -- an
+# edge is PROVEN the moment its control connection is up, before it routes a
+# single site prefix. Three demo-lab runs read "4 PROVEN" while every edge's
+# service VPN carried nothing into OMP and no site could reach another; the
+# line below now says how many of the proven edges ROUTED, and calls the rest
+# DEGRADED by name with the read-back's reason, so a control-plane-up,
+# service-down lab reads as what it is. It stays a report, not a failure: the
+# lab is still useful to debug, and the runtime decides what to do with it.
+- name: "Report what onboarding did"
+  vars:
+    sdwan_proven: "{{ sdwan_edge_verdicts | default([]) | selectattr('verdict', 'equalto', 'PROVEN') | list }}"
+    sdwan_routed: "{{ sdwan_edge_verdicts | default([]) | selectattr('service.routed', 'defined') | selectattr('service.routed', 'equalto', true) | list }}"
+    sdwan_degraded: "{{ sdwan_edge_verdicts | default([]) | selectattr('verdict', 'equalto', 'PROVEN') | selectattr('service.verdict', 'defined') | rejectattr('service.verdict', 'in', ['ROUTED', 'NOT_ATTEMPTED']) | list }}"
+  debug:
+    msg: >-
+      SD-WAN fabric '{{ sdwan_intent.organization }}' onboarded on
+      {{ inventory_hostname }}: validator {{ sdwan_intent.vbond_address }},
+      {{ sdwan_intent.controllers | length }} controller(s) enrolled,
+      {{ sdwan_intent.edges | length }} edge(s) attempted, of which
+      {{ sdwan_proven | length }}
+      PROVEN on the controller's control connections
+      ({{ sdwan_edge_verdicts | default([]) | map(attribute='name') | zip(sdwan_edge_verdicts | default([]) | map(attribute='verdict')) | map('join', '=') | join(', ') | default('none', true) }})
+      and {{ sdwan_routed | length }} ROUTED on the controller's OMP table
+      ({{ sdwan_edge_verdicts | default([]) | map(attribute='name') | zip(sdwan_edge_verdicts | default([]) | map(attribute='service.verdict', default='NOT_ATTEMPTED')) | map('join', '=') | join(', ') | default('none', true) }}).
+      {% if sdwan_degraded | length > 0 %}
+      SERVICE SIDE DEGRADED on {{ sdwan_degraded | length }} of {{ sdwan_proven | length }} proven edge(s):
+      {% for v in sdwan_degraded %}
+      {{ v.name }} {{ v.service.verdict }}: {{ v.service.reason | default('no reason recorded', true) }}
+      {% endfor %}
+      {% endif %}
+      {% for v in sdwan_edge_verdicts | default([]) | rejectattr('verdict', 'equalto', 'PROVEN') | list %}
+      NOT_PROVEN {{ v.name }}: {{ v.reason | default('no control connection on the controller', true) }}
+      {% endfor %}
+
+- name: "Say the service side is degraded, once, where the run summary is read"
+  # One line, its own task, so a log reader (and Loki) can match it without
+  # parsing the summary above: `sdwan-service-verdict: DEGRADED ...`. ROUTED
+  # only when at least one edge routed and none is degraded; an empty fabric
+  # is NONE, never a vacuous ROUTED.
+  vars:
+    sdwan_routed_names: "{{ sdwan_edge_verdicts | default([]) | selectattr('service.routed', 'defined') | selectattr('service.routed', 'equalto', true) | map(attribute='name') | list }}"
+    sdwan_unrouted_names: "{{ sdwan_edge_verdicts | default([]) | selectattr('verdict', 'equalto', 'PROVEN') | selectattr('service.verdict', 'defined') | rejectattr('service.verdict', 'in', ['ROUTED', 'NOT_ATTEMPTED']) | map(attribute='name') | list }}"
+  debug:
+    msg: >-
+      sdwan-service-verdict: {{ 'DEGRADED' if sdwan_unrouted_names | length > 0 else ('ROUTED' if sdwan_routed_names | length > 0 else 'NONE') }}
+      routed={{ sdwan_routed_names }}
+      unrouted={{ sdwan_unrouted_names }}
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_admit_edges.yml b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_admit_edges.yml
new file mode 100644
index 0000000..2e10017
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_admit_edges.yml
@@ -0,0 +1,632 @@
+---
+# ADMIT EVERY WAN EDGE, ALL AT ONCE.
+#
+# The edges are independent: each one generates its own CSR, gets its own leaf
+# signed, fetches and installs it, reads back its own certificate serial, and
+# has that serial authorised on the appliances. Nothing an edge does depends on
+# another edge. Run serially -- one include per edge, each with fixed console
+# sleeps -- that is roughly ten minutes PER EDGE, and demo-lab has four; the
+# fabric's four edges took ~35 minutes of a deployment's budget doing work that
+# is four copies of the same wait.
+#
+# So this file runs the pipeline in STAGES: every edge's CSR concurrently, then
+# every signature, then every install, and so on. Stages stay ordered because a
+# leaf cannot be installed before it is signed; within a stage the edges are
+# independent and run as parallel async jobs joined before the next stage.
+#
+# WHY STAGES AND NOT A PARALLEL INCLUDE. The lane runs inside the manager's
+# play (`netlab initial -m sdwan --limit <managers>`), so there is exactly one
+# host here and Ansible's own parallelism -- forks across hosts -- is not
+# available. `async` + `poll: 0` is: it backgrounds each job on the delegated
+# host and `async_status` joins them. It is also why this file does not use a
+# block/rescue per edge the way the sequential path does: there is no per-edge
+# task branch to rescue. Instead EVERY task is non-fatal by construction
+# (`failed_when: false`) and each stage filters to the edges still eligible,
+# recording a reason for the ones it drops. One edge can no more fail the
+# fabric here than it can there -- it is the same rule, enforced differently.
+#
+# NO SHARED STATE IS WRITTEN CONCURRENTLY. Every artefact is named after its
+# edge (/tmp/sdwan-edge-<name>.csr, <cert-dir>/<name>.crt). The one genuinely
+# shared file is the CA's serial counter (`openssl -CAcreateserial` writes
+# /tmp/sdwan-fabric-ca.srl), so SIGNING IS DELIBERATELY SEQUENTIAL: it is
+# openssl on a local file and costs milliseconds, and two concurrent signings
+# would race the counter and could issue two leaves with one serial -- which
+# the appliances index BY serial.
+#
+# The sequential path (sdwan_authorize_edge.yml) is kept and still works; set
+# sdwan.edge_parallel: false to take it.
+
+- name: "Start every edge eligible, with no reason to refuse it"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = {} -%}
+      {%- for e in sdwan_intent.edges -%}
+      {%-   set _ = d.update({e.name: {'ok': (e.chassis | default('')) | length > 0,
+                                       'chassis': e.chassis | default(''),
+                                       'serial': '',
+                                       'reason': '' if (e.chassis | default('')) else
+                                                 'carries no chassis: the roster was rendered by a netlab older than this lane'}}) -%}
+      {%- endfor -%}
+      {{ d }}
+    sdwan_edge_serial_tries: "{{ sdwan.edge_serial_retries | default(10) }}"
+    sdwan_edge_serial_delay: "{{ sdwan.edge_serial_delay | default(15) }}"
+    sdwan_edge_helper_session: "/tmp/sdwan-cli-session.sh"
+    sdwan_edge_helper_wait: "/tmp/sdwan-edge-wait-serial.sh"
+    sdwan_edge_helper_prompt: "/tmp/sdwan-cli-wait-prompt.sh"
+
+# The appliances, resolved ONCE for the whole fan-out rather than per edge.
+# Addressed the way ANSIBLE addresses them -- the roster's address is the
+# fabric's enrolment address and is not routable from this runner (netlab
+# 0047).
+- name: "List the appliances that must hold every identity"
+  set_fact:
+    sdwan_edge_targets: >-
+      {%- set t = [ {'name': inventory_hostname, 'host': sdwan_api_host, 'user': sdwan_api_user, 'password': sdwan_api_password} ] -%}
+      {%- for c in sdwan_intent.controllers -%}
+      {%-   set hv = hostvars[c.name] | default({}, true) -%}
+      {%-   set _ = t.append({'name': c.name,
+                              'host': hv.ansible_host | default(c.address, true),
+                              'user': hv.ansible_user | default(c.username | default('admin'), true),
+                              'password': hv.ansible_password | default(c.password | default('admin'), true)}) -%}
+      {%- endfor -%}
+      {{ t }}
+  no_log: true
+
+- name: "How each edge is reached, and on which appliances it must be authorised"
+  set_fact:
+    sdwan_edge_conn: >-
+      {%- set d = {} -%}
+      {%- for e in sdwan_intent.edges -%}
+      {%-   set hv = hostvars[e.name] | default({}, true) -%}
+      {%-   set _ = d.update({e.name: {
+                'ssh': (hv.ansible_user | default('admin', true)) ~ '@' ~ (hv.ansible_host | default(e.address, true)),
+                'password': hv.ansible_password | default('admin', true)}}) -%}
+      {%- endfor -%}
+      {{ d }}
+  no_log: true
+
+# THE HELPERS ARE STAGED, THEN RUN AS COMMANDS. The `script` action copies
+# and runs in one step, but its plugin refuses async ("This action (script)
+# does not support async"), and async is the entire mechanism here. `command`
+# supports it, so the two helpers are placed on the runner once and invoked by
+# path -- same files, same arguments, same credential handling (SSHPASS in the
+# environment, never in argv).
+- name: "Stage the CLI helpers on the runner"
+  copy:
+    src: "files/{{ item.src }}"
+    dest: "{{ item.dest }}"
+    mode: "0755"
+  loop:
+    - { src: sdwan_cli_session.sh, dest: "{{ sdwan_edge_helper_session }}" }
+    - { src: sdwan_edge_wait_serial.sh, dest: "{{ sdwan_edge_helper_wait }}" }
+    - { src: sdwan_cli_wait_prompt.sh, dest: "{{ sdwan_edge_helper_prompt }}" }
+  loop_control:
+    label: "{{ item.dest }}"
+  register: sdwan_edge_helper_staged
+  changed_when: false
+  failed_when: false
+
+# Even THIS cannot be fatal. If the helpers are not on the runner nothing can
+# be admitted, but that is a verdict about the edges, not a reason to fail a
+# deployment whose 77 nodes are healthy -- the same rule the rest of the file
+# keeps. Every edge is dropped with the staging error as its reason, and the
+# stages below then have nothing eligible to do.
+- name: "If the helpers could not be staged, no edge can be admitted"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- set failed = (sdwan_edge_helper_staged.results | default([])) | selectattr('failed', 'defined') | selectattr('failed') | list -%}
+      {%- if failed -%}
+      {%-   set why = 'the CLI helpers could not be staged on the runner: ' ~ ((failed | map(attribute='msg') | map('default', 'no message') | join('; ')) | truncate(200)) -%}
+      {%-   for name, st in d.items() -%}
+      {%-     set _ = d.update({name: st | combine({'ok': false, 'reason': why})}) -%}
+      {%-   endfor -%}
+      {%- endif -%}
+      {{ d }}
+
+- name: "Say what is about to be admitted, and where"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=fanout edges={{ sdwan_intent.edges | map(attribute='name') | list }}
+      appliances={{ sdwan_edge_targets | map(attribute='name') | zip(sdwan_edge_targets | map(attribute='host')) | map('join', '@') | list }}
+      mode=parallel
+
+# ---- STAGE 1: every CSR at once -------------------------------------------
+- name: "Ask every edge for a CSR (fire)"
+  command: >-
+    {{ sdwan_edge_helper_session }} "{{ sdwan_edge_conn[item].ssh }}"
+    "terminal length 0"
+    "request platform software sdwan csr upload bootflash:sdwan/{{ item }}.csr"
+    "{{ sdwan_intent.organization }}" "{{ sdwan_intent.organization }}" "sleep:8"
+    "more bootflash:sdwan/{{ item }}.csr"
+  environment:
+    SSHPASS: "{{ sdwan_edge_conn[item].password }}"
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+  async: "{{ sdwan.edge_stage_timeout | default(600) }}"
+  poll: 0
+  register: sdwan_csr_jobs
+  changed_when: false
+  failed_when: false
+  no_log: true
+
+- name: "Wait for every CSR (join)"
+  async_status:
+    jid: "{{ item.ansible_job_id }}"
+  loop: "{{ sdwan_csr_jobs.results | default([]) | selectattr('ansible_job_id', 'defined') | list }}"
+  loop_control:
+    label: "{{ item.item }}"
+  register: sdwan_csr_joined
+  until: sdwan_csr_joined.finished
+  retries: "{{ sdwan.edge_join_retries | default(60) }}"
+  delay: "{{ sdwan.edge_join_delay | default(10) }}"
+  failed_when: false
+  no_log: true
+
+- name: "Keep each edge's CSR, and drop the edges that produced none"
+  set_fact:
+    sdwan_edge_csr: >-
+      {%- set d = {} -%}
+      {%- for r in sdwan_csr_joined.results | default([]) -%}
+      {%-   set text = (r.stdout | default('')) | regex_findall('(?s)-----BEGIN CERTIFICATE REQUEST-----.*?-----END CERTIFICATE REQUEST-----') | first | default('', true) -%}
+      {%-   set _ = d.update({r.item.item: text}) -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Record the edges whose CSR never came back"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- for name, st in d.items() -%}
+      {%-   if st.ok and not (sdwan_edge_csr[name] | default('')) -%}
+      {%-     set _ = d.update({name: st | combine({'ok': false, 'reason':
+                'produced no CSR. The device answers `request platform software sdwan csr upload` only in CONTROLLER mode with SSH reachable on its management address; an autonomous router has no such command at all.'})}) -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Write out each surviving edge's CSR"
+  copy:
+    content: "{{ sdwan_edge_csr[item] }}\n"
+    dest: "/tmp/sdwan-edge-{{ item }}.csr"
+    mode: "0600"
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+  changed_when: false
+
+# ---- STAGE 2: sign, SEQUENTIALLY (the CA serial counter is shared) ---------
+- name: "Sign each CSR with the fabric CA, one at a time"
+  command: >-
+    openssl x509 -req -in /tmp/sdwan-edge-{{ item }}.csr
+    -CA {{ sdwan_ca_crt }} -CAkey {{ sdwan_ca_key }}
+    -CAserial /tmp/sdwan-fabric-ca.srl -CAcreateserial
+    -days 730 -sha256 -out {{ sdwan_edge_cert_dir }}/{{ item }}.crt
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+  register: sdwan_sign_results
+  changed_when: true
+  failed_when: false
+
+- name: "Read the serial the CA issued for each edge"
+  command: openssl x509 -in {{ sdwan_edge_cert_dir }}/{{ item }}.crt -noout -serial
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+  register: sdwan_issued_results
+  changed_when: false
+  failed_when: false
+
+- name: "Keep the issued serials, and drop any edge the CA would not sign"
+  set_fact:
+    sdwan_edge_issued: >-
+      {%- set d = {} -%}
+      {%- for r in sdwan_issued_results.results | default([]) -%}
+      {%-   set _ = d.update({r.item: (r.stdout | default('')) | regex_replace('^serial=', '') | trim}) -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Record the edges whose leaf was never issued"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- for name, st in d.items() -%}
+      {%-   if st.ok and not (sdwan_edge_issued[name] | default('')) -%}
+      {%-     set _ = d.update({name: st | combine({'ok': false, 'reason':
+                'the fabric CA issued no leaf for it (openssl produced no certificate to read a serial from)'})}) -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+
+# ---- STAGE 3: every install at once ---------------------------------------
+- name: "Have every edge fetch and install its leaf (fire)"
+  command: >-
+    {{ sdwan_edge_helper_session }} "{{ sdwan_edge_conn[item].ssh }}"
+    "terminal length 0"
+    "copy http://{{ sdwan_runner_ip }}:{{ sdwan_edge_cert_port }}/{{ item }}.crt bootflash:sdwan/{{ item }}.crt"
+    "" "" "sleep:6"
+    "request platform software sdwan certificate install bootflash:sdwan/{{ item }}.crt"
+    "sleep:12"
+  environment:
+    SSHPASS: "{{ sdwan_edge_conn[item].password }}"
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+  async: "{{ sdwan.edge_stage_timeout | default(600) }}"
+  poll: 0
+  register: sdwan_install_jobs
+  changed_when: false
+  failed_when: false
+  no_log: true
+
+- name: "Wait for every install (join)"
+  async_status:
+    jid: "{{ item.ansible_job_id }}"
+  loop: "{{ sdwan_install_jobs.results | default([]) | selectattr('ansible_job_id', 'defined') | list }}"
+  loop_control:
+    label: "{{ item.item }}"
+  register: sdwan_install_joined
+  until: sdwan_install_joined.finished
+  retries: "{{ sdwan.edge_join_retries | default(60) }}"
+  delay: "{{ sdwan.edge_join_delay | default(10) }}"
+  failed_when: false
+  no_log: true
+
+# ---- STAGE 4: every serial read at once, each retrying inside its own job --
+- name: "Ask every edge for its certificate serial until it has one (fire)"
+  command: >-
+    {{ sdwan_edge_helper_wait }} "{{ sdwan_edge_conn[item].ssh }}"
+    "{{ sdwan_edge_serial_tries }}" "{{ sdwan_edge_serial_delay }}"
+  environment:
+    SSHPASS: "{{ sdwan_edge_conn[item].password }}"
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+  async: "{{ sdwan.edge_serial_timeout | default(1200) }}"
+  poll: 0
+  register: sdwan_serial_jobs
+  changed_when: false
+  failed_when: false
+
+- name: "Wait for every serial read (join)"
+  async_status:
+    jid: "{{ item.ansible_job_id }}"
+  loop: "{{ sdwan_serial_jobs.results | default([]) | selectattr('ansible_job_id', 'defined') | list }}"
+  loop_control:
+    label: "{{ item.item }}"
+  register: sdwan_serial_joined
+  until: sdwan_serial_joined.finished
+  retries: "{{ sdwan.edge_join_retries | default(60) }}"
+  delay: "{{ sdwan.edge_join_delay | default(10) }}"
+  failed_when: false
+
+- name: "Keep what each edge says its serial is"
+  set_fact:
+    sdwan_edge_device_serial: >-
+      {%- set d = {} -%}
+      {%- for r in sdwan_serial_joined.results | default([]) -%}
+      {%-   set _ = d.update({r.item.item: (r.stdout | default('')) | regex_findall('serial number: ([0-9A-Fa-f]{8,})') | first | default('', true)}) -%}
+      {%- endfor -%}
+      {{ d }}
+    sdwan_edge_serial_tail: >-
+      {%- set d = {} -%}
+      {%- for r in sdwan_serial_joined.results | default([]) -%}
+      {%-   set _ = d.update({r.item.item: (r.stdout | default('')) | regex_findall('(?m)^(?:Chassis number:.*|sdwan-edge-serial-attempts:.*)$') | join(' | ') | truncate(240)}) -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Say what every edge did with its leaf"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=leaf device={{ item }}
+      chassis={{ sdwan_edge_status[item].chassis }}
+      issued_serial={{ sdwan_edge_issued[item] | default('none', true) }}
+      device_serial={{ sdwan_edge_device_serial[item] | default('', true) or 'none' }}
+      read={{ sdwan_edge_serial_tail[item] | default('no output', true) }}
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+
+- name: "Drop any edge whose installed leaf is not the one we issued"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- for name, st in d.items() -%}
+      {%-   if st.ok -%}
+      {%-     set dev = sdwan_edge_device_serial[name] | default('') -%}
+      {%-     set iss = sdwan_edge_issued[name] | default('') -%}
+      {%-     if dev and iss and (dev | upper) == (iss | upper) -%}
+      {%-       set _ = d.update({name: st | combine({'serial': dev})}) -%}
+      {%-     else -%}
+      {%-       set _ = d.update({name: st | combine({'ok': false, 'reason':
+                  'did not install the certificate we issued (device serial "' ~ (dev or 'none') ~ '", issued "' ~ (iss or 'none') ~ '"). Last read: ' ~ (sdwan_edge_serial_tail[name] | default('no output', true))})}) -%}
+      {%-     endif -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+
+# ---- STAGE 4b: WAIT for the appliances before judging any edge by them -----
+#
+# SILENCE NOW IS A WAIT, NOT A VERDICT. An appliance that does not answer is
+# the one failure this lane cannot honestly blame on an edge, and on demo-lab
+# (run 86907) it produced four identical NOT_PROVEN verdicts that named the
+# edges for a fault in the vSmart. So the appliances are asked to prove their
+# CLI answers BEFORE any edge is judged by them, with a retry budget: a
+# controller we could have reached a minute later is worth waiting for.
+#
+# The probe is the CLI itself, not a port check: a listening sshd that cannot
+# get to a prompt would pass a TCP test and fail every `request vedge add`.
+# The prompt character is the proof -- an ssh failure prints its own error to
+# the same stream and never contains one.
+# ONE JOB PER APPLIANCE, ALL AT ONCE. This was a single task with a `loop:`
+# and an `until:`, and ansible applies retries PER LOOP ITEM -- so the three
+# appliances were waited for one after another, up to 20 x 15s each. Measured
+# on demo-lab (run 94000, runtime stage markers in Loki): the stage containing
+# this took 33m01s of a 53m40s bring-up, against 18m11s for `netlab initial`
+# and 34s for the whole SD-WAN service side. Concurrently the cost is the
+# slowest appliance, not the sum of three.
+#
+# The retry budget itself is UNCHANGED and deliberately so: the comment above
+# records that a vSmart which answered a minute later once produced four
+# identical NOT_PROVEN verdicts naming the edges for a fault in the
+# controller. Waiting is right; waiting in series is not.
+- name: "Wait for each appliance's CLI to answer (fire)"
+  command: >-
+    {{ sdwan_edge_helper_prompt }} "{{ item.user }}@{{ item.host }}"
+    "{{ sdwan.appliance_ready_retries | default(20) }}"
+    "{{ sdwan.appliance_ready_delay | default(15) }}"
+  environment:
+    SSHPASS: "{{ item.password }}"
+  loop: "{{ sdwan_edge_targets }}"
+  loop_control:
+    label: "{{ item.name }} ({{ item.host }})"
+  async: "{{ sdwan.appliance_ready_timeout | default(600) }}"
+  poll: 0
+  register: sdwan_appliance_jobs
+  changed_when: false
+  failed_when: false
+
+- name: "Wait for each appliance's CLI to answer (join)"
+  async_status:
+    jid: "{{ item.ansible_job_id }}"
+  loop: "{{ sdwan_appliance_jobs.results | default([]) | selectattr('ansible_job_id', 'defined') | list }}"
+  loop_control:
+    label: "{{ item.item.name | default(item.item) }}"
+  register: sdwan_appliance_joined
+  until: sdwan_appliance_joined.finished
+  retries: "{{ sdwan.edge_join_retries | default(60) }}"
+  delay: "{{ sdwan.edge_join_delay | default(10) }}"
+  failed_when: false
+
+- name: "Name the appliances that never answered"
+  set_fact:
+    # The helper prints its own attempt count because an async job has no
+    # ansible `until:` counter to read. Parsed with an explicit loop rather
+    # than a map/first chain: jinja's `first` takes no `default`, and passing
+    # one raised "sync_do_first() got an unexpected keyword argument 'default'"
+    # -- which killed run 94896 on this reporting line, after the work was done.
+    sdwan_appliance_attempts: >-
+      {%- set out = [] -%}
+      {%- for r in sdwan_appliance_joined.results | default([]) -%}
+      {%-   set hits = (r.stdout | default('')) | regex_findall('sdwan-appliance-prompt-attempts: ([0-9]+)') -%}
+      {%-   set _ = out.append(hits[0] if hits else '0') -%}
+      {%- endfor -%}
+      {{ out }}
+    sdwan_appliance_down: >-
+      {%- set out = [] -%}
+      {%- for r in sdwan_appliance_joined.results | default([]) -%}
+      {%-   if not ((r.stdout | default('')) is search('#')) -%}
+      {%-     set _ = out.append({'name': r.item.item.name, 'host': r.item.item.host,
+                                  'detail': ((r.stdout | default('')) ~ ' ' ~ (r.stderr | default(''))) | regex_replace('\s+', ' ') | trim | truncate(160) or 'no output at all'}) -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ out }}
+
+- name: "Say which appliances are ready, and which are not"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=appliances
+      ready={{ sdwan_edge_targets | map(attribute='name') | list | difference(sdwan_appliance_down | map(attribute='name') | list) }}
+      not_answering={{ sdwan_appliance_down | map(attribute='name') | zip(sdwan_appliance_down | map(attribute='detail')) | map('join', '=') | list }}
+      attempts={{ sdwan_appliance_attempts }}
+
+# An appliance that is still silent after the budget is a fabric fault, and it
+# is recorded as one on every edge -- naming the appliance, never the edge.
+- name: "If an appliance never answered, no edge can be admitted through it"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- if sdwan_appliance_down -%}
+      {%-   set why = 'the fabric appliance(s) ' ~ (sdwan_appliance_down | map(attribute='name') | zip(sdwan_appliance_down | map(attribute='host')) | map('join', ' @ ') | join(', ')) ~ ' never answered their CLI after ' ~ ((sdwan_appliance_attempts | map('int') | list | max) | string) ~ ' attempts, so this edge could not be authorised on them: ' ~ (sdwan_appliance_down | map(attribute='detail') | join(' | ')) -%}
+      {%-   for name, st in d.items() -%}
+      {%-     if st.ok -%}{%- set _ = d.update({name: st | combine({'ok': false, 'reason': why})}) -%}{%- endif -%}
+      {%-   endfor -%}
+      {%- endif -%}
+      {{ d }}
+
+# ---- STAGE 4c: the RETURN PATH, before we wait on a handshake for it -------
+#
+# An edge dials the validator; the validator answers from VPN 0. If VPN 0 has
+# no route back to the edge's transport prefix the handshake dies as DCONFAIL
+# on the edge and NOTHING says why -- measured on demo-lab (run 87451): three
+# edges behind site links sat at "connect / DCONFAIL" for twenty minutes while
+# the vBond, which had silently dropped its seeded routes, answered
+# `show running-config vpn 0 ip route` with "% No entries found." and
+# `ping vpn 0 <edge>` with "Network is unreachable". The one edge that came up
+# was the DC edge, on-link with the controllers and needing no route at all.
+#
+# So the route is CHECKED, by reading each appliance's own VPN-0 table. This
+# does not fail the run: an edge whose return path is missing is recorded with
+# that reason instead of a silent timeout, and the rest proceed.
+# ONE JOB PER APPLIANCE, ALL AT ONCE -- same reason as the prompt wait above.
+# This was a plain `loop:`, so three SSH sessions ran one after another.
+# MEASURED, run 95482 (Loki): 23:56:37 -> 23:57:12, 34.6s of wall clock for
+# three appliances on a lab with a SINGLE edge; concurrently the cost is the
+# slowest session, not the sum. Nothing about the reading changes -- the same
+# helper, the same command, the same `failed_when: false` -- only the shape.
+- name: "Read each appliance's VPN 0 routing table (fire)"
+  command: >-
+    {{ sdwan_edge_helper_session }} "{{ item.user }}@{{ item.host }}"
+    "paginate false"
+    "show ip route vpn 0 | tab"
+  environment:
+    SSHPASS: "{{ item.password }}"
+  loop: "{{ sdwan_edge_targets }}"
+  loop_control:
+    label: "{{ item.name }}"
+  async: "{{ sdwan.appliance_route_timeout | default(120) }}"
+  poll: 0
+  register: sdwan_appliance_route_jobs
+  changed_when: false
+  failed_when: false
+  no_log: true
+
+# The join delay is 5s, not the edge lane's 10s: these sessions are a single
+# `show`, measured at ~12s each, so a 10s poll would hand most of the saving
+# straight back. The BUDGET (120s) still covers the async timeout above, so no
+# appliance is given less time than it had when this ran in series.
+- name: "Read each appliance's VPN 0 routing table (join)"
+  async_status:
+    jid: "{{ item.ansible_job_id }}"
+  loop: >-
+    {{ sdwan_appliance_route_jobs.results | default([])
+       | selectattr('ansible_job_id', 'defined') | list }}
+  loop_control:
+    label: "{{ item.item.name | default(item.item) }}"
+  register: sdwan_appliance_routes
+  until: sdwan_appliance_routes.finished
+  retries: "{{ sdwan.route_join_retries | default(24) }}"
+  delay: "{{ sdwan.route_join_delay | default(5) }}"
+  changed_when: false
+  failed_when: false
+  no_log: true
+
+- name: "Which appliances can answer which edge"
+  set_fact:
+    sdwan_return_path: >-
+      {%- set d = {} -%}
+      {%- for name, st in sdwan_edge_status.items() -%}
+      {%-   set pfx = (sdwan_intent.edges | selectattr('name', 'equalto', name) | map(attribute='transport_prefix') | first | default('', true)) -%}
+      {%-   set missing = [] -%}
+      {%-   if pfx -%}
+      {%-     for r in sdwan_appliance_routes.results | default([]) -%}
+      {%-       if pfx not in (r.stdout | default('')) -%}
+      {%-         set _ = missing.append(r.item.item.name) -%}
+      {%-       endif -%}
+      {%-     endfor -%}
+      {%-   endif -%}
+      {%-   set _ = d.update({name: {'prefix': pfx, 'missing': missing}}) -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Say which return paths are in place"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=return-path device={{ item.key }}
+      transport_prefix={{ item.value.prefix | default('unknown', true) }}
+      appliances_without_a_route={{ item.value.missing }}
+  loop: "{{ sdwan_return_path | dict2items }}"
+  loop_control:
+    label: "{{ item.key }}"
+
+- name: "Record the edges whose reply can never come back"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- for name, st in d.items() -%}
+      {%-   if st.ok and (sdwan_return_path[name].missing | default([])) -%}
+      {%-     set _ = d.update({name: st | combine({'ok': false, 'reason':
+                'no return path to its transport prefix ' ~ (sdwan_return_path[name].prefix | default('?', true)) ~ ' from: ' ~ (sdwan_return_path[name].missing | join(', ')) ~ '. Its DTLS handshake would die as DCONFAIL with nothing to name it. The controllers take these routes from the day-0 CLI overlay (netlab 0050); an appliance missing them booted from a seed that dropped them.'})}) -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+
+# ---- STAGE 5: authorise every (edge x appliance) pair at once --------------
+- name: "Authorise every surviving edge on every appliance (fire)"
+  command: >-
+    {{ sdwan_edge_helper_session }} "{{ item.1.user }}@{{ item.1.host }}"
+    "request vedge add chassis-num {{ sdwan_edge_status[item.0].chassis }} serial-num {{ sdwan_edge_status[item.0].serial }} org-name \"{{ sdwan_intent.organization }}\""
+  environment:
+    SSHPASS: "{{ item.1.password }}"
+  loop: "{{ (sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list) | product(sdwan_edge_targets) | list }}"
+  loop_control:
+    label: "{{ item.0 }} -> {{ item.1.name }}"
+  async: "{{ sdwan.edge_stage_timeout | default(600) }}"
+  poll: 0
+  register: sdwan_add_jobs
+  changed_when: false
+  failed_when: false
+  no_log: true
+
+- name: "Wait for every authorisation (join)"
+  async_status:
+    jid: "{{ item.ansible_job_id }}"
+  loop: "{{ sdwan_add_jobs.results | default([]) | selectattr('ansible_job_id', 'defined') | list }}"
+  loop_control:
+    label: "{{ item.item.0 }} -> {{ item.item.1.name }}"
+  register: sdwan_add_joined
+  until: sdwan_add_joined.finished
+  retries: "{{ sdwan.edge_join_retries | default(60) }}"
+  delay: "{{ sdwan.edge_join_delay | default(10) }}"
+  failed_when: false
+  no_log: true
+
+# A reply and a SILENCE are different failures with different fixes: an
+# appliance that says "error-reason ..." refused the identity, one that says
+# nothing was never reached (netlab 0047).
+- name: "Name what every appliance said about every edge"
+  set_fact:
+    sdwan_edge_add_report: >-
+      {%- set d = {} -%}
+      {%- for r in sdwan_add_joined.results | default([]) -%}
+      {%-   set name = r.item.item.0 -%}
+      {%-   set appliance = r.item.item.1 -%}
+      {%-   set said = (r.stdout | default('')) | regex_findall('(?m)^(?:status .*|error-reason .*)$') -%}
+      {%-   set tail = (r.stdout | default('')) | regex_replace('\s+', ' ') | trim | truncate(160) -%}
+      {%-   set ok = (said | join(' ') | lower is search('status success')) or (tail | lower is search('already')) -%}
+      {%-   set entry = {'appliance': appliance.name, 'host': appliance.host, 'ok': ok,
+                         'detail': said | join(' | ') if said else ('NO REPLY -- the session reached no CLI on ' ~ appliance.host ~ (' (session output: ' ~ tail ~ ')' if tail else ' (no output at all)'))} -%}
+      {%-   set _ = d.update({name: (d[name] | default([])) + [entry]}) -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Say what every appliance answered, per edge"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=vedge-add device={{ item }}
+      chassis={{ sdwan_edge_status[item].chassis }} serial={{ sdwan_edge_status[item].serial }}
+      answers={{ (sdwan_edge_add_report[item] | default([])) | map(attribute='appliance')
+                 | zip((sdwan_edge_add_report[item] | default([])) | map(attribute='detail')) | map('join', '=') | list }}
+  loop: "{{ sdwan_edge_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+
+- name: "Drop any edge an appliance would not take"
+  set_fact:
+    sdwan_edge_status: >-
+      {%- set d = sdwan_edge_status -%}
+      {%- for name, st in d.items() -%}
+      {%-   if st.ok -%}
+      {%-     set refused = (sdwan_edge_add_report[name] | default([])) | rejectattr('ok') | list -%}
+      {%-     if refused -%}
+      {%-       set _ = d.update({name: st | combine({'ok': false, 'reason':
+                  'an appliance did not authorise it: ' ~ (refused | map(attribute='appliance') | zip(refused | map(attribute='detail')) | map('join', ' @ ') | join('; '))})}) -%}
+      {%-     endif -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+
+# ---- the reasons the verdict file will carry ------------------------------
+- name: "Carry every refusal's reason into the verdict merge"
+  set_fact:
+    sdwan_edge_reasons: >-
+      {%- set d = sdwan_edge_reasons | default({}) -%}
+      {%- for name, st in sdwan_edge_status.items() -%}
+      {%-   if not st.ok -%}
+      {%-     set _ = d.update({name: st.reason}) -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+    sdwan_edge_serials: >-
+      {%- set d = {} -%}
+      {%- for name, st in sdwan_edge_status.items() -%}
+      {%-   if st.ok -%}{%- set _ = d.update({name: st.serial}) -%}{%- endif -%}
+      {%- endfor -%}
+      {{ d }}
+
+- name: "Say which edges were admitted, and why the others were not"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=admission device={{ item.key }}
+      chassis={{ item.value.chassis }}
+      verdict={{ 'ADMITTED' if item.value.ok else 'NOT_PROVEN' }}
+      {{ ('serial=' ~ item.value.serial) if item.value.ok else ('reason=' ~ item.value.reason) }}
+  loop: "{{ sdwan_edge_status | dict2items }}"
+  loop_control:
+    label: "{{ item.key }}"
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_authorize_edge.yml b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_authorize_edge.yml
new file mode 100644
index 0000000..af4b049
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_authorize_edge.yml
@@ -0,0 +1,376 @@
+---
+# ADMIT ONE VIRTUAL WAN EDGE INTO THE FABRIC -- the flow MEASURED end to end on
+# 2026-09-06 (scratch lab sdwan-edge01, vManage 20.18.4, C8000V 17.18.03a):
+#
+#   1. the edge, booted in controller mode from its netlab-rendered
+#      ciscosdwan_cloud_init.cfg, generates its own CSR
+#        request platform software sdwan csr upload bootflash:sdwan/<n>.csr
+#      (it prompts for the organization-unit TWICE; the OU must be the fabric
+#      organization or vManage later refuses the leaf);
+#   2. the fabric CA signs it, exactly as it signs the controllers' leaves;
+#   3. the leaf is fetched by the edge over HTTP from THIS runner -- `copy`
+#      on 17.18 has no `vrf` keyword and `certificate install` takes only a
+#      bootflash: path, so day-0 carries `ip http client source-interface
+#      <mgmt>` (initial/cat8000v-kne.j2) and the copy sources from VRF
+#      Mgmt-intf, which reaches pod addresses through KubeVirt's masquerade;
+#   4. request platform software sdwan certificate install bootflash:sdwan/<n>.crt
+#      -> `show sdwan certificate serial` yields the CERTIFICATE serial;
+#   5. that serial -- NOT the day-0 token -- is what `request vedge add
+#      chassis-num <c> serial-num <s> org-name <org>` wants, on the manager,
+#      the validator AND the controller (the CLI door feeds each appliance's
+#      own control list; vManage's NMS inventory only learns the edge once it
+#      attaches). With the token as serial the validator answered SERNTPRES
+#      on every attempt; with the certificate serial the edge was `up` on the
+#      vSmart within a minute.
+#
+# WHY NOT vManage's API. POST /system/device personality=vedge answers
+# SYSTD0001 "Unable to connect to admin@<edge>:830" even against a
+# controller-mode edge with NETCONF listening (measured 2026-09-06): in
+# controller mode the edge serves NETCONF to vManage inside the DTLS tunnel,
+# which is exactly what does not exist yet. Both list-upload lanes refuse a
+# virtual platform. This is the door that is open.
+#
+# EPHEMERAL IDENTITY, BY DESIGN. The edge's keypair lives on its
+# containerDisk, so every VMI restart mints a new CSR and a new serial. That
+# is why this runs from the `onboard` lane as well as from a deploy, and why
+# the vEdge-list entry is re-authorised rather than assumed.
+#
+# ONE EDGE CANNOT FAIL THE FABRIC (netlab 0046). Everything below sits in a
+# block/rescue: an edge that cannot produce a CSR, cannot install its leaf, or
+# cannot be read back is recorded NOT_PROVEN with the reason and the play
+# moves to the next edge. A test that cannot run is not a pass -- and it is
+# not a crash either. Measured on demo-lab 2026-09-06: the serial extraction
+# raised inside the templar and took the WHOLE deployment down with
+# "FatalError in topology: Configuration deployment failed", with three edges
+# never attempted, on a lab whose 77 nodes were healthy.
+
+# The edge's IDENTITY comes from the roster and cannot fail to resolve, so it
+# is set before the block -- the rescue below needs a name to record a verdict
+# against, and a rescue that cannot name its edge is no better than a crash.
+- name: "Name this edge once, for every message below"
+  set_fact:
+    sdwan_edge_name: "{{ sdwan_edge.name }}"
+    sdwan_edge_chassis: "{{ sdwan_edge.chassis | default('') }}"
+    sdwan_edge_org: "{{ sdwan_intent.organization }}"
+    sdwan_edge_serial: ""
+    sdwan_edge_reason: ""
+
+- name: "Admit {{ sdwan_edge_name }}"
+  block:
+
+  # INSIDE the block: this reads hostvars, which is a lookup that CAN fail
+  # (an edge in the fabric roster that the Ansible inventory does not carry),
+  # and one edge's missing inventory entry must not end the play.
+  - name: "Resolve how to reach {{ sdwan_edge_name }}"
+    set_fact:
+      sdwan_edge_ssh: >-
+        {{ (hostvars[sdwan_edge_name].ansible_user | default('admin')) ~ '@' ~
+           (hostvars[sdwan_edge_name].ansible_host | default(sdwan_edge.address)) }}
+      sdwan_edge_password: "{{ hostvars[sdwan_edge_name].ansible_password | default('admin') }}"
+    no_log: true
+
+  - name: "Refuse an edge with no board identity ({{ sdwan_edge_name }})"
+    fail:
+      msg: >
+        carries no chassis. The sdwan module mints one for every cat8000v edge
+        (_push_edge_identity); its absence means the roster was rendered by a
+        netlab older than this lane.
+    when: not sdwan_edge_chassis
+
+  # ---- 1. CSR on the edge -------------------------------------------------
+  - name: "Ask the edge for a CSR with OU={{ sdwan_edge_org }} ({{ sdwan_edge_name }})"
+    script: >-
+      files/sdwan_cli_session.sh "{{ sdwan_edge_ssh }}"
+      "terminal length 0"
+      "request platform software sdwan csr upload bootflash:sdwan/{{ sdwan_edge_name }}.csr"
+      "{{ sdwan_edge_org }}" "{{ sdwan_edge_org }}" "sleep:8"
+      "more bootflash:sdwan/{{ sdwan_edge_name }}.csr"
+    environment:
+      SSHPASS: "{{ sdwan_edge_password }}"
+    register: sdwan_edge_csr_session
+    changed_when: "'CSR upload successful' in (sdwan_edge_csr_session.stdout | default(''))"
+    failed_when: false
+    no_log: true
+
+  - name: "Extract the edge's CSR ({{ sdwan_edge_name }})"
+    set_fact:
+      sdwan_edge_csr_text: >-
+        {{ (sdwan_edge_csr_session.stdout | default(''))
+           | regex_findall('(?s)-----BEGIN CERTIFICATE REQUEST-----.*?-----END CERTIFICATE REQUEST-----')
+           | first | default('', true) }}
+
+  - name: "Refuse to continue without a CSR ({{ sdwan_edge_name }})"
+    fail:
+      msg: >
+        produced no CSR. The device answers `request platform software sdwan
+        csr upload` only in CONTROLLER mode with SSH reachable on its
+        management address; an autonomous router (day-0 keyed iosxe_config.txt
+        instead of ciscosdwan_cloud_init.cfg) has no such command at all.
+    when: not sdwan_edge_csr_text
+
+  - name: "Write the CSR out ({{ sdwan_edge_name }})"
+    copy:
+      content: "{{ sdwan_edge_csr_text }}\n"
+      dest: "/tmp/sdwan-edge-{{ sdwan_edge_name }}.csr"
+      mode: "0600"
+    changed_when: false
+
+  - name: "Prove the CSR carries the fabric organization as OU ({{ sdwan_edge_name }})"
+    command: openssl req -in /tmp/sdwan-edge-{{ sdwan_edge_name }}.csr -noout -subject
+    register: sdwan_edge_csr_subject
+    changed_when: false
+    failed_when: "('OU = ' ~ sdwan_edge_org) not in sdwan_edge_csr_subject.stdout and ('OU=' ~ sdwan_edge_org) not in sdwan_edge_csr_subject.stdout"
+
+  # ---- 2. sign with the fabric CA -----------------------------------------
+  - name: "Sign it with the fabric CA ({{ sdwan_edge_name }})"
+    command: >-
+      openssl x509 -req -in /tmp/sdwan-edge-{{ sdwan_edge_name }}.csr
+      -CA {{ sdwan_ca_crt }} -CAkey {{ sdwan_ca_key }}
+      -CAserial /tmp/sdwan-fabric-ca.srl -CAcreateserial
+      -days 730 -sha256 -out {{ sdwan_edge_cert_dir }}/{{ sdwan_edge_name }}.crt
+    changed_when: true
+
+  - name: "Read the serial the CA issued ({{ sdwan_edge_name }})"
+    command: openssl x509 -in {{ sdwan_edge_cert_dir }}/{{ sdwan_edge_name }}.crt -noout -serial
+    register: sdwan_edge_issued
+    changed_when: false
+
+  # ---- 3. fetch + install --------------------------------------------------
+  - name: "Have the edge fetch and install its leaf ({{ sdwan_edge_name }})"
+    script: >-
+      files/sdwan_cli_session.sh "{{ sdwan_edge_ssh }}"
+      "terminal length 0"
+      "copy http://{{ sdwan_runner_ip }}:{{ sdwan_edge_cert_port }}/{{ sdwan_edge_name }}.crt bootflash:sdwan/{{ sdwan_edge_name }}.crt"
+      "" "" "sleep:6"
+      "request platform software sdwan certificate install bootflash:sdwan/{{ sdwan_edge_name }}.crt"
+      "sleep:12"
+    environment:
+      SSHPASS: "{{ sdwan_edge_password }}"
+    register: sdwan_edge_install_session
+    changed_when: "'Certificate Install Successful' in (sdwan_edge_install_session.stdout | default(''))"
+    failed_when: false
+    no_log: true
+
+  # ---- 4. READ THE SERIAL BACK, IN ITS OWN SESSION, UNTIL IT APPEARS -------
+  #
+  # SEPARATE, RETRIED, AND NOT no_log -- all three deliberately.
+  #
+  # SEPARATE + RETRIED because the install is not instantaneous and its
+  # duration is not ours to predict: the previous revision typed
+  # `show sdwan certificate serial` 12 seconds after the install command in
+  # the SAME fixed-sleep session, so on a busy host the show was swallowed by
+  # the still-running install and the session returned no serial at all --
+  # while the install itself SUCCEEDED (measured on demo-lab 2026-09-06:
+  # cdg-vedge01 holds certificate-status Installed and serial
+  # 12F701FE2B121B77381742178B6F759CCDEAF38D, both written during that very
+  # run, minutes after the lane had already given up on it). A fixed sleep is
+  # a guess about someone else's machine; asking again until the device
+  # answers is a measurement.
+  #
+  # NOT no_log because this session runs ONE read-only show command and
+  # carries no credential in its output -- and the whole reason the demo-lab
+  # failure took a live re-run to diagnose is that the session that held the
+  # answer was hidden. The password still travels in SSHPASS, never in argv.
+  - name: "Ask the edge for its certificate serial, until it has one ({{ sdwan_edge_name }})"
+    script: >-
+      files/sdwan_cli_session.sh "{{ sdwan_edge_ssh }}"
+      "terminal length 0"
+      "show sdwan certificate serial"
+    environment:
+      SSHPASS: "{{ sdwan_edge_password }}"
+    register: sdwan_edge_serial_session
+    changed_when: false
+    failed_when: false
+    until: >-
+      (sdwan_edge_serial_session.stdout | default(''))
+        | regex_findall('serial number: ([0-9A-Fa-f]{8,})') | length > 0
+    retries: "{{ sdwan.edge_serial_retries | default(10) }}"
+    delay: "{{ sdwan.edge_serial_delay | default(15) }}"
+
+  # regex_findall, NOT regex_search with a capture-group argument. Measured
+  # against this image's ansible-core 2.19: the `'\\1'` spelling routes the
+  # filter through its group-NUMBER path, which is not None-safe, so a
+  # non-matching read raises
+  #   "The filter plugin 'ansible.builtin.regex_search' failed:
+  #    'NoneType' object has no attribute 'group'"
+  # inside task-args finalization -- an error no `default()` further down the
+  # pipeline can catch, because the exception happens before it. That is what
+  # ended the demo-lab run. regex_findall returns [] on no match and the serial
+  # on a match; both directions verified in the runtime image.
+  - name: "Extract the certificate serial the edge now presents ({{ sdwan_edge_name }})"
+    set_fact:
+      sdwan_edge_serial: >-
+        {{ (sdwan_edge_serial_session.stdout | default(''))
+           | regex_findall('serial number: ([0-9A-Fa-f]{8,})')
+           | first | default('', true) }}
+
+  - name: "Say what the edge did with its leaf ({{ sdwan_edge_name }})"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=leaf device={{ sdwan_edge_name }}
+        chassis={{ sdwan_edge_chassis }}
+        issued_serial={{ sdwan_edge_issued.stdout | regex_replace('^serial=', '') }}
+        device_serial={{ sdwan_edge_serial | default('', true) or 'none' }}
+        install={{ 'Certificate Install Successful' in (sdwan_edge_install_session.stdout | default('')) }}
+        serial_read_attempts={{ sdwan_edge_serial_session.attempts | default(1) }}
+
+  - name: "Refuse to authorise an edge whose leaf is not the one we issued ({{ sdwan_edge_name }})"
+    fail:
+      msg: >
+        did not install the certificate we issued (device serial
+        "{{ sdwan_edge_serial | default('', true) or 'none' }}", issued
+        "{{ sdwan_edge_issued.stdout | regex_replace('^serial=', '') }}").
+        What the device said, last read:
+        {{ (sdwan_edge_serial_session.stdout | default('')) | regex_findall('(?m)^Chassis number:.*$') | last | default('no Chassis number line at all', true) | truncate(300) }}
+    when: >-
+      not sdwan_edge_serial or
+      (sdwan_edge_serial | upper) != (sdwan_edge_issued.stdout | regex_replace('^serial=', '') | upper)
+
+  # ---- 5. authorise chassis + CERTIFICATE serial on every appliance --------
+  # THE ROSTER'S ADDRESS IS THE FABRIC'S, NOT OURS. sdwan_intent.controllers
+  # carries each controller's ENROLMENT address, which _push_onboarding_facts
+  # sets transport-first on purpose: vManage logs into the controller over the
+  # fabric to enrol it, so the fabric address is the right one THERE. It is
+  # the wrong one HERE. This lane runs on the runner, and a transport address
+  # lives on a meshnet L2 link that no pod can route to.
+  #
+  # Measured on demo-lab 2026-09-06 from a runner-like pod:
+  #   vbond   service ClusterIP :22  -> SSH-2.0-OpenSSH_9.6
+  #   vsmart  service ClusterIP :22  -> SSH-2.0-OpenSSH_9.6
+  #   vbond   172.16.0.69:22 (roster) -> TimeoutError
+  #   vsmart  172.16.0.71:22 (roster) -> TimeoutError
+  # which is exactly the run's evidence: answers=[['status success'], [], []].
+  # The manager was reached on the address ANSIBLE uses for it and answered;
+  # the two controllers were dialled on the fabric and never answered at all.
+  # An empty answer is silence, not a refusal -- and silence had been read as
+  # a refusal.
+  #
+  # So every appliance is addressed the way Ansible addresses it: the
+  # management host from the inventory (the KNE service DNS), with the roster
+  # address kept only as a last-resort fallback for a controller the
+  # inventory does not carry.
+  - name: "List the appliances that must hold the identity: manager, then every enrolled controller"
+    set_fact:
+      sdwan_edge_targets: >-
+        {%- set t = [ {'name': inventory_hostname, 'host': sdwan_api_host, 'user': sdwan_api_user, 'password': sdwan_api_password} ] -%}
+        {%- for c in sdwan_intent.controllers -%}
+        {%-   set hv = hostvars[c.name] | default({}, true) -%}
+        {%-   set _ = t.append({'name': c.name,
+                                'host': hv.ansible_host | default(c.address, true),
+                                'user': hv.ansible_user | default(c.username | default('admin'), true),
+                                'password': hv.ansible_password | default(c.password | default('admin'), true)}) -%}
+        {%- endfor -%}
+        {{ t }}
+    no_log: true
+
+  - name: "Say which address each appliance is being dialled on ({{ sdwan_edge_name }})"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=targets device={{ sdwan_edge_name }}
+        appliances={{ sdwan_edge_targets | map(attribute='name') | zip(sdwan_edge_targets | map(attribute='host')) | map('join', '@') | list }}
+
+  # SILENCE NOW IS A WAIT, NOT A VERDICT (netlab 0049). An appliance that does
+  # not answer is the one failure that must not be blamed on an edge, so its
+  # CLI is asked to prove itself first, with a retry budget. The prompt is the
+  # proof: an ssh error prints to the same stream and never contains one.
+  - name: "Wait for each appliance's CLI to answer ({{ sdwan_edge_name }})"
+    script: >-
+      files/sdwan_cli_session.sh "{{ item.user }}@{{ item.host }}"
+      "show clock"
+    environment:
+      SSHPASS: "{{ item.password }}"
+    loop: "{{ sdwan_edge_targets }}"
+    loop_control:
+      label: "{{ item.name }} ({{ item.host }})"
+    register: sdwan_appliance_probe
+    until: (sdwan_appliance_probe.stdout | default('')) is search('#')
+    retries: "{{ sdwan.appliance_ready_retries | default(20) }}"
+    delay: "{{ sdwan.appliance_ready_delay | default(15) }}"
+    changed_when: false
+    failed_when: false
+    no_log: true
+
+  - name: "Refuse to judge {{ sdwan_edge_name }} by an appliance that never answered"
+    fail:
+      msg: >
+        could not be authorised because
+        {{ sdwan_appliance_probe.results | default([]) | rejectattr('stdout', 'search', '#') | map(attribute='item') | map(attribute='name') | list }}
+        never answered their CLI after
+        {{ sdwan_appliance_probe.results | default([]) | map(attribute='attempts') | map('default', 1) | list | max }} attempts.
+        That is a fabric fault, not this edge's.
+    when: sdwan_appliance_probe.results | default([]) | rejectattr('stdout', 'search', '#') | list | length > 0
+
+  - name: "Authorise the board identity on the manager, validator and controller ({{ sdwan_edge_name }})"
+    script: >-
+      files/sdwan_cli_session.sh "{{ item.user }}@{{ item.host }}"
+      "request vedge add chassis-num {{ sdwan_edge_chassis }} serial-num {{ sdwan_edge_serial }} org-name \"{{ sdwan_edge_org }}\""
+    environment:
+      SSHPASS: "{{ item.password }}"
+    loop: "{{ sdwan_edge_targets }}"
+    loop_control:
+      label: "{{ item.name }} ({{ item.host }})"
+    register: sdwan_vedge_adds
+    changed_when: "'status success' in (sdwan_vedge_adds.stdout | default('') | lower)"
+    failed_when: false
+    no_log: true
+
+
+  # A reply and a SILENCE are different failures and must not read the same.
+  # An appliance that answers "error-reason ..." refused the identity; one
+  # that answers nothing was never reached, and the address it was dialled on
+  # is the first thing the next reader needs.
+  - name: "Name what each appliance actually said ({{ sdwan_edge_name }})"
+    set_fact:
+      sdwan_edge_add_report: >-
+        {%- set out = [] -%}
+        {%- for r in sdwan_vedge_adds.results -%}
+        {%-   set said = (r.stdout | default('')) | regex_findall('(?m)^(?:status .*|error-reason .*)$') -%}
+        {%-   set tail = (r.stdout | default('')) | regex_replace('\s+', ' ') | trim | truncate(160) -%}
+        {%-   set _ = out.append({'appliance': r.item.name,
+                                  'host': r.item.host,
+                                  'said': said,
+                                  'ok': (said | join(' ') | lower is search('status success')) or (tail | lower is search('already')),
+                                  'detail': said | join(' | ') if said else ('NO REPLY -- the session reached no CLI on ' ~ r.item.host ~ (' (session output: ' ~ tail ~ ')' if tail else ' (no output at all)'))}) -%}
+        {%- endfor -%}
+        {{ out }}
+
+  - name: "Say what each appliance answered ({{ sdwan_edge_name }})"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=vedge-add device={{ sdwan_edge_name }}
+        chassis={{ sdwan_edge_chassis }} serial={{ sdwan_edge_serial }}
+        answers={{ sdwan_edge_add_report | map(attribute='appliance') | zip(sdwan_edge_add_report | map(attribute='detail')) | map('join', '=') | list }}
+
+  - name: "Refuse to call an edge admitted when an appliance would not take it ({{ sdwan_edge_name }})"
+    fail:
+      msg: >
+        an appliance did not authorise it (chassis {{ sdwan_edge_chassis }},
+        serial {{ sdwan_edge_serial }}):
+        {% for r in sdwan_edge_add_report | rejectattr('ok') | list %}
+        {{ r.appliance }} @ {{ r.host }}: {{ r.detail }};
+        {% endfor %}
+    when: sdwan_edge_add_report | rejectattr('ok') | list | length > 0
+
+  - name: "Remember this edge's serial ({{ sdwan_edge_name }})"
+    set_fact:
+      sdwan_edge_serials: "{{ (sdwan_edge_serials | default({})) | combine({sdwan_edge_name: sdwan_edge_serial}) }}"
+
+  # ---- the whole point of the block: one edge's failure is ITS verdict -----
+  rescue:
+
+  - name: "Record why {{ sdwan_edge_name }} was not admitted"
+    set_fact:
+      sdwan_edge_reasons: >-
+        {{ (sdwan_edge_reasons | default({}))
+           | combine({sdwan_edge_name:
+               (ansible_failed_result.msg | default('admission failed with no message'))
+               | regex_replace('\\s+', ' ') | trim | truncate(400)}) }}
+
+  - name: "Say that {{ sdwan_edge_name }} is NOT_PROVEN, and carry on with the rest"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=admission device={{ sdwan_edge_name }}
+        chassis={{ sdwan_edge_chassis }} verdict=NOT_PROVEN
+        reason={{ sdwan_edge_reasons[sdwan_edge_name] | default('unknown') }}
+        -- the fabric keeps the edges that DID pass; this one is recorded, not
+        fatal, and re-running `onboard` retries it.
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_enrol_and_sign.yml b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_enrol_and_sign.yml
new file mode 100644
index 0000000..b7dc416
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_enrol_and_sign.yml
@@ -0,0 +1,136 @@
+---
+# Enrol ONE controller and certificate-sign it before the next -- the vendor's
+# add -> CSR -> sign -> install interleave. See the banner in sdwan.yml for why
+# the order is load-bearing (device-blind install; CSR context from enrolment).
+
+# SILENCE NOW IS A WAIT, NOT A VERDICT -- HERE TOO, BUT ASKED FROM THE RIGHT
+# PLACE. The edge-onboarding lane (sdwan_edge_add.yml, 0049) taught this for
+# edges asking a controller to authorise them: retry with a budget instead of
+# trusting a first "not reachable". A first cut of this fix (2026-09-21,
+# reverted same day) copied that pattern literally -- probe the controller's
+# own CLI over SSH with files/sdwan_cli_session.sh -- and that is wrong HERE.
+# The edge probe runs from wherever THAT play's host is, which has a real
+# path to an edge's address; this play's host is vmanage, and every task in
+# it that needs the lab's transport fabric already delegates to localhost
+# (the ansible CONTROLLER, i.e. the netlab-up job pod) because the script/
+# module tooling lives there, not on the Viptela boxes. Measured live
+# (demo-lab rebuild, an internal task): the job pod has NO route to ANY
+# transport-VLAN address -- `nc -w5 172.16.2.70 22` times out, same for
+# vsmart's 172.16.2.72 -- while it reaches vManage's Kubernetes Service IP
+# (a mgmt/API address) fine. A CLI probe from that pod can never succeed
+# against a controller's transport address, healthy or not: 20 retries just
+# delayed the identical failure by ~12 minutes with a different message.
+#
+# THE ONE PATH THAT DOES REACH vbond'S TRANSPORT ADDRESS is vManage's OWN
+# backend, over the lab's meshnet fabric -- which is exactly how the ORIGINAL
+# error surfaced: "Manager error: ... Unable to connect to ...@172.16.2.70:830"
+# is vManage's server-side connection attempt, relayed back through its REST
+# API to this ansible task (itself reached over vManage's mgmt Service IP,
+# which the job pod DOES have a route to -- the API call always got through;
+# only vManage's own downstream SSH to vbond failed). So the retry has to be
+# on the REAL action, not a stand-in for it: fire the enrol call itself
+# repeatedly, on the SAME budget the edge lane uses
+# (sdwan.appliance_ready_retries/_delay), and only fail loudly once vManage's
+# own attempts are exhausted.
+#
+# THE RACE THIS CLOSES (unchanged from the first cut). The vManage
+# exclusive-admission fix (kneAdmissionExclusiveModels chart value) made
+# vManage's own dockerd-hang boot failure rare, so it now typically starts
+# enrolling controllers earlier and more reliably -- and vbond, which used to
+# have vManage's own slow boot as informal cover, no longer does.
+- name: "Enrol {{ sdwan_ctrl.name }} ({{ sdwan_ctrl.personality }} {{ sdwan_ctrl.address }})"
+  cisco.catalystwan.devices_controllers:
+    manager_credentials: "{{ sdwan_manager_credentials }}"
+    state: present
+    device_ip: "{{ sdwan_ctrl.address }}"
+    hostname: "{{ sdwan_ctrl.name }}"
+    username: "{{ sdwan_ctrl.username | default('admin') }}"
+    password: "{{ sdwan_ctrl.password | default('admin') }}"
+    personality: "{{ sdwan_ctrl.personality }}"
+    # The vendor's default, and the vendor's contract: enrolment opens the
+    # certificate workflow on vManage, so the later install has a CSR to bind to.
+    # GENERATE THE CSR EXACTLY ONCE, IN THE SIGN STEP -- NOT HERE.
+    # Every generate_csr makes a NEW CSR and bumps the common-name index:
+    #   vsmart-<chassis>-0.viptela.com, then -1, then -2 ...
+    # Enrolling with generate_csr: true produced -0, the sign step then produced
+    # -1, and installing the certificate signed from one against the other fails
+    # in vManage's own words (run 76295):
+    #   Failed to retrieve device data / 'Not able to find any device for CSR
+    #   common name vsmart-<chassis>-0.viptela.com' / DEVLIFECYCLE0002
+    # while the device record held deviceCSRCommonName ...-1.viptela.com.
+    # The module default is true, so this must be set false explicitly.
+    generate_csr: false
+  register: sdwan_enrol_one
+  # RETRY THE CALL ITSELF, not a proxy for it. Any outcome other than the
+  # "Could not perform" connectivity-refused pattern stops the loop
+  # immediately -- success obviously, but also any OTHER failure message,
+  # since retrying wouldn't fix a real config error and the "Refuse to
+  # continue" task below still catches it. state: present makes a retried
+  # add idempotent: a failed attempt does not partially register the device.
+  until: not ((sdwan_enrol_one.msg | default('')) is search('Could not perform'))
+  retries: "{{ sdwan.appliance_ready_retries | default(20) }}"
+  delay: "{{ sdwan.appliance_ready_delay | default(15) }}"
+  no_log: true
+  failed_when: false
+
+# failed_when: false stamps failed=false on every result, so the module's msg is
+# the surviving failure signal (send_request_safely formats it as
+# "Could not perform '<action>' action."). Reaching here means the retry
+# budget above is exhausted -- this is no longer a first-attempt verdict.
+- name: "Refuse to continue if vManage would not enrol {{ sdwan_ctrl.name }}"
+  fail:
+    msg: >
+      vManage refused to enrol {{ sdwan_ctrl.name }} ({{ sdwan_ctrl.personality }}
+      {{ sdwan_ctrl.address }}) after
+      {{ (sdwan.appliance_ready_retries | default(20) | int) * (sdwan.appliance_ready_delay | default(15) | int) }}s
+      of retries: {{ sdwan_enrol_one.msg | default('no message') }}.
+      Organization, validator and signing mode are already set, so the fabric
+      settings are not the cause -- check that the controller answers SSH on its
+      TRANSPORT address FROM vManage (not from this ansible run, which has no
+      route to it) and that its day-0 applied (a controller whose day-0 commit
+      aborted is reachable, healthy, and has no personality).
+  when: (sdwan_enrol_one.msg | default('')) is search('Could not perform')
+
+- name: "Read vManage's inventory after enrolling {{ sdwan_ctrl.name }}"
+  cisco.catalystwan.devices_info:
+    manager_credentials: "{{ sdwan_manager_credentials }}"
+    device_category: controllers
+  register: sdwan_inv_after
+
+# SIGN EXACTLY THE CONTROLLER JUST ENROLLED, AND NEVER THE SAME BOX TWICE.
+# The previous revision looped over "whatever is not Installed", on the premise
+# that after enrolling one controller that set is exactly that controller. It is
+# not: cert_install_status does NOT flip to Installed when the install call
+# returns -- that is what the read-back at the end of sdwan.yml exists to prove
+# -- so the box enrolled FIRST is still "Not Installed" when the second one is
+# enrolled, and it gets signed a SECOND time.
+#
+# A second signing round is not a harmless retry. Measured on vsmart 20.7.1
+# (run 76217, device /var/log/messages):
+#     10:23:38 netconf upload  -> security-install-csr      (CSR #1)
+#     10:23:43 netconf install                              (cert from CSR #1)
+#     10:23:46 netconf upload  -> security-install-csr      (CSR #2)
+#     10:24:07 netconf install
+# generate_csr REGENERATES the device's private key, so the certificate
+# installed seconds earlier no longer matches it. The device ends up holding
+# neither cert -- `show certificate installed` empty, certificate-status
+# Not-Installed -- while vManage happily reports a stored
+# deviceEnterpriseCertificate. Both controllers failed exactly this way.
+#
+# Matching on device_ip is safe HERE, before the box is up: vManage holds the
+# enrolment address (measured: deviceIP 172.16.0.2 / 172.16.0.3 with host_name
+# still None) and only re-keys to the system-ip once control connections form,
+# which cannot happen until this certificate is installed. The uuid guard makes
+# it deterministic even if that ever changes.
+- name: "Certificate-sign the controller just enrolled"
+  include_tasks: sdwan_sign_controller.yml
+  loop: >-
+    {{ sdwan_inv_after.devices | default([])
+       | selectattr('device_ip', 'defined')
+       | selectattr('device_ip', 'equalto', sdwan_ctrl.address)
+       | rejectattr('cert_install_status', 'equalto', 'Installed')
+       | rejectattr('uuid', 'in', sdwan_signed_uuids | default([]))
+       | list }}
+  loop_control:
+    loop_var: sdwan_target
+    label: "{{ sdwan_target.host_name | default(sdwan_target.uuid, true) }} ({{ sdwan_target.device_ip | default('?') }})"
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_service_vpns.yml b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_service_vpns.yml
new file mode 100644
index 0000000..4fdf726
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_service_vpns.yml
@@ -0,0 +1,505 @@
+---
+# THE SERVICE SIDE OF THE WAN EDGES, delivered by vManage after admission.
+#
+# An edge the admission lane has PROVEN carries VPN 0 and VPN 512 and routes
+# nothing: no service VRF, so its site is unreachable over the overlay. This
+# stage gives each PROVEN edge that declares one (sdwan.service_vpn in the
+# topology -> sdwan_intent.edges[].service) its service VRF, its site-facing
+# interfaces, its loopback and the site's routing protocol with the seam to
+# OMP -- through vManage, as a per-edge CLI template, the way the owner asked
+# for it: "from the api, yes - not day 0; that was hard fought".
+#
+# NETLAB RENDERS, vMANAGE DELIVERS. The intent was derived by the sdwan module
+# from the edge's own netlab modules (ospf/bgp/eigrp: areas, neighbours,
+# router-ids computed as for any router); templates/sdwan_service_vpn.cli.j2
+# renders it as controller-mode IOS-XE; files/sdwan_service_vpn.py grafts it
+# onto the running configuration vManage holds for the device (a CLI template
+# is a WHOLE configuration, not a fragment) and the collection's own modules
+# create/update the template and attach it. No hand-rolled REST anywhere.
+#
+# SEQUENCED AFTER THE VERDICT. Runs only for edges whose admission verdict is
+# PROVEN, after the read-back that produced it. An edge that is not proven is
+# NOT_ATTEMPTED here, with that reason, and nothing is sent for it.
+#
+# IDEMPOTENT. The overlay owns named blocks; those are stripped from the
+# running configuration before the graft, so a re-run produces the same file,
+# cli_templates' own diff reports "same as provided", and the device is not
+# touched. A changed intent updates the template and cli_templates reattaches
+# it (force: true) -- replacing, never stacking. Attach is issued only when the
+# template has no device attached yet.
+#
+# ITS OWN VERDICT, PER EDGE, READ BACK: ROUTED means vManage's copy of the
+# device's running configuration carries every owned block AND the
+# controller's OMP table carries every prefix the edge originates (its service
+# links and loopback) -- the site is reachable over the overlay; PUSHED means
+# the configuration landed but, within the read-back budget, the controller
+# never carried those prefixes (the reason names whether the edge advertised
+# them or not, and its OMP peer states) -- a DEGRADED edge: control plane up,
+# service side not routing; REFUSED means vManage or the device said no (the
+# message is the reason); NOT_PROVEN means the attach was accepted but the
+# configuration does not carry the owned blocks; NOT_ATTEMPTED means the edge
+# was not eligible (not proven, no intent, not visible to vManage). What the
+# site advertises beyond the edge's own prefixes is reported, not gated.
+# Nothing here fails the play: the same rule the admission lane keeps. But a
+# run in which every edge is PUSHED and none ROUTED is not a success, and the
+# summary in sdwan.yml says DEGRADED, per edge, with the reason.
+#
+# MEASURED before this verdict existed (demo-lab runs 131674, 136222, 137827,
+# 2026-09-11): all four edges PUSHED with routed=False, the run summary said
+# "4 PROVEN", and host-to-host across the overlay was 0/3 on every pair.
+
+- name: "Which proven edges declare a service side"
+  set_fact:
+    sdwan_svc_edges: >-
+      {{ sdwan_intent.edges | default([])
+         | selectattr('service', 'defined')
+         | selectattr('name', 'in', sdwan_edge_verdicts | default([])
+                                     | selectattr('verdict', 'equalto', 'PROVEN')
+                                     | map(attribute='name') | list)
+         | list }}
+    sdwan_svc_status: >-
+      {%- set d = {} -%}
+      {%- set proven = sdwan_edge_verdicts | default([]) | selectattr('verdict', 'equalto', 'PROVEN') | map(attribute='name') | list -%}
+      {%- for e in sdwan_intent.edges | default([]) -%}
+      {%-   if e.service is not defined -%}
+      {%-     set _ = d.update({e.name: {'ok': false, 'verdict': 'NOT_ATTEMPTED', 'reason': 'the topology declares no service VPN for this edge (sdwan.service_vpn)', 'template': ''}}) -%}
+      {%-   elif e.name not in proven -%}
+      {%-     set _ = d.update({e.name: {'ok': false, 'verdict': 'NOT_ATTEMPTED', 'reason': 'the edge is not PROVEN on the controller; nothing is attached to an edge that has not enrolled', 'template': ''}}) -%}
+      {%-   else -%}
+      {%-     set _ = d.update({e.name: {'ok': true, 'verdict': '', 'reason': '', 'template': 'skyforge-' ~ e.name ~ '-service'}}) -%}
+      {%-   endif -%}
+      {%- endfor -%}
+      {{ d }}
+    sdwan_svc_dir: "/tmp/sdwan-service"
+    sdwan_svc_helper: "files/sdwan_service_vpn.py"
+
+- name: "Say which edges get a service side, and which do not"
+  debug:
+    msg: >-
+      sdwan-edge-evidence: stage=service-plan device={{ item.key }}
+      eligible={{ item.value.ok }} vpn={{ (sdwan_intent.edges | selectattr('name', 'equalto', item.key) | map(attribute='service.vpn') | first) | default('none', true) }}
+      {{ ('template=' ~ item.value.template) if item.value.ok else ('reason=' ~ item.value.reason) }}
+  loop: "{{ sdwan_svc_status | dict2items }}"
+  loop_control:
+    label: "{{ item.key }}"
+
+- name: "Nothing to deliver: keep the verdicts as they are"
+  set_fact:
+    sdwan_edge_verdicts: >-
+      {%- set out = [] -%}
+      {%- for v in sdwan_edge_verdicts | default([]) -%}
+      {%-   set st = sdwan_svc_status.get(v.name, {}) -%}
+      {%-   set _ = out.append(v | combine({'service': {'verdict': st.verdict | default('NOT_ATTEMPTED'), 'reason': st.reason | default(''), 'template': st.template | default(''), 'routed': false}})) -%}
+      {%- endfor -%}
+      {{ out }}
+  when: sdwan_svc_edges | length == 0
+
+- name: "Deliver the service side of every proven edge"
+  when: sdwan_svc_edges | length > 0
+  block:
+  - name: "Create the working directory"
+    file:
+      path: "{{ sdwan_svc_dir }}"
+      state: directory
+      mode: "0700"
+    changed_when: false
+
+  - name: "The helper proves it can merge before it touches anything"
+    script: "{{ sdwan_svc_helper }} selftest"
+    register: sdwan_svc_selftest
+    changed_when: false
+    failed_when: false
+
+  - name: "Refuse every edge if the helper cannot pass its own test"
+    set_fact:
+      sdwan_svc_status: >-
+        {%- set d = sdwan_svc_status -%}
+        {%- set raw = (sdwan_svc_selftest.stdout | default('', true)) | trim -%}
+        {%- set ok = raw.startswith('{') and ((raw | from_json).selftest | default('')) == 'ok' -%}
+        {%- if not ok -%}
+        {%-   set why = 'the merge helper failed its self-test: ' ~ ((raw or (sdwan_svc_selftest.stderr | default(''))) | regex_replace('\s+', ' ') | trim | truncate(200)) -%}
+        {%-   for name, st in d.items() -%}
+        {%-     if st.ok -%}{%- set _ = d.update({name: st | combine({'ok': false, 'verdict': 'NOT_ATTEMPTED', 'reason': why})}) -%}{%- endif -%}
+        {%-   endfor -%}
+        {%- endif -%}
+        {{ d }}
+
+  # ---- render: the overlay netlab owns, one file per edge ------------------
+  - name: "Say what the self-test returned"
+    # It ran two tasks ago and said nothing when it PASSED, so a self-test that
+    # passed and one that was never reached looked identical in the log.
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=service-selftest rc={{ sdwan_svc_selftest.rc | default('none') }}
+        stdout_bytes={{ (sdwan_svc_selftest.stdout | default('')) | length }}
+        stderr={{ (sdwan_svc_selftest.stderr | default('')) | regex_replace('\s+', ' ') | trim | truncate(300) or 'none' }}
+
+  - name: "Render each edge's service-side overlay"
+    template:
+      src: "templates/sdwan_service_vpn.cli.j2"
+      dest: "{{ sdwan_svc_dir }}/{{ item.name }}.overlay.cfg"
+      mode: "0600"
+    vars:
+      edge: "{{ item }}"
+    loop: "{{ sdwan_svc_edges }}"
+    loop_control:
+      label: "{{ item.name }}"
+    when: sdwan_svc_status[item.name].ok
+    changed_when: false
+
+  # ---- prepare: running configuration from vManage + overlay -> template file
+  - name: "Stage the credential for the merge"
+    copy:
+      content: >-
+        {%- set edges = [] -%}
+        {%- for e in sdwan_svc_edges -%}
+        {%-   if sdwan_svc_status[e.name].ok -%}
+        {%-     set _ = edges.append({'name': e.name, 'chassis': e.chassis | default(''), 'system_ip': e.system_ip | default(''),
+                                      'overlay_file': sdwan_svc_dir ~ '/' ~ e.name ~ '.overlay.cfg',
+                                      'owned_blocks': e.service.owned_blocks | default([])}) -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ {'credentials': sdwan_manager_credentials, 'out_dir': sdwan_svc_dir, 'edges': edges} | to_json }}
+      dest: "{{ sdwan_svc_dir }}/prepare-input.json"
+      mode: "0600"
+    changed_when: false
+    no_log: true            # THIS task holds the credential
+
+  - name: "Read each edge's running configuration from vManage and graft the overlay"
+    script: "{{ sdwan_svc_helper }} prepare {{ sdwan_svc_dir }}/prepare-input.json"
+    register: sdwan_svc_prepare
+    changed_when: false
+    failed_when: false
+
+  - name: "Remove the staged credential"
+    file:
+      path: "{{ sdwan_svc_dir }}/prepare-input.json"
+      state: absent
+    changed_when: false
+
+  - name: "Say what the merge did, per edge"
+    # rc=0 with an empty edge list is the SAME LINE for three different
+    # failures: the helper swallowed an exception (it exits 0 by design), the
+    # helper was handed an empty list, or stdout never arrived at all. Today's
+    # run printed exactly that line and the diagnosis cost a full re-run.
+    # stdout_bytes / parsed / input_edges / error / stdout_head separate all
+    # three in one line. stage=service-readback has carried stdout_bytes since
+    # patch 0048; the prepare stage never did, and prepare is what failed.
+    #
+    # Everything is computed inside ONE expression on purpose. An Ansible
+    # `vars:` entry that renders a dict hands the next expression a STRING,
+    # so a parsed-once-reused-later refactor silently yields edges=[] for a
+    # perfectly healthy document -- caught by rendering a healthy 2-edge case
+    # and watching it come back empty.
+    vars:
+      sdwan_svc_prepare_report: >-
+        {%- set raw = (sdwan_svc_prepare.stdout | default('', true)) | trim -%}
+        {%- set parsed = raw | from_json if raw.startswith('{') else {} -%}
+        {%- set out = [] -%}
+        {%- for e in parsed.edges | default([]) -%}
+        {%-   set _ = out.append({'name': e.name | default(''),
+                                  'ok': e.ok | default(false),
+                                  'base_lines': e.base_lines | default(0),
+                                  'merged_lines': e.merged_lines | default(0),
+                                  'replaced': e.replaced_blocks | default(0),
+                                  'reason': e.reason | default(''),
+                                  'device': e.device | default({})}) -%}
+        {%- endfor -%}
+        stdout_bytes={{ raw | length }}
+        parsed={{ 'yes' if raw.startswith('{') else 'NO -- stdout is not a JSON object' }}
+        input_edges={{ parsed.input_edges | default('n/a') }}
+        error={{ (parsed.error | default('none')) | regex_replace('\s+', ' ') | trim | truncate(300) }}
+        edges={{ out }}
+        stdout_head={{ raw[:300] | regex_replace('\s+', ' ') }}
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=service-prepare rc={{ sdwan_svc_prepare.rc | default('none') }}
+        {{ sdwan_svc_prepare_report }}
+        stderr={{ (sdwan_svc_prepare.stderr | default('')) | regex_replace('\s+', ' ') | trim | truncate(600) or 'none' }}
+
+  - name: "Keep each edge's merged configuration file, and drop the edges vManage could not serve"
+    set_fact:
+      sdwan_svc_status: >-
+        {%- set d = sdwan_svc_status -%}
+        {%- set raw = (sdwan_svc_prepare.stdout | default('', true)) | trim -%}
+        {%- set parsed = raw | from_json if raw.startswith('{') else {} -%}
+        {%- set by_name = {} -%}
+        {%- for e in parsed.edges | default([]) -%}{%- set _ = by_name.update({e.name: e}) -%}{%- endfor -%}
+        {%- for name, st in d.items() -%}
+        {%-   if st.ok -%}
+        {%-     set e = by_name.get(name, {}) -%}
+        {%-     if e.ok | default(false) -%}
+        {%-       set _ = d.update({name: st | combine({'config_file': e.config_file, 'already_carried': e.already_carried | default(false), 'device': e.device | default({})})}) -%}
+        {%-     else -%}
+        {%-       set _ = d.update({name: st | combine({'ok': false, 'verdict': 'NOT_ATTEMPTED',
+                    'reason': 'the merge could not be prepared: ' ~ (e.reason | default('the helper returned no entry for this edge (rc=' ~ (sdwan_svc_prepare.rc | default('none')) ~ ' stdout_bytes=' ~ (raw | length) ~ ' input_edges=' ~ (parsed.input_edges | default('n/a')) ~ (' error=' ~ (parsed.error | truncate(200)) if parsed.error | default('') else '') ~ ')', true))})}) -%}
+        {%-     endif -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ d }}
+
+  # ---- deliver: the collection creates/updates the template, then attaches
+  - name: "Create or update each edge's CLI template on vManage"
+    cisco.catalystwan.cli_templates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      state: present
+      template_name: "{{ sdwan_svc_status[item].template }}"
+      template_description: "skyforge netlab: service VPN {{ (sdwan_svc_edges | selectattr('name', 'equalto', item) | map(attribute='service.vpn') | first) }} of {{ item }} (netlab renders, vManage delivers)"
+      device_model: "vedge-C8000V"
+      config_file: "{{ sdwan_svc_status[item].config_file }}"
+      force: true
+      timeout_seconds: "{{ sdwan.service_attach_timeout | default(600) }}"
+    loop: "{{ sdwan_svc_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+    register: sdwan_svc_template
+    # ignore_errors, NOT failed_when: false.
+    #
+    # Both suppress the abort; only ONE preserves the verdict. `failed_when:
+    # false` OVERWRITES the result's failed flag with false, so the
+    # "Drop any edge ... vManage refused/would not attach" branches below --
+    # which test `r.failed` -- were DEAD CODE and every refusal fell through to
+    # the success branch.
+    #
+    # MEASURED 2026-09-10 on sdwan-service-min: vManage answered "Failed to
+    # attach device template: skyforge-site1-edge01-service" with failed=False,
+    # the edge was not dropped, attached_now was recorded as true, and the
+    # service verdict then blamed "the attach was accepted but the running
+    # configuration does not carry vrf definition 200..." -- a wrong diagnosis
+    # that sent the investigation after the device instead of after the attach.
+    #
+    # ignore_errors keeps failed: true on the result AND continues the play, so
+    # one edge's refusal still does not cost the others their verdict.
+    ignore_errors: true
+
+  - name: "Say what vManage did with each template"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=service-template device={{ item.item }}
+        template={{ sdwan_svc_status[item.item].template }}
+        changed={{ item.changed | default(false) }} failed={{ item.failed | default(false) }}
+        msg={{ (item.msg | default('')) | regex_replace('\s+', ' ') | trim | truncate(240) }}
+    loop: "{{ sdwan_svc_template.results | default([]) }}"
+    loop_control:
+      label: "{{ item.item }}"
+
+  - name: "Drop any edge whose template vManage refused"
+    set_fact:
+      sdwan_svc_status: >-
+        {%- set d = sdwan_svc_status -%}
+        {%- for r in sdwan_svc_template.results | default([]) -%}
+        {%-   if r.failed | default(false) -%}
+        {%-     set _ = d.update({r.item: d[r.item] | combine({'ok': false, 'verdict': 'REFUSED',
+                  'reason': 'vManage refused the CLI template: ' ~ ((r.msg | default('no message')) | regex_replace('\s+', ' ') | trim | truncate(300))})}) -%}
+        {%-   else -%}
+        {%-     set _ = d.update({r.item: d[r.item] | combine({'template_changed': r.changed | default(false)})}) -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ d }}
+
+  - name: "Which templates already have their device attached"
+    cisco.catalystwan.cli_templates_info:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      filters:
+        name: "{{ sdwan_svc_status[item].template }}"
+    loop: "{{ sdwan_svc_status | dict2items | selectattr('value.ok') | map(attribute='key') | list }}"
+    register: sdwan_svc_template_info
+    failed_when: false
+
+  - name: "Attach each new template to its edge (fire)"
+    # ASYNC/POLL:0, NOT A SYNCHRONOUS LOOP.
+    #
+    # MEASURED 2026-09-19 on demo-lab an internal task: four edges, one after
+    # another, cost 115s wall-clock in this one task -- the single largest
+    # item in the whole 35-minute bring-up's SD-WAN onboarding phase. Each
+    # attach is an independent per-device vManage API call with nothing to
+    # serialize on (unlike the controller cert chain in sdwan_sign_controller.yml,
+    # which genuinely must enrol vbond before vsmart). Firing all four and
+    # joining turns the sum into the max, the same idiom the CSR/install/serial
+    # stages above already use.
+    cisco.catalystwan.device_templates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      state: attached
+      template_name: "{{ sdwan_svc_status[item.item].template }}"
+      hostname: "{{ sdwan_svc_status[item.item].device.hostname | default(item.item, true) }}"
+      timeout_seconds: "{{ sdwan.service_attach_timeout | default(600) }}"
+    loop: "{{ sdwan_svc_template_info.results | default([]) }}"
+    loop_control:
+      label: "{{ item.item }}"
+    when: >-
+      (item.templates_info | default([]) | map(attribute='devices_attached') | map('default', 0) | map('int') | sum) == 0
+    async: "{{ sdwan.service_attach_timeout | default(600) }}"
+    poll: 0
+    register: sdwan_svc_attach_fire
+    ignore_errors: true
+
+  - name: "Wait for every attach (join)"
+    async_status:
+      jid: "{{ item.ansible_job_id }}"
+    loop: "{{ sdwan_svc_attach_fire.results | default([]) | selectattr('ansible_job_id', 'defined') | list }}"
+    loop_control:
+      label: "{{ item.item.item }}"
+    register: sdwan_svc_attach_joined
+    until: sdwan_svc_attach_joined.finished
+    retries: "{{ sdwan.edge_join_retries | default(60) }}"
+    delay: "{{ sdwan.edge_join_delay | default(10) }}"
+    # ignore_errors, NOT failed_when: false -- same reasoning as the old
+    # synchronous task's comment (kept below on the merge step, since this is
+    # now where a real vManage refusal actually surfaces): `failed_when: false`
+    # would overwrite r.failed and make "Drop any edge vManage would not
+    # attach" below dead code again.
+    ignore_errors: true
+
+  - name: "Combine attach results: skipped edges pass through as-is, fired edges take their joined outcome"
+    # WHY A MERGE STEP. `when:` still short-circuits template_info entries
+    # that already have a device attached (idempotency, unchanged) -- those
+    # never got an ansible_job_id and so never went through the join. The
+    # downstream tasks below were written against ONE results list covering
+    # every edge, skipped or not, so this rebuilds that shape: skipped ->
+    # pass the fire-task's own skipped result through unchanged; fired ->
+    # substitute the join task's result (which carries the real
+    # failed/msg/changed vManage returned, per the comment on the join task
+    # above). Matched by ansible_job_id, which is unique per fired job.
+    #
+    # RE-PARENT `item` ON THE JOINED ENTRY. The join task loops over the FIRE
+    # task's results, so a joined entry's `.item` is the fire result and the
+    # edge name sits one level deeper than the consumers below expect
+    # (`.item.item` would be the templates_info result DICT, not the name).
+    # MEASURED 2026-09-19, demo-lab an internal task: "Drop any edge vManage
+    # would not attach" used that dict as a dict KEY and the whole bring-up
+    # failed with `unhashable type: '_AnsibleLazyTemplateDict'` after all 80
+    # pods were already up. Setting `item` back to the fire result's own
+    # `item` (the templates_info entry) restores `results[i].item.item ==
+    # edge name`, byte-for-byte the shape the old synchronous task produced.
+    set_fact:
+      sdwan_svc_attach: >-
+        {%- set combined = [] -%}
+        {%- for r in sdwan_svc_attach_fire.results | default([]) -%}
+        {%-   if r.ansible_job_id is defined -%}
+        {%-     set j = (sdwan_svc_attach_joined.results | default([]) | selectattr('ansible_job_id', 'equalto', r.ansible_job_id) | list | first) -%}
+        {%-     set _ = combined.append(j | combine({'item': r.item})) -%}
+        {%-   else -%}
+        {%-     set _ = combined.append(r) -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ {'results': combined} }}
+
+  - name: "Say what the attach did, per edge"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=service-attach device={{ item.item.item }}
+        skipped={{ item.skipped | default(false) }} changed={{ item.changed | default(false) }} failed={{ item.failed | default(false) }}
+        msg={{ (item.msg | default('')) | regex_replace('\s+', ' ') | trim | truncate(240) }}
+    loop: "{{ sdwan_svc_attach.results | default([]) }}"
+    loop_control:
+      label: "{{ item.item.item }}"
+
+  - name: "Drop any edge vManage would not attach"
+    set_fact:
+      sdwan_svc_status: >-
+        {%- set d = sdwan_svc_status -%}
+        {%- for r in sdwan_svc_attach.results | default([]) -%}
+        {%-   set name = r.item.item -%}
+        {%-   if r.failed | default(false) -%}
+        {%-     set _ = d.update({name: d[name] | combine({'ok': false, 'verdict': 'REFUSED',
+                  'reason': 'vManage would not attach the CLI template: ' ~ ((r.msg | default('no message')) | regex_replace('\s+', ' ') | trim | truncate(300))})}) -%}
+        {%-   else -%}
+        {%-     set _ = d.update({name: d[name] | combine({'attached_now': not (r.skipped | default(false))})}) -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ d }}
+
+  # ---- read back: the device's running configuration and the controller's OMP table
+  - name: "Stage the credential for the read-back"
+    copy:
+      content: >-
+        {%- set edges = [] -%}
+        {%- for e in sdwan_svc_edges -%}
+        {%-   if sdwan_svc_status[e.name].ok -%}
+        {%-     set _ = edges.append({'name': e.name, 'chassis': e.chassis | default(''), 'system_ip': e.system_ip | default(''),
+                                      'vpn': e.service.vpn, 'owned_blocks': e.service.owned_blocks | default([]),
+                                      'expect_prefixes': e.service.omp.expect_prefixes | default([])}) -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ {'credentials': sdwan_manager_credentials, 'edges': edges,
+            'controller_system_ips': sdwan_intent.controllers | selectattr('personality', 'equalto', 'vsmart') | map(attribute='system_ip') | list,
+            'poll_seconds': sdwan.service_readback_seconds | default(300), 'poll_interval': 15} | to_json }}
+      dest: "{{ sdwan_svc_dir }}/readback-input.json"
+      mode: "0600"
+    changed_when: false
+    no_log: true
+
+  - name: "Read back what each edge runs and what the controller routes for it"
+    script: "{{ sdwan_svc_helper }} readback {{ sdwan_svc_dir }}/readback-input.json"
+    register: sdwan_svc_readback
+    changed_when: false
+    failed_when: false
+
+  - name: "Remove the staged read-back credential"
+    file:
+      path: "{{ sdwan_svc_dir }}/readback-input.json"
+      state: absent
+    changed_when: false
+
+  - name: "Say what the read-back itself returned"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=service-readback rc={{ sdwan_svc_readback.rc | default('none') }}
+        stdout_bytes={{ (sdwan_svc_readback.stdout | default('')) | length }}
+        stderr={{ (sdwan_svc_readback.stderr | default('')) | regex_replace('\s+', ' ') | trim | truncate(200) or 'none' }}
+
+  - name: "The verdict, per edge, from what was read back"
+    set_fact:
+      sdwan_svc_status: >-
+        {%- set d = sdwan_svc_status -%}
+        {%- set raw = (sdwan_svc_readback.stdout | default('', true)) | trim -%}
+        {%- set parsed = raw | from_json if raw.startswith('{') else {} -%}
+        {%- set by_name = {} -%}
+        {%- for e in parsed.edges | default([]) -%}{%- set _ = by_name.update({e.name: e}) -%}{%- endfor -%}
+        {%- for name, st in d.items() -%}
+        {%-   if st.ok -%}
+        {%-     set e = by_name.get(name, {}) -%}
+        {%-     if e.config_ok | default(false) and (e.omp | default({})).routed | default(false) -%}
+        {%-       set _ = d.update({name: st | combine({'verdict': 'ROUTED', 'reason': '', 'omp': e.omp | default({})})}) -%}
+        {%-     elif e.config_ok | default(false) -%}
+        {%-       set _ = d.update({name: st | combine({'verdict': 'PUSHED', 'omp': e.omp | default({}),
+                    'reason': 'the configuration landed but the service VPN is not routing: '
+                              ~ ((e.omp | default({})).reason | default('the controller carries none of ' ~ ((e.omp | default({})).expected | default([]) | join(', ')), true))
+                              ~ ' after ' ~ ((e.omp | default({})).waited_seconds | default('?')) ~ 's / ' ~ ((e.omp | default({})).attempts | default('?')) ~ ' read(s)'
+                              ~ (('; read-back errors: ' ~ ((e.omp | default({})).errors | join(' | ') | truncate(300))) if (e.omp | default({})).errors | default([]) else '')})}) -%}
+        {%-     else -%}
+        {%-       set _ = d.update({name: st | combine({'ok': false, 'verdict': 'NOT_PROVEN', 'omp': e.omp | default({}),
+                    'reason': 'the attach was accepted but the running configuration vManage reads does not carry ' ~ ((e.missing_blocks | default([])) | join(', ') or 'the owned blocks') ~ (('; ' ~ e.reason) if e.reason | default('') else '')})}) -%}
+        {%-     endif -%}
+        {%-   endif -%}
+        {%- endfor -%}
+        {{ d }}
+
+  - name: "Say what each edge now runs, and what the controller carries for it"
+    debug:
+      msg: >-
+        sdwan-edge-evidence: stage=service device={{ item.key }}
+        verdict={{ item.value.verdict }} template={{ item.value.template }}
+        template_changed={{ item.value.template_changed | default('n/a') }} attached_now={{ item.value.attached_now | default('n/a') }}
+        routed={{ item.value.omp.routed | default('n/a') }}
+        omp_expected={{ item.value.omp.expected | default([]) }} omp_seen={{ item.value.omp.seen | default([]) }}
+        edge_advertised={{ item.value.omp.advertised | default([]) }} omp_peers={{ item.value.omp.peers | default([]) }}
+        site_prefixes={{ item.value.omp.site_prefixes | default([]) }}
+        controller_query={{ item.value.omp.controller_query | default('n/a') }} controller_rows={{ item.value.omp.controller_rows | default('n/a') }}
+        waited={{ item.value.omp.waited_seconds | default('n/a') }}s attempts={{ item.value.omp.attempts | default('n/a') }}
+        {{ ('reason=' ~ item.value.reason) if item.value.reason else '' }}
+    loop: "{{ sdwan_svc_status | dict2items }}"
+    loop_control:
+      label: "{{ item.key }}={{ item.value.verdict }}"
+
+  - name: "Fold the service verdicts into the edge verdicts"
+    set_fact:
+      sdwan_edge_verdicts: >-
+        {%- set out = [] -%}
+        {%- for v in sdwan_edge_verdicts | default([]) -%}
+        {%-   set st = sdwan_svc_status.get(v.name, {}) -%}
+        {%-   set _ = out.append(v | combine({'service': {'verdict': st.verdict | default('NOT_ATTEMPTED'),
+                                                          'reason': st.reason | default(''),
+                                                          'template': st.template | default(''),
+                                                          'routed': (st.omp | default({})).routed | default(false),
+                                                          'omp': st.omp | default({})}})) -%}
+        {%- endfor -%}
+        {{ out }}
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_sign_controller.yml b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_sign_controller.yml
new file mode 100644
index 0000000..7a8a8e2
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/sdwan_sign_controller.yml
@@ -0,0 +1,423 @@
+---
+# Certificate-sign ONE controller from vManage's own inventory: ask vManage to
+# make the DEVICE generate a CSR, sign it with the fabric CA, and install the
+# result.
+#
+# sdwan_target is a devices_info ENTRY, not a roster entry -- so device_ip is
+# the address vManage itself holds for the box, which is the only one its
+# inventory filter will match, and host_name/uuid are vManage's names for it.
+#
+# THE DEVICE MUST GENERATE ITS OWN CSR, against its own private key. vManage
+# does that over its NETCONF session to the box, which is why enrolment has to
+# have succeeded first. A CSR signed on the device's behalf is refused at
+# install with "CSR not generated / Certificate doesn't match CSR".
+#
+# NO REST HERE EITHER. The collection owns the endpoints and the payload shapes.
+# It does NOT own the polling for this particular call -- see the read-back in
+# sdwan.yml, which is where "installed" is actually proven.
+
+# THE TWO-ARGUMENT default() IS LOAD-BEARING. Jinja's one-argument default()
+# substitutes only for an UNDEFINED variable, never for None -- and host_name IS
+# None for a controller at this point in the lifecycle. vManage holds the
+# enrolment address with host_name still null and only re-keys to the system-ip
+# once control connections form, which cannot happen until this certificate is
+# installed (the same fact is documented in sdwan_enrol_and_sign.yml).
+#
+# With one argument, sdwan_target_name renders EMPTY for every controller. Both
+# controllers then write, sign and read the SAME files -- /tmp/sdwan-.csr and
+# /tmp/sdwan-.crt -- and every message in this file names no device at all
+# ("Ask the device to generate a CSR ()"). vmanage itself has a real host_name,
+# so it alone gets its own files, which is why the collision is invisible from
+# the one node that works.
+#
+# The signing loop is sequential per controller, so the shared path has not been
+# shown to corrupt an install on its own. It is still a defect, and an unnamed
+# device in an error message is how a two-controller failure reads as one.
+- name: "Name this controller once, for every message below"
+  set_fact:
+    sdwan_target_name: "{{ sdwan_target.host_name | default(sdwan_target.uuid, true) }}"
+    sdwan_target_ip: "{{ sdwan_target.device_ip | default('') }}"
+
+- name: "Refuse to sign a controller vManage lists without an address"
+  fail:
+    msg: >
+      vManage lists {{ sdwan_target_name }} with no device_ip, so there is no
+      handle to generate a CSR against. That is an inventory the fabric cannot
+      act on -- check that the device's day-0 committed a system-ip.
+  when: not sdwan_target_ip
+
+- name: "Skip a controller that already holds a certificate ({{ sdwan_target_name }})"
+  debug:
+    msg: "{{ sdwan_target_name }} already has a certificate installed; nothing to sign."
+  when: sdwan_target.cert_install_status | default('') == 'Installed'
+
+- name: "Sign and install"
+  when: sdwan_target.cert_install_status | default('') != 'Installed'
+  block:
+  - name: "Ask the device to generate a CSR ({{ sdwan_target_name }})"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_ip: "{{ sdwan_target_ip }}"
+      generate_csr: true
+    register: sdwan_csr
+
+  # THE ENVELOPE IS response.<response_key>, AND IT IS A LIST. send_request_safely
+  # stores every DataSequence under result.response[<key>] as a list of dumped
+  # models, so the CSR lives at response.generate_csr[0].deviceCSR. The previous
+  # revision read sdwan_csr.generate_csr.deviceCSR -- a path that does not exist,
+  # swallowed by `| default('')`, which turned a variable-path typo into "vManage
+  # returned no deviceCSR" and sent the reader after NETCONF reachability.
+  #
+  # Both spellings are accepted and a MISS NAMES THE KEYS IT DID SEE, so a
+  # collection that renames the field reports that fact instead of a silent "".
+  - name: "Extract the CSR the device produced ({{ sdwan_target_name }})"
+    set_fact:
+      sdwan_csr_text: >-
+        {{ (sdwan_csr.response.generate_csr | default([{}], true) | first).deviceCSR
+           | default((sdwan_csr.response.generate_csr | default([{}], true) | first).device_csr, true)
+           | default('', true) }}
+
+  # WHAT VMANAGE TOLD US ABOUT THE DEVICE, WHICH WE HAVE BEEN THROWING AWAY.
+  #
+  # generate_csr returns a full device record (DeviceCsrGenerationResponse in
+  # the collection) and this lane reads exactly ONE field out of it, deviceCSR.
+  # Everything else is discarded -- including the fields that answer the
+  # question this investigation is stuck on, and they arrive over the SDK on a
+  # call we already make. No device CLI, no second connection, no new access
+  # path: `raw` over the declared network_cli connection cannot work at all,
+  # because ansible has no cliconf plugin for viptela.
+  #
+  # THE ONE THAT MATTERS MOST IS deviceCSRGenTime. If it is not from THIS run,
+  # vManage handed back a CACHED CSR instead of asking the device for a fresh
+  # one -- and a certificate signed from a stale CSR is exactly a certificate
+  # the device has no key for, which is what "CSR not generated / Certificate
+  # doesn't match CSR" says. Measured 2026-09-03: the leaf we sign matches the
+  # CSR we are given (patch 0032), so if that CSR is stale the whole chain is
+  # internally consistent and still wrong at the device.
+  #
+  # rootCertHash is the device's ROOT CA as vManage sees it -- the device error
+  # also names root-ca-chain validation, and this is the only place we can read
+  # it without touching the device.
+  #
+  # deviceEnterpriseCertificate / deviceEnterpriseCertInstallTime say whether
+  # vManage is already holding a certificate for this device from an earlier
+  # attempt. Run 76217's note records vManage "happily reporting a stored
+  # deviceEnterpriseCertificate" while the device held none.
+  #
+  # This is a debug over a variable that is already registered. It cannot fail
+  # the play, which is the property the previous device-side attempt lacked.
+  - name: "EVIDENCE: what vManage says about this device ({{ sdwan_target_name }})"
+    vars:
+      sdwan_csr_rec: "{{ (sdwan_csr.response.generate_csr | default([{}], true) | first) }}"
+    debug:
+      msg: >-
+        sdwan-cert-evidence: stage=vmanage-record
+        device={{ sdwan_target_name }}
+        ip={{ sdwan_target_ip }}
+        uuid={{ sdwan_csr_rec.uuid | default('-') }}
+        csr_common_name={{ sdwan_csr_rec.deviceCSRCommonName | default('-') }}
+        csr_gen_time={{ sdwan_csr_rec.deviceCSRGenTime | default('-') }}
+        csr_gen_time_str="{{ sdwan_csr_rec.deviceCSRGenTimeString | default('-') }}"
+        cert_install_status={{ sdwan_csr_rec.certInstallStatus | default('-') }}
+        root_cert_hash={{ sdwan_csr_rec.rootCertHash | default('-') }}
+        enterprise_cert_len={{ (sdwan_csr_rec.deviceEnterpriseCertificate | default('', true)) | length }}
+        enterprise_cert_install_time={{ sdwan_csr_rec.deviceEnterpriseCertInstallTime | default('-') }}
+        state={{ sdwan_csr_rec.state | default('-') }}
+        device_state={{ sdwan_csr_rec.deviceState | default('-') }}
+        global_state={{ sdwan_csr_rec.globalState | default('-') }}
+        valid={{ sdwan_csr_rec.valid | default('-') }}
+        validity={{ sdwan_csr_rec.validity | default('-') }}
+        upload_source={{ sdwan_csr_rec.uploadSource | default('-') }}
+        personality={{ sdwan_csr_rec.personality | default('-') }}
+        vmanage_activity="{{ sdwan_csr_rec.activity | default([], true) | join(' ~ ') }}"
+
+  - name: "EVIDENCE: the clock this run is comparing that against ({{ sdwan_target_name }})"
+    debug:
+      msg: >-
+        sdwan-cert-evidence: stage=clock
+        device={{ sdwan_target_name }}
+        run_epoch={{ lookup('pipe','date +%s') }}
+        run_iso={{ lookup('pipe','date -u +%Y-%m-%dT%H:%M:%SZ') }}
+
+  - name: "Fail if no CSR came back ({{ sdwan_target_name }})"
+    fail:
+      msg: >
+        vManage returned no CSR for {{ sdwan_target_name }}
+        ({{ sdwan_target_ip }}). The response carried these keys:
+        {{ (sdwan_csr.response.generate_csr | default([{}], true) | first).keys() | list | join(', ') }}.
+        If deviceCSR is among them this is an extraction bug; if it is not,
+        vManage generates the CSR ON THE DEVICE over NETCONF, so it usually
+        means it cannot reach or log into the box.
+    when: not sdwan_csr_text
+
+  - name: "Write the CSR out ({{ sdwan_target_name }})"
+    copy:
+      content: "{{ sdwan_csr_text }}"
+      dest: "/tmp/sdwan-{{ sdwan_target_name }}.csr"
+      mode: "0600"
+
+  # WHOSE CSR IS THIS? The install side of devices_certificates is DEVICE-BLIND
+  # -- device_ip is accepted and never read, and vManage binds the PEM to
+  # whatever CSR is OUTSTANDING (see the note in sdwan.yml). Nothing here ever
+  # proved the READ side is any different. If generate_csr is device-blind too,
+  # vManage hands back the MANAGER's CSR for every device_ip we ask about, this
+  # lane signs it once per controller, and each controller is handed a leaf
+  # built from a key it does not hold.
+  #
+  # That is indistinguishable from success until the device answers, 300s
+  # later, with the only two lines that name the real fault:
+  #
+  #   Certificate Install Unsuccessful Error: ... CSR not generated
+  #   Certificate doesn't match CSR
+  #
+  # Measured 2026-09-03 (task 78840): vManage's own certificate installed and
+  # BOTH controllers failed with exactly those lines, while the OU positive
+  # control below PASSED -- so the leaf was a well-formed certificate carrying
+  # the right organization. A well-formed certificate for the WRONG KEYPAIR is
+  # precisely what a device-blind CSR read produces, and the OU check cannot
+  # see it because the OU is copied from whatever CSR arrived.
+  #
+  # The public key is the identity that matters: two devices cannot legitimately
+  # present the same one. Extract it and refuse the moment a second device is
+  # handed a CSR that another device already owns.
+  #
+  # NO SHELL, NO PIPELINE, ON PURPOSE. Hashing via `openssl ... | openssl dgst`
+  # needs bash and pipefail; without pipefail a failing openssl hashes EMPTY
+  # input, every device collides on the hash of nothing, and this check reports
+  # a device-blind read that never happened. Writing the key to a file makes
+  # openssl's own exit code the gate, and slurp compares the key material
+  # itself rather than a digest of it.
+  - name: "Extract the CSR's public key ({{ sdwan_target_name }})"
+    command: >-
+      openssl req -in /tmp/sdwan-{{ sdwan_target_name }}.csr
+      -noout -pubkey -out /tmp/sdwan-{{ sdwan_target_name }}.csr.pub
+    changed_when: false
+
+  - name: "Read the CSR's public key ({{ sdwan_target_name }})"
+    slurp:
+      src: "/tmp/sdwan-{{ sdwan_target_name }}.csr.pub"
+    register: sdwan_csr_pubkey
+
+  - name: "Record the CSR subject, so a mismatch names whose CSR it really is ({{ sdwan_target_name }})"
+    command: >-
+      openssl req -in /tmp/sdwan-{{ sdwan_target_name }}.csr -noout -subject
+    register: sdwan_csr_subject
+    changed_when: false
+
+  # THE DIAGNOSTIC. Fails at CSR time, on the runner, naming both devices --
+  # instead of 300s later on the device, in a message that blames the OU.
+  - name: "Refuse a CSR that already belongs to another device ({{ sdwan_target_name }})"
+    fail:
+      msg: >
+        vManage returned the SAME CSR public key for
+        {{ sdwan_target_name }} ({{ sdwan_target_ip }}) as it did for
+        {{ sdwan_seen_csr_keys[sdwan_csr_pubkey.content] }}.
+        Two devices cannot share a keypair, so this CSR was NOT generated on
+        {{ sdwan_target_name }}: devices_certificates is returning one
+        outstanding CSR regardless of device_ip, exactly as its install side
+        ignores device_ip. Signing it would hand {{ sdwan_target_name }} a
+        certificate for a key it does not hold, and the device would answer
+        "CSR not generated / Certificate doesn't match CSR" 300s later.
+        The CSR subject vManage returned here is:
+        {{ sdwan_csr_subject.stdout | trim }}.
+        FIX THE READ, NOT THE SUBJECT -- the subject is copied from the CSR and
+        will always look correct. The device must generate its own CSR against
+        its own private key before anything is signed for it.
+    when: >-
+      sdwan_csr_pubkey.content in (sdwan_seen_csr_keys | default({}))
+      and (sdwan_seen_csr_keys | default({}))[sdwan_csr_pubkey.content] != sdwan_target_name
+
+  - name: "Remember this device's CSR key ({{ sdwan_target_name }})"
+    set_fact:
+      sdwan_seen_csr_keys: >-
+        {{ (sdwan_seen_csr_keys | default({}))
+           | combine({ sdwan_csr_pubkey.content: sdwan_target_name }) }}
+
+  # EMIT THE EVIDENCE WHETHER OR NOT ANYTHING IS WRONG.
+  #
+  # The refusal above only speaks when it fires. A run where nothing fires then
+  # tells you the keys were distinct and shows you NOTHING about what they were
+  # -- so a quiet run cannot be distinguished from a run that never got here,
+  # and the next question ("fine, then WHOSE csr is it?") needs another build.
+  # Diagnostic state that is only printed on failure is not observability; it
+  # is a hypothesis that happened to be checked.
+  #
+  # One structured line per device, always. Grep `sdwan-cert-evidence:` in Loki
+  # and the whole per-device certificate identity for a run comes back, in
+  # order, pass or fail. The digest is computed with Jinja's hash() so this
+  # needs no shell -- see the note above on why a pipeline is not used here.
+  - name: "EVIDENCE: this device's CSR identity ({{ sdwan_target_name }})"
+    debug:
+      msg: >-
+        sdwan-cert-evidence: stage=csr
+        device={{ sdwan_target_name }}
+        ip={{ sdwan_target_ip }}
+        csr_pubkey_sha256={{ sdwan_csr_pubkey.content | hash('sha256') }}
+        csr_subject="{{ sdwan_csr_subject.stdout | trim }}"
+
+  # Local openssl, not an API call: this is OUR certificate authority signing a
+  # request, and the private key never leaves the runner. It is deployment
+  # material mounted onto this pod -- see the CA checks in sdwan.yml, which
+  # refuse to run if it is absent rather than minting a throwaway CA.
+  #
+  # -CAserial POINTS AT /tmp ON PURPOSE. -CAcreateserial alone writes <ca>.srl
+  # NEXT TO THE CA, and the CA arrives on a projected Kubernetes secret volume
+  # that is mounted read-only -- so openssl would die "Can't open … for writing"
+  # on every run, fresh or repeat, with a message about a serial file nobody
+  # asked for.
+  #
+  # DO NOT ADD -subj. THE CSR SUBJECT IS COPIED VERBATIM ON PURPOSE.
+  #
+  # Viptela validates the presented certificate's subject against the CSR it
+  # is still holding for the device -- "Certificate doesn't match CSR" is one
+  # of its error lines. `openssl x509 -req` WITHOUT -subj copies the CSR's
+  # subject DER byte for byte, which is the only way that comparison passes.
+  #
+  # Measured 2026-09-02 against the device's real CSR, pulled live from
+  # vManage: the subject already carries OU=<organization>, alongside
+  # emailAddress=support@viptela.com, encoded as PrintableString (DER tag
+  # 0x13). Passing -subj rebuilds the subject instead of copying it: it drops
+  # emailAddress, transposes O and OU, and re-encodes every value as
+  # UTF8String (tag 0x0C). The bytes then differ from the CSR's and the device
+  # refuses the certificate.
+  #
+  # A revision of this task did pass -subj, on the reading that
+  #
+  #   System organization name [  skyforge ]  does not match with cert
+  #   subject's OUs  [   ].
+  #
+  # meant the OU was absent from the leaf. It was not. The same error block
+  # continues:
+  #
+  #   Couldn't retrieve Not Before Data from certificate /tmp/vconfd/server.crt.tmp
+  #   The certificate is not valid after , Current date is ...
+  #
+  # An EMPTY notBefore and an EMPTY notAfter are the diagnostic: the device
+  # parsed NOTHING out of the file it received. Every field it reports back is
+  # empty for the same reason, the OU included. Read those empty dates as the
+  # primary evidence, not as noise trailing a subject mismatch.
+  - name: "Sign it with the fabric CA ({{ sdwan_target_name }})"
+    command: >-
+      openssl x509 -req -in /tmp/sdwan-{{ sdwan_target_name }}.csr
+      -CA {{ sdwan_ca_crt }} -CAkey {{ sdwan_ca_key }}
+      -CAserial /tmp/sdwan-fabric-ca.srl -CAcreateserial
+      -days 730 -sha256 -out /tmp/sdwan-{{ sdwan_target_name }}.crt
+
+  # POSITIVE CONTROL, not decoration: prove the OU actually landed in the leaf
+  # before handing it to vManage. It arrives by way of the CSR subject being
+  # copied verbatim, so this also fails if anything ever starts rewriting that
+  # subject -- which is exactly the regression to catch, since an OU mismatch
+  # is invisible until vManage rejects the install 300s later.
+  - name: "Prove the signed leaf carries the fabric organization ({{ sdwan_target_name }})"
+    command: >-
+      openssl x509 -in /tmp/sdwan-{{ sdwan_target_name }}.crt -noout -subject
+    register: sdwan_leaf_subject
+    changed_when: false
+    failed_when: >-
+      ('OU = ' ~ sdwan_intent.organization) not in sdwan_leaf_subject.stdout
+      and ('OU=' ~ sdwan_intent.organization) not in sdwan_leaf_subject.stdout
+
+  # SECOND HALF OF THE SAME PROOF. The OU check above proves the leaf carries
+  # the right organization; it says nothing about WHOSE KEY the leaf certifies,
+  # which is the field the device actually rejects on. `openssl x509 -req`
+  # copies the CSR's public key, so this holds by construction today -- that is
+  # the point: it PINS the property, so any future revision that signs one
+  # device's certificate from another device's CSR fails HERE, on the runner,
+  # instead of silently producing an installable certificate for the wrong box.
+  - name: "Extract the signed leaf's public key ({{ sdwan_target_name }})"
+    command: >-
+      openssl x509 -in /tmp/sdwan-{{ sdwan_target_name }}.crt
+      -noout -pubkey -out /tmp/sdwan-{{ sdwan_target_name }}.crt.pub
+    changed_when: false
+
+  - name: "Read the signed leaf's public key ({{ sdwan_target_name }})"
+    slurp:
+      src: "/tmp/sdwan-{{ sdwan_target_name }}.crt.pub"
+    register: sdwan_leaf_pubkey
+
+  - name: "Prove the leaf certifies the key from THIS device's CSR ({{ sdwan_target_name }})"
+    fail:
+      msg: >
+        The certificate signed for {{ sdwan_target_name }} certifies a
+        different public key than the CSR it was built from. Installing it
+        would give the device a certificate for a key it does not hold, and
+        the device would report "Certificate doesn't match CSR".
+    when: sdwan_leaf_pubkey.content != sdwan_csr_pubkey.content
+
+  # Same rule for the leaf and for the CA that signed it. The device's error
+  # names root-ca-chain validation, so WHICH CA signed this leaf is evidence we
+  # should never have to rebuild an image to see.
+  - name: "Read the fabric CA identity ({{ sdwan_target_name }})"
+    command: >-
+      openssl x509 -in {{ sdwan_ca_crt }} -noout -subject -fingerprint -sha256
+    register: sdwan_ca_identity
+    changed_when: false
+
+  - name: "EVIDENCE: signed leaf and signing CA identity ({{ sdwan_target_name }})"
+    debug:
+      msg: >-
+        sdwan-cert-evidence: stage=leaf
+        device={{ sdwan_target_name }}
+        leaf_pubkey_sha256={{ sdwan_leaf_pubkey.content | hash('sha256') }}
+        leaf_subject="{{ sdwan_leaf_subject.stdout | trim }}"
+        ca="{{ sdwan_ca_identity.stdout | trim | replace('\n', ' | ') }}"
+
+  - name: "Read the signed certificate ({{ sdwan_target_name }})"
+    slurp:
+      src: "/tmp/sdwan-{{ sdwan_target_name }}.crt"
+    register: sdwan_signed
+
+  # wait_for_completed is NOT passed, because this module ignores it for an
+  # install: install_signed_certificate routes through send_request_safely,
+  # which never polls, so the argument would document a guarantee that does not
+  # exist. The verdict is read back in sdwan.yml, from vManage's inventory,
+  # after every controller has been through this file.
+  - name: "Install the signed certificate ({{ sdwan_target_name }})"
+    cisco.catalystwan.devices_certificates:
+      manager_credentials: "{{ sdwan_manager_credentials }}"
+      device_ip: "{{ sdwan_target_ip }}"
+      install_signed_certificate: "{{ sdwan_signed.content | b64decode }}"
+    register: sdwan_install
+
+  # WHAT vMANAGE SAID, KEPT RATHER THAN DISCARDED.
+  #
+  # install_signed_certificate goes through the collection's send_request_safely,
+  # which stores the manager's reply under result.response.install_signed_cert and
+  # does NOT poll a task. The lane used to print only .msg, so a refused install
+  # and an accepted one looked identical and the only signal was the read-back
+  # timing out 300s later with "Not Installed" -- a symptom that names the
+  # certificate while saying nothing about the cause. Measured 2026-09-02: both
+  # controllers reached this point, the device ended with an EMPTY
+  # "show certificate installed", and vManage's reply was never recorded.
+  #
+  # Keep the whole reply per controller and hand it to the read-back's failure
+  # message. Shape-agnostic on purpose: whatever the manager returns is evidence.
+  - name: "Record what vManage returned for the install ({{ sdwan_target_name }})"
+    set_fact:
+      sdwan_install_reports: "{{ (sdwan_install_reports | default([])) + [ {
+        'name': sdwan_target_name,
+        'address': sdwan_target_ip,
+        'msg': sdwan_install.msg | default(''),
+        'response': sdwan_install.response | default({}) } ] }}"
+
+  - name: "Say what vManage returned for the install ({{ sdwan_target_name }})"
+    debug:
+      msg: >-
+        {{ sdwan_target_name }}: {{ sdwan_install.msg | default('certificate submitted') }}
+        -- manager reply: {{ sdwan_install.response | default({}) }}
+        (installed is proven by the read-back, not by this call)
+
+  - name: "Refuse to call an install submitted when vManage returned nothing ({{ sdwan_target_name }})"
+    fail:
+      msg: >-
+        vManage returned no reply for the signed certificate of
+        {{ sdwan_target_name }} ({{ sdwan_target_ip }}). The install endpoint
+        always answers -- an empty reply means the call did not reach the
+        certificate workflow at all, and waiting 300s for a status that can
+        never change would only hide that.
+    when: (sdwan_install.response | default({})) == {}
+
+
+  - name: "Remember this device was signed, so no later pass re-keys it"
+    set_fact:
+      sdwan_signed_uuids: "{{ (sdwan_signed_uuids | default([])) + [ sdwan_target.uuid ] }}"
diff --git a/netsim/ansible/tasks/cisco_sdwan-manager/templates/sdwan_service_vpn.cli.j2 b/netsim/ansible/tasks/cisco_sdwan-manager/templates/sdwan_service_vpn.cli.j2
new file mode 100644
index 0000000..297fba0
--- /dev/null
+++ b/netsim/ansible/tasks/cisco_sdwan-manager/templates/sdwan_service_vpn.cli.j2
@@ -0,0 +1,177 @@
+{#
+  THE SERVICE SIDE OF ONE WAN EDGE, as IOS-XE SD-WAN (controller-mode) CLI.
+
+  Rendered by the manager's lane (sdwan_service_vpns.yml) from the intent the
+  sdwan module derived (sdwan.onboarding.edges[].service), one file per edge,
+  and grafted onto the running configuration vManage holds for the device by
+  files/sdwan_service_vpn.py before it becomes that edge's CLI template. This
+  is NOT the whole device configuration -- only the blocks the intent OWNS
+  (service.owned_blocks); everything the day-0 put there stays as it is.
+
+  SYNTAX IS CONTROLLER-MODE IOS-XE, not Viptela and not classic IOS. Sources:
+    Cisco Catalyst SD-WAN Routing Configuration Guide, IOS XE 17.x,
+      "OMP route redistribution" -- `omp / address-family ipv4 vrf N /
+      advertise {connected|static|bgp|eigrp|ospf external}`; connected, static
+      and OSPF intra/inter-area routes are advertised by default, BGP, EIGRP
+      and OSPF external only when named.
+      "OSPF and OSPFv3 protocol" -- `router ospf N vrf N / redistribute omp`.
+    Qualified Command Reference, "EIGRP commands" -- named mode only:
+      `router eigrp <name> / address-family ipv4 unicast vrf N
+      autonomous-system A / topology base / redistribute omp metric ...`.
+    Qualified Command Reference, "Routing" -- `router bgp A / address-family
+      ipv4 vrf N / redistribute omp`.
+  The VRF carries an RD and route-targets the way vManage's own generated
+  configuration does (`rd 1:N`, import/export 1:N).
+
+  PURE JINJA2. Every address/netmask/wildcard was computed by the sdwan
+  module (_ipv4_parts); no ansible filter is needed, so the same file renders
+  identically offline (the render gate) and in the lane.
+#}
+{%- set svc = edge.service -%}
+{%- set vpn = svc.vpn -%}
+vrf definition {{ vpn }}
+ rd 1:{{ vpn }}
+ address-family ipv4
+  route-target export 1:{{ vpn }}
+  route-target import 1:{{ vpn }}
+ exit-address-family
+!
+{% if svc.nat is defined and svc.nat %}
+{#- DIA: this leaks VRF {{ vpn }}'s own default route into the global
+    (transport) table, where the edge's `sdwan / interface X / nat` (day-0,
+    on whichever transport interface declared sdwan.nat) actually performs
+    the translation. A standalone top-level command, not a block header --
+    _edge_service_intent lists this exact line in owned_blocks so a
+    re-render replaces rather than stacks it, same as every block here. #}
+ip nat route vrf {{ vpn }} 0.0.0.0 0.0.0.0 global
+!
+{% endif %}
+{% if svc.loopback is defined %}
+interface {{ svc.loopback.ifname }}
+ description service VPN {{ vpn }} loopback
+ vrf forwarding {{ vpn }}
+ ip address {{ svc.loopback.address }} {{ svc.loopback.netmask }}
+{# The loopback is in OSPF only when netlab put it there (node.loopback.ospf),
+   the same gate netlab's own ospf templates use; an edge whose loopback was
+   taken out of OSPF (`loopback.ospf: false`) keeps it out here too. #}
+{% if svc.ospf is defined and svc.loopback.ospf is defined %}
+ ip ospf {{ svc.ospf.process }} area {{ svc.loopback.ospf.area }}
+{% endif %}
+!
+{% endif %}
+{% for i in svc.interfaces %}
+interface {{ i.ifname }}
+ description service VPN {{ vpn }}{% if i.neighbors %} to {{ i.neighbors | join(', ') }}{% endif %}
+
+ vrf forwarding {{ vpn }}
+ ip address {{ i.address }} {{ i.netmask }}
+{# NO `ip mtu` HERE, AT ANY VALUE. vManage's cEdge CLI-template model has no
+    such element, and a template push is transactional -- one unknown element
+    costs the WHOLE service VPN.
+
+    Measured against a live vManage 20.18.4, three ways, all refused:
+      ip mtu 8950  -> device pulled the config then refused it:
+                      CONFD_ERRCODE_INCONSISTENT_VALUE (38) ... % Invalid input
+                      (`ip mtu` cannot exceed the L2 MTU, 1500 on a cat8000v)
+      mtu 8950     -> vManage refused the TEMPLATE:
+                      syntax error: unknown command / Error: mtu 8950
+      ip mtu 1500  -> vManage refused the TEMPLATE, on all four demo-lab edges:
+                      syntax error: element does not exist / Error: ip mtu 1500
+
+    The lane's only PASSING run (sdwan-service-min, r74) emitted NO mtu line at
+    all -- the value was 8950 and a <=1500 guard suppressed it. Clamping the
+    link to 1500 then made that same guard emit `ip mtu 1500`, which is how
+    demo-lab found this. Absence is the proven-good state, so make it
+    unconditional rather than a guard that can flip back on.
+
+    THE SEAM still gets its agreement, from the other end: cat8000v declares
+    features.initial.max_mtu 1500 so netlab clamps the LINK and the peer (an
+    ASA at 8950 in demo-lab) renders 1500 too. That is device config netlab owns
+    on a device that accepts it -- not a line pushed through vManage.
+
+    Do NOT reach for `ip ospf mtu-ignore`: it hides the mismatch instead of
+    fixing it.
+    WHITESPACE CONTROL MATTERS HERE. This comment uses PLAIN delimiters on
+    purpose. A leading dash strips the newline that ENDS the ip address line and
+    a trailing dash strips the one before ip ospf, welding two commands into one
+    so vManage answered, on all four demo-lab edges:
+      Error: ip address 10.1.0.162 255.255.255.252 ip ospf 200 area 0.0.0.0
+      syntax error: element does not exist
+    Do not add the dashes back. #}
+{% if i.ospf is defined and svc.ospf is defined %}
+ ip ospf {{ svc.ospf.process }} area {{ i.ospf.area }}
+{% if i.ospf.network_type in ('point-to-point', 'broadcast', 'non-broadcast', 'point-to-multipoint') %}
+ ip ospf network {{ i.ospf.network_type }}
+{% endif %}
+{% endif %}
+ no shutdown
+!
+{% endfor %}
+{% if svc.ospf is defined %}
+router ospf {{ svc.ospf.process }} vrf {{ vpn }}
+ router-id {{ svc.ospf.router_id }}
+{% if svc.ospf.redistribute_omp %}
+ redistribute omp
+{% endif %}
+{% for i in svc.interfaces if i.ospf is defined and i.ospf.passive %}
+ passive-interface {{ i.ifname }}
+{% endfor %}
+!
+{% endif %}
+{% if svc.eigrp is defined %}
+router eigrp sdwan
+ address-family ipv4 unicast vrf {{ vpn }} autonomous-system {{ svc.eigrp.as }}
+  eigrp router-id {{ svc.eigrp.router_id }}
+{% for i in svc.interfaces if i.eigrp is defined and i.eigrp.passive %}
+  af-interface {{ i.ifname }}
+   passive-interface
+  exit-af-interface
+{% endfor %}
+  topology base
+{% if svc.eigrp.redistribute_omp %}
+   redistribute omp metric {{ svc.eigrp.metric }}
+{% endif %}
+  exit-af-topology
+{# `network` for the interfaces that CARRY eigrp, as templates/eigrp/ios.j2
+   does for every other IOS router netlab builds: a service interface with
+   `eigrp: false` is in the VRF but not in the routing process. #}
+{% for i in svc.interfaces if i.eigrp is defined %}
+  network {{ i.address }} 0.0.0.0
+{% endfor %}
+{% if svc.loopback is defined and svc.loopback.eigrp is defined %}
+  network {{ svc.loopback.address }} 0.0.0.0
+{% endif %}
+ exit-address-family
+!
+{% endif %}
+{% if svc.bgp is defined %}
+router bgp {{ svc.bgp.as }}
+ bgp log-neighbor-changes
+ address-family ipv4 vrf {{ vpn }}
+  bgp router-id {{ svc.bgp.router_id }}
+{% if svc.bgp.advertise_loopback and svc.loopback is defined %}
+  network {{ svc.loopback.address }} mask {{ svc.loopback.netmask }}
+{% endif %}
+{% if svc.bgp.redistribute_omp %}
+  redistribute omp
+{% endif %}
+{% for n in svc.bgp.neighbors %}
+  neighbor {{ n.ipv4 }} remote-as {{ n.as }}
+  neighbor {{ n.ipv4 }} description {{ n.name }}
+{% if n.update_source %}
+  neighbor {{ n.ipv4 }} update-source {{ n.update_source }}
+{% endif %}
+  neighbor {{ n.ipv4 }} activate
+{% endfor %}
+ exit-address-family
+!
+{% endif %}
+sdwan
+ omp
+  address-family ipv4 vrf {{ vpn }}
+{% for a in svc.omp.advertise %}
+   advertise {{ a }}
+{% endfor %}
+  !
+ !
+!
diff --git a/netsim/ansible/templates/initial/cisco_sdwan-controller-kne.j2 b/netsim/ansible/templates/initial/cisco_sdwan-controller-kne.j2
new file mode 100644
index 0000000..994bcd3
--- /dev/null
+++ b/netsim/ansible/templates/initial/cisco_sdwan-controller-kne.j2
@@ -0,0 +1,10 @@
+{% import 'cisco_sdwan.cloudconfig.j2' as cc with context %}
+{% macro tif(loop) %}eth{{ loop.index }}{% endmacro %}
+{% macro mif(loop) %}eth{{ loop.index + 1 }}{% endmacro %}
+{#
+  vSmart: ONE interface per VPN in the seed (init-path validator, see the
+  macro file). eth0 + the first management interface are seeded; every
+  transport interface and any further management interface ride the CLI
+  overlay the injector commits after login.
+#}
+{{ cc.cloudconfig('vsmart', cc.zcloud('vsmart', 'vsmart', false, tif, mif, false, seed_transport=false, seed_mgmt_max=1), false, cc.overlay_cli(tif, mif, 1, route=true)) }}
diff --git a/netsim/ansible/templates/initial/cisco_sdwan-controller.j2 b/netsim/ansible/templates/initial/cisco_sdwan-controller.j2
new file mode 100644
index 0000000..06f064b
--- /dev/null
+++ b/netsim/ansible/templates/initial/cisco_sdwan-controller.j2
@@ -0,0 +1,210 @@
+{#
+  OVERLAY CONFIG IS NOT DAY-0. This file brings up MANAGEMENT (VPN 512 / eth0)
+  and identity, and stops there. It deliberately does NOT write `vbond`, VPN 0
+  or tunnel-interfaces.
+
+  It used to. Patch 0045 added them and every attempt to make them correct
+  failed on a real device, three rounds running:
+
+    1. _push_overlay_facts hashed a Box -- netlab COMPILE crashed, so no sdwan
+       topology could be built at all.
+    2. `no route-consistency-check` was re-added for vSmart (rejected), and
+       trim_blocks glued `!` onto the vbond address.
+    3. vEdge: `too few 'vpn 0 interface <if> tunnel-interface encapsulation'`.
+       vSmart: `values are not unique: eth0` -- the overlay put the MANAGEMENT
+       interface into VPN 0 while VPN 512 already held it. Viptela forbids one
+       interface in two VPNs.
+
+  The serial console rejects one line at a time and aborts the whole commit, so
+  each defect hid the next. Overlay onboarding -- vbond, certificates, tunnels,
+  policy -- belongs to vManage and the cisco.catalystwan Ansible collection,
+  over an API built for it. docs/module/sdwan.md said as much from the start:
+  "SD-WAN onboarding is performed by the vendor's own controllers, and a second
+  controller writing device config would fight them."
+
+  The sdwan module still COMPUTES the overlay facts; nothing here consumes them.
+#}
+{#
+    Cisco SD-WAN vSmart controller day-0 bootstrap (KNE startup-config config-drive, pre-SSH).
+
+    Brings up management (VPN 512) so SSH is reachable for the collector collection,
+    AND the transport tunnels (VPN 0) the SD-WAN overlay actually runs on.
+
+    TWO THINGS THIS FILE USED TO GET WRONG, both of which made a healthy-looking
+    device that could never join a fabric:
+
+      1. `vbond 192.0.2.1` was hardcoded -- a TEST-NET address with nothing
+         behind it. Every device dialled an address that does not exist.
+      2. Only VPN 512 was configured. Viptela control connections run over
+         VPN 0 with a tunnel-interface; a node with management alone has no
+         tunnel to form a connection on, no matter how correct the rest is.
+
+    The fabric-level values (vbond, organization, site-id, system-ip) and the
+    transport interface list come from netsim/modules/sdwan.py::_push_overlay_facts,
+    because a template renders with NODE scope and cannot look up another node
+    -- yet every node must agree on the validator address and the organization.
+
+    THE VALIDATOR GETS `vbond <addr> local`. Without the `local` keyword it
+    points at itself as a client and never answers as one, so every other
+    device reaches it and is refused.
+
+    The `sdwan.` guards keep the device bootable when the sdwan module is NOT
+    enabled: management and SSH still come up, just no overlay.
+#}
+{#
+  NOTE: `no route-consistency-check` is deliberately ABSENT here. It is a vEdge
+  command; vSmart rejects it outright. Measured 2026-08-15 -- the serial day-0
+  injector reported, against the live device:
+
+    vsmart(config-system)#  no route-consistency-check
+    ---------------------------^
+    device rejected config line 6: ' no route-consistency-check'
+    syntax error
+
+  which aborted the whole day-0 for the controller while the vEdge in the same
+  topology configured cleanly. cisco_sdwan_edge.j2 keeps it.
+
+  RE-ADDED BY 0045 AND RE-REMOVED HERE: 0045 rewrote this template for the
+  overlay and dropped this comment along with the guard it documents, so the
+  known-bad line came back and every vSmart/vBond day-0 aborted again
+  (demo-lab 2026-08-27, CrashLoopBackOff on viptela-serial-inject).
+#}
+{#
+  FABRIC IDENTITY. These four are what make a Viptela box a member of an
+  overlay rather than a lone appliance: without system-ip, site-id,
+  organization-name and a vbond pointer it has nothing to dial and nothing to
+  identify itself with, and no control connection can form.
+
+  The sdwan module derives all four (_push_overlay_facts) because they are
+  properties of the FABRIC, not of one node -- a template renders with node
+  scope and cannot look up the validator's address or keep an organization
+  byte-identical across devices.
+
+  Measured 2026-08-31 on demo-lab: the module computed them for every node and
+  no template emitted any of them. `show running-config system | include
+  vbond` on the live vSmart returned NOTHING -- it knew its own hostname and
+  nothing about the fabric it was supposed to control.
+#}
+system
+ host-name {{ inventory_hostname }}
+ admin-tech-on-failure
+{#
+  FABRIC IDENTITY ONLY WHEN THE NODE RUNS THE sdwan MODULE. Without the module
+  the device still boots (host-name, admin, VPN 512) and simply belongs to no
+  overlay -- that is the contract the KNE provider documents for a Viptela node
+  outside a fabric. WITH the module every value below is required and the
+  strict renderer fails on a missing one; the module itself reports a missing
+  validator by name before it gets that far. No per-attribute default: a
+  guessed system-ip or vbond is the placeholder fabric this file once shipped.
+#}
+{% if sdwan is defined %}
+ system-ip               {{ sdwan.system_ip }}
+ site-id                 {{ sdwan.site_id }}
+ organization-name       "{{ sdwan.organization }}"
+ vbond                   {{ sdwan.vbond_address }}{{ " local vbond-only" if sdwan.is_validator | default(false) else "" }}
+{% endif %}
+!
+{#
+  THE DECLARED PASSWORD, not the factory one.
+
+  This used to render `password admin`, and the factory->declared transition
+  happened later over vManage's REST API. That could not work in general: while
+  the box holds the factory password every /dataservice/* answers 302 ->
+  passwordReset.html on an otherwise valid session, so the API lane had to
+  perform the very transition that unblocked its own session. vManage also
+  refuses to KEEP the factory value ("USER0002: Password for admin user cannot
+  be configured to default/last password", measured live).
+
+  Day-0 is the right place: the image already FORCES a password change on first
+  boot, and the serial injector is already answering that prompt. Having it
+  answer with the declared value makes the transition a non-event rather than a
+  special case, and this stanza keeps the committed config agreeing with it.
+
+  sdwan.declared_password is resolved fabric-wide by the sdwan module, so this
+  file, the injector's answer and the API lane's login all read ONE value.
+#}
+aaa
+ user admin
+  password {{ sdwan.declared_password | default('admin') }}
+ !
+!
+{#
+  CONTROLLERS PUT eth0 IN VPN 0, NOT VPN 512.
+
+  vSmart/vManage/vBond ship a factory config that already places eth0 in VPN 0
+  (transport/control). Adding the same interface to VPN 512 is not a second
+  address, it is a DUPLICATE, and the device refuses the whole commit:
+
+    Aborted: values are not unique: eth0
+    'vpn 0 interface eth0 if-name'
+    'vpn 512 interface eth0 if-name'
+
+  Measured 2026-08-27 on demo-lab: with day-0 stripped to basics, all four vEdges
+  configured cleanly while vSmart and vBond both aborted here -- vEdge really
+  does use eth0 as VPN 512 management, and the controllers really do not.
+  cisco_sdwan_edge.j2 keeps VPN 512 for that reason.
+#}
+vpn 0
+ interface eth0
+  ip dhcp-client
+  no shutdown
+ !
+!
+{#
+  MANAGEMENT BOOTSTRAP (VPN 512). vManage onboards a controller by opening an
+  SSH/NETCONF session to it -- "Failed to get SSH session" is the API's own
+  words when it cannot -- and Viptela serves those in the MANAGEMENT VPN.
+  Measured: tcp/22 and tcp/830 stayed closed on a VPN 0 transport interface
+  both with a tunnel-interface (allow-service filters until the tunnel is up,
+  which needs the very certificates onboarding obtains) and without one
+  (nothing listens there). The KNE management port cannot carry it either --
+  every controller boots with eth0 Up/Up and NO address.
+#}
+{% for m in sdwan.mgmt_interfaces | default([]) %}
+vpn 512
+ interface eth{{ loop.index + 1 }}
+  ip address {{ m.ipv4 }}
+  no shutdown
+ !
+!
+{% endfor %}
+{#
+  TRANSPORT BOOTSTRAP -- an ADDRESS, deliberately without a tunnel-interface.
+
+  Measured across four rig runs. Onboarding needs vManage to reach the device
+  over NETCONF, because the DEVICE has to generate its own CSR against its own
+  private key; vManage signing one for it produces "CSR not generated /
+  Certificate doesn't match CSR" on install.
+
+  Neither obvious path carried that session:
+
+    transport WITH tunnel-interface  Viptela's allow-service filter applies and
+                                     does not pass until the tunnel is up --
+                                     which needs the certificates this exists
+                                     to obtain. Measured RST-ACK on tcp/22 and
+                                     tcp/830. Adding "allow-service netconf
+                                     sshd" is in the running config and changes
+                                     nothing, for that reason.
+
+    management (eth0)                unusable here: ALL THREE controllers show
+                                     eth0 Up/Up with NO ipv4 address. The
+                                     KubeVirt pod address answers from the
+                                     cluster only through masquerade NAT, so
+                                     no such path exists from inside the lab.
+                                     Confirmed from vManage itself: every
+                                     management probe returned no-answer.
+
+  A plain addressed interface has no filter, so netconf answers and enrollment
+  can proceed. Tunnels, colours and policy are vManage's to push afterwards --
+  which is the real division of labour anyway.
+#}
+{% for t in sdwan.transport_interfaces | default([]) %}
+vpn 0
+ interface eth{{ loop.index }}
+  ip address {{ t.ipv4 }}
+  no shutdown
+ !
+!
+{% endfor %}
+
+{% include 'cisco_sdwan.rootca.j2' %}
diff --git a/netsim/ansible/templates/initial/cisco_sdwan-manager-kne.j2 b/netsim/ansible/templates/initial/cisco_sdwan-manager-kne.j2
new file mode 100644
index 0000000..64e94dd
--- /dev/null
+++ b/netsim/ansible/templates/initial/cisco_sdwan-manager-kne.j2
@@ -0,0 +1,4 @@
+{% import 'cisco_sdwan.cloudconfig.j2' as cc with context %}
+{% macro tif(loop) %}eth{{ loop.index }}{% endmacro %}
+{% macro mif(loop) %}eth{{ loop.index + 1 }}{% endmacro %}
+{{ cc.cloudconfig('vmanage', cc.zcloud('vmanage', 'vmanage', false, tif, mif, true), true, cc.overlay_routes()) }}
diff --git a/netsim/ansible/templates/initial/cisco_sdwan-manager.j2 b/netsim/ansible/templates/initial/cisco_sdwan-manager.j2
new file mode 100644
index 0000000..4295912
--- /dev/null
+++ b/netsim/ansible/templates/initial/cisco_sdwan-manager.j2
@@ -0,0 +1,210 @@
+{#
+  OVERLAY CONFIG IS NOT DAY-0. This file brings up MANAGEMENT (VPN 512 / eth0)
+  and identity, and stops there. It deliberately does NOT write `vbond`, VPN 0
+  or tunnel-interfaces.
+
+  It used to. Patch 0045 added them and every attempt to make them correct
+  failed on a real device, three rounds running:
+
+    1. _push_overlay_facts hashed a Box -- netlab COMPILE crashed, so no sdwan
+       topology could be built at all.
+    2. `no route-consistency-check` was re-added for vSmart (rejected), and
+       trim_blocks glued `!` onto the vbond address.
+    3. vEdge: `too few 'vpn 0 interface <if> tunnel-interface encapsulation'`.
+       vSmart: `values are not unique: eth0` -- the overlay put the MANAGEMENT
+       interface into VPN 0 while VPN 512 already held it. Viptela forbids one
+       interface in two VPNs.
+
+  The serial console rejects one line at a time and aborts the whole commit, so
+  each defect hid the next. Overlay onboarding -- vbond, certificates, tunnels,
+  policy -- belongs to vManage and the cisco.catalystwan Ansible collection,
+  over an API built for it. docs/module/sdwan.md said as much from the start:
+  "SD-WAN onboarding is performed by the vendor's own controllers, and a second
+  controller writing device config would fight them."
+
+  The sdwan module still COMPUTES the overlay facts; nothing here consumes them.
+#}
+{#
+    Cisco SD-WAN Manager (vManage) day-0 bootstrap (KNE startup-config config-drive, pre-SSH).
+
+    Brings up management (VPN 512) so SSH is reachable for the collector collection,
+    AND the transport tunnels (VPN 0) the SD-WAN overlay actually runs on.
+
+    TWO THINGS THIS FILE USED TO GET WRONG, both of which made a healthy-looking
+    device that could never join a fabric:
+
+      1. `vbond 192.0.2.1` was hardcoded -- a TEST-NET address with nothing
+         behind it. Every device dialled an address that does not exist.
+      2. Only VPN 512 was configured. Viptela control connections run over
+         VPN 0 with a tunnel-interface; a node with management alone has no
+         tunnel to form a connection on, no matter how correct the rest is.
+
+    The fabric-level values (vbond, organization, site-id, system-ip) and the
+    transport interface list come from netsim/modules/sdwan.py::_push_overlay_facts,
+    because a template renders with NODE scope and cannot look up another node
+    -- yet every node must agree on the validator address and the organization.
+
+    THE VALIDATOR GETS `vbond <addr> local`. Without the `local` keyword it
+    points at itself as a client and never answers as one, so every other
+    device reaches it and is refused.
+
+    The `sdwan.` guards keep the device bootable when the sdwan module is NOT
+    enabled: management and SSH still come up, just no overlay.
+#}
+{#
+  NOTE: `no route-consistency-check` is deliberately ABSENT here. It is a vEdge
+  command; vSmart rejects it outright. Measured 2026-08-15 -- the serial day-0
+  injector reported, against the live device:
+
+    vsmart(config-system)#  no route-consistency-check
+    ---------------------------^
+    device rejected config line 6: ' no route-consistency-check'
+    syntax error
+
+  which aborted the whole day-0 for the controller while the vEdge in the same
+  topology configured cleanly. cisco_sdwan_edge.j2 keeps it.
+
+  RE-ADDED BY 0045 AND RE-REMOVED HERE: 0045 rewrote this template for the
+  overlay and dropped this comment along with the guard it documents, so the
+  known-bad line came back and every vSmart/vBond day-0 aborted again
+  (demo-lab 2026-08-27, CrashLoopBackOff on viptela-serial-inject).
+#}
+{#
+  FABRIC IDENTITY. These four are what make a Viptela box a member of an
+  overlay rather than a lone appliance: without system-ip, site-id,
+  organization-name and a vbond pointer it has nothing to dial and nothing to
+  identify itself with, and no control connection can form.
+
+  The sdwan module derives all four (_push_overlay_facts) because they are
+  properties of the FABRIC, not of one node -- a template renders with node
+  scope and cannot look up the validator's address or keep an organization
+  byte-identical across devices.
+
+  Measured 2026-08-31 on demo-lab: the module computed them for every node and
+  no template emitted any of them. `show running-config system | include
+  vbond` on the live vSmart returned NOTHING -- it knew its own hostname and
+  nothing about the fabric it was supposed to control.
+#}
+system
+ host-name {{ inventory_hostname }}
+ admin-tech-on-failure
+{#
+  FABRIC IDENTITY ONLY WHEN THE NODE RUNS THE sdwan MODULE. Without the module
+  the device still boots (host-name, admin, VPN 512) and simply belongs to no
+  overlay -- that is the contract the KNE provider documents for a Viptela node
+  outside a fabric. WITH the module every value below is required and the
+  strict renderer fails on a missing one; the module itself reports a missing
+  validator by name before it gets that far. No per-attribute default: a
+  guessed system-ip or vbond is the placeholder fabric this file once shipped.
+#}
+{% if sdwan is defined %}
+ system-ip               {{ sdwan.system_ip }}
+ site-id                 {{ sdwan.site_id }}
+ organization-name       "{{ sdwan.organization }}"
+ vbond                   {{ sdwan.vbond_address }}{{ " local vbond-only" if sdwan.is_validator | default(false) else "" }}
+{% endif %}
+!
+{#
+  THE DECLARED PASSWORD, not the factory one.
+
+  This used to render `password admin`, and the factory->declared transition
+  happened later over vManage's REST API. That could not work in general: while
+  the box holds the factory password every /dataservice/* answers 302 ->
+  passwordReset.html on an otherwise valid session, so the API lane had to
+  perform the very transition that unblocked its own session. vManage also
+  refuses to KEEP the factory value ("USER0002: Password for admin user cannot
+  be configured to default/last password", measured live).
+
+  Day-0 is the right place: the image already FORCES a password change on first
+  boot, and the serial injector is already answering that prompt. Having it
+  answer with the declared value makes the transition a non-event rather than a
+  special case, and this stanza keeps the committed config agreeing with it.
+
+  sdwan.declared_password is resolved fabric-wide by the sdwan module, so this
+  file, the injector's answer and the API lane's login all read ONE value.
+#}
+aaa
+ user admin
+  password {{ sdwan.declared_password | default('admin') }}
+ !
+!
+{#
+  CONTROLLERS PUT eth0 IN VPN 0, NOT VPN 512.
+
+  vSmart/vManage/vBond ship a factory config that already places eth0 in VPN 0
+  (transport/control). Adding the same interface to VPN 512 is not a second
+  address, it is a DUPLICATE, and the device refuses the whole commit:
+
+    Aborted: values are not unique: eth0
+    'vpn 0 interface eth0 if-name'
+    'vpn 512 interface eth0 if-name'
+
+  Measured 2026-08-27 on demo-lab: with day-0 stripped to basics, all four vEdges
+  configured cleanly while vSmart and vBond both aborted here -- vEdge really
+  does use eth0 as VPN 512 management, and the controllers really do not.
+  cisco_sdwan_edge.j2 keeps VPN 512 for that reason.
+#}
+vpn 0
+ interface eth0
+  ip dhcp-client
+  no shutdown
+ !
+!
+{#
+  MANAGEMENT BOOTSTRAP (VPN 512). vManage onboards a controller by opening an
+  SSH/NETCONF session to it -- "Failed to get SSH session" is the API's own
+  words when it cannot -- and Viptela serves those in the MANAGEMENT VPN.
+  Measured: tcp/22 and tcp/830 stayed closed on a VPN 0 transport interface
+  both with a tunnel-interface (allow-service filters until the tunnel is up,
+  which needs the very certificates onboarding obtains) and without one
+  (nothing listens there). The KNE management port cannot carry it either --
+  every controller boots with eth0 Up/Up and NO address.
+#}
+{% for m in sdwan.mgmt_interfaces | default([]) %}
+vpn 512
+ interface eth{{ loop.index + 1 }}
+  ip address {{ m.ipv4 }}
+  no shutdown
+ !
+!
+{% endfor %}
+{#
+  TRANSPORT BOOTSTRAP -- an ADDRESS, deliberately without a tunnel-interface.
+
+  Measured across four rig runs. Onboarding needs vManage to reach the device
+  over NETCONF, because the DEVICE has to generate its own CSR against its own
+  private key; vManage signing one for it produces "CSR not generated /
+  Certificate doesn't match CSR" on install.
+
+  Neither obvious path carried that session:
+
+    transport WITH tunnel-interface  Viptela's allow-service filter applies and
+                                     does not pass until the tunnel is up --
+                                     which needs the certificates this exists
+                                     to obtain. Measured RST-ACK on tcp/22 and
+                                     tcp/830. Adding "allow-service netconf
+                                     sshd" is in the running config and changes
+                                     nothing, for that reason.
+
+    management (eth0)                unusable here: ALL THREE controllers show
+                                     eth0 Up/Up with NO ipv4 address. The
+                                     KubeVirt pod address answers from the
+                                     cluster only through masquerade NAT, so
+                                     no such path exists from inside the lab.
+                                     Confirmed from vManage itself: every
+                                     management probe returned no-answer.
+
+  A plain addressed interface has no filter, so netconf answers and enrollment
+  can proceed. Tunnels, colours and policy are vManage's to push afterwards --
+  which is the real division of labour anyway.
+#}
+{% for t in sdwan.transport_interfaces | default([]) %}
+vpn 0
+ interface eth{{ loop.index }}
+  ip address {{ t.ipv4 }}
+  no shutdown
+ !
+!
+{% endfor %}
+
+{% include 'cisco_sdwan.rootca.j2' %}
