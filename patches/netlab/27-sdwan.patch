+---
+description: Cisco SD-WAN Validator
+parent: unknown
+interface_name: eth{ifindex}
+mgmt_if: eth0
+clab:
+  # containerlab models the SD-WAN control plane as ONE kind with a
+  # per-appliance type, which is what netlab passes through here.
+  node:
+    kind: cisco_sdwan
+    type: validator
+  image: registry.example.com/skyforge/kubevirt/cisco_sdwan-validator:20.7.1-kne-r1
+group_vars:
+  netlab_device_type: cisco_sdwan-validator
+  ansible_network_os: viptela
+  ansible_connection: network_cli
+  ansible_user: admin
+  ansible_ssh_pass: admin
+  ansible_password: admin
+features:
+  # STATIC ROUTES, for one declaration only: `routing.static` with a default
+  # route toward the site/DC exit, which the sdwan module renders into VPN 0
+  # of this appliance's day-0 (initial/cisco_sdwan.cloudconfig.j2). The
+  # routing module never configures a Viptela appliance over Ansible -- these
+  # nodes are outside the netlab-initial limit (day-0 arrives on the boot
+  # disk) -- so this registers the upstream attribute, not a config path.
+  routing:
+    static:
+      vrf: False
+      inter_vrf: False
+      discard: False
+  # Same shape as cisco_sdwan-controller: groups.all force-adds
+  # module:[services] fleet-wide, so every device must register services
+  # support or any topology containing it fails at compile
+  # ("does not support module services" -- measured on the first vbond
+  # bring-up, 2026-08-31). The services template is a documented no-op.
+  services:
+    dns:
+      transport_vrf: false
+  sdwan:
+    types: [ validator ]
+kne:
+  node.type: validator
diff --git a/netsim/modules/sdwan.py b/netsim/modules/sdwan.py
new file mode 100644
index 0000000..3878ea2
--- /dev/null
+++ b/netsim/modules/sdwan.py
@@ -0,0 +1,1470 @@
+#
+# SD-WAN system topology and metadata transformation module
+#
+
+import ipaddress
+import typing
+from box import Box
+
+from .. import data
+from ..augment import devices, links
+from ..utils import log
+from . import _Module
+
+# containerlab scopes `type` to `kind`. On the cisco_sdwan appliances the type
+# names WHICH control-plane node this is; on cat8000v `controller` means
+# "boot SD-WAN managed", which is an EDGE in fabric terms. A device with no
+# entry here has no default type -- a plain IOS-XE c8000v declares nothing at
+# all, which is exactly how containerlab spells it.
+DEVICE_DEFAULT_TYPES = {
+  "cisco_sdwan-controller": "controller",
+  "cisco_sdwan-validator": "validator",
+  "cisco_sdwan-manager": "manager",
+  "versa-director": "controller",
+  "versa-flexvnf": "edge",
+}
+
+# The authored containerlab type -> the SD-WAN FABRIC role. Identity for every
+# device except cat8000v, where containerlab's `controller` type means the
+# box boots managed and therefore participates as an edge.
+DEVICE_TYPE_FABRIC_ROLE = {
+  "cat8000v": {"controller": "edge"},
+}
+
+# KEYS are netlab devices; VALUES are FORWARD identities and keep their own
+# spelling. The two are different namespaces that happen to spell some names
+# alike -- cisco_sdwan_edge is still what the collector calls a managed edge, even
+# though no netlab device is named that any more.
+INVENTORY_VENDOR_OS = {
+  "cat8000v": "cisco_ios_xe",
+  "cisco_sdwan-controller": "cisco_sdwan_controller",
+  "cisco_sdwan-validator": "cisco_sdwan_validator",
+  "cisco_sdwan-manager": "cisco_sdwan_manager",
+  "versa-director": "versa_director",
+  "versa-flexvnf": "versa_flexvnf",
+}
+
+# A cat8000v is IOS-XE when it is a plain router and an SD-WAN edge when it
+# boots managed. One device, two collection identities -- which is why this is
+# keyed on the FABRIC ROLE and not on the device alone. Our vBond is likewise
+# the vSmart IMAGE in the validator role.
+INVENTORY_VENDOR_OS_BY_ROLE = {
+  ("cat8000v", "edge"): "cisco_sdwan_edge",
+  ("cisco_sdwan-controller", "validator"): "cisco_sdwan_validator",
+}
+
+DEVICE_SD_WAN_VENDOR = {
+  "cat8000v": "cisco",
+  "cisco_sdwan-controller": "cisco",
+  "cisco_sdwan-validator": "cisco",
+  "cisco_sdwan-manager": "cisco",
+  "versa-director": "versa",
+  "versa-flexvnf": "versa",
+}
+
+SDWAN_INVENTORY_ROLES = {"manager", "controller", "validator", "analytics", "edge"}
+
+# The routing modules an edge may run on its SERVICE side. netlab computes
+# their facts (areas, neighbours, router-ids) exactly as for any router; the
+# sdwan module keeps their templates OUT of the edge's startup-config and
+# renders the facts into the service VRF of the vManage CLI template instead
+# (see _edge_service_intent).
+SERVICE_ROUTING_MODULES = ("ospf", "bgp", "eigrp")
+
+SYSTEM_VENDOR = {
+  "catalyst": "cisco",
+  "versa": "versa",
+}
+
+CATALYST_PROFILE = {
+  "roles": {
+    "manager": {
+      "name": "sdwan_manager",
+      "device": "cisco_sdwan-manager",
+      "system_ip_offset": 1,
+      "constraints": {"cpu": "18", "memory": "36Gi", "ephemeral-storage": "525Gi"},
+    },
+    "controller": {
+      "name": "sdwan_controller",
+      "device": "cisco_sdwan-controller",
+      "system_ip_offset": 2,
+      "constraints": {"cpu": "4", "memory": "4Gi", "ephemeral-storage": "16Gi"},
+    },
+    "validator": {
+      "name": "sdwan_validator",
+      "device": "cisco_sdwan-validator",
+      "system_ip_offset": 3,
+      "constraints": {"cpu": "2", "memory": "4Gi", "ephemeral-storage": "10Gi"},
+    },
+  },
+  "edge": {
+    "device": "cat8000v",
+    "constraints": {"cpu": "3", "memory": "6Gi", "ephemeral-storage": "50Gi"},
+  },
+}
+
+CATALYST_CONTROLLER_ARTIFACTS = {
+  "manager": ["root-ca.pem", "sdwan_manager.crt", "sdwan_manager.key", "wan-edge-serials.json"],
+  "controller": ["root-ca.pem", "sdwan_controller.crt", "sdwan_controller.key"],
+  "validator": ["root-ca.pem", "sdwan_validator.crt", "sdwan_validator.key"],
+}
+
+
+def _system_ip(network: ipaddress.IPv4Network, offset: int) -> str:
+  try:
+    address = network.network_address + offset
+  except IndexError:
+    address = network.broadcast_address
+  if address not in network or address in (network.network_address, network.broadcast_address):
+    log.error(
+      f"SD-WAN system_ip_pool {network} is too small for address offset {offset}",
+      category=log.IncorrectValue,
+      module="sdwan",
+    )
+  return str(address)
+
+
+def _bootstrap_bundle(bundle_ref: str, artifacts: list[str]) -> list[dict]:
+  return [{
+    "name": "sdwan-trust",
+    "secret_name": bundle_ref,
+    "required_keys": artifacts,
+  }]
+
+
+def _catalyst_lifecycle(controller_names: list[str], edge_names: list[str]) -> Box:
+  controller_probes = [
+    {
+      "name": "vmanage-control-plane-ready",
+      "node": "sdwan_manager",
+      "type": "vendor",
+      "vendor": "catalyst",
+      "check": "vmanage-control-plane",
+      "success": "certificate-valid && services-ready && controllers-connected",
+      "timeout": "30m",
+    },
+    {
+      "name": "vsmart-control-plane-ready",
+      "node": "sdwan_controller",
+      "type": "vendor",
+      "vendor": "catalyst",
+      "check": "vsmart-control-connections",
+      "success": "certificate-valid && vbond-connected && vmanage-connected",
+      "timeout": "20m",
+    },
+    {
+      "name": "vbond-control-plane-ready",
+      "node": "sdwan_validator",
+      "type": "vendor",
+      "vendor": "catalyst",
+      "check": "vbond-control-connections",
+      "success": "certificate-valid && vsmart-connected && vmanage-connected",
+      "timeout": "20m",
+    },
+  ]
+  edge_probes = [
+    {
+      "name": f"{name}-fabric-ready",
+      "node": name,
+      "type": "vendor",
+      "vendor": "catalyst",
+      "check": "edge-control-connections",
+      "success": "certificate-valid && vbond-connected && vsmart-connected && omp-up",
+      "timeout": "20m",
+    }
+    for name in edge_names
+  ]
+  return data.get_box({
+    "phases": [
+      {
+        "name": "controllers-admitted",
+        "nodes": controller_names,
+        "requires": [],
+        "probes": [],
+      },
+      {
+        "name": "controllers-trusted",
+        "nodes": [],
+        "requires": ["controllers-admitted"],
+        "probes": controller_probes,
+      },
+      {
+        "name": "edges-admitted",
+        "nodes": edge_names,
+        "requires": ["controllers-trusted"],
+        "probes": [],
+      },
+      {
+        "name": "fabric-ready",
+        "nodes": [],
+        "requires": ["edges-admitted"],
+        "probes": edge_probes,
+      },
+    ],
+  })
+
+
+def _node_modules(topology: Box) -> list:
+  """Modules for a GENERATED sdwan node: the topology's own list plus sdwan.
+
+  The generated controllers and edges are fabric members by construction, so
+  they declare the module themselves. Relying on the topology's global module
+  list instead would force `module: [ sdwan ]` to be global -- which drags
+  every plain transport router into a module it has no business being in.
+  """
+  mods = list(topology.get("module", []))
+  if "sdwan" not in mods:
+    mods.append("sdwan")
+  return mods
+
+
+def _add_generated_link(topology: Box, node_names: list[str], role: str) -> None:
+  link_name = f"sdwan.{role}"
+  link = links.adjust_link_object(
+    {
+      "interfaces": [{"node": name} for name in node_names],
+      "sdwan": {"role": role},
+      "type": "lan",
+    },
+    link_name,
+    topology.nodes,
+  )
+  if link is not None:
+    if not isinstance(topology.get("links", None), list):
+      topology.links = []
+    link.linkindex = links.get_next_linkindex(topology)
+    topology.links.append(link)
+
+
+def _expand_catalyst_system(topology: Box) -> None:
+  sdwan = topology.sdwan
+  transport = str(sdwan.get("control_plane.attach", "") or sdwan.get("edges.attach", ""))
+  if not transport or transport not in topology.nodes:
+    log.error(
+      "sdwan.system catalyst requires control_plane.attach or edges.attach to name an existing transport node",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+    return
+
+  try:
+    network = ipaddress.ip_network(str(sdwan.system_ip_pool), strict=False)
+  except ValueError:
+    log.error(
+      f"Invalid SD-WAN system_ip_pool {sdwan.get('system_ip_pool', '')}",
+      category=log.IncorrectValue,
+      module="sdwan",
+    )
+    return
+
+  bundle_ref = str(sdwan.get("trust.bundle_ref", "")).strip()
+  if not bundle_ref:
+    log.error(
+      "sdwan.system requires trust.bundle_ref (an existing SOPS-managed Kubernetes Secret name)",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+    return
+
+  controller_names: list[str] = []
+  for role, profile in CATALYST_PROFILE["roles"].items():
+    name = profile["name"]
+    if name in topology.nodes:
+      log.error(
+        f"sdwan.system generated node {name} collides with an existing node",
+        category=log.IncorrectValue,
+        module="sdwan",
+      )
+      continue
+    topology.nodes[name] = data.get_box({
+      "name": name,
+      "device": profile["device"],
+      "interfaces": [],
+      "module": _node_modules(topology),
+      "sdwan": {
+        "type": role,
+        "system_ip": _system_ip(network, profile["system_ip_offset"]),
+      },
+      "kne": {
+        "constraints": profile["constraints"],
+        "bootstrap_bundles": _bootstrap_bundle(bundle_ref, CATALYST_CONTROLLER_ARTIFACTS[role]),
+      },
+    })
+    controller_names.append(name)
+
+  members = sdwan.get("edges.members", {})
+  edge_device = str(sdwan.get("edges.device", "") or CATALYST_PROFILE["edge"]["device"])
+  site_id = int(sdwan.get("edges.defaults.site_id_start", 101))
+  edge_names: list[str] = []
+  for edge_offset, (name, edge_data) in enumerate(members.items()):
+    edge_data = data.get_box(edge_data or {})
+    if name in topology.nodes:
+      log.error(
+        f"sdwan.system edge {name} collides with an existing node",
+        category=log.IncorrectValue,
+        module="sdwan",
+      )
+      continue
+    edge_artifacts = [
+      "root-ca.pem",
+      f"{name}.crt",
+      f"{name}.key",
+      f"{name}.chassis-id",
+      f"{name}.serial-number",
+    ]
+    topology.nodes[name] = data.get_box({
+      "name": name,
+      "device": str(edge_data.get("device", "") or edge_device),
+      "interfaces": [],
+      "module": _node_modules(topology),
+      "sdwan": {
+        # containerlab spells a managed c8000v `type: controller`; the fabric
+        # role "edge" is derived from it.
+        "type": "controller",
+        "site_id": int(edge_data.get("site_id", site_id + edge_offset)),
+        "system_ip": str(
+          edge_data.get("system_ip", "")
+          or _system_ip(network, site_id + edge_offset)
+        ),
+      },
+      "kne": {
+        "constraints": CATALYST_PROFILE["edge"]["constraints"],
+        "bootstrap_bundles": _bootstrap_bundle(bundle_ref, edge_artifacts),
+      },
+    })
+    edge_names.append(name)
+
+  if not edge_names:
+    log.error(
+      "sdwan.system requires at least one edges.members entry",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+  elif len(edge_names) < 2 and str(sdwan.get("profile", "minimum-lab")) == "minimum-lab":
+    log.error(
+      "sdwan.profile minimum-lab requires at least two edges.members entries",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+
+  _add_generated_link(topology, [transport] + controller_names + edge_names, "transport")
+  edge_count = len(edge_names)
+  reservation = {
+    "cpu": str(24 + 3 * edge_count),
+    "memory": f"{44 + 6 * edge_count}Gi",
+    "ephemeral-storage": f"{551 + 50 * edge_count}Gi",
+  }
+  sdwan.profile = str(sdwan.get("profile", "") or "minimum-lab")
+  sdwan.vendor = "cisco"
+  sdwan.fabric = True
+  sdwan.controllers = {
+    "manager": "sdwan_manager",
+    "controller": "sdwan_controller",
+    "validator": "sdwan_validator",
+  }
+  sdwan.lifecycle = _catalyst_lifecycle(controller_names, edge_names)
+  sdwan.capacity = {"reservation": reservation}
+
+
+def _expand_system(topology: Box) -> None:
+  system = str(topology.get("sdwan.system", "")).strip().lower()
+  if not system:
+    return
+  if system == "versa":
+    log.error(
+      "Versa SD-WAN system is parked: headend licensing entitlement is unresolved",
+      category=log.IncorrectValue,
+      module="sdwan",
+    )
+    return
+  if system != "catalyst":
+    log.error(
+      f"Unsupported sdwan.system {system}",
+      category=log.IncorrectValue,
+      module="sdwan",
+    )
+    return
+  _expand_catalyst_system(topology)
+
+
+def _node_transport_address(node: Box) -> str:
+  """The node's first transport-interface address, bare.
+
+  Read off the interfaces directly rather than from sdwan.transport_interfaces,
+  because that field is populated by a later pass and this runs before it.
+  """
+  for intf in node.get("interfaces", []) or []:
+    if not isinstance(intf, Box):
+      continue
+    if str(intf.get("sdwan.role", "") or "") != "transport":
+      continue
+    addr = str(intf.get("ipv4", "") or "")
+    if addr:
+      return addr.split("/")[0]
+  return ""
+
+
+def _node_mgmt_address(node: Box) -> str:
+  return str(node.get("mgmt.ipv4", "") or node.get("mgmt.ipv6", "") or "")
+
+
+def _node_type(node: Box) -> str:
+  """The AUTHORED containerlab type, or "" for a node that declares none.
+
+  There is deliberately no "underlay" fallback: a plain device carries no type,
+  the same way it carries none in a containerlab topology.
+  """
+  return str(node.get("sdwan.type", "") or DEVICE_DEFAULT_TYPES.get(node.device, ""))
+
+
+def _fabric_role(node: Box) -> str:
+  """The SD-WAN fabric role this node plays, derived from its type."""
+  node_type = _node_type(node)
+  if not node_type:
+    return ""
+  return DEVICE_TYPE_FABRIC_ROLE.get(node.device, {}).get(node_type, node_type)
+
+
+def _check_type_support(node: Box, topology: Box, node_type: str) -> None:
+  if not node_type:
+    return
+
+  features = devices.get_device_features(node, topology.defaults)
+  valid_types = features.get("sdwan.types", [])
+  if node_type in valid_types:
+    return
+
+  log.error(
+    f"Device {node.device} (node {node.name}) cannot be used as SD-WAN type {node_type}",
+    category=log.IncorrectValue,
+    module="sdwan",
+    more_data=f"valid types: {', '.join(valid_types)}",
+  )
+
+
+def _check_vendor_support(node: Box, topology: Box, node_type: str) -> None:
+  if not node_type:
+    return
+
+  fabric_vendor = str(topology.get("sdwan.vendor", "cisco"))
+  device_vendor = DEVICE_SD_WAN_VENDOR.get(node.device, "")
+  if not device_vendor or device_vendor == fabric_vendor:
+    return
+
+  log.error(
+    f"Device {node.device} (node {node.name}) belongs to {device_vendor} SD-WAN, not {fabric_vendor}",
+    category=log.IncorrectValue,
+    module="sdwan",
+  )
+
+
+def _find_role_nodes(topology: Box) -> dict:
+  role_nodes: dict = {}
+  for node in topology.nodes.values():
+    if "sdwan" not in node:
+      continue
+    role = _fabric_role(node)
+    if not role:
+      continue
+    role_nodes.setdefault(role, []).append(node)
+  return role_nodes
+
+
+def _inventory_node_entry(node: Box) -> dict:
+  entry = {
+    "node": node.name,
+    "role": _fabric_role(node),
+    "type": _node_type(node),
+    "device": node.device,
+    "vendor": DEVICE_SD_WAN_VENDOR.get(node.device, ""),
+    "address": _node_mgmt_address(node),
+  }
+  if node.get("sdwan.site_id", None) is not None:
+    entry["site_id"] = node.sdwan.site_id
+  if node.get("sdwan.system_ip", None) is not None:
+    entry["system_ip"] = node.sdwan.system_ip
+  vendor_os = INVENTORY_VENDOR_OS_BY_ROLE.get(
+    (node.device, _fabric_role(node)),
+    INVENTORY_VENDOR_OS.get(node.device, ""),
+  )
+  if vendor_os:
+    entry["vendor_os"] = vendor_os
+  return entry
+
+
+def _build_inventory(topology: Box) -> Box:
+  vendor = str(topology.get("sdwan.vendor", "cisco"))
+  inventory_name = str(
+    topology.get("sdwan.inventory.name", "")
+    or f"{topology.name}-sdwan"
+  )
+  inventory_type = str(topology.get("sdwan.inventory.type", "") or f"{vendor}_sdwan")
+  collect_from = topology.get("sdwan.inventory.collect_from", None)
+  entries = [
+    _inventory_node_entry(node)
+    for node in topology.nodes.values()
+    if _fabric_role(node) in SDWAN_INVENTORY_ROLES
+  ]
+  if not collect_from:
+    collect_from = next((entry["node"] for entry in entries if entry["role"] == "controller"), None)
+
+  return data.get_box(
+    {
+      "name": inventory_name,
+      "vendor": vendor,
+      "type": inventory_type,
+      "collect_from": collect_from,
+      "nodes": entries,
+    }
+  )
+
+
+def _check_cisco_fabric(topology: Box, role_nodes: dict) -> None:
+  if topology.get("sdwan.vendor", "cisco") != "cisco" or not topology.get("sdwan.fabric", False):
+    return
+
+  for role in ("manager", "controller", "validator", "edge"):
+    if role_nodes.get(role, []):
+      continue
+    log.error(
+      f"Cisco SD-WAN fabric is missing a {role} node",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+
+
+def _check_versa_fabric(topology: Box, role_nodes: dict) -> None:
+  if topology.get("sdwan.vendor", "cisco") != "versa":
+    return
+
+  for role in ("controller", "edge"):
+    if role_nodes.get(role, []):
+      continue
+    log.error(
+      f"Versa SD-WAN setup is missing a {role} node",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+
+
+
+def _crypt_sha512(password: str, salt_seed: str) -> str:
+  """$6$ (SHA-512 crypt) of password with a salt derived from salt_seed.
+
+  Falls back to the plaintext if openssl is unavailable, so an offline render
+  still produces a document; the runtime image always has openssl.
+  """
+  import hashlib, shutil, subprocess
+  salt = hashlib.sha256(salt_seed.encode()).hexdigest()[:16]
+  if not shutil.which("openssl"):
+    return password
+  try:
+    out = subprocess.run(
+      ["openssl", "passwd", "-6", "-salt", salt, password],
+      capture_output=True, text=True, check=True, timeout=30).stdout.strip()
+    return out if out.startswith("$6$") else password
+  except Exception:
+    return password
+
+
+def _default_route_nexthop(node: Box, ifname: str = "") -> str:
+  """The next hop of the node's `routing.static` IPv4 default route, resolved.
+
+  netlab's routing module is the upstream declaration for "how this router
+  leaves its site": `routing.static: [{ipv4: 0.0.0.0/0, nexthop.node: <rtr>}]`,
+  and by module_cleanup it has resolved `nexthop.node` into `nexthop.ipv4`
+  (+ `nexthop.intf`). A controller-mode edge and a Viptela appliance carry no
+  routing module config of their own (they are outside the netlab-initial
+  limit), so the sdwan module renders the same declaration into their day-0:
+  `ip route 0.0.0.0 0.0.0.0 <gw>` on a cat8000v, `vpn 0 ip route 0.0.0.0/0`
+  on a Viptela seed. With ifname, an entry pinned to that interface wins;
+  otherwise the first resolved default route. Returns "" when none is
+  declared -- validator on-link, nothing rendered.
+  """
+  routes = node.get("routing.static", None)
+  if not isinstance(routes, list):
+    return ""
+  fallback = ""
+  for sr in routes:
+    if not isinstance(sr, Box):
+      continue
+    if str(sr.get("ipv4", "") or "") != "0.0.0.0/0":
+      continue
+    nh = sr.get("nexthop", None)
+    if not isinstance(nh, Box):
+      continue
+    addr = str(nh.get("ipv4", "") or "").split("/")[0]
+    if not addr:
+      continue
+    if ifname and str(nh.get("intf", "") or "") == ifname:
+      return addr
+    fallback = fallback or addr
+  return fallback
+
+
+def _transport_gateway(topology: Box, node: Box, intf: Box) -> str:
+  """The next hop an edge's transport interface uses to reach the validator."""
+  return _default_route_nexthop(node, str(intf.get("ifname", "") or ""))
+
+
+def _edge_transport_prefixes(role_nodes: dict) -> list:
+  """The subnets the fabric's edges are reachable on, as CIDR strings.
+
+  These are what a controller needs a route to -- not "everything". An edge
+  behind a site answers on its transport interface, so the controller's reply
+  has to leave by the site exit; every other destination, the management
+  network above all, must keep using the interface it already had.
+
+  Deduplicated and sorted so a re-render is byte-stable.
+  """
+  prefixes = set()
+  for node in role_nodes.get("edge", []):
+    for intf in node.get("interfaces", []) or []:
+      if not isinstance(intf, Box):
+        continue
+      if str(intf.get("sdwan.role", "") or "") != "transport":
+        continue
+      addr = str(intf.get("ipv4", "") or "")
+      if not addr or "/" not in addr:
+        continue
+      try:
+        prefixes.add(str(ipaddress.ip_interface(addr).network))
+      except ValueError:
+        continue
+  return sorted(prefixes)
+
+
+def _push_edge_identity(topology: Box, node: Box, organization: str) -> None:
+  """Give a virtual WAN edge the board identity its day-0 and the manager share.
+
+  A virtual edge has no hardware identity. In controller mode a cat8000v takes
+  its chassis number from vinitparam `uuid` and authenticates its first DTLS
+  session to the validator with vinitparam `otp`; the fabric admits it only if
+  a controller's vEdge list holds the SAME pair. Cisco's PnP portal mints the
+  pair and signs a list; a lab has no portal, and vManage 20.18.4 still carries
+  the manual door: `request vedge add chassis-num <uuid> serial-num <token>`
+  (measured on its CLI 2026-09-06, on vBond too). So the pair is minted HERE,
+  once, and consumed by both the day-0 template and the onboarding roster.
+
+  DETERMINISTIC, on purpose. A re-render must produce the identity the device
+  already booted with, or a re-driven onboarding authorises a chassis that
+  does not exist. The chassis is a v5 UUID of (organization, topology, node)
+  in the C8K-<UUID> form vManage's own C8000V entries use. The token is an
+  HMAC of the chassis under the deployment's fabric CA KEY when the platform
+  has mounted one -- unique per deployment and not derivable from the topology
+  -- and a plain digest of the same seed for an offline render, which has no
+  fabric to protect. An explicit sdwan.chassis / sdwan.token always wins, which
+  is how a portal-issued identity is carried.
+  """
+  import hashlib, hmac, uuid
+  topo_name = str(topology.get("name", "") or "")
+  seed = f"skyforge-sdwan/{organization}/{topo_name}/{node.name}"
+  chassis = str(node.get("sdwan.chassis", "") or "").strip()
+  if not chassis:
+    chassis = "C8K-" + str(uuid.uuid5(uuid.NAMESPACE_URL, seed)).upper()
+  token = str(node.get("sdwan.token", "") or "").strip()
+  if not token:
+    key_path = str(topology.get(
+      "sdwan.trust.ca_key_path", "") or "/skyforge-secrets/sdwan-ca/ca.key")
+    key_bytes = b""
+    try:
+      with open(key_path, "rb") as fh:
+        key_bytes = fh.read()
+    except OSError:
+      key_bytes = b""
+    if key_bytes:
+      token = hmac.new(key_bytes, chassis.encode(), hashlib.sha256).hexdigest()[:32]
+    else:
+      token = hashlib.sha256(f"{seed}/{chassis}".encode()).hexdigest()[:32]
+  node.sdwan.chassis = chassis
+  node.sdwan.token = token
+
+
+def _push_overlay_facts(topology: Box, role_nodes: dict) -> None:
+  """Push the facts a Viptela day-0 template cannot work out for itself.
+
+  A template renders with NODE scope -- it sees `sdwan.*` on its own node but
+  cannot look up another node. Yet three values a Viptela device needs to join
+  an overlay are properties of the FABRIC:
+
+    vbond          the validator's address; every node must point at the SAME
+                   one, knowable only once the validator is placed
+    organization   must be byte-identical fabric-wide
+    site-id        must DIFFER per site or the fabric collapses into one site
+
+  Before this the templates hardcoded `vbond 192.0.2.1` -- a TEST-NET address
+  with nothing behind it -- so every device booted healthy, was collected by
+  the collector, and dialled an address that does not exist. No control connection
+  could form. The templates said so ("overlay onboarding left as placeholder");
+  this makes the placeholder real.
+
+  THE VALIDATOR ADDRESS IS THE MANAGEMENT ADDRESS, deliberately. These day-0
+  day-0 once brought up VPN 512 / eth0 and nothing else, which made management
+  the only addressed interface when control connections were attempted. That is
+  no longer true: the initial templates configure the transport interface, so
+  the vbond target is the transport address and the fabric can actually reach
+  it.
+
+  An explicit sdwan.site_id or sdwan.system_ip in the topology always wins.
+  """
+  validators = role_nodes.get("validator", [])
+  vbond_addr = ""
+  for node in validators:
+    # TRANSPORT first. This is the address every controller and edge is told to
+    # find the validator on, so it has to be one they can reach on the fabric.
+    # Management cannot serve that role here: it is a render-time value from
+    # netlab's mgmt pool (172.20.20.x), while under KNE the real management
+    # address is assigned at deploy time -- so the fabric was being handed an
+    # address nothing answers on. Measured on a live vManage, whose
+    # settings/configuration/device read back domainIp 172.20.20.103 while the
+    # validator was actually reachable on its transport address.
+    vbond_addr = _node_transport_address(node) or _node_mgmt_address(node)
+    if vbond_addr:
+      break
+
+  if validators and not vbond_addr:
+    log.error(
+      "SD-WAN validator has no management address, so no node can be given a vbond target",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+  # A Viptela device that runs the module but has no validator to point at is
+  # not a lab with a missing feature, it is a lab that cannot boot: the day-0
+  # seed carries `vbond <addr>` unconditionally (see cisco_sdwan.cloudconfig.j2
+  # and the CLI templates -- the value was once a TEST-NET placeholder and the
+  # whole fabric dialled nothing). Say so here, by name, instead of letting the
+  # render die on "'dict object' has no attribute 'vbond_address'".
+  if not validators and topology.get("sdwan.vendor", "cisco") == "cisco":
+    needs_vbond = [
+      n.name for role in ("manager", "controller", "edge") for n in role_nodes.get(role, []) ]
+    if needs_vbond:
+      log.error(
+        f"SD-WAN nodes {', '.join(sorted(needs_vbond))} run the sdwan module but the topology "
+        "has no validator (vbond) node, so they have no vbond target to join",
+        category=log.MissingValue,
+        module="sdwan",
+      )
+
+  organization = str(topology.get("sdwan.organization", "") or "skyforge")
+
+  # The fabric trust anchor. Same scope argument as organization and vbond: it
+  # is a property of the FABRIC, identical on every node, and a node-scoped
+  # template cannot reach up to the topology to find it.
+  #
+  # STRIPPED, then re-terminated with exactly one newline. The PEM crosses three
+  # boundaries before a device sees it -- a topology value, a rendered day-0
+  # file, and a heredoc typed over a serial console -- and each one is happy to
+  # add or eat a trailing blank line. `request root-cert-chain install` fails on
+  # a malformed PEM with a message about the CHAIN rather than the file, so a
+  # stray newline reads as a trust problem. Normalise once, here.
+  # THE TRUST ANCHOR, read from the deployment's mounted CA rather than carried
+  # in the topology.
+  #
+  # An explicit sdwan.trust.root_ca_pem always wins -- tests and offline renders
+  # need a way to supply one -- but the normal path is the FILE the platform
+  # mounts onto the runner. That keeps the user's topology out of it: the CA is
+  # per-deployment material, and rewriting a submitted topology to carry it
+  # would make "which CA is this fabric using" a property of a bundle that has
+  # already been archived.
+  #
+  # Read at RENDER time, in the runner, where the mount exists. Absent is not an
+  # error here: a topology with no sdwan trust configured still has to render
+  # (that is how every non-SD-WAN lab and every unit test works). The lane
+  # refuses later, loudly, if it needs a CA and has none -- see sdwan.yml.
+  root_ca_pem = str(topology.get("sdwan.trust.root_ca_pem", "") or "").strip()
+  if not root_ca_pem:
+    ca_path = str(topology.get(
+      "sdwan.trust.ca_cert_path", "") or "/skyforge-secrets/sdwan-ca/ca.crt")
+    try:
+      with open(ca_path, "r") as fh:
+        root_ca_pem = fh.read().strip()
+    except OSError:
+      root_ca_pem = ""
+  if root_ca_pem:
+    root_ca_pem += "\n"
+
+  # THE DECLARED PASSWORD, resolved once for the whole fabric.
+  #
+  # This exists so the factory->declared transition can happen in DAY-0 rather
+  # than over the API, and the reason is a chicken-and-egg the API lane could
+  # not win: while the box still holds the factory password, every
+  # /dataservice/* answers 302 -> passwordReset.html on an otherwise valid
+  # session. No session-based module can perform the transition that unblocks
+  # its own session. The serial console has no such gate -- it is ALREADY being
+  # forced to set a password on first boot ("You must set an initial admin
+  # password"), so having the injector answer with the declared value removes
+  # the transition entirely instead of working around it.
+  #
+  # vManage additionally REFUSES to keep the factory value: "USER0002: Password
+  # for admin user cannot be configured to default/last password" (measured
+  # live). So admin/admin cannot survive there under any lane.
+  #
+  # ONE SOURCE, three consumers: the day-0 `aaa` stanza below, the injector's
+  # answer to the forced prompt (via kne.env), and the API lane's login.
+  # Drift between those three is what previously left a password that existed
+  # only in one operator's head.
+  api_password = str(topology.get("sdwan.api_password", "") or "")
+
+  for name, node in topology.nodes.items():
+    if "sdwan" not in node or not isinstance(node.sdwan, Box):
+      continue
+    if vbond_addr:
+      node.sdwan.vbond_address = vbond_addr
+    node.sdwan.organization = organization
+    # THE ROLE, AS A NODE FACT. A day-0 template renders with node scope and
+    # cannot call _fabric_role; a cat8000v is a plain IOS-XE router or a
+    # managed edge depending on this one value, and the template has to
+    # branch on it.
+    node.sdwan.fabric_role = _fabric_role(node)
+    # EVERY FABRIC MEMBER, edges included. The note that used to stand here
+    # said an edge gets its anchor from a vManage-generated bootstrap; the
+    # bootstrap is now rendered HERE (initial/cat8000v-kne.j2), so the edge
+    # needs the PEM in its day-0 like the controllers do -- it rides the
+    # cloud-config ca-certs section with rcc: true.
+    if root_ca_pem and node.sdwan.fabric_role in ("manager", "controller", "validator", "edge"):
+      node.sdwan.root_ca_pem = root_ca_pem
+    if node.sdwan.fabric_role == "edge":
+      _push_edge_identity(topology, node, organization)
+
+    # Topology-wide sdwan.api_password wins; otherwise the DEVICE's own declared
+    # credential, which is the containerlab default (admin) for every
+    # personality. A lab that needs a different value sets sdwan.api_password in
+    # its topology. Falling back to the device default keeps those existing
+    # declarations authoritative instead of overriding them with a fabric-wide
+    # value nobody asked for.
+    # NOT node.ansible_password -- it is not there. The credential is declared in
+    # the DEVICE definition's group_vars (netsim/devices/cisco_sdwan-*.yml) and
+    # is merged into Ansible group_vars, never onto the node, so reading it off
+    # the node silently yields "" and everything quietly falls back to admin.
+    # Reading it from the device definition is what keeps day-0 and the device
+    # declaration in agreement; a topology that overrides sdwan.api_password
+    # then moves BOTH together rather than drifting one against the other.
+    device = str(node.get("device", "") or "")
+    device_password = str(
+      topology.get(f"defaults.devices.{device}.group_vars.ansible_password", "") or ""
+    )
+    node.sdwan.declared_password = api_password or device_password or "admin"
+    # THE SAME VALUE AS A CRYPT HASH, for the cloud-init seed (the -kne day-0
+    # templates). Measured on 20.7.1: a plaintext <password> in a full ConfD
+    # init file is stored VERBATIM and every login is refused; the identical
+    # value as a $6$ hash logs straight in, and it is what Cisco's own day-0
+    # carries. Deterministic salt so a re-render is byte-stable. openssl rather
+    # than crypt(): Python 3.13 removed the crypt module, and openssl is a hard
+    # dependency of this runtime already (the fabric CA is signed with it).
+    node.sdwan.declared_password_hash = _crypt_sha512(
+      node.sdwan.declared_password, salt_seed=f"{organization}:{name}")
+    if node.get("sdwan.site_id", None) is None:
+      node.sdwan.site_id = 1
+    if node.get("sdwan.system_ip", None) is None:
+      node.sdwan.system_ip = f"10.255.255.{node.get('id', 1)}"
+
+    # THE VALIDATOR MUST KNOW IT IS THE VALIDATOR. Viptela marks it with
+    # `vbond <addr> local`; without the `local` keyword the node points at
+    # itself as a client and never answers as one, so every other device gets
+    # a reachable address that refuses the session.
+    node.sdwan.is_validator = _fabric_role(node) == "validator"
+    # THE WAY BACK -- AS SPECIFIC ROUTES, NEVER A DEFAULT.
+    #
+    # A controller on the DC VLAN answers an edge behind a site only if VPN 0
+    # has a route there. The obvious form, a default route, is WRONG here and
+    # cost demo-lab a fabric (run 86907): the vSmart's seed is forced to put
+    # eth0 -- the KNE MANAGEMENT interface, addressed by DHCP from KubeVirt's
+    # masquerade -- into VPN 0, because its init-path validator allows at most
+    # one interface per VPN. A static default in VPN 0 therefore competes with
+    # eth0's DHCP default IN THE SAME TABLE, and when it wins, every reply to
+    # a management connection leaves by the transport interface toward a
+    # gateway with no route back to the cluster. Measured: vsmart answered SSH
+    # on run 86401 and not on 86907 with identical config -- whichever default
+    # is installed last wins, so it is a race, which is worse than a break.
+    # vBond and vManage were unaffected because their eth0 sits in VPN 512.
+    #
+    # So the controllers get routes to exactly the prefixes they must answer:
+    # the edges' TRANSPORT subnets, via the same site exit the topology
+    # already declares. The edges keep their default route -- their management
+    # lives in VRF Mgmt-intf, a different table, which is why cdg-vedge01
+    # carries both and stays reachable.
+    if node.sdwan.fabric_role in ("manager", "controller", "validator"):
+      gw0 = _default_route_nexthop(node)
+      if gw0:
+        # A CONNECTED SUBNET NEEDS NO ROUTE, and giving it one is worse than
+        # redundant: it sends on-link traffic to a gateway. demo-lab's DC edge
+        # shares the controllers' own sdwan_ctrl VLAN, so its transport prefix
+        # is exactly the one to drop here.
+        connected = set()
+        for intf in node.get("interfaces", []) or []:
+          if not isinstance(intf, Box):
+            continue
+          addr = str(intf.get("ipv4", "") or "")
+          if addr and "/" in addr:
+            try:
+              connected.add(str(ipaddress.ip_interface(addr).network))
+            except ValueError:
+              pass
+        routes = [
+          {"prefix": prefix, "nexthop": gw0}
+          for prefix in _edge_transport_prefixes(role_nodes)
+          if prefix not in connected
+        ]
+        if routes:
+          node.sdwan.vpn0_routes = routes
+
+    # TRANSPORT INTERFACES. Control connections run over VPN 0 with a
+    # tunnel-interface -- NOT over the VPN 512 management interface these
+    # templates used to be limited to. A node with no transport interface can
+    # be perfectly configured and still never form a control connection,
+    # because it has no tunnel to form one on.
+    #
+    # An interface is transport if the topology says so (sdwan.role or the
+    # link's role), and colours default to "default" rather than being
+    # invented per-interface: two ends of one tunnel must agree on colour.
+    transport = []
+    for intf in node.get("interfaces", []) or []:
+      if not isinstance(intf, Box):
+        continue
+      role = str(intf.get("sdwan.role", "") or "")
+      if role != "transport":
+        continue
+      if not intf.get("ipv4", None):
+        continue
+      entry = {
+        "ifname": intf.get("ifname", ""),
+        "ipv4": str(intf.ipv4),
+        "color": str(intf.get("sdwan.color", "") or "default"),
+      }
+      # DIA: this transport interface is the edge's NAT-outside interface for
+      # its service VPN. Read straight off the interface (never inherited from
+      # the node), the same way role/color are -- one edge can have several
+      # transports and only one needs to be the exit.
+      if bool(intf.get("sdwan.nat", False)):
+        entry["nat"] = True
+      # Jumbo everywhere: the transport interface carries the SD-WAN tunnels, so
+      # it takes the fabric MTU too. netlab clamped the link; render the value.
+      if "mtu" in intf:
+        try:
+          entry["mtu"] = int(intf.mtu)
+        except (TypeError, ValueError):
+          pass
+      # THE WAY OUT OF THE SITE. An edge whose validator is not on-link (every
+      # demo-lab site: the controllers sit on the DC's sdwan_ctrl VLAN) needs a
+      # default route on its transport, and controller-mode day-0 carries no
+      # routing module. netlab's link `gateway` attribute is the only
+      # declaration that exists for that hop; when the link declares one, the
+      # edge's day-0 renders `ip route 0.0.0.0 0.0.0.0 <gw>`.
+      gw = _transport_gateway(topology, node, intf)
+      if gw:
+        entry["gateway"] = gw
+      transport.append(entry)
+    # MANAGEMENT INTERFACES (VPN 512). Onboarding needs these and the fabric
+    # does not, which is why they are collected separately.
+    #
+    # CORRECTED 2026-09-02, from vManage's own vshell on a live sdwan-min.
+    # The paragraph that stood here said Viptela serves SSH/NETCONF only in the
+    # MANAGEMENT VPN and that tcp/22 and tcp/830 stay closed on a transport
+    # interface both with and without a tunnel-interface. Both halves are
+    # false, and believing them is what left every controller without a WAN
+    # interface. Measured, from vManage, with the fabric in exactly the state
+    # this lane leaves it:
+    #
+    #   echo | nc 172.16.0.2 830  ->  SSH-2.0-OpenSSH_8.2   (vsmart transport)
+    #   echo | nc 172.16.0.2 22   ->  SSH-2.0-OpenSSH_8.2
+    #   echo | nc 172.16.0.3 830  ->  SSH-2.0-OpenSSH_8.2   (vbond transport,
+    #                                  which HAS carried a tunnel-interface with
+    #                                  allow-service all/netconf/sshd all along)
+    #   echo | nc 172.16.1.2 830  ->  (nothing, rc=124)     (vsmart MANAGEMENT)
+    #
+    # So transport carries onboarding and management carries nothing -- the
+    # opposite of the old note -- and allow-service does not lock onboarding
+    # out, which the validator had been disproving in every run.
+    #
+    # Management interfaces are still collected: a real controller has both,
+    # and the roster/day-0 want them. They are simply not the onboarding path.
+    #
+    # So a controller needs BOTH, exactly as a real one is deployed: an
+    # out-of-band management address to be onboarded on, and a transport
+    # address for the fabric to run on.
+    mgmt = []
+    for intf in node.get("interfaces", []) or []:
+      if not isinstance(intf, Box):
+        continue
+      if str(intf.get("sdwan.role", "") or "") != "management":
+        continue
+      if not intf.get("ipv4", None):
+        continue
+      mgmt.append({
+        "ifname": intf.get("ifname", ""),
+        "ipv4": str(intf.ipv4),
+      })
+    if mgmt:
+      node.sdwan.mgmt_interfaces = mgmt
+
+    if transport:
+      node.sdwan.transport_interfaces = transport
+    elif _fabric_role(node) in ("edge", "controller", "validator", "manager"):
+      log.error(
+        f"SD-WAN node {node.name} ({_fabric_role(node)}) has no transport interface; "
+        "control connections run over VPN 0 and cannot form without one. "
+        "Mark a link or interface with sdwan.role: transport.",
+        category=log.MissingValue,
+        module="sdwan",
+      )
+
+def _edge_declares_service(node: Box) -> bool:
+  """True when the topology asks for a service side on this edge.
+
+  Either the node names a default service VPN (sdwan.service_vpn) or a link
+  pins one (sdwan.vpn) or marks itself sdwan.role: service. Absent all three
+  the edge stays exactly what it is today -- VPN 0 and VPN 512 only -- and
+  nothing in its rendering changes.
+  """
+  if node.get("sdwan.service_vpn", None) is not None:
+    return True
+  for intf in node.get("interfaces", []) or []:
+    if not isinstance(intf, Box):
+      continue
+    if intf.get("sdwan.vpn", None) is not None:
+      return True
+    if str(intf.get("sdwan.role", "") or "") == "service":
+      return True
+  return False
+
+
+def _ipv4_parts(cidr: str) -> dict:
+  """address / netmask / wildcard / network for an IPv4 interface address.
+
+  Computed HERE rather than in the CLI template so the template stays pure
+  Jinja2 -- the same rule the manager intent template follows (no ansible
+  filters at netlab-create time, none needed at deploy time either).
+  """
+  iface = ipaddress.ip_interface(cidr)
+  net = iface.network
+  return {
+    "ipv4": str(iface),
+    "address": str(iface.ip),
+    "netmask": str(net.netmask),
+    "wildcard": str(net.hostmask),
+    "prefix": str(net),
+  }
+
+
+def _edge_service_intent(topology: Box, node: Box) -> typing.Optional[Box]:
+  """The service side of ONE edge, as the intent vManage will deliver.
+
+  WHAT THIS IS. A WAN edge that carries VPN 0 and VPN 512 alone is enrolled
+  and routes nothing: its site is unreachable over the overlay because no
+  service VRF exists to carry it. demo-lab's four edges sat in exactly that
+  state, admitted and proven, while Paris could not reach London (2026-09-07).
+  This derives, from what netlab already knows, everything the edge's service
+  VRF needs: which interfaces are in it (every addressed data interface that
+  is neither transport nor management -- the author names no interface), the
+  loopback, and the site's routing protocol from the edge's own netlab
+  modules, with the seam to OMP.
+
+  WHERE IT GOES. NOT into day-0. The CVAC bootstrap is untouched; this rides
+  the manager's onboarding intent (sdwan.onboarding.edges[].service) and is
+  delivered AFTER admission by tasks/cisco_sdwan-manager/sdwan_service_vpns.yml
+  as a vManage CLI template, the way the owner asked for it ("from the API,
+  not day 0").
+
+  THE SEAM RULE, read from the source lab (demo-lab.unl, 2026-09-07): a site
+  with BGP on the edge (LHR, iBGP 65023 behind two reflectors) redistributes
+  OMP into BGP and advertises BGP into OMP, and its OSPF stays intra-area with
+  no seam; a site with OSPF alone (CDG, JFK-DC) redistributes OMP into OSPF
+  and advertises `ospf external`; EIGRP (JFK) redistributes OMP and advertises
+  eigrp. Connected and static are always advertised. So: the site's EGP is the
+  seam when it has one, otherwise its IGP.
+
+  ONE SERVICE VPN PER EDGE, for now. netlab gives a router ONE loopback, and
+  the loopback is what the IGP router-id and the iBGP sessions hang off; two
+  VRFs would need two. A second VPN is a refusal here, not a silent half.
+  """
+  if not _edge_declares_service(node):
+    return None
+
+  default_vpn = node.get("sdwan.service_vpn", None)
+  interfaces = []
+  vpns = set()
+  for intf in node.get("interfaces", []) or []:
+    if not isinstance(intf, Box):
+      continue
+    role = str(intf.get("sdwan.role", "") or "")
+    if role in ("transport", "management"):
+      continue
+    vpn = intf.get("sdwan.vpn", None)
+    if vpn is None and (role == "service" or default_vpn is not None):
+      vpn = default_vpn
+    if vpn is None:
+      continue
+    addr = str(intf.get("ipv4", "") or "")
+    if not addr or "/" not in addr:
+      log.error(
+        f"SD-WAN edge {node.name}: interface {intf.get('ifname', '?')} is in service VPN {vpn} "
+        "but has no IPv4 address; a service interface must be addressed",
+        category=log.MissingValue,
+        module="sdwan",
+      )
+      continue
+    vpns.add(int(vpn))
+    entry = data.get_box(_ipv4_parts(addr))
+    entry.ifname = str(intf.get("ifname", "") or "")
+    entry.vpn = int(vpn)
+    # CARRY THE LINK MTU INTO THE SERVICE INTERFACE. netlab already clamped this
+    # interface to the fabric MTU (8950 on the jumbo fleet) -- the SAME value the
+    # ASA on the other end of an OSPF seam renders via l.mtu. The cat8000v day-0
+    # template emits no mtu, so without this the vEdge service interface sits at
+    # the 1500 default while its neighbour is at 8950. OSPF's DBD carries the
+    # Interface-MTU field and a router REJECTS a DBD whose MTU exceeds its own
+    # (RFC 2328 s10.6), so the adjacency wedges in EXSTART with "too many
+    # retransmissions" even though the link carries 1500-byte frames fine
+    # (measured on demo-lab 2026-09-08: ping 1500 df succeeded while OSPF never
+    # left EXSTART). Emit the matching mtu so both ends agree and the seam forms.
+    if "mtu" in intf:
+      try:
+        entry.mtu = int(intf.mtu)
+      except (TypeError, ValueError):
+        pass
+    entry.neighbors = [
+      str(n.get("node", "") or "") for n in (intf.get("neighbors", []) or []) if isinstance(n, Box)
+    ]
+    if "ospf" in intf and isinstance(intf.ospf, Box):
+      entry.ospf = {
+        "area": str(intf.ospf.get("area", "0.0.0.0")),
+        "network_type": str(intf.ospf.get("network_type", "") or ""),
+        "passive": bool(intf.ospf.get("passive", False)),
+      }
+    if "eigrp" in intf and isinstance(intf.eigrp, Box):
+      entry.eigrp = {"passive": bool(intf.eigrp.get("passive", False))}
+    interfaces.append(entry)
+
+  if not interfaces:
+    log.error(
+      f"SD-WAN edge {node.name} declares a service VPN but has no addressed data interface to put in it "
+      "(every non-transport, non-management interface is a service interface)",
+      category=log.MissingValue,
+      module="sdwan",
+    )
+    return None
+  if len(vpns) > 1:
+    log.error(
+      f"SD-WAN edge {node.name} names more than one service VPN ({sorted(vpns)}); "
+      "one service VPN per edge is what this lane renders (one loopback, one router-id)",
+      category=log.IncorrectValue,
+      module="sdwan",
+    )
+    return None
+
+  vpn = vpns.pop()
+  service = data.get_box({"vpn": vpn, "interfaces": interfaces})
+
+  # DIA: true when ANY of this edge's transport interfaces declared
+  # sdwan.nat. Read from sdwan.transport_interfaces (built by
+  # _push_overlay_facts, which always runs before this) rather than
+  # re-scanning node.interfaces, so this agrees exactly with what day-0
+  # rendered onto the transport side -- one flag, one source of truth.
+  service.nat = any(
+    bool(t.get("nat", False)) for t in (node.get("sdwan.transport_interfaces", []) or [])
+  )
+
+  loopback = node.get("loopback", None)
+  lo_addr = str(loopback.get("ipv4", "") or "") if isinstance(loopback, Box) else ""
+  if lo_addr and "/" in lo_addr:
+    service.loopback = data.get_box(_ipv4_parts(lo_addr))
+    service.loopback.ifname = str(loopback.get("ifname", "") or "Loopback0")
+    if "ospf" in loopback and isinstance(loopback.ospf, Box):
+      service.loopback.ospf = {"area": str(loopback.ospf.get("area", "0.0.0.0"))}
+    # The loopback joins EIGRP on the same terms as netlab's own IOS template
+    # (templates/eigrp/ios.j2: `network` for every interface, loopback
+    # included, that CARRIES an eigrp key). An interface where the eigrp
+    # module was switched off has no key and gets no network statement.
+    if "eigrp" in loopback and isinstance(loopback.eigrp, Box):
+      service.loopback.eigrp = {"passive": bool(loopback.eigrp.get("passive", False))}
+  router_id = service.get("loopback.address", "") or interfaces[0].address
+
+  modules = node.get("module", []) or []
+  has_bgp = "bgp" in modules and node.get("bgp.as", None) is not None
+  has_ospf = "ospf" in modules and any("ospf" in i for i in interfaces)
+  has_eigrp = "eigrp" in modules and node.get("eigrp.as", None) is not None
+
+  # The seam: the site's EGP if it has one, otherwise its IGP.
+  seam = "bgp" if has_bgp else ("ospf" if has_ospf else ("eigrp" if has_eigrp else ""))
+  advertise = ["connected", "static"]
+
+  if has_ospf:
+    service.ospf = data.get_box({
+      "process": vpn,
+      "router_id": str(node.get("ospf.router_id", "") or router_id),
+      "redistribute_omp": seam == "ospf",
+    })
+    if seam == "ospf":
+      advertise.append("ospf external")
+
+  if has_bgp:
+    service_ifnames = {i.ifname for i in interfaces}
+    neighbors = []
+    for ngb in node.get("bgp.neighbors", []) or []:
+      if not isinstance(ngb, Box) or not ngb.get("ipv4", None) or not isinstance(ngb.ipv4, str):
+        continue
+      ntype = str(ngb.get("type", "") or "")
+      # An EBGP neighbour lives on a link; only a SERVICE link belongs in the
+      # VRF. IBGP neighbours ride the loopbacks and always do.
+      if ntype != "ibgp":
+        ifname = str(ngb.get("ifname", "") or "")
+        if ifname and ifname not in service_ifnames:
+          continue
+      neighbors.append({
+        "name": str(ngb.get("name", "") or ""),
+        "ipv4": str(ngb.ipv4),
+        "as": ngb.get("as", None),
+        "type": ntype,
+        "rr": bool(ngb.get("rr", False)),
+        "update_source": service.get("loopback.ifname", "") if ntype == "ibgp" else "",
+      })
+    service.bgp = data.get_box({
+      "as": node.bgp["as"],
+      "router_id": str(node.get("bgp.router_id", "") or router_id),
+      "neighbors": neighbors,
+      # netlab marks the loopback it wants in BGP as loopback.bgp.advertise
+      # (bgp.advertise_loopback is the node-level default it derives from).
+      "advertise_loopback": "loopback" in service and bool(
+        loopback.get("bgp.advertise", node.get("bgp.advertise_loopback", True)) if isinstance(loopback, Box) else False
+      ),
+      "redistribute_omp": seam == "bgp",
+    })
+    if seam == "bgp":
+      advertise.append("bgp")
+
+  if has_eigrp:
+    service.eigrp = data.get_box({
+      "as": int(node.eigrp["as"]),
+      "router_id": str(node.get("eigrp.router_id", "") or router_id),
+      "redistribute_omp": seam == "eigrp",
+      # EIGRP takes no external route without a composite metric; these are
+      # the numbers Cisco's own OMP-into-EIGRP example uses.
+      "metric": "1000000 100 255 1 1500",
+    })
+    if seam == "eigrp":
+      advertise.append("eigrp")
+
+  service.omp = data.get_box({
+    "advertise": advertise,
+    # The prefixes this edge itself ORIGINATES into OMP once the VRF is up:
+    # its service links and its loopback, all `advertise connected`. What the
+    # site advertises through the IGP/EGP on top of these is reported by the
+    # read-back but does not gate it -- it depends on the site, not the edge.
+    "expect_prefixes": sorted({i.prefix for i in interfaces} | ({service.loopback.prefix} if "loopback" in service else set())),
+  })
+
+  # THE BLOCKS THIS INTENT OWNS in the device's configuration, as paths of
+  # block headers. The delivery stage strips exactly these from the running
+  # configuration vManage holds before grafting the rendered overlay, so a
+  # re-run is a no-op and a changed intent replaces rather than stacks; the
+  # read-back proves exactly these landed.
+  owned = [[f"vrf definition {vpn}"]]
+  owned += [[f"interface {i.ifname}"] for i in interfaces]
+  if "loopback" in service:
+    owned.append([f"interface {service.loopback.ifname}"])
+  if has_ospf:
+    owned.append([f"router ospf {vpn} vrf {vpn}"])
+  if has_bgp:
+    owned.append([f"router bgp {node.bgp['as']}"])
+  if has_eigrp:
+    owned.append(["router eigrp sdwan"])
+  owned.append(["sdwan", "omp", f"address-family ipv4 vrf {vpn}"])
+  if service.nat:
+    # A standalone top-level command, not a block -- but the tree in
+    # sdwan_service_vpn.py has no trouble owning a leaf node by its exact
+    # header text, and it must be listed here for the SAME reason every
+    # other line here is: strip-before-graft is what makes a re-render
+    # replace instead of stack, and the read-back proves this landed.
+    owned.append([f"ip nat route vrf {vpn} 0.0.0.0 0.0.0.0 global"])
+  service.owned_blocks = owned
+  return service
+
+
+def _push_onboarding_facts(topology: Box, role_nodes: dict) -> None:
+  """Give the manager the fabric roster its REST onboarding lane will enroll.
+
+  Same scope rule as _push_overlay_facts: a template renders with NODE scope,
+  so the manager cannot look up the validator's address or enumerate the
+  controllers by itself. Onboarding needs exactly that -- which boxes exist,
+  what personality each one is, and how to reach it.
+
+  This is INTENT, not configuration. It says "these devices belong to this
+  fabric"; vManage decides what that means on each device. Nothing here is
+  pushed to a device by netlab.
+
+  The manager deliberately does NOT enroll itself: it is the box being talked
+  to, and POSTing it to its own device list is how the earlier probe run got a
+  self-referential entry that never came up.
+  """
+  managers = role_nodes.get("manager", [])
+  if not managers:
+    return
+
+  # Controllers to enroll, in the order vManage wants them: the validator must
+  # exist before a controller can be attached to the fabric.
+  roster = []
+  for role in ("validator", "controller"):
+    for node in role_nodes.get(role, []):
+      address = _node_mgmt_address(node)
+      if not address:
+        log.error(
+          f"SD-WAN {role} {node.name} has no management address, so vManage cannot enroll it",
+          category=log.MissingValue,
+          module="sdwan",
+        )
+        continue
+      # ENROLLMENT ADDRESS: transport first, management as the fallback.
+      # vManage logs into the target to enroll it, and the vBond (vEdge
+      # Enrollment names the TRANSPORT address, because that is where the
+      # device actually answers.
+      #
+      # Measured, after two wrong turns: VPN 512 is a separate NETWORK
+      # NAMESPACE on these images (ip netns: 512 / default / 65531), and sshd
+      # listens on 0.0.0.0:22 and :830 in the DEFAULT namespace only. A
+      # management address therefore cannot reach sshd no matter how it is
+      # addressed -- ICMP answers, TCP never will.
+      #
+      # The transport interface lives in the default namespace beside sshd. A
+      # banner grab from vManage to the vSmart's transport address returns
+      # SSH-2.0-OpenSSH_8.2 on both ports. Note that vManage's own
+      # /device/tools/nping reported those same ports "closed"; that tool
+      # disagrees with a direct connection and should not be trusted for this
+      # question -- two revisions were built on believing it.
+      mgmt = node.get("sdwan.mgmt_interfaces", []) or []
+      transport = node.get("sdwan.transport_interfaces", []) or []
+      enroll_addr = address.split("/")[0]
+      if mgmt and mgmt[0].get("ipv4"):
+        enroll_addr = str(mgmt[0]["ipv4"]).split("/")[0]
+      if transport and transport[0].get("ipv4"):
+        enroll_addr = str(transport[0]["ipv4"]).split("/")[0]
+      roster.append({
+        "name": node.name,
+        "address": enroll_addr,
+        # vManage's own vocabulary, not netlab's role name. These are the
+        # values POST /dataservice/system/device accepts.
+        "personality": "vbond" if role == "validator" else "vsmart",
+        "system_ip": str(node.get("sdwan.system_ip", "") or ""),
+        "site_id": node.get("sdwan.site_id", 1),
+        # THE TARGET'S credential, not the manager's. vManage uses this pair
+        # to log into the controller being enrolled; passing the manager's
+        # API credential here is what returned HTTP 400 on a vsmart that
+        # still (correctly) holds its own declared admin/admin.
+        #
+        # READ FROM THE SAME PLACE DAY-0 DOES. node.ansible_password IS NOT
+        # THERE -- the credential is declared in the DEVICE definition's
+        # group_vars and merged into Ansible group_vars, never onto the node --
+        # so this used to resolve to "admin" by accident. That is the right
+        # answer today, and silently the wrong one the moment a topology
+        # declares sdwan.api_password: day-0 would set the declared value while
+        # this roster still told vManage to log in with admin, and the
+        # enrolment failure would name the network, not the credential.
+        # declared_password is what _push_overlay_facts already resolved.
+        "username": str(node.get("ansible_user", "") or "admin"),
+        "password": str(
+          node.get("sdwan.declared_password", "")
+          or node.get("ansible_password", "")
+          or "admin"
+        ),
+      })
+
+  # Edges are AUTHORISED, not enrolled. vManage never logs into a WAN edge to
+  # add it the way it does a controller: the edge dials the validator itself,
+  # presenting the chassis/token pair its day-0 carries, and the fabric admits
+  # it iff the manager's vEdge list holds that pair. The lane therefore hands
+  # vManage the pair (`request vedge add`), marks it valid, pushes the list,
+  # and then READS BACK the validator's/controller's control connections to
+  # say whether the edge actually came up -- PROVEN or NOT_PROVEN, per edge.
+  #
+  # Neither list lane admits a virtual platform ("Virtual Platform is not
+  # allowed in CSV Upload"; .viptela needs a Cisco signature), which is why the
+  # pair goes in over the CLI. The identity itself is minted by
+  # _push_edge_identity and is the SAME pair the day-0 template renders.
+  edges = []
+  for node in role_nodes.get("edge", []):
+    edges.append({
+      "name": node.name,
+      "address": _node_mgmt_address(node).split("/")[0],
+      "transport_address": _node_transport_address(node),
+      # The subnet a controller must have a route to before this edge's DTLS
+      # reply can come back. The lane checks for it rather than waiting out a
+      # silent handshake failure (netlab 0050).
+      "transport_prefix": next(iter(_edge_transport_prefixes({"edge": [node]})), ""),
+      "system_ip": str(node.get("sdwan.system_ip", "") or ""),
+      "site_id": node.get("sdwan.site_id", 1),
+      "chassis": str(node.get("sdwan.chassis", "") or ""),
+      "token": str(node.get("sdwan.token", "") or ""),
+    })
+    # THE SERVICE SIDE, day-1, delivered by vManage after admission. Absent
+    # when the topology does not ask, so a roster for a topology without it is
+    # byte-identical to before.
+    service = _edge_service_intent(topology, node)
+    if service is not None:
+      node.sdwan.service = service
+      edges[-1]["service"] = service
+
+  for node in managers:
+    node.sdwan.onboarding = {
+      "organization": str(node.get("sdwan.organization", "") or "skyforge"),
+      # STRIP THE PREFIX. sdwan.vbond_address comes from _node_mgmt_address,
+      # which returns mgmt.ipv4 verbatim -- and that may carry a /NN. The API
+      # wants a bare address; the day-0 templates already split on "/" for the
+      # same reason, which is the tell that a prefix is possible here.
+      "vbond_address": str(node.get("sdwan.vbond_address", "") or "").split("/")[0],
+      "controllers": roster,
+      "edges": edges,
+    }
+
+
+class SDWAN(_Module):
+  def module_normalize(self, topology: Box) -> None:
+    _expand_system(topology)
+    log.exit_on_error()
+
+  def node_post_transform(self, node: Box, topology: Box) -> None:
+    # The sdwan module renders no per-device CONFIG. Day-0 identity lives in the
+    # initial/ templates and the overlay belongs to vManage -- pushing overlay
+    # state onto a device by hand is what this module exists to avoid.
+    #
+    # The MANAGER is the one exception, and it is not an exception to that rule:
+    # its sdwan lane drives vManage's own REST API (see
+    # tasks/cisco_sdwan-manager/sdwan.yml), so the controller still owns the
+    # overlay -- netlab just tells it what the fabric is. Skipping config on the
+    # manager too would leave netlab able to describe a fabric it can never
+    # bring up, which is the state this module sat in until 2026-08-31.
+    if _fabric_role(node) != "manager":
+      data.append_to_list(node, "skip_config", "sdwan")
+    # AN EDGE'S SERVICE-SIDE ROUTING NEVER LANDS IN ITS STARTUP-CONFIG. The
+    # ospf/bgp/eigrp modules are on the edge so netlab computes the site's
+    # areas, neighbours and router-ids; their IOS templates would otherwise be
+    # concatenated onto the CVAC bootstrap by the KNE provider (after the
+    # closing MIME boundary, where the device ignores them -- but the day-0
+    # artefact is frozen and must not change by a byte). They are rendered
+    # into the service VRF of the vManage CLI template instead.
+    if _fabric_role(node) == "edge" and _edge_declares_service(node):
+      for m in SERVICE_ROUTING_MODULES:
+        if m in (node.get("module", []) or []):
+          data.append_to_list(node, "skip_config", m)
+    if "sdwan" not in node:
+      node.sdwan = data.get_empty_box()
+
+    if node.sdwan is True:
+      node.sdwan = data.get_empty_box()
+    if not isinstance(node.sdwan, Box):
+      node.pop("sdwan", None)
+      return
+
+    node_type = _node_type(node)
+    if node_type:
+      node.sdwan.type = node_type
+    _check_type_support(node, topology, node_type)
+    _check_vendor_support(node, topology, node_type)
+
+  def module_cleanup(self, topology: Box) -> None:
+    role_nodes = _find_role_nodes(topology)
+    topology.sdwan = topology.get("sdwan", data.get_empty_box())
+    topology.sdwan.inventory = _build_inventory(topology)
+    _push_overlay_facts(topology, role_nodes)
+    _push_onboarding_facts(topology, role_nodes)
+    _check_cisco_fabric(topology, role_nodes)
+    _check_versa_fabric(topology, role_nodes)
+    log.exit_on_error()
