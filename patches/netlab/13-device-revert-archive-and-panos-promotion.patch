+def build_queue(lines: list, op_mode: bool, do_commit: bool) -> list:
+  """The CLI session, one entry per prompt. Pure, so the sequence is testable without a device."""
+  # scripting-mode keeps the CLI from echoing interactive furniture; pager off keeps long output from wedging the
+  # prompt detector.
+  queue = ['set cli scripting-mode on', 'set cli pager off']
+  if not op_mode:
+    queue.append('configure')
+  queue += lines
+  if do_commit:
+    queue.append('commit')
+  if not op_mode:
+    queue.append('exit')
+  queue.append('exit')
+  return queue
+
