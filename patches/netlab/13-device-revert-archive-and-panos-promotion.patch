diff --git a/tests/test_panos_promotion_log.py b/tests/test_panos_promotion_log.py
new file mode 100644
index 0000000..07e3b1d
--- /dev/null
+++ b/tests/test_panos_promotion_log.py
@@ -0,0 +1,192 @@
+"""PAN-OS password promotion: the per-attempt log (SKYFORGE-SPECIFIC instrumentation).
+
+The requirement: after a boot, the attempt log must say WHEN the guest started answering, per attempt and per phase
+(the already-promoted probe and the promotion each have their own budget), without ever changing what the module does
+and without ever carrying a password. The subject is driven through its real pty/ssh transport; only the `ssh`
+program is replaced (the module exposes ssh_argv as the single source of the command) by a scripted endpoint.
+"""
+
+import importlib.util
+import re
+import sys
+import textwrap
+from pathlib import Path
+
+import pytest
+
+LIB = Path(__file__).parent.parent / "netsim" / "ansible" / "library" / "panos_admpwd_kne.py"
+
+NEW = "Admin@123"
+OLD = "admin"
+
+FAKE_SSH = textwrap.dedent(
+    r'''
+    import sys, time
+    mode = sys.argv[1]
+    def say(text):
+        sys.stdout.write(text); sys.stdout.flush()
+    if mode == "silent":
+        time.sleep(30)
+    elif mode == "promoted":
+        time.sleep(0.3)
+        say("Warning: Permanently added\nadmin@10.0.0.1's password: ")
+        sys.stdin.readline()
+        say("\nadmin@PA-VM> ")
+        sys.stdin.readline()
+    elif mode == "factory":
+        # ready device that still wants the factory credential: first the probe (new password) is answered with the
+        # forced-change dialog, then the promotion walks it.
+        say("admin@10.0.0.1's password: ")
+        sys.stdin.readline()
+        say("\nEnter old password : ")
+        sys.stdin.readline()
+        say("\nEnter new password : ")
+        sys.stdin.readline()
+        say("\nConfirm password   : ")
+        sys.stdin.readline()
+        say("\nPassword changed\nadmin@PA-VM> ")
+        time.sleep(1)
+    '''
+)
+
+
+@pytest.fixture()
+def lib(tmp_path):
+    spec = importlib.util.spec_from_file_location("panos_admpwd_kne_under_test", LIB)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    script = tmp_path / "fake_ssh.py"
+    script.write_text(FAKE_SSH)
+    mod._fake_script = str(script)
+    return mod
+
+
+class FailJson(Exception):
+    def __init__(self, kwargs):
+        super().__init__(kwargs.get("msg"))
+        self.kwargs = kwargs
+
+
+class FakeModule:
+    def __init__(self, tmp_path, timeout=20):
+        self.params = {
+            "host": "10.0.0.1", "port": 22, "username": "admin", "old_password": OLD, "new_password": NEW,
+            "key_filename": None, "timeout": timeout, "attempt_log": str(tmp_path / "promotion.log"),
+        }
+
+    def fail_json(self, **kwargs):
+        raise FailJson(kwargs)
+
+
+def point_at(lib, monkeypatch, mode):
+    monkeypatch.setattr(lib, "ssh_argv", lambda module: [sys.executable, "-u", lib._fake_script, mode])
+
+
+def lines_of(path):
+    return Path(path).read_text().splitlines()
+
+
+def field(line, key):
+    match = re.search(rf" {key}=(\S+)", line)
+    assert match, f"{key} missing from {line!r}"
+    return match.group(1)
+
+
+def test_probe_logs_start_end_elapsed_first_output_and_why(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "promoted")
+    module = FakeModule(tmp_path)
+    log = lib.AttemptLog(lib.attempt_log_path(module))
+    promoted, _ = lib.already_promoted(module, log)
+    assert promoted is True
+    start, end = lines_of(module.params["attempt_log"])
+    assert " phase=probe event=start" in start and field(start, "attempt") == "1"
+    assert " phase=probe event=end" in end
+    assert field(end, "already_promoted") == "True" and field(end, "why") == "cli-prompt"
+    assert float(field(end, "first_output_s")) >= 0.3, "time to first byte is what says the guest answered"
+    assert float(field(end, "elapsed_s")) >= float(field(end, "first_output_s"))
+    # RFC3339-ish UTC stamp with milliseconds leads every line
+    assert re.match(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z promotion ", start)
+
+
+def test_silent_endpoint_is_logged_as_no_output_and_deadline(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "silent")
+    module = FakeModule(tmp_path, timeout=2)
+    log = lib.AttemptLog(lib.attempt_log_path(module))
+    promoted, _ = lib.already_promoted(module, log)
+    assert promoted is False
+    end = lines_of(module.params["attempt_log"])[-1]
+    assert field(end, "why") == "deadline" and field(end, "first_output_s") == "none"
+    assert float(field(end, "elapsed_s")) >= 2.0
+
+
+def test_attempts_are_numbered_across_calls_and_the_clock_runs_from_the_first(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "promoted")
+    module = FakeModule(tmp_path)
+    for _ in range(3):
+        log = lib.AttemptLog(lib.attempt_log_path(module))
+        lib.already_promoted(module, log)
+    starts = [l for l in lines_of(module.params["attempt_log"]) if "event=start" in l]
+    assert [field(l, "attempt") for l in starts] == ["1", "2", "3"]
+    since = [float(field(l, "since_first_s")) for l in starts]
+    assert since[0] == 0.0 and since == sorted(since) and since[2] > 0
+
+
+def test_factory_device_logs_probe_refusal_then_a_successful_promotion(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "factory")
+    module = FakeModule(tmp_path)
+    log = lib.AttemptLog(lib.attempt_log_path(module))
+    promoted, _ = lib.already_promoted(module, log)
+    assert promoted is False
+    changed, _ = lib.promote_password(module, log)
+    assert changed is True
+    text = "\n".join(lines_of(module.params["attempt_log"]))
+    assert "phase=probe event=end" in text and "why=factory-password-prompt" in text
+    promote_end = [l for l in lines_of(module.params["attempt_log"]) if "phase=promote event=end" in l][0]
+    assert field(promote_end, "changed") == "True" and field(promote_end, "saw_old_prompt") == "True"
+    assert field(promote_end, "saw_confirm_prompt") == "True"
+
+
+def test_a_failed_promotion_carries_the_attempt_log_in_the_failure(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "silent")
+    module = FakeModule(tmp_path, timeout=2)
+    log = lib.AttemptLog(lib.attempt_log_path(module))
+    lib.already_promoted(module, log)
+    with pytest.raises(FailJson) as failure:
+        lib.promote_password(module, log)
+    carried = failure.value.kwargs["attempt_log"]
+    assert "phase=probe event=end" in carried and "phase=promote event=end" in carried
+    assert "changed=False" in carried
+
+
+def test_no_password_ever_reaches_the_log(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "factory")
+    module = FakeModule(tmp_path)
+    log = lib.AttemptLog(lib.attempt_log_path(module))
+    lib.already_promoted(module, log)
+    lib.promote_password(module, log)
+    blob = Path(module.params["attempt_log"]).read_text() + log.text()
+    assert NEW not in blob and "Enter old password" not in blob
+
+
+def test_an_unwritable_log_never_fails_the_promotion(lib, monkeypatch, tmp_path):
+    point_at(lib, monkeypatch, "promoted")
+    module = FakeModule(tmp_path)
+    module.params["attempt_log"] = str(tmp_path / "no-such-dir" / "x.log")
+    log = lib.AttemptLog(lib.attempt_log_path(module))
+    promoted, _ = lib.already_promoted(module, log)
+    assert promoted is True and log.text(), "the in-memory copy still serves the result"
+
+
+def test_default_log_path_is_per_endpoint(lib, tmp_path):
+    module = FakeModule(tmp_path)
+    module.params["attempt_log"] = None
+    assert lib.attempt_log_path(module) == "/tmp/skyforge-panos-promotion-10.0.0.1-22.log"
+
+
+def test_initial_yml_resets_passes_and_reports_the_log():
+    text = (Path(__file__).parent.parent / "netsim" / "ansible" / "tasks" / "panos" / "initial.yml").read_text()
+    assert "Reset the PAN-OS promotion attempt log" in text
+    assert text.index("Reset the PAN-OS promotion attempt log") < text.index("Wait for the PAN-OS SSH endpoint")
+    promo = text.index("Promote the PAN-OS admin password")
+    assert "attempt_log:" in text[promo : promo + 3500]
+    assert text.index("Report the PAN-OS promotion attempts") > promo
diff --git a/tests/test_panos_single_commit.py b/tests/test_panos_single_commit.py
new file mode 100644
index 0000000..3405c1a
--- /dev/null
+++ b/tests/test_panos_single_commit.py
@@ -0,0 +1,261 @@
+"""PAN-OS single-commit mode (SKYFORGE-SPECIFIC): SKYFORGE_PANOS_SINGLE_COMMIT.
+
+The requirement. The PAN-OS lanes (initial, static routes, services, firewall.policy) used to commit four times.
+With the switch on there must be EXACTLY ONE commit, it must come after every lane's lines, and it must cover
+the lanes that really staged something; with the switch off (the default) the sequence must be today's, commit for
+commit. The subject is the REAL task files run by the real ansible-playbook; only the three modules that would
+talk to a device are replaced by recorders (the CLI module, and the two XML-API modules of the static-route lane).
+"""
+
+import json
+import os
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+
+import pytest
+import yaml
+
+ANSIBLE = Path(__file__).parent.parent / "netsim" / "ansible"
+TASKS = ANSIBLE / "tasks"
+
+CLI_STUB = textwrap.dedent(
+    '''
+    import json, os
+    from ansible.module_utils.basic import AnsibleModule
+
+    def main():
+        m = AnsibleModule(argument_spec=dict(
+            host=dict(type="str"), port=dict(type="int"), username=dict(type="str"),
+            password=dict(type="str", no_log=True), lines=dict(type="list", elements="str", default=[]),
+            commit=dict(type="bool", default=True), commit_only=dict(type="bool", default=False),
+            mode=dict(type="str", default="configure"), timeout=dict(type="int", default=300)))
+        p = m.params
+        with open(os.environ["RECORD"], "a") as fh:
+            fh.write(json.dumps({"kind": "cli", "first": (p["lines"] or [""])[0], "n": len(p["lines"] or []),
+                                 "commit": p["commit"], "commit_only": p["commit_only"]}) + "\\n")
+        if p["commit_only"] and p["commit"] and os.environ.get("STUB_FAIL_COMMIT"):
+            m.fail_json(msg="PAN-OS commit failed on the device", transcript="Validation Error: zone inside has no interface")
+        m.exit_json(changed=True)
+
+    main()
+    '''
+)
+
+API_STUB = textwrap.dedent(
+    '''
+    import json, os
+    from ansible.module_utils.basic import AnsibleModule
+
+    def main():
+        m = AnsibleModule(argument_spec=dict(
+            provider=dict(type="raw", no_log=True), virtual_router=dict(type="raw"), name=dict(type="raw"),
+            destination=dict(type="raw"), interface=dict(type="raw"), nexthop=dict(type="raw"),
+            nexthop_type=dict(type="raw")))
+        with open(os.environ["RECORD"], "a") as fh:
+            fh.write(json.dumps({"kind": "KIND", "name": m.params.get("name")}) + "\\n")
+        m.exit_json(changed=True)
+
+    main()
+    '''
+)
+
+
+def named(tasks, needle):
+    for task in tasks:
+        if needle in str(task.get("name", "")):
+            return task
+    raise AssertionError(f"no task named like {needle!r}")
+
+
+def build_workdir(tmp_path):
+    (tmp_path / "library").write_text("") if False else (tmp_path / "library").mkdir()
+    (tmp_path / "library" / "panos_cli_config_kne.py").write_text(CLI_STUB)
+    coll = tmp_path / "collections" / "ansible_collections" / "paloaltonetworks" / "panos" / "plugins" / "modules"
+    coll.mkdir(parents=True)
+    (coll.parent.parent / "meta").mkdir()
+    (coll.parent.parent / "meta" / "runtime.yml").write_text("requires_ansible: '>=2.9'\n")
+    (coll / "panos_static_route.py").write_text(API_STUB.replace("KIND", "api-route"))
+    (coll / "panos_commit_firewall.py").write_text(API_STUB.replace("KIND", "api-commit"))
+    (tmp_path / "tasks").symlink_to(TASKS)
+    tpl = tmp_path / "templates"
+    tpl.mkdir()
+    (tpl / "initial.j2").write_text("set deviceconfig system hostname pa-fw\nset zone \"inside\" network layer3 ethernet1/1\n")
+    (tpl / "services.j2").write_text("set deviceconfig system service disable-snmp no\n")
+    (tpl / "policy.j2").write_text('set rulebase security rules "ALLOW" action allow\n')
+    (tpl / "empty.j2").write_text("\n")
+
+    initial_tasks = yaml.safe_load((TASKS / "panos" / "initial.yml").read_text())
+    initial_play = yaml.safe_load((ANSIBLE / "initial-config.ansible").read_text())
+    decide = named(initial_play[0]["tasks"], "Decide whether PAN-OS commits once")
+    final_play = named(initial_play, "Commit staged PAN-OS configuration")
+
+    def lane(template, action):
+        return {
+            "name": f"deploy {action}",
+            "include_tasks": "tasks/deploy-config/panos.yml",
+            "args": {"apply": {"vars": {"config_template": str(tpl / template), "netsim_action": action}}},
+        }
+
+    play1 = {
+        "name": "pa-fw lanes in the order netlab runs them",
+        "hosts": "pa_fw",
+        "gather_facts": False,
+        "vars": {"config_template": str(tpl / "initial.j2")},
+        "tasks": [
+            decide,
+            named(initial_tasks, "Render the PAN-OS initial configuration"),
+            named(initial_tasks, "Apply and commit the PAN-OS initial configuration"),
+            named(initial_tasks, "initial configuration is staged"),
+            {"name": "routing lane", "include_tasks": "tasks/panos/routing.yml"},
+            lane("services.j2", "services"),
+            lane("policy.j2", "firewall.policy"),
+            lane("empty.j2", "firewall.zonebased"),
+        ],
+    }
+    final = dict(final_play)
+    final["hosts"] = "pa_fw"
+    (tmp_path / "play.yml").write_text(yaml.safe_dump([play1, final]))
+    (tmp_path / "hosts").write_text("[pa_fw]\npa-fw ansible_connection=local\n")
+    (tmp_path / "group_vars").mkdir()
+    # inventory variables, as netlab's group_vars/host_vars provide them: visible to EVERY play of the playbook
+    (tmp_path / "group_vars" / "pa_fw.yml").write_text(yaml.safe_dump({
+        "ansible_host": "127.0.0.1", "panos_kne_ssh_port": 22, "ansible_user": "admin", "ansible_password": "x",
+        "netlab_device_type": "panos", "panos_provider": {"ip_address": "127.0.0.1"},
+        "panos_virtual_router": "default",
+        "routing": {"static": [{"ipv4": "10.10.101.0/24", "nexthop": {"ipv4": "10.252.2.1", "intf": "ethernet1/1"}}]},
+    }))
+    return tmp_path
+
+
+def run(tmp_path, single_commit, fail_commit=False):
+    import shutil
+    if shutil.which("ansible-playbook") is None:
+        pytest.skip("ansible-playbook is not installed: the single-commit command sequence was NOT exercised here")
+    work = build_workdir(tmp_path)
+    record = work / "record.jsonl"
+    env = dict(os.environ)
+    env.update(
+        RECORD=str(record),
+        ANSIBLE_LIBRARY=str(work / "library"),
+        ANSIBLE_COLLECTIONS_PATH=str(work / "collections"),
+        ANSIBLE_HOME=str(work / "ansible_home"),
+        ANSIBLE_LOCAL_TEMP=str(work / "tmp"),
+        ANSIBLE_NOCOLOR="1",
+    )
+    env.pop("SKYFORGE_PANOS_SINGLE_COMMIT", None)
+    env.pop("STUB_FAIL_COMMIT", None)
+    if single_commit is not None:
+        env["SKYFORGE_PANOS_SINGLE_COMMIT"] = single_commit
+    if fail_commit:
+        env["STUB_FAIL_COMMIT"] = "1"
+    proc = subprocess.run(
+        [sys.executable, "-m", "ansible", "playbook", "-i", str(work / "hosts"), str(work / "play.yml")]
+        if False else ["ansible-playbook", "-i", str(work / "hosts"), str(work / "play.yml")],
+        cwd=work, env=env, capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL,
+    )
+    records = [json.loads(l) for l in record.read_text().splitlines()] if record.exists() else []
+    return proc, records
+
+
+def commits(records):
+    """Every commit the device would see: a CLI call with commit=true, or the API commit."""
+    return [r for r in records if (r["kind"] == "cli" and r["commit"]) or r["kind"] == "api-commit"]
+
+
+def test_default_is_four_commits_in_todays_order(tmp_path):
+    proc, rec = run(tmp_path, None)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert [r["kind"] for r in rec] == ["cli", "api-route", "api-commit", "cli", "cli"], rec
+    assert [r["commit"] for r in rec if r["kind"] == "cli"] == [True, True, True]
+    assert len(commits(rec)) == 4, "initial, routes, services, policy: the empty zonebased render sends nothing"
+    assert not any(r.get("commit_only") for r in rec)
+
+
+@pytest.mark.parametrize("value", ["false", "0", "", "off", "garbage"])
+def test_anything_but_an_explicit_on_keeps_per_lane_commits(tmp_path, value):
+    proc, rec = run(tmp_path, value)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert len(commits(rec)) == 4 and not any(r.get("commit_only") for r in rec)
+
+
+@pytest.mark.parametrize("value", ["1", "true", "TRUE", "yes", "on"])
+def test_switch_on_means_exactly_one_commit_and_it_is_last(tmp_path, value):
+    proc, rec = run(tmp_path, value)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert [r["kind"] for r in rec] == ["cli", "api-route", "cli", "cli", "cli"], rec
+    assert len(commits(rec)) == 1, rec
+    assert rec[-1]["commit_only"] is True and rec[-1]["commit"] is True and rec[-1]["n"] == 0
+    # every lane staged its lines first, none committed
+    assert all(r["commit"] is False for r in rec[:-1] if r["kind"] == "cli")
+    assert [r["first"] for r in rec if r["kind"] == "cli"][:3] == [
+        "set deviceconfig system hostname pa-fw",
+        "set deviceconfig system service disable-snmp no",
+        'set rulebase security rules "ALLOW" action allow',
+    ]
+
+
+def test_the_single_commit_names_every_staged_lane_and_a_failure_names_them_too(tmp_path):
+    proc, rec = run(tmp_path, "true", fail_commit=True)
+    assert proc.returncode != 0
+    out = proc.stdout + proc.stderr
+    assert "The single PAN-OS commit on pa-fw failed" in out
+    for lane in ("initial", "routing", "services", "firewall.policy"):
+        assert lane in out.split("It covered the lanes")[1].split(";")[0], lane
+    assert "firewall.zonebased" not in out.split("It covered the lanes")[1].split(";")[0], "an empty render stages nothing"
+    assert "SKYFORGE_PANOS_SINGLE_COMMIT" in out, "the failure says how to get per-lane commits back"
+    assert len(commits(rec)) == 1
