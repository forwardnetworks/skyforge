+# PER-ATTEMPT LOG OF THE PROMOTION (SKYFORGE-SPECIFIC, instrumentation only).
+# panos_admpwd_kne appends one line per probe/promote phase boundary to this file (UTC time, attempt number,
+# elapsed, time to first byte, why the phase ended) and the report task below prints it, so the next boot shows
+# when the guest actually started answering. Fresh file per play so a reconfigure does not inherit old attempts.
+- name: Reset the PAN-OS promotion attempt log
+  ansible.builtin.file:
+    path: "/tmp/skyforge-panos-promotion-{{ inventory_hostname }}.log"
+    state: absent
+
 - name: Wait for the PAN-OS SSH endpoint to accept connections
   ansible.builtin.wait_for:
     host: "{{ ansible_host }}"
@@ -75,6 +84,7 @@
     old_password: admin
     new_password: "{{ ansible_password }}"
     key_filename: "{{ ansible_ssh_private_key_file | default(omit) }}"
+    attempt_log: "/tmp/skyforge-panos-promotion-{{ inventory_hostname }}.log"
     # POLL FINELY, DO NOT WAIT COARSELY. timeout is the budget for ONE attempt,
     # and a device that is not up yet burns ALL of it before failing -- so at
     # 300s + 30s delay each retry cost 5.5 MINUTES and the ceiling was 55.
@@ -96,6 +106,10 @@
   retries: 50
   delay: 10
 
+- name: Report the PAN-OS promotion attempts (when did the guest start answering?)
+  ansible.builtin.debug:
+    msg: "{{ lookup('file', '/tmp/skyforge-panos-promotion-' ~ inventory_hostname ~ '.log', errors='ignore') | default('no attempt log was written', true) }}"
+
 # THE AUTOCOMMIT GATE, OVER THE SAME SSH SESSION EVERYTHING ELSE USES.
 #
 # A cold PAN-OS refuses every user commit until its first-boot AutoCom job
@@ -231,5 +245,15 @@
     username: "{{ ansible_user }}"
     password: "{{ ansible_password }}"
     lines: "{{ panos_initial_config.splitlines() }}"
-    commit: true
+    # SKYFORGE-SPECIFIC single-commit mode: with SKYFORGE_PANOS_SINGLE_COMMIT on, initial-config.ansible sets
+    # panos_commit_deferred, every lane only STAGES its lines in the candidate configuration, and ONE commit at
+    # the end of the playbook (tasks/panos/commit-pending.yml) commits them all. Off (the default) this is the
+    # historical commit-per-lane.
+    commit: "{{ not (panos_commit_deferred | default(false) | bool) }}"
     timeout: 300
+
+- name: Remember that the PAN-OS initial configuration is staged but not committed
+  ansible.builtin.set_fact:
+    panos_commit_pending: true
+    panos_pending_lanes: "{{ (panos_pending_lanes | default([])) + [netsim_action | default('initial')] }}"
+  when: panos_commit_deferred | default(false) | bool
