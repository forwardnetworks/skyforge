From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] devices: archive stanza for timed revert on IOS-family,
 PAN-OS password promotion and single commit, Junos day-0 normalising commit

---
diff --git a/netsim/ansible/initial-config.ansible b/netsim/ansible/initial-config.ansible
index a8725c9..53b4ced 100755
--- a/netsim/ansible/initial-config.ansible
+++ b/netsim/ansible/initial-config.ansible
@@ -14,6 +14,15 @@
       node_files: "{{ lookup('env','PWD') }}/node_files"
     tags: [ always ]
 
+  # SKYFORGE-SPECIFIC: single PAN-OS commit. When SKYFORGE_PANOS_SINGLE_COMMIT is on, the PAN-OS lanes only stage
+  # their lines and the last play below commits once (tasks/panos/commit-pending.yml). The flag is set HERE, in the
+  # playbook that owns that last play, so no other playbook that reaches the PAN-OS lanes (netlab config, reload)
+  # can leave staged-but-uncommitted configuration behind: they never see panos_commit_deferred and commit per lane.
+  - name: Decide whether PAN-OS commits once at the end of this playbook
+    set_fact:
+      panos_commit_deferred: "{{ (lookup('env','SKYFORGE_PANOS_SINGLE_COMMIT') | default('',true) | trim | lower) in ['1','true','yes','on'] }}"
+    tags: [ always ]
+
   - name: Deploy initial configuration
     include_tasks: "tasks/deploy-module.yml"
     args:
@@ -90,3 +99,21 @@
     loop: "{{ netlab_custom_config }}"
     loop_control:
       loop_var: custom_config
+
+#
+# SKYFORGE-SPECIFIC: the one PAN-OS commit (only when a lane staged something; see tasks/panos/commit-pending.yml)
+#
+- name: Commit staged PAN-OS configuration
+  hosts: all:!unprovisioned
+  strategy: "{{ netlab_strategy|default('linear') }}"
+  gather_facts: false
+  tags: [ always ]
+  tasks:
+  - name: Commit the configuration the PAN-OS lanes staged
+    include_tasks: "tasks/panos/commit-pending.yml"
+    when: >-
+      (panos_commit_pending | default(false) | bool)
+      and (netlab_device_type | default(ansible_network_os | default(''))) == 'panos'
+    args:
+      apply:
+        tags: [ always ]
