+def test_a_run_that_staged_nothing_commits_nothing(tmp_path):
+    import shutil
+    if shutil.which("ansible-playbook") is None:
+        pytest.skip("ansible-playbook is not installed: the single-commit command sequence was NOT exercised here")
+    work = build_workdir(tmp_path)
+    play = yaml.safe_load((work / "play.yml").read_text())
+    play[0]["tasks"] = [t for t in play[0]["tasks"] if t["name"].startswith("Decide")]
+    (work / "play.yml").write_text(yaml.safe_dump(play))
+    env = dict(os.environ, RECORD=str(work / "r.jsonl"), ANSIBLE_LIBRARY=str(work / "library"),
+               ANSIBLE_HOME=str(work / "h"), ANSIBLE_LOCAL_TEMP=str(work / "t"), SKYFORGE_PANOS_SINGLE_COMMIT="true")
+    proc = subprocess.run(["ansible-playbook", "-i", str(work / "hosts"), str(work / "play.yml")], cwd=work, env=env,
+                          capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert not (work / "r.jsonl").exists(), "no staged lane, no commit"
