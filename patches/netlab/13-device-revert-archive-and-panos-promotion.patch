index cb6d8df..9d0988b 100644
--- a/netsim/ansible/library/panos_admpwd_kne.py
+++ b/netsim/ansible/library/panos_admpwd_kne.py
@@ -1,6 +1,7 @@
 #!/usr/bin/python
 from __future__ import annotations
 
+import datetime
 import os
 import pty
 import re
@@ -50,6 +51,14 @@ options:
     required: false
     default: 180
     type: int
+  attempt_log:
+    description:
+      - File the module appends ONE LINE per phase boundary to (UTC timestamp, attempt number, phase C(probe) or
+        C(promote), event C(start) or C(end), elapsed seconds, time to the first byte the device sent, and why the
+        phase ended). Default C(/tmp/skyforge-panos-promotion-<host>-<port>.log). A failure to write it never fails
+        the module. The same text is returned as C(attempt_log) so a failed run still carries it.
+    required: false
+    type: str
 author:
   - Skyforge
 '''
@@ -58,6 +67,68 @@ author:
 PROMPT_BYTES = 4096
 
 
+def _utc_stamp(epoch: float) -> str:
+  moment = datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc)
+  return moment.strftime('%Y-%m-%dT%H:%M:%S.') + f'{moment.microsecond // 1000:03d}Z'
+
+
+def attempt_log_path(module: AnsibleModule) -> str:
+  explicit = str(module.params.get('attempt_log') or '').strip()
+  if explicit:
+    return explicit
+  where = re.sub(r'[^A-Za-z0-9_.-]+', '-', f"{module.params['host']}-{module.params['port']}")
+  return f'/tmp/skyforge-panos-promotion-{where}.log'
+
+
+class AttemptLog:
+  """Per-attempt record of the password promotion, so the NEXT boot shows when the guest actually became ready.
+
+  WHY. The retry loop in tasks/panos/initial.yml (timeout 45s, delay 10s) produced two data points on fleet40
+  2026-10-10 -- first RETRYING line 91 s after the SSH port opened, success 64 s later -- and neither could say when
+  the guest started answering, because Ansible prints nothing about an attempt until it ends and the module said
+  nothing about how it spent its time. One attempt is TWO phases, each with its own budget: the already-promoted
+  PROBE (up to min(timeout, 60) s) and then the PROMOTION (up to timeout s), so a single "45 s" attempt can really
+  take ~90 s. This logs both, with timestamps, and never changes what the module does.
+  """
+
+  def __init__(self, path: str):
+    self.path = path
+    self.lines: list = []
+    prior = []
+    try:
+      with open(path, encoding='utf-8') as handle:
+        prior = handle.read().splitlines()
+    except OSError:
+      prior = []
+    self.attempt = sum(1 for line in prior if ' phase=probe event=start' in line) + 1
+    self.first_epoch = None
+    for line in prior:
+      match = re.search(r' epoch=([0-9.]+)', line)
+      if match:
+        self.first_epoch = float(match.group(1))
+        break
+
+  def write(self, phase: str, event: str, **fields) -> None:
+    now = time.time()
+    if self.first_epoch is None:
+      self.first_epoch = now
+    parts = [
+      _utc_stamp(now), 'promotion', f'attempt={self.attempt}', f'phase={phase}', f'event={event}',
+      f'since_first_s={now - self.first_epoch:.1f}', f'epoch={now:.3f}',
+    ]
+    parts += [f'{key}={value}' for key, value in fields.items()]
+    line = ' '.join(parts)
+    self.lines.append(line)
+    try:
+      with open(self.path, 'a', encoding='utf-8') as handle:
+        handle.write(line + '\n')
+    except OSError:
+      pass  # a log that cannot be written must never fail a promotion
+
+  def text(self) -> str:
+    return '\n'.join(self.lines)
+
+
 def scrub(text: str, *secrets: str) -> str:
   for secret in secrets:
     if secret:
