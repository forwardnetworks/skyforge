diff --git a/netsim/ansible/tasks/panos/commit-pending.yml b/netsim/ansible/tasks/panos/commit-pending.yml
new file mode 100644
index 0000000..2549604
--- /dev/null
+++ b/netsim/ansible/tasks/panos/commit-pending.yml
@@ -0,0 +1,43 @@
+---
+# SKYFORGE-SPECIFIC: the ONE PAN-OS commit of the single-commit mode (SKYFORGE_PANOS_SINGLE_COMMIT).
+#
+# WHY. Every PAN-OS lane (initial, static routes, services, firewall.policy, firewall.zonebased) used to push its
+# set-commands AND commit: four commits of 48 to 67 s each on fleet40 (2026-10-10), ~250 s of the lab's apply
+# phase, while the set-commands themselves take ~3 s. Nothing in the lanes depends on an earlier lane being
+# COMMITTED: they are all `set` statements into the candidate configuration (a rule that names a zone, a route
+# that names an interface, an lldp line on an interface the initial lane created are references the commit
+# validates, and the candidate already holds the target). With the switch on, each lane stages its lines
+# (commit=false) and this file commits once, at the very end of initial-config.ansible.
+#
+# WHAT THIS KEEPS. The autocommit gate and the password promotion still run BEFORE any lane (initial.yml). A
+# line the device rejects ("Invalid syntax", "Unknown command") still fails the lane that sent it. What changes
+# is that a commit-time validation error is now reported by this task for the whole staged set; the failure
+# message names every staged lane. Nothing is rolled back: the candidate configuration keeps all the lanes, as it
+# did after a failed per-lane commit.
+- name: Commit the staged PAN-OS configuration (one commit for every lane)
+  block:
+  - name: "Commit staged PAN-OS lanes: {{ panos_pending_lanes | default([]) | join(', ') }}"
+    panos_cli_config_kne:
+      host: "{{ ansible_host }}"
+      port: "{{ panos_kne_ssh_port }}"
+      username: "{{ ansible_user }}"
+      password: "{{ ansible_password }}"
+      commit_only: true
+      commit: true
+      timeout: 600
+    register: panos_single_commit
+
+  - name: The staged PAN-OS lanes are committed
+    ansible.builtin.set_fact:
+      panos_commit_pending: false
+
+  rescue:
+  - name: The single PAN-OS commit failed
+    ansible.builtin.fail:
+      msg: >-
+        The single PAN-OS commit on {{ inventory_hostname }} failed
+        ({{ ansible_failed_result.msg | default('no message') }}). It covered the lanes
+        {{ panos_pending_lanes | default([]) | join(', ') }}; none of them is committed and the device's candidate
+        configuration still holds all of them. Per-lane commits are the default: unset
+        SKYFORGE_PANOS_SINGLE_COMMIT to get a commit (and a failure) per lane. Device transcript tail:
+        {{ (ansible_failed_result.transcript | default(''))[-1500:] }}
