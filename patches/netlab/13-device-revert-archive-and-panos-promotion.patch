diff --git a/netsim/ansible/templates/initial/junos/skyforge-day0-commit.j2 b/netsim/ansible/templates/initial/junos/skyforge-day0-commit.j2
new file mode 100644
index 0000000..32ed7b0
--- /dev/null
+++ b/netsim/ansible/templates/initial/junos/skyforge-day0-commit.j2
@@ -0,0 +1,37 @@
+{#
+    SKYFORGE-SPECIFIC. A NORMALISING COMMIT AT THE END OF DAY-0.
+
+    The KubeVirt Junos images (vjunos-router, vjunos-switch, vsrx) boot this file as their whole
+    configuration: the device loads it at boot ("by root via other") and that load is rollback 0. Its
+    STORED text is not what `show configuration` renders afterwards (no version line, no assigned uid,
+    password hashes as the load produced them). So the first held change after boot has a rollback 1
+    that never digests as the running config, and the config-push executor refuses to revert it from
+    the platform (live 2026-11-01, run 1b51663c on cp-vjrouter-r1: "junos rollback 1 is not the
+    pre-change config"); only the device's own commit-confirmed timer could undo it.
+
+    This event policy makes the device commit ONCE, about a minute after boot, from its own running
+    configuration. The commit removes the policy itself, so the running config is the netlab config
+    and nothing else, and rollback 0 is then a rendering of that config: the next change's rollback 1
+    digests exactly as the pre-change running config, and the platform revert works from the first change.
+    No change of configuration content is made by this commit other than deleting the policy.
+
+    NO commit-options log. A log line is printed under the entry in `show system commit`, and the
+    config-push executor reads that list fail-closed: live 2026-11-01 (run 7a7099e8) it refused the
+    first change on "unexpected line" for exactly that text, before anything was committed.
+#}
+event-options {
+    generate-event {
+        skyforge-day0-commit time-interval 60;
+    }
+    policy skyforge-day0-commit {
+        events skyforge-day0-commit;
+        then {
+            change-configuration {
+                commands {
+                    "delete event-options policy skyforge-day0-commit";
+                    "delete event-options generate-event skyforge-day0-commit";
+                }
+            }
+        }
+    }
+}
