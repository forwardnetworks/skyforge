+def test_the_flag_is_decided_only_in_the_playbook_that_owns_the_final_commit():
+    """netlab config / reload playbooks reach the same PAN-OS lanes. They must never see the flag, or they would
+    stage configuration nothing commits."""
+    for playbook in sorted(ANSIBLE.glob("*.ansible")):
+        text = playbook.read_text()
+        if playbook.name == "initial-config.ansible":
+            assert "panos_commit_deferred" in text and "tasks/panos/commit-pending.yml" in text
+        else:
+            assert "panos_commit_deferred" not in text, playbook.name
+    for lane in (TASKS / "panos" / "initial.yml", TASKS / "panos" / "routing.yml", TASKS / "deploy-config" / "panos.yml"):
+        assert "panos_commit_deferred | default(false)" in lane.read_text(), f"{lane.name}: undefined must mean per-lane commit"
+
+
+def _module():
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("panos_cli_config_kne_under_test", ANSIBLE / "library" / "panos_cli_config_kne.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def test_session_queue_for_a_lane_is_unchanged_and_commit_only_sends_just_the_commit():
+    cli = _module()
+    # today's lane session: lines, commit, leave configure mode, leave
+    assert cli.build_queue(["set a b", "set c d"], op_mode=False, do_commit=True) == [
+        "set cli scripting-mode on", "set cli pager off", "configure", "set a b", "set c d", "commit", "exit", "exit"]
+    # a staged lane: the same session without the commit
+    assert cli.build_queue(["set a b"], op_mode=False, do_commit=False) == [
+        "set cli scripting-mode on", "set cli pager off", "configure", "set a b", "exit", "exit"]
+    # the single commit: no set lines, just the commit
+    assert cli.build_queue([], op_mode=False, do_commit=True) == [
+        "set cli scripting-mode on", "set cli pager off", "configure", "commit", "exit", "exit"]
+    # op mode (the autocommit gate) is untouched
+    assert cli.build_queue(["show jobs all"], op_mode=True, do_commit=False) == [
+        "set cli scripting-mode on", "set cli pager off", "show jobs all", "exit"]
