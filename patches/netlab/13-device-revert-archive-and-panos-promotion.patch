   if pid == 0:
@@ -223,7 +291,11 @@ def promote_password(module: AnsibleModule) -> tuple[bool,str]:
   sent_confirm = False
   changed = False
   exited = False
-  deadline = time.time() + timeout
+  started = time.time()
