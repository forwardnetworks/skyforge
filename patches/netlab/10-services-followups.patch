@@ -133,9 +157,23 @@ attributes:
       ignore: []
       must_have: [ server, ipv4, ipv6 ]
       check_when: [ _server_list ]
+_top:
+  attributes:
+    _services_listen:
+      proto:
+        type: str
+        valid_values: [ https, http, tcp-echo, udp-echo, iperf3 ]
+        _required: True
+      port:
+        type: int
+        min_value: 1
+        max_value: 65535
+        _required: True
+
 features:
   dns: DNS client
   syslog: syslog client
+  bmp: BMP monitoring station (device listens, station dials)
   # Split by PROTOCOL, not a flat `flow: True`. Juniper splits by platform --
   # sFlow on the switch, inline IPFIX on the router -- so one capability flag
   # would silently render nothing on half the fleet.
diff --git a/netsim/providers/kne.py b/netsim/providers/kne.py
index 06096c8..7830cb6 100644
--- a/netsim/providers/kne.py
+++ b/netsim/providers/kne.py
@@ -2636,26 +2636,61 @@ def adjust_iol_node_data(kne_data: Box, node: Box) -> None:
   kne_data.env.IOL_RUNNER_LOCAL_APP = str(node_id)
 
 CALDERA_AGENT_ENV_KEYS = ('SKYFORGE_CALDERA_AGENT_ENABLED','SKYFORGE_CALDERA_SERVER')
+LINUX_SERVICES_ENV_KEYS = ('SKYFORGE_SERVICES','SKYFORGE_SERVICES_NAME','SKYFORGE_IPERF3_SERVER_PORT')
 
-def adjust_linux_node_data(kne_data: Box, node: Box) -> None:
+def caldera_agent_node_selected(node: Box) -> bool:
+  '''
+  Is this node one the platform asked to run the Caldera agent?
+
+  NETLAB_KNE_CALDERA_AGENT_NODES is a comma-separated list of node names the platform server puts on the
+  runtime Job together with NETLAB_KNE_CALDERA_AGENT_SERVER. ABSENT (or empty) means every linux node of the
+  deployment, which is the default scope of the deployment setting; PRESENT means exactly those nodes.
+  '''
+  selected = [ n.strip() for n in str(os.environ.get('NETLAB_KNE_CALDERA_AGENT_NODES','') or '').split(',') if n.strip() ]
+  return (not selected) or node.name in selected
+
+def linux_services_env(node: Box) -> dict:
   '''
-  PLATFORM-SPECIFIC: the Caldera (Sandcat) agent is OPT-IN PER LAB, and this is the only door.
+  The pod env for the node's DECLARED listeners (services.listen).
 
-  The skyforge-linux-host image starts its Sandcat launcher only when the pod carries
-  SKYFORGE_CALDERA_AGENT_ENABLED=1 and SKYFORGE_CALDERA_SERVER. Both come from ONE per-run fact,
-  NETLAB_KNE_CALDERA_AGENT_SERVER, which the platform server puts on the runtime Job only when the
-  deployment's owner switched Caldera on for that deployment (default off, audited). Unset -> the pod
-  gets neither variable and the image runs no agent.
+  SKYFORGE_SERVICES is the "<proto>:<port>,..." list the skyforge-linux-host image's strict parser reads
+  (https, http, tcp-echo, udp-echo); an iperf3 entry becomes SKYFORGE_IPERF3_SERVER_PORT because the image
+  starts that server on its own switch. SKYFORGE_SERVICES_NAME is the node name, echoed in the health JSON.
+  No declaration -> empty dict -> the image starts no listener.
+  '''
+  env: dict = {}
+  listen = node.get('services.listen',None) or []
+  items = [ f"{e.proto}:{e.port}" for e in listen if e.get('proto') and e.get('proto') != 'iperf3' ]
+  if items:
+    env['SKYFORGE_SERVICES'] = ','.join(items)
+    env['SKYFORGE_SERVICES_NAME'] = node.name
+  for e in listen:
+    if e.get('proto') == 'iperf3':
+      env['SKYFORGE_IPERF3_SERVER_PORT'] = str(e.port)
+  return env
 
-  A topology author's own `kne.env.SKYFORGE_CALDERA_*` is DISCARDED either way: the lab file is user
-  input and must not be able to enrol a node by itself (the Caldera NetworkPolicy is the second lock;
-  this keeps the pod spec honest about it).
+def adjust_linux_node_data(kne_data: Box, node: Box) -> None:
+  '''
+  PLATFORM-SPECIFIC: the pod env of a linux host comes from the platform and the declaration, not from raw env.
+
+  1. Caldera (Sandcat) agent -- OPT-IN, PLATFORM-AUTHORISED, PER DEPLOYMENT AND PER NODE SCOPE. The
+     skyforge-linux-host image starts its launcher only when the pod carries SKYFORGE_CALDERA_AGENT_ENABLED=1 and
+     SKYFORGE_CALDERA_SERVER. Both come from ONE per-run fact, NETLAB_KNE_CALDERA_AGENT_SERVER, which the
+     The platform server puts on the runtime Job only when the deployment's owner switched Caldera on (default off,
+     audited); the optional NETLAB_KNE_CALDERA_AGENT_NODES narrows it to the nodes the owner selected. Nothing in
+     the topology can ask for the agent: a topology author's own `kne.env.SKYFORGE_CALDERA_*` is DISCARDED either
+     way (the lab file is user input; the Caldera NetworkPolicy is the second lock).
+  2. Listeners -- `services.listen` (node or group level) is rendered into SKYFORGE_SERVICES /
+     SKYFORGE_IPERF3_SERVER_PORT, and a topology author's own values for those keys are discarded, so the
+     declaration is the only door and the node data tells the truth about what listens.
   '''
   kne_data.env = kne_data.get('env',Box(default_box=True,box_dots=True))
-  for key in CALDERA_AGENT_ENV_KEYS:
+  for key in CALDERA_AGENT_ENV_KEYS + LINUX_SERVICES_ENV_KEYS:
     kne_data.env.pop(key,None)
+  for key,value in linux_services_env(node).items():
+    kne_data.env[key] = value
   server = str(os.environ.get('NETLAB_KNE_CALDERA_AGENT_SERVER','') or '').strip()
-  if not server:
+  if not server or not caldera_agent_node_selected(node):
     return
   kne_data.env.SKYFORGE_CALDERA_AGENT_ENABLED = '1'
   kne_data.env.SKYFORGE_CALDERA_SERVER = server
