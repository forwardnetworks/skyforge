diff --git a/netsim/ansible/templates/services/linux.j2 b/netsim/ansible/templates/services/linux.j2
index 32a2b67..3af375a 100644
--- a/netsim/ansible/templates/services/linux.j2
+++ b/netsim/ansible/templates/services/linux.j2
@@ -1,2 +1,40 @@
 #!/bin/sh
+{#
+  PLATFORM-SPECIFIC (patch 39): the SNMP agent of a linux host, delivered like the services of every other NOS.
+
+  `services.server.snmp` is set on every node by the platform defaults (community `skyforge`, the community
+  the collector's collectors poll with), so a linux host answers SNMP exactly like a cEOS does. A node opts out with
+  `services.server.snmp: false`. A linux image without net-snmp (any non-platform image) is skipped with a note,
+  never an error: the services script must not fail a lab over a missing optional daemon.
+
+  The script runs inside the pod (the linux namespace-exec lane) at day 0 AND again on every warm reconfigure,
+  so it is idempotent: it rewrites the config and signals a running snmpd to reload instead of starting a second
+  one. The community lives only in the 0600 config file; the script never prints it.
+#}
 # Syslog configuration comes here (eventually)
+{% if services.server.snmp is defined %}
+if command -v snmpd >/dev/null 2>&1; then
+  mkdir -p /etc/snmp /var/log
+  ( umask 077
+    {
+      echo "agentAddress udp:161"
+      echo "rocommunity {{ services.server.snmp.community|default('skyforge') }} default"
+      echo "sysName $(hostname)"
+      echo "sysDescr Skyforge linux host (skyforge-linux-host)"
+{%   if services.server.snmp.location is defined %}
+      echo "sysLocation {{ services.server.snmp.location }}"
+{%   endif %}
+{%   if services.server.snmp.contact is defined %}
+      echo "sysContact {{ services.server.snmp.contact }}"
+{%   endif %}
+      echo "dontLogTCPWrappersConnects yes"
+    } > /etc/snmp/snmpd.conf )
+  if [ -s /run/snmpd.pid ] && kill -0 "$(cat /run/snmpd.pid)" 2>/dev/null; then
+    kill -HUP "$(cat /run/snmpd.pid)"
+  else
+    snmpd -C -c /etc/snmp/snmpd.conf -p /run/snmpd.pid -Lf /var/log/snmpd.log
+  fi
+else
+  echo "services: snmpd is not installed in this image; SNMP agent not started" >&2
+fi
+{% endif %}
