+def test_kne_linux_services_script_configures_snmpd_read_only(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  text = _linux_services_script(tmp_path,"""    services:
+      server:
+        snmp: { community: lab-ro-7, location: "rack 3" }
+""")
+  assert text.startswith('#!/bin/sh')
+  assert 'rocommunity lab-ro-7 default' in text
+  assert 'sysLocation rack 3' in text
+  assert 'sysName $(hostname)' in text and 'Skyforge linux host' in text
+  assert 'agentAddress udp:161' in text
+  assert 'rwcommunity' not in text and 'rwuser' not in text and 'createUser' not in text
+  assert 'umask 077' in text                          # the config carrying the community is not world-readable
+  # idempotent on a warm reconfigure: reload a running daemon, start one otherwise
+  assert 'kill -HUP' in text and 'snmpd -C -c /etc/snmp/snmpd.conf' in text
+  # the community is written to the file and never echoed to the console
+  assert text.count('lab-ro-7') == 1
+  # a missing daemon is a note, not a failure
+  assert 'command -v snmpd' in text and 'not installed' in text
+
