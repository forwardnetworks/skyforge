+def _linux_listen_env(tmp_path: Path) -> tuple:
+  topo_file = write_topology(tmp_path,LISTEN_TOPOLOGY)
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+  return Path('topology.pb.txt').read_text()
