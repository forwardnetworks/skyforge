+def test_kne_linux_declared_listeners_render_into_the_pod_env(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  monkeypatch.delenv('NETLAB_KNE_CALDERA_AGENT_SERVER',raising=False)
+  monkeypatch.delenv('NETLAB_KNE_CALDERA_AGENT_NODES',raising=False)
+  text = _linux_listen_env(tmp_path)
+  h1 = _node_block(text,'h1')
+  assert 'value: "https:443,http:80,tcp-echo:7001,udp-echo:7002"' in h1
+  assert 'key: "SKYFORGE_IPERF3_SERVER_PORT"' in h1 and 'value: "5201"' in h1
+  assert 'value: "h1"' in h1                      # SKYFORGE_SERVICES_NAME
+  assert 'KEEP_ME' in h1
+  # the lab author's own values for the same keys are discarded: the declaration is the only door
+  assert 'http:9999' not in text and '9998' not in text
+  # a node with no declaration gets no listener env at all
+  h2 = _node_block(text,'h2')
+  assert 'SKYFORGE_SERVICES' not in h2 and 'SKYFORGE_IPERF3' not in h2
+  # group-level declaration reaches every member
+  for member in ('h3','h4'):
+    assert 'value: "https:8443"' in _node_block(text,member)
+
