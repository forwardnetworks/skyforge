+"""services.bmp: a passive BMP station on EOS and Junos, and nowhere else.
+
+These tests compile real topologies through the real module and render the real
+services templates, so they go red if the schema, the device declarations, the
+module's eligibility rule or either template is changed out from under the others.
+The requirement they pin: the station is rendered only on a node that runs the bgp
+module on EOS or Junos, never on any other platform, and a declaration that cannot
+render is removed from the node data rather than left looking configured.
+"""
+import textwrap
+from pathlib import Path
+
+import pytest
+from box import Box
+
+from netsim import augment
+from netsim.utils import log, templates
+from netsim.utils import read as _read
+
+SERVICES = 'ansible/templates/services'
+EXTRA = [str(Path(__file__).parent.parent / 'netsim' / 'ansible' / 'templates')]
+
+TOPOLOGY = """
+defaults.device: eos
+provider: clab
+module: [ bgp, services ]
+services.bmp.station: bmp.example.net
+bgp.as: 65000
+nodes:
+  e1:
+  j1:
+    device: vjunos-router
+    provider: libvirt
+    box: x
+  s1:
+    device: vsrx
+    provider: libvirt
+    box: x
+  f1:
+    device: frr
+  n1:
+    device: iosv
+  e2:
+    services.bmp.enabled: false
+  e3:
+    module: [ services ]
+  e4:
+    services.bmp.port: 50002
+    services.bmp.name: collector
+    services.bmp.failure_handling: SWITCH_TO_CLI
+links: [ e1-j1, e1-f1, e1-n1, e1-e2, e1-e3, e1-s1, e1-e4 ]
+"""
+
+
+def _init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+def compile_topology(tmp_path: Path, text: str, raise_error: bool = False) -> Box:
+  f = tmp_path / 'topology.yml'
+  f.write_text(textwrap.dedent(text).strip() + "\n")
+  _init_log(raise_error)
+  topology = _read.load(str(f),relative_topo_name=True,user_defaults=[])
+  log.exit_on_error()
+  augment.main.transform(topology)
+  return topology
+
+
+@pytest.fixture
+def topo(tmp_path: Path) -> Box:
+  return compile_topology(tmp_path,TOPOLOGY)
+
+
+def render(node: Box, device_template: str) -> str:
+  return templates.render_template(
+    data=node.to_dict(),
+    j2_file=f'{device_template}.j2',
+    path=SERVICES,extra_path=EXTRA)
+
+
+def test_eligible_nodes_keep_the_block_with_defaults_filled(topo: Box):
+  for name in ('e1','j1'):
+    bmp = topo.nodes[name].services.bmp
+    assert bmp.station == 'bmp.example.net'
+    assert bmp.port == 50001
+    assert bmp.mode == 'passive'
+    assert bmp.name == 'skyforge'
+
+
+def test_a_node_value_beats_the_default_and_failure_handling_is_carried(topo: Box):
+  bmp = topo.nodes.e4.services.bmp
+  assert (bmp.port,bmp.name,bmp.failure_handling) == (50002,'collector','SWITCH_TO_CLI')
+  assert 'failure_handling' not in topo.nodes.e1.services.bmp
+
+
+@pytest.mark.parametrize('node,why',[
+  ('f1','frr declares no bmp support'),
+  ('n1','ios declares no bmp support and has no bgp.as'),
+  ('s1','vsrx is a firewall persona that opts out of the junos declaration'),
+  ('e2','explicit enabled: false'),
+  ('e3','eos without the bgp module'),
+])
+def test_every_other_node_has_the_block_removed(topo: Box, node: str, why: str):
+  assert 'bmp' not in topo.nodes[node].get('services',{}), why
+
+
+def test_eos_renders_a_passive_station_under_router_bgp(topo: Box):
+  out = render(topo.nodes.e1,'eos')
+  assert textwrap.dedent("""\
+    router bgp 65000
+       bgp monitoring
+       monitoring port 50001
+       monitoring station skyforge
+          connection address bmp.example.net
+          connection mode passive
+    """) in out
+  assert 'collector' in render(topo.nodes.e4,'eos')
+  assert 'monitoring port 50002' in render(topo.nodes.e4,'eos')
+
+
+def test_junos_renders_hierarchical_config_never_set_lines(topo: Box):
+  out = render(topo.nodes.j1,'vjunos-router')
+  assert 'station skyforge {' in out
+  assert 'connection-mode passive;' in out
+  assert 'station-address bmp.example.net;' in out
+  assert 'station-port 50001;' in out
+  assert 'pre-policy;' in out and 'post-policy;' in out
+  assert not any(l.lstrip().startswith('set ') for l in out.splitlines())
+
+
+def test_no_bmp_text_without_the_declaration(topo: Box):
+  # e3 has no bgp module and e2 opted out: their rendered services must carry no station
+  assert 'monitoring' not in render(topo.nodes.e3,'eos')
+  assert 'bmp' not in render(topo.nodes.e2,'eos')
+  assert 'bmp' not in render(topo.nodes.s1,'vsrx')
+
+
+@pytest.mark.parametrize('template',sorted(
+  p.stem for p in (Path(__file__).parent.parent / 'netsim' / SERVICES).glob('*.j2')
+  if p.stem not in ('eos','junos','vmx','vptx','vsrx','vjunos-router','vjunos-switch')))
+def test_other_platforms_render_identically_with_or_without_the_declaration(topo: Box, template: str):
+  """IOS, IOS-XE, NX-OS, XR, FRR ... : the declaration must change not one byte."""
+  base = topo.nodes.f1.to_dict()
+  with_bmp = Box(base,box_dots=True)
+  with_bmp.services.bmp = {'station':'bmp.example.net','port':50001,'mode':'passive','name':'skyforge'}
+  data = Box(base,default_box=True,box_dots=True)
+  data.services.dns._server_list = ['10.0.0.1']
+  bare = templates.render_template(data=data.to_dict(),j2_file=f'{template}.j2',path=SERVICES,extra_path=EXTRA)
+  data.services.bmp = {'station':'bmp.example.net','port':50001,'mode':'passive','name':'skyforge'}
+  decl = templates.render_template(data=data.to_dict(),j2_file=f'{template}.j2',path=SERVICES,extra_path=EXTRA)
+  assert bare == decl
+
+
+def test_a_declaration_without_a_station_is_an_error(tmp_path: Path):
+  text = TOPOLOGY.replace('services.bmp.station: bmp.example.net','services.bmp.port: 50001')
+  with pytest.raises(log.ErrorAbort):
+    compile_topology(tmp_path,text,raise_error=True)
+
+
+def test_passive_is_the_only_mode(tmp_path: Path):
+  text = TOPOLOGY.replace('services.bmp.station: bmp.example.net',
+                          'services.bmp: { station: x, mode: active }')
+  with pytest.raises(log.ErrorAbort):
+    compile_topology(tmp_path,text,raise_error=True)
