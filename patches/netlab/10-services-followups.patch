+def _node_block(provider_text: str, name: str) -> str:
+  # topology.pb.txt lists one `nodes {` block per node; return the one named `name`
+  blocks = provider_text.split('nodes: {')
+  return next(b for b in blocks if f'name: "{name}"' in b)
+
