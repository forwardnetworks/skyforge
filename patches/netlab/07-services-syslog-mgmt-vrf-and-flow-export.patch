diff --git a/netsim/ansible/templates/services/eos.j2 b/netsim/ansible/templates/services/eos.j2
index 18c12a9..1e50990 100644
--- a/netsim/ansible/templates/services/eos.j2
+++ b/netsim/ansible/templates/services/eos.j2
@@ -38,3 +38,35 @@ management api gnmi
 #}
 snmp-server community {{ services.server.snmp.community|default('skyforge') }} ro
 {% endif %}
+{% if services.syslog._server_list is defined and services.syslog._mgmt|default(False) %}
+{#
+  Skyforge: `transport_vrf: mgmt` (see services.py). The collector is reached
+  over management, so logs are sourced from the management interface.
+#}
+logging source-interface {{ mgmt_if|default('Management0') }}
+{% endif %}
+{% if services.flow.protocol|default('') == 'sflow' and services.flow._server_list is defined %}
+{#
+  sFLOW EXPORT -- the point of which is evidence, not telemetry.
+
+  Monitoring collects over the management interface, so a completely dead data
+  plane certifies green today. An sFlow record says THIS DEVICE forwarded these
+  packets: a claim about the fabric, made by the fabric, which no counter on a
+  traffic generator can make about itself.
+
+  All GLOBAL on EOS -- `sflow run` enables it, and there is no per-interface
+  line to emit. Other platforms (IOS-XE flow monitors, Junos sampling) need a
+  per-interface loop, which a template can do: services/panos.j2 already
+  iterates `interfaces` and skips the management one. That exclusion matters
+  here too -- an exporter on the management interface reports the traffic our
+  own monitoring generates, which is noise wearing the costume of evidence.
+#}
+{%   for _flow_host in services.flow._server_list[:2] %}
+sflow destination {{ _flow_host }} {{ services.flow.port|default(6343) }}
+{%   endfor %}
+sflow source-interface {{ mgmt_if|default('Management0') }}
+{%   if services.flow.sampling is defined %}
+sflow sample {{ services.flow.sampling }}
+{%   endif %}
+sflow run
+{% endif %}
diff --git a/netsim/ansible/templates/services/ios.j2 b/netsim/ansible/templates/services/ios.j2
index 6155a85..7eba15d 100644
--- a/netsim/ansible/templates/services/ios.j2
+++ b/netsim/ansible/templates/services/ios.j2
@@ -40,3 +40,110 @@ logging host {{ "ipv6 " if ':' in syslog_host else "" }}{{ syslog_host }}{%
 #}
 snmp-server community {{ services.server.snmp.community|default('skyforge') }} RO
 {% endif %}
+{% if services.syslog._server_list is defined and services.syslog._mgmt|default(False) %}
+{#
+  Skyforge: `transport_vrf: mgmt` (see services.py). The collector is reached
+  over management, so logs are sourced from the management interface.
+#}
+logging source-interface {{ mgmt_if|default(mgmt.ifname|default('Ethernet0/0')) }}{%
+   if services.syslog.transport_vrf is defined %} vrf {{ services.syslog.transport_vrf }}{% endif +%}
+{% endif %}
+{% set _flow_mgmt = mgmt_if|default(mgmt.ifname|default('')) %}
+{% set _flow_l3 = [] %}
+{% for intf in interfaces|default([]) if intf.ifname != _flow_mgmt
+     and ((intf.ipv4 is defined and intf.ipv4) or (intf.ipv6 is defined and intf.ipv6)) %}
+{%   set _ = _flow_l3.append(intf.ifname) %}
+{% endfor %}
+{#
+  NOT ON AN SD-WAN EDGE. A controller-mode cat8000v does not own its running
+  configuration -- vManage does. This block would land in the CVAC day-0 seed
+  and then sit inside whatever the service-side lane reads back and re-pushes as
+  that edge's CLI template, which is a fight over the same bytes. Worse, a day-0
+  the appliance rejects costs the whole SD-WAN bootstrap, which is the most
+  expensive thing in this tree to get back. A plain (autonomous-mode) cat8000v
+  has none of that and exports normally. Revisit by adding the exporter to the
+  SERVICE-SIDE overlay template (sdwan_service_vpn.cli.j2), where vManage is the
+  one pushing it.
+#}
+{% if 'sdwan' not in module|default([])
+      and services.flow.protocol|default('') in ['netflow','ipfix']
+      and services.flow._server_list is defined and _flow_l3 %}
+{#
+  FLEXIBLE NETFLOW EXPORT -- the point of which is evidence, not telemetry.
+
+  Monitoring collects over the management interface, so a completely dead data
+  plane certifies green. A flow record says THIS DEVICE forwarded these packets:
+  a claim about the fabric, made by the fabric, which no counter on a traffic
+  generator can make about itself.
+
+  IOS SPEAKS NO sFLOW. Measured 2026-09-11 on a live IOL: `show sflow` is
+  "% Invalid input detected", while `show flow record` lists the full built-in
+  Flexible NetFlow set and `show flow exporter` answers empty rather than
+  erroring. So this platform declares netflow/ipfix and NOT sflow, which is what
+  makes the module refuse `protocol: sflow` here instead of rendering nothing
+  and looking configured.
+
+  PER-INTERFACE, AND NOT ON MANAGEMENT. Unlike EOS -- where `sflow run` is one
+  global line -- a flow monitor does nothing until it is applied to an
+  interface. The management interface is excluded on purpose: an exporter there
+  reports the traffic our own monitoring generates, which is noise wearing the
+  costume of evidence.
+
+  ONLY ON ADDRESSED INTERFACES. `ip flow monitor` is an L3 interface command:
+  an L2 switchport (ioll2, measured 2026-09-11 on demo-lab dc-sdwan-sw01) rejects
+  it. The monitor therefore follows the L3 ADDRESS, not the interface name --
+  routed ports, subinterfaces and addressed SVI/BDI -- and a node with no routed
+  interface renders no flow block at all rather than an exporter attached to
+  nothing.
+#}
+flow record skyforge-ipv4
+ match ipv4 protocol
+ match ipv4 source address
+ match ipv4 destination address
+ match transport source-port
+ match transport destination-port
+ match ipv4 tos
+ match interface input
+ collect interface output
+ collect counter bytes
+ collect counter packets
+ collect timestamp sys-uptime first
+ collect timestamp sys-uptime last
+!
+{%   for _flow_host in services.flow._server_list[:2] %}
+flow exporter skyforge-{{ loop.index }}
+ destination {{ _flow_host }}{% if services.flow.transport_vrf is defined %} vrf {{ services.flow.transport_vrf }}{% endif +%}
+{%     if _flow_mgmt %}
+ source {{ _flow_mgmt }}
+{%     endif %}
+ transport udp {{ services.flow.port|default(2055) }}
+ export-protocol {{ 'ipfix' if services.flow.protocol == 'ipfix' else 'netflow-v9' }}
+ template data timeout 60
+!
+{%   endfor %}
+flow monitor skyforge
+{%   for _flow_host in services.flow._server_list[:2] %}
+ exporter skyforge-{{ loop.index }}
+{%   endfor %}
+ record skyforge-ipv4
+ cache timeout active 60
+!
+{%   if services.flow.sampling is defined %}
+{#
+  1-in-N. Unsampled export from a traffic generator's own load is a denial of
+  service against the collector, so sampling is not the optional nicety it looks.
+#}
+sampler skyforge
+ mode random 1 out-of {{ services.flow.sampling }}
+!
+{%   endif %}
+{%   for _flow_intf in _flow_l3 %}
+interface {{ _flow_intf }}
+{%     if services.flow.sampling is defined %}
+ ip flow monitor skyforge sampler skyforge input
+{%     else %}
+ ip flow monitor skyforge input
+{%     endif %}
+!
+{%   endfor %}
+{% endif %}
diff --git a/netsim/ansible/templates/services/vjunos-router.j2 b/netsim/ansible/templates/services/vjunos-router.j2
index 9916d04..0aae39b 100644
--- a/netsim/ansible/templates/services/vjunos-router.j2
+++ b/netsim/ansible/templates/services/vjunos-router.j2
@@ -1,3 +1,10 @@
+{#
+    DNS and syslog come from upstream services/junos.j2. This file exists
+    because netlab picks services/<netlab_device_type>.j2 BEFORE
+    services/<ansible_network_os>.j2, so a per-device file that did not include
+    the parent would silently take those clients away from this device.
+#}
+{% include 'junos.j2' +%}
 {% if services.server.snmp is defined %}
 {#
     SNMP agent. Junos configuration is HIERARCHICAL everywhere else in netlab
@@ -30,3 +37,86 @@ snmp {
   }
 }
 {% endif %}
+{#
+  sFLOW EXPORT -- the point of which is evidence, not telemetry.
+
+  Monitoring collects over the management interface, so a completely dead data
+  plane certifies green. An sFlow record says THIS DEVICE forwarded these
+  packets: a claim about the fabric, made by the fabric, which no counter on a
+  traffic generator can make about itself.
+
+  sFLOW AND NOT IPFIX, AND THE REASON IS NOT THE ONE IN THE DOCS. Patch 0042
+  wrote that "Juniper divides by platform, sFlow on the switch and inline IPFIX
+  on the router". That is true of real EX and real MX and it is NOT true of the
+  two images in this tree. MEASURED 2026-09-11 on live demo-lab:
+
+    cdg-cor-sw01 (vjunos-router)  show version -> Model: vmx, RE-VMX
+    cdg-acc-sw01 (vjunos-switch)  show version -> Model: vmx, RE-VMX
+
+  Distinct container disks (juniper_vjunos-router and juniper_vjunos-switch,
+  different digests), one platform underneath. Their mgd schemas are identical
+  token for token -- `set protocols sflow ?`, `set forwarding-options sampling ?`
+  and `set services flow-monitoring ?` return the same completions on both -- so
+  there is no split here to follow, and a template that pretended there was
+  would render inline-jflow on one of two identical vMXs.
+
+  WHAT WAS ACTUALLY PROVEN is that this exact block is ACCEPTED. On
+  cdg-cor-sw01, in `configure private`, `commit check` over
+  agent-id/source-ip/collector+udp-port/sample-rate ingress/polling-interval/
+  interfaces returned "configuration check succeeds"; `rollback` then
+  `show | compare` came back EMPTY and nothing was committed. Inline IPFIX got
+  no such proof: `forwarding-options sampling instance` and
+  `services flow-monitoring version-ipfix` are both in the schema, but inline
+  jflow needs a PFE that implements it and this one is riot, so declaring ipfix
+  here would be a claim about hardware nobody checked.
+
+  STILL UNPROVEN, and this is the next lab's job: that records ARRIVE. The
+  collector sits at a cluster address reached over management, and sFlow
+  datagrams leave from the forwarding plane. `show sflow collector` on any
+  vJunos is the evidence.
+
+  NO agent-id OR source-ip, for the same reason Skyforge never sets a syslog
+  source-address: netlab's mgmt.ipv4 is not the address this device has.
+
+  PHYSICAL INTERFACES, DE-DUPLICATED. netlab hands us unit names (ge-0/0/1.0);
+  sFlow is configured on the port. Management is absent from `interfaces`
+  already and is filtered again here, because an exporter on the management
+  interface reports the traffic our own monitoring generates, which is noise
+  wearing the costume of evidence. irb is filtered too: it isn't physical,
+  and on the switch persona `sflow interfaces irb` is a hard mgd error at
+  boot ("sFlow can be configured only on ge/xe/et interfaces"), so the
+  vjunos-switch template must never emit it -- kept consistent here rather
+  than diverging per persona.
+#}
+{% set _sflow_ports = [] %}
+{% for intf in interfaces|default([]) %}
+{%   set _phy = intf.ifname.split('.')[0] %}
+{%   if _phy not in _sflow_ports and not _phy.startswith('fxp') and not _phy.startswith('em') and not _phy.startswith('irb') %}
+{%     set _ = _sflow_ports.append(_phy) %}
+{%   endif %}
+{% endfor %}
+{% if services.flow.protocol|default('') == 'sflow'
+      and services.flow._server_list is defined and _sflow_ports %}
+protocols {
+  sflow {
+    polling-interval 20;
+{%   if services.flow.sampling is defined %}
+{#
+  1-in-N. Unsampled export from a traffic generator's own load is a denial of
+  service against the collector, so sampling is not the optional nicety it looks.
+#}
+    sample-rate {
+      ingress {{ services.flow.sampling }};
+    }
+{%   endif %}
+{%   for _flow_host in services.flow._server_list[:2] %}
+    collector {{ _flow_host }} {
+      udp-port {{ services.flow.port|default(6343) }};
+    }
+{%   endfor %}
+{%   for _sflow_port in _sflow_ports %}
+    interfaces {{ _sflow_port }};
+{%   endfor %}
+  }
+}
+{% endif %}
