diff --git a/netsim/modules/services.py b/netsim/modules/services.py
index e2f2d7b..d6945e0 100644
--- a/netsim/modules/services.py
+++ b/netsim/modules/services.py
@@ -80,6 +80,97 @@ def check_feature_support(ndata: Box, svc_data: Box, topology: Box, mod_attr: Bo
         attribute=f'services.server.{kw}',
         check_mode=devices.FC_MODE.BLACKLIST)
 
+# Which protocol to pick when a node was given a flow client but no protocol.
+# IPFIX first because it is the standard and our collector's NetFlow listener
+# decodes it; netflow-v9 next for devices that predate IPFIX export; sFlow last
+# because it is a sampling protocol, not a flow record -- prefer the device that
+# can tell us what it actually forwarded.
+FLOW_PROTOCOL_PREFERENCE = ['ipfix','netflow','sflow']
+
+def device_flow_protocols(ndata: Box, topology: Box) -> list:
+  """Which flow protocols this node's device declares, in preference order."""
+  features = devices.get_device_features(ndata,topology.defaults)
+  offered = features.get('services',{}).get('flow',{}) or {}
+  return [p for p in FLOW_PROTOCOL_PREFERENCE if offered.get(p,False)]
+
+def resolve_flow_protocol(ndata: Box, topology: Box) -> None:
+  """Pick the protocol from the DEVICE when the topology did not name one.
+
+  The type of flow export is device-dependent and most platforms speak one of
+  the three. Forcing a single protocol across a mixed fleet either refuses the
+  topology or, worse, renders nothing and looks configured. Absence of
+  `protocol` therefore means "whatever this device speaks", which is exactly
+  what a fleet-wide block wants to say and cannot otherwise express.
+
+  An EXPLICIT protocol is left alone in every case, including an unsupported
+  one: check_flow_protocol still refuses it, so an author who names a protocol
+  their device cannot speak hears about it rather than silently getting another.
+
+  The port follows the protocol. `services.flow.ports` is the collector's
+  listener map; the resolved protocol selects its entry. An explicit `port`
+  wins, and the map is consumed here so no device template has to know it
+  exists.
+  """
+  flow = ndata.get('services.flow',None)
+  if not flow:
+    return
+
+  if not flow.get('protocol',None):
+    speaks = device_flow_protocols(ndata,topology)
+    if speaks:
+      flow.protocol = speaks[0]
+
+  proto = flow.get('protocol',None)
+  ports = flow.get('ports',None)
+  if proto and ports and not flow.get('port',None):
+    mapped = ports.get(proto,None)
+    if mapped:
+      flow.port = mapped
+  if ports is not None:
+    flow.pop('ports',None)
+
+def check_flow_protocol(ndata: Box, svc_data: Box, topology: Box) -> None:
+  """
+  Refuse a flow protocol the device does not speak.
+
+  WITHOUT THIS THE PROTOCOL SPLIT IS DECORATION. check_feature_support above
+  asks "does this device support the flow CLIENT", which is one bit -- it
+  cannot tell sFlow from NetFlow. Measured before this existed: a topology
+  asking for `protocol: netflow` against cEOS, which speaks only sFlow,
+  compiled CLEAN and rendered nothing. The device looked configured and
+  exported nothing, which is the exact failure this feature is meant to prevent
+  -- a lab that certifies green while its data plane is unobserved.
+
+  The split is not pedantry. Juniper divides by platform: sFlow on the switch,
+  inline IPFIX on the router. One flat `flow: True` capability would render
+  nothing on half the fleet and say so nowhere.
+  """
+  proto = ndata.get('services.flow.protocol',None)
+  if not proto:
+    return
+
+  features = devices.get_device_features(ndata,topology.defaults)
+  supported = features.get('services',{}).get(f'flow.{proto}',False)
+  if supported:
+    return
+
+  # Dotted feature keys are NESTED by the time they reach here -- the device
+  # file writes `flow.sflow: True` but get_device_features returns a Box where
+  # that is services.flow.sflow. Iterating the top level and matching on a
+  # 'flow.' prefix finds nothing, which is why the first cut of this message
+  # told the operator the device "exports no flow protocol" while it was
+  # happily exporting sFlow. A diagnostic that misdescribes the thing it is
+  # diagnosing sends the reader somewhere else entirely.
+  flow_features = features.get('services',{}).get('flow',{}) or {}
+  offered = sorted(
+    name for name,enabled in flow_features.items()
+    if enabled and name != 'sampling')
+  log.error(
+    f'Device {ndata.device} (node {ndata.name}) does not support flow protocol {proto}'
+    + (f' -- it speaks {", ".join(offered)}' if offered else ' -- it exports no flow protocol'),
+    category=log.IncorrectValue,
+    module='services')
+
 def print_client_server_errors(svc_cache: Box, mod_attr: Box) -> None:
   for kw in mod_attr.clients:
     for srv_name,srv_data in svc_cache.items():
@@ -105,6 +196,37 @@ def check_vrf(ndata: Box,mod_attr: Box) -> None:
         category=log.MissingDependency,
         module='services')
 
+# MANAGEMENT-VRF TRANSPORT (Skyforge extension). Upstream `transport_vrf` must
+# name a LAB VRF -- check_vrf() refuses anything else -- but a collector that
+# lives outside the lab (Skyforge's syslog and flow receivers) is reached over
+# the MANAGEMENT interface, whose VRF is a device property (the netlab_mgmt_vrf
+# group variable), not a lab VRF, and differs per device across one fleet.
+# `transport_vrf: mgmt` therefore means "whatever this device calls its
+# management VRF": it is set aside before check_vrf() and put back afterwards as
+# the device's own VRF name, so upstream's templates render it unchanged. A
+# device whose management interface sits in the global table simply gets no VRF.
+# A real lab VRF that happens to be called `mgmt` wins.
+MGMT_TRANSPORT = 'mgmt'
+
+def take_mgmt_transport(ndata: Box, mod_attr: Box) -> None:
+  for kw in mod_attr.clients:
+    cdata = ndata.get(f'services.{kw}',None)
+    if not isinstance(cdata,Box) or cdata.get('transport_vrf',None) != MGMT_TRANSPORT:
+      continue
+    if MGMT_TRANSPORT in ndata.get('vrfs',{}):
+      continue
+    cdata.pop('transport_vrf')
+    cdata._mgmt = True                            # templates: source from the management interface
+
+def set_mgmt_transport(ndata: Box, topology: Box, mod_attr: Box) -> None:
+  mgmt_vrf = devices.get_node_group_var(ndata,'netlab_mgmt_vrf',topology.defaults)
+  if not isinstance(mgmt_vrf,str) or not mgmt_vrf:
+    return
+  for kw in mod_attr.clients:
+    cdata = ndata.get(f'services.{kw}',None)
+    if isinstance(cdata,Box) and cdata.get('_mgmt',False):
+      cdata.transport_vrf = mgmt_vrf
+
 def set_dns_fields(ndata: Box) -> None:
   """
   Set DNS-related extra fields to simplify configuration templates:
@@ -155,6 +277,13 @@ class Services(_Module):
       set_dns_fields(ndata)
       disable_shared_hosts(ndata)
       check_feature_support(ndata,svc_data,topology,mod_attr)
+      # Resolve BEFORE the check: a node that named no protocol takes its
+      # device's, and check_flow_protocol then judges the resolved value -- so
+      # the resolution can never hand a template something the device refuses.
+      resolve_flow_protocol(ndata,topology)
+      check_flow_protocol(ndata,svc_data,topology)
+      take_mgmt_transport(ndata,mod_attr)
       check_vrf(ndata,mod_attr)
+      set_mgmt_transport(ndata,topology,mod_attr)
 
     print_client_server_errors(svc_cache,mod_attr)
diff --git a/netsim/modules/services.yml b/netsim/modules/services.yml
index 98edf46..e605491 100644
--- a/netsim/modules/services.yml
+++ b/netsim/modules/services.yml
@@ -26,9 +26,56 @@ attributes:
         type: list
         _subtype: { type: ipv6, use: address }
       transport_vrf: id
+    # FLOW EXPORT (NetFlow / IPFIX / sFlow). A CLIENT, exactly like syslog: the
+    # device dials a collector. An SNMP agent is a server because it listens and
+    # an NMS dials IT -- putting an exporter under `server` would be that
+    # mistake mirrored, and would lose resolve_servers(), which is the whole
+    # reason the client half exists.
+    #
+    # WHY THIS EXISTS AT ALL: monitoring collects over the management interface,
+    # so a completely dead data plane certifies green today. A flow record comes
+    # from the NOS and says the DEVICE forwarded these packets -- evidence about
+    # the fabric, made by the fabric, which no counter on a traffic generator
+    # can provide about itself.
+    flow:
+      server: { type: list, _subtype: node_id }
+      ipv4:
+        type: list
+        _subtype: { type: ipv4, use: address }
+      ipv6:
+        type: list
+        _subtype: { type: ipv6, use: address }
+      # Which wire protocol to speak. The per-device feature flags below gate
+      # this: a device declaring only sflow refuses `protocol: netflow` rather
+      # than rendering nothing and looking configured.
+      protocol: { type: str, valid_values: [ netflow, ipfix, sflow ] }
+      port: { type: int, min_value: 1, max_value: 65535 }
+      # 1-in-N. Sampling is not optional at lab scale in the way it looks:
+      # unsampled export from a traffic generator's own load is a denial of
+      # service against the collector.
+      sampling: { type: int, min_value: 1 }
+      # PER-PROTOCOL LISTENER PORTS. Which protocol a device can speak is a
+      # property of the DEVICE -- IOS has no sFlow at all (measured: `show
+      # sflow` is "% Invalid input" on IOL, while `show flow record` lists the
+      # full Flexible NetFlow set), cEOS has no ASIC for `flow tracking
+      # hardware` and so speaks only sFlow. Which port to dial is a property of
+      # the COLLECTOR. A deployer that can inject only one `protocol` and one
+      # `port` can therefore serve a single-NOS fleet and no other: measured
+      # 2026-09-11, injecting `protocol: sflow` fleet-wide onto demo-lab made
+      # `netlab create` FAIL on all 22 IOL nodes rather than export anything.
+      # Declare the listener map once; each node takes the entry for whichever
+      # protocol it resolved to. An explicit `port` still wins over the map.
+      ports:
+        type: dict
+        _keys:
+          netflow: { type: int, min_value: 1, max_value: 65535 }
+          ipfix: { type: int, min_value: 1, max_value: 65535 }
+          sflow: { type: int, min_value: 1, max_value: 65535 }
+      transport_vrf: id
   node:
     dns: { copy: global }
     syslog: { copy: global }
+    flow: { copy: global }
     server:
       dns:
         type: dict
@@ -82,9 +129,20 @@ attributes:
       ignore: []
       must_have: [ server, ipv4, ipv6 ]
       check_when: [ _server_list ]
+    flow:                                         # Skyforge: flow export (NetFlow/IPFIX/sFlow) client
+      ignore: []
+      must_have: [ server, ipv4, ipv6 ]
+      check_when: [ _server_list ]
 features:
   dns: DNS client
   syslog: syslog client
+  # Split by PROTOCOL, not a flat `flow: True`. Juniper splits by platform --
+  # sFlow on the switch, inline IPFIX on the router -- so one capability flag
+  # would silently render nothing on half the fleet.
+  flow.sflow: sFlow export
+  flow.netflow: NetFlow v5/v9 export
+  flow.ipfix: IPFIX (NetFlow v10) export
+  flow.sampling: Configurable sampling rate
   server.dns: DNS server
   server.snmp: SNMP agent (responds to an NMS)
   server.gnmi: gNMI/gRPC telemetry endpoint
diff --git a/tests/test_services_flow.py b/tests/test_services_flow.py
new file mode 100644
index 0000000..aaac033
--- /dev/null
+++ b/tests/test_services_flow.py
@@ -0,0 +1,87 @@
+"""The flow protocol is the DEVICE's to choose, and a platform default degrades.
+
+Both behaviours were added because the alternative was measured and was worse
+than doing nothing: injecting one `protocol` fleet-wide made `netlab create`
+exit 1 on every node whose NOS did not speak it, which is why flow export had
+never run outside a pure-cEOS lab.
+
+These tests drive the real module functions against real device definitions --
+`iol` genuinely declares netflow/ipfix and no sflow, `eos` genuinely declares
+sflow only -- so they fail if either declaration is changed out from under the
+resolution logic, which a mock would not catch.
+"""
+import pytest
+
+from box import Box
+
+from netsim.modules import services
+from netsim.utils import strings          # noqa: F401  (import side effects)
+from netsim import data
+
+
+def _topology() -> Box:
+    from netsim.augment import devices as _d      # noqa: F401
+    from netsim.utils import read as _read
+    topo = _read.read_yaml('package:topology-defaults.yml')
+    return Box({'defaults': topo}, default_box=True, box_dots=True)
+
+
+def _node(name: str, device: str, **svc) -> Box:
+    n = Box({'name': name, 'device': device}, default_box=True, box_dots=True)
+    if svc:
+        n.services = Box(svc, default_box=True, box_dots=True)
+    return n
+
+
+def test_iol_speaks_netflow_and_ipfix_but_never_sflow():
+    """The split is the whole point: measured on a live IOL, `show sflow` is
+    '% Invalid input detected' while `show flow record` lists the full built-in
+    Flexible NetFlow set."""
+    topo = _topology()
+    assert services.device_flow_protocols(_node('r1', 'iol'), topo) == ['ipfix', 'netflow']
+    assert services.device_flow_protocols(_node('r2', 'eos'), topo) == ['sflow']
+    # A device that declares nothing offers nothing -- not a default.
+    assert services.device_flow_protocols(_node('r3', 'linux'), topo) == []
+
+
+def test_absent_protocol_resolves_to_what_the_device_speaks():
+    topo = _topology()
+    n = _node('r1', 'iol', flow={'ipv4': ['10.0.0.1'], 'ports': {'ipfix': 2055, 'sflow': 6343}})
+    services.resolve_flow_protocol(n, topo)
+    assert n.services.flow.protocol == 'ipfix'
+    # The port FOLLOWS the protocol, and the map is consumed so no device
+    # template has to know it existed.
+    assert n.services.flow.port == 2055
+    assert 'ports' not in n.services.flow
+
+    e = _node('r2', 'eos', flow={'ipv4': ['10.0.0.1'], 'ports': {'ipfix': 2055, 'sflow': 6343}})
+    services.resolve_flow_protocol(e, topo)
+    assert e.services.flow.protocol == 'sflow'
+    assert e.services.flow.port == 6343
+
+
+def test_an_explicit_protocol_is_never_substituted():
+    """Including an unsupported one. check_flow_protocol must still get the
+    chance to refuse it -- an author who names a protocol their device cannot
+    speak has to hear so, not silently receive a different one."""
+    topo = _topology()
+    n = _node('r1', 'iol', flow={'ipv4': ['10.0.0.1'], 'protocol': 'sflow',
+                                 'ports': {'ipfix': 2055, 'sflow': 6343}})
+    services.resolve_flow_protocol(n, topo)
+    assert n.services.flow.protocol == 'sflow'
+    assert n.services.flow.port == 6343
+
+
+def test_an_explicit_port_beats_the_listener_map():
+    topo = _topology()
+    n = _node('r1', 'iol', flow={'ipv4': ['10.0.0.1'], 'port': 9995,
+                                 'ports': {'ipfix': 2055}})
+    services.resolve_flow_protocol(n, topo)
+    assert n.services.flow.port == 9995
+
+
+def test_a_device_that_exports_nothing_gets_no_protocol():
+    topo = _topology()
+    n = _node('r1', 'linux', flow={'ipv4': ['10.0.0.1'], 'ports': {'ipfix': 2055}})
+    services.resolve_flow_protocol(n, topo)
+    assert 'protocol' not in n.services.flow
