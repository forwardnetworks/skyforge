@@ -0,0 +1,324 @@
+"""Flow export and syslog beyond the IOS routers: IOL-L2, vJunos and the ASA.
+
+Patch 0064 made the protocol a property of the device and gave the IOS ROUTERS
+a client. What it left behind was measured on demo-lab: 17 of 77 nodes are
+`ioll2`, which inherits `features.services` from `parent: iol` -- so it had
+DECLARED ipfix/netflow and passed every capability check while
+services/ioll2.j2 had no flow block at all. A declaration without a template is
+the failure this whole feature exists to prevent, wearing the costume of a
+pass.
+
+These tests drive the real module functions and render the real templates
+against the real device definitions, so they go red if either side is changed
+out from under the other -- which is exactly the drift a mock cannot see.
+
+The L2 rule is the one worth the most here: `ip flow monitor` is an L3
+interface command and an access/trunk port refuses it. Measured on live demo-lab
+2026-09-11, jfk-acc-sw01 has three ROUTED ports and dc-sdwan-sw01 has six
+`switchport access vlan 1000` ports and an address-less SVI, so one of them
+must render the monitor and the other must render NOTHING.
+"""
+import re
+
+import pytest
+
+from box import Box
+
+from netsim.modules import services
+from netsim.augment import devices as _devices
+from netsim.utils import log, templates
+from netsim.utils import read as _read
+
+
+SERVICES_TEMPLATE_PATH = 'ansible/templates/services'
+
+
+@pytest.fixture
+def topo() -> Box:
+    """topology-defaults WITH device inheritance processed.
+
+    Without process_device_inheritance, `ioll2` reports only server.snmp and
+    the single most important fact in this file -- that it inherits iol's flow
+    declaration -- is invisible. That is precisely how the gap survived 0064.
+    """
+    t = Box({'defaults': _read.read_yaml('package:topology-defaults.yml')},
+            default_box=True, box_dots=True)
+    _devices.process_device_inheritance(t)
+    return t
+
+
+def _node(name: str, device: str, **svc) -> Box:
+    n = Box({'name': name, 'device': device}, default_box=True, box_dots=True)
+    if svc:
+        n.services = Box(svc, default_box=True, box_dots=True)
+    return n
+
+
+def _render(device_template: str, **data) -> str:
+    return templates.render_template(
+        data=Box(data, default_box=True, box_dots=True).to_dict(),
+        j2_file=f'{device_template}.j2',
+        path=SERVICES_TEMPLATE_PATH)
+
+
+# ---------------------------------------------------------------- declarations
+
+def test_ioll2_inherits_the_iol_flow_declaration(topo):
+    """The fact that hid the gap. ioll2 redefines features.services with only
+    server.snmp, and the parent's syslog/flow survive the merge -- so every
+    capability check passed and 17 nodes rendered nothing."""
+    assert services.device_flow_protocols(_node('s1', 'ioll2'), topo) == ['ipfix', 'netflow']
+    assert services.device_flow_protocols(_node('r1', 'iol'), topo) == ['ipfix', 'netflow']
+    ioll2 = _devices.get_device_features(_node('s1', 'ioll2'), topo.defaults)
+    assert ioll2.services.syslog is True
+    assert ioll2.services.server.snmp is True       # ... and its own declaration is not lost
+
+
+@pytest.mark.parametrize('device,speaks', [
+    ('asav',           ['netflow']),
+    ('vjunos-router',  ['sflow']),
+    ('vjunos-switch',  ['sflow']),
+])
+def test_the_firewall_and_the_junipers_declare_what_was_probed(topo, device, speaks):
+    """asav: `show flow-export counters` answers empty where `show flarble
+    wibble` errors, and there is no IPFIX export and no `show sflow` at all.
+    vjunos-*: both images report Model: vmx, and the sFlow block is the one
+    `commit check` accepted on cdg-cor-sw01."""
+    assert services.device_flow_protocols(_node('n1', device), topo) == speaks
+
+
+def test_the_asa_is_not_given_a_sampler_it_does_not_have(topo):
+    """NSEL exports connection EVENTS, not sampled packets. Declaring
+    flow.sampling would make the module believe a sampler exists; leaving it
+    undeclared makes check_optional_features skip the injected value in
+    blacklist mode instead of honouring it."""
+    asa = _devices.get_device_features(_node('f1', 'asav'), topo.defaults)
+    assert 'sampling' not in asa.services.flow
+    assert _devices.get_device_features(_node('s1', 'ioll2'), topo.defaults).services.flow.sampling is True
+    assert _devices.get_device_features(_node('j1', 'vjunos-router'), topo.defaults).services.flow.sampling is True
+
+
+# ------------------------------------------------------------------ resolution
+
+@pytest.mark.parametrize('device,proto,port', [
+    ('ioll2',          'ipfix',   2055),
+    ('asav',           'netflow', 2055),
+    ('vjunos-router',  'sflow',   6343),
+    ('vjunos-switch',  'sflow',   6343),
+])
+def test_each_new_platform_takes_its_own_listener_port(topo, device, proto, port):
+    n = _node('n1', device, flow={'ipv4': ['198.19.255.53'],
+                                  'ports': {'ipfix': 2055, 'netflow': 2055, 'sflow': 6343}})
+    services.resolve_flow_protocol(n, topo)
+    assert n.services.flow.protocol == proto
+    assert n.services.flow.port == port
+
+
+def test_an_explicit_protocol_the_firewall_cannot_speak_is_still_refused(topo):
+    """0064's refusal must survive every new declaration. An author who asks an
+    ASA for sFlow has said something false about their lab."""
+    log.init_log_system(header=False)
+    n = _node('f1', 'asav', flow={'ipv4': ['198.19.255.53'], 'protocol': 'sflow'})
+    services.check_flow_protocol(n, n.services, topo)
+    errors = '\n'.join(log.get_error_log())
+    assert 'does not support flow protocol sflow' in errors
+    assert 'it speaks netflow' in errors
+    log.init_log_system(header=False)
+
+
+# -------------------------------------------------------------------- IOL-L2
+
+_L2_ONLY = [
+    {'ifname': 'Ethernet0/1', 'type': 'lan', 'vlan': {'access': 'sdwan_ctrl', 'access_id': 1000}},
+    {'ifname': 'Ethernet0/2', 'type': 'lan', 'vlan': {'access': 'sdwan_ctrl', 'access_id': 1000}},
+    {'ifname': 'Vlan1000', 'type': 'svi', 'virtual_interface': True,
+     'vlan': {'mode': 'bridge', 'name': 'sdwan_ctrl'}},
+]
+
+_ROUTED = [
+    {'ifname': 'Ethernet0/1', 'type': 'p2p', 'ipv4': '10.1.0.1/30'},
+    {'ifname': 'Ethernet0/2', 'type': 'p2p', 'ipv4': '10.1.0.5/30'},
+    {'ifname': 'Ethernet0/3', 'type': 'lan', 'ipv4': '172.16.1.15/24'},
+]
+
+# ioll2 has no services/ioll2.j2 of its own: paths.t_files falls through
+# netlab_device_type to ansible_network_os, so it renders upstream's
+# services/ios.j2, which carries the flow block for every IOS device.
+IOLL2_TEMPLATE = 'ios'
+
+
+def test_ioll2_renders_the_ios_services_template(topo):
+    """If someone adds services/ioll2.j2 it shadows ios.j2 and drops upstream's
+    syslog/DNS for 17 demo-lab nodes -- the tests below would then be rendering
+    a template ioll2 no longer uses."""
+    import pathlib
+    import netsim
+    tdir = pathlib.Path(netsim.__file__).parent / SERVICES_TEMPLATE_PATH
+    assert not (tdir / 'ioll2.j2').exists()
+    assert (tdir / f'{IOLL2_TEMPLATE}.j2').exists()
+    assert topo.defaults.devices.ioll2.group_vars.ansible_network_os == IOLL2_TEMPLATE
+
+
+_FLOW = {'protocol': 'ipfix', 'port': 2055, 'sampling': 1000,
+         '_server_list': ['198.19.255.53']}
+_SYSLOG = {'_server_list': ['198.19.255.54']}
+
+
+def test_an_ioll2_switchport_never_gets_a_flow_monitor():
+    """dc-sdwan-sw01 in one test. Six access ports and an address-less SVI:
+    `ip flow monitor` would be refused on every one of them, so the whole block
+    -- record, exporter, monitor -- must be absent rather than present and
+    attached to nothing."""
+    out = _render(IOLL2_TEMPLATE,
+                  services={'flow': _FLOW, 'syslog': _SYSLOG, 'server': {'snmp': {}}},
+                  interfaces=_L2_ONLY,
+                  mgmt={'ifname': 'Ethernet0/0'})
+    assert 'ip flow monitor' not in out
+    assert 'flow monitor skyforge' not in out
+    assert 'flow exporter' not in out
+    assert 'flow record' not in out
+    # ... and the node is not left unobserved: syslog and SNMP still render.
+    assert 'logging host 198.19.255.54' in out
+    assert 'snmp-server community skyforge RO' in out
+
+
+def test_an_ioll2_routed_port_gets_one_and_management_does_not():
+    out = _render(IOLL2_TEMPLATE,
+                  services={'flow': _FLOW, 'syslog': _SYSLOG, 'server': {'snmp': {}}},
+                  interfaces=_ROUTED,
+                  mgmt={'ifname': 'Ethernet0/0'})
+    assert out.count(' ip flow monitor skyforge sampler skyforge input') == 3
+    for ifname in ('Ethernet0/1', 'Ethernet0/2', 'Ethernet0/3'):
+        assert f'interface {ifname}\n' in out
+    assert '\ninterface Ethernet0/0\n' not in out        # management is not a witness to itself
+    assert 'export-protocol ipfix' in out
+    assert 'source Ethernet0/0' in out                   # ... but it IS the source
+    assert 'sampler skyforge' in out
+
+
+def test_an_ioll2_with_a_mix_takes_only_the_routed_half():
+    out = _render(IOLL2_TEMPLATE,
+                  services={'flow': _FLOW, 'syslog': _SYSLOG, 'server': {'snmp': {}}},
+                  interfaces=_L2_ONLY + _ROUTED[:1] + [
+                      {'ifname': 'Vlan200', 'type': 'svi', 'ipv4': '10.9.0.1/24'}],
+                  mgmt={'ifname': 'Ethernet0/0'})
+    assert out.count(' ip flow monitor') == 2
+    assert 'interface Vlan200\n' in out                  # an ADDRESSED SVI is routed
+    assert 'interface Vlan1000\n' not in out             # an address-less one is not
+    assert 'interface Ethernet0/2\n' not in out          # and an access port never is
+
+
+# -------------------------------------------------------------------- vJunos
+
+@pytest.mark.parametrize('device_template', ['vjunos-router', 'vjunos-switch'])
+def test_the_junos_block_is_the_one_that_passed_commit_check(device_template):
+    """Every statement here was accepted by `commit check` on the live
+    cdg-cor-sw01 inside `configure private`, and rolled back to an empty
+    `show | compare`. Both images are the same vMX, so both render the same."""
+    out = _render(device_template,
+                  services={'flow': {'protocol': 'sflow', 'port': 6343, 'sampling': 1000,
+                                     '_server_list': ['198.19.255.53']},
+                            'syslog': {'_server_list': ['198.19.255.54']},
+                            'server': {'snmp': {}}},
+                  interfaces=[{'ifname': 'ge-0/0/0.0'}, {'ifname': 'ge-0/0/1.0'},
+                              {'ifname': 'ge-0/0/1.100'}, {'ifname': 'fxp0.0'}])
+    assert 'collector 198.19.255.53 {' in out
+    assert 'udp-port 6343;' in out
+    assert 'ingress 1000;' in out
+    assert 'polling-interval 20;' in out
+    # PHYSICAL ports, de-duplicated -- two units of ge-0/0/1 are one interface.
+    assert out.count('    interfaces ') == 2
+    assert 'interfaces ge-0/0/0;' in out
+    assert 'interfaces ge-0/0/1;' in out
+    assert 'ge-0/0/1.100' not in out
+    assert 'fxp0' not in out
+    # NO address netlab invented for a management interface KNE actually
+    # addresses: the live cdg-cor-sw01 answers 10.0.2.2 on fxp0, not the
+    # 172.20.20.x mgmt.ipv4 in host_vars.
+    assert 'source-ip' not in out
+    assert 'agent-id' not in out
+    assert 'source-address' not in out
+    # Syslog is hierarchical, like every other Junos fragment -- a `set` line
+    # here makes mgd reject the whole file.
+    assert 'host "198.19.255.54" {' in out
+    assert not any(line.startswith('set ') for line in out.splitlines())
+
+
+def test_a_junos_node_with_no_data_interface_renders_no_sflow():
+    out = _render('vjunos-router',
+                  services={'flow': {'protocol': 'sflow', 'port': 6343,
+                                     '_server_list': ['198.19.255.53']},
+                            'syslog': {'_server_list': ['198.19.255.54']}},
+                  interfaces=[{'ifname': 'fxp0.0'}])
+    assert 'sflow' not in out
+    assert 'host "198.19.255.54" {' in out
+
+
+# ----------------------------------------------------------------------- ASA
+
+@pytest.mark.parametrize('device_template', ['asa', 'asav'])
+def test_the_asa_export_joins_the_policy_that_is_already_applied(device_template):
+    """An ASA permits exactly ONE global service-policy and cdg-fw01 already has
+    it: `show running-config service-policy` returns `service-policy
+    global_policy global`. A second one is refused, so the class joins the
+    existing policy instead."""
+    out = _render(device_template,
+                  services={'flow': {'protocol': 'netflow', 'port': 2055,
+                                     '_server_list': ['198.19.255.53']},
+                            'syslog': {'_server_list': ['198.19.255.54']},
+                            'server': {'snmp': {}}},
+                  interfaces=[{'ifname': 'GigabitEthernet0/0', 'ipv4': '10.1.0.146/30'}],
+                  mgmt={'ifname': 'Management0/0'})
+    assert 'policy-map global_policy' in out
+    assert 'service-policy' not in out
+    assert 'flow-export event-type all destination 198.19.255.53' in out
+    # The NAME of the management interface, never the interface itself: the ASA
+    # writes destinations in terms of nameif, and netlab's own asav day-0 sets
+    # `nameif management` on Management0/0.
+    assert 'flow-export destination management 198.19.255.53 2055' in out
+    assert 'logging host management 198.19.255.54' in out
+    assert 'Management0/0' not in out
+    # NSEL has no sampler, so nothing here may pretend to configure one.
+    assert 'sampler' not in out
+    assert 'logging enable' in out
+
+
+def test_the_asa_renders_nothing_new_when_no_collector_is_given():
+    """A cluster with no collector deployed must render no client block at all.
+    The SNMP agent is unaffected -- it is a server, and it was already there."""
+    out = _render('asav', services={'server': {'snmp': {}}},
+                  interfaces=[{'ifname': 'GigabitEthernet0/0'}],
+                  mgmt={'ifname': 'Management0/0'})
+    assert 'flow-export' not in out
+    assert 'logging' not in out
+    assert out.strip() == 'snmp-server community skyforge'
+
+
+# ------------------------------------------------------------ SD-WAN edges
+
+def test_a_controller_mode_edge_gets_no_flow_block_in_its_day0():
+    """vManage owns a controller-mode cEdge's configuration, and a day-0 the
+    appliance rejects costs the whole SD-WAN bootstrap. The same node without
+    the sdwan module is the control: it exports."""
+    data = dict(services={'flow': _FLOW, 'syslog': _SYSLOG, 'server': {'snmp': {}}},
+                interfaces=_ROUTED, mgmt={'ifname': 'GigabitEthernet1'})
+    plain = _render(IOLL2_TEMPLATE, **data)
+    edge = _render(IOLL2_TEMPLATE, module=['sdwan', 'services'], **data)
+    assert 'flow exporter skyforge-1' in plain
+    assert 'flow exporter' not in edge
+    assert 'ip flow monitor' not in edge
+    assert 'logging host' in edge                          # syslog still goes
+
+
+# ------------------------------------------------------ Junos include join
+
+@pytest.mark.parametrize('device_template', ['vjunos-router', 'vjunos-switch', 'vmx', 'vptx', 'vsrx'])
+def test_the_upstream_junos_fragment_does_not_run_into_the_next_stanza(device_template):
+    """The upstream services default `dns.domain: netlab.local` makes junos.j2
+    end in `system { ... }`; with trim_blocks the include ate the newline and
+    the next stanza started on the closing-brace line (`}snmp {`)."""
+    out = _render(device_template,
+                  services={'dns': {'domain': 'netlab.local'}, 'server': {'snmp': {}}})
+    assert 'domain-name netlab.local;' in out
+    assert 'snmp {' in out
+    assert not re.search(r'\}[^\s}]', out), out
