diff --git a/netsim/extra/tunnel/dmvpn/__init__.py b/netsim/extra/tunnel/dmvpn/__init__.py
new file mode 100644
index 0000000..194fd5c
--- /dev/null
+++ b/netsim/extra/tunnel/dmvpn/__init__.py
@@ -0,0 +1,145 @@
+from box import Box
+
+from netsim import api
+from netsim.utils import log
+
+from ... import tunnel as _tunnel
+
+_config_name = 'tunnel.dmvpn'
+
+'''
+tunnel.dmvpn -- multipoint GRE with NHRP.
+
+extra/tunnel/gre is POINT-TO-POINT: it insists on exactly two nodes per link and
+gives each end a `tunnel destination`. A DMVPN cloud is neither. One link
+carries a hub (or several) and any number of spokes, and no interface has a
+tunnel destination at all -- NHRP resolves the far end at run time. So this
+plugin uses tunnel's shared source handling but not _p2p.
+
+  links:
+  - clc-r34: { ipv4: 10.10.10.1 }        # hub
+    clc-r29: { ipv4: 10.10.10.2 }        # spoke
+    clc-r32: { ipv4: 10.10.10.3 }        # spoke
+    prefix: { ipv4: 10.10.10.0/24 }
+    tunnel: { mode: dmvpn, hub: [ clc-r34 ] }
+
+Each interface is marked `_dmvpn_role` hub or spoke, and every spoke is given
+`_dmvpn_nhs`, the list of hub tunnel addresses plus the hubs' transport
+addresses, because `ip nhrp map` needs BOTH: the overlay address to map and the
+underlay address to send to.
+
+DEVICE SUPPORT IS IOS-FAMILY ONLY, AND THAT IS A VENDOR FACT, NOT A GAP HERE.
+DMVPN is NHRP plus mGRE as Cisco implements it; IOS-XR does not implement DMVPN
+and neither does EOS or NX-OS. A device that cannot do it is REPORTED, not
+silently skipped, so a topology that puts a DMVPN spoke on the wrong platform
+fails at compile instead of coming up with an overlay that never forms.
+'''
+
+def _hub_list(link: Box) -> list:
+  """
+  tunnel.hub as a LIST, whatever it arrived as.
+
+  A single-hub cloud is written `hub: [ clc-r34 ]` and can reach here as the
+  bare string 'clc-r34'. Iterating that yields its CHARACTERS, and the plugin
+  then reports one error per letter -- "names hub c", "names hub l" ... which
+  is what it did before this existed.
+  """
+  hubs = link.get('tunnel.hub',None)
+  if hubs is None:
+    return []
+  if isinstance(hubs,str):
+    return [ hubs ]
+  return list(hubs)
+
+def pre_transform(topology: Box) -> None:
+  _tunnel.set_tunnel_type(topology)
+  for link in _tunnel.links(topology,'dmvpn'):
+    if len(link.interfaces) < 2:
+      log.error(
+        f'A DMVPN cloud needs at least two nodes attached (link {link._linkname})',
+        category=log.IncorrectAttr,
+        module='tunnel.dmvpn')
+      continue
+
+    hubs = _hub_list(link)
+    if not hubs:
+      log.error(
+        f'DMVPN link {link._linkname} declares no tunnel.hub\n' + \
+        f'... Name at least one attached node as the NHRP next-hop server',
+        category=log.IncorrectAttr,
+        module='tunnel.dmvpn')
+      continue
+
+    attached = [ intf.node for intf in link.interfaces ]
+    for h in hubs:
+      if h not in attached:
+        log.error(
+          f'DMVPN link {link._linkname} names hub {h}, which is not attached to it\n' + \
+          f'... Attached nodes are: {", ".join(attached)}',
+          category=log.IncorrectAttr,
+          module='tunnel.dmvpn')
+
+def post_transform(topology: Box) -> None:
+  for link in _tunnel.links(topology,'dmvpn'):
+    hubs   = _hub_list(link)
+    lidx   = link.get('linkindex',None)
+    net_id = link.get('tunnel.nhrp_id',None) or lidx or 1
+    t_af   = link.get('tunnel.af','ipv4')
+    passwd = link.get('tunnel.password',None)
+
+    # MATCH ON THE LINK'S linkindex, NOT THE LINK-INTERFACE'S.
+    #
+    # A link's own `interfaces` entries carry linkindex None; it is the NODE's
+    # interface that carries the link's index. Comparing the two never matched,
+    # so roles were never assigned and the plugin's template was never
+    # registered -- the config simply did not appear, with no error to say so.
+    def node_tunnel_intf(node_name: str):
+      for ni in topology.nodes[node_name].get('interfaces',[]):
+        if ni.get('linkindex',None) == lidx and ni.get('tunnel',None):
+          return ni
+      return None
+
+    # PASS 1 -- resolve every tunnel source on this cloud first.
+    #
+    # A spoke's `ip nhrp map` needs the hub's NBMA (underlay) address, which is
+    # the address of the hub's tunnel SOURCE interface. That is only known once
+    # set_tunnel_source has run for the hub, so sources have to be resolved for
+    # the whole link before any map can be built.
+    on_link = []
+    for intf in link.interfaces:
+      ndata = topology.nodes[intf.node]
+      if not _tunnel.check_feature(ndata,topology,f_name='dmvpn',f_desc='DMVPN tunnels'):
+        continue
+      ni = node_tunnel_intf(intf.node)
+      if ni is None:
+        continue
+      u_iflist = _tunnel.get_tunnel_source(ndata,ni,topology)
+      if u_iflist:
+        _tunnel.set_tunnel_source(ni,u_iflist,ndata,topology)
+      on_link.append((intf.node,ndata,ni))
+
+    # The hubs' overlay + NBMA addresses, which every other node has to map.
+    hub_map = []
+    for h_name,h_ndata,h_ni in on_link:
+      if h_name not in hubs:
+        continue
+      overlay = h_ni.get(t_af,None)
+      nbma    = h_ni.get(f'tunnel._source.{t_af}',None)
+      if not overlay:
+        continue
+      hub_map.append({
+        'node':    h_name,
+        'overlay': str(overlay).split('/')[0],
+        'nbma':    str(nbma).split('/')[0] if nbma else None })
+
+    # PASS 2 -- roles and NHRP data.
+    for n_name,ndata,ni in on_link:
+      ni.tunnel._dmvpn_role  = 'hub' if n_name in hubs else 'spoke'
+      ni.tunnel._dmvpn_netid = net_id
+      # Every node maps every OTHER hub. On a cloud with two hubs that is what
+      # makes them point at each other, which is how the workbook has it.
+      ni.tunnel._dmvpn_nhs   = [ h for h in hub_map if h['node'] != n_name ]
+      if passwd:
+        ni.tunnel._dmvpn_password = passwd
+
+      api.node_config(ndata,_config_name)
diff --git a/netsim/extra/tunnel/dmvpn/defaults.yml b/netsim/extra/tunnel/dmvpn/defaults.yml
new file mode 100644
index 0000000..ce78563
--- /dev/null
+++ b/netsim/extra/tunnel/dmvpn/defaults.yml
@@ -0,0 +1,39 @@
+# DMVPN (multipoint GRE + NHRP) tunnel attributes
+#
+# DMVPN is not point-to-point, so it does not use extra/tunnel/_p2p: a cloud has
+# one or more hubs and any number of spokes on ONE link, and there is no
+# `tunnel destination` at all -- NHRP resolves it.
+---
+providers:
+  clab:
+    kmods:
+      tunnel@dmvpn: [ ip_gre ]
+
+attributes:
+  link:
+    tunnel:
+      af:
+        { type: str, valid_values: [ ipv4, ipv6 ] }
+      mode:
+        _required: True
+        type: str
+        valid_values:
+          dmvpn:
+      hub:                    # Node name(s) acting as NHRP next-hop server.
+                              # A single hub may be written as a bare string.
+        type: list
+        _subtype: str
+        _alt_types: [ str ]
+      nhrp_id: int            # NHRP network-id; defaults to the link index
+      password: str           # NHRP authentication string
+      source:
+        type: dict
+        _keys:
+          ifindex: int
+          type:
+            { type: str, valid_values: [ loopback ] }
+          linkid: id
+          link:
+            name: str
+            role: id
+      vrf: str
diff --git a/netsim/extra/tunnel/dmvpn/ios.j2 b/netsim/extra/tunnel/dmvpn/ios.j2
new file mode 100644
index 0000000..175a487
--- /dev/null
+++ b/netsim/extra/tunnel/dmvpn/ios.j2
@@ -0,0 +1,45 @@
+{#
+  DMVPN on IOS/IOL: multipoint GRE plus NHRP, in the workbook's own form.
+
+  Hub:   ip nhrp map multicast dynamic          (learn spokes as they register)
+  Spoke: ip nhrp map <hub-overlay> <hub-nbma>   (reach the hub before NHRP works)
+         ip nhrp map multicast <hub-nbma>       (carry routing multicast to it)
+         ip nhrp nhs <hub-overlay>              (register with it)
+
+  No `tunnel destination` -- that is the point of mGRE.
+#}
+{% for intf in netlab_interfaces if intf.tunnel.mode|default('') == 'dmvpn' %}
+!
+interface {{ intf.ifname }}
+ tunnel mode gre multipoint
+{%   if intf.tunnel.vrf is defined %}
+ tunnel vrf {{ intf.tunnel.vrf }}
+{%   endif %}
+ tunnel source {{ intf.tunnel._source.ifname }}
+ ip nhrp network-id {{ intf.tunnel._dmvpn_netid|default(1) }}
+{%   if intf.tunnel._dmvpn_password is defined %}
+ ip nhrp authentication {{ intf.tunnel._dmvpn_password }}
+{%   endif %}
+{%   if intf.tunnel._dmvpn_role|default('spoke') == 'hub' %}
+ ip nhrp map multicast dynamic
+{#
+  ONE MULTIPOINT INTERFACE CARRIES EVERY SPOKE, so EIGRP split horizon on the
+  hub stops spoke A ever hearing spoke B: the update learned on Tunnel0 is
+  never sent back out Tunnel0. The workbook's hub carries `no ip split-horizon
+  eigrp <as>` for exactly this reason, and the demo-lab source hub (which lacked
+  it) never got spoke-to-spoke routes. Emitted on the HUB only, and only when
+  the node runs EIGRP on this tunnel -- OSPF point-to-multipoint has no such
+  rule. Measured 2026-09-12: the rendered demo-lab hub had none of it until this.
+#}
+{%     if eigrp.as is defined and intf.eigrp is defined %}
+ no ip split-horizon eigrp {{ eigrp.as }}
+{%     endif %}
+{%   endif %}
+{%   for nhs in intf.tunnel._dmvpn_nhs|default([]) %}
+{%     if nhs.nbma %}
+ ip nhrp map {{ nhs.overlay }} {{ nhs.nbma }}
+ ip nhrp map multicast {{ nhs.nbma }}
+{%     endif %}
+ ip nhrp nhs {{ nhs.overlay }}
+{%   endfor %}
+{% endfor %}
-- 
2.56.0

