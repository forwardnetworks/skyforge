diff --git a/netsim/extra/bgp/rr_group/__init__.py b/netsim/extra/bgp/rr_group/__init__.py
new file mode 100644
index 0000000..d6324bf
--- /dev/null
+++ b/netsim/extra/bgp/rr_group/__init__.py
@@ -0,0 +1,94 @@
+from box import Box
+
+from netsim.utils import log
+
+_requires    = [ 'bgp' ]
+
+'''
+bgp.rr_group -- prune IBGP sessions down to shared peering scopes.
+
+bgp.domain gives a node ONE domain and drops every cross-domain IBGP session.
+That cannot describe a route reflector which peers with its regional pair in
+one scope and with the core in another, while never peering with the other
+region at all. Written for the CCIE SP practice lab, whose Section 3.1
+solution has exactly that shape:
+
+  R1  -> R3, BB, R21..R24        R2  -> R4, BB, R25..R28, Internet
+  R3  -> R1, BB, R21..R24        R4  -> R2, BB, R25..R28, Internet
+  R21 -> R1, R3 only             R25 -> R2, R4 only
+
+with no R1<->R2 session anywhere and BB as the single transit reflector
+carrying no clients. R1 and R3 share `spda_a` and `core_a`; R1 and BB share
+`core_a`; R1 and R2 share nothing.
+
+SEMANTICS
+
+  * `rr_group` is a LIST of scope names on a node.
+  * An IBGP session is kept when the two ends share at least one scope.
+  * A session is dropped ONLY when BOTH ends declare rr_group and the two
+    lists are disjoint.
+
+The last rule is deliberate and conservative. A node with no rr_group is
+UNSCOPED, not "in an empty scope": every session it has behaves exactly as it
+does without this plugin. That keeps the plugin additive -- loading it changes
+nothing until scopes are declared -- and it keeps other autonomous systems in
+the same topology untouched, which matters because the lab has 11 BGP nodes
+outside the SP AS that carry no scopes at all.
+
+EBGP is never touched. Scoping applies to IBGP only, matching bgp.domain.
+'''
+
+def post_transform(topology: Box) -> None:
+  rr_as: dict = {}                                          # AS numbers that use route reflectors
+  group_rr: dict = {}                                       # (as,scope) -> does that scope hold a reflector?
+  group_seen: dict = {}                                     # (as,scope) -> is that scope used at all?
+
+  for n, ndata in topology.nodes.items():
+    if 'bgp' not in ndata.get('module',[]):                 # Skip nodes not running BGP
+      continue
+
+    n_groups = set(ndata.get('bgp.rr_group',[]) or [])      # This node's scopes; empty means UNSCOPED
+    n_as     = str(ndata.get('bgp.as'))
+
+    if ndata.get('bgp.rr',False):                           # Remember which AS use reflectors...
+      rr_as[n_as] = True
+
+    for grp in n_groups:                                    # ... and which scopes hold one
+      key = f'{n_as}:{grp}'
+      group_seen[key] = True
+      if ndata.get('bgp.rr',False):
+        group_rr[key] = True
+
+    if not n_groups:                                        # UNSCOPED node: leave every session alone
+      continue
+
+    ngb_list = []
+    for ngb in ndata.bgp.neighbors:
+      if ngb.type != 'ibgp':                                # Keep every EBGP session
+        ngb_list.append(ngb)
+        continue
+
+      p_groups = set(topology.nodes[ngb.name].get('bgp.rr_group',[]) or [])
+      if not p_groups:                                      # Peer is UNSCOPED: keep the session
+        ngb_list.append(ngb)
+        continue
+
+      if n_groups & p_groups:                               # Shared scope: keep the session
+        ngb_list.append(ngb)
+
+    ndata.bgp.neighbors = ngb_list
+
+  # A scope that uses reflectors but contains none cannot propagate anything
+  # inside itself. Report it the way bgp.domain reports a domain with no RR,
+  # rather than letting the lab come up with silent black holes.
+  for key in sorted(group_seen):
+    (g_as,g_name) = key.split(':',1)
+    if g_as not in rr_as:                                   # This AS does not use reflectors at all
+      continue
+    if group_rr.get(key,False):                             # Scope has a reflector: fine
+      continue
+    log.error(
+      f'BGP AS {g_as} uses route reflectors, but scope {g_name} contains none.\n' + \
+      f'... Nodes whose only scope is {g_name} will have no IBGP route propagation\n' + \
+      f'... Give at least one router in scope {g_name} bgp.rr: True',
+      log.IncorrectValue,'bgp.rr_group')
diff --git a/netsim/extra/bgp/rr_group/defaults.yml b/netsim/extra/bgp/rr_group/defaults.yml
new file mode 100644
index 0000000..906a828
--- /dev/null
+++ b/netsim/extra/bgp/rr_group/defaults.yml
@@ -0,0 +1,13 @@
+# bgp.rr_group attributes
+#
+# A node may belong to SEVERAL peering scopes. An IBGP session survives only if
+# the two ends share at least one. bgp.domain is the single-valued equivalent
+# and cannot express a reflector that peers with its regional pair in one scope
+# and with the core in another.
+---
+bgp:
+  attributes:
+    node:
+      rr_group:
+        type: list
+        _subtype: str
diff --git a/netsim/extra/ospf/instances/__init__.py b/netsim/extra/ospf/instances/__init__.py
new file mode 100644
index 0000000..765f1c4
--- /dev/null
+++ b/netsim/extra/ospf/instances/__init__.py
@@ -0,0 +1,150 @@
+from box import Box
+
+from netsim import api
+from netsim.utils import log
+
+_requires    = [ 'ospf' ]
+_config_name = 'ospf.instances'
+
+'''
+ospf.instances -- more than one OSPF process per node.
+
+netlab's ospf module configures exactly ONE process in a node's global routing
+table. The CCIE SP workbook runs TWO: OSPF 100 across the SP core and
+distribution area, OSPF 200 across the customer areas and the internet hub,
+mutually redistributed on the four routers that carry both.
+
+  ospf:
+    process: 200                  # the PRIMARY process, handled by the module
+    area: 0.0.0.0
+    instances:
+      100: { area: 0.0.0.1 }      # an ADDITIONAL process
+    redistribute:
+      200: [ 100 ]                # into 200, redistribute 100
+      100: [ 200 ]                # into 100, redistribute 200
+
+An interface joins a non-primary instance by naming it:
+
+  - clc-r1:
+      ospf: { process: 100, area: 0.0.0.1 }
+
+HOW THE SPLIT IS DONE, AND WHY IT LOOKS LIKE THIS
+
+The base template renders every interface that still carries an `ospf`
+attribute into the primary process. So an interface belonging to another
+instance has to leave the base template's view entirely: this plugin REMOVES
+`ospf` from that interface and hands a COPY -- with `ospf` intact -- to the
+instance under `ospf._instances[pid]._interfaces`.
+
+The per-device template then calls the module's OWN macro for each extra
+instance, with that pid and that interface list. Rendering is therefore
+upstream's, not a second implementation of it, so anything the module learns
+to emit for a process is emitted for these too.
+'''
+
+def _norm_area(area: str) -> str:
+  return str(area)
+
+def post_transform(topology: Box) -> None:
+  for n, ndata in topology.nodes.items():
+    if 'ospf' not in ndata.get('module',[]):
+      continue
+
+    instances = ndata.get('ospf.instances',None)
+    primary   = ndata.get('ospf.process',1)
+
+    # Interfaces may name a process even on a node that declares no extra
+    # instances -- that is an error worth naming, because the interface would
+    # otherwise land silently in the primary process.
+    for intf in ndata.get('interfaces',[]):
+      i_pid = intf.get('ospf.process',None)
+      if i_pid is None or int(i_pid) == int(primary):
+        continue
+      if not instances or int(i_pid) not in [ int(k) for k in instances.keys() ]:
+        log.error(
+          f'Node {n} interface {intf.get("ifname","?")} asks for OSPF process {i_pid},\n' + \
+          f'... but the node declares no ospf.instances entry for it\n' + \
+          f'... Primary process is {primary}; declare {i_pid} under ospf.instances',
+          log.IncorrectValue,'ospf.instances')
+
+    if not instances:
+      continue
+
+    inst_data = Box({},default_box=True,box_dots=True)
+
+    for pid, idata in instances.items():
+      pid_i = int(pid)
+      entry = Box(idata or {},default_box=True,box_dots=True)
+      entry.process = pid_i
+      # Every instance needs an af so the device template knows to emit it.
+      entry.af.ipv4 = True
+      entry._interfaces = []
+      inst_data[str(pid_i)] = entry
+
+    # Move interfaces out of the primary process and into their instance.
+    keep = []
+    for intf in ndata.get('interfaces',[]):
+      i_pid = intf.get('ospf.process',None)
+      if i_pid is None or int(i_pid) == int(primary):
+        keep.append(intf)
+        continue
+
+      key = str(int(i_pid))
+      if key not in inst_data:                       # already reported above
+        keep.append(intf)
+        continue
+
+      moved = Box(intf,default_box=True,box_dots=True)
+      # An interface that does not name its own area inherits the instance's.
+      if 'area' not in moved.ospf and 'area' in inst_data[key]:
+        moved.ospf.area = inst_data[key].area
+      inst_data[key]._interfaces.append(moved)
+
+      # Remove it from the base template's view WITHOUT dropping the interface
+      # itself: the node still has the address, it just is not in the primary
+      # OSPF process any more.
+      stripped = Box(intf,default_box=True,box_dots=True)
+      stripped.pop('ospf',None)
+      keep.append(stripped)
+
+    ndata.interfaces = keep
+
+    # CROSS-PROCESS REDISTRIBUTION IS RENDERED BY THIS PLUGIN, NOT BY THE
+    # MODULE'S REDISTRIBUTE MACRO.
+    #
+    # templates/routing/_redistribute.<dev>.j2 keys `import` by PROTOCOL NAME and
+    # appends a single `ospf_pid` for an ospf source -- and ios.ospfv2.j2 does not
+    # pass that parameter at all, so it defaults to 1. There is no way to say
+    # "into process 200, redistribute process 100" through it: one key, one pid,
+    # and the pid it would use is wrong.
+    #
+    # Writing `import['ospf_100']` instead, as an earlier revision did, made the
+    # macro emit the KEY as the protocol: `redistribute ospf_100`, which is not a
+    # command on any of these platforms. It rendered, it looked plausible in
+    # node_files, and no device would have accepted it.
+    #
+    # So record the pairs and let the per-device template emit the real command.
+    redist = ndata.get('ospf.redistribute',None) or {}
+    xredist = []
+    for tgt, src_list in redist.items():
+      tgt_i = int(tgt)
+      if tgt_i != int(primary) and str(tgt_i) not in inst_data:
+        log.error(
+          f'Node {n} redistributes into OSPF process {tgt_i}, which is neither\n' + \
+          f'... the primary process ({primary}) nor a declared instance',
+          log.IncorrectValue,'ospf.instances')
+        continue
+      sources = [ src_list ] if not isinstance(src_list,list) else src_list
+      for src in sources:
+        src_i = int(src)
+        if src_i != int(primary) and str(src_i) not in inst_data:
+          log.error(
+            f'Node {n} redistributes OSPF process {src_i} into {tgt_i}, but {src_i}\n' + \
+            f'... is neither the primary process ({primary}) nor a declared instance',
+            log.IncorrectValue,'ospf.instances')
+          continue
+        xredist.append({ 'target': tgt_i, 'source': src_i })
+
+    ndata.ospf._xredist = xredist
+    ndata.ospf._instances = inst_data
+    api.node_config(ndata,_config_name)
diff --git a/netsim/extra/ospf/instances/asa.j2 b/netsim/extra/ospf/instances/asa.j2
new file mode 100644
index 0000000..5aab3ef
--- /dev/null
+++ b/netsim/extra/ospf/instances/asa.j2
@@ -0,0 +1,71 @@
+{#
+  Extra OSPF processes on ASA, plus cross-process redistribution.
+
+  Same shape as ios.j2 in this directory (and for the same reason it renders
+  the process itself instead of calling ospf/asa.ospfv2.j2's macro: a plugin
+  template's Jinja search path cannot resolve that macro's nested imports).
+  ASA syntax follows asa.ospfv2.j2 exactly: `network <net> <mask> area <int>`
+  statements (not `ip ospf <pid> area` on the interface -- ASA has none), the
+  area converted from dotted-decimal to an integer the way the base template
+  does, per-interface knobs under `interface <nameif>` as `ospf <knob>`.
+  Verified against a real ASA capture running OSPF 100 and 200 side by side
+  (sjc-bldg1-fw01: `router ospf 200` / `network 101.19.0.16 255.255.255.252
+  area 0.0.0.0` / `default-information originate metric 1`).
+
+  ASA's `redistribute ospf <pid>` takes no `subnets` keyword (that is IOS).
+#}
+{% macro area_to_int(area) -%}
+{%- set parts = area|string %}
+{%- if '.' in parts %}
+{%- set p = parts.split('.') %}
+{{ (p[0]|int * 16777216) + (p[1]|int * 65536) + (p[2]|int * 256) + (p[3]|int) }}
+{%- else %}
+{{ parts }}
+{%- endif %}
+{%- endmacro %}
+{% for pid, idata in ospf._instances|default({})|dictsort %}
+!
+router ospf {{ idata.process }}
+{%   if idata.router_id is defined %}
+ router-id {{ idata.router_id }}
+{%   elif ospf.router_id is defined %}
+ router-id {{ ospf.router_id }}
+{%   endif %}
+{%   if idata.reference_bandwidth is defined %}
+ auto-cost reference-bandwidth {{ idata.reference_bandwidth }}
+{%   endif %}
+{%   if idata.default is defined %}
+{%     set dfd = idata.default %}
+ default-information originate{%
+     if dfd.always|default(False) %} always{% endif %}{%
+     if dfd.type|default('') %} metric-type {{ dfd.type.replace('e','') }}{% endif %}{%
+     if dfd.cost|default(0) %} metric {{ dfd.cost }}{% endif +%}
+{%   endif %}
+{%   for l in idata._interfaces|default([]) if 'ipv4' in l and l.ipv4 is string %}
+{%     if l.ospf.passive|default(False) %}
+ passive-interface {{ l.ifname }}
+{%     endif %}
+ network {{ l.ipv4|ansible.utils.ipaddr('network') }} {{ l.ipv4|ansible.utils.ipaddr('netmask') }} area {{ area_to_int(l.ospf.area) }}
+{%   endfor %}
+{%   for l in idata._interfaces|default([]) if 'ipv4' in l and (l.ospf.cost is defined or l.ospf.timers is defined or l.ospf.priority is defined) %}
+!
+interface {{ l.ifname }}
+{%     if l.ospf.cost is defined %}
+ ospf cost {{ l.ospf.cost }}
+{%     endif %}
+{%     if l.ospf.timers.hello is defined %}
+ ospf hello-interval {{ l.ospf.timers.hello }}
+{%     endif %}
+{%     if l.ospf.timers.dead is defined %}
+ ospf dead-interval {{ l.ospf.timers.dead }}
+{%     endif %}
+{%     if l.ospf.priority is defined %}
+ ospf priority {{ l.ospf.priority }}
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+{% for r in ospf._xredist|default([]) %}
+!
+router ospf {{ r.target }}
+ redistribute ospf {{ r.source }}
+{% endfor %}
diff --git a/netsim/extra/ospf/instances/defaults.yml b/netsim/extra/ospf/instances/defaults.yml
new file mode 100644
index 0000000..c38ac65
--- /dev/null
+++ b/netsim/extra/ospf/instances/defaults.yml
@@ -0,0 +1,39 @@
+# ospf.instances attributes
+#
+# netlab's ospf module gives a node exactly ONE process in the global routing
+# table. `instances` declares the additional ones, and an interface says which
+# instance it belongs to with its own `ospf.process`.
+---
+ospf:
+  no_propagate:
+    instances:
+  attributes:
+    node:
+      instances:
+        type: dict
+        _subtype:
+          type: dict
+          _keys:
+            area: { type: ipv4, use: id }
+            router_id: { type: ipv4, use: id }
+            reference_bandwidth: int
+            # An instance's own default-information originate -- e.g. the ISP
+            # side of a dual-process ASA WAN edge, where the default route
+            # belongs on process 200 but never on the inside process 100.
+            # Same shape as the base ospf module's own ospf.default attribute.
+            default:
+              _alt_types: [ bool ]
+              type: dict
+              _keys:
+                always: bool
+                policy: id
+                cost: int
+                type:
+                  type: str
+                  valid_values: [ e1, e2 ]
+      redistribute:
+        type: dict
+    interface:
+      process: int
+    link:
+      process: int
diff --git a/netsim/extra/ospf/instances/eos.j2 b/netsim/extra/ospf/instances/eos.j2
new file mode 100644
index 0000000..5f50a0e
--- /dev/null
+++ b/netsim/extra/ospf/instances/eos.j2
@@ -0,0 +1,13 @@
+{#
+  Extra OSPF processes on EOS, plus cross-process redistribution.
+  EOS's macro takes the same (pid,vrf,data,interfaces) shape as IOS.
+#}
+{% import "ospf/eos.ospfv2.j2" as ospfv2 with context %}
+{% for pid, idata in ospf._instances|default({})|dictsort %}
+{{ ospfv2.config(idata.process,False,idata,idata._interfaces|default([])) }}
+{% endfor %}
+{% for r in ospf._xredist|default([]) %}
+!
+router ospf {{ r.target }}
+   redistribute ospf {{ r.source }}
+{% endfor %}
diff --git a/netsim/extra/ospf/instances/ios.j2 b/netsim/extra/ospf/instances/ios.j2
new file mode 100644
index 0000000..0657640
--- /dev/null
+++ b/netsim/extra/ospf/instances/ios.j2
@@ -0,0 +1,68 @@
+{#
+  Extra OSPF processes on IOS/IOL, plus cross-process redistribution.
+
+  WHY THIS RENDERS THE PROCESS ITSELF INSTEAD OF CALLING ios.ospfv2.j2.
+
+  Calling the module's macro would be preferable -- one implementation of "how a
+  process is emitted" -- and it was tried. It does not work from a plugin: the
+  macro's own first line imports `templates/routing/_default.ios.j2`, which
+  resolves only when `netsim/ansible` is on the Jinja search path. A plugin
+  template's search path ends at `netsim/ansible/templates`, so the nested import
+  fails with the macro itself found. The path list belongs to the framework, not
+  to us, so the choice is a template that works or a macro call that cannot
+  resolve.
+
+  Kept deliberately narrow: what a second OSPF process needs and nothing more.
+  Interface OSPF settings (cost, network type, timers) stay on the PRIMARY
+  process where the ospf module already renders them -- an interface here has
+  been moved out of the primary process, so its per-interface knobs move with it
+  and are emitted below.
+
+  Redistribution is emitted here too. The module's redistribute macro keys
+  `import` by protocol name and appends one `ospf_pid` that ios.ospfv2.j2 never
+  passes, so it cannot express "into 200, redistribute 100" -- see __init__.py.
+#}
+{% for pid, idata in ospf._instances|default({})|dictsort %}
+!
+router ospf {{ idata.process }}
+{%   if idata.router_id is defined %}
+ router-id {{ idata.router_id }}
+{%   elif ospf.router_id is defined %}
+ router-id {{ ospf.router_id }}
+{%   endif %}
+{%   if idata.reference_bandwidth is defined %}
+ auto-cost reference-bandwidth {{ idata.reference_bandwidth }}
+{%   endif %}
+{%   for l in idata._interfaces|default([]) if l.ospf.passive|default(False) %}
+ passive-interface {{ l.ifname }}
+{%   endfor %}
+{%   for l in idata._interfaces|default([]) if 'ipv4' in l %}
+!
+interface {{ l.ifname }}
+! {{ l.name|default("") }}
+ ip ospf {{ idata.process }} area {{ l.ospf.area }}
+{%     if l.ospf.network_type is defined %}
+ ip ospf network {{ l.ospf.network_type }}
+{%     endif %}
+{%     if l.ospf.cost is defined %}
+ ip ospf cost {{ l.ospf.cost }}
+{%     endif %}
+{%     if l.ospf.bfd|default(False) %}
+ ip ospf bfd
+{%     endif %}
+{%     if l.ospf.timers.hello is defined %}
+ ip ospf hello-interval {{ l.ospf.timers.hello }}
+{%     endif %}
+{%     if l.ospf.timers.dead is defined %}
+ ip ospf dead-interval {{ l.ospf.timers.dead }}
+{%     endif %}
+{%     if l.ospf.priority is defined %}
+ ip ospf priority {{ l.ospf.priority }}
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+{% for r in ospf._xredist|default([]) %}
+!
+router ospf {{ r.target }}
+ redistribute ospf {{ r.source }} match internal external subnets
+{% endfor %}
