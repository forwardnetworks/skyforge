diff --git a/netsim/ansible/templates/initial/keysight_ixia-c-controller.j2 b/netsim/ansible/templates/initial/keysight_ixia-c-controller.j2
new file mode 100644
index 0000000..48e03d6
--- /dev/null
+++ b/netsim/ansible/templates/initial/keysight_ixia-c-controller.j2
@@ -0,0 +1,12 @@
+{#
+  DELIBERATELY EMPTY -- not a stub awaiting content.
+
+  ixia-c components are configured over the OTG API after boot. There is no
+  day-0 configuration for netlab to produce, and putting any here would make
+  this file a SECOND producer of device config, which this platform forbids.
+
+  The file exists because netlab enables `routing` on any host linked to a
+  router and then looks for a template to render. Without it `netlab create`
+  fails with "Cannot find initial configuration template". Rendering nothing is
+  the right answer; having no file reads as an oversight rather than a decision.
+#}
