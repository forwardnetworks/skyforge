diff --git a/netsim/ansible/templates/initial/vsrx.j2 b/netsim/ansible/templates/initial/vsrx.j2
new file mode 100644
index 0000000..a6abec0
--- /dev/null
+++ b/netsim/ansible/templates/initial/vsrx.j2
@@ -0,0 +1,213 @@
+{#
+    vSRX day-0. Body is vjunos-router.j2 / vjunos-switch.j2 verbatim (those two
+    are byte-identical); this file exists so the vsrx device RESOLVES to it.
+
+    WHY (2026-09-15). vSRX was onboarded to the KubeVirt lane by patches/kne/0031
+    on the vJunos CD-ROM juniper.conf path, and that patch said in its own text:
+    "NOT YET PROVEN ON A LIVE vSRX -- check on first bring-up: does the running
+    config carry the rendered stanzas?" Nobody did. demo-lab r9, r13 and
+    r14 then failed on BOTH vsrx nodes with "Could not open socket to <ip>:830"
+    -- NETCONF never opened, on any run, within any budget (600s; r14 waited
+    the full window on a controller-side port probe). A 2-node smoke
+    (vsrx-day0-readback, VMI fw1) read the bootstrap secret back: the
+    juniper.conf on the CD-ROM was netlab's upstream junos.j2 output --
+    interfaces, lldp, snmp -- and NOTHING ELSE. No root-authentication, no
+    login user, no `system services { ssh; netconf ssh; }`, no fxp0 address.
+    Junos ships none of those (see the vjunos header below), so the device
+    booted with no way in: sshd and netconf were never enabled. Every readiness
+    failure on vsrx was this file not existing.
+
+    vsrx shares every relevant property with vjunos on this lane, verified on
+    the live smoke VMI: plain vendor qcow2 (kubevirt/vsrx:21.2R3-S4.8-native-r1,
+    no vrnetlab layer), KubeVirt masquerade `default` NIC forwarding 22/830 to
+    the guest at 10.0.2.2 via 10.0.2.1, meshnet bridge NICs for data, and
+    netlab device defaults of admin / admin@123 (netsim/devices/vsrx.yml) --
+    the same ansible_user/ansible_ssh_pass this template consumes. vSRX keeps
+    fxp0 outside its security zones, so host-inbound ssh/netconf on fxp0 needs
+    no zone policy.
+#}
+system {
+  host-name {{ inventory_hostname }};
+  static-host-mapping {
+{% for k,v in hostvars.items() if k != inventory_hostname %}
+{%   if v.loopback.ipv4 is defined %}
+    {{ k|replace('_','') }} inet {{ v.loopback.ipv4|ansible.utils.ipaddr('address') }};
+{%   elif v.interfaces|default([]) and v.interfaces[0].ipv4|default(False) is string %}
+    {{ k|replace('_','') }} inet {{ v.interfaces[0].ipv4|ansible.utils.ipaddr('address') }};
+{%   endif %}
+{% endfor %}
+  }
+{#
+    THE LOGIN. Credentials come from ansible_user / ansible_ssh_pass so they
+    follow netlab's own declaration, same as vjunos-router.j2 -- but the
+    ENCODING diverges from that template's `plain-text-password-value`, and
+    the reason is load-bearing:
+#}
+{#
+    encrypted-password, NOT plain-text-password-value -- vsrx DIVERGES from
+    vjunos-router.j2 here, and the reason is load-bearing. This image boots
+    into Junos FIPS mode unconditionally (`junos.kern.fpc_fips: 0 -> 1`,
+    `fipsd` started, every boot, config or no config) -- proven both on the
+    live KubeVirt VM and on a bare, factory, Juniper-downloaded
+    junos-vsrx3-x86-64-21.3R1.9.qcow2 booted locally under plain QEMU/KVM,
+    completely outside Skyforge. In FIPS mode `plain-text-password-value`
+    commits cleanly (mgd: commit complete, no warning anywhere) but the
+    account it produces never authenticates -- console, SSH and NETCONF all
+    reject the exact password just configured. Switching to a pre-computed
+    encrypted-password (sha512crypt) fixed it on the SAME local VM, same FIPS
+    boot, first try. Root cause is presumed to be FIPS-mode commit deriving a
+    non-FIPS-approved hash from the plain-text directive; not confirmed
+    against Juniper's own docs, but the before/after is unambiguous.
+
+    Salt is `inventory_hostname` (crypt accepts any 0-16 char alnum salt) so
+    the hash is DETERMINISTIC across re-renders of the same node -- a random
+    salt here would make every `netlab config` reconfigure look like a
+    password change even when it is not.
+
+    `sha512_crypt` is patches/netlab/30 (netsim/utils/filters.py), NOT
+    Ansible's `password_hash`: this renderer (netsim/utils/templates.py
+    add_j2_filters) registers only a hand-picked filter set, so
+    password_hash is unreachable from a template even though passlib ships
+    in the runtime image -- first attempt at this fix used password_hash and
+    failed at `netlab create` with "No filter named 'password_hash'", caught
+    before it ever reached a device. sha512_crypt defaults to rounds=5000
+    (glibc's traditional count), producing the exact `$6$salt$hash` shape
+    (no `rounds=N$` segment) proven working live; passlib's own default of
+    656000 rounds would encode as `$6$rounds=656000$salt$hash`, a different,
+    unverified wire shape.
+
+    vjunos-router.j2 is NOT changed to match: its header claims Junos hashes
+    plain-text-password-value on commit, and that template is independently
+    verified working live (23.4R2-S2.1, SSH+NETCONF both answered). Whether
+    THAT image also boots FIPS was not checked; changing a proven-working
+    template on an unverified guess is the wrong trade. If vjunos is ever
+    seen with this same symptom, apply the identical fix there and delete
+    this paragraph's uncertainty.
+#}
+  root-authentication {
+    encrypted-password "{{ ansible_ssh_pass|default('admin@123')|sha512_crypt(salt=inventory_hostname) }}";
+  }
+  login {
+    user {{ ansible_user|default('admin') }} {
+      class super-user;
+      authentication {
+        encrypted-password "{{ ansible_ssh_pass|default('admin@123')|sha512_crypt(salt=inventory_hostname) }}";
+      }
+    }
+  }
+  services {
+    ssh {
+      root-login allow;
+    }
+    netconf {
+      ssh;
+    }
+  }
+{#
+    management-instance keeps fxp0 in the mgmt_junos routing instance, so the
+    management default route cannot leak into the lab's own routing table.
+#}
+  management-instance;
+}
+
+{% if vrfs is defined %}
+{% include 'initial/junos.vrf.j2' %}
+{% endif %}
+{% if vlans is defined %}
+{% include 'initial/junos.vlan.j2' %}
+{% endif %}
+
+interfaces {
+{#
+    fxp0 IS the management address, statically, exactly as vrnetlab's init.conf
+    set {MGMT_IP_IPV4}. DHCP does NOT work here, and the reason is worth keeping:
+    this image is a Linux wrapper running the Junos RE nested behind its own
+    br-ext bridge, and the WRAPPER's dhclient consumes the single lease KubeVirt
+    masquerade offers ("bound to 10.0.2.2"). The RE is left with no address, so
+    nothing answers on 22/830 even though sshd is listening on both.
+
+    10.0.2.2/24 via 10.0.2.1 are KubeVirt masquerade constants: masquerade NATs
+    inbound traffic to 10.0.2.2 and gateways at 10.0.2.1 (the default
+    10.0.2.0/24 -- our VMIs never override the masquerade cidr), so the RE must
+    hold exactly this address to receive it.
+
+    Verified 2026-08-29 on a real KubeVirt vJunos VM: fxp0.0 up at 10.0.2.2/24,
+    ping to 10.0.2.1 in mgmt_junos at 0% loss, and SSH-2.0-OpenSSH_7.5 returned
+    on both 22 and 830 from a separate pod.
+#}
+  fxp0 {
+    unit 0 {
+      family inet {
+        address 10.0.2.2/24;
+      }
+    }
+  }
+{#
+# MTU is handled outside the main interface loop: it applies only to the master
+# interface, and the value is computed by the junos device quirks.
+#}
+{% for l in interfaces|default([]) %}
+{%   if l._junos_mtu_with_headers is defined %}
+  {{ l.junos_interface }} {
+    mtu {{ l._junos_mtu_with_headers }};
+  }
+{%   endif %}
+{% endfor %}
+
+{% for l in netlab_interfaces %}
+  {{ l.ifname }} {
+{% if l.name is defined %}
+    description "{{ l.name }}{{ " ["+l.role+"]" if l.role is defined else "" }}";
+{% elif l.type|default("") == "stub" %}
+    description "Stub interface"
+{% endif %}
+
+{% if l.bandwidth is defined %}
+      bandwidth {{ l.bandwidth * 1000 }};
+{% endif %}
+{% if l.shutdown|default(False) %}
+      disable;
+{% endif %}
+{% if 'ipv4' in l %}
+      family inet {
+{%   if l.ipv4 == True %}
+        unnumbered-address lo0.0;
+{%   elif l.ipv4|ansible.utils.ipv4 %}
+        address {{ l.ipv4 }};
+{%   else %}
+! Invalid IPv4 address {{ l.ipv4 }}
+{%   endif %}
+{%   if l.mtu is defined and l._junos_mtu_with_headers is not defined %}
+        mtu {{ l.mtu }};
+{%   endif %}
+      }
+{% endif %}
+{% if 'ipv6' in l %}
+      family inet6 {
+{%   if l.ipv6 is string %}
+        address {{ l.ipv6 }};
+{%   endif %}
+{%   if l.mtu is defined and l._junos_mtu_with_headers is not defined %}
+        mtu {{ l.mtu }};
+{%   endif %}
+      }
+{% endif %}
+  }
+{% endfor %}
+}
+{% include 'initial/junos/lldp.j2' %}
+
+{#
+    management-instance puts fxp0 in the mgmt_junos routing instance, so the
+    management default route has to live there too -- it is not inherited from
+    inet.0. Without it the RE answers only on-subnet.
+#}
+routing-instances {
+  mgmt_junos {
+    routing-options {
+      static {
+        route 0.0.0.0/0 next-hop 10.0.2.1;
+      }
+    }
+  }
+}
