diff --git a/netsim/augment/nodes.py b/netsim/augment/nodes.py
index 114bc03..e366a23 100644
--- a/netsim/augment/nodes.py
+++ b/netsim/augment/nodes.py
@@ -654,6 +654,20 @@ def transform(topology: Box, defaults: Box, pools: Box) -> None:
 Cleanup non-Ansible configuration file data -- remove all daemon/node config mappings that
 are not used by a module, a plugin (based on "config" data) or a device itself
 '''
+"""
+SKYFORGE-SPECIFIC (patch 55): the 'lldp' node/interface attribute exists only on devices that declare the 'lldp' feature
+(today: linux with the kne provider). netlab's usual rule for a device that lacks an optional feature applies: the
+topology is rejected with "Device <device> does not support lldp used in <path>". That includes a link-level 'lldp' that
+propagates onto the interface of a node that cannot do it, and an explicit 'lldp: false' (the attribute is not accepted at all).
+"""
+def check_lldp_support(topology: Box) -> None:
+  for name,node in topology.nodes.items():
+    if 'lldp' in node:
+      devices.check_optional_features(node.lldp,f'nodes.{name}.lldp',node,topology,'lldp')
+    for idx,intf in enumerate(node.get('interfaces',[])):
+      if 'lldp' in intf:
+        devices.check_optional_features(intf.lldp,f'nodes.{name}.interfaces[{idx}].lldp (ifname {intf.get("ifname","?")})',node,topology,'lldp')
+
 def cleanup_non_ansible_config(n: Box) -> None:
