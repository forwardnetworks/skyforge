-def adjust_linux_node_data(kne_data: Box, node: Box) -> None:
+def linux_lldp_env(node: Box, topology: Box) -> dict:
+  '''
+  The pod env that carries the node's LLDP choice, from the plain `lldp` attribute (node, group node_data or
+  defaults.devices.linux; per-interface `lldp` on the link/interface overrides the node value for that interface).
+
+  OFF by default: SKYFORGE_LLDP_DISABLED=1. If LLDP is effectively on for at least one data-plane interface the key is not
+  written (the image runs lldpd node-wide unless told otherwise). SKYFORGE_LLDP_INTERFACES (comma list of pod ifnames) is
+  written only when a per-interface choice exists, so an image that understands it can restrict lldpd to those interfaces;
+  an absent key means every data-plane interface. A node-wide `lldp: true` whose interfaces are all explicitly false is OFF.
+  Only a real boolean True switches anything on.
+  '''
+  node_on = node.get('lldp',None)
+  if node_on is None:
+    node_on = devices.get_device_attribute(node,'lldp',topology.defaults)
+  node_on = node_on is True
+  per_interface = False
+  on_ifnames = []
+  for intf in node.get('interfaces',[]):
+    choice = intf.get('lldp',None)
+    if choice is not None:
+      per_interface = True
+    if (node_on if choice is None else choice is True) and intf.get('ifname',None):
+      on_ifnames.append(str(intf.ifname))
+  if not on_ifnames and not (node_on and not node.get('interfaces',[])):
+    return { 'SKYFORGE_LLDP_DISABLED': '1' }
+  return { 'SKYFORGE_LLDP_INTERFACES': ','.join(on_ifnames) } if per_interface else {}
+
+def adjust_linux_node_data(kne_data: Box, node: Box, topology: Box) -> None:
   '''
   SKYFORGE-SPECIFIC: the pod env of a linux host comes from the platform and the declaration, not from raw env.
 
@@ -2633,12 +2661,19 @@ def adjust_linux_node_data(kne_data: Box, node: Box) -> None:
   2. Listeners -- `services.listen` (node or group level) is rendered into SKYFORGE_SERVICES /
      SKYFORGE_IPERF3_SERVER_PORT, and a topology author's own values for those keys are discarded, so the
      declaration is the only door and the node data tells the truth about what listens.
+  3. LLDP -- OFF BY DEFAULT (owner decision 2026-10-12), switched by the plain `lldp` attribute (see linux_lldp_env). The
+     skyforge-linux-host image runs lldpd unless the pod carries SKYFORGE_LLDP_DISABLED=1, and the collector then lists every
+     LLDP-discovered host in a path trace as a device "missing from collection" (hosts are collected as endpoints, not
+     devices). A topology author's own `kne.env` values for SKYFORGE_LLDP_DISABLED / SKYFORGE_LLDP_INTERFACES are DISCARDED:
+     `lldp` is the only door.
   '''
   kne_data.env = kne_data.get('env',Box(default_box=True,box_dots=True))
-  for key in CALDERA_AGENT_ENV_KEYS + LINUX_SERVICES_ENV_KEYS:
+  for key in CALDERA_AGENT_ENV_KEYS + LINUX_SERVICES_ENV_KEYS + LINUX_LLDP_ENV_KEYS:
     kne_data.env.pop(key,None)
   for key,value in linux_services_env(node).items():
     kne_data.env[key] = value
+  for key,value in linux_lldp_env(node,topology).items():
+    kne_data.env[key] = value
   server = str(os.environ.get('NETLAB_KNE_CALDERA_AGENT_SERVER','') or '').strip()
   if not server or not caldera_agent_node_selected(node):
     return
diff --git a/tests/test_kne_provider.py b/tests/test_kne_provider.py
index e1bb281..360ca9b 100644
--- a/tests/test_kne_provider.py
+++ b/tests/test_kne_provider.py
@@ -1,5 +1,6 @@
 #!/usr/bin/env python3
 
+import re
 import textwrap
 from argparse import Namespace
 from pathlib import Path
@@ -1644,6 +1645,169 @@ def test_kne_linux_caldera_agent_env_follows_the_per_run_fact(tmp_path: Path, mo
   assert 'attacker.example' not in provider_text
 
 
+def _lldp_pod_env_by_node(tmp_path: Path, topology_yaml: str) -> dict:
+  '''Render the KNE provider file; return {node: (SKYFORGE_LLDP_DISABLED, SKYFORGE_LLDP_INTERFACES)}, None where the key is absent.'''
+  init_log()
+  create.run(['-o','config','-o','provider',str(write_topology(tmp_path,topology_yaml))])
+  text = Path('topology.pb.txt').read_text()
+  assert 'KEEP_ME' in text, 'the author\'s unrelated env must survive'
+  result = {}
+  for block in text.split('\nnodes: {')[1:]:
+    name = re.search(r'name: "([^"]+)"',block).group(1)
+    vals = []
+    for key in ('SKYFORGE_LLDP_DISABLED','SKYFORGE_LLDP_INTERFACES'):
+      found = re.findall(r'key: "' + key + r'"\s+value: "([^"]*)"',block)
+      assert len(found) <= 1, f'{name}: {key} must appear at most once, got {found}'
+      vals.append(found[0] if found else None)
+    result[name] = tuple(vals)
+  return result
+
+
+def _lldp_rejected(tmp_path: Path, topology_yaml: str, capsys: pytest.CaptureFixture) -> str:
+  topo_file = write_topology(tmp_path,topology_yaml)
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    topology = _read.load(str(topo_file),relative_topo_name=True,user_defaults=[])
+    augment.main.transform(topology)
+  captured = capsys.readouterr()
+  return captured.out + captured.err
+
+
+# The author's own raw env values (which would keep lldpd on / pick interfaces) must never survive.
+LLDP_RAW_ENV = """
+    kne:
+      env:
+        SKYFORGE_LLDP_DISABLED: "0"
+        SKYFORGE_LLDP_INTERFACES: "eth9"
+        KEEP_ME: "yes"
+"""
+OFF = ('1',None)
+ON_ALL = (None,None)
+
+
+def test_kne_linux_lldp_is_off_by_default(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,"provider: kne\nnodes:\n  h1:\n    device: linux" + LLDP_RAW_ENV + "  h2:\n    device: linux\n")
+  assert got == { 'h1': OFF, 'h2': OFF }
+
+
+def test_kne_linux_lldp_node_true_and_explicit_false(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,"provider: kne\nnodes:\n  h1:\n    device: linux\n    lldp: true" + LLDP_RAW_ENV + "  h2:\n    device: linux\n    lldp: false\n  h3:\n    device: linux\n")
+  assert got == { 'h1': ON_ALL, 'h2': OFF, 'h3': OFF }
+
+
+def test_kne_linux_lldp_group_level_true(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,"""
+provider: kne
+groups:
+  lldp_on:
+    members: [ h1, h2 ]
+    node_data:
+      lldp: true
+nodes:
+  h1:
+    device: linux""" + LLDP_RAW_ENV + """  h2:
+    device: linux
+  h3:
+    device: linux
+""")
+  assert got == { 'h1': ON_ALL, 'h2': ON_ALL, 'h3': OFF }
+
+
+def test_kne_linux_lldp_defaults_level_true(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,"""
+provider: kne
+defaults.devices.linux.lldp: true
+nodes:
+  h1:
+    device: linux""" + LLDP_RAW_ENV + """  h2:
+    device: linux
+    lldp: false
+""")
+  # the device default switches h1 on; a node's own value beats it
+  assert got == { 'h1': ON_ALL, 'h2': OFF }
+
+
+LLDP_TWO_LINKS = """
+provider: kne
+nodes:
+  h1:
+    device: linux""" + LLDP_RAW_ENV + """  s1:
+    device: linux
+  s2:
+    device: linux
+links:
+- h1: { lldp: %s }
+  s1:
+- h1: { lldp: %s }
+  s2:
+"""
+
+
+def test_kne_linux_lldp_interface_level_selects_interfaces(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  # node off (default), interface to s1 on, interface to s2 explicitly off -> lldp runs on eth1 only
+  got = _lldp_pod_env_by_node(tmp_path,LLDP_TWO_LINKS % ('true','false'))
+  assert got['h1'] == (None,'eth1')
+  assert got['s1'] == OFF and got['s2'] == OFF
+
+
+def test_kne_linux_lldp_interface_false_overrides_node_true(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,LLDP_TWO_LINKS.replace("    device: linux" + LLDP_RAW_ENV,"    device: linux\n    lldp: true" + LLDP_RAW_ENV,1) % ('false','true'))
+  # node true, but the interface to s1 is off: only the interface to s2 (eth2) runs LLDP
+  assert got['h1'] == (None,'eth2')
+
+
+def test_kne_linux_lldp_every_interface_false_is_off_even_with_node_true(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,LLDP_TWO_LINKS.replace("    device: linux" + LLDP_RAW_ENV,"    device: linux\n    lldp: true" + LLDP_RAW_ENV,1) % ('false','false'))
+  assert got['h1'] == OFF
+
+
+@pytest.mark.parametrize('where',[ "nodes:\n  h1:\n    device: linux\n    lldp: maybe\n",
+                                   "nodes: [ h1, h2 ]\ndefaults.device: linux\nlinks:\n- h1: { lldp: 5 }\n  h2:\n" ])
+def test_kne_lldp_rejects_a_non_boolean(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture, where: str) -> None:
+  monkeypatch.chdir(tmp_path)
+  out = _lldp_rejected(tmp_path,"provider: kne\n" + where,capsys)
+  assert 'lldp' in out and 'bool' in out.lower()
+
+
+def test_kne_lldp_is_rejected_on_a_non_linux_node(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture) -> None:
+  monkeypatch.chdir(tmp_path)
+  out = _lldp_rejected(tmp_path,"provider: kne\nnodes:\n  h1:\n    device: linux\n  r1:\n    device: eos\n    lldp: true\nlinks: [ h1-r1 ]\n",capsys)
+  assert 'Device eos does not support lldp used in nodes.r1.lldp' in out
+
+
+def test_kne_lldp_false_is_also_rejected_on_a_non_linux_node(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture) -> None:
+  monkeypatch.chdir(tmp_path)
+  out = _lldp_rejected(tmp_path,"provider: kne\nnodes:\n  r1:\n    device: eos\n    lldp: false\n",capsys)
+  assert 'Device eos does not support lldp' in out
+
+
+def test_kne_lldp_on_the_switch_side_of_a_link_is_rejected(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture) -> None:
+  monkeypatch.chdir(tmp_path)
+  # netlab's rule for an unsupported optional feature is an error, not a warning, so a switch-side lldp stops the compile
+  out = _lldp_rejected(tmp_path,"provider: kne\nnodes:\n  h1:\n    device: linux\n  s1:\n    device: eos\nlinks:\n- h1: { lldp: true }\n  s1: { lldp: true }\n",capsys)
+  assert 'Device eos does not support lldp used in nodes.s1.interfaces' in out
+  assert 'Device linux does not support' not in out
+
+
+def test_kne_lldp_link_level_reaches_the_switch_interface_and_is_rejected(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture) -> None:
+  monkeypatch.chdir(tmp_path)
+  out = _lldp_rejected(tmp_path,"provider: kne\nnodes:\n  h1:\n    device: linux\n  s1:\n    device: eos\nlinks:\n- h1:\n  s1:\n  lldp: true\n",capsys)
+  assert 'Device eos does not support lldp used in nodes.s1.interfaces' in out
+
+
+def test_kne_lldp_on_the_host_side_of_a_host_switch_link_is_accepted(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  got = _lldp_pod_env_by_node(tmp_path,"provider: kne\nnodes:\n  h1:\n    device: linux" + LLDP_RAW_ENV + "  s1:\n    device: eos\nlinks:\n- h1: { lldp: true }\n  s1:\n")
+  assert got['h1'] == (None,'eth1')
+  assert got['s1'] == (None,None), "a non-linux node is never touched by the linux adjuster"
+
 
 
 LISTEN_TOPOLOGY = """
