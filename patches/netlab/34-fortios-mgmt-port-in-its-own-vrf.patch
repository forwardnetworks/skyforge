From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Fri, 2 Oct 2026 12:00:00 +0000
Subject: [PATCH] kne: the FortiOS management port is the seed's shape: own
 VRF, static address, no default

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/netsim/providers/kne.py b/netsim/providers/kne.py
index 72705ce..414b360 100644
--- a/netsim/providers/kne.py
+++ b/netsim/providers/kne.py
@@ -1639,6 +1639,31 @@ def fortios_bootstrap_password(node: Box, topology: Box) -> str:
     password = ''
   return password or 'admin'
 
+# The management port lives in its own routing table, as the seed's FortiGate does
+# (its collected `get router info routing-table all` has the 192.168.148.0/22
+# management network in VRF 2 and the data plane in VRF 0). FortiOS installs the
+# DHCP offer's gateway as a distance-5 default in the interface's VRF, so with the
+# default VRF 0 that default beat every data-plane default.
+FORTIOS_MGMT_VRF = 2
+
+# The seed's port1 is `set ip 192.168.148.10 255.255.252.0`, STATIC, and its VRF 2
+# holds only that connected route: no default. The lab port1 therefore carries the
+# KubeVirt masquerade constants (the guest is always 10.0.2.2/24 behind 10.0.2.1;
+# our VMIs never override the masquerade cidr) as a static address, and no default.
+# Management replies still need a way back to the sources that manage the box, or
+# the interface's reverse-path check drops them (measured on a booted 7.0.9 VM:
+# static address and nothing else -> 22/443 time out from every pod). Those
+# sources are all in the cluster's pod range (cilium_host, the kubelet/probe and
+# every collector pod are 198.18.x.x), so ONE static route for that range via the
+# masquerade gateway carries management without putting a default in the table
+# the collector merges into the data plane.
+FORTIOS_MGMT_IP = '10.0.2.2'
+FORTIOS_MGMT_NETMASK = '255.255.255.0'
+FORTIOS_MGMT_GATEWAY = '10.0.2.1'
+FORTIOS_MGMT_SOURCES = ('198.18.0.0', '255.254.0.0')
+# a high id so a topology's own `config router static` (edit 1..) never overwrites it
+FORTIOS_MGMT_ROUTE_ID = 4000
+
 def generate_fortios_bootstrap(node: Box, topology: Box) -> None:
   if node.device != 'fortios':
     return
@@ -1656,10 +1681,19 @@ def generate_fortios_bootstrap(node: Box, topology: Box) -> None:
       'end',
       'config system interface',
       'edit port1',
-      'set mode dhcp',
+      'set mode static',
+      f'set ip {FORTIOS_MGMT_IP} {FORTIOS_MGMT_NETMASK}',
+      f'set vrf {FORTIOS_MGMT_VRF}',
       'set allowaccess ping http https ssh',
       'next',
       'end',
+      'config router static',
+      f'edit {FORTIOS_MGMT_ROUTE_ID}',
+      f'set dst {FORTIOS_MGMT_SOURCES[0]} {FORTIOS_MGMT_SOURCES[1]}',
+      f'set gateway {FORTIOS_MGMT_GATEWAY}',
+      'set device port1',
+      'next',
+      'end',
     ])
   ]
   for module in startup_config_modules(node,topology):
-- 
2.56.0

