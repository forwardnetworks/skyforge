From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Wed, 7 Oct 2026 12:00:00 +0000
Subject: [PATCH] netmiko: a failed configuration push includes the tail of the
 session log

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/netsim/cli/initial/netmiko.py b/netsim/cli/initial/netmiko.py
index 853b831..f22fdbc 100644
--- a/netsim/cli/initial/netmiko.py
+++ b/netsim/cli/initial/netmiko.py
@@ -13,6 +13,24 @@ from ...utils import log
 from ...utils import netmiko as _netmiko
 
 
+def _session_tail(session_log: str, lines: int = 40) -> str:
+  """The last lines of the netmiko session log, appended to a failure message.
+
+  The session log lives in the job's own work directory and goes away with it,
+  so a failure the platform's log pipeline can only describe as "inspect the
+  session log file" cannot be diagnosed afterwards. Emitting the tail with the
+  error puts the device's actual replies (prompts, mode, error text) in the log.
+  """
+  try:
+    with open(session_log,'r',errors='replace') as f:
+      tail = f.read().splitlines()[-lines:]
+  except OSError:
+    return ''
+  if not tail:
+    return ''
+  return '\n--- last ' + str(len(tail)) + ' lines of ' + session_log + ' ---\n' + '\n'.join(tail) + '\n--- end of session log ---'
+
+
 def deploy(n_data: Box,topology: Box,n_deploy: list) -> None:
   node_config = n_data.get('_node_config',None)
   if not node_config:
@@ -68,7 +86,7 @@ def deploy(n_data: Box,topology: Box,n_deploy: list) -> None:
       append_to_list(n_data._deploy,'failed',cfg_item)
       log.error(
         f'{cfg_item} configuration failed on {n_data.name}',
-        more_data=str(ex),
+        more_data=str(ex) + _session_tail(session_log),
         more_hints=f'Inspect the session log file {session_log} for more details',
         module='netmiko')
       return
@@ -88,7 +106,7 @@ def deploy(n_data: Box,topology: Box,n_deploy: list) -> None:
       append_to_list(n_data._deploy,'failed','save')
       log.error(
         f'Cannot save configuration on {n_data.name}',
-        more_data=str(ex),
+        more_data=str(ex) + _session_tail(session_log),
         more_hints=f'Inspect the session log file {session_log} for more details',
         module='netmiko')
       return
