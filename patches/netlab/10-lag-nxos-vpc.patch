From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:00 +0000
Subject: [PATCH] lag: NX-OS vPC (MLAG peer, peer-keepalive, domain)

---
diff --git a/docs/module/lag.md b/docs/module/lag.md
index 89d072c..b5b0e88 100644
--- a/docs/module/lag.md
+++ b/docs/module/lag.md
@@ -12,6 +12,7 @@ LAG is currently supported on these platforms:
 | Aruba AOS-CX [❗](caveats-aruba) | ✅ | ✅ | ✅ | ✅ |
 | Cisco IOL L2[^iol2] | ✅ | ✅ | ✅ | ❌ |
 | Cisco IOSV L2[^iol2]  | ✅ | ✅ | ✅ | ❌ |
+| Cisco Nexus OS        | ✅ | ✅ | ✅ | ✅ |
 | Cumulus Linux 4.x     | ✅ | ✅ | ❌  | ❌ |
 | Cumulus 5.x (NVUE)    | ✅ | ✅ | ❌  | ✅ |
 | Dell OS10             | ✅ | ✅ | ✅  | ✅ |
@@ -96,6 +97,11 @@ Node/interface level:
 
 Link level:
 * **lag.mlag.peergroup**: This parameter configures a unique peer group ID for the pair of MLAG switches. Can be set to *True* for auto-id generation or an integer (that must be globally unique)
+* **lag.mlag.peer_switch**: Use the same spanning-tree bridge identity on both MLAG peers (Cisco Nexus OS)
+* **lag.mlag.peer_gateway**: Allow a peer to forward packets addressed to the other peer's gateway MAC address (Cisco Nexus OS)
+* **lag.mlag.layer3_peer_router**: Allow routing-protocol adjacencies over a VLAN carried on the peer link (Cisco Nexus OS)
+
+_Netlab_ rejects the three domain options on platforms that do not advertise support for them.
 
 A simple example:
 ```
@@ -120,6 +126,24 @@ links:
     mlag.peergroup: True # (also) used to derive a unique MAC address for this group of MLAG peers
 ```
 
+The following peer-link declaration creates Nexus vPC domain 10 with two
+physical peer-link members and the commonly used routing hardening options:
+
+```
+nodes:
+  s1: { device: nxos, module: [ lag ] }
+  s2: { device: nxos, module: [ lag ] }
+
+links:
+- lag:
+    members: [ s1-s2, s1-s2 ]
+    mlag:
+      peergroup: 10
+      peer_switch: true
+      peer_gateway: true
+      layer3_peer_router: true
+```
+
 ### Advanced MLAG Parameters
 
 The **lag.mlag.peer.backup_ip** _device feature_ specifies a property from the node data model that should be used to determine the MLAG peer's backup IP address (the IP address an MLAG node tries to reach when resolving a split-brain scenario). This parameter is part of the device features and can be changed only for a device type, not individual nodes.
diff --git a/netsim/ansible/templates/lag/nxos.j2 b/netsim/ansible/templates/lag/nxos.j2
new file mode 100644
index 0000000..b938dd4
--- /dev/null
+++ b/netsim/ansible/templates/lag/nxos.j2
@@ -0,0 +1,71 @@
+{% set vpc = namespace(enabled=false) %}
+{% for intf in interfaces if intf.lag.mlag.peergroup is defined %}
+{%   set vpc.enabled = true %}
+{% endfor %}
+feature lacp
+{% if vpc.enabled %}
+feature vpc
+{% endif %}
+!
+{# Provision the vPC domain and peer link #}
+{% for intf in interfaces if intf.lag.mlag.peergroup is defined %}
+vpc domain {{ intf.lag.mlag.peergroup }}
+{%   if intf.lag.mlag.peer_switch|default(false) %}
+ peer-switch
+{%   endif %}
+{%   if intf.lag.mlag.peer_gateway|default(false) %}
+ peer-gateway
+{%   endif %}
+{%   if intf.lag.mlag.layer3_peer_router|default(false) %}
+ layer3 peer-router
+{%   endif %}
+!
+interface port-channel{{ intf.lag.mlag.ifindex }}
+ description vPC peer-link
+ switchport mode trunk
+ spanning-tree port type network
+ vpc peer-link
+!
+{%   for ch in interfaces if ch==intf or ch.lag._peerlink|default(0) == intf.linkindex %}
+interface {{ ch.ifname }}
+ description {{ ch.name }} (vPC peer-link member)
+ switchport mode trunk
+ channel-group {{ intf.lag.mlag.ifindex }} mode active
+!
+{%   endfor %}
+{% endfor %}
+
+{# Regular port channels, including downstream vPCs #}
+{% for intf in interfaces if intf.type == 'lag' %}
+interface {{ intf.ifname }}
+{%   if '_mlag' in intf.lag %}
+ description {{ intf.name }} (vPC {{ intf.lag.ifindex }})
+{#   NX-OS interfaces default to L3 and 'vpc' is accepted only on an L2 port-channel #}
+ switchport
+ vpc {{ intf.lag.ifindex }}
+{%   else %}
+ description {{ intf.name }}
+{%     if 'ipv4' in intf or 'ipv6' in intf %}
+ no switchport
+{%     endif %}
+{%   endif %}
+!
+{%   for ch in interfaces if ch.lag._parentindex|default(None) == intf.lag.ifindex %}
+{%     set lag_mode =
+         'on' if intf.lag.lacp|default('') == 'off' else
+         'active' if intf.lag.lacp_mode|default('') == 'active' else
+         'passive' %}
+interface {{ ch.ifname }}
+ description {{ ch.name }} in channel-group {{ intf.lag.ifindex }}
+{%     if 'ipv4' in intf or 'ipv6' in intf %}
+ no switchport
+{%     elif '_mlag' in intf.lag %}
+ switchport
+{%     endif %}
+ channel-group {{ intf.lag.ifindex }} mode {{ lag_mode }}
+{%     if intf.lag.lacp|default('') == 'fast' %}
+ lacp rate fast
+{%     endif %}
+!
+{%   endfor %}
+{% endfor %}
