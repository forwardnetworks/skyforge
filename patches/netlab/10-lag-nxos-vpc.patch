diff --git a/tests/test_nxos_vpc.py b/tests/test_nxos_vpc.py
new file mode 100644
index 0000000..6f6c318
--- /dev/null
+++ b/tests/test_nxos_vpc.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from netsim import augment
+from netsim.cli import create
+from netsim.utils import log
+from netsim.utils import read as _read
+
+
+def init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+def write_topology(tmp_path: Path, topology: str) -> Path:
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent(topology).strip() + '\n')
+  return topo_file
+
+
+def test_kne_renders_native_nxos_vpc(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ lag ]
+
+nodes:
+  s1: { device: nxos }
+  s2: { device: nxos }
+  c1: { device: ioll2 }
+
+links:
+- lag:
+    members:
+    - s1: { ifindex: 1 }
+      s2: { ifindex: 1 }
+    - s1: { ifindex: 2 }
+      s2: { ifindex: 2 }
+    mlag:
+      peergroup: 10
+      peer_switch: true
+      peer_gateway: true
+      layer3_peer_router: true
+- prefix: false
+  lag.members: [ c1-s1, c1-s2 ]
+""")
+
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  startup = Path('node_files/s1/startup-config').read_text()
+  assert 'feature lacp\nfeature vpc' in startup
+  assert 'vpc domain 10\n peer-switch\n peer-gateway\n layer3 peer-router' in startup
+  assert 'interface port-channel4096' in startup
+  assert ' spanning-tree port type network\n vpc peer-link' in startup
+  assert startup.count(' channel-group 4096 mode active') == 2
+  assert 'interface port-channel1\n description s1 -> [c1,s2] (vPC 1)\n switchport\n vpc 1' in startup
+  assert 'interface Ethernet1/3\n description s1 -> c1 in channel-group 1\n switchport\n channel-group 1 mode active' in startup
+
+  provider_text = Path('topology.pb.txt').read_text()
+  assert 'name: "s1"\n  vendor: CISCO\n  model: "nxos"' in provider_text
+  assert provider_text.count('links: {') == 4
+
+
+def test_mlag_domain_options_are_device_capabilities(tmp_path: Path) -> None:
+  topo_file = write_topology(tmp_path,"""
+module: [ lag ]
+defaults.device: eos
+nodes: [ s1, s2 ]
+links:
+- lag:
+    members: [ s1-s2 ]
+    mlag:
+      peergroup: 10
+      peer_gateway: true
+""")
+
+  init_log(raise_error=True)
+  topology = _read.load(str(topo_file),relative_topo_name=True,user_defaults=[])
+  try:
+    augment.main.transform(topology)
+  except log.ErrorAbort:
+    assert 'does not support lag.mlag.peer_gateway' in '\n'.join(log.get_error_log())
+  else:
+    raise AssertionError('unsupported MLAG domain option was accepted')
