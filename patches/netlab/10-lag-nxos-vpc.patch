diff --git a/netsim/modules/lag.py b/netsim/modules/lag.py
index de74482..4d91255 100644
--- a/netsim/modules/lag.py
+++ b/netsim/modules/lag.py
@@ -13,6 +13,7 @@ ID_SET = 'lag_id'
 PEERLINK_ID_SET = 'peerlink_id'
 
 PEERLINK_ID_ATT = 'lag.mlag.peergroup'
+MLAG_DOMAIN_ATTR = [ 'peer_switch', 'peer_gateway', 'layer3_peer_router' ]
 
 """
 populate_lag_id_set -- Collect any user defined lag.ifindex values globally and initialize ID generator
@@ -103,6 +104,19 @@ def check_mside_lag_support(node: str, linkname: str, topology: Box) -> bool:
     return False
   return True
 
+"""
+check_mlag_domain_support - check device support for optional MLAG domain settings
+"""
+def check_mlag_domain_support(node: Box, intf: Box, features: Box) -> None:
+  supported = features.get('lag.mlag.domain',[])
+  for attr in MLAG_DOMAIN_ATTR:
+    if not intf.get(f'lag.mlag.{attr}',False) or attr in supported:
+      continue
+    log.error(
+      f'Node {node.name} ({node.device}) does not support lag.mlag.{attr}',
+      category=log.IncorrectAttr,
+      module='lag')
+
 """
 normalized_members - builds a normalized list of lag member links. It also checks that:
 
@@ -472,6 +486,7 @@ class LAG(_Module):
     uses_esi_lag = False
     for i in node.interfaces:
       if i.get(PEERLINK_ID_ATT,None):          # Fill in peer loopback IP and vMAC for MLAG peer links
+        check_mlag_domain_support(node,i,features)
         populate_mlag_peer(node,i,topology)
         has_peerlink = True
       elif i.type=='lag':
