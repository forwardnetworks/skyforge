index 0000000..af3385f
--- /dev/null
+++ b/tests/integration/multicast/01-eos-basic.yml
@@ -0,0 +1,49 @@
+---
+message: |
+  Use this topology to test basic Arista EOS IPv4 multicast configuration.
+  The validation checks whether the DUT has multicast routing, PIM, RP,
+  static IGMP group, router-alert, and static multicast route configuration.
+
+defaults.sources.extra: [ ../wait_times.yml, ../warnings.yml ]
+
+provider: clab
+module: [ multicast ]
+defaults.device: eos
+
+multicast:
+  rp:
+  - address: 1.1.2.1
+    group: 224.1.1.1/32
+  static:
+  - source: 3.3.3.0/24
+    next_hop: 2.2.2.2
+
+nodes:
+  dut:
+    loopback.ipv4: 1.1.2.1/32
+
+links:
+- dut:
+    ipv4: 1.1.1.1/30
+    multicast:
+      igmp:
+        router_alert: true
+        groups: [ 224.1.1.1 ]
+- dut:
+    ipv4: 2.2.2.1/30
+    multicast: true
+
+validate:
+  config:
+    description: Check EOS multicast configuration
+    nodes: [ dut ]
+    devices: [ eos ]
+    exec: show running-config
+    valid: >-
+      'router multicast' in stdout and
+      'rpf route 3.3.3.0/24 2.2.2.2' in stdout and
+      'router pim sparse-mode' in stdout and
+      'rp address 1.1.2.1 224.1.1.1/32' in stdout and
+      'ip igmp static-group 224.1.1.1' in stdout and
+      'ip igmp router-alert optional' in stdout and
+      'pim ipv4 sparse-mode' in stdout
