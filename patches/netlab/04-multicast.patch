diff --git a/netsim/modules/multicast.py b/netsim/modules/multicast.py
new file mode 100644
index 0000000..3a17ddf
--- /dev/null
+++ b/netsim/modules/multicast.py
@@ -0,0 +1,145 @@
+#
+# IPv4 multicast transformation module
+#
+
+import ipaddress
+import typing
+
+from box import Box
+
+from .. import data
+from ..augment import devices
+from ..utils import log
+from . import _Module, _routing
+
+
+def _rp_instances(node: Box) -> typing.Generator:
+  if isinstance(node.get("multicast", None), Box):
+    yield (node.multicast, "global")
+
+  for vname, vdata in node.get("vrfs", {}).items():
+    if isinstance(vdata.get("multicast", None), Box):
+      yield (vdata.multicast, f"VRF {vname}")
+
+
+def _multicast_group(value: str) -> bool:
+  net = ipaddress.ip_network(value)
+  return isinstance(net, ipaddress.IPv4Network) and net.subnet_of(ipaddress.IPv4Network("224.0.0.0/4"))
+
+
+def _unicast_source(value: str) -> bool:
+  return not ipaddress.ip_network(value).overlaps(ipaddress.ip_network("224.0.0.0/4"))
+
+
+def _normalize_interface(intf: Box, node: Box) -> None:
+  if "multicast" not in intf:
+    return
+
+  if intf.multicast is True:
+    intf.multicast = data.get_empty_box()
+  if not isinstance(intf.multicast, Box):
+    intf.pop("multicast", None)
+    return
+
+  src = node.multicast
+  if intf.get("vrf", None) and isinstance(node.vrfs[intf.vrf].get("multicast", None), Box):
+    src = node.vrfs[intf.vrf].multicast
+
+  if "mode" not in intf.multicast and "mode" in src:
+    intf.multicast.mode = src.mode
+
+
+def _check_mode(node: Box, features: Box, mode: str, where: str) -> None:
+  if mode not in features.multicast.get("modes", []):
+    log.error(
+      f"Device {node.device} (node {node.name}) does not support multicast mode {mode}",
+      category=log.IncorrectValue,
+      module="multicast",
+      more_data=where,
+    )
+
+
+def _check_rp(node: Box, features: Box) -> None:
+  for mdata, where in _rp_instances(node):
+    if mdata.get("rp", []) and not features.multicast.get("rp", False):
+      log.error(
+        f"Device {node.device} (node {node.name}) does not support static multicast RP configuration",
+        category=log.IncorrectValue,
+        module="multicast",
+        more_data=where,
+      )
+      continue
+
+    for rp in mdata.get("rp", []):
+      if not _multicast_group(rp.group):
+        log.error(
+          f"Multicast RP group {rp.group} on node {node.name} is not an IPv4 multicast prefix",
+          category=log.IncorrectValue,
+          module="multicast",
+          more_data=where,
+        )
+      if rp.get("bidir", False) and not features.multicast.get("bidir", False):
+        log.error(
+          f"Device {node.device} (node {node.name}) does not support bidirectional PIM",
+          category=log.IncorrectValue,
+          module="multicast",
+          more_data=where,
+        )
+
+
+def _check_static(node: Box, features: Box) -> None:
+  for mdata, where in _rp_instances(node):
+    if mdata.get("static", []) and not features.multicast.get("static", False):
+      log.error(
+        f"Device {node.device} (node {node.name}) does not support static multicast routes",
+        category=log.IncorrectValue,
+        module="multicast",
+        more_data=where,
+      )
+      continue
+
+    for route in mdata.get("static", []):
+      if not _unicast_source(route.source):
+        log.error(
+          f"Static multicast source {route.source} on node {node.name} cannot be a multicast prefix",
+          category=log.IncorrectValue,
+          module="multicast",
+          more_data=where,
+        )
+
+
+class Multicast(_Module):
+  def node_post_transform(self, node: Box, topology: Box) -> None:
+    features = devices.get_device_features(node, topology.defaults)
+
+    for intf in node.get("interfaces", []):
+      if _routing.external(intf, "multicast"):
+        continue
+      if "multicast" in intf and "ipv4" not in intf:
+        intf.pop("multicast", None)
+        continue
+      _normalize_interface(intf, node)
+
+    if any("vrf" in intf and "multicast" in intf for intf in node.get("interfaces", [])) and not features.multicast.get(
+      "vrf", False
+    ):
+      log.error(
+        f"Device {node.device} (node {node.name}) does not support multicast in VRFs",
+        category=log.IncorrectValue,
+        module="multicast",
+      )
+
+    for intf in node.get("interfaces", []):
+      if "multicast" not in intf:
+        continue
+      _check_mode(node, features, intf.multicast.mode, f"interface {intf.ifname} ({intf.name})")
+      if intf.get("multicast.igmp", {}) and not features.multicast.get("igmp", False):
+        log.error(
+          f"Device {node.device} (node {node.name}) does not support IGMP multicast options",
+          category=log.IncorrectValue,
+          module="multicast",
+          more_data=f"interface {intf.ifname} ({intf.name})",
+        )
+
+    _check_rp(node, features)
+    _check_static(node, features)
diff --git a/netsim/modules/multicast.yml b/netsim/modules/multicast.yml
new file mode 100644
index 0000000..9872ef2
--- /dev/null
+++ b/netsim/modules/multicast.yml
@@ -0,0 +1,78 @@
+# IPv4 multicast default settings and attributes
+#
+---
+transform_after: [ vlan, vrf ]
+config_after: [ vlan, vrf, routing ]
+mode: sparse
+
+attributes:
+  can_be_true: [ link, interface ]
+  global:
+    mode: { type: str, valid_values: [ sparse, sparse-dense, bidir ] }
+    rp:
+      type: list
+      make_list: True
+      _subtype: _multicast_rp
+    static:
+      type: list
+      make_list: True
+      _subtype: _multicast_static
+  node:
+    mode: { copy: global }
+    rp: { copy: global }
+    static: { copy: global }
+  vrf:
+    mode: { copy: global }
+    rp: { copy: global }
+    static: { copy: global }
+  link:
+    _alt_types: [ bool ]
+    mode: { type: str, valid_values: [ sparse, sparse-dense, bidir ] }
+    igmp:
+      router_alert: bool
+      groups:
+        type: list
+        make_list: True
+        _subtype: { type: ipv4, use: address }
+  interface:
+    _alt_types: [ bool ]
+    mode: { type: str, valid_values: [ sparse, sparse-dense, bidir ] }
+    igmp:
+      router_alert: bool
+      groups:
+        type: list
+        make_list: True
+        _subtype: { type: ipv4, use: address }
+
+_top:
+  attributes:
+    _multicast_rp:
+      address:
+        type: ipv4
+        use: address
+        _required: True
+      group:
+        type: ipv4
+        use: prefix
+        _required: True
+      override: bool
+      bidir: bool
+    _multicast_static:
+      source:
+        type: ipv4
+        use: prefix
+        _required: True
+      next_hop:
+        type: ipv4
+        use: address
+        _required: True
+
+features:
+  mode: PIM interface modes
+  rp: Static rendezvous points
+  static: Static multicast RPF routes
+  vrf: VRF multicast routing
+  igmp: IGMP interface options
+
+warnings:
+  inactive: True
