From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] multicast: PIM sparse/bidir, IGMP, static RP

---
diff --git a/docs/netlab-multicast-plan.md b/docs/netlab-multicast-plan.md
new file mode 100644
index 0000000..632235b
--- /dev/null
+++ b/docs/netlab-multicast-plan.md
@@ -0,0 +1,27 @@
+# Netlab Multicast Plan
+
+## Summary
+
+Add IPv4 multicast support to the vendored netlab tree for the platform, scoped to Cisco IOL and Arista EOS. The goal is configuration parity with multicast behavior the collector already parses: PIM, static RP, IGMP receiver joins, VRF multicast, static multicast RPF routes, and EOS bidirectional PIM.
+
+## Implementation
+
+- Add a `multicast` module with node, VRF, and interface attributes for PIM mode, static RP entries, static multicast routes, and IGMP options.
+- Enable the module only on `iol` and `eos`; explicitly keep `ioll2` unsupported.
+- Render IOS/IOL commands with `ip multicast-routing`, `ip pim rp-address`, interface `ip pim ...-mode`, IGMP options, and `ip mroute`.
+- Render EOS commands with `router multicast`, `router pim sparse-mode` or `router pim bidirectional`, interface PIM/IGMP commands, and static mroutes.
+- Validate multicast group prefixes, non-multicast RPF source prefixes, unsupported PIM modes, unsupported VRF multicast, and unsupported bidir use.
+
+## Tests
+
+- Add focused pytest coverage for IOL transform and rendered config.
+- Add EOS rendered-config coverage for VRF multicast and bidirectional PIM.
+- Run targeted multicast tests plus the documented transform/error test slice when a Python 3.10+ environment with test dependencies is available.
+
+## Out Of Scope
+
+- IPv6 PIM and MLD.
+- MSDP.
+- NX-OS TRM or MVPN.
+- IGMP snooping-only Layer 2 behavior.
+- Live multicast traffic validation.
diff --git a/netsim/ansible/templates/multicast/eos.j2 b/netsim/ansible/templates/multicast/eos.j2
new file mode 100644
index 0000000..f57d8de
--- /dev/null
+++ b/netsim/ansible/templates/multicast/eos.j2
@@ -0,0 +1,53 @@
+!
+{% if multicast is defined or vrfs|default({})|selectattr('multicast','defined')|list %}
+router multicast
+{%   if multicast is defined %}
+  ipv4
+    routing
+{%   endif %}
+{%   for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+  vrf {{ vname }}
+    ipv4
+      routing
+{%   endfor %}
+!
+{% endif %}
+{% set pim = namespace(bidir=false) %}
+{% for rp in multicast.rp|default([]) if rp.bidir|default(False) %}
+{%   set pim.bidir = true %}
+{% endfor %}
+{% for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+{%   for rp in vdata.multicast.rp|default([]) if rp.bidir|default(False) %}
+{%     set pim.bidir = true %}
+{%   endfor %}
+{% endfor %}
+router pim {{ 'bidirectional' if pim.bidir else 'sparse-mode' }}
+{% for rp in multicast.rp|default([]) %}
+  ip pim rp-address {{ rp.address }} {{ rp.group }}{{ ' bidir' if rp.bidir|default(False) else '' }}
+{% endfor %}
+{% for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+  vrf {{ vname }}
+{%   for rp in vdata.multicast.rp|default([]) %}
+    ip pim rp-address {{ rp.address }} {{ rp.group }}{{ ' bidir' if rp.bidir|default(False) else '' }}
+{%   endfor %}
+{% endfor %}
+!
+{% for intf in netlab_interfaces if intf.multicast is defined %}
+interface {{ intf.ifname }}
+ ip pim {{ 'bidirectional' if intf.multicast.mode == 'bidir' else intf.multicast.mode + '-mode' }}
+{%   if intf.multicast.igmp.router_alert|default(False) %}
+ ip igmp router-alert optional
+{%   endif %}
+{%   for group in intf.multicast.igmp.groups|default([]) %}
+ ip igmp static-group {{ group }}
+{%   endfor %}
+!
+{% endfor %}
+{% for route in multicast.static|default([]) %}
+ip mroute {{ route.source }} {{ route.next_hop }}
+{% endfor %}
+{% for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+{%   for route in vdata.multicast.static|default([]) %}
+ip mroute vrf {{ vname }} {{ route.source }} {{ route.next_hop }}
+{%   endfor %}
+{% endfor %}
diff --git a/netsim/ansible/templates/multicast/ios.j2 b/netsim/ansible/templates/multicast/ios.j2
new file mode 100644
index 0000000..c418040
--- /dev/null
+++ b/netsim/ansible/templates/multicast/ios.j2
@@ -0,0 +1,41 @@
+!
+{% if multicast is defined %}
+ip multicast-routing
+{% endif %}
+{% for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+ip multicast-routing vrf {{ vname }} DISTRIBUTED
+{% endfor %}
+!
+{% set acl = namespace(id=79) %}
+{% for rp in multicast.rp|default([]) %}
+{%   set acl.id = acl.id + 1 %}
+access-list {{ acl.id }} permit {{ rp.group|ansible.utils.ipaddr('address') }}
+ip pim rp-address {{ rp.address }} {{ acl.id }}{{ ' override' if rp.override|default(False) else '' }}
+{% endfor %}
+{% for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+{%   for rp in vdata.multicast.rp|default([]) %}
+{%     set acl.id = acl.id + 1 %}
+access-list {{ acl.id }} permit {{ rp.group|ansible.utils.ipaddr('address') }}
+ip pim vrf {{ vname }} rp-address {{ rp.address }} {{ acl.id }}{{ ' override' if rp.override|default(False) else '' }}
+{%   endfor %}
+{% endfor %}
+!
+{% for intf in netlab_interfaces if intf.multicast is defined %}
+interface {{ intf.ifname }}
+ ip pim {{ intf.multicast.mode }}-mode
+{%   if intf.multicast.igmp.router_alert|default(False) and netlab_device_type|default('') != 'iol' %}
+ ip igmp router-alert optional
+{%   endif %}
+{%   for group in intf.multicast.igmp.groups|default([]) %}
+ ip igmp join-group {{ group }}
+{%   endfor %}
+!
+{% endfor %}
+{% for route in multicast.static|default([]) %}
+ip mroute {{ route.source|ansible.utils.ipaddr('network') }} {{ route.source|ansible.utils.ipaddr('netmask') }} {{ route.next_hop }}
+{% endfor %}
+{% for vname,vdata in vrfs|default({})|dictsort if vdata.multicast is defined %}
+{%   for route in vdata.multicast.static|default([]) %}
+ip mroute vrf {{ vname }} {{ route.source|ansible.utils.ipaddr('network') }} {{ route.source|ansible.utils.ipaddr('netmask') }} {{ route.next_hop }}
+{%   endfor %}
+{% endfor %}
