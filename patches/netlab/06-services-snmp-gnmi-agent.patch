diff --git a/netsim/ansible/templates/services/fortinet.fortios.fortios.j2 b/netsim/ansible/templates/services/fortinet.fortios.fortios.j2
new file mode 100644
index 0000000..7e8f9f1
--- /dev/null
+++ b/netsim/ansible/templates/services/fortinet.fortios.fortios.j2
@@ -0,0 +1,27 @@
+{% if services.server.snmp is defined %}
+{#
+    SNMP agent, ported VERBATIM from the snmp_config custom config module so the
+    generated configuration is byte-for-byte what this platform emitted before.
+    The only change is that the community is a parameter, defaulting to
+    `skyforge` -- the community the collector's collectors poll with. Any other default
+    leaves every device reachable and unpollable.
+#}
+config system interface
+  edit "port1"
+    set allowaccess ping http https ssh snmp
+  next
+end
+config system snmp sysinfo
+  set status enable
+end
+config system snmp community
+  edit 1
+    set name "{{ services.server.snmp.community|default('skyforge') }}"
+    config hosts
+      edit 1
+        set ip 0.0.0.0 0.0.0.0
+      next
+    end
+  next
+end
+{% endif %}
