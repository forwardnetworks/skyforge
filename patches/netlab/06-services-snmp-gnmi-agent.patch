diff --git a/netsim/ansible/templates/services/sros.j2 b/netsim/ansible/templates/services/sros.j2
index d406406..7b711b5 100644
--- a/netsim/ansible/templates/services/sros.j2
+++ b/netsim/ansible/templates/services/sros.j2
@@ -1,3 +1,19 @@
+{#
+    SR OS services configuration -- ONE gNMI document.
+
+    SR OS is deployed by tasks/deploy-config/sros.yml, which does
+    `yaml_config | from_yaml` and applies cfg.updates / delete / replace. That
+    makes this file a single YAML DOCUMENT, not a concatenation of blocks: two
+    top-level `updates:` keys do not merge, the second WINS, and the first
+    service's configuration is silently lost. So every service contributes
+    entries to one list, and every platform detail below is inside it.
+
+    It also means CLI text cannot be used here at all. `/configure ...` parses as
+    a plain string, and the deploy task guards `cfg.updates is not string`, so it
+    would be skipped without error -- which is exactly what the old
+    gnmi_config/sros.j2 did: SR OS gNMI was never actually applied.
+#}
+{% if services.syslog._server_list is defined or services.server.snmp is defined or services.server.gnmi is defined %}
 updates:
 {% if services.syslog._server_list is defined %}
 - path: configure/log
@@ -9,8 +25,16 @@ updates:
 {%   for syslog_host in services.syslog._server_list %}
     - syslog-name: "{{ syslog_host }}"
       address: "{{ syslog_host }}"
+{#     `log syslog <n> hostname` does not exist on SR OS 22.x: 22.10 rejects the
+       whole configure/log update ("MINOR: MGMT_CORE #2201: .../hostname - Unknown
+       element"), measured 2026-09-30 on the KubeVirt vr-sros 22.10 pair. The KNE
+       provider publishes the release it reads from the image tag as
+       kne.sros_version_major; an unknown release (0, or no KNE data) keeps
+       upstream's behaviour. #}
+{%     if (kne.sros_version_major|default(0)|int) == 0 or (kne.sros_version_major|int) >= 23 %}
       hostname:
         use-system-name: {}
+{%     endif %}
 {%   endfor %}
     log-id:
 {%   for syslog_host in services.syslog._server_list %}
@@ -25,3 +49,32 @@ updates:
         syslog: "{{ syslog_host }}"
 {%   endfor %}
 {% endif %}
+{% if services.server.snmp is defined %}
+- path: configure/system/management-interface/snmp
+  val:
+    packet-size: 9216
+    streaming:
+      admin-state: enable
+- path: configure/system/security/user-params/local-user/user[user-name=admin]
+  val:
+    access:
+      console: true
+      ftp: true
+      grpc: true
+      netconf: true
+- path: configure/system/security/snmp/community[community-string={{ services.server.snmp.community|default('skyforge') }}]
+  val:
+    access-permissions: r
+    version: v2c
+{% endif %}
+{% if services.server.gnmi is defined %}
+- path: configure/system/management-interface/netconf
+  val:
+    admin-state: enable
+- path: configure/system/grpc
+  val:
+    admin-state: enable
+    gnmi:
+      admin-state: enable
+{% endif %}
+{% endif %}
diff --git a/netsim/ansible/templates/services/vjunos-router.j2 b/netsim/ansible/templates/services/vjunos-router.j2
new file mode 100644
index 0000000..9916d04
--- /dev/null
+++ b/netsim/ansible/templates/services/vjunos-router.j2
@@ -0,0 +1,32 @@
+{% if services.server.snmp is defined %}
+{#
+    SNMP agent. Junos configuration is HIERARCHICAL everywhere else in netlab
+    (initial/junos.j2, bgp/junos.j2, ... and csrx.j2 right here), and every
+    module fragment is concatenated into ONE juniper.conf. A `set ...` line
+    inside that file is a syntax error: mgd rejects the WHOLE file and boots the
+    FACTORY configuration -- no management address, no ssh, nothing for the collector
+    to collect. Measured 2026-08-28 on demo-lab, where all four vJunos came
+    up amnesiac. The community defaults to `skyforge`, the community the collector's
+    collectors poll with; any other default leaves every device reachable and
+    unpollable.
+#}
+snmp {
+  {#
+      The management interface (fxp0) lives in the mgmt_junos routing
+      instance -- Skyforge's initial/vjunos-*.j2 sets management-instance so
+      out-of-band default route cannot leak into the data plane. snmpd binds
+      *:161 in the DEFAULT instance and, without this statement, silently
+      drops every request that arrives on fxp0. Measured 2026-09-07 on
+      demo-lab's four vJunos with the same community from the same probe host:
+      the loopback answered, the management address timed out, and the collector
+      read the silence as "invalid snmp credentials". Two lines: this one
+      and the community's routing-instance (alone this one left snmpd
+      counting every poll as "bad community uses", measured 2026-10-09).
+  #}
+  routing-instance-access;
+  community {{ services.server.snmp.community|default('skyforge') }} {
+    authorization read-only;
+    routing-instance mgmt_junos;
+  }
+}
+{% endif %}
