diff --git a/netsim/modules/services.yml b/netsim/modules/services.yml
index 5d2ffce..98edf46 100644
--- a/netsim/modules/services.yml
+++ b/netsim/modules/services.yml
@@ -45,6 +45,33 @@ attributes:
       syslog:
         type: bool
         _remove_when_false: True
+      # SNMP AGENT. An agent is a SERVER, not a client: it listens on 161 and
+      # answers the NMS, exactly as a DNS server answers a resolver. Modelling it
+      # as a client would also break resolve_servers, which requires every client
+      # to name a server (or an explicit address) and errors with "is neither a
+      # client nor a server" otherwise -- a lab that only wants an
+      # `snmp-server community` line has no server to name.
+      #
+      # snmp is therefore deliberately NOT in `clients` below. Trap/inform
+      # DESTINATIONS are the genuine client half and can be added later as
+      # services.snmp.server without disturbing this.
+      snmp:
+        type: dict
+        _keys:
+          community: str
+          location: str
+          contact: str
+        true_value: {}
+        _remove_when_false: True
+      # gNMI/gRPC TELEMETRY ENDPOINT. Same reasoning as snmp: the device LISTENS
+      # and a collector dials it, so it is a server. `port` is the gRPC listener
+      # port; platforms that hard-code it ignore the value.
+      gnmi:
+        type: dict
+        _keys:
+          port: int
+        true_value: {}
+        _remove_when_false: True
 
   clients:                                        # List of supported services clients
     dns:
@@ -59,4 +86,6 @@ features:
   dns: DNS client
   syslog: syslog client
   server.dns: DNS server
+  server.snmp: SNMP agent (responds to an NMS)
+  server.gnmi: gNMI/gRPC telemetry endpoint
   server.syslog: syslog server
