diff --git a/netsim/extra/firewall/policy/__init__.py b/netsim/extra/firewall/policy/__init__.py
new file mode 100644
index 0000000..f87657a
--- /dev/null
+++ b/netsim/extra/firewall/policy/__init__.py
@@ -0,0 +1,179 @@
+#
+# Firewall policy plugin
+#
+
+import re
+
+from box import Box
+
+from netsim import api
+from netsim.augment import devices
+from netsim.utils import log
+
+_config_name = "firewall.policy"
+
+# tcp/4022, udp/53, tcp/8080-8090 -- the inline form, so a one-off port does not
+# need a named service object.
+_INLINE_SERVICE = re.compile(r"^(tcp|udp)/(\d+(?:-\d+)?)$", re.IGNORECASE)
+
+# Services every platform understands without an object behind them.
+_BARE_PROTOCOLS = ("ip", "icmp", "tcp", "udp")
+
+
+def _as_list(value: object, default: str = "any") -> list:
+    if value is None:
+        return [default]
+    if isinstance(value, list):
+        return [str(v) for v in value if str(v)]
+    text = str(value).strip()
+    return [text] if text else [default]
+
+
+def _normalize_action(value: object) -> str:
+    action = str(value or "permit").strip().lower()
+    if action in ("allow", "accept"):
+        return "permit"
+    if action not in ("permit", "deny"):
+        return "permit"
+    return action
+
+
+def _has_feature(features: Box, key: str) -> bool:
+    try:
+        return bool(features.get(key, False))
+    except Exception:                                     # noqa: BLE001 - Box lookup shapes vary
+        return False
+
+
+def _service_is_resolvable(name: str, objects: dict, groups: dict = None, named_ok: bool = False, _seen: set = None) -> bool:
+    """Can a platform WITHOUT App-ID turn this service token into an ACE?
+
+    A group resolves when every member resolves (recursively, cycles refused).
+    On a platform with a predefined service catalogue (policy_named_services)
+    any bare name is accepted: the device defines it, the plugin cannot know
+    the list and must not narrow it.
+    """
+    lowered = name.strip().lower()
+    if lowered in ("any", "") or lowered in _BARE_PROTOCOLS:
+        return True
+    if _INLINE_SERVICE.match(lowered):
+        return True
+    if name in objects:
+        return True
+    groups = groups or {}
+    if name in groups:
+        _seen = set(_seen or ())
+        if name in _seen:
+            return False
+        _seen.add(name)
+        return all(_service_is_resolvable(m, objects, groups, named_ok, _seen) for m in groups[name])
+    return named_ok
+
+
+def post_transform(topology: Box) -> None:
+    for node in topology.nodes.values():
+        rules = node.get("firewall.policy.rules", [])
+        if not isinstance(rules, list) or not rules:
+            continue
+
+        features = devices.get_device_features(node, topology.defaults)
+        if "firewall.policy" not in features:
+            log.error(
+                f"Node {node.name}({node.device}) does not support firewall.policy rules",
+                category=log.IncorrectAttr,
+                module=_config_name,
+            )
+            continue
+
+        app_id = _has_feature(features, "firewall.policy_app_id")
+        named_ok = _has_feature(features, "firewall.policy_named_services")
+
+        objects = {}
+        for obj_idx, obj in enumerate(node.get("firewall.policy.service_objects", []) or []):
+            if not isinstance(obj, Box) or not obj.get("name"):
+                log.error(
+                    f"Node {node.name} firewall.policy.service_objects[{obj_idx}] needs a name",
+                    category=log.IncorrectType,
+                    module=_config_name,
+                )
+                continue
+            objects[obj.name] = obj
+
+        groups = {}
+        for grp_idx, grp in enumerate(node.get("firewall.policy.service_groups", []) or []):
+            if not isinstance(grp, Box) or not grp.get("name") or not isinstance(grp.get("members"), list):
+                log.error(
+                    f"Node {node.name} firewall.policy.service_groups[{grp_idx}] needs a name and a members list",
+                    category=log.IncorrectType,
+                    module=_config_name,
+                )
+                continue
+            groups[grp.name] = [str(m) for m in grp.members]
+
+        for adr_idx, adr in enumerate(node.get("firewall.policy.address_objects", []) or []):
+            if not isinstance(adr, Box) or not adr.get("name") or not adr.get("ipv4"):
+                log.error(
+                    f"Node {node.name} firewall.policy.address_objects[{adr_idx}] needs a name and an ipv4 value",
+                    category=log.IncorrectType,
+                    module=_config_name,
+                )
+
+        sequence = 10
+        for idx, rule in enumerate(rules):
+            if not isinstance(rule, Box):
+                log.error(
+                    f"Node {node.name} firewall.policy.rules[{idx}] must be a dictionary",
+                    category=log.IncorrectType,
+                    module=_config_name,
+                )
+                continue
+
+            rule.action = _normalize_action(rule.get("action", "permit"))
+            rule.from_zone = str(rule.get("from_zone", "any"))
+            rule.to_zone = str(rule.get("to_zone", "any"))
+            rule.src = _as_list(rule.get("src"), "any")
+            rule.dst = _as_list(rule.get("dst"), "any")
+            declared_services = rule.get("services")
+            rule.application = _as_list(rule.get("application"), "any")
+            # A rule that names an application and no service means "this
+            # application, on the ports it normally uses" -- PAN-OS spells that
+            # `application-default`. Defaulting to `any` instead would widen the
+            # rule to that application on EVERY port, which is not what the
+            # author wrote. Same default the firewall.zonebased PAN-OS path uses.
+            if declared_services is None and rule.application != ["any"]:
+                rule.services = ["application-default"]
+            else:
+                rule.services = _as_list(declared_services, "any")
+            rule.log = bool(rule.get("log", True))
+            rule.nat = bool(rule.get("nat", False))
+            rule.setdefault("name", f"policy_{idx + 1}")
+            rule.setdefault("sequence", sequence)
+            sequence += 10
+
+            # An application match that the platform cannot make is not a
+            # warning: rendering the rule without it changes what the rule
+            # PERMITS. Fail the build instead.
+            if rule.application != ["any"] and not app_id:
+                log.error(
+                    f"Node {node.name}({node.device}) cannot match on application "
+                    f"{rule.application} in firewall.policy.rules[{idx}] ({rule.name}): "
+                    "the platform has no App-ID. Express the intent as a service "
+                    "(protocol/port) instead, or move the rule to a device that has one.",
+                    category=log.IncorrectAttr,
+                    module=_config_name,
+                )
+
+            # Likewise, a platform without App-ID builds its ACE from the
+            # service, so an unresolvable service name renders nothing at all.
+            if not app_id:
+                for svc in rule.services:
+                    if not _service_is_resolvable(svc, objects, groups, named_ok):
+                        log.error(
+                            f"Node {node.name}({node.device}) cannot resolve service '{svc}' in "
+                            f"firewall.policy.rules[{idx}] ({rule.name}): name it in "
+                            "firewall.policy.service_objects or service_groups, or write it inline as tcp/PORT.",
+                            category=log.IncorrectAttr,
+                            module=_config_name,
+                        )
+
+        api.node_config(node, _config_name)
diff --git a/netsim/extra/firewall/policy/asa.j2 b/netsim/extra/firewall/policy/asa.j2
new file mode 100644
index 0000000..718a8a9
--- /dev/null
+++ b/netsim/extra/firewall/policy/asa.j2
@@ -0,0 +1,96 @@
+{#
+    Cisco ASA firewall.policy.
+
+    The ASA has no zone object: an interface's `nameif` IS its zone, and an ACL
+    is bound to one interface in one direction. from_zone therefore selects the
+    interface the ACL is applied INBOUND on, and every rule sharing a from_zone
+    lands in that interface's ACL, in declared order -- which is what makes rule
+    ORDER meaningful here, exactly as it is on PAN-OS.
+
+    nameif and security-level are set by the initial config from
+    `firewall.zone` / `firewall.security_level`, not here: changing an
+    interface's nameif after the fact makes the ASA discard the configuration
+    already attached to the old name, including the ACL this template binds.
+#}
+{% set svcmap = {} %}
+{% for obj in firewall.policy.service_objects | default([]) %}
+{%   set _ = svcmap.update({obj.name: obj}) %}
+{% endfor %}
+{#
+  Service GROUPS are flattened into their members here, one ACE per member:
+  the ASA object-group form would need `object-group service` plus a
+  protocol-qualified reference, and a flat ACE list is what the plugin's
+  resolvability check already validated member by member. Two levels of
+  nesting are enough for every group a seed has shown so far.
+#}
+{% set grpmap = {} %}
+{% for grp in firewall.policy.service_groups | default([]) %}
+{%   set _ = grpmap.update({grp.name: grp.members}) %}
+{% endfor %}
+{% macro expand(lst) -%}
+{%- set out = [] -%}
+{%- for s in lst -%}
+{%-   if s in grpmap -%}
+{%-     for m in grpmap[s] -%}
+{%-       if m in grpmap -%}
+{%-         for mm in grpmap[m] -%}{%- set _ = out.append(mm) -%}{%- endfor -%}
+{%-       else -%}{%- set _ = out.append(m) -%}
+{%-       endif -%}
+{%-     endfor -%}
+{%-   else -%}{%- set _ = out.append(s) -%}
+{%-   endif -%}
+{%- endfor -%}
+{{ out | join(',') }}
+{%- endmacro %}
+{% macro addr(a) %}
+{%- set t = a | lower -%}
+{%- if t in ['any','any4','0.0.0.0/0'] -%}any
+{%- elif '/' in a -%}
+{%- if a.endswith('/32') -%}host {{ a.split('/')[0] }}
+{%- else -%}{{ a | ipaddr('network') }} {{ a | ipaddr('netmask') }}
+{%- endif -%}
+{%- else -%}host {{ a }}
+{%- endif -%}
+{% endmacro %}
+{% macro svc_proto(s) %}
+{%- set t = s | lower -%}
+{%- if t == 'any' -%}ip
+{%- elif t in ['ip','icmp','tcp','udp'] -%}{{ t }}
+{%- elif '/' in t -%}{{ t.split('/')[0] }}
+{%- elif s in svcmap -%}{{ svcmap[s].protocol }}
+{%- else -%}ip
+{%- endif -%}
+{% endmacro %}
+{% macro svc_port(s) %}
+{%- set t = s | lower -%}
+{%- if '/' in t -%}
+{%- set p = t.split('/')[1] -%}
+{%- if '-' in p %} range {{ p.split('-')[0] }} {{ p.split('-')[1] }}{% else %} eq {{ p }}{% endif -%}
+{%- elif s in svcmap -%}
+{%- set p = svcmap[s].port | string -%}
+{%- if '-' in p %} range {{ p.split('-')[0] }} {{ p.split('-')[1] }}{% else %} eq {{ p }}{% endif -%}
+{%- endif -%}
+{% endmacro %}
+{% if firewall.policy.same_security_traffic | default(false) %}
+same-security-traffic permit inter-interface
+{% endif %}
+{% set zones = [] %}
+{% for policy in firewall.policy.rules | default([]) %}
+{%   if policy.from_zone not in zones %}
+{%     set _ = zones.append(policy.from_zone) %}
+{%   endif %}
+{% endfor %}
+{% for zone in zones %}
+{%   set aclname = (zone | upper) ~ '-IN' %}
+{%   for policy in firewall.policy.rules | default([]) if policy.from_zone == zone %}
+{%     for src in policy.src | default(['any']) %}
+{%       for dst in policy.dst | default(['any']) %}
+{%         for svc in (expand(policy.services | default(['any'])) | trim).split(',') %}
+access-list {{ aclname }} extended {{ policy.action }} {{ svc_proto(svc) | trim }} {{ addr(src) | trim }} {{ addr(dst) | trim }}{{ svc_port(svc) }}{% if policy.icmp_type is defined and svc_proto(svc) | trim == 'icmp' %} {{ policy.icmp_type }}{% endif %}{% if policy.log | default(true) %} log{% endif %}
+
+{%         endfor %}
+{%       endfor %}
+{%     endfor %}
+{%   endfor %}
+access-group {{ aclname }} in interface {{ zone }}
+{% endfor %}
diff --git a/netsim/extra/firewall/policy/defaults.yml b/netsim/extra/firewall/policy/defaults.yml
new file mode 100644
index 0000000..fcf4cb0
--- /dev/null
+++ b/netsim/extra/firewall/policy/defaults.yml
@@ -0,0 +1,131 @@
+# firewall.policy
+#
+---
+devices:
+  # asav: added by Skyforge. The ASA has no App-ID, so it deliberately does NOT
+  # get firewall.policy_app_id -- see the comment on panos below.
+  asav:
+    features.firewall.policy: True
+  fortios:
+    features.firewall.policy: True
+    # FortiOS ships a catalogue of predefined service objects (HTTP, HTTPS,
+    # SSH, DNS, LDAPS ...) that a policy may name without defining. Without
+    # this flag the plugin's non-App-ID resolvability check rejected every
+    # such name and blueprint authors flattened the seed's `set service "HTTP
+    # and HTTPS"` into inline ports or widened it to `any` -- which is exactly
+    # the fidelity loss the check exists to prevent. Named services are
+    # emitted verbatim; groups and custom objects declared in this plugin are
+    # rendered as objects first (fortios.j2).
+    features.firewall.policy_named_services: True
+  panos:
+    features.firewall.policy: True
+    # PAN-OS classifies traffic by App-ID, and `application:` on a rule is only
+    # meaningful where the platform actually does that. It is a SEPARATE feature
+    # flag rather than an implied part of firewall.policy because dropping an
+    # application match silently INVERTS the author's intent: a rule that reads
+    # "deny ssh" becomes "deny nothing", and a rule that reads "permit
+    # web-browsing" becomes "permit every port the service list allows". The
+    # plugin therefore hard-errors on `application:` for a device without this
+    # flag instead of rendering something weaker than what was written.
+    features.firewall.policy_app_id: True
+  none:
+    features.firewall.policy: True
+    features.firewall.policy_app_id: True
+    features.firewall.policy_named_services: True
+
+attributes:
+  node:
+    firewall.policy:
+      rules: { type: list, _subtype: _fw_policy_rule }
+      # Named service objects. PAN-OS needs the object to exist before a rule
+      # can reference it by name, and the ASA needs the protocol/port pair to
+      # build an ACE at all, so both consumers read this same list.
+      service_objects: { type: list, _subtype: _fw_policy_service }
+      # Named service GROUPS (FortiOS `config firewall service group`, PAN-OS
+      # `set service-group`, ASA object-group service). A rule that names a
+      # group keeps the group: the ASA template expands members into ACEs,
+      # FortiOS and PAN-OS emit the group object and reference it by name.
+      # Members are service_objects names, inline tcp|udp/PORT forms, other
+      # groups, or (on policy_named_services platforms) predefined names.
+      service_groups: { type: list, _subtype: _fw_policy_service_group }
+      # Named address objects for platforms that cannot take a prefix inline
+      # (FortiOS `set srcaddr`/`set dstaddr` need an address object). A rule's
+      # src/dst may still be a bare prefix or host: fortios.j2 generates the
+      # object for it, named after the prefix.
+      address_objects: { type: list, _subtype: _fw_policy_address }
+      # ASA only: interfaces at EQUAL security levels cannot talk without this.
+      # It is a node-wide switch on the platform, not a per-rule one.
+      same_security_traffic: bool
+  interface:
+    # The ASA has no zone construct: an interface's `nameif` IS its zone, and
+    # rules reference that name. Declaring the zone on the interface is what
+    # lets from_zone/to_zone resolve to a real interface on that platform.
+    firewall.zone: { type: id }
+    firewall.security_level: { type: int, min_value: 0, max_value: 100 }
+
+  _fw_policy_service:
+    name:
+      type: str
+      _required: true
+    protocol:
+      type: str
+      _required: true
+      valid_values: [ tcp, udp ]
+    # str, not int: PAN-OS and the ASA both accept ranges ("8080-8090"), and an
+    # int type would reject them at validation time.
+    port:
+      type: str
+      _required: true
+    description: str
+
+  _fw_policy_service_group:
+    name:
+      type: str
+      _required: true
+    members:
+      type: list
+      _subtype: str
+      _required: true
+    description: str
+
+  _fw_policy_address:
+    name:
+      type: str
+      _required: true
+    # a prefix (10.1.0.0/16), a host (10.1.1.1/32) or a range (10.1.1.1-10.1.1.9)
+    ipv4:
+      type: str
+      _required: true
+    description: str
+
+  _fw_policy_rule:
+    name: str
+    sequence: int
+    action:
+      type: str
+      _required: true
+      valid_values: [ permit, deny ]
+    from_zone:
+      type: id
+      _required: true
+    to_zone:
+      type: id
+      _required: true
+    src:
+      type: list
+      _subtype: str
+    dst:
+      type: list
+      _subtype: str
+    services:
+      type: list
+      _subtype: str
+    application:
+      type: list
+      _subtype: str
+    # ICMP message type, for platforms that filter on it (ASA writes it as the
+    # last token of the ACE, e.g. `permit icmp any any echo-reply`). PAN-OS
+    # expresses the same intent as an App-ID and ignores this.
+    icmp_type: str
+    log: bool
+    nat: bool
diff --git a/netsim/extra/firewall/policy/fortios.j2 b/netsim/extra/firewall/policy/fortios.j2
new file mode 100644
index 0000000..485e41b
--- /dev/null
+++ b/netsim/extra/firewall/policy/fortios.j2
@@ -0,0 +1,158 @@
+{#
+  firewall.policy on FortiOS.
+
+  OBJECTS FIRST. A FortiGate policy cannot name a prefix or a port inline:
+  `set srcaddr` / `set dstaddr` take address objects and `set service` takes
+  service objects or groups. Before this template rendered the rule lines
+  only, so a rule whose dst was a prefix or whose service was a group the
+  seed defined (`"HTTP and HTTPS"`) either failed on the box or had to be
+  widened to `all`/`ALL` by the author. Now:
+
+    * service_objects  -> config firewall service custom
+    * service_groups   -> config firewall service group   (members by name)
+    * address_objects  -> config firewall address
+    * a src/dst token that is a prefix, a host or a range gets an address
+      object named after itself; `any`/`all` stays the built-in `all`
+    * an inline tcp/PORT or udp/PORT service gets a custom object tcp-PORT
+    * names that are none of the above are emitted verbatim: FortiOS
+      predefines HTTP, HTTPS, SSH, DNS, LDAPS ... (policy_named_services)
+
+  from_zone/to_zone are srcintf/dstintf: an interface OR a zone object. Zones
+  come from firewall.zone on the node's interfaces; a bare interface name works
+  without it.
+
+  ZONES FIRST. A zone is a `config system zone` object, and a policy naming one
+  that does not exist fails on the box (`node_check_object fail! for name
+  LB_DMZ ... Command fail. Return code -651`). firewall.policy is rendered and
+  deployed BEFORE firewall.zonebased (in the KNE user_data and in the replay),
+  so the zones are declared here as well, ahead of the first policy. The block
+  is the same one firewall/zonebased/fortios.j2 renders; keep them identical.
+  Re-declaring a zone is idempotent (`edit` + the same `set`s).
+#}
+{% set zb_zones = {} %}
+{% for intf in interfaces|default([]) if intf.firewall.zone is defined %}
+{%   set _ = zb_zones.setdefault(intf.firewall.zone, []).append(intf.ifname) %}
+{% endfor %}
+{% set zb_intra = {} %}
+{% for rule in firewall.zonebased.default_rules|default([]) if rule.from_zone == rule.to_zone %}
+{%   set _ = zb_intra.update({ rule.from_zone: 'allow' if rule.action == 'permit' else 'deny' }) %}
+{% endfor %}
+{% if zb_zones %}
+config system zone
+{%   for zname, zifs in zb_zones.items() %}
+edit "{{ zname }}"
+set intrazone {{ zb_intra[zname]|default('deny') }}
+set interface "{{ zifs|join('" "') }}"
+next
+{%   endfor %}
+end
+{% endif %}
+{% set ns = namespace(addr=[], svc=[]) %}
+{% for rule in firewall.policy.rules | default([]) %}
+{%   for a in (rule.src | default([])) + (rule.dst | default([])) %}
+{%     if a not in ns.addr and a | lower not in ['any', 'all'] and ('/' in a or '-' in a or (a.count('.') == 3 and a.replace('.', '').isdigit())) %}
+{%       set ns.addr = ns.addr + [a] %}
+{%     endif %}
+{%   endfor %}
+{%   for s in rule.services | default([]) %}
+{%     if '/' in s and s not in ns.svc %}
+{%       set ns.svc = ns.svc + [s] %}
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+{% set svc_objects = firewall.policy.service_objects | default([]) %}
+{% set svc_groups = firewall.policy.service_groups | default([]) %}
+{% set addr_objects = firewall.policy.address_objects | default([]) %}
+{% if addr_objects or ns.addr %}
+config firewall address
+{%   for a in addr_objects %}
+edit "{{ a.name }}"
+{%     if '-' in a.ipv4 %}
+set type iprange
+set start-ip {{ a.ipv4.split('-')[0] }}
+set end-ip {{ a.ipv4.split('-')[1] }}
+{%     else %}
+set subnet {{ a.ipv4 | ipaddr('network') }} {{ a.ipv4 | ipaddr('netmask') }}
+{%     endif %}
+{%     if a.description is defined %}
+set comment "{{ a.description }}"
+{%     endif %}
+next
+{%   endfor %}
+{%   for a in ns.addr %}
+edit "{{ a }}"
+{%     if '-' in a %}
+set type iprange
+set start-ip {{ a.split('-')[0] }}
+set end-ip {{ a.split('-')[1] }}
+{%     elif '/' in a %}
+set subnet {{ a | ipaddr('network') }} {{ a | ipaddr('netmask') }}
+{%     else %}
+set subnet {{ a }} 255.255.255.255
+{%     endif %}
+set comment "generated from the inline form {{ a }}"
+next
+{%   endfor %}
+end
+{% endif %}
+{% if svc_objects or ns.svc %}
+config firewall service custom
+{%   for s in svc_objects %}
+edit "{{ s.name }}"
+set {{ s.protocol | lower }}-portrange {{ s.port }}
+{%     if s.description is defined %}
+set comment "{{ s.description }}"
+{%     endif %}
+next
+{%   endfor %}
+{%   for s in ns.svc %}
+edit "{{ s | replace('/', '-') }}"
+set {{ s.split('/')[0] | lower }}-portrange {{ s.split('/')[1] }}
+set comment "generated from the inline form {{ s }}"
+next
+{%   endfor %}
+end
+{% endif %}
+{% if svc_groups %}
+config firewall service group
+{%   for g in svc_groups %}
+edit "{{ g.name }}"
+set member "{{ g.members | map('replace', '/', '-') | join('" "') }}"
+{%     if g.description is defined %}
+set comment "{{ g.description }}"
+{%     endif %}
+next
+{%   endfor %}
+end
+{% endif %}
+{% macro addr(lst) -%}
+{%- set out = [] -%}
+{%- for a in lst | default(['all']) -%}
+{%-   set _ = out.append('all' if a | lower in ['any', 'all'] else a) -%}
+{%- endfor -%}
+{{ out | join('" "') }}
+{%- endmacro %}
+{% macro svc(lst) -%}
+{%- set out = [] -%}
+{%- for s in lst | default(['ALL']) -%}
+{%-   set _ = out.append('ALL' if s | lower in ['any', 'all', 'ip'] else s | replace('/', '-')) -%}
+{%- endfor -%}
+{{ out | join('" "') }}
