diff --git a/netsim/extra/ipsec/__init__.py b/netsim/extra/ipsec/__init__.py
new file mode 100644
index 0000000..c3f3db6
--- /dev/null
+++ b/netsim/extra/ipsec/__init__.py
@@ -0,0 +1,323 @@
+import hashlib
+import json
+import re
+import typing
+
+from box import Box
+
+from netsim import api, data
+from netsim.augment import devices
+from netsim.utils import log
+
+_config_name = "ipsec"
+
+
+def merge_data(base: typing.Optional[Box], extra: typing.Optional[Box]) -> Box:
+  if isinstance(base, Box) and isinstance(extra, Box):
+    return data.get_new_box(base) + extra
+  if isinstance(base, Box):
+    return data.get_new_box(base)
+  if isinstance(extra, Box):
+    return data.get_new_box(extra)
+  return data.get_empty_box()
+
+
+def sanitize_name(value: str) -> str:
+  return re.sub(r"[^a-zA-Z0-9._-]", "-", value)
+
+
+def build_object_name(intf: Box, suffix: str) -> str:
+  return sanitize_name(f"netlab-{intf.node}-{intf.ifname}-{suffix}")
+
+
+def profile_suffix(node: str, category: str, content: typing.Any) -> str:
+  payload = json.dumps(content, sort_keys=True, separators=(",", ":"))
+  digest = hashlib.sha1(payload.encode("utf-8")).hexdigest()[:8]
+  return sanitize_name(f"netlab-{node}-{category}-{digest}")
+
+
+def normalize_selectors(selectors: list, intf: Box) -> list:
+  result = []
+  for index, selector in enumerate(selectors, start=1):
+    name = selector.get("name", sanitize_name(f"{intf.node}-{intf.ifname}-selector-{index}"))
+    result.append(
+      data.get_box(
+        {
+          "name": name,
+          "local": selector.local,
+          "remote": selector.remote,
+        }
+      )
+    )
+
+  return result
+
+
+def append_unique_named(parent: Box, list_name: str, item: Box) -> None:
+  if list_name not in parent:
+    parent[list_name] = []
+
+  for existing in parent[list_name]:
+    if existing.name == item.name:
+      return
+
+  parent[list_name].append(item)
+
+
+def get_ike_profile_data(tunnel: Box) -> Box:
+  profile = data.get_box({"name": tunnel.ike.crypto_profile})
+  for key in ("authentication", "encryption", "dh_group", "lifetime_days", "lifetime_hours", "lifetime_minutes", "lifetime_seconds"):
+    if key in tunnel.ike:
+      profile[key] = tunnel.ike[key]
+  return profile
+
+
+def get_esp_profile_data(tunnel: Box) -> Box:
+  profile = data.get_box({"name": tunnel.esp.crypto_profile})
+  for key in ("authentication", "encryption", "dh_group", "lifetime_days", "lifetime_hours", "lifetime_minutes", "lifetime_seconds", "lifesize_gb"):
+    if key in tunnel.esp:
+      profile[key] = tunnel.esp[key]
+  return profile
+
+
+def get_transform_set_data(tunnel: Box) -> Box:
+  transform = data.get_box({"name": tunnel.esp.transform_set})
+  for key in ("authentication", "encryption"):
+    if key in tunnel.esp:
+      transform[key] = tunnel.esp[key]
+  return transform
+
+
+def get_peer_interface(link: Box, intf: Box) -> typing.Optional[Box]:
+  for peer_intf in link.interfaces:
+    if peer_intf.node != intf.node:
+      return peer_intf
+
+  return None
+
+
+def validate_ipsec_link(link: Box) -> bool:
+  if link.node_count != 2:
+    log.error(
+      f"IPsec can be used only on point-to-point tunnel links ({link._linkname})",
+      category=log.IncorrectValue,
+      module=_config_name,
+    )
+    return False
+
+  if link.type != "tunnel":
+    log.error(
+      f"IPsec can be used only on tunnel links ({link._linkname})",
+      category=log.IncorrectAttr,
+      module=_config_name,
+    )
+    return False
+
+  if "preshared_key" not in link.ipsec:
+    log.error(
+      f"Missing link-level ipsec.preshared_key on {link._linkname}",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    return False
+
+  if link.ipsec.get("mode", "route-based") == "policy-based" and "selectors" not in link.ipsec:
+    log.error(
+      f"Policy-based IPsec requires ipsec.selectors on {link._linkname}",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    return False
+
+  return True
+
+
+def validate_device_support(node: Box, features: Box, params: Box, link: Box, source_from_forward: bool = False) -> bool:
+  if "ipsec" not in features:
+    if source_from_forward:
+      log.warning(
+        text=f"Node {node.name}({node.device}) does not support IPsec tunnels on {link._linkname}",
+        module=_config_name,
+      )
+    else:
+      log.error(
+        f"Node {node.name}({node.device}) does not support IPsec tunnels on {link._linkname}",
+        category=log.IncorrectAttr,
+        module=_config_name,
+      )
+    return False
+
+  f_ipsec = features.ipsec
+  if f_ipsec is True:
+    return True
+
+  mode = params.get("mode", "route-based").replace("-", "_")
+  if not f_ipsec.get(mode, False):
+    if source_from_forward:
+      log.warning(
+        text=f"Node {node.name}({node.device}) does not support {params.get('mode', 'route-based')} IPsec on {link._linkname}",
+        module=_config_name,
+      )
+    else:
+      log.error(
+        f"Node {node.name}({node.device}) does not support {params.get('mode', 'route-based')} IPsec on {link._linkname}",
+        category=log.IncorrectAttr,
+        module=_config_name,
+      )
+    return False
+
+  ike_version = params.get("ike.version", "ikev2")
+  if "ike" in f_ipsec and ike_version not in f_ipsec.ike:
+    if source_from_forward:
+      log.warning(
+        text=f"Node {node.name}({node.device}) does not support {ike_version} IPsec on {link._linkname}",
+        module=_config_name,
+      )
+    else:
+      log.error(
+        f"Node {node.name}({node.device}) does not support {ike_version} IPsec on {link._linkname}",
+        category=log.IncorrectAttr,
+        module=_config_name,
+      )
+    return False
+
+  return True
+
+
+def build_tunnel_entry(link: Box, intf: Box, peer_intf: Box) -> typing.Optional[Box]:
+  params = merge_data(link.ipsec, intf.get("ipsec", None))
+  peer_params = merge_data(link.ipsec, peer_intf.get("ipsec", None))
+
+  if "local_interface" not in params:
+    if "local_address" not in params and "endpoint" not in params:
+      log.error(
+        f"Missing {link._linkname}.{intf.node}.ipsec.local_interface or local_address",
+        category=log.MissingValue,
+        module=_config_name,
+      )
+      return None
+
+  peer_type = params.get("peer_type", "ip")
+  peer_value = params.get("peer", None)
+  if peer_value is None and peer_type != "dynamic":
+    peer_value = peer_params.get("endpoint", None)
+
+  if peer_type != "dynamic" and peer_value is None:
+    log.error(
+      f"Cannot determine IPsec peer for {link._linkname}.{intf.node}; set ipsec.peer or remote ipsec.endpoint",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    return None
+
+  mode = params.get("mode", "route-based")
+  selectors = params.get("selectors", [])
+  if mode == "policy-based" and not selectors:
+    log.error(
+      f"Policy-based IPsec requires selectors on {link._linkname}.{intf.node}",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    return None
+
+  tunnel_name = params.get("name", link.ipsec.get("name", build_object_name(intf, "tunnel")))
+  ike_profile = params.get("ike.crypto_profile", None)
+  esp_profile = params.get("esp.crypto_profile", None)
+  ike_custom = "ike" in params and any(k != "version" and k != "enable_nat_traversal" and k != "crypto_profile" for k in params.ike.keys())
+  esp_custom = "esp" in params and any(k != "crypto_profile" for k in params.esp.keys())
+
+  entry = data.get_box(
+    {
+      "name": tunnel_name,
+      "mode": mode,
+      "ifname": intf.ifname,
+      "linkindex": intf.get("linkindex", link.linkindex),
+      "peer_type": peer_type,
+      "preshared_key": params.preshared_key,
+      "ike_gateway": build_object_name(intf, "ike"),
+      "ike": params.get("ike", data.get_empty_box()),
+      "esp": params.get("esp", data.get_empty_box()),
+    }
+  )
+
+  if peer_value is not None:
+    entry.peer = peer_value
+  if "local_interface" in params:
+    entry.local_interface = params.local_interface
+  if "local_address" in params:
+    entry.local_address = params.local_address
+  elif "endpoint" in params:
+    entry.local_address = params.endpoint
+  if "firewall.zone" in intf:
+    entry.zone_name = intf.firewall.zone
+  if "ipv4" in intf:
+    entry.ipv4 = intf.ipv4
+  if "mtu" in intf:
+    entry.mtu = intf.mtu
+  if selectors:
+    entry.selectors = normalize_selectors(selectors, intf)
+  if "local_id_type" in params:
+    entry.local_id_type = params.local_id_type
+  if "local_id_value" in params:
+    entry.local_id_value = params.local_id_value
+  if "peer_id_type" in params:
+    entry.peer_id_type = params.peer_id_type
+  if "peer_id_value" in params:
+    entry.peer_id_value = params.peer_id_value
+
+  if ike_profile:
+    entry.ike.crypto_profile = ike_profile
+  elif ike_custom:
+    entry.ike.crypto_profile = profile_suffix(intf.node, "ike-profile", entry.ike)
+    entry.ike.create_profile = True
+  else:
+    entry.ike.crypto_profile = "default"
+
+  if esp_profile:
+    entry.esp.crypto_profile = esp_profile
+  elif esp_custom:
+    entry.esp.crypto_profile = profile_suffix(intf.node, "ipsec-profile", entry.esp)
+    entry.esp.create_profile = True
+  else:
+    entry.esp.crypto_profile = "default"
+
+  if "version" not in entry.ike:
+    entry.ike.version = "ikev2"
+  entry.ike.policy_name = build_object_name(intf, "ike-policy")
+  entry.ike.keyring_name = build_object_name(intf, "ike-keyring")
+  entry.ike.profile_name = build_object_name(intf, "ikev2-profile")
+  entry.esp.transform_set = profile_suffix(intf.node, "transform-set", get_esp_profile_data(entry))
+  entry.esp.profile_name = build_object_name(intf, "ipsec-profile")
+
+  return entry
+
+
+def post_transform(topology: Box) -> None:
+  for link in topology.get("links", []):
+    if "ipsec" not in link:
+      continue
+    if not validate_ipsec_link(link):
+      continue
+
+    for intf in link.interfaces:
+      node = topology.nodes[intf.node]
+
+      peer_intf = get_peer_interface(link, intf)
+      if peer_intf is None:
+        continue
+
+      tunnel_entry = build_tunnel_entry(link, intf, peer_intf)
+      if tunnel_entry is None:
+        continue
+
+      features = devices.get_device_features(node, topology.defaults)
+      if not validate_device_support(node, features, tunnel_entry, link, source_from_forward="_forward" in node):
+        continue
+
+      data.append_to_list(node, "ipsec.tunnels", tunnel_entry)
+      if tunnel_entry.ike.get("create_profile", False):
+        append_unique_named(node.ipsec, "ike_profiles", get_ike_profile_data(tunnel_entry))
+      if tunnel_entry.esp.get("create_profile", False):
+        append_unique_named(node.ipsec, "esp_profiles", get_esp_profile_data(tunnel_entry))
+        append_unique_named(node.ipsec, "transform_sets", get_transform_set_data(tunnel_entry))
+      api.node_config(node, _config_name)
