--- /dev/null
+++ b/netsim/extra/firewall/policy/panos.j2
@@ -0,0 +1,60 @@
+{#
+  firewall.policy on PAN-OS, as configuration-mode set commands.
+
+  This replaces the XML-API task list (deploy.panos.yml): PAN-OS is
+  single-transport now -- everything reaches the device over the KNE SSH
+  endpoint through panos_cli_config_kne, which detects device rejections and
+  fails fast, keeps the password out of process arguments, and re-applies
+  idempotently (an unchanged candidate commits as a no-op). The concerns the
+  old task-list header raised about the sshpass lane are answered by the
+  module, not ignored.
+
+  ORDER IS THE POLICY. PAN-OS evaluates top-down and a set-created rule
+  appends to the bottom, so declaration order here IS evaluation order on a
+  fresh device -- the same loop-order semantic the API lane had, with the same
+  limit: a rule added to the middle of an existing policy appends instead.
+
+  One set statement per attribute: a set line addresses one subtree path.
+  Multi-value fields use the [ a b ] list form.
+#}
+{% for svc in firewall.policy.service_objects|default([]) %}
+set service "{{ svc.name }}" protocol {{ svc.protocol }} port {{ svc.port }}
+{%   if svc.description is defined %}
+set service "{{ svc.name }}" description "{{ svc.description }}"
+{%   endif %}
+{% endfor %}
+{% for grp in firewall.policy.service_groups|default([]) %}
+set service-group "{{ grp.name }}" members [ {{ grp.members|map('replace','/','-')|join(' ') }} ]
+{% endfor %}
+{% for adr in firewall.policy.address_objects|default([]) %}
+set address "{{ adr.name }}" {{ 'ip-range' if '-' in adr.ipv4 else 'ip-netmask' }} {{ adr.ipv4 }}
+{% endfor %}
+{# The inline `tcp/4022` service form gets an object generated for it, exactly
+   as the API lane did -- PAN-OS has no inline protocol/port syntax on a rule. #}
+{# PURE JINJA2 ONLY in extra/ templates: netlab create renders them with its
+   own environment, which has neither ansible's flatten/search/regex_* filters
+   nor its tests. Measured 2026-08-31: "No test named 'search'" failed the
+   whole demo-lab create at the topology-processing stage. #}
+{% set ns = namespace(seen=[]) %}
+{% for rule in firewall.policy.rules|default([]) %}
+{%   for inline_svc in rule.services|default([]) %}
+{%     if '/' in inline_svc and inline_svc not in ns.seen %}
+{%       set ns.seen = ns.seen + [inline_svc] %}
+set service "{{ inline_svc|replace('/','-') }}" protocol {{ inline_svc.split('/')[0] }} port {{ inline_svc.split('/')[1] }}
+set service "{{ inline_svc|replace('/','-') }}" description "generated from the inline form {{ inline_svc }}"
+{%     endif %}
+{%   endfor %}
+{% endfor %}
+{% for rule in firewall.policy.rules|default([]) %}
+{%   set rname = rule.name|default('policy_' ~ loop.index) %}
+set rulebase security rules "{{ rname }}" from [ {{ rule.from_zone }} ]
+set rulebase security rules "{{ rname }}" to [ {{ rule.to_zone }} ]
+set rulebase security rules "{{ rname }}" source [ {{ rule.src|default(['any'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" destination [ {{ rule.dst|default(['any'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" application [ {{ rule.application|default(['any'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" service [ {{ rule.services|default(['application-default'])|map('replace','/','-')|join(' ') }} ]
+set rulebase security rules "{{ rname }}" action {{ 'allow' if rule.action == 'permit' else 'deny' }}
+set rulebase security rules "{{ rname }}" rule-type {{ 'intrazone' if rule.from_zone == rule.to_zone else 'interzone' }}
+set rulebase security rules "{{ rname }}" log-start no
+set rulebase security rules "{{ rname }}" log-end {{ 'yes' if rule.log|default(true) else 'no' }}
+{% endfor %}
