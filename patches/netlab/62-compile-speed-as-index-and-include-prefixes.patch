+#
+# patch 62: AS index for the BGP scans, include prefixes for link names
+#
+
+def test_include_prefixes_and_nodename_validity_do_not_depend_on_who_built_the_list() -> None:
+  from netsim.augment import links
+  nodes = get_box({'a': {}, 'comp': {'include': 'x'}, 'other': {'include': 'y'}, 'plain': {'device': 'eos'}})
+  pfx = links.include_prefixes(nodes)
+  assert sorted(pfx) == ['comp_', 'other_']
+  for n in ('a', 'comp', 'comp_leaf', 'other_x', 'plain_x', 'zzz', 'comp-leaf', 'compx', ''):
+    expected = n in nodes or any(n.startswith(p) for p in ('comp_', 'other_'))
+    assert links.is_nodename_valid(n, nodes) is expected
+    assert links.is_nodename_valid(n, nodes, pfx) is expected
+  nodes_plain = get_box({'a': {}, 'b': {}})                              # no 'include': a non-string key is a plain miss
+  assert links.is_nodename_valid(5, nodes_plain) is False and links.is_nodename_valid(5, nodes_plain, ()) is False
+
+
+def _as_topology() -> Box:
+  return get_box({'nodes': {
+    'a': {'name': 'a', 'bgp': {'as': 1, 'rr': True}}, 'b': {'name': 'b', 'bgp': {'as': 1}},
+    'c': {'name': 'c'}, 'd': {'name': 'd', 'bgp': {'as': 2, 'rr': True}}, 'e': {'name': 'e', 'bgp': {'as': 1, 'rr': True}},
+    'f': {'name': 'f', 'bgp': {'as': '1'}}}})
+
+
+def test_the_as_index_answers_what_the_scans_answered() -> None:
+  from netsim.modules import bgp
+  topo = _as_topology()
+  ref = _as_topology()
+  try:
+    bgp.build_as_index(topo)
+    assert bgp._index_for(topo) is not None
+    for asn in (1, 2, 3, '1', 1.0, True, None):
+      got = bgp.find_bgp_rr(asn, topo)
+      assert [n.name for n in got] == [n.name for n in _reference_find_bgp_rr(asn, ref)]
+      assert all(a is b for a, b in zip(got, [n for n in topo.nodes.values() if n.name in [m.name for m in got]]))
+    got = bgp.find_bgp_rr(1, topo)
+    got.clear()                                                          # callers get their own list
+    assert len(bgp.find_bgp_rr(1, topo)) == 2
+    assert [n.name for n in bgp._index_members(1, topo)] == ['a', 'b', 'e'] and [n.name for n in bgp._index_members('1', topo)] == ['f']
+    _same(topo, ref)
+  finally:
+    bgp._as_index = None
+
+
+def test_the_as_index_steps_aside_for_anything_it_cannot_answer_exactly() -> None:
+  from netsim.modules import bgp
+  try:
+    topo = _as_topology()
+    bgp.build_as_index(topo)
+    assert bgp._index_for(_as_topology()) is None                        # another topology object
+    topo.nodes.z = get_box({'name': 'z'})
+    assert bgp._index_for(topo) is None                                  # the node set changed
+    assert bgp._index_rr(1, topo) is None and bgp._index_members(1, topo) is None
+    topo = _as_topology(); topo.nodes.c.vrfs = {'v': {}}                 # vrf can set a fake bgp.as later: no index at all
+    bgp.build_as_index(topo)
+    assert bgp._as_index is None
+    topo = _as_topology(); topo.nodes.e.bgp = {'rr': True}               # a shape the scan handles through python-box
+    bgp.build_as_index(topo)
+    assert bgp._index_rr(1, topo) is None and bgp._index_members(1, topo) is not None
+    topo = _as_topology(); topo.nodes.e.bgp = {'as': [1], 'rr': True}    # an AS that cannot be a dictionary key
+    bgp.build_as_index(topo)
+    assert bgp._as_index is None
+    topo = _as_topology()
+    bgp.build_as_index(topo)
+    assert bgp._index_rr([1], topo) is None and bgp._index_members({}, topo) is None
+    bgp.BGP({}).module_cleanup(topo)
+    assert bgp._as_index is None
+  finally:
+    bgp._as_index = None
+
+
+def test_compile_output_is_identical_with_and_without_the_as_index(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """Route reflectors, an iBGP full mesh, EBGP between the ASes: sessions must not change."""
+  from netsim.modules import bgp
+  text = _bgp_lab_topology()
+  built = []
+  real = bgp.build_as_index
+  def spy(topology):
+    real(topology)
+    built.append(bgp._as_index is not None)
+  monkeypatch.setattr(bgp, 'build_as_index', spy)
+  _compile_text(tmp_path, monkeypatch, 'warm', text)
+  built.clear()
+  on = _tree(_compile_text(tmp_path, monkeypatch, 'on', text), tmp_path / 'on')
+  assert built == [True], 'the index was not built (or not usable): this comparison proves nothing'
+  monkeypatch.setattr(bgp, 'build_as_index', lambda topology: None)       # the original scans
+  off = _tree(_compile_text(tmp_path, monkeypatch, 'off', text), tmp_path / 'off')
+  assert set(on) == set(off) and len(on) > 10
+  assert [k for k in on if on[k] != off[k]] == []
+  neighbors = [v for k, v in on.items() if k.startswith('host_vars/') and b'neighbors' in v]
+  assert neighbors, 'no BGP neighbours in the output'
