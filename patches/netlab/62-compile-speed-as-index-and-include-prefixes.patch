diff --git a/netsim/modules/bgp.py b/netsim/modules/bgp.py
index 0e0701e..ca5af27 100644
--- a/netsim/modules/bgp.py
+++ b/netsim/modules/bgp.py
@@ -82,6 +82,73 @@ def validate_bgp_sessions(node: Box, sessions: Box, attribute: str) -> bool:
 
   return OK
 
+"""
+SKYFORGE-SPECIFIC (patch 62): AS index. find_bgp_rr and build_ibgp_sessions looked at every node for every BGP node
+(N * N reads: 13 s of a 3,972-node compile). The index is built once, in module_post_transform, from the state the
+scans would see: bgp.as and bgp.rr are final by then (node_pre_transform sets rr, module_post_transform sets router IDs
+and RR clusters from it), and the one place that sets an AS later (vrf: a fake bgp.as for inter-VRF route leaking, in
+vrf's node_post_transform) needs node.vrfs, so any node with vrfs switches the index off.
+
+It answers only what the scans answered and for the shapes they handled the same way: every node whose bgp is not a
+dictionary with an 'as' (the original expression creates keys on those, through python-box) sends find_bgp_rr back
+to the scan; an AS value that cannot be a dictionary key sends both back to the scan. The index is dropped in
+module_cleanup and ignored for any other topology object or node count.
+"""
+class _AsIndex:
+  def __init__(self, topology: Box):
+    self.topology = topology
+    self.count = len(topology.nodes)
+    self.members: typing.Dict[typing.Any,typing.List[Box]] = {}   # AS -> nodes with that bgp.as, in node order
+    rr: typing.Optional[typing.Dict[typing.Any,typing.List[Box]]] = {}
+    for n in topology.nodes.values():
+      if 'vrfs' in n:
+        raise ValueError('vrfs')
+      bgp = dict.get(n,'bgp',_NO_BGP)
+      asn = _bgp_as(n)
+      if asn is not None:
+        self.members.setdefault(asn,[]).append(n)
+      if bgp is _NO_BGP:
+        continue
+      if not (isinstance(bgp,dict) and 'as' in bgp):
+        rr = None                                 # a shape the scan treats through python-box: leave it to the scan
+      elif rr is not None and bgp.get('rr',None):
+        rr.setdefault(dict.__getitem__(bgp,'as'),[]).append(n)
+    self.rr = rr
+
+_as_index: typing.Optional[_AsIndex] = None
+
+def _index_for(topology: Box) -> typing.Optional[_AsIndex]:
+  idx = _as_index
+  if idx is None or idx.topology is not topology or idx.count != len(topology.nodes):
+    return None
+  return idx
+
+def _index_rr(bgp_as: typing.Any, topology: Box) -> typing.Optional[typing.List[Box]]:
+  idx = _index_for(topology)
+  if idx is None or idx.rr is None:
+    return None
+  try:
+    return list(idx.rr.get(bgp_as,()))
+  except TypeError:                               # an AS that cannot be a key: the scan decides
+    return None
+
+def _index_members(node_as: typing.Any, topology: Box) -> typing.Optional[typing.List[Box]]:
+  idx = _index_for(topology)
+  if idx is None:
+    return None
+  try:
+    return idx.members.get(node_as,[])
+  except TypeError:
+    return None
+
+def build_as_index(topology: Box) -> None:
+  global _as_index
+  _as_index = None
+  try:
+    _as_index = _AsIndex(topology)
+  except Exception:                               # whatever the index could not read, the scans will read (and report)
+    _as_index = None
+
 """
 find_bgp_rr: find route reflectors in the specified autonomous system
 
@@ -90,6 +157,9 @@ Given an autonomous system and lab topology, return a list of node names that ar
 _NO_BGP = object()
 
 def find_bgp_rr(bgp_as: int, topology: Box) -> typing.List[Box]:
+  rr = _index_rr(bgp_as,topology)                 # SKYFORGE-SPECIFIC (patch 62): looked up in the index, if there is one
+  if rr is not None:
+    return rr
   # SKYFORGE-SPECIFIC: every BGP node scans every node; read the usual shape (bgp is a dictionary with an 'as') at
   # dictionary level and leave anything else to the original expression (which, through python-box, may create keys)
   result = []
@@ -200,9 +270,10 @@ def build_ibgp_sessions(node: Box, sessions: Box, topology: Box) -> None:
   rrlist = [] if is_rr else find_bgp_rr(node_as,topology)
   rr_mesh  = node.bgp.get("rr_mesh",True)         # Do we want to have a mesh between RRs (default: Yes)?
   if is_rr or not rrlist:                         # If the current node is RR or we have a full mesh
+    as_members = _index_members(node_as,topology)   # SKYFORGE-SPECIFIC (patch 62): the nodes in this AS, from the index
     ibgp_ngb_list = [                             # ... we need IBGP sessions to all nodes in the AS
-      ngb for ngb in topology.nodes.values()      # ... but while building the node list
-        if _bgp_as(ngb) == node_as and            # ... skip everyone not in the current AS (or not running BGP)
+      ngb for ngb in (topology.nodes.values() if as_members is None else as_members)   # ... but while building the node list
+        if (as_members is not None or _bgp_as(ngb) == node_as) and   # ... skip everyone not in the current AS (or not running BGP)
            ngb.name != node.name]                 # ... and the current node
     if is_rr and not rr_mesh:                     # Are we a RR and the user hates inter-RR sessions?
       ibgp_ngb_list = [                           # ... Let's exclude other RRs from neighbor list
@@ -1060,9 +1131,14 @@ class BGP(_Module):
       if 'bgp' in n:
         _routing.router_id(n,'bgp',topology.pools)
 
+    build_as_index(topology)                      # SKYFORGE-SPECIFIC (patch 62)
     build_bgp_rr_clusters(topology)
     check_confederation_data(topology)
 
+  def module_cleanup(self, topology: Box) -> None:
+    global _as_index                              # SKYFORGE-SPECIFIC (patch 62)
+    _as_index = None
+
   #
   # Execute the rest of node post-transform code, including setting up the BGP session table
   #
diff --git a/tests/test_compile_speed.py b/tests/test_compile_speed.py
index 1eda47a..716805e 100644
--- a/tests/test_compile_speed.py
+++ b/tests/test_compile_speed.py
@@ -691,3 +691,96 @@ def test_when_a_config_worker_logs_something_the_parent_renders_a_private_copy(t
   on = _tree(_compile_text(tmp_path, monkeypatch, 'on', text, outputs=('config',)), tmp_path / 'on')
   assert calls == [True, False], f'expected a shared topology and then a private one, got {calls}'
   assert [k for k in on if on[k] != off.get(k)] == [] and any(k.startswith('node_files/') for k in on)
+
