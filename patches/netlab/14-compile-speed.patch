@@ -0,0 +1,548 @@
+"""
+SKYFORGE-SPECIFIC fast paths for the two whole-topology conversions the output modules do: Box -> plain dict
+(`Box.to_dict()`) and plain dict -> Box (`get_box(dict)`).
+
+Why: python-box converts one value at a time through `__getitem__`, `__setitem__` and a configuration dictionary it
+rebuilds for every nested object. For a 512-node lab the output modules do that for about 1.3 million nested
+objects, four times over (adjusted topology for the configs, the Kubernetes snapshot, the pickle, the provider file).
+
+What these functions guarantee: the result is EQUAL to what python-box produces, including the type of every
+nested object (Box / BoxList / dict / list) and python-box's own bookkeeping (`_box_config`, `box_options`). Anything
+this module is not certain about is handed back to python-box:
+
+* `to_dict` follows python-box's own algorithm and only skips the per-key `__getitem__` call;
+* `from_plain` builds the nested objects directly ONLY for the plain data python-box would convert without
+  surprises (string keys without dots or brackets, plain dict/list/scalar values). A key with a '.' or '[' (python-box
+  splits it into nested objects), a self-referencing container, an unexpected type or an unknown python-box version
+  goes through python-box itself;
+* `SKYFORGE_NETLAB_COMPILE_FASTBOX=0` turns the module off. `SKYFORGE_NETLAB_COMPILE_FASTBOX_VERIFY=1` runs python-box too and aborts the compile when
+  the two results differ (the tests run that way).
+"""
+
+import os
+import typing
+
+import box as _box
+from box import Box, BoxList
+
+# python-box versions this was written and tested against: the one the Skyforge runtime image ships, and the newest one
+# the developers use. Any other version keeps the slow, original path.
+KNOWN_VERSIONS = ('7.3.2','7.4.1')
+ENABLED = os.environ.get('SKYFORGE_NETLAB_COMPILE_FASTBOX','1') != '0' and getattr(_box,'__version__','') in KNOWN_VERSIONS
+VERIFY = os.environ.get('SKYFORGE_NETLAB_COMPILE_FASTBOX_VERIFY','0') == '1'
+
+_SCALARS = (int,float,str,bytes,bytearray,bool,complex,set,frozenset)
+
+def _to_dict(b: Box) -> dict:
+  out = dict.copy(b)                                   # the stored values, no per-key __getitem__ round trip
+  for k,v in out.items():
+    if v is b:
+      out[k] = out
+    elif isinstance(v,Box):
+      out[k] = _to_dict(v)
+    elif isinstance(v,BoxList):
+      out[k] = _to_list(v)
+  return out
+
+def _to_list(bl: BoxList) -> list:
+  new_list: list = []
+  for x in bl:
+    if x is bl:
+      new_list.append(new_list)
+    elif isinstance(x,Box):
+      new_list.append(_to_dict(x))
+    elif isinstance(x,BoxList):
+      new_list.append(_to_list(x))
+    else:
+      new_list.append(x)
+  return new_list
+
+def to_dict(b: Box) -> dict:
+  """Same result as b.to_dict()"""
+  if not enabled() or not isinstance(b,Box):
+    return b.to_dict()
+
+  result = _to_dict(b)
+  if VERIFY:
+    expected = b.to_dict()
+    if not same_structure(result,expected):
+      from ..utils import log
+      log.fatal('netlab fastbox: to_dict differs from python-box')
+  return result
+
+#
+# plain dict -> Box
+#
+
+class _Slow(Exception):
+  """Raised when a value needs python-box's own conversion."""
+  def __init__(self, why: str = ''):
+    super().__init__(why)
+
+_safe_cache: typing.Dict[typing.Any,str] = {}
+_safe_str: typing.Dict[str,str] = {}
+
+def _new_box(cfg0: dict, ns: tuple) -> Box:
+  b = dict.__new__(Box)
+  cfg = cfg0.copy()
+  cfg['__safe_keys'] = {}
+  cfg['box_namespace'] = ns
+  object.__setattr__(b,'_box_config',cfg)
+  return b
+
+def _opts_of(cfg0: dict) -> dict:
+  return {k:v for k,v in cfg0.items() if not k.startswith('__')}
+
+def _child_options(opts0: dict, ns: tuple) -> dict:
+  opts = opts0.copy()
+  opts['box_namespace'] = ns
+  return opts
+
+def _fill(b: Box, src: dict, cfg0: dict, opts0: dict, ns: tuple, proto: Box) -> None:
+  """
+  Store the items of `src` in `b` the way Box.__init__ / Box.__convert_and_store do for this configuration:
+  dictionaries (Box or not) are re-created as boxes, a BoxList is kept (python-box keeps the very same object and
+  only updates its options), a plain list becomes a BoxList, everything else is stored as it is.
+  """
+  safe = b._box_config['__safe_keys']
+  for k,v in dict.items(src):
+    if v is src:
+      raise _Slow('self reference')
+    if k.__class__ is str and ('.' in k or '[' in k):
+      raise _Slow(f'dotted key {k!r}')
+    if k.__class__ is str:
+      sk = _safe_str.get(k)
+      if sk is None:
+        sk = _safe_str[k] = proto._safe_attr(k)
+    else:
+      ck = (k.__class__,k)
+      sk = _safe_cache.get(ck)
+      if sk is None:
+        sk = _safe_cache[ck] = proto._safe_attr(k)
+    safe[sk] = k
+    if isinstance(v,_SCALARS):
+      dict.__setitem__(b,k,v)
+    elif isinstance(v,dict):
+      child = _new_box(cfg0,ns + (k,))
+      _fill(child,v,cfg0,opts0,ns + (k,),proto)
+      dict.__setitem__(b,k,child)
+    elif isinstance(v,list):
+      if isinstance(v,BoxList):
+        v.box_options.update(_child_options(opts0,ns + (k,)))
+        dict.__setitem__(b,k,v)
+      else:
+        dict.__setitem__(b,k,_make_list(v,cfg0,opts0,ns + (k,),proto))
+    else:                                               # None, tuples and every other object are stored as they are
+      dict.__setitem__(b,k,v)
+
+def _make_list(src: list, cfg0: dict, opts0: dict, ns: tuple, proto: Box) -> BoxList:
+  bl = BoxList(**_child_options(opts0,ns))               # empty list with python-box's own options handling
+  for x in src:
+    if x is src:
+      raise _Slow('self reference')
+    if isinstance(x,dict):
+      child = _new_box(cfg0,ns)
+      _fill(child,x,cfg0,opts0,ns,proto)
+      list.append(bl,child)
+    elif isinstance(x,list):                            # python-box re-creates every list item, BoxList or not
+      list.append(bl,_make_list(x,cfg0,opts0,ns,proto))
+    else:
+      list.append(bl,x)
+  return bl
+
+_OPTS = dict(default_box=True,default_box_none_transform=False,box_dots=True)
+_MISSING = object()
+_proto: typing.Optional[Box] = None
+_cfg0: dict = {}
+_opts0: dict = {}
+_standard: dict = {}
+
+def _ensure_proto() -> None:
+  global _proto
+  if _proto is None:
+    proto = Box(**_OPTS)                                # python-box builds the configuration, once
+    _cfg0.update(proto._box_config)
+    _cfg0['__created'] = True
+    _opts0.update(_opts_of(_cfg0))
+    _standard.update({k:v for k,v in _cfg0.items() if not k.startswith('__') and k != 'box_namespace'})
+    _proto = proto
+
+def _is_standard(src: Box) -> bool:
+  """Is this Box configured the way netlab's get_box configures them (namespace aside)?"""
+  _ensure_proto()
+  cfg = src._box_config
+  return all(cfg.get(k,_MISSING) == v for k,v in _standard.items()) and \
+         all(k in _standard or k.startswith('__') or k == 'box_namespace' for k in cfg)
+
+#
+# Raw fast paths (no enable check, no verification); they raise _Slow for anything python-box must handle itself
+#
+def _from_plain_fast(init: dict) -> Box:
+  _ensure_proto()
+  result = _new_box(_cfg0,())
+  _fill(result,init,_cfg0,_opts0,(),_proto)
+  return result
+
+def _copy_fast(src: Box, ns: tuple = ()) -> Box:
+  _ensure_proto()
+  result = _new_box(_cfg0,ns)
+  _fill(result,src,_cfg0,_opts0,ns,_proto)
+  return result
+
+#
+# Public entry points: same result as python-box, or python-box itself
+#
+def from_plain(init: dict) -> Box:
+  """
+  Same result as Box(init,default_box=True,default_box_none_transform=False,box_dots=True) for a plain dict or a Box
+  (python-box ignores the configuration of a source Box and re-creates every nested dictionary).
+  """
+  if not enabled() or (type(init) is not dict and type(init) is not Box):
+    return Box(init,**_OPTS)
+  try:
+    result = _from_plain_fast(init)
+  except _Slow as why:
+    if os.environ.get('SKYFORGE_NETLAB_COMPILE_FASTBOX_DEBUG'):
+      print(f'fastbox: from_plain fell back to python-box: {why}')
+    return Box(init,**_OPTS)
+
+  if VERIFY:
+    expected = Box(init,**_OPTS)
+    if not same_structure(result,expected,check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: from_plain differs from python-box')
+  return result
+
+def copy_subtree(src: Box, ns: tuple = ()) -> Box:
+  """
+  Same result as src.copy() (python-box: a new Box whose nested dictionaries are re-created and whose lists are
+  shared), placed at namespace `ns` (python-box's own copy() detaches the namespace: ns=()).
+  """
+  if not enabled() or type(src) is not Box or not _is_standard(src):
+    return src.copy()
+  try:
+    result = _copy_fast(src,ns)
+  except _Slow:
+    return src.copy()
+
+  if VERIFY and not ns:
+    expected = src.copy()
+    if not same_structure(result,expected,check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: copy differs from Box.copy()')
+  return result
+
+def copy_box(src: Box) -> Box:
+  """Same result as src.copy()"""
+  return copy_subtree(src)
+
+def add(a: Box, b: dict) -> Box:
+  """Same result as a + b. python-box (7.3.2 and 7.4.1): copy a, then merge_update(b) on the copy (frozen aside)."""
+  if not enabled() or type(a) is not Box or not isinstance(b,dict) or a._box_config.get('frozen_box'):
+    return a + b
+  result = copy_box(a)
+  result.merge_update(b)
+  if VERIFY:
+    expected = a + b
+    if not same_structure(result,expected,check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: add differs from Box.__add__')
+  return result
+
+def _fill_deep(b: Box, src: dict, cfg0: dict, opts0: dict, ns: tuple, proto: Box) -> None:
+  """Like _fill, but a source BoxList is re-created as well: the result equals Box(src.to_dict()) for a Box source"""
+  safe = b._box_config['__safe_keys']
+  for k,v in dict.items(src):
+    if v is src:
+      raise _Slow('self reference')
+    if k.__class__ is str and ('.' in k or '[' in k):
+      raise _Slow(f'dotted key {k!r}')
+    if k.__class__ is str:
+      sk = _safe_str.get(k)
+      if sk is None:
+        sk = _safe_str[k] = proto._safe_attr(k)
+    else:
+      ck = (k.__class__,k)
+      sk = _safe_cache.get(ck)
+      if sk is None:
+        sk = _safe_cache[ck] = proto._safe_attr(k)
+    safe[sk] = k
+    if isinstance(v,_SCALARS):
+      dict.__setitem__(b,k,v)
+    elif isinstance(v,dict):
+      child = _new_box(cfg0,ns + (k,))
+      _fill_deep(child,v,cfg0,opts0,ns + (k,),proto)
+      dict.__setitem__(b,k,child)
+    elif isinstance(v,list):
+      dict.__setitem__(b,k,_make_list_deep(v,cfg0,opts0,ns + (k,),proto))
+    else:
+      dict.__setitem__(b,k,v)
+
+def _make_list_deep(src: list, cfg0: dict, opts0: dict, ns: tuple, proto: Box) -> BoxList:
+  bl = BoxList(**_child_options(opts0,ns))
+  for x in src:
+    if x is src:
+      raise _Slow('self reference')
+    if isinstance(x,dict):
+      child = _new_box(cfg0,ns)
+      _fill_deep(child,x,cfg0,opts0,ns,proto)
+      list.append(bl,child)
+    elif isinstance(x,list):
+      list.append(bl,_make_list_deep(x,cfg0,opts0,ns,proto))
+    else:
+      list.append(bl,x)
+  return bl
+
+def _deep_copy_fast(src: Box) -> Box:
+  _ensure_proto()
+  result = _new_box(_cfg0,())
+  _fill_deep(result,src,_cfg0,_opts0,(),_proto)
+  return result
+
+def deep_copy(src: Box) -> Box:
+  """
+  SKYFORGE-SPECIFIC: same result as get_box(src.to_dict()) -- a completely independent copy -- in one pass,
+  without building the intermediate plain dictionary.
+  """
+  if not enabled() or type(src) is not Box:
+    return Box(src.to_dict(),**_OPTS)
+  try:
+    result = _deep_copy_fast(src)
+  except _Slow:
+    return from_plain(to_dict(src))
+  if VERIFY:
+    expected = Box(src.to_dict(),**_OPTS)
+    if not same_structure(result,expected,check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: deep_copy differs from get_box(to_dict())')
+  return result
+
+
+def _set_item_fast(b: Box, key: typing.Any, value: typing.Any) -> None:
+  """Raw: what Box.__setitem__ / __convert_and_store do for a standard Box and a plain key; raises _Slow"""
+  _ensure_proto()
+  ns = b._box_config['box_namespace'] + (key,)
+  if isinstance(value,_SCALARS) or value is None:
+    stored = value
+  elif isinstance(value,dict):
+    if value is b:
+      raise _Slow('self reference')
+    stored = _new_box(_cfg0,ns)
+    _fill(stored,value,_cfg0,_opts0,ns,_proto)
+  elif isinstance(value,BoxList):
+    value.box_options.update(_child_options(_opts0,ns))
+    stored = value
+  elif isinstance(value,list):
+    stored = _make_list(value,_cfg0,_opts0,ns,_proto)
+  else:
+    stored = value
+  if key.__class__ is str:
+    sk = _safe_str.get(key)
+    if sk is None:
+      sk = _safe_str[key] = _proto._safe_attr(key)
+  else:
+    ck = (key.__class__,key)
+    sk = _safe_cache.get(ck)
+    if sk is None:
+      sk = _safe_cache[ck] = _proto._safe_attr(key)
+  b._box_config['__safe_keys'][sk] = key
+  dict.__setitem__(b,key,stored)
+
+def set_item(b: Box, key: typing.Any, value: typing.Any) -> None:
+  """
+  SKYFORGE-SPECIFIC: same result as b[key] = value (python-box re-creates a dictionary value as a Box, keeps a BoxList
+  and updates its options, makes a plain list a BoxList), without python-box's per-key conversion.
+  """
+  if not enabled() or type(b) is not Box or (isinstance(key,str) and ('.' in key or '[' in key)) or not _is_standard(b):
+    b[key] = value
+    return
+  try:
+    _set_item_fast(b,key,value)
+  except _Slow:
+    b[key] = value
+
+def set_reference(b: Box, key: str, value: typing.Any) -> None:
+  """
+  SKYFORGE-SPECIFIC: store `value` under `key` WITHOUT python-box's conversion (b[key] = value would copy a dictionary).
+  Only for a Box that is about to be copied as a whole (append_box, set_item, copy_box): the copy re-creates the value
+  exactly as an assignment would have, so the end result is the same and one copy is saved.
+  """
+  if not enabled() or type(b) is not Box or not isinstance(key,str) or '.' in key or '[' in key or not _is_standard(b):
+    b[key] = value
+    return
+  sk = _safe_str.get(key)
+  if sk is None:
+    sk = _safe_str[key] = _proto._safe_attr(key)
+  b._box_config['__safe_keys'][sk] = key
+  dict.__setitem__(b,key,value)
+
+def set_list(b: Box, key: typing.Any, value: list) -> None:
+  """
+  SKYFORGE-SPECIFIC: same result as b[key] = value for a plain list (python-box makes it a BoxList and re-creates every
+  dictionary in it), without python-box's per-item conversion. Anything unusual goes through python-box.
+  """
+  if not enabled() or type(b) is not Box or type(value) is not list or not isinstance(key,str) or '.' in key or '[' in key \
+     or not _is_standard(b):
+    b[key] = value
+    return
+  try:
+    bl = _make_list(value,_cfg0,_opts0,b._box_config['box_namespace'] + (key,),_proto)
+  except _Slow:
+    b[key] = value
+    return
+  sk = _safe_str.get(key)
+  if sk is None:
+    sk = _safe_str[key] = _proto._safe_attr(key)
+  b._box_config['__safe_keys'][sk] = key
+  dict.__setitem__(b,key,bl)
+  if VERIFY:
+    check = Box(**_OPTS)
+    object.__setattr__(check,'_box_config',dict(b._box_config,__safe_keys=dict(b._box_config['__safe_keys'])))
+    check[key] = value
+    if not same_structure(dict.__getitem__(b,key),dict.__getitem__(check,key),check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: set_list differs from python-box')
+
+def append_box(bl: BoxList, item: typing.Any) -> None:
+  """
+  SKYFORGE-SPECIFIC: same result as bl.append(item) (python-box re-creates a dictionary item as a Box configured by
+  the list's options), without python-box's per-key conversion. Anything unusual goes through python-box.
+  """
+  if not enabled() or type(bl) is not BoxList or type(item) not in (dict,Box):
+    bl.append(item)
+    return
+  _ensure_proto()
+  opts = bl.box_options
+  ns = opts.get('box_namespace',())
+  if opts.get('box_class',None) is not Box or not isinstance(ns,tuple) or \
+     {k:v for k,v in opts.items() if k != 'box_namespace'} != {k:v for k,v in _opts0.items() if k != 'box_namespace'}:
+    bl.append(item)
+    return
+  try:
+    child = _new_box(_cfg0,ns)
+    _fill(child,item,_cfg0,_opts0,ns,_proto)
+  except _Slow:
+    bl.append(item)
+    return
+  list.append(bl,child)
+  if VERIFY:
+    check = BoxList(**opts)
+    check.append(item)
+    if not same_structure(child,check[0],check_config=True):
+      from ..utils import log
+      log.fatal('netlab fastbox: append_box differs from python-box')
+
+def shallow(src: Box) -> Box:
+  """
+  A new top-level Box with the configuration and keys of `src` whose VALUES ARE THE SAME OBJECTS (no conversion).
+  Only for copy-on-write use: the caller must replace a value before modifying anything under it.
+  """
+  result = dict.__new__(Box)
+  cfg = dict(src._box_config)
+  cfg['__safe_keys'] = dict(src._box_config['__safe_keys'])
+  cfg['box_namespace'] = ()
+  object.__setattr__(result,'_box_config',cfg)
+  dict.update(result,src)
+  return result
+
+def same_structure(a: typing.Any, b: typing.Any, check_config: bool = False, _depth: int = 0) -> bool:
+  """Equal values, equal container types at every level, and (check_config) equal python-box bookkeeping"""
+  if a.__class__ is not b.__class__:
+    return False
+  if isinstance(a,dict):
+    if list(a.keys()) != list(b.keys()):
+      return False
+    if check_config and isinstance(a,Box) and a._box_config != b._box_config:
+      return False
+    return all(same_structure(dict.__getitem__(a,k),dict.__getitem__(b,k),check_config,_depth + 1) for k in a.keys())
+  if isinstance(a,list):
+    if len(a) != len(b):
+      return False
+    if check_config and isinstance(a,BoxList) and a.box_options != b.box_options:
+      return False
+    return all(same_structure(x,y,check_config,_depth + 1) for x,y in zip(a,b))
+  return bool(a == b)
+
+
+#
+# SELF-TEST. The fast paths reproduce python-box's own algorithms, and python-box ships in more than one build: the
+# runtime image has Debian's Cython-compiled 7.3.2 on python 3.13, developers pip's pure-python 7.4.1 (whose
+# merge_update grew an argument 7.3.2 does not have -- the first version of this module used it and every compile
+# in the image died). Before the first use, every fast path is compared with the installed python-box on a structure
+# that exercises what a compile produces; any difference or exception switches the module off for this process, so
+# the result is python-box's own, only slower.
+#
+_self_test_state: typing.Optional[bool] = None
+
+def _sample() -> dict:
+  import ipaddress
+  return {
+    'a': 1, 'b': 'x', 'c': None, 'd': [1, {'e': [2, {'f': 'g'}]}, [3, [4]]], 'h': {'i': {'j': {}}, 'k': []},
+    1: {2: 'int keys'}, 'with-dash': {'class': True}, 'ip': ipaddress.ip_network('10.0.0.0/24'), 't': (1, 2),
+    'flag': False, 'f': 1.5,
+  }
+
+def _run_self_test() -> bool:
+  try:
+    if not same_structure(_from_plain_fast(_sample()),Box(_sample(),**_OPTS),check_config=True):
+      return False
+    b = Box(_sample(),**_OPTS)
+    if not same_structure(_to_dict(b),b.to_dict()):
+      return False
+    b1, b2 = Box(_sample(),**_OPTS), Box(_sample(),**_OPTS)
+    if not same_structure(_from_plain_fast(b1),Box(b2,**_OPTS),check_config=True):
+      return False
+    b1, b2 = Box(_sample(),**_OPTS), Box(_sample(),**_OPTS)
