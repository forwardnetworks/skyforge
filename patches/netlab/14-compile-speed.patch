diff --git a/netsim/cli/parallel_outputs.py b/netsim/cli/parallel_outputs.py
new file mode 100644
index 0000000..e9a2e2f
--- /dev/null
+++ b/netsim/cli/parallel_outputs.py
@@ -0,0 +1,109 @@
+#
+# SKYFORGE-SPECIFIC (patch 57): run the 'netlab create' output modules concurrently.
+#
+# WHY. On a large lab the output modules are about a third of the compile (measured at 512 nodes in the runtime
+# image, patches 1-55: config 17.4%, provider 7.8%, pickle 5.2%, ansible 2.9%) and most of them only read the
+# transformed topology.
+#
+# HOW. The loop below is the original output loop (create.run) with one change: a module that comes after the
+# barrier ('config') and does not change the topology has its write() run in a forked worker instead of inline.
+# Everything else happens in this process, in the original order: loading each module (which can add an empty
+# defaults.outputs.<name> entry to the topology), 'config' (later modules read the node_files it writes: the KNE
+# provider assembles each startup-config from them), and 'pickle' (it puts the provider instance cache back into
+# topology._Providers, so it must change THIS process's topology). A worker forked at module N therefore sees exactly
+# the topology the sequential loop handed module N. Each module's stdout/stderr, errors and warnings are replayed in
+# module order (utils/forkrun.py), so the console output and exit status match the sequential loop and the files are
+# byte-identical (patch tests + the Rolex ladder + the blueprint corpus).
+#
+# WHEN NOT (create.run's original loop runs instead):
+#   * SKYFORGE_NETLAB_PARALLEL_OUTPUTS=0;
+#   * the process cannot fork safely (no fork, or more than one thread);
+#   * -o on the command line, --devices, an output with options or a filename, or an unknown output module:
+#     keep netlab's exact behaviour;
+#   * fewer than two modules after the barrier.
+# One difference on FAILURE only: with sequential outputs, modules after a failing one never run; here the concurrent
+# ones may already have written their files when the error is reported. Messages and exit status are the same.
+#
+import importlib.util
+import os
+import tempfile
+import typing
+
+from box import Box
+
+from ..data import memo
+from ..outputs import _TopologyOutput
+from ..utils import forkrun, log
+
+IN_PROCESS = {'pickle'}                         # changes the topology it is handed: must run here
+BARRIER = 'config'                              # later modules read the files it writes
+
+
+def enabled() -> bool:
+  return os.environ.get('SKYFORGE_NETLAB_PARALLEL_OUTPUTS', '1') != '0'
+
+
+def usable(args: typing.Any, topology: Box) -> bool:
+  if not enabled() or not forkrun.fork_ok() or getattr(args, 'devices', None):
+    return False
+  if not isinstance(args.output, Box):          # -o on the command line: the user asked for something specific
+    return False
+  names = []
+  for name in args.output:
+    value = args.output[name]
+    if value is False:
+      continue
+    if value or ':' in name or '=' in name:     # options or an output file: not the plain default
+      return False
+    if importlib.util.find_spec(f'netsim.outputs.{name}') is None:
+      return False
+    names.append(name)
+  rest = names[names.index(BARRIER) + 1:] if BARRIER in names else names
+  return len([ n for n in rest if n not in IN_PROCESS ]) >= 1 and len(rest) >= 2
+
+
+def _write(module: typing.Any, topology: Box) -> typing.Callable[[], None]:
+  def fn() -> None:
+    memo.invalidate()                           # patch 54: the caches must not outlive a module
+    module.write(topology)
+    memo.invalidate()
+  return fn
+
+
+def run(args: typing.Any, topology: Box) -> None:
+  from .create import get_output_parameter
+
+  barrier_passed = BARRIER not in args.output
+  with tempfile.TemporaryDirectory(prefix='netlab-outputs-') as tmpdir:
+    pending: list = []                          # (tag, pid or None, local result or None, what, module)
+    for idx, output_format in enumerate(args.output):
+      output_param = get_output_parameter(output_format, args.output)
+      if not output_param:
+        continue
+      output_module = _TopologyOutput.load(output_param, topology.defaults.outputs[output_param.split(':')[0]])
+      if not output_module:                     # usable() checked the names; keep the original behaviour anyway
+        log.error('Unknown output format %s' % output_format, log.IncorrectValue, 'create')
+        continue
+      tag = f'o{idx}'
+      if not barrier_passed or output_format in IN_PROCESS:
+        if not pending:                         # nothing concurrent yet: exactly the original inline step
+          _write(output_module, topology)()
+          log.exit_on_error()
+        else:
+          pending.append((tag, None, forkrun.run_captured(_write(output_module, topology), tmpdir, tag), output_format, output_module))
+      else:
+        pending.append((tag, forkrun.start(_write(output_module, topology), tmpdir, tag), None, output_format, output_module))
+      if output_format == BARRIER:
+        barrier_passed = True
+
+    results = [ local if pid is None else forkrun.collect(pid, tmpdir, tag, f'output module {what}')
+                for tag, pid, local, what, _ in pending ]
+    for (tag, pid, _, what, module), result in zip(pending, results):   # replay in module order
+      if pid is not None and not forkrun.clean(result):
+        # The worker logged something (an error, a warning, a hint): what netlab prints once per process can only
+        # be printed right by this process, so this module runs again here, at its place in the order. The output
+        # modules after the barrier only read the topology, so the re-run writes the same files.
+        _write(module, topology)()
+        log.exit_on_error()
+      else:
+        forkrun.replay(result)
