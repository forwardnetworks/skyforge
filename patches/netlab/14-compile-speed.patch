+  return (value,False)                   # Return whatever the device value is
 
-  return value                           # Return whatever the device value is
+def get_device_attribute(node: Box, attr: str, defaults: Box) -> typing.Optional[typing.Any]:
+  value,shared = _device_attribute(node,attr,defaults)
+  # SKYFORGE-SPECIFIC: every caller still gets a merged table of its own, as it always did (python-box creates keys
+  # when a missing one is read, and callers may modify what they get)
+  return fastbox.copy_box(value) if shared else value
+
+def get_device_attribute_readonly(node: Box, attr: str, defaults: Box) -> typing.Optional[typing.Any]:
+  """
+  SKYFORGE-SPECIFIC: get_device_attribute for callers that only READ the result with .get() and `in`. The value may
+  be shared with every other node of the device type: never modify it, and never read a missing key with attribute
+  or [] access (python-box would create it). Saves a copy of the table per call.
+  """
+  return _device_attribute(node,attr,defaults)[0]
 
