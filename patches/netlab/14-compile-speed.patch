+#!/usr/bin/env python3
+"""
+Parallel outputs (SKYFORGE-SPECIFIC, patch 57): running the output modules (and the per-node config rendering) in
+forked workers must change how long 'netlab create' takes, never what it produces: not the files, not the console
+output, not the topology create.run() returns, not the exit behaviour on an error.
+
+Every test compares a run with the parallel paths ON against the same run with them OFF
+(SKYFORGE_NETLAB_PARALLEL_OUTPUTS=0, the original sequential loop).
+"""
+
+import pickle
+import textwrap
+import threading
+from pathlib import Path
+
+import pytest
+
+from netsim.cli import create, parallel_outputs
+from netsim.data import memo
+from netsim.outputs import parallel_config
+from netsim.utils import forkrun, log
+
+_TOPOLOGY = """
+provider: kne
+module: [ ospf, bgp, vxlan, evpn, vlan ]
+bgp.as: 65000
+addressing:
+  loopback: { ipv4: 10.0.0.0/16, prefix: 32 }
+  mgmt: { ipv4: 10.200.0.0/14 }
+vlans:
+  tenant0: { id: 100, mode: bridge, prefix: 10.100.0.0/24 }
+  tenant1: { id: 101, mode: bridge, prefix: 10.104.0.0/24 }
+defaults.device: eos
+nodes:
+  s1: { bgp.rr: true }
+  s2: { bgp.rr: true }
+  l1: { vlans: { tenant0: {}, tenant1: {} } }
+  l2: { vlans: { tenant0: {}, tenant1: {} } }
+  h1: { device: linux }
+  h2: { device: linux }
+  h3: { device: linux }
+links:
+- { s1: , l1: }
+- { s1: , l2: }
+- { s2: , l1: }
+- { s2: , l2: }
+- { l1: , h1: , vlan.access: tenant0 }
+- { l1: , h2: , vlan.access: tenant1 }
+- { l2: , h3: , vlan.access: tenant0 }
+"""
+
+
+def _init_log() -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=False, raise_error=False, warning=False, logging=False, verbose=0)
+
+
+def _compile(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capfd: pytest.CaptureFixture, name: str,
+             parallel: bool, topology_text: str = _TOPOLOGY) -> tuple:
+  lab = tmp_path / name / 'lab'
+  lab.mkdir(parents=True)
+  monkeypatch.chdir(lab)
+  monkeypatch.setenv('SKYFORGE_NETLAB_PARALLEL_OUTPUTS', '1' if parallel else '0')
+  monkeypatch.setenv('SKYFORGE_NETLAB_PARALLEL_CONFIG_MIN', '1')    # exercise the per-node workers on a small lab
+  monkeypatch.setenv('SKYFORGE_NETLAB_CONFIG_WORKERS', '3')
+  memo.invalidate()
+  (lab / 'topology.yml').write_text(textwrap.dedent(topology_text).strip() + '\n')
+  _init_log()
+  capfd.readouterr()
+  topology = create.run([str(lab / 'topology.yml')])              # default outputs: config, provider, pickle, tools, ansible
+  out, err = capfd.readouterr()
+  return lab, topology, out.replace(str(tmp_path / name), '<ROOT>'), err.replace(str(tmp_path / name), '<ROOT>')
+
+
+def _tree(lab: Path, root: Path) -> dict:
+  out = {}
+  for p in sorted(lab.rglob('*')):
+    if p.is_file() and '__pycache__' not in p.parts:
+      rel = str(p.relative_to(lab))
+      raw = p.read_bytes()
+      if rel.endswith('.pickle'):
+        data = pickle.loads(raw)
+        data.get('defaults', {}).get('_cache', {}).pop('timestamp', None)
+        raw = repr(data).encode()
+      out[rel] = (raw.replace(str(root).encode(), b'<ROOT>'), p.stat().st_mode)
+  return out
+
+
+def _plain(topology) -> dict:
+  d = topology.to_dict()
+  providers = d.pop('_Providers', {})
+  d['_Providers'] = sorted(providers)                              # provider objects: compare which, not identity
+  d.get('defaults', {}).get('_cache', {}).pop('timestamp', None)   # wall-clock time of the run
+  return d
+
+
+@pytest.fixture
+def warm(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capfd: pytest.CaptureFixture) -> None:
+  """netlab caches the parsed defaults on first use and the key order of a cold and a warm start differ: compare warm starts."""
+  _compile(tmp_path, monkeypatch, capfd, 'warmup', parallel=False)
+
+
+def test_parallel_outputs_are_used_for_a_default_create(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                        capfd: pytest.CaptureFixture) -> None:
+  """Positive control for the equality tests below: the parallel paths really run."""
+  calls = {'outputs': 0, 'config': 0}
+  real_out, real_cfg = parallel_outputs.run, parallel_config.run
+  monkeypatch.setattr(parallel_outputs, 'run', lambda *a: (calls.__setitem__('outputs', calls['outputs'] + 1), real_out(*a)))
+  monkeypatch.setattr(parallel_config, 'run', lambda *a: (calls.__setitem__('config', calls['config'] + 1), real_cfg(*a)))
+  _compile(tmp_path, monkeypatch, capfd, 'on', parallel=True)
+  assert calls == {'outputs': 1, 'config': 1}
+
+
+def test_files_console_and_returned_topology_are_identical(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                           capfd: pytest.CaptureFixture) -> None:
+  lab_off, topo_off, out_off, err_off = _compile(tmp_path, monkeypatch, capfd, 'off', parallel=False)
+  lab_on, topo_on, out_on, err_on = _compile(tmp_path, monkeypatch, capfd, 'on', parallel=True)
+  off, on = _tree(lab_off, tmp_path / 'off'), _tree(lab_on, tmp_path / 'on')
+  assert set(on) == set(off) and len(on) > 20
+  assert [k for k in on if on[k] != off[k]] == []
+  assert out_on == out_off and 'CONFIG' in out_on
+  assert err_on == err_off
+  assert repr(_plain(topo_on)).replace(str(tmp_path / 'on'), '<ROOT>') == \
+         repr(_plain(topo_off)).replace(str(tmp_path / 'off'), '<ROOT>')
+
+
+def test_provider_output_reads_the_files_config_writes(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                       capfd: pytest.CaptureFixture) -> None:
+  """Why 'config' is a barrier: the KNE provider builds each startup-config from the node_files 'config' writes, so
+  'provider' without 'config' first writes different files."""
+  lab_full, _, _, _ = _compile(tmp_path, monkeypatch, capfd, 'full', parallel=False)
+  lab = tmp_path / 'provider-only' / 'lab'
+  lab.mkdir(parents=True)
+  monkeypatch.chdir(lab)
+  memo.invalidate()
+  (lab / 'topology.yml').write_text(textwrap.dedent(_TOPOLOGY).strip() + '\n')
+  _init_log()
+  create.run(['-o', 'provider', str(lab / 'topology.yml')])
+  full, alone = _tree(lab_full, tmp_path / 'full'), _tree(lab, tmp_path / 'provider-only')
+  startup = [ k for k in full if k.endswith('/startup-config') ]
+  assert startup and all(full[k][0] for k in startup)
+  assert [ k for k in startup if alone.get(k) != full[k] ] == startup
+
+
+def test_provider_starts_only_after_config_has_finished(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                        capfd: pytest.CaptureFixture) -> None:
+  """The barrier itself, independent of timing luck: a slow 'config' must have finished before 'provider' starts."""
+  import time
+  from netsim.outputs import config as config_output, provider as provider_output
+  events = tmp_path / 'events'
+
+  def traced(cls, name, delay=0.0):
+    real = cls.write
+    def write(self, topology) -> None:
+      with open(events, 'a') as f: f.write(f'{name} start\n')
+      time.sleep(delay)
+      real(self, topology)
+      with open(events, 'a') as f: f.write(f'{name} end\n')
+    monkeypatch.setattr(cls, 'write', write)
+
+  traced(config_output.ConfigurationFiles, 'config', delay=1.0)
+  traced(provider_output.ProviderConfiguration, 'provider')
+  _compile(tmp_path, monkeypatch, capfd, 'on', parallel=True)
+  order = events.read_text().split('\n')
+  assert order.index('config end') < order.index('provider start')
+
+
+def test_pickle_runs_in_process_so_the_returned_topology_matches(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                                 capfd: pytest.CaptureFixture) -> None:
+  """'pickle' changes the topology it writes (provider cache back into _Providers); in a worker that change would be
+  lost and create.run() would return a different topology."""
+  _, topo_off, _, _ = _compile(tmp_path, monkeypatch, capfd, 'off', parallel=False)
+  monkeypatch.setattr(parallel_outputs, 'IN_PROCESS', set())
+  _, topo_on, _, _ = _compile(tmp_path, monkeypatch, capfd, 'on', parallel=True)
+  assert repr(_plain(topo_on)).replace(str(tmp_path / 'on'), '<ROOT>') != \
+         repr(_plain(topo_off)).replace(str(tmp_path / 'off'), '<ROOT>')
+
+
+def test_an_error_in_a_worker_fails_the_run_like_the_sequential_loop(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                                     capfd: pytest.CaptureFixture) -> None:
+  from netsim.outputs import ansible as ansible_output
+
+  def broken(self, topology) -> None:
+    log.error('ansible output broke on purpose', log.IncorrectValue, 'ansible')
+
+  monkeypatch.setattr(ansible_output.AnsibleInventory, 'write', broken)
+  results = {}
+  for name, parallel in (('off', False), ('on', True)):
+    with pytest.raises(SystemExit) as ex:
+      _compile(tmp_path, monkeypatch, capfd, name, parallel=parallel)
+    results[name] = (ex.value.code, capfd.readouterr())
+  assert results['on'][0] == results['off'][0] != 0
+  err = { k: v[1].err.replace(str(tmp_path / k), '<ROOT>') for k, v in results.items() }
+  assert err['on'] == err['off'] and 'broke on purpose' in err['on']
+
+
+def test_once_only_messages_are_printed_once(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                             capfd: pytest.CaptureFixture) -> None:
+  """netlab prints the 'Errors encountered' header and each documentation hint once per process. Two config workers
+  that each hit a missing template must not print them twice (found on the blueprint corpus: demo-lab/full)."""
+  broken = _TOPOLOGY.replace('  s1: { bgp.rr: true }', '  s1: { bgp.rr: true, config: [ no_such_template ] }') \
+                    .replace('  h3: { device: linux }', '  h3: { device: linux, config: [ no_such_template ] }')
+  assert broken != _TOPOLOGY
+  results = {}
+  for name, parallel in (('off', False), ('on', True)):
+    with pytest.raises(SystemExit):
+      _compile(tmp_path, monkeypatch, capfd, name, parallel=parallel, topology_text=broken)
+    results[name] = capfd.readouterr()
+  err = { k: v.err.replace(str(tmp_path / k), '<ROOT>') for k, v in results.items() }
+  assert err['off'].count("--debug template") == 1 and 'no_such_template' in err['off']
+  assert err['on'] == err['off']
+  assert results['on'].out.replace(str(tmp_path / 'on'), '<ROOT>') == results['off'].out.replace(str(tmp_path / 'off'), '<ROOT>')
+
+
+def test_once_only_messages_across_output_modules(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                  capfd: pytest.CaptureFixture) -> None:
+  """Same as above across two output-module workers: the first one warns, the second one fails. The header and the
+  hint must appear once, in the sequential order."""
+  from netsim.outputs import ansible as ansible_output, provider as provider_output
+  real_provider = provider_output.ProviderConfiguration.write
+
+  hint = 'a hint netlab prints once per process'
+
+  def warn_then_write(self, topology) -> None:
+    log.warning(text='provider output warns on purpose', module='provider', more_hints=[hint])
+    real_provider(self, topology)
+
+  def broken(self, topology) -> None:
+    log.error('ansible output broke on purpose', log.IncorrectValue, 'ansible', more_hints=[hint])
+
+  monkeypatch.setattr(provider_output.ProviderConfiguration, 'write', warn_then_write)
+  monkeypatch.setattr(ansible_output.AnsibleInventory, 'write', broken)
+  results = {}
+  for name, parallel in (('off', False), ('on', True)):
+    with pytest.raises(SystemExit):
+      _compile(tmp_path, monkeypatch, capfd, name, parallel=parallel)
+    results[name] = capfd.readouterr()
+  err = { k: v.err.replace(str(tmp_path / k), '<ROOT>') for k, v in results.items() }
+  assert 'warns on purpose' in err['off'] and 'broke on purpose' in err['off'] and err['off'].count(hint) == 1
+  assert err['on'] == err['off']
+
+
+def test_shared_templates_see_the_sequential_shared_list() -> None:
+  """The per-node workers must hand each node exactly the shared_list the sequential loop had on reaching it."""
+
+  class Topo(dict):
+    pass
+
+  nodes = {f'n{i}': {'shared': src} for i, src in
+           enumerate([['a'], [], ['a', 'b'], ['b'], ['c', 'a', 'c'], [], ['d'], ['a', 'd', 'e']])}
+  topo = Topo(nodes=nodes)
+  topo.nodes = nodes
+
+  def run_sequential() -> dict:
+    seen, shared = {}, []
+    for name, data in nodes.items():
+      seen[name] = list(shared)
+      for src in data['shared']:
+        if src not in shared:
+          shared.append(src)
+    return seen
+
+  seen: dict = {}
+
+  def one_node(name, data, shared_list) -> None:
+    seen[name] = list(shared_list)
+
+  # run the parallel planner in-process (no fork) by replacing the worker start with a direct call
+  results = []
+
+  def start(fn, tmpdir, tag):
+    fn()
+    results.append(tag)
+    return len(results)
+
+  orig = (forkrun.start, forkrun.collect, forkrun.replay, forkrun.clean)
+  try:
+    forkrun.start = start
+    forkrun.collect = lambda pid, tmpdir, tag, what: {}
+    forkrun.replay = lambda r, exit_on_error=True: None
+    forkrun.clean = lambda r: True
+    parallel_config.run(topo, one_node, lambda d: d['shared'])
+  finally:
+    forkrun.start, forkrun.collect, forkrun.replay, forkrun.clean = orig
+  assert seen == run_sequential()
+
+
+def test_no_fork_while_threads_are_running() -> None:
+  stop = threading.Event()
+  t = threading.Thread(target=stop.wait)
+  t.start()
+  try:
+    assert forkrun.fork_ok() is False
+  finally:
+    stop.set()
+    t.join()
+  assert forkrun.fork_ok() is True
+
+
+def test_explicit_outputs_keep_the_sequential_loop() -> None:
+  from box import Box
+
+  class Args:
+    devices = None
+
+  args = Args()
+  args.output = Box({'config': None, 'provider': None, 'pickle': None, 'tools': None, 'ansible': None})
+  assert parallel_outputs.usable(args, Box()) is True               # the defaults, as netlab create uses them
+  args.output = ['config', 'provider', 'pickle', 'ansible']          # the same modules, named with -o
+  assert parallel_outputs.usable(args, Box()) is False
+  args.output = Box({'config': None, 'provider': None, 'ansible': 'dir'})   # an output with an option
+  assert parallel_outputs.usable(args, Box()) is False
+  args.output = Box({'config': None, 'provider': None, 'no_such_output': None})
+  assert parallel_outputs.usable(args, Box()) is False
+  args.output = Box({'config': None, 'provider': None, 'pickle': None, 'tools': None, 'ansible': None})
+  args.devices = ['r1']
+  assert parallel_outputs.usable(args, Box()) is False
+
+
+def test_a_worker_sees_the_keys_earlier_module_loads_added(warm, tmp_path: Path, monkeypatch: pytest.MonkeyPatch,
+                                                          capfd: pytest.CaptureFixture) -> None:
+  """Loading an output module can add an empty defaults.outputs.<name> entry to the topology, and the pickle written
+  after it records that. Modules must therefore be loaded in this process, in order: loading them all up front made
+  the pickle differ on every blueprint (found on the corpus run)."""
+  lab_off, _, _, _ = _compile(tmp_path, monkeypatch, capfd, 'off', parallel=False)
+  lab_on, _, _, _ = _compile(tmp_path, monkeypatch, capfd, 'on', parallel=True)
+  off = pickle.loads((lab_off / 'netlab.snapshot.pickle').read_bytes())
+  on = pickle.loads((lab_on / 'netlab.snapshot.pickle').read_bytes())
+  assert list(on['defaults']['outputs'].keys()) == list(off['defaults']['outputs'].keys())
