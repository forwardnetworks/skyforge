-  return features + n_features
+  if not n_features:                     # SKYFORGE-SPECIFIC: nothing to merge, so this is just features.copy() (one copy
+    return fastbox.copy_box(features)    # ... where the uncached code made two: the merge, then the copy; same result)
+
+  return fastbox.add(features,n_features)
+
+def get_device_features_readonly(node: Box, defaults: Box) -> Box:
+  """
+  SKYFORGE-SPECIFIC: get_device_features for callers that only READ the result with .get() and `in` (see
+  get_device_attribute_readonly). Falls back to get_device_features whenever the node has its own features.
+  """
+  if node.get('_features',None):
+    return get_device_features(node,defaults)
+  features,_shared = _device_attribute(node,'features',defaults)
