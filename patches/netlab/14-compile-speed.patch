@@ -0,0 +1,96 @@
+"""
+SKYFORGE-SPECIFIC compile-time memoisation of lookups that are rebuilt for every node and link.
+
+Why: python-box rebuilds (deep-copies) a whole Box on every `a + b`. netlab does that for the same device-type
+feature tables and the same attribute-definition tables once per node, interface and attribute -- tens of thousands
+of times for a 512-node lab -- and the cost grows faster than linearly with the node count.
+
+The caches are CONSERVATIVE:
+
+* an entry is only a hit when the SOURCE OBJECTS it was built from are the same Python objects (identity, not
+  equality), so replacing a table is a miss;
+* for the device tables, which plugins and hooks may edit in place, an entry is also a miss when the content of the
+  sources no longer equals the snapshot taken when the entry was built;
+* every cache is dropped (`invalidate`) around each plugin hook, module hook, provider hook and output module;
+* a cached device table is never handed out itself: callers get a copy of their own, as they always did (python-box
+  creates a key when a missing one is read, and that must not leak from one caller to the next);
+* `SKYFORGE_NETLAB_COMPILE_MEMO=0` switches the whole thing off (no caching, original behaviour);
+* `SKYFORGE_NETLAB_COMPILE_MEMO_VERIFY=1` recomputes on EVERY hit and aborts if the cached value differs. The test
+  corpus is run that way. (The switches are not NETLAB_*: netlab turns every NETLAB_* variable into a defaults entry.)
+"""
+
+import atexit
+import copy
+import os
+import typing
+
+from box import Box
+
+from ..utils import log
+
+DISABLED = os.environ.get('SKYFORGE_NETLAB_COMPILE_MEMO','1') == '0'
+VERIFY = os.environ.get('SKYFORGE_NETLAB_COMPILE_MEMO_VERIFY','0') == '1'
+STATS = os.environ.get('SKYFORGE_NETLAB_COMPILE_MEMO_STATS','0') == '1'
+
+# name -> key -> (refs, value, compute, snapshots of the watched objects)
+_caches: typing.Dict[str, typing.Dict[typing.Any, tuple]] = {}
+stats: typing.Dict[str, typing.List[int]] = {}
+
+def invalidate() -> None:
+  _caches.clear()
+
+def _same(a: typing.Any, b: typing.Any) -> bool:
+  return a == b
+
+def _snapshot(obj: typing.Any) -> typing.Any:
+  from . import fastbox
+  return fastbox.to_dict(obj) if isinstance(obj,Box) else copy.deepcopy(obj)
+
+def memo(
+      name: str,
+      key: typing.Hashable,
+      refs: tuple,
+      compute: typing.Callable[[], typing.Any],
+      watch: tuple = ()) -> typing.Any:
+  """
+  Return compute() once per (name,key) while the objects in `refs` stay the same objects and the objects in `watch`
+  still have the content they had when the value was computed (a plugin or hook that edits one of them in place gets a
+  fresh computation, not a stale answer). The returned object is SHARED between callers: callers must not modify it
+  (verify mode enforces that).
+  """
+  if DISABLED:
+    return compute()
+
+  cache = _caches.setdefault(name,{})
+  stat = stats.setdefault(name,[0,0])
+  entry = cache.get(key)
+  if entry is not None and len(entry[0]) == len(refs) and all(a is b for a,b in zip(entry[0],refs)) \
+      and all(w == snap for w,snap in zip(watch,entry[3])):
+    stat[0] += 1
+    if VERIFY:
+      fresh = compute()
+      if not _same(fresh,entry[1]):
+        log.fatal(f'netlab memo: cached {name} {key!r} differs from a fresh computation (stale entry or a caller modified a shared result)')
+    return entry[1]
+
+  stat[1] += 1
+  value = compute()
+  cache[key] = (refs,value,compute,tuple(_snapshot(w) for w in watch))
+  return value
+
+def verify_all(where: str) -> None:
+  """Recompute every cached entry and abort if any differs from what callers have been handed."""
+  if DISABLED:
+    return
+  for name,cache in _caches.items():
+    for key,(refs,value,compute,_snaps) in cache.items():
+      if not _same(compute(),value):
+        log.fatal(f'netlab memo: cached {name} {key!r} differs from a fresh computation at {where} (stale entry or a caller modified a shared result)')
+
+def report() -> None:
+  if STATS:
+    for name,(hit,miss) in sorted(stats.items()):
+      print(f'memo {name}: hits={hit} misses={miss}')
+
+if STATS:
+  atexit.register(report)
