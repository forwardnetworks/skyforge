+def test_stripping_a_secondary_namespace_never_reaches_the_next_validation(monkeypatch: pytest.MonkeyPatch) -> None:
+  """
+  get_valid_attributes strips the _required flags of a secondary namespace that has a no_propagate list IN the table
+  it is given. With the speed-ups that table shares namespaces with the cache, so the strip must land on a copy.
+  Compared against the same sequence with the speed-ups off.
+  """
+  from netsim.data import validate
+  _init_log()
+  attrs = get_box({
+    'node': {'name': 'str', 'mode': {'type': 'str', '_required': True}},
+    'link': {'mtu': 'int', 'tunnel': {'type': 'dict', '_keys': {'mode': {'type': 'str', '_required': True}}},
+             'bw': {'type': 'int', '_required': True}},
+    'link_no_propagate': ['bw'],
+    'interface': {'ifindex': 'int'},
+  })
+  extra = get_box({'node': {'clab': None}, 'link': {'clab': None}})
+
+  def sequence() -> tuple:
+    memo.invalidate()
+    first = validate.resolve_attributes(attrs, extra, ['node'])         # resolving 'node' leaves 'link' untouched
+    validate.get_valid_attributes(first[0], ['interface', 'link'])      # strips link.* _required in first[0]
+    second = validate.resolve_attributes(attrs, extra, ['node'])
+    return fastbox.to_dict(first[0]), fastbox.to_dict(second[0])
+
+  fast_first, fast_second = sequence()
+  monkeypatch.setattr(memo, 'DISABLED', True)
+  monkeypatch.setattr(fastbox, 'ENABLED', False)
+  slow_first, slow_second = sequence()
+  assert slow_first != slow_second                     # the test is only meaningful if something was stripped
+  assert fast_first == slow_first                      # the strip happened in the validation's own table ...
+  assert fast_second == slow_second                    # ... and not in the next one
+  assert attrs.link.tunnel._keys.mode._required is True
+
+
+def test_recursive_validation_on_a_private_table_matches_the_uncached_code(monkeypatch: pytest.MonkeyPatch) -> None:
+  """
+  A recursive validation reuses its caller's merged table; with the speed-ups its namespaces and valid-attribute
+  table come from a cache keyed by the table's origin and stripped namespaces, and the strip is replayed on a hit.
+  Every result and the table itself must equal the uncached sequence, on the first call and on cache hits.
+  """
+  from netsim.data import validate
+  _init_log()
+  attrs = get_box({
+    'node': {'name': 'str', 'mode': {'type': 'str', '_required': True}},
+    'interface': {'ifindex': 'int', '_namespace': ['link']},
+    'link': {'mtu': {'type': 'int', '_required': True}, 'bw': {'type': 'int', '_required': True}},
+    'link_no_propagate': ['bw'],
+  })
+  extra = get_box({'node': {'clab': None}})
+
+  def sequence() -> list:
+    memo.invalidate()
+    out = []
+    for _ in range(3):                                 # first call fills the cache, the others hit it
+      table = validate.resolve_attributes(attrs, extra, ['node'])[0]
+      for attr_list in (['interface'], ['node'], ['interface']):
+        _t, ns, valid = validate.resolve_attributes(table, None, attr_list)
+        out.append((list(ns), fastbox.to_dict(valid) if isinstance(valid, Box) else valid, fastbox.to_dict(table)))
+    return out
+
+  fast = sequence()
+  monkeypatch.setattr(memo, 'DISABLED', True)
+  monkeypatch.setattr(fastbox, 'ENABLED', False)
+  slow = sequence()
+  assert fast == slow
+  assert slow[0][2] != fastbox.to_dict(attrs + extra)  # the strip happened (the test exercises the side effect)
+
