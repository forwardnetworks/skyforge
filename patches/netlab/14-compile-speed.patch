   return data
 
+def get_consolidated_device_data_readonly(node: Box, defaults: Box) -> Box:
+  """
+  SKYFORGE-SPECIFIC: get_consolidated_device_data for a caller that only READS the result (.get(), `in`, existing
+  keys). The merged device definition is the same for every node of a device type and provider, so it is built once
+  (netsim.data.memo: same source objects and unchanged content, dropped around every hook) and shared: never modify
+  it, never read a missing key with attribute or [] access.
+  """
+  devtype  = node.device
+  provider = get_provider(node,defaults)
+  if not devtype in defaults.devices:
+    return get_consolidated_device_data(node,defaults)
+  devdata = defaults.devices[devtype]
+  return memo.memo(
+    'consolidated_device_data',
+    (id(defaults),devtype,provider),
+    (defaults,devdata),
+    lambda: get_consolidated_device_data(node,defaults),
+    watch=(devdata,tuple(defaults.providers.keys())))     # the merge drops every provider's own block
+
