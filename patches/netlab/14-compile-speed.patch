+    got = bgp.find_bgp_rr(1, topo)
+    got.clear()                                                          # callers get their own list
+    assert len(bgp.find_bgp_rr(1, topo)) == 2
+    assert [n.name for n in bgp._index_members(1, topo)] == ['a', 'b', 'e'] and [n.name for n in bgp._index_members('1', topo)] == ['f']
+    _same(topo, ref)
+  finally:
+    bgp._as_index = None
+
+
+def test_the_as_index_steps_aside_for_anything_it_cannot_answer_exactly() -> None:
+  from netsim.modules import bgp
+  try:
+    topo = _as_topology()
+    bgp.build_as_index(topo)
+    assert bgp._index_for(_as_topology()) is None                        # another topology object
+    topo.nodes.z = get_box({'name': 'z'})
+    assert bgp._index_for(topo) is None                                  # the node set changed
+    assert bgp._index_rr(1, topo) is None and bgp._index_members(1, topo) is None
+    topo = _as_topology(); topo.nodes.c.vrfs = {'v': {}}                 # vrf can set a fake bgp.as later: no index at all
+    bgp.build_as_index(topo)
+    assert bgp._as_index is None
+    topo = _as_topology(); topo.nodes.e.bgp = {'rr': True}               # a shape the scan handles through python-box
+    bgp.build_as_index(topo)
+    assert bgp._index_rr(1, topo) is None and bgp._index_members(1, topo) is not None
+    topo = _as_topology(); topo.nodes.e.bgp = {'as': [1], 'rr': True}    # an AS that cannot be a dictionary key
+    bgp.build_as_index(topo)
+    assert bgp._as_index is None
+    topo = _as_topology()
+    bgp.build_as_index(topo)
+    assert bgp._index_rr([1], topo) is None and bgp._index_members({}, topo) is None
+    bgp.BGP({}).module_cleanup(topo)
+    assert bgp._as_index is None
+  finally:
+    bgp._as_index = None
+
+
+def test_compile_output_is_identical_with_and_without_the_as_index(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """Route reflectors, an iBGP full mesh, EBGP between the ASes: sessions must not change."""
+  from netsim.modules import bgp
+  text = _bgp_lab_topology()
+  built = []
+  real = bgp.build_as_index
+  def spy(topology):
