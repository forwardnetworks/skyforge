+  (lab / 'topology.yml').write_text('plugin: [ edit_features ]\n' + textwrap.dedent(_TOPOLOGY).strip() + '\n')
+  _init_log()
+  create.run(['-o', 'config', '-o', 'provider', '-o', 'ansible:dir', '-o', 'pickle', str(lab / 'topology.yml')])
