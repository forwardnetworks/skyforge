diff --git a/netsim/outputs/parallel_config.py b/netsim/outputs/parallel_config.py
new file mode 100644
index 0000000..577f8b6
--- /dev/null
+++ b/netsim/outputs/parallel_config.py
@@ -0,0 +1,78 @@
+#
+# SKYFORGE-SPECIFIC (patch 57): render node configuration files in forked workers.
+#
+# The node loop in outputs/config.py is independent per node except for one piece of shared state: the list of
+# "shared" config templates already written. The parent computes, for every node, exactly the shared_list the
+# sequential loop would have had on reaching that node, then hands contiguous chunks of nodes to workers. Each worker
+# writes its nodes' files; its console lines, errors and warnings are replayed in chunk order (utils/forkrun.py), so
+# the files, the CONFIG lines and the exit status are the same as the sequential loop.
+#
+# Used only when the lab has at least SKYFORGE_NETLAB_PARALLEL_CONFIG_MIN nodes (default 64), forking is safe, and
+# SKYFORGE_NETLAB_PARALLEL_OUTPUTS is not 0. Workers: SKYFORGE_NETLAB_CONFIG_WORKERS (default min(8, CPUs)).
+#
+import os
+import shutil
+import tempfile
+import typing
+
+from box import Box
+
+from ..utils import forkrun
+
+
+def _workers() -> int:
+  try:
+    want = int(os.environ.get('SKYFORGE_NETLAB_CONFIG_WORKERS', '0'))
+  except ValueError:
+    want = 0
+  cpus = len(os.sched_getaffinity(0)) if hasattr(os, 'sched_getaffinity') else (os.cpu_count() or 1)
+  return max(1, want if want > 0 else min(8, cpus))
+
+
+def usable(topology: Box) -> bool:
+  if os.environ.get('SKYFORGE_NETLAB_PARALLEL_OUTPUTS', '1') == '0' or not forkrun.fork_ok():
+    return False
+  try:
+    min_nodes = int(os.environ.get('SKYFORGE_NETLAB_PARALLEL_CONFIG_MIN', '64'))
+  except ValueError:
+    min_nodes = 64
+  return len(topology.nodes) >= min_nodes and _workers() > 1
+
+
+def run(topology: Box, one_node: typing.Callable, shared_sources: typing.Callable, unshare: typing.Optional[typing.Callable] = None) -> None:
+  names = list(topology.nodes.keys())
+  shared: list = []                             # simulate the sequential loop's shared_list
+  start_state = {}
+  for n_name in names:
+    start_state[n_name] = list(shared)
+    for src in shared_sources(topology.nodes[n_name]):
+      if src not in shared:
+        shared.append(src)
+
+  w = min(_workers(), len(names))
+  size = -(-len(names) // w)
+  chunks = [ names[i:i + size] for i in range(0, len(names), size) ]
+
+  def chunk_fn(chunk: list) -> typing.Callable[[], None]:
+    def fn() -> None:
+      for n_name in chunk:
+        one_node(n_name, topology.nodes[n_name], list(start_state[n_name]))
+    return fn
+
+  with tempfile.TemporaryDirectory(prefix='netlab-config-') as tmpdir:
+    pids = [ forkrun.start(chunk_fn(c), tmpdir, f'c{i}') for i, c in enumerate(chunks) ]
+    results = [ forkrun.collect(pid, tmpdir, f'c{i}', 'config worker') for i, pid in enumerate(pids) ]
+    if all(forkrun.clean(r) for r in results):
+      for r in results:
+        forkrun.replay(r, exit_on_error=False)  # the output loop checks errors after the module, as before
+      return
+
+  # A worker logged something (an error, a warning, a hint). What netlab prints once per process can only be printed
+  # right by this process: start the node files again and render every node here, exactly as the original loop does.
+  if os.path.exists('node_files'):
+    shutil.rmtree('node_files')
+  if unshare is not None:                       # SKYFORGE-SPECIFIC (patch 61): the topology was shared with the caller's
+    topology = unshare()                        # ... own, and the original loop rendered a private copy
+  shared_list: list = []
+  for n_name in names:
+    one_node(n_name, topology.nodes[n_name], shared_list)
