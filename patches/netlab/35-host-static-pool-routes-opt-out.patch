From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] SKYFORGE-SPECIFIC: OSPF-speaking hosts that opt out skip pool
 static routes

---
diff --git a/netsim/devices/a10.yml b/netsim/devices/a10.yml
index 0e5b6f8..891bdfe 100644
--- a/netsim/devices/a10.yml
+++ b/netsim/devices/a10.yml
@@ -95,6 +95,7 @@ features:
     ipv4: true
   routing:
     static: true
+    static_pool_routes: false   # SKYFORGE-SPECIFIC: role host, but OSPF-learned (seed has no 'ip route')
 
 kne:
   interface.name: eth{ifindex}
diff --git a/netsim/roles/host.py b/netsim/roles/host.py
index 4ffc6f2..7349bc5 100644
--- a/netsim/roles/host.py
+++ b/netsim/roles/host.py
@@ -52,6 +52,15 @@ def add_host_static_routes(topology: Box) -> None:
     if n_data.get('routing.static',None):         # Host already has static routes, move on
       continue
 
+    # SKYFORGE-SPECIFIC: a 'host'-role device that runs OSPF (A10 vThunder in demo-lab)
+    # learns its routes dynamically; pool-prefix static routes via the first gateway
+    # would override that and loop against the neighbouring firewall. Skip only when the
+    # device opts out AND the node actually has the ospf module; an A10 with no IGP keeps
+    # its pool routes (they are its only routes).
+    if 'ospf' in n_data.get('module',[]) and \
+       not devices.get_device_features(n_data,topology.defaults).get('routing.static_pool_routes',True):
+      continue
+
     # Premature optimization: create the default static route list only when encountering the first host
     if sr_list is None:
       sr_list = default_static_route_list(topology)
-- 
