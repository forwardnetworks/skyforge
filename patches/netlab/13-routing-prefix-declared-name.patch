diff --git a/netsim/modules/routing/prefix.py b/netsim/modules/routing/prefix.py
index 45f5ff9..56aa774 100644
--- a/netsim/modules/routing/prefix.py
+++ b/netsim/modules/routing/prefix.py
@@ -15,6 +15,66 @@ from ...data import append_to_list, get_empty_box
 from ...utils import log
 from . import utils as _utils
 
+"""
+extract_prefix_names:
+
+A prefix filter is normally a list of entries. It can also be a dictionary with a
+'value' list and a 'name' -- the exact object name the DEVICE gets (the same shape
+the community lists use for their 'type' + 'value'). The dictionary is folded back
+into the plain list before validation, and the declared name is kept in
+routing._pfxname[<key>] so expand_prefix_list can build the per-AF name map.
+
+Why: netlab appends the address family to every prefix-list name ('p1-ipv4') so
+platforms with one namespace for IPv4 and IPv6 prefix lists never collide. Some
+labs need the configured name to be exactly what was declared (a change-review
+demo edits the lists by name), and IOS keeps 'ip prefix-list' and 'ipv6
+prefix-list' in separate namespaces anyway.
+"""
+def extract_prefix_names(r_object: Box, o_name: str = 'topology') -> None:
+  pfx = r_object.get('routing.prefix',None)
+  if not isinstance(pfx,Box):
+    return
+
+  for key in list(pfx.keys()):
+    pdata = pfx[key]
+    if not isinstance(pdata,Box) or 'value' not in pdata:
+      continue
+    extra = [ k for k in pdata.keys() if k not in ('name','value') ]
+    if extra:
+      log.error(
+        f'Prefix filter {key} in {o_name} can have only "name" and "value" attributes, found {",".join(extra)}',
+        category=log.IncorrectAttr,
+        module='routing')
+    if 'name' in pdata:
+      if not isinstance(pdata.name,str) or not pdata.name:
+        log.error(
+          f'The "name" of prefix filter {key} in {o_name} must be a non-empty string',
+          category=log.IncorrectType,
+          module='routing')
+      else:
+        r_object.routing._pfxname[key] = pdata.name
+    pfx[key] = pdata.value
+
+"""
+declared_prefix_name: the declared device name of prefix filter <p_name>, or None
+
+* Without a declared 'name' the device configures '<p_name>-<af>' (unchanged behavior on every platform)
+* A declared 'name' is used verbatim when the device features declare routing.prefix.name
+  (the device keeps per-AF prefix lists in separate namespaces or the caller accepts the
+  collision); on any other device it is an error, not a silent fallback.
+"""
+def declared_prefix_name(p_name: str, node: Box, topology: Box, features: Box) -> typing.Optional[str]:
+  declared = node.get(f'routing._pfxname.{p_name}',None) or topology.get(f'routing._pfxname.{p_name}',None)
+  if not declared:
+    return None
+  if not features.get('routing.prefix.name',False):
+    log.error(
+      f'Device {node.device} (node {node.name}) cannot use the declared prefix-list name "{declared}" (prefix filter {p_name})',
+      more_hints=['The device configuration templates use netlab prefix list names (<name>-<af>)'],
+      category=log.IncorrectAttr,
+      module='routing')
+    return None
+  return declared
 
 def expand_prefix_entry(p_entry: Box, path: str, topology: Box) -> Box:
   """
@@ -178,6 +238,7 @@ def expand_prefix_list(p_name: str,o_name: str,node: Box,topology: Box) -> typin
   node.routing[o_name][p_name] = sorted(node.routing[o_name][p_name],key=lambda O: O.get('sequence',10))
   features = a_devices.get_device_features(node,topology.defaults)
   min_strict = features.get('routing.prefix.strict',False)
+  declared = declared_prefix_name(p_name,node,topology,features)
   af_prefix: dict = {}                                      # Prepare dictionary of per-AF prefix lists
   for af in ('ipv4','ipv6'):                                # Iterate over address families (sorry, no CLNS or IPX)
     af_prefix[af] = []                                      # Start with an emtpy per-AF list
@@ -197,5 +258,7 @@ def expand_prefix_list(p_name: str,o_name: str,node: Box,topology: Box) -> typin
       node.routing['_'+o_name][af][p_name] = af_prefix[af]  # ... yes, save it
     else:
       node.routing['_'+o_name][af][p_name] = create_empty_prefix_list(af)      
+    # The name the device gets for this per-AF list ('<name>-<af>' unless a name was declared)
+    node.routing['_'+o_name+'_name'][af][p_name] = declared or f'{p_name}-{af}'
 
   return None                                               # No need to do additional checks
