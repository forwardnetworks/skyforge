@@ -0,0 +1,37 @@
+# Test prefix filters that keep a declared device list name
+#
+addressing.loopback.ipv6: 2001:db8:cafe::/48
+module: [ routing ]
+provider: clab                # To make IOL work
+defaults.device: iol
+
+prefix:
+  lan_ds:
+    ipv4: 192.168.42.0/24
+    ipv6: 2001:db8:cafe:42::/64
+
+routing.prefix:
+  p_named:                    # Global filter with a declared name
+    name: CUSTOMER-IN
+    value:
+    - prefix: 10.0.0.0/8
+      max: 24
+    - prefix: prefix.lan_ds   # Dual-stack: the name is used for the ipv4 and ipv6 lists
+  p_plain:                    # A plain list keeps the <name>-<af> names
+  - prefix: 172.16.0.0/12
+
+routing.policy:
+  pol_named:
+  - match.prefix: p_named
+  - match.prefix: p_plain
+
+nodes:
+  r1:
+    routing.policy:
+      pol_named:              # Imports p_named and p_plain
+  r2:
+    routing.prefix:
+      p_local:                # Node filter with a declared name
+        name: LOCAL-OUT
+        value:
+        - prefix: 192.0.2.0/24
