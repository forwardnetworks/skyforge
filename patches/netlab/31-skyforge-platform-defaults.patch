From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Fri, 2 Oct 2026 12:00:00 +0000
Subject: [PATCH] skyforge platform defaults (provider kne, mgmt pool, KNE
 provider settings, credentials)

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/netsim/defaults/addressing.yml b/netsim/defaults/addressing.yml
index 4cea7a8..56c9243 100644
--- a/netsim/defaults/addressing.yml
+++ b/netsim/defaults/addressing.yml
@@ -10,7 +10,7 @@ lan:
 p2p:
   ipv4: 10.1.0.0/16
 mgmt:
-  ipv4: 192.168.121.0/24
+  ipv4: 172.20.20.0/22
   start: 100
   mac: CA-FE-00-00-00-00
 l2only:
diff --git a/netsim/defaults/const.yml b/netsim/defaults/const.yml
index fb3925a..3f855eb 100644
--- a/netsim/defaults/const.yml
+++ b/netsim/defaults/const.yml
@@ -7,5 +7,5 @@ multi_provider: [ libvirt, clab ]
 ifname:
   neighbors: 5
   maxlength: 255
-MAX_NODE_ID: 150
+MAX_NODE_ID: 250
 doc_url_prefix: https://netlab.tools/
diff --git a/netsim/devices/a10.yml b/netsim/devices/a10.yml
index 7999fe2..0e5b6f8 100644
--- a/netsim/devices/a10.yml
+++ b/netsim/devices/a10.yml
@@ -23,7 +23,14 @@ clab:
   interface:
     name: eth{ifindex}
 group_vars:
-  ansible_network_os: acos
+  # FQCN, not the bare short name. The acos cliconf/terminal plugins live in
+  # the vendored a10.acos_cli collection and its meta/runtime.yml declares NO
+  # redirect for the short name, so `acos` alone does not resolve and ansible
+  # fails the very first task with "network os acos is not supported" -- an
+  # UNREACHABLE verdict, which reads as the appliance never booting rather
+  # than as a plugin-resolution error. Verified present in the netlab image:
+  # vendor/ansible_collections/a10/acos_cli/plugins/{cliconf,terminal}/acos.py
+  ansible_network_os: a10.acos_cli.acos
   ansible_user: admin
   ansible_password: a10
   ansible_ssh_pass: a10
@@ -61,8 +68,17 @@ group_vars:
   # ssh first (connect-only, above), then readiness-check/a10.yml proves enable
   # mode and a configure-terminal session before netmiko pushes the config.
   netlab_ready: [ ssh, ansible ]
-  netlab_check_retries: 90
+  # Full-scale KNE runs can delay vThunder SSH readiness well beyond 30m.
+  # Keep the contract in defaults (not upstream netlab code) and allow up
+  # to 60m before failing netlab initial readiness.
+  netlab_check_retries: 360
   netlab_check_delay: 10
+  # vThunder can accept SSH before config submodes leave LOADING state.
+  # The vendor readiness probe must wait for enable-mode success before
+  # config apply, instead of mutating topology or adding Skyforge-side
+  # retry behavior.
+  a10_config_retries: 30
+  a10_config_delay: 20
 external:
   image: none
 graphite.icon: server
diff --git a/netsim/devices/asav.yml b/netsim/devices/asav.yml
index 7a5be2c..e560751 100644
--- a/netsim/devices/asav.yml
+++ b/netsim/devices/asav.yml
@@ -8,18 +8,58 @@ interface_name: GigabitEthernet0/{ifindex}
 ifindex_offset: 0
 mgmt_if: Management0/0
 group_vars:
-  ansible_user: vagrant
-  ansible_ssh_pass: vagrant1
+  # These are the cisco_asav image's real defaults and are also rendered
+  # explicitly into day-0 so readiness and post-boot automation agree.
+  ansible_user: admin
+  ansible_ssh_pass: CiscoAsa1!
   ansible_become_method: enable
-  ansible_become_password: vagrant1
+  ansible_become_password: CiscoAsa1!
   ansible_network_os: asa
   ansible_connection: network_cli
   # yamllint disable-line rule:line-length
   netlab_ssh_args: "-o KexAlgorithms=+diffie-hellman-group14-sha1 -o PubkeyAcceptedKeyTypes=+ssh-rsa -o HostKeyAlgorithms=+ssh-rsa"
-  netlab_check_retries: 50
+  # ASAv first boot on Kubernetes can take several minutes and may include
+  # internal restart phases before management SSH is reachable. Keep the
+  # public Skyforge device key as asav.
+  #
+  # 360x5s = 1800s, ALIGNED WITH THE VM-NOS DEPLOY BUDGET. These two numbers
+  # are the same claim about the same device and must not disagree:
+  # vmNOSPerNodeDeployBudgetSeconds["asav"] is 1800 because ASAv is slow,
+  # while this readiness gate used to give up at 1200s -- ten minutes BEFORE
+  # the budget said the device was even expected to be ready. netlab
+  # therefore failed the topology while the platform was still patiently
+  # waiting, and the error blamed SSH rather than the mismatch.
+  #
+  # MEASURED 2026-08-27 on demo-lab: the job failed at 23 minutes with "SSH
+  # server did not start in time on node(s) cdg-fw01,jfk-dc-fw01". The same
+  # topology had brought both ASAvs up on earlier runs -- what changed is
+  # that vManage finally BOOTS now (its containerDisk fix landed), adding
+  # 4 vCPU and 32Gi of real load and pushing ASAv first boot past the
+  # shorter window.
+  #
+  # Corroborating: the per-NOS SMOKE topology for asav already overrides
+  # this to 400 (blueprints netlab/_smoke/nos/asav/topology.yml). The
+  # override existed because ASAv needs the longer window; the shared
+  # default never followed, so every topology that did NOT override -- like
+  # demo-lab -- inherited a window the device cannot meet.
+  #
+  # THIS FIXES A CONTRADICTION, NOT ASAv. asav is certified only l1
+  # ("native/profile proof") on talos, so its boot time on this substrate
+  # is uncharacterised and 1800s is an alignment, not a measurement. The
+  # l3 certification lane is the thing that will produce a real number;
+  # this value should be revisited against that evidence rather than
+  # treated as validated.
+  netlab_check_retries: 360
   netlab_initial: always
   netlab_check_command: |
     exit
+  ansible_password: CiscoAsa1!
+  netlab_ready: [ ssh ]
+  netlab_check_delay: 5
+  # RSA-4096 keygen inside the initial config can exceed ansible's 60s
+  # default command timeout on a virtual appliance. Same remedy a10
+  # already uses (180s).
+  ansible_command_timeout: 180
 external:
   image: none
 features:
@@ -47,6 +87,7 @@ features:
     collect: true
     reload: true
     config_mode: [ netmiko ]
+    max_mtu: 1500
   bgp:
     advertise: true
     caveats:
diff --git a/netsim/devices/cat8000v.yml b/netsim/devices/cat8000v.yml
index e4c87d9..fd63eda 100644
--- a/netsim/devices/cat8000v.yml
+++ b/netsim/devices/cat8000v.yml
@@ -24,6 +24,34 @@ libvirt:
   create_iso: cat8000v
 group_vars:
   netlab_device_type: cat8000v
+  # The cat8000v IOS-XE day-0 (netlab initial/ios.j2:8 -> "username admin privilege
+  # 15 secret admin" + "enable secret admin") creates admin/admin, NOT vagrant. This
+  # is the OPPOSITE of nxos (whose day-0 makes vagrant): match the credentials the
+  # box actually has so netlab-initial / the collector can log in once the config-drive
+  # day-0 ingests.
+  ansible_user: admin
+  ansible_ssh_pass: admin
+  ansible_password: admin
+  ansible_network_os: ios
+  ansible_connection: network_cli
+  netlab_ready: [ ssh ]
+  # The management VRF initial/ios.j2 puts GigabitEthernet1 in (same var, same
+  # name, same reason as iol above): the services templates read it to put the
+  # syslog host and flow exporter destination IN that VRF. Without the VRF the
+  # DHCP default on Gi1 (AD 254) lost to the lab's BGP default and management
+  # replies left through the data plane -- five of nine c8000v unreachable on
+  # :22 with a fully applied config (measured 2026-09-14).
+  netlab_mgmt_vrf: MGMT
+  # BOOT BUDGET for the startup-config readiness gate (netlab initial --ready).
+  # netlab's default is 50 x 5 s = 250 s, sized for a container. A c8000v
+  # reaches SSH about 6 minutes after the VMI is created when nine boot at
+  # once (measured 2026-09-14, c8k-9node-scale: first four at +5m50s), and
+  # the gate starts only after every pod is Ready, so 120 x 5 s = 10 minutes
+  # covers the slow tail without hiding a hung guest for very long.
+  netlab_check_retries: 120
+  netlab_check_delay: 5
+  # Catalyst 8000v uses the legacy IOS/IOS-XE SSH negotiation profile.
+  netlab_ssh_args: "-o KexAlgorithms=+diffie-hellman-group-exchange-sha1 -o PubkeyAcceptedKeyTypes=+ssh-rsa -o HostKeyAlgorithms=+ssh-rsa"
 node:
   min_mtu: 1500
 features:
@@ -57,5 +85,13 @@ features:
     asymmetrical_irb: true
     irb: true
     transport: [ vxlan, mpls, sr ]
+  initial:
+    max_mtu: 1500
 kne:
   interface.name: eth{ifindex-1}
+  group_vars:
+    # STARTUP FIRST, NETMIKO FOR RECONFIGURE (owner, 2026-09-27). Bring-up
+    # boots the whole config from the config-drive day-0 (initial_policy
+    # never: nothing is pushed after boot); a warm reconfigure is delivered
+    # over netmiko to the running VM. Before this it had no reconfigure lane.
+    netlab_reconfigure_mode: netmiko
diff --git a/netsim/devices/cisco_sdwan-controller.yml b/netsim/devices/cisco_sdwan-controller.yml
index 4ab7174..6448a99 100644
--- a/netsim/devices/cisco_sdwan-controller.yml
+++ b/netsim/devices/cisco_sdwan-controller.yml
@@ -10,6 +10,15 @@ clab:
     kind: cisco_sdwan
     type: controller
   image: registry.example.com/skyforge/kubevirt/cisco_sdwan-controller:20.7.1-kne-r1
+  features:
+    initial:
+      # Same startup-only day-0 contract as cat8000v above (and dellos10
+      # in the vendor tree): no viptela ansible support exists, so the node
+      # must never enter the ansible initial limit.
+      config_mode: [ startup ]
+  group_vars:
+    # VM NOS: startup/config-drive is the only pre-SSH apply path.
+    netlab_config_mode: startup
 group_vars:
   ansible_user: admin
   ansible_ssh_pass: admin
@@ -17,6 +26,32 @@ group_vars:
   netlab_device_type: cisco_sdwan-controller
   ansible_network_os: viptela
   ansible_connection: network_cli
+  netlab_ready: [ ssh ]
+  # SSH READINESS BUDGET. Without these netlab's generic ssh readiness check
+  # (netsim/ansible/tasks/readiness-check/ssh.yml) falls back to
+  # `netlab_check_retries|default(20)` x `netlab_check_delay|default(5)` =
+  # 100 SECONDS -- and this is a KubeVirt VM, not a container.
+  #
+  # vSmart reaches "System Ready" on the serial console at ~100s (measured
+  # 2026-08-15), and sshd accepts only AFTER that, so the default budget
+  # expires almost exactly when the NOS becomes usable. Deployment
+  # 484d7fbf died on precisely this:
+  #   FatalError in topology: SSH server did not start in time on node(s) ve1
+  # The failure is a stopwatch, not a NOS fault -- it names the device and
+  # reads like the image is broken.
+  #
+  # Every other VM NOS already declares a boot-sized budget (asav 240x5 =
+  # 1200s, csrx 60x5 = 300s); these two were the only ones left on the
+  # container-sized default.
+  #
+  # 180x5 = 900s, NOT asav's 240x5. The first attempt used 1200s and made
+  # things worse: the k8s Job that runs bring-up has its own 20m (1200s)
+  # runtime budget, so an inner wait equal to the outer one can never
+  # finish -- deployment d634bdbe died with "job runtime timed out after
+  # 20m0s" instead of a readiness verdict. A nested budget must leave room
+  # for the stages around it (~2 min here).
+  netlab_check_retries: 180
+  netlab_check_delay: 5
 features:
   # STATIC ROUTES, for one declaration only: `routing.static` with a default
   # route toward the site/DC exit, which the sdwan module renders into VPN 0
@@ -40,3 +75,12 @@ features:
     types: [ controller, validator ]
 kne:
   node.type: controller
+  features:
+    initial:
+      # Same startup-only day-0 contract as cat8000v above (and dellos10
+      # in the vendor tree): no viptela ansible support exists, so the node
+      # must never enter the ansible initial limit.
+      config_mode: [ startup ]
+  group_vars:
+    # VM NOS: startup/config-drive is the only pre-SSH apply path.
+    netlab_config_mode: startup
diff --git a/netsim/devices/cisco_sdwan-manager.yml b/netsim/devices/cisco_sdwan-manager.yml
index 9bc3652..cbf0ef9 100644
--- a/netsim/devices/cisco_sdwan-manager.yml
+++ b/netsim/devices/cisco_sdwan-manager.yml
@@ -10,6 +10,14 @@ clab:
     kind: cisco_sdwan
     type: manager
   image: registry.example.com/skyforge/kubevirt/cisco_sdwan-manager:20.7.1-kne-r1
+  features:
+    initial:
+      # Same startup-only day-0 contract as cat8000v and cisco_sdwan-controller: there
+      # is no viptela ansible network_os, so the initial play would die at
+      # first contact. This keeps the node OUT of the ansible initial limit.
+      config_mode: [ startup ]
+  group_vars:
+    netlab_config_mode: startup
 group_vars:
   ansible_user: admin
   # CONTAINERLAB DEFAULT. admin/admin is what containerlab/vrnetlab ships for
@@ -21,8 +29,20 @@ group_vars:
   # (USER0002 "Password for admin user cannot be configured to default/last
   # password"). If that reproduces, the declared value belongs in the
   # deployment layer that owns per-lab credentials -- NOT hardcoded here.
-  ansible_ssh_pass: admin
-  ansible_password: admin
+  # vMANAGE CANNOT USE THE FACTORY admin/admin FOR ITS API. Measured live
+  # 2026-09-02: after login the whole /dataservice API 302-redirects to
+  # passwordReset.html until admin leaves the default -- vManage policy USER0002,
+  # "Password for admin user cannot be configured to default/last password".
+  # vManage has ONE admin credential (console + API), so it must be non-default
+  # everywhere. This is NOT an invented literal: it is the platform's PAN-OS
+  # value (defaults.devices.panos.group_vars.ansible_password), reused because
+  # PAN-OS forces a first-login change for the same reason. Seeding vManage
+  # non-default from first boot means the reset gate never arms (proven: a
+  # seeded box returns 200 on /dataservice/system/device/controllers, no
+  # redirect). vSmart/vBond (cisco_sdwan-controller/-validator) have no such
+  # gate and keep admin/admin -- this override is per-DEVICE, manager only.
+  ansible_ssh_pass: Admin@123
+  ansible_password: Admin@123
   netlab_device_type: cisco_sdwan-manager
   ansible_network_os: viptela
   # LOCAL, not network_cli. network_cli refuses unknown network_os at task
@@ -30,6 +50,14 @@ group_vars:
   # and the manager MUST: its sdwan module lane drives the vManage REST API
   # (delegated uri calls, no device connection). PAN-OS/A10 precedent.
   ansible_connection: local
+  netlab_ready: [ ssh ]
+  # vManage is a far heavier appliance than vSmart or vEdge (it carries the
+  # NMS, its own datastore and the GUI), so it boots slower. 240x5 = 1200s
+  # would collide with the k8s bring-up Job's own 20m budget -- the mistake
+  # already recorded on cat8000v above -- so this stays at 210x5 = 1050s,
+  # longer than the controllers but still inside the outer budget.
+  netlab_check_retries: 210
+  netlab_check_delay: 5
 features:
   # STATIC ROUTES, for one declaration only: `routing.static` with a default
   # route toward the site/DC exit, which the sdwan module renders into VPN 0
@@ -53,3 +81,11 @@ features:
     types: [ manager ]
 kne:
   node.type: manager
+  features:
+    initial:
+      # Same startup-only day-0 contract as cat8000v and cisco_sdwan-controller: there
+      # is no viptela ansible network_os, so the initial play would die at
+      # first contact. This keeps the node OUT of the ansible initial limit.
+      config_mode: [ startup ]
+  group_vars:
+    netlab_config_mode: startup
diff --git a/netsim/devices/cisco_sdwan-validator.yml b/netsim/devices/cisco_sdwan-validator.yml
index 189fad8..d9ccfd2 100644
--- a/netsim/devices/cisco_sdwan-validator.yml
+++ b/netsim/devices/cisco_sdwan-validator.yml
@@ -10,6 +10,15 @@ clab:
     kind: cisco_sdwan
     type: validator
   image: registry.example.com/skyforge/kubevirt/cisco_sdwan-validator:20.7.1-kne-r1
+  features:
+    initial:
+      # Same startup-only day-0 contract as cisco_sdwan-controller and
+      # -manager: there is no viptela ansible network_os, so the initial
+      # play dies at first contact. Keeps the node OUT of the ansible
+      # initial limit; day-0 arrives through the KNE serial injector.
+      config_mode: [ startup ]
+  group_vars:
+    netlab_config_mode: startup
 group_vars:
   netlab_device_type: cisco_sdwan-validator
   ansible_network_os: viptela
@@ -17,6 +26,27 @@ group_vars:
   ansible_user: admin
   ansible_ssh_pass: admin
   ansible_password: admin
+  # NOT [ ssh ], unlike the controller and manager blocks this was copied
+  # from. NOTHING NEEDS SSH TO THE vBOND:
+  #   - netlab initial does not: config_mode is startup, so the node is
+  #     deliberately outside the ansible limit;
+  #   - vManage enrolls it over the lab network itself, not through us;
+  #   - the collector models the validator as an ENDPOINT, not an SSH-collected
+  #     device.
+  # The gate was pure copy-paste, and it is the only thing that ever
+  # demanded the port: bring-up died on "SSH server did not start in time
+  # on node(s) vbond" (run 74071) for a service no consumer wants. Waiting
+  # on a port nothing uses is not a readiness check, it is a coin flip that
+  # fails the lab.
+  netlab_ready: [ none ]
+  # vBond is the LIGHTEST of the three (vEdge software, no NMS, no OMP
+  # policy engine), so it boots fastest -- but it is still a KubeVirt VM,
+  # not a container, and the generic default is 20x5 = 100s. Matching the
+  # controller's 180x5 = 900s rather than inventing a third budget: it is
+  # inside the bring-up Job's 20m outer budget, with room for the stages
+  # around it.
+  netlab_check_retries: 180
+  netlab_check_delay: 5
 features:
   # STATIC ROUTES, for one declaration only: `routing.static` with a default
   # route toward the site/DC exit, which the sdwan module renders into VPN 0
@@ -41,3 +71,8 @@ features:
     types: [ validator ]
 kne:
   node.type: validator
+  features:
+    initial:
+      config_mode: [ startup ]
+  group_vars:
+    netlab_config_mode: startup
diff --git a/netsim/devices/eos.yml b/netsim/devices/eos.yml
index 5ad477c..0aff4fb 100644
--- a/netsim/devices/eos.yml
+++ b/netsim/devices/eos.yml
@@ -8,14 +8,29 @@ tunnel_interface_name: Tunnel{ifindex}
 lag_interface_name: "port-channel{lag.ifindex}"
 role: router
 group_vars:
-  ansible_user: vagrant
-  ansible_ssh_pass: vagrant
+  ansible_user: admin
+  ansible_ssh_pass: admin
   ansible_network_os: eos
   ansible_connection: network_cli
   netlab_config_remove:
   - no lldp transmit
   - no lldp receive
-  netlab_config_mode: netmiko
+  ansible_password: admin
+  netlab_config_mode: sh
+  # Skip netlab's SSH readiness gate under KNE. That gate probes the topology
+  # mgmt.ipv4 (a clab mgmt-bridge address, e.g. 192.168.167.x) which KNE never
+  # assigns — devices are reachable only at their pod IP — so it always times
+  # out and kills `netlab initial` before the provider-native day-0 apply runs.
+  # cEOS day-0 config (config_mode: sh) is applied over the KNE container shell
+  # (kubectl/FastCli exec), NOT over mgmt SSH, so the gate is pure dead weight
+  # here. netlab_ready: none makes deploy.run proceed straight to
+  # deploy_provider_config. See the netlab-KNE mgmt-address analysis 2026-07-16.
+  netlab_ready: [ none ]
+  # KNE cEOS links need EOS PHY control messages disabled so control-plane
+  # frames such as IS-IS leave the container dataplane. Valid on the pinned
+  # cEOS 4.34.2f (netlab's reference cEOS); the newer 4.36.0.1f REJECTED it
+  # (% Invalid input), which is one reason we pin 4.34.2f platform-wide.
+  netlab_phy_control: false
 features:
   initial:
     system_mtu: true
@@ -201,7 +216,7 @@ clab:
       ipv4: False
       ipv6: False
     initial:
-      config_mode: [ netmiko, sh ]
+      config_mode: [ sh ]
   interface:
     name: et{ifindex}
   node:
@@ -216,7 +231,18 @@ clab:
     ansible_ssh_pass: admin
     ansible_become: yes
     ansible_become_method: enable
-    netlab_ready: [ ssh ]
+    # netlab_ready MUST be overridden at the clab-provider level, not just the
+    # device level below. get_device_attribute() resolves a KNE node's
+    # group_vars as `value + pvalue`, where value = devices.eos.group_vars
+    # (device-level) and pvalue = devices.eos.clab.group_vars (KNE falls back
+    # to the clab provider block). pvalue (clab) WINS the merge, so the
+    # built-in eos.yml clab.group_vars.netlab_ready: [ssh] shadowed our
+    # device-level [none] and kept the SSH readiness gate alive — it timed out
+    # against the unreachable KNE mgmt IP and killed `netlab initial` even
+    # though `kne create` succeeded. Overriding here makes [none] actually win
+    # for KNE eos nodes. (cEOS day-0 is pushed over the container shell in
+    # config_mode: sh, so the SSH gate is pure dead weight.)
+    netlab_ready: [ none ]
     netlab_config_path: /mnt/flash/             # These variables are used when netlab_config_mode == 'sh'
     netlab_config_wrapper: |
       {% if netlab_need_shebang %}
@@ -289,7 +315,18 @@ kne:
     ansible_ssh_pass: admin
     ansible_become: yes
     ansible_become_method: enable
-    netlab_ready: [ ssh ]
+    # netlab_ready MUST be overridden at the clab-provider level, not just the
+    # device level below. get_device_attribute() resolves a KNE node's
+    # group_vars as `value + pvalue`, where value = devices.eos.group_vars
+    # (device-level) and pvalue = devices.eos.clab.group_vars (KNE falls back
+    # to the clab provider block). pvalue (clab) WINS the merge, so the
+    # built-in eos.yml clab.group_vars.netlab_ready: [ssh] shadowed our
+    # device-level [none] and kept the SSH readiness gate alive — it timed out
+    # against the unreachable KNE mgmt IP and killed `netlab initial` even
+    # though `kne create` succeeded. Overriding here makes [none] actually win
+    # for KNE eos nodes. (cEOS day-0 is pushed over the container shell in
+    # config_mode: sh, so the SSH gate is pure dead weight.)
+    netlab_ready: [ none ]
     netlab_config_path: /mnt/flash/             # These variables are used when netlab_config_mode == 'sh'
     netlab_config_wrapper: |
       {% if netlab_need_shebang %}
diff --git a/netsim/devices/fortios.yml b/netsim/devices/fortios.yml
index b65350e..e9c6508 100644
--- a/netsim/devices/fortios.yml
+++ b/netsim/devices/fortios.yml
@@ -22,8 +22,8 @@ clab:
       healthcheck: true
 group_vars:
   ansible_user: admin
-  ansible_password: admin
-  ansible_ssh_pass: admin
+  ansible_password: Admin@123
+  ansible_ssh_pass: Admin@123
   ansible_network_os: fortinet.fortios.fortios
   ansible_connection: httpapi
   collections:
@@ -80,7 +80,53 @@ features:
   initial:
     collect: true
     config_mode: [ netmiko ]
+    # STARTUP-ONLY (netlab device feature, read by the KNE provider's
+    # startup_only check). The boot applied the whole config from
+    # user_data, so bring-up skips the Ansible/netmiko replay, exactly as
+    # for iol. The reconfigure lane is netlab_reconfigure_mode above, not a
+    # second flag: the old startup_read_once (which kept an SSH CLI lane,
+    # deploy-config/fortios-kne.yml, alive on reconfigure renders) is gone
+    # from the provider, and that deploy file with it.
+    #
+    # features.initial.config_mode is deliberately NOT declared here. The
