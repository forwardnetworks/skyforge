From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:00 +0000
Subject: [PATCH] ospf: distribute-list from prefix lists and standard ACLs

---
diff --git a/netsim/ansible/templates/ospf/ios.ospfv2.j2 b/netsim/ansible/templates/ospf/ios.ospfv2.j2
index 4282f90..a958a3f 100644
--- a/netsim/ansible/templates/ospf/ios.ospfv2.j2
+++ b/netsim/ansible/templates/ospf/ios.ospfv2.j2
@@ -13,6 +13,12 @@ router ospf {{ ospf_pid }}
 {% if ospf_data.reference_bandwidth is defined %}
  auto-cost reference-bandwidth {{ ospf_data.reference_bandwidth }}
 {% endif %}
+{% if ospf_data.distribute_list is defined %}
+{#  routing/acl.ios.j2 renders the ACL named by ospf.distribute_list as an
+    IPv4 standard ACL under its own unsuffixed name (not <name>_ipv4): IOS
+    rejects an OSPF distribute-list that names an extended ACL. #}
+ distribute-list {{ ospf_data.distribute_list }} in
+{% endif %}
 {% for l in intf_data if l.ospf.passive|default(False) %}
  passive-interface {{ l.ifname }}
 {% endfor %}
diff --git a/netsim/ansible/templates/routing/acl.ios.j2 b/netsim/ansible/templates/routing/acl.ios.j2
index 89d73c4..99edcaf 100644
--- a/netsim/ansible/templates/routing/acl.ios.j2
+++ b/netsim/ansible/templates/routing/acl.ios.j2
@@ -12,9 +12,30 @@
 {%- endif -%}
 {% endmacro %}
 
+{#
+  ACLs referenced by ospf.distribute_list are rendered as IPv4 STANDARD ACLs
+  under their own (unsuffixed) name: IOS resolves `distribute-list <name> in`
+  under `router ospf` to a standard ACL and refuses the command ("ACL cannot be
+  created or an ACL with the same name but incompatible type already exists")
+  when <name> is an extended ACL. ospf.py has already verified the ACL only
+  uses standard-ACL match fields and is not also attached to an interface.
+#}
+{% set std_acl = [ ospf.distribute_list ] if ospf.distribute_list is defined else [] %}
 {% if routing.acl is defined %}
 {%  for acl_af, acl_data in routing._acl.items() %}
 {%    for name, acl_list in acl_data.items() %}
+{%      if name in std_acl %}
+{%        if acl_af == 'ipv4' %}
+ip access-list standard {{ name }}
+{%          for e in acl_list %}
+{%            if e.description is defined %}
+ remark {{ e.description }}
+{%            else %}
+ {{ e.action }}{{ r_acl_addr(e.src, acl_af) }}{{ " log" if e.log is defined else "" }}
+{%            endif %}
+{%          endfor %}
+{%        endif %}
+{%      else %}
 {%      set cmd = "ipv6" if acl_af == "ipv6" else "ip" %}
 {%      set seqcmd = "sequence " if acl_af == "ipv6" else "" %}
 {%      set ext = " extended" if acl_af == "ipv4" else "" %}
@@ -35,6 +56,7 @@
       r_acl_port(e.dst) }}{{ est }}{{ log }}
 {%        endif %}
 {%      endfor %}
+{%      endif %}
 {%    endfor %}
 {%  endfor %}
 {% endif %}
diff --git a/netsim/devices/ios.yml b/netsim/devices/ios.yml
index 7f2d1c3..72da9ea 100644
--- a/netsim/devices/ios.yml
+++ b/netsim/devices/ios.yml
@@ -121,6 +121,7 @@ features:
     unnumbered: true
     import: [ bgp, isis, ripv2, connected, static, vrf, eigrp ]
     default.policy: true
+    distribute_list: true
     password: true
     priority: true
     timers: true
diff --git a/netsim/modules/ospf.py b/netsim/modules/ospf.py
index 6985b23..da767cd 100644
--- a/netsim/modules/ospf.py
+++ b/netsim/modules/ospf.py
@@ -161,6 +161,53 @@ def check_gr(node: Box, features: Box) -> None:
           log.IncorrectValue,
           'ospf')
 
+def check_standard_acl(node: Box, acl_name: str) -> None:
+  """
+  IOS renders the ACL referenced by ospf.distribute_list as an IPv4 standard
+  ACL (routing/acl.ios.j2), which can only match on the source prefix. Reject
+  entries that need an extended ACL, and reject attaching the same ACL to an
+  interface (the interface form references the extended <name>_ipv4 ACL,
+  which is not rendered for a distribute-list ACL).
+  """
+  def is_any(addr: Box) -> bool:
+    if not addr:
+      return True
+    if 'port' in addr:
+      return False
+    if addr.get('prefix',None) == ['any']:
+      return True
+    pfx = [ p for af in ('ipv4','ipv6') for p in addr.get(af,[]) ]
+    return bool(pfx) and all(str(p).endswith('/0') for p in pfx)   # 'any' expands to 0.0.0.0/0 + ::/0
+
+  for idx,entry in enumerate(node.routing.acl[acl_name],1):
+    reason = ''
+    if entry.get('protocol','ip') != 'ip':
+      reason = f'protocol {entry.protocol}'
+    elif entry.get('established',False):
+      reason = 'established'
+    elif 'port' in entry.get('src',{}):
+      reason = 'a source port'
+    elif not is_any(entry.get('dst',{})):
+      reason = 'a destination match'
+    if reason:
+      log.error(
+        text=f'{node.name} ospf.distribute_list ACL {acl_name} entry #{idx} uses {reason}; ' + \
+              'a distribute-list ACL is a standard ACL and can match only the source prefix',
+        category=log.IncorrectValue,
+        module='ospf')
+
+  for intf in node.get('interfaces',[]):
+    intf_acl = intf.get('routing.acl',{})
+    for acl_ref in intf_acl.values():
+      refs = [ acl_ref ] if isinstance(acl_ref,str) else list(acl_ref.values())
+      if acl_name in refs:
+        log.error(
+          text=f'{node.name} ACL {acl_name} is used by ospf.distribute_list and also attached to ' + \
+               f'interface {intf.ifname}; use a separate routing.acl entry for the interface filter',
+          category=log.IncorrectValue,
+          module='ospf')
+
+
 class OSPF(_Module):
 
   def node_post_transform(self, node: Box, topology: Box) -> None:
@@ -205,6 +252,21 @@ class OSPF(_Module):
     _routing.check_vrf_protocol_support(node,'ospf','ipv6','ospfv3',topology)
     _routing.check_intf_support(node,'ospf',topology)
     check_gr(node,features)
+    dlist = node.get('ospf.distribute_list',None)
+    if dlist is not None:
+      if not features.get('ospf.distribute_list',False):
+        log.error(
+          text=f'{node.name} (device {node.device}) does not support ospf.distribute_list',
+          category=log.IncorrectValue,
+          module='ospf')
+      elif dlist not in node.get('routing.acl',{}):
+        log.error(
+          text=f'{node.name} ospf.distribute_list references ACL {dlist}, which is not ' + \
+               f'declared in this node\'s routing.acl',
+          category=log.IncorrectValue,
+          module='ospf')
+      else:
+        check_standard_acl(node,dlist)
 
     # Collect OSPF areas from interfaces (similar to ospf.areas plugin but without extra attributes)
     collect_ospf_areas(node)
diff --git a/netsim/modules/ospf.yml b/netsim/modules/ospf.yml
index 73e5ed5..8fb2c61 100644
--- a/netsim/modules/ospf.yml
+++ b/netsim/modules/ospf.yml
@@ -39,6 +39,11 @@ attributes:
         cost: int
         type: { type: str, valid_values: [ e1, e2 ] }
     digest: { type: dict }
+    # Global (not per-interface) inbound route filter: `router ospf <pid> /
+    # distribute-list <acl> in`. References the name of a `routing.acl` entry
+    # already declared on this node -- same `id` type interface.acl.in.ipv4
+    # uses for the same kind of reference.
+    distribute_list: id
     gr:
       _remove_when_false: True
       _value_to_dict:
-- 
2.56.0

