diff --git a/netsim/ansible/templates/services/sros.j2 b/netsim/ansible/templates/services/sros.j2
index d406406..7b711b5 100644
--- a/netsim/ansible/templates/services/sros.j2
+++ b/netsim/ansible/templates/services/sros.j2
@@ -1,3 +1,19 @@
+{#
+    SR OS services configuration -- ONE gNMI document.
+
+    SR OS is deployed by tasks/deploy-config/sros.yml, which does
+    `yaml_config | from_yaml` and applies cfg.updates / delete / replace. That
+    makes this file a single YAML DOCUMENT, not a concatenation of blocks: two
+    top-level `updates:` keys do not merge, the second WINS, and the first
+    service's configuration is silently lost. So every service contributes
+    entries to one list, and every platform detail below is inside it.
+
+    It also means CLI text cannot be used here at all. `/configure ...` parses as
+    a plain string, and the deploy task guards `cfg.updates is not string`, so it
+    would be skipped without error -- which is exactly what the old
+    gnmi_config/sros.j2 did: SR OS gNMI was never actually applied.
+#}
+{% if services.syslog._server_list is defined or services.server.snmp is defined or services.server.gnmi is defined %}
 updates:
 {% if services.syslog._server_list is defined %}
 - path: configure/log
@@ -9,8 +25,16 @@ updates:
 {%   for syslog_host in services.syslog._server_list %}
     - syslog-name: "{{ syslog_host }}"
       address: "{{ syslog_host }}"
+{#     `log syslog <n> hostname` does not exist on SR OS 22.x: 22.10 rejects the
+       whole configure/log update ("MINOR: MGMT_CORE #2201: .../hostname - Unknown
+       element"), measured 2026-09-30 on the KubeVirt vr-sros 22.10 pair. The KNE
+       provider publishes the release it reads from the image tag as
+       kne.sros_version_major; an unknown release (0, or no KNE data) keeps
+       upstream's behaviour. #}
+{%     if (kne.sros_version_major|default(0)|int) == 0 or (kne.sros_version_major|int) >= 23 %}
       hostname:
         use-system-name: {}
+{%     endif %}
 {%   endfor %}
     log-id:
 {%   for syslog_host in services.syslog._server_list %}
@@ -25,3 +49,32 @@ updates:
         syslog: "{{ syslog_host }}"
 {%   endfor %}
 {% endif %}
+{% if services.server.snmp is defined %}
+- path: configure/system/management-interface/snmp
+  val:
+    packet-size: 9216
+    streaming:
+      admin-state: enable
+- path: configure/system/security/user-params/local-user/user[user-name=admin]
+  val:
+    access:
+      console: true
+      ftp: true
+      grpc: true
+      netconf: true
+- path: configure/system/security/snmp/community[community-string={{ services.server.snmp.community|default('skyforge') }}]
+  val:
+    access-permissions: r
+    version: v2c
+{% endif %}
+{% if services.server.gnmi is defined %}
+- path: configure/system/management-interface/netconf
+  val:
+    admin-state: enable
+- path: configure/system/grpc
+  val:
+    admin-state: enable
+    gnmi:
+      admin-state: enable
+{% endif %}
+{% endif %}
diff --git a/netsim/ansible/templates/services/vjunos-router.j2 b/netsim/ansible/templates/services/vjunos-router.j2
new file mode 100644
index 0000000..0aae39b
--- /dev/null
+++ b/netsim/ansible/templates/services/vjunos-router.j2
@@ -0,0 +1,122 @@
+{#
+    DNS and syslog come from upstream services/junos.j2. This file exists
+    because netlab picks services/<netlab_device_type>.j2 BEFORE
+    services/<ansible_network_os>.j2, so a per-device file that did not include
+    the parent would silently take those clients away from this device.
+#}
+{% include 'junos.j2' +%}
+{% if services.server.snmp is defined %}
+{#
+    SNMP agent. Junos configuration is HIERARCHICAL everywhere else in netlab
+    (initial/junos.j2, bgp/junos.j2, ... and csrx.j2 right here), and every
+    module fragment is concatenated into ONE juniper.conf. A `set ...` line
+    inside that file is a syntax error: mgd rejects the WHOLE file and boots the
+    FACTORY configuration -- no management address, no ssh, nothing for the collector
+    to collect. Measured 2026-08-28 on demo-lab, where all four vJunos came
+    up amnesiac. The community defaults to `skyforge`, the community the collector's
+    collectors poll with; any other default leaves every device reachable and
+    unpollable.
+#}
+snmp {
+  {#
+      The management interface (fxp0) lives in the mgmt_junos routing
+      instance -- the platform's initial/vjunos-*.j2 sets management-instance so
+      out-of-band default route cannot leak into the data plane. snmpd binds
+      *:161 in the DEFAULT instance and, without this statement, silently
+      drops every request that arrives on fxp0. Measured 2026-09-07 on
+      demo-lab's four vJunos with the same community from the same probe host:
+      the loopback answered, the management address timed out, and the collector
+      read the silence as "invalid snmp credentials". Two lines: this one
+      and the community's routing-instance (alone this one left snmpd
+      counting every poll as "bad community uses", measured 2026-10-09).
+  #}
+  routing-instance-access;
+  community {{ services.server.snmp.community|default('skyforge') }} {
+    authorization read-only;
+    routing-instance mgmt_junos;
+  }
+}
+{% endif %}
+{#
+  sFLOW EXPORT -- the point of which is evidence, not telemetry.
+
+  Monitoring collects over the management interface, so a completely dead data
+  plane certifies green. An sFlow record says THIS DEVICE forwarded these
+  packets: a claim about the fabric, made by the fabric, which no counter on a
+  traffic generator can make about itself.
+
+  sFLOW AND NOT IPFIX, AND THE REASON IS NOT THE ONE IN THE DOCS. Patch 0042
+  wrote that "Juniper divides by platform, sFlow on the switch and inline IPFIX
+  on the router". That is true of real EX and real MX and it is NOT true of the
+  two images in this tree. MEASURED 2026-09-11 on live demo-lab:
+
+    cdg-cor-sw01 (vjunos-router)  show version -> Model: vmx, RE-VMX
+    cdg-acc-sw01 (vjunos-switch)  show version -> Model: vmx, RE-VMX
+
+  Distinct container disks (juniper_vjunos-router and juniper_vjunos-switch,
+  different digests), one platform underneath. Their mgd schemas are identical
+  token for token -- `set protocols sflow ?`, `set forwarding-options sampling ?`
+  and `set services flow-monitoring ?` return the same completions on both -- so
+  there is no split here to follow, and a template that pretended there was
+  would render inline-jflow on one of two identical vMXs.
+
+  WHAT WAS ACTUALLY PROVEN is that this exact block is ACCEPTED. On
+  cdg-cor-sw01, in `configure private`, `commit check` over
+  agent-id/source-ip/collector+udp-port/sample-rate ingress/polling-interval/
+  interfaces returned "configuration check succeeds"; `rollback` then
+  `show | compare` came back EMPTY and nothing was committed. Inline IPFIX got
+  no such proof: `forwarding-options sampling instance` and
+  `services flow-monitoring version-ipfix` are both in the schema, but inline
+  jflow needs a PFE that implements it and this one is riot, so declaring ipfix
+  here would be a claim about hardware nobody checked.
+
+  STILL UNPROVEN, and this is the next lab's job: that records ARRIVE. The
+  collector sits at a cluster address reached over management, and sFlow
+  datagrams leave from the forwarding plane. `show sflow collector` on any
+  vJunos is the evidence.
+
+  NO agent-id OR source-ip, for the same reason the platform never sets a syslog
+  source-address: netlab's mgmt.ipv4 is not the address this device has.
+
+  PHYSICAL INTERFACES, DE-DUPLICATED. netlab hands us unit names (ge-0/0/1.0);
+  sFlow is configured on the port. Management is absent from `interfaces`
+  already and is filtered again here, because an exporter on the management
+  interface reports the traffic our own monitoring generates, which is noise
+  wearing the costume of evidence. irb is filtered too: it isn't physical,
+  and on the switch persona `sflow interfaces irb` is a hard mgd error at
+  boot ("sFlow can be configured only on ge/xe/et interfaces"), so the
+  vjunos-switch template must never emit it -- kept consistent here rather
+  than diverging per persona.
+#}
+{% set _sflow_ports = [] %}
+{% for intf in interfaces|default([]) %}
+{%   set _phy = intf.ifname.split('.')[0] %}
+{%   if _phy not in _sflow_ports and not _phy.startswith('fxp') and not _phy.startswith('em') and not _phy.startswith('irb') %}
+{%     set _ = _sflow_ports.append(_phy) %}
+{%   endif %}
+{% endfor %}
+{% if services.flow.protocol|default('') == 'sflow'
+      and services.flow._server_list is defined and _sflow_ports %}
+protocols {
+  sflow {
+    polling-interval 20;
+{%   if services.flow.sampling is defined %}
+{#
+  1-in-N. Unsampled export from a traffic generator's own load is a denial of
+  service against the collector, so sampling is not the optional nicety it looks.
+#}
+    sample-rate {
+      ingress {{ services.flow.sampling }};
+    }
+{%   endif %}
+{%   for _flow_host in services.flow._server_list[:2] %}
+    collector {{ _flow_host }} {
+      udp-port {{ services.flow.port|default(6343) }};
+    }
+{%   endfor %}
+{%   for _sflow_port in _sflow_ports %}
+    interfaces {{ _sflow_port }};
+{%   endfor %}
+  }
+}
+{% endif %}
