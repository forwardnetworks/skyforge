+@pytest.mark.parametrize('device_template', ['vjunos-router', 'vjunos-switch'])
+def test_the_junos_block_is_the_one_that_passed_commit_check(device_template):
+    """Every statement here was accepted by `commit check` on the live
+    cdg-cor-sw01 inside `configure private`, and rolled back to an empty
+    `show | compare`. Both images are the same vMX, so both render the same."""
+    out = _render(device_template,
+                  services={'flow': {'protocol': 'sflow', 'port': 6343, 'sampling': 1000,
+                                     '_server_list': ['198.19.255.53']},
+                            'syslog': {'_server_list': ['198.19.255.54']},
+                            'server': {'snmp': {}}},
+                  interfaces=[{'ifname': 'ge-0/0/0.0'}, {'ifname': 'ge-0/0/1.0'},
+                              {'ifname': 'ge-0/0/1.100'}, {'ifname': 'fxp0.0'}])
+    assert 'collector 198.19.255.53 {' in out
+    assert 'udp-port 6343;' in out
+    assert 'ingress 1000;' in out
+    assert 'polling-interval 20;' in out
+    # PHYSICAL ports, de-duplicated -- two units of ge-0/0/1 are one interface.
+    assert out.count('    interfaces ') == 2
+    assert 'interfaces ge-0/0/0;' in out
+    assert 'interfaces ge-0/0/1;' in out
+    assert 'ge-0/0/1.100' not in out
+    assert 'fxp0' not in out
+    # NO address netlab invented for a management interface KNE actually
+    # addresses: the live cdg-cor-sw01 answers 10.0.2.2 on fxp0, not the
+    # 172.20.20.x mgmt.ipv4 in host_vars.
+    assert 'source-ip' not in out
+    assert 'agent-id' not in out
+    assert 'source-address' not in out
+    # Syslog is hierarchical, like every other Junos fragment -- a `set` line
+    # here makes mgd reject the whole file.
+    assert 'host "198.19.255.54" {' in out
+    assert not any(line.startswith('set ') for line in out.splitlines())
