+  # file writes `flow.sflow: True` but get_device_features returns a Box where
+  # that is services.flow.sflow. Iterating the top level and matching on a
+  # 'flow.' prefix finds nothing, which is why the first cut of this message
+  # told the operator the device "exports no flow protocol" while it was
+  # happily exporting sFlow. A diagnostic that misdescribes the thing it is
+  # diagnosing sends the reader somewhere else entirely.
+  flow_features = features.get('services',{}).get('flow',{}) or {}
+  offered = sorted(
