+def test_a_controller_mode_edge_gets_no_flow_block_in_its_day0():
+    """vManage owns a controller-mode cEdge's configuration, and a day-0 the
+    appliance rejects costs the whole SD-WAN bootstrap. The same node without
+    the sdwan module is the control: it exports."""
+    data = dict(services={'flow': _FLOW, 'syslog': _SYSLOG, 'server': {'snmp': {}}},
+                interfaces=_ROUTED, mgmt={'ifname': 'GigabitEthernet1'})
+    plain = _render(IOLL2_TEMPLATE, **data)
+    edge = _render(IOLL2_TEMPLATE, module=['sdwan', 'services'], **data)
+    assert 'flow exporter skyforge-1' in plain
+    assert 'flow exporter' not in edge
+    assert 'ip flow monitor' not in edge
+    assert 'logging host' in edge                          # syslog still goes
