         attribute=f'services.server.{kw}',
         check_mode=devices.FC_MODE.BLACKLIST)
 
+# Which protocol to pick when a node was given a flow client but no protocol.
+# IPFIX first because it is the standard and our collector's NetFlow listener
+# decodes it; netflow-v9 next for devices that predate IPFIX export; sFlow last
+# because it is a sampling protocol, not a flow record -- prefer the device that
+# can tell us what it actually forwarded.
+FLOW_PROTOCOL_PREFERENCE = ['ipfix','netflow','sflow']
