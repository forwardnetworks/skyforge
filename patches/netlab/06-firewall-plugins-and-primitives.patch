--- /dev/null
+++ b/netsim/extra/ipsec/defaults.yml
@@ -0,0 +1,108 @@
+# Generic IPsec tunnel plugin
+#
+---
+devices:
+  none:
+    features.ipsec:
+      route_based: True
+      policy_based: True
+      tunnel: True
+      ike: [ ikev1, ikev2, ikev2-preferred ]
+  panos:
+    features.ipsec:
+      route_based: True
+      policy_based: True
+      tunnel: True
+      ike: [ ikev1, ikev2, ikev2-preferred ]
+  ios:
+    features.ipsec:
+      route_based: True
+      tunnel: True
+      ike: [ ikev2 ]
+
+attributes:
+  link:
+    ipsec: _ipsec_link
+  interface:
+    ipsec: _ipsec_node
+
+  _ipsec_link:
+    mode:
+      type: str
+      valid_values: [ route-based, policy-based ]
+    name: str
+    preshared_key: str
+    peer_type:
+      type: str
+      valid_values: [ ip, dynamic, fqdn ]
+    selectors:
+      type: list
+      _subtype: _ipsec_selector
+    ike: _ipsec_ike
+    esp: _ipsec_esp
+
+  _ipsec_node:
+    mode:
+      type: str
+      valid_values: [ route-based, policy-based ]
+    name: str
+    preshared_key: str
+    local_interface: str
+    local_address: str
+    endpoint: str
+    peer: str
+    peer_type:
+      type: str
+      valid_values: [ ip, dynamic, fqdn ]
+    selectors:
+      type: list
+      _subtype: _ipsec_selector
+    local_id_type:
+      type: str
+      valid_values: [ ipaddr, fqdn, ufqdn, keyid, dn ]
+    local_id_value: str
+    peer_id_type:
+      type: str
+      valid_values: [ ipaddr, fqdn, ufqdn, keyid, dn ]
+    peer_id_value: str
+    ike: _ipsec_ike
+    esp: _ipsec_esp
+
+  _ipsec_ike:
+    version:
+      type: str
+      valid_values: [ ikev1, ikev2, ikev2-preferred ]
+    crypto_profile: str
+    authentication:
+      type: list
+      _subtype: str
+    encryption:
+      type: list
+      _subtype: str
+    dh_group:
+      type: list
+      _subtype: str
+    lifetime_days: int
+    lifetime_hours: int
+    lifetime_minutes: int
+    lifetime_seconds: int
+    enable_nat_traversal: bool
+
+  _ipsec_esp:
+    crypto_profile: str
+    authentication:
+      type: list
+      _subtype: str
+    encryption:
+      type: list
+      _subtype: str
+    dh_group: str
+    lifetime_days: int
+    lifetime_hours: int
+    lifetime_minutes: int
+    lifetime_seconds: int
+    lifesize_gb: int
+
+  _ipsec_selector:
+    local: str
+    remote: str
diff --git a/netsim/extra/ipsec/ios.j2 b/netsim/extra/ipsec/ios.j2
new file mode 100644
index 0000000..e352597
--- /dev/null
+++ b/netsim/extra/ipsec/ios.j2
@@ -0,0 +1,111 @@
+{% macro ike_encryption(value) -%}
+{%   set enc = {
+       'aes128': 'aes-cbc-128',
+       'aes-128-cbc': 'aes-cbc-128',
+       'aes192': 'aes-cbc-192',
+       'aes-192-cbc': 'aes-cbc-192',
+       'aes256': 'aes-cbc-256',
+       'aes-256-cbc': 'aes-cbc-256'
+     } %}
+{{   enc.get(value, value) }}
+{%- endmacro %}
+{% macro esp_encryption(value) -%}
+{%   set enc = {
+       'aes128': 'esp-aes 128',
+       'aes-128-cbc': 'esp-aes 128',
+       'aes192': 'esp-aes 192',
+       'aes-192-cbc': 'esp-aes 192',
+       'aes256': 'esp-aes 256',
+       'aes-256-cbc': 'esp-aes 256',
+       'aes-128-gcm': 'esp-gcm 128',
+       'aes-256-gcm': 'esp-gcm 256'
+     } %}
+{{   enc.get(value, 'esp-aes 256') }}
+{%- endmacro %}
+{% macro ike_integrity(value) -%}
+{%   set alg = {
+       'sha1': 'sha1',
+       'sha256': 'sha256',
+       'sha384': 'sha384',
+       'sha512': 'sha512',
+       'md5': 'md5'
+     } %}
+{{   alg.get(value, value) }}
+{%- endmacro %}
+{% macro esp_integrity(value) -%}
+{%   set alg = {
+       'sha1': 'esp-sha-hmac',
+       'sha256': 'esp-sha256-hmac',
+       'sha384': 'esp-sha384-hmac',
+       'sha512': 'esp-sha512-hmac',
+       'md5': 'esp-md5-hmac'
+     } %}
+{{   alg.get(value, '') }}
+{%- endmacro %}
+{% macro dh_group(value) -%}
+{{ value|replace('group','') }}
+{%- endmacro %}
+!
+{% for profile in ipsec.ike_profiles|default([]) %}
+!
+crypto ikev2 proposal {{ profile.name }}
+ encryption {{ ike_encryption(profile.encryption|default(['aes-256-cbc'])|first) }}
+ integrity {{ ike_integrity(profile.authentication|default(['sha256'])|first) }}
+ group {{ dh_group(profile.dh_group|default(['group14'])|first) }}
+{%   if profile.lifetime_seconds is defined %}
+ lifetime {{ profile.lifetime_seconds }}
+{%   elif profile.lifetime_minutes is defined %}
+ lifetime {{ profile.lifetime_minutes * 60 }}
+{%   elif profile.lifetime_hours is defined %}
+ lifetime {{ profile.lifetime_hours * 3600 }}
+{%   elif profile.lifetime_days is defined %}
+ lifetime {{ profile.lifetime_days * 86400 }}
+{%   endif %}
+!
+{% endfor %}
+{% for transform in ipsec.transform_sets|default([]) %}
+!
+crypto ipsec transform-set {{ transform.name }} {{ esp_encryption(transform.encryption|default(['aes-256-cbc'])|first) }}{% set esp_auth = esp_integrity(transform.authentication|default(['sha256'])|first) %}{{ ' ' + esp_auth if esp_auth else '' }}
+ mode tunnel
+!
+{% endfor %}
+{% for tunnel in ipsec.tunnels|default([]) %}
+{%   if tunnel.mode != 'route-based' %}
+! IPsec tunnel {{ tunnel.name }} skipped: IOS template currently supports only route-based tunnels
+{%   else %}
+!
+crypto ikev2 policy {{ tunnel.ike.policy_name }}
+ proposal {{ tunnel.ike.crypto_profile }}
+!
+crypto ikev2 keyring {{ tunnel.ike.keyring_name }}
+ peer {{ tunnel.name }}
+  address {{ tunnel.peer }}
+  pre-shared-key {{ tunnel.preshared_key }}
+!
+crypto ikev2 profile {{ tunnel.ike.profile_name }}
+ match identity remote address {{ tunnel.peer }} 255.255.255.255
+ authentication remote pre-share
+ authentication local pre-share
+ keyring local {{ tunnel.ike.keyring_name }}
+{%   if tunnel.local_interface is defined %}
+ match address local interface {{ tunnel.local_interface }}
+{%   endif %}
+{%   if tunnel.local_id_type|default('') == 'ipaddr' and tunnel.local_id_value is defined %}
+ identity local address {{ tunnel.local_id_value }}
+{%   endif %}
+!
+crypto ipsec profile {{ tunnel.esp.profile_name }}
+ set transform-set {{ tunnel.esp.transform_set }}
+ set ikev2-profile {{ tunnel.ike.profile_name }}
+{%   if tunnel.esp.dh_group is defined and tunnel.esp.dh_group != 'no-pfs' %}
+ set pfs group{{ dh_group(tunnel.esp.dh_group) }}
+{%   endif %}
+!
+interface {{ tunnel.ifname }}
+ tunnel source {{ tunnel.local_interface if tunnel.local_interface is defined else tunnel.local_address }}
+ tunnel destination {{ tunnel.peer }}
+ tunnel mode ipsec ipv4
+ tunnel protection ipsec profile {{ tunnel.esp.profile_name }}
+!
+{%   endif %}
+{% endfor %}
diff --git a/netsim/extra/ipsec/panos.j2 b/netsim/extra/ipsec/panos.j2
new file mode 100644
index 0000000..624c85d
--- /dev/null
+++ b/netsim/extra/ipsec/panos.j2
@@ -0,0 +1,91 @@
+{#
+  IPsec on PAN-OS, as configuration-mode set commands -- same single-transport
+  port as firewall.policy/panos.j2. Object order matters for readability, not
+  correctness: everything lands in one candidate and one commit.
+
+  The tunnel interface takes the same implicit-vsys treatment as the initial
+  template: NO `set vsys ... import` (single-vsys VM-Series has no such
+  subtree -- captured "Invalid syntax." from a live device), and zone
+  membership imports the interface implicitly.
+#}
+{% for profile in ipsec.ike_profiles|default([]) %}
+{%   set p = 'set network ike crypto-profiles ike-crypto-profiles "' ~ profile.name ~ '"' %}
+{%   if profile.authentication is defined %}
+{{ p }} hash [ {{ profile.authentication|join(' ') if profile.authentication is not string else profile.authentication }} ]
+{%   endif %}
+{%   if profile.encryption is defined %}
+{{ p }} encryption [ {{ profile.encryption|join(' ') if profile.encryption is not string else profile.encryption }} ]
+{%   endif %}
+{%   if profile.dh_group is defined %}
+{{ p }} dh-group [ {{ profile.dh_group|join(' ') if profile.dh_group is not string else profile.dh_group }} ]
+{%   endif %}
+{%   for unit in ['days','hours','minutes','seconds'] if profile['lifetime_' ~ unit] is defined %}
+{{ p }} lifetime {{ unit }} {{ profile['lifetime_' ~ unit] }}
+{%   endfor %}
+{% endfor %}
+{% for profile in ipsec.esp_profiles|default([]) %}
+{%   set p = 'set network ike crypto-profiles ipsec-crypto-profiles "' ~ profile.name ~ '"' %}
+{%   if profile.authentication is defined %}
+{{ p }} esp authentication [ {{ profile.authentication|join(' ') if profile.authentication is not string else profile.authentication }} ]
+{%   endif %}
+{%   if profile.encryption is defined %}
+{{ p }} esp encryption [ {{ profile.encryption|join(' ') if profile.encryption is not string else profile.encryption }} ]
+{%   endif %}
+{%   if profile.dh_group is defined %}
+{# SCALAR, unlike the ike profile's dh-group: the ipsec-crypto-profile takes
+   ONE group and the list form is rejected token-by-token -- captured live:
+   "[ is not a valid token / Invalid syntax." #}
+{{ p }} dh-group {{ profile.dh_group[0] if profile.dh_group is not string else profile.dh_group }}
+{%   endif %}
+{%   for unit in ['days','hours','minutes','seconds'] if profile['lifetime_' ~ unit] is defined %}
+{{ p }} lifetime {{ unit }} {{ profile['lifetime_' ~ unit] }}
+{%   endfor %}
+{%   if profile.lifesize_gb is defined %}
+{{ p }} lifesize gb {{ profile.lifesize_gb }}
+{%   endif %}
+{% endfor %}
+{% for tunnel in ipsec.tunnels|default([]) %}
+set network interface tunnel units {{ tunnel.ifname }}
+{%   if tunnel.ipv4 is defined %}
+set network interface tunnel units {{ tunnel.ifname }} ip {{ tunnel.ipv4 }}
+{%   endif %}
+{%   if tunnel.mtu is defined and tunnel.mtu <= 1500 %}
+set network interface tunnel units {{ tunnel.ifname }} mtu {{ tunnel.mtu }}
+{%   endif %}
+set network interface tunnel units {{ tunnel.ifname }} comment "{{ tunnel.name }}"
+set network virtual-router {{ panos_virtual_router|default('default') }} interface {{ tunnel.ifname }}
+{%   if tunnel.zone_name is defined %}
+set zone "{{ tunnel.zone_name }}" network layer3 {{ tunnel.ifname }}
+{%   endif %}
+{%   set gw = 'set network ike gateway "' ~ tunnel.ike_gateway ~ '"' %}
+{{ gw }} authentication pre-shared-key key "{{ tunnel.preshared_key }}"
+{{ gw }} local-address interface {{ tunnel.local_interface }}
+{%   if tunnel.peer is defined %}
+{{ gw }} peer-address ip {{ tunnel.peer }}
+{%   else %}
+{{ gw }} peer-address dynamic
+{%   endif %}
+{%   if tunnel.ike.version|default('ikev2') == 'ikev1' %}
+{{ gw }} protocol ikev1 ike-crypto-profile "{{ tunnel.ike.crypto_profile }}"
+{%   else %}
+{{ gw }} protocol ikev2 ike-crypto-profile "{{ tunnel.ike.crypto_profile }}"
+{%   endif %}
+{%   if tunnel.ike.enable_nat_traversal|default(false) %}
+{{ gw }} protocol-common nat-traversal enable yes
+{%   endif %}
+{%   if tunnel.local_id_type is defined %}
+{{ gw }} local-id type {{ tunnel.local_id_type }} id "{{ tunnel.local_id_value }}"
+{%   endif %}
+{%   if tunnel.peer_id_type is defined %}
+{{ gw }} peer-id type {{ tunnel.peer_id_type }} id "{{ tunnel.peer_id_value }}"
+{%   endif %}
+{%   set tn = 'set network tunnel ipsec "' ~ tunnel.name ~ '"' %}
+{{ tn }} tunnel-interface {{ tunnel.ifname }}
+{{ tn }} auto-key ike-gateway "{{ tunnel.ike_gateway }}"
+{{ tn }} auto-key ipsec-crypto-profile "{{ tunnel.esp.crypto_profile }}"
+{%   for selector in tunnel.selectors|default([]) %}
+{{ tn }} auto-key proxy-id "{{ selector.name }}" local {{ selector.local }}
+{{ tn }} auto-key proxy-id "{{ selector.name }}" remote {{ selector.remote }}
+{{ tn }} auto-key proxy-id "{{ selector.name }}" protocol any
+{%   endfor %}
+{% endfor %}
diff --git a/netsim/extra/loadbalancer/__init__.py b/netsim/extra/loadbalancer/__init__.py
new file mode 100644
index 0000000..96e489a
--- /dev/null
+++ b/netsim/extra/loadbalancer/__init__.py
@@ -0,0 +1,179 @@
+"""Load-balancer plugin.
+
+Supports the structured `loadbalancer` model used by staged EVE migrations while
+preserving imported `load_balancing` metadata for on-prem parity work.
+"""
+
+from box import Box
+
+from netsim import api
+from netsim.augment import devices
+from netsim.utils import log
+
+_config_name = "loadbalancer"
+
+# Monitor references that need no loadbalancer.monitors entry:
+#   ping    -- the built-in ICMP probe (ACOS: the predefined `ping` monitor)
+#   none    -- health checking explicitly disabled at that level
+#   default -- no binding; the device's own default check applies
+_BUILTIN_MONITORS = ("ping", "none", "default")
+
+
+def _supports_loadbalancer_rendering(features: Box) -> bool:
+  if "loadbalancer" not in features:
+    return False
+  return features.get("loadbalancer") is not False
+
+
+def _validate_load_balancing_data(node: Box) -> None:
+  if not node.get("load_balancing"):
+    return
+
+  if not isinstance(node.load_balancing.get("virtual_servers"), list):
+    log.error(
+      f"Node {node.name} has malformed load_balancing.virtual_servers (expected a list)",
+      category=log.IncorrectType,
+      module=_config_name,
+    )
+
+  if not isinstance(node.load_balancing.get("service_groups"), list):
+    log.error(
+      f"Node {node.name} has malformed load_balancing.service_groups (expected a list)",
+      category=log.IncorrectType,
+      module=_config_name,
+    )
+
+  if not isinstance(node.load_balancing.get("servers"), list):
+    log.error(
+      f"Node {node.name} has malformed load_balancing.servers (expected a list)",
+      category=log.IncorrectType,
+      module=_config_name,
+    )
+
+
+class _LB:
+  @staticmethod
+  def _normalize(node: Box) -> None:
+    node.loadbalancer.setdefault("monitors", [])
+    node.loadbalancer.setdefault("pools", [])
+    node.loadbalancer.setdefault("virtual_servers", [])
+
+    monitor_map = {
+      m.name: m for m in node.loadbalancer.monitors if isinstance(m, Box) and m.get("name")
+    }
+    pool_map = {
+      p.name: p for p in node.loadbalancer.pools if isinstance(p, Box) and p.get("name")
+    }
+
+    for monitor in monitor_map.values():
+      monitor.type = str(monitor.get("type", "tcp")).lower()
+      if monitor.type == "ping":                  # vendor-neutral name for the probe is icmp
+        monitor.type = "icmp"
+      # interval/timeout stay ABSENT unless the user set them: the device
+      # default applies, and a forced default can be invalid (ACOS rejects a
+      # timeout larger than the interval -- the old 10/30 defaults were).
+      if "interval" in monitor and "timeout" in monitor and monitor.timeout > monitor.interval:
+        log.error(
+          f"Node {node.name} monitor {monitor.name}: timeout {monitor.timeout} exceeds interval {monitor.interval}",
+          category=log.IncorrectValue,
+          module=_config_name,
+        )
+    # A tcp monitor with no port cannot be rendered (ACOS: `method tcp port N`).
+    # Before monitors rendered at all, blueprints declared such monitors as
+    # inert placeholders (demo-lab did); keep those loading -- warn and
+    # drop the object -- but binding one is an error below.
+    portless = {
+      name for name, m in monitor_map.items() if m.type == "tcp" and not m.get("port")
+    }
+    for name in portless:
+      log.warning(
+        text=f"Node {node.name} monitor {name}: a tcp monitor needs a port; it is not rendered",
+        module=_config_name,
+      )
+    node.loadbalancer.monitors = [
+      m for m in node.loadbalancer.monitors if not (isinstance(m, Box) and m.get("name") in portless)
+    ]
+
+    def check_monitor_ref(ref, what: str) -> None:
+      if ref in portless:
+        log.error(
+          f"Node {node.name} {what} binds monitor {ref}: a tcp monitor needs a port",
+          category=log.MissingValue,
+          module=_config_name,
+        )
+        return
+      if ref is None or ref in _BUILTIN_MONITORS or ref in monitor_map:
+        return
+      log.error(
+        f"Node {node.name} {what} references missing monitor {ref}",
+        more_hints=[f"Use a loadbalancer.monitors name or one of: {', '.join(_BUILTIN_MONITORS)}"],
+        category=log.IncorrectValue,
+        module=_config_name,
+      )
+
+    for pool in pool_map.values():
+      pool.protocol = str(pool.get("protocol", "tcp")).lower()
+      check_monitor_ref(pool.get("monitor", None), f"pool {pool.name}")
+      check_monitor_ref(pool.get("member_monitor", None), f"pool {pool.name} member_monitor")
+      check_monitor_ref(pool.get("server_monitor", None), f"pool {pool.name} server_monitor")
+      pool.setdefault("members", [])
+      for member in pool.members:
+        member.port = int(member.get("port", 0))
+        # Resolve the pool-level defaults onto each member so templates read
+        # one place: members[].monitor / members[].server_monitor.
+        for attr, pool_attr in (("monitor", "member_monitor"), ("server_monitor", "server_monitor")):
+          if attr not in member and pool.get(pool_attr, None) is not None:
+            member[attr] = pool[pool_attr]
+          check_monitor_ref(member.get(attr, None), f"pool {pool.name} member {member.name} {attr}")
+
+    for vs in node.loadbalancer.virtual_servers:
+      if not isinstance(vs, Box):
+        log.error(
+          f"Node {node.name} has invalid virtual_server entry {vs}",
+          category=log.IncorrectType,
+          module=_config_name,
+        )
+        continue
+      vs.protocol = str(vs.get("protocol", "tcp")).lower()
+      vs.port = int(vs.get("port", 0))
+      if vs.pool not in pool_map:
+        log.error(
+          f"Node {node.name} virtual_server {vs.name} references missing pool {vs.pool}",
+          category=log.IncorrectValue,
+          module=_config_name,
+        )
+
+
+def post_transform(topology: Box) -> None:
+  for node in topology.nodes.values():
+    features = devices.get_device_features(node, topology.defaults)
+
+    if isinstance(node.get("loadbalancer", None), Box):
+      if "loadbalancer" not in features:
+        log.error(
+          f"Node {node.name}({node.device}) does not support loadbalancer plugin",
+          category=log.IncorrectAttr,
+          module=_config_name,
+        )
+        continue
+
+      _LB._normalize(node)
+      api.node_config(node, _config_name)
+      continue
+
+    if not node.get("load_balancing"):
+      continue
+
+    _validate_load_balancing_data(node)
+
+    if node.get("placeholder") or node.get("device", "") == "none":
+      continue
+
+    if _supports_loadbalancer_rendering(features):
+      api.node_config(node, _config_name)
+      continue
+
+    log.warning(
+      text=f"Node {node.name}({node.device}) has load-balancing metadata; rendering of these features is not implemented yet",
+      module=_config_name,
+    )
diff --git a/netsim/extra/loadbalancer/a10.j2 b/netsim/extra/loadbalancer/a10.j2
new file mode 100644
index 0000000..cbe8233
--- /dev/null
+++ b/netsim/extra/loadbalancer/a10.j2
@@ -0,0 +1,55 @@
+{#
+  A10 ACOS SLB, rendered from the vendor-neutral loadbalancer model.
+
+  Health checks bind at three ACOS levels, each from its own attribute:
+    slb server <n> <ip>            health-check <m>  <- members[].server_monitor
+      port <p> <proto>             health-check <m>  <- members[].monitor
+    slb service-group <n> <proto>  health-check <m>  <- pools[].monitor
+  (pools[].server_monitor / pools[].member_monitor are resolved onto every
+  member by the plugin.) `ping` is ACOS's predefined ICMP monitor and is never
+  declared; `none` renders health-check-disable; `default`/unset renders
+  nothing, which leaves ACOS's own default -- an L3 ICMP check on the server
+  and an L4 TCP handshake on the port. That default is why a VIP whose members
+  run no listener on the port reads Down while ICMP to them is fine.
+
+  An icmp monitor renders no `method` line: ICMP is the ACOS default method and
+  running-config does not show it (seed: `health monitor hm_... / interval 10`).
+#}
+{% macro hc(ref) %}{{ 'health-check-disable' if ref == 'none' else 'health-check ' ~ ref }}{% endmacro %}
+{% for m in loadbalancer.monitors | default([]) %}
+health monitor {{ m.name }}
+{%   if m.type == 'tcp' %}
+  method tcp port {{ m.port }}
+{%   elif m.type == 'http' %}
+  method http{% if m.port is defined %} port {{ m.port }}{% endif %} url GET {{ m.url | default('/') }}
+{%   endif %}
+{%   if m.interval is defined %}
+  interval {{ m.interval }}{% if m.timeout is defined %} timeout {{ m.timeout }}{% endif %}
+
+{%   endif %}
+{% endfor %}
+{% for pool in loadbalancer.pools | default([]) %}
+{%   for member in pool.members | default([]) %}
+slb server {{ member.name }} {{ member.address }}
+{%     if member.server_monitor | default('default') != 'default' %}
+  {{ hc(member.server_monitor) }}
+{%     endif %}
+  port {{ member.port }} {{ pool.protocol | default('tcp') }}
+{%     if member.monitor | default('default') != 'default' %}
+    {{ hc(member.monitor) }}
+{%     endif %}
+{%   endfor %}
+slb service-group {{ pool.name }} {{ pool.protocol | default('tcp') }}
+{%   if pool.monitor | default('default', true) != 'default' %}
+  {{ hc(pool.monitor) }}
+{%   endif %}
+{%   for member in pool.members | default([]) %}
+  member {{ member.name }} {{ member.port }}
+{%   endfor %}
+{% endfor %}
+
+{% for vs in loadbalancer.virtual_servers | default([]) %}
+slb virtual-server {{ vs.name }} {{ vs.vip }}
+  port {{ vs.port }} {{ vs.protocol | default('tcp') }}
+    service-group {{ vs.pool }}
+{% endfor %}
diff --git a/netsim/extra/loadbalancer/defaults.yml b/netsim/extra/loadbalancer/defaults.yml
new file mode 100644
index 0000000..957d12b
--- /dev/null
+++ b/netsim/extra/loadbalancer/defaults.yml
@@ -0,0 +1,110 @@
+# Generic load-balancer plugin
+#
+---
+devices:
+  a10:
+    features.loadbalancer: True
+  none:
+    features.loadbalancer: True
+
+attributes:
+  node:
+    load_balancing:
+      type: dict
+    loadbalancer:
+      monitors: { type: list, _subtype: _lb_monitor }
+      pools: { type: list, _subtype: _lb_pool }
+      virtual_servers: { type: list, _subtype: _lb_virtual_server }
+
+  _lb_monitor:
+    _description: |
+      A named health monitor. `type` is the probe: icmp (ping is accepted as
+      an alias and normalized to icmp), tcp (connect to `port`), or http
+      (GET `url` on `port`). interval/timeout are seconds and are rendered
+      only when set; timeout must not exceed interval. A monitor does
+      nothing until something binds it: pools[].monitor,
+      pools[].member_monitor / members[].monitor, or
+      pools[].server_monitor / members[].server_monitor.
+    name:
+      type: str
+      _required: true
+    type:
+      type: str
+      valid_values: [ icmp, ping, tcp, http ]
+    interval: { type: int, min_value: 1 }
+    timeout: { type: int, min_value: 1 }
+    port: { type: int, min_value: 1, max_value: 65534 }
+    url:
+      type: str
+      _description: HTTP monitor request path (default /), e.g. /index.php
+    send: str
+    receive: str
+
+  _lb_pool:
+    name:
+      type: str
+      _required: true
+    protocol:
+      type: str
+      valid_values: [ tcp, udp ]
+    monitor:
+      type: str
+      _alt_types: [ NoneType ]
+      _description: |
+        Pool-level (service-group) health check: a monitors[] name, `ping`
+        (the built-in ICMP probe), `none` (health checking disabled) or
+        `default` (no binding; the device default applies).
+    member_monitor:
+      type: str
+      _description: |
+        Default per-member SERVICE (ip:port) health check for every member of
+        this pool; same values as monitor. members[].monitor overrides it.
+    server_monitor:
+      type: str
+      _description: |
+        Default per-member SERVER (host/node) health check for every member
+        of this pool; same values as monitor. members[].server_monitor
+        overrides it.
+    members:
+      type: list
+      _subtype: _lb_member
+
+  _lb_member:
+    name:
+      type: str
+      _required: true
+    address:
+      type: ipv4
+      use: interface
+      _required: true
+    port:
+      type: int
+      _required: true
+    monitor:
+      type: str
+      _description: |
+        This member's SERVICE (ip:port) health check -- a monitors[] name,
+        ping, none or default. Overrides the pool's member_monitor.
+    server_monitor:
+      type: str
+      _description: |
+        This member's SERVER (host) health check -- a monitors[] name, ping,
+        none or default. Overrides the pool's server_monitor.
+
+  _lb_virtual_server:
+    name:
+      type: str
+      _required: true
+    vip:
+      type: ipv4
+      use: interface
+      _required: true
+    port:
+      type: int
+      _required: true
+    protocol:
+      type: str
+      valid_values: [ tcp, udp ]
+    pool:
+      type: str
+      _required: true
diff --git a/netsim/extra/loadbalancer/f5.j2 b/netsim/extra/loadbalancer/f5.j2
new file mode 100644
index 0000000..7ad4a20
--- /dev/null
+++ b/netsim/extra/loadbalancer/f5.j2
@@ -0,0 +1,51 @@
+{% macro f5_name(value) -%}
+{% if value is string and value.startswith('/') %}
+{{ value }}
+{% else %}
+/Common/{{ value }}
+{% endif %}
+{%- endmacro %}
+{% macro f5_destination(vs) -%}
+{% if vs.destination is defined %}
+{%   if vs.destination.startswith('/') %}
+{{ vs.destination }}
+{%   else %}
+/Common/{{ vs.destination }}
+{%   endif %}
+{% elif vs.vip is defined %}
+/Common/{{ vs.vip }}:{{ vs.port|default('any') }}
+{% else %}
+/Common/0.0.0.0:any
+{% endif %}
+{%- endmacro %}
+{% for server in load_balancing.servers|default([]) %}
+{%   if server.name is defined and server.ip is defined %}
+create ltm node {{ f5_name(server.name) }} address {{ server.ip }}
+{%   endif %}
+{% endfor %}
+{% for group in load_balancing.service_groups|default([]) %}
+{%   if group.name is defined %}
+{%     set members = [] %}
+{%     for member in group.members|default([]) %}
+{%       if member.server is defined and member.port is defined %}
+{%         set _ = members.append(f5_name(member.server) ~ ':' ~ member.port|string) %}
+{%       endif %}
+{%     endfor %}
+{%     if members %}
+create ltm pool {{ f5_name(group.name) }} members add { {{ members|join(' ') }} }
+{%     else %}
+create ltm pool {{ f5_name(group.name) }}
+{%     endif %}
+{%   endif %}
+{% endfor %}
+{% for vs in load_balancing.virtual_servers|default([]) %}
+{%   if vs.name is defined %}
+{%     set protocol = vs.protocol|default('tcp') %}
+{%     set pool_name = f5_name(vs.pool) if vs.pool is defined else '' %}
+{%     if pool_name %}
+create ltm virtual {{ f5_name(vs.name) }} destination {{ f5_destination(vs) }} ip-protocol {{ protocol }} pool {{ pool_name }}
+{%     else %}
+create ltm virtual {{ f5_name(vs.name) }} destination {{ f5_destination(vs) }} ip-protocol {{ protocol }}
+{%     endif %}
+{%   endif %}
+{% endfor %}
diff --git a/netsim/extra/nat/__init__.py b/netsim/extra/nat/__init__.py
new file mode 100644
index 0000000..43d9859
--- /dev/null
+++ b/netsim/extra/nat/__init__.py
@@ -0,0 +1,186 @@
+from box import Box
+
+from netsim import api
+from netsim.augment import devices
+from netsim.utils import log
+
+_config_name = "nat"
+
+# NAT does NOT require a firewall. You can translate addresses without having any
+# policy at all -- a switch doing PAT to the outside is the ordinary case, and it
+# has nothing to do with firewall rules.
+#
+# This used to be `_requires = ["firewall.policy"]`, which augment/plugin.py
+# enforces as a HARD dependency:
+#
+#   nat plugin requires firewall.policy plugin which is not included in lab topology
+#
+# So `plugin: [ nat ]` on its own was rejected at compile time and every pure-NAT
+# topology had to carry `plugin: [ firewall.policy, nat ]` for a firewall it never
+# used. Verified against the real compiler before the change: a single-node
+# fortios topology with `plugin: [ nat ]` failed L2-compile.
+#
+# The firewall.policy integration is genuinely OPTIONAL: _promote_policy_nat_rules
+# reads node.firewall.policy.rules through .get() and is a no-op when the plugin
+# is absent, so nothing else here needs the dependency.
+#
+# `_execute_after` preserves the ORDERING that `_requires` was also providing --
+# when both plugins ARE loaded, nat must still run after firewall.policy so the
+# promotion sees its rules. Unlike `_requires` it is not enforced as a dependency:
+# plugin_requires_check only inspects `_requires`, and utils/sort.dependency
+# filters names that are not in the plugin list, so an absent firewall.policy is
+# simply ignored instead of failing the lab.
+_execute_after = ["firewall.policy"]
+
+
+def _as_list(value: object) -> list:
+  if value is None:
+    return []
+  if isinstance(value, list):
+    return list(value)
+  return [value]
+
+
+def _normalize_rule(node: Box, rule: Box, rule_idx: int) -> bool:
+  ok = True
+  if bool(rule.get("nat", False)) and "type" not in rule:
+    # Policy-derived NAT rules are rendered by platform policy templates; they
+    # do not use the standalone NAT rule schema.
+    return True
+
+  if "type" not in rule:
+    log.error(
+      f"Node {node.name} has NAT rule #{rule_idx} without nat.rules[{rule_idx}].type",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    return False
+
+  if "name" not in rule:
+    rule.name = f"rule_{rule_idx + 1}"
+  if "enabled" not in rule:
+    rule.enabled = True
+
+  for key in ("inside", "outside", "source", "destination", "service"):
+    if key in rule:
+      rule[key] = _as_list(rule[key])
+
+  if rule.type == "source" and "translated_source" not in rule:
+    log.error(
+      f"Node {node.name} source NAT rule {rule.name} is missing translated_source",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    ok = False
+
+  if rule.type == "destination" and "translated_destination" not in rule:
+    log.error(
+      f"Node {node.name} destination NAT rule {rule.name} is missing translated_destination",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    ok = False
+
+  if rule.type == "static" and "translated_destination" not in rule and "translated_source" not in rule:
+    log.error(
+      f"Node {node.name} static NAT rule {rule.name} is missing translated_source or translated_destination",
+      category=log.MissingValue,
+      module=_config_name,
+    )
+    ok = False
+
+  return ok
+
+
+def _promote_policy_nat_rules(node: Box) -> None:
+  policy_rules = node.get("firewall.policy.rules", [])
+  if not isinstance(policy_rules, list):
+    return
+
+  nat_rules = [r for r in policy_rules if isinstance(r, Box) and bool(r.get("nat", False))]
+  if not nat_rules:
+    return
+
+  # APPEND, never replace. This was `node.nat.rules = nat_rules`, which meant a
+  # single firewall.policy rule carrying `nat: true` SILENTLY DESTROYED every NAT
+  # rule the author had written under node.nat.rules -- no error, no warning, the
+  # lab just came up without the translation it was asked for.
+  #
+  # That was survivable while the plugin rendered nothing for most platforms. It
+  # is not now: eos, ios, iol and panos all render from node.nat.rules, so on a
+  # firewall carrying both an authored NAT rule and a policy rule flagged
+  # `nat: true`, the authored one vanished from the device configuration.
+  #
+  # Order matters and is deliberate: authored rules first, promoted policy rules
+  # after. FortiOS is why -- nat/fortios.j2 re-enters `config firewall policy`
+  # and matches promoted rules by the `sequence` firewall.policy stamped on them,
+  # so promoted rules must keep their relative order among themselves.
+  existing = node.get("nat.rules", [])
+  if not isinstance(existing, list):
+    existing = []
+  node.nat.rules = list(existing) + nat_rules
+
+
+def post_transform(topology: Box) -> None:
+  for node in topology.nodes.values():
+    features = devices.get_device_features(node, topology.defaults)
+    nat_supported = "nat" in features and features.nat is not False
+
+    if "nat" not in node:
+      node.nat = {}
+    if "_roles" not in node.nat:
+      node.nat._roles = {}
+    if "_zones" not in node.nat:
+      node.nat._zones = {}
+
+    _promote_policy_nat_rules(node)
+    has_nat_rules = bool(node.get("nat.rules", []))
+
+    for intf in node.get("interfaces", []):
+      nat_role = intf.get("nat.role", "")
+      if not nat_role:
+        continue
+      if not nat_supported:
+        log.error(
+          f"Node {node.name}({node.device}) does not support NAT roles used on {intf.name}",
+          category=log.IncorrectAttr,
+          module=_config_name,
+        )
+        continue
+      if nat_role not in ("inside", "outside"):
+        log.error(
+          f"Invalid NAT role {nat_role} on {intf.name}",
+          category=log.IncorrectValue,
+          module=_config_name,
+        )
+        continue
+
+      if nat_role not in node.nat._roles:
+        node.nat._roles[nat_role] = []
+      node.nat._roles[nat_role].append(
+        {
+          "ifname": intf.ifname,
+          "name": intf.get("name", ""),
+        }
+      )
+
+      if "firewall.zone" in intf:
+        if nat_role not in node.nat._zones:
+          node.nat._zones[nat_role] = []
+        zones = node.nat._zones[nat_role]
+        if intf.firewall.zone not in zones:
+          zones.append(intf.firewall.zone)
+
+    if has_nat_rules and not nat_supported:
+      log.error(
+        f"Node {node.name}({node.device}) does not support NAT rules",
+        category=log.IncorrectAttr,
+        module=_config_name,
+      )
+      continue
+
+    for rule_idx, rule in enumerate(node.get("nat.rules", [])):
+      _normalize_rule(node, rule, rule_idx)
+
+    if has_nat_rules:
+      api.node_config(node, _config_name)
diff --git a/netsim/extra/nat/asa.j2 b/netsim/extra/nat/asa.j2
new file mode 100644
index 0000000..24694c7
--- /dev/null
+++ b/netsim/extra/nat/asa.j2
@@ -0,0 +1,105 @@
+{#
+  Cisco ASA NAT (8.3+ "twice NAT" / manual NAT).
+
+  NAMED asa.j2, NOT asav.j2. The two lookups use different keys: the plugin
+  checks features under the DEVICE name (asav), while the config template is
+  resolved by device TYPE (asa). Naming this asav.j2 gets the device past
+  validation and then fails the run with "Cannot find nat configuration
+  template for <node>/device asav" -- measured, not theorised.
+
+  SHAPE, and why this is neither ios.j2 nor eos.j2: the ASA names its interfaces
+  with `nameif` and every NAT statement is written in terms of those NAMES, as a
+  (real,mapped) interface PAIR -- `nat (inside,outside) source ...`. There is no
+  per-interface `ip nat inside` marking to emit, and no global statement that
+  works without the pair. What the roles give us here is which nameif goes on
+  each side of that parenthesis.
+
+  Real and mapped addresses must be `object network` definitions; the ASA will
+  not take a bare subnet inline on a manual NAT line. One object per source
+  entry, so a rule listing three subnets renders three unambiguous statements
+  rather than one that depends on object-group semantics differing by release.
+
+  nameif comes from `firewall.zone` when the interface declares one (the same
+  attribute firewall.policy binds its ACLs to) and falls back to the interface
+  name, which is what the initial config uses when no zone is declared.
+#}
+{% set inside = nat._roles.inside | default([]) %}
+{% set outside = nat._roles.outside | default([]) %}
+{% set rules = nat.rules | default([]) | rejectattr('enabled','equalto',False) | list %}
+{#
+  nameif is resolved through the node's OWN interface list, not through
+  nat._roles: the role entries are trimmed copies carrying only ifname and
+  name, so `role.firewall.zone` is always undefined and every translation
+  would silently render against the interface NAME instead of the zone.
+  Measured -- it produced `nat (GigabitEthernet0/0,GigabitEthernet0/1)`.
+#}
+{% set zone_of = {} %}
+{% for intf in interfaces | default([]) %}
+{%   if intf.firewall is defined and intf.firewall.zone is defined %}
+{%     set _ = zone_of.update({intf.ifname: intf.firewall.zone}) %}
+{%   endif %}
+{% endfor %}
+{% macro nameif(intf) %}{{ zone_of.get(intf.ifname, intf.ifname) }}{% endmacro %}
+{#
+  An address object is a SUBNET or a RANGE depending on how it was written.
+  `10.21.3.2-10.21.3.20` is a range on the ASA and has no prefix form, so it
+  cannot be expressed as a subnet without changing which addresses translate.
+#}
+{% macro addr_object(value) %}
+{%- if '-' in value %} range {{ value.split('-')[0] }} {{ value.split('-')[1] }}
+{%- else %} subnet {{ value | ipaddr('network') }} {{ value | ipaddr('netmask') }}
+{%- endif -%}
+{% endmacro %}
+{#
+  A rule may name its own zone PAIR. The DC firewall translates
+  `nat (inside,dmvpn)` for its 1:1 mapping while PATing `(inside,outside)`, so
+  the pair cannot be a property of the node's interface roles alone.
+#}
+{% macro pair(rule, a, b) %}{{ rule.inside | default([a], true) | first }},{{ rule.outside | default([b], true) | first }}{% endmacro %}
+{% if rules and not (inside and outside) %}
+! NAT NOT APPLIED: the ASA writes every translation as an interface PAIR,
+! `nat (real,mapped)`, so it needs BOTH roles. inside={{ inside | length }}
+! outside={{ outside | length }}. Declare nat.role: inside and nat.role: outside
+! on the links, or these {{ rules | length }} rule(s) cannot be programmed.
+{% endif %}
+{% if inside and outside %}
+{%   set in_if = nameif(inside[0]) | trim %}
+{%   set out_if = nameif(outside[0]) | trim %}
+{%   for rule in rules %}
+{%     set base = 'NAT-' ~ (rule.name | upper) %}
+{%     if rule.type == 'source' %}
+{%       for src in rule.source | default([]) %}
+object network {{ base }}-REAL{{ loop.index if rule.source | length > 1 else '' }}
+{{ addr_object(src) }}
+{%       endfor %}
+{%       for src in rule.source | default([]) %}
+{%         set obj = base ~ '-REAL' ~ (loop.index if rule.source | length > 1 else '') %}
+{%         if rule.translated_source is not defined or rule.translated_source == 'interface' %}
+nat ({{ pair(rule, in_if, out_if) }}) source dynamic {{ obj }} interface
+{%         else %}
+object network {{ base }}-PAT{{ loop.index if rule.source | length > 1 else '' }}
+{{ addr_object(rule.translated_source) }}
+nat ({{ pair(rule, in_if, out_if) }}) source dynamic {{ obj }} {{ base }}-PAT{{ loop.index if rule.source | length > 1 else '' }}
+{%         endif %}
+{%       endfor %}
+{%     elif rule.type == 'static' and rule.translated_source is defined %}
+{%       for src in rule.source | default([]) %}
+{%         set sfx = loop.index if rule.source | length > 1 else '' %}
+object network {{ base }}-REAL{{ sfx }}
+{{ addr_object(src) }}
+object network {{ base }}-MAPPED{{ sfx }}
+{{ addr_object(rule.translated_source) }}
+nat ({{ pair(rule, in_if, out_if) }}) source static {{ base }}-REAL{{ sfx }} {{ base }}-MAPPED{{ sfx }}
+{%       endfor %}
+{%     elif rule.type == 'destination' and rule.translated_destination is defined %}
+{%       for dst in rule.destination | default([]) %}
+{%         set sfx = loop.index if rule.destination | length > 1 else '' %}
+object network {{ base }}-DST{{ sfx }}
+{{ addr_object(dst) }}
+object network {{ base }}-DSTMAP{{ sfx }}
+{{ addr_object(rule.translated_destination) }}
+nat ({{ pair(rule, out_if, in_if) }}) source static {{ base }}-DSTMAP{{ sfx }} {{ base }}-DST{{ sfx }}
+{%       endfor %}
+{%     endif %}
+{%   endfor %}
+{% endif %}
diff --git a/netsim/extra/nat/defaults.yml b/netsim/extra/nat/defaults.yml
new file mode 100644
index 0000000..2cdbe8f
--- /dev/null
+++ b/netsim/extra/nat/defaults.yml
@@ -0,0 +1,90 @@
+# Generic NAT plugin
+#
+---
+devices:
+  # eos: added by Skyforge (patches/netlab/0026). Arista is INTERFACE-based, so
+  # eos.j2 renders NAT under the interfaces carrying nat.role: outside.
+  #
+  # ⚠️ THIS LIST IS NOT "PLATFORMS WHERE NAT WORKS". Check for a template before
+  # believing an entry. Current state:
+  #
+  #   eos      nat/eos.j2                                  -> renders
+  #   ios      nat/ios.j2                                  -> renders
+  #   iol      nat/iol.j2 (includes ios.j2)                -> renders
+  #   panos    nat/panos.j2, AND __init__.py lifts firewall.policy rules
+  #            carrying `nat: true` into node.nat.rules     -> renders (both paths)
+  #   fortios  nat/fortios.j2 + firewall.policy/fortios.j2  -> renders
+  #   asav     nat/asav.j2                                  -> renders
+  #
+  # Every declared platform now has a template. Keep it that way: a device
+  # listed here without one validates an author's rules, reports features.nat
+  # supported, and emits nothing -- the lab comes up green and does not
+  # translate. If you add a device, add its template in the same commit.
+  eos:
+    features.nat: True
+  # MEASURED FALSE 2026-09-07 on the pinned netlab (f64bc4f3): this entry and
+  # iol.j2 are both INERT. `features` IS inherited through `parent: ios`, and
+  # the template lookup DOES walk the parent chain -- deleting iol.j2 renders
+  # byte-identical NAT on an iol node. Kept because harmless; do NOT cite this
+  # as proof the pattern is required. The previous comment here claimed the
+  # opposite and sent a reader hunting a phantom ipsec/iol gap for a day.
+  iol:
+    features.nat: True
+  panos:
+    features.nat: True
+  fortios:
+    features.nat: True
+  asav:
+    features.nat: True
+  # vsrx: nat/junos.j2 -- source NAT (interface / pool) as a rule-set per rule,
+  # from-zone/to-zone taken from the rule's inside/outside zone names or, when
+  # the rule names none, from the zones of the interfaces carrying nat.role.
+  vsrx:
+    features.nat: True
+  ios:
+    features.nat: True
+  none:
+    features.nat: True
+
+attributes:
+  node:
+    nat: _nat_node
+  interface:
+    nat: _nat_interface
+
+  _nat_interface:
+    role:
+      type: str
+      valid_values: [ inside, outside ]
+
+  _nat_node:
+    rules:
+      type: list
+      _subtype: _nat_rule
+
+  _nat_rule:
+    name: str
+    type:
+      type: str
+      valid_values: [ source, destination, static ]
+    description: str
+    enabled: bool
+    inside:
+      type: list
+      _subtype: str
+    outside:
+      type: list
+      _subtype: str
+    source:
+      type: list
+      _subtype: str
+    destination:
+      type: list
+      _subtype: str
+    service:
+      type: list
+      _subtype: str
+    translated_source: str
+    translated_destination: str
+    translated_service: str
+    nat: bool
diff --git a/netsim/extra/nat/eos.j2 b/netsim/extra/nat/eos.j2
new file mode 100644
index 0000000..4deab30
--- /dev/null
+++ b/netsim/extra/nat/eos.j2
@@ -0,0 +1,67 @@
+{#
+  Arista EOS NAT.
+
+  EOS is INTERFACE-BASED, unlike the policy-based fortios template next to this
+  file: every NAT command is applied under an interface, so a rule can only be
+  rendered onto interfaces carrying `nat.role: outside`. Declare roles on the
+  links, e.g.
+
+      nodes:
+        s2:
+          nat.rules:
+            - name: outbound
+              type: source
+              source: [ 10.0.0.0/8 ]
+              translated_source: interface
+      links:
+        - s2:
+            nat.role: outside
+          h1:
+            nat.role: inside
+
+  If a node has NAT rules but NO outside interface, this renders a loud marker
+  comment instead of silently producing nothing -- a NAT config that quietly
+  fails to apply is the worst outcome, because the lab comes up "green" and only
+  the traffic is wrong.
+
+  translated_source: `interface` (or omitted) means PAT/overload onto the outside
+  interface address, which is the common case. An explicit address is rendered as
+  a static translation instead.
+#}
+{% set outside = nat._roles.outside | default([]) %}
+{# Reject only an EXPLICIT enabled:false. A `selectattr('enabled')` filter would
+   also silently drop any rule that never set `enabled` -- policy-derived rules
+   (nat: true) return early from _normalize_rule and never get the default, so
+   filtering on truthiness would quietly discard them. #}
+{% set rules = nat.rules | default([]) | rejectattr('enabled','equalto',False) | list %}
+{% if rules and not outside %}
+! NAT NOT APPLIED: node has {{ rules | length }} NAT rule(s) but no interface with
+! nat.role: outside. EOS applies NAT under an interface -- declare the outside
+! role on a link, or these rules cannot be programmed.
+{% endif %}
+{% for rule in rules %}
+{%   if rule.type == 'source' and rule.source is defined %}
+ip access-list standard NAT-{{ rule.name | upper }}
+{%     for src in rule.source %}
+   permit {{ src }}
+{%     endfor %}
+!
+{%   endif %}
+{% endfor %}
+{% for intf in outside %}
+interface {{ intf.ifname }}
+{%   for rule in rules %}
+{%     if rule.type == 'source' %}
+{%       if rule.translated_source is not defined or rule.translated_source == 'interface' %}
+   ip nat source dynamic access-list NAT-{{ rule.name | upper }} overload
+{%       else %}
+   ip nat source static {{ rule.source | first }} {{ rule.translated_source }}
+{%       endif %}
+{%     elif rule.type == 'static' and rule.translated_source is defined %}
+   ip nat source static {{ rule.source | first }} {{ rule.translated_source }}
+{%     elif rule.type == 'destination' and rule.translated_destination is defined %}
+   ip nat destination static {{ rule.destination | first }} {{ rule.translated_destination }}
+{%     endif %}
+{%   endfor %}
+!
+{% endfor %}
