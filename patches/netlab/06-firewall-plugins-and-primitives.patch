diff --git a/netsim/extra/ipsec/asav.j2 b/netsim/extra/ipsec/asav.j2
new file mode 100644
index 0000000..5f1e1f8
--- /dev/null
+++ b/netsim/extra/ipsec/asav.j2
@@ -0,0 +1,101 @@
+{% macro ike_encryption(value) -%}
+{%   set enc = {
+       'aes128': 'aes-128',
+       'aes-128-cbc': 'aes-128',
+       'aes192': 'aes-192',
+       'aes-192-cbc': 'aes-192',
+       'aes256': 'aes-256',
+       'aes-256-cbc': 'aes-256'
+     } %}
+{{   enc.get(value, 'aes-256') }}
+{%- endmacro %}
+{% macro ike_integrity(value) -%}
+{%   set alg = {
+       'sha1': 'sha',
+       'sha256': 'sha-256',
+       'sha384': 'sha-384',
+       'sha512': 'sha-512'
+     } %}
+{{   alg.get(value, 'sha-256') }}
+{%- endmacro %}
+{% macro esp_encryption(value) -%}
+{%   set enc = {
+       'aes128': 'aes-128',
+       'aes-128-cbc': 'aes-128',
+       'aes192': 'aes-192',
+       'aes-192-cbc': 'aes-192',
+       'aes256': 'aes-256',
+       'aes-256-cbc': 'aes-256',
+       'aes-128-gcm': 'aes-gcm-128',
+       'aes-256-gcm': 'aes-gcm-256'
+     } %}
+{{   enc.get(value, 'aes-256') }}
+{%- endmacro %}
+{% macro esp_integrity(value) -%}
+{%   set alg = {
+       'sha1': 'sha-1',
+       'sha256': 'sha-256',
+       'sha384': 'sha-384',
+       'sha512': 'sha-512'
+     } %}
+{{   alg.get(value, 'sha-256') }}
+{%- endmacro %}
+{% macro dh_group(value) -%}
+{{ value|replace('group','') }}
+{%- endmacro %}
+!
+{% for tunnel in ipsec.tunnels|default([]) %}
+{%   if tunnel.mode != 'route-based' %}
+! IPsec tunnel {{ tunnel.name }} skipped: ASAv template currently supports only route-based tunnels
+{%   else %}
+!
+crypto ikev2 policy {{ loop.index + 9 }}
+ encryption {{ ike_encryption(tunnel.ike.encryption|default(['aes-256-cbc'])|first) }}
+ integrity {{ ike_integrity(tunnel.ike.authentication|default(['sha256'])|first) }}
+ group {{ dh_group(tunnel.ike.dh_group|default(['group14'])|first) }}
+{%     if tunnel.ike.lifetime_seconds is defined %}
+ lifetime seconds {{ tunnel.ike.lifetime_seconds }}
+{%     elif tunnel.ike.lifetime_minutes is defined %}
+ lifetime seconds {{ tunnel.ike.lifetime_minutes * 60 }}
+{%     elif tunnel.ike.lifetime_hours is defined %}
+ lifetime seconds {{ tunnel.ike.lifetime_hours * 3600 }}
+{%     elif tunnel.ike.lifetime_days is defined %}
+ lifetime seconds {{ tunnel.ike.lifetime_days * 86400 }}
+{%     endif %}
+!
+crypto ipsec ikev2 ipsec-proposal {{ tunnel.esp.crypto_profile }}
+ protocol esp encryption {{ esp_encryption(tunnel.esp.encryption|default(['aes-256-cbc'])|first) }}
+ protocol esp integrity {{ esp_integrity(tunnel.esp.authentication|default(['sha256'])|first) }}
+!
+tunnel-group {{ tunnel.peer }} type ipsec-l2l
+tunnel-group {{ tunnel.peer }} ipsec-attributes
+ ikev2 remote-authentication pre-shared-key {{ tunnel.preshared_key }}
+ ikev2 local-authentication pre-shared-key {{ tunnel.preshared_key }}
+!
+crypto ipsec profile {{ tunnel.esp.profile_name }}
+ set ikev2 ipsec-proposal {{ tunnel.esp.crypto_profile }}
+{%     if tunnel.esp.dh_group is defined and tunnel.esp.dh_group != 'no-pfs' %}
+ set pfs group{{ dh_group(tunnel.esp.dh_group) }}
+{%     endif %}
+{%     if tunnel.esp.lifetime_seconds is defined %}
+ set security-association lifetime seconds {{ tunnel.esp.lifetime_seconds }}
+{%     elif tunnel.esp.lifetime_minutes is defined %}
+ set security-association lifetime seconds {{ tunnel.esp.lifetime_minutes * 60 }}
+{%     elif tunnel.esp.lifetime_hours is defined %}
+ set security-association lifetime seconds {{ tunnel.esp.lifetime_hours * 3600 }}
+{%     elif tunnel.esp.lifetime_days is defined %}
+ set security-association lifetime seconds {{ tunnel.esp.lifetime_days * 86400 }}
+{%     endif %}
+!
+interface {{ tunnel.ifname }}
+{%     if tunnel.ipv4 is defined %}
+ ip address {{ tunnel.ipv4|ansible.utils.ipaddr('address') }} {{ tunnel.ipv4|ansible.utils.ipaddr('netmask') }}
+{%     endif %}
+ tunnel source interface {{ tunnel.local_interface if tunnel.local_interface is defined else tunnel.local_address }}
+ tunnel destination {{ tunnel.peer }}
+ tunnel mode ipsec ipv4
+ tunnel protection ipsec profile {{ tunnel.esp.profile_name }}
+ no shutdown
+!
+{%   endif %}
+{% endfor %}
diff --git a/netsim/extra/ipsec/defaults.yml b/netsim/extra/ipsec/defaults.yml
