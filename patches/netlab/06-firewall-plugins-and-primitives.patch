+def test_asa_inspect_renders_in_global_policy(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+plugin: [ firewall.policy ]
+nodes:
+  fw: { device: asav, firewall.policy: { same_security_traffic: true, inspect: [ icmp, icmp-error ] } }
+  fw2: { device: asav }
+  r:  { device: iol }
+links:
+- interfaces: [ { node: fw, firewall.zone: inside }, { node: r } ]
+- interfaces: [ { node: fw2, firewall.zone: inside }, { node: r } ]
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  fw = startup('fw')
+  assert 'policy-map global_policy\n class inspection_default\n  inspect icmp\n  inspect icmp error' in fw
+  assert 'inspect icmp' not in startup('fw2')  # positive control
+
+
+def test_asa_inspect_rejects_an_unknown_engine(tmp_path: Path) -> None:
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+plugin: [ firewall.policy ]
+nodes:
+  fw: { device: asav, firewall.policy: { inspect: [ http ] } }
+  r:  { device: iol }
+links:
+- interfaces: [ { node: fw, firewall.zone: inside }, { node: r } ]
+""")
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(topo_file)])
+
+
+def test_host_behind_l2_switch_learns_the_vlan_vip(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """A host on a pure-L2 access switch and a host wired straight to the IRB
+  switch are on the same VLAN and must get the same VRRP VIP as their default
+  gateway. Before the gateway module finalized VLAN access links, only the
+  second one did."""
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+gateway.id: 1
+gateway.protocol: vrrp
+vlans:
+  v10: { id: 10, gateway: { vrrp: { group: 10 } } }
+nodes:
+  dis1: { device: ioll2, module: [ vlan, gateway ], gateway.vrrp.priority: 110 }
+  dis2: { device: ioll2, module: [ vlan, gateway ] }
+  acc:  { device: ioll2, module: [ vlan ], vlan.mode: bridge }
+  h1:   { device: linux }
+  h2:   { device: linux }
+links:
+- { acc: {}, dis1: {}, vlan.trunk: [ v10 ] }
+- { acc: {}, dis2: {}, vlan.trunk: [ v10 ] }
+- { acc: {}, h1: {}, vlan.access: v10 }
+- { dis1: {}, h2: {}, vlan.access: v10 }
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  h1 = module_cfg('h1','routing')
+  h2 = module_cfg('h2','routing')
+  assert 'ip route replace 0.0.0.0/0 via 172.16.0.1 dev eth1' in h2   # positive control (IRB switch on the wire)
+  assert 'ip route replace 0.0.0.0/0 via 172.16.0.1 dev eth1' in h1   # the host behind the L2 switch
+  dis1 = startup('dis1')
+  assert 'vrrp 10 address-family ipv4' in dis1
+  assert '    address 172.16.0.1' in dis1
+  assert 'priority 110' in dis1
