new file mode 100644
index 0000000..ac6ff72
--- /dev/null
+++ b/netsim/extra/nat/iol.j2
@@ -0,0 +1,15 @@
+{#
+  Cisco IOL (IOS-on-Linux) NAT.
+
+  MEASURED FALSE 2026-09-07 on the pinned netlab (f64bc4f3): this file is INERT.
+  The template lookup DOES walk the `parent: ios` chain, so `ios.j2` is found
+  for an iol node on its own -- deleting this file renders byte-identical NAT.
+  Kept because harmless and explicit; do NOT cite it as proof a per-device
+  template is required, which is what the previous version of this note claimed.
+
+  The NAT config itself is identical to IOS, so include it rather than copying:
+  a duplicated template is two sources of truth that drift the first time only
+  one of them is fixed. If this include ever fails to resolve, Jinja raises
+  TemplateNotFound -- a loud failure, not a silently empty NAT config.
+#}
+{% include "ios.j2" %}
diff --git a/netsim/extra/nat/ios.j2 b/netsim/extra/nat/ios.j2
new file mode 100644
index 0000000..23f4c03
--- /dev/null
+++ b/netsim/extra/nat/ios.j2
@@ -0,0 +1,64 @@
+{#
+  Classic Cisco IOS NAT (IOS / IOS-XE / IOL).
+
+  DIFFERENT SHAPE FROM eos.j2, and the difference is the whole reason this is a
+  separate template rather than a copy: IOS needs THREE things, EOS needs one.
+
+    1. every inside interface marked  `ip nat inside`
+    2. every outside interface marked `ip nat outside`
+    3. a GLOBAL `ip nat inside source ...` statement tying them together
+
+  EOS carries the translation on the outside interface alone. So an IOS node with
+  only `nat.role: outside` declared produces a NAT config that cannot translate
+  anything -- it needs BOTH roles. That is checked below and reported loudly
+  rather than rendered as a half-config.
+
+  ACLs are standard ACLs with WILDCARD masks, not prefixes: `permit 10.0.0.0
+  0.255.255.255`. The `ipaddr` filter reaches netaddr.IPNetwork attributes, so
+  `ipaddr('network')` and `ipaddr('hostmask')` give exactly the two halves IOS
+  wants. Verified: 10.0.0.0/8 -> `10.0.0.0 0.255.255.255`, 192.168.1.0/24 ->
+  `192.168.1.0 0.0.0.255`.
+#}
+{% set inside = nat._roles.inside | default([]) %}
+{% set outside = nat._roles.outside | default([]) %}
+{% set rules = nat.rules | default([]) | rejectattr('enabled','equalto',False) | list %}
+{% if rules and not (inside and outside) %}
+! NAT NOT APPLIED: IOS requires BOTH an inside and an outside interface.
+! inside={{ inside | length }} outside={{ outside | length }}. Declare
+! nat.role: inside and nat.role: outside on the links, or these {{ rules | length }}
+! rule(s) cannot be programmed.
+{% endif %}
+{% for rule in rules %}
+{%   if rule.type in ['source','static'] and rule.source is defined %}
+ip access-list standard NAT-{{ rule.name | upper }}
+{%     for src in rule.source %}
+ permit {{ src | ipaddr('network') }} {{ src | ipaddr('hostmask') }}
+{%     endfor %}
+!
+{%   endif %}
+{% endfor %}
+{% for intf in inside %}
+interface {{ intf.ifname }}
+ ip nat inside
+!
+{% endfor %}
+{% for intf in outside %}
+interface {{ intf.ifname }}
+ ip nat outside
+!
+{% endfor %}
+{% if inside and outside %}
+{%   for rule in rules %}
+{%     if rule.type == 'source' %}
+{%       if rule.translated_source is not defined or rule.translated_source == 'interface' %}
+ip nat inside source list NAT-{{ rule.name | upper }} interface {{ outside[0].ifname }} overload
+{%       else %}
+ip nat inside source list NAT-{{ rule.name | upper }} pool {{ rule.translated_source }} overload
+{%       endif %}
+{%     elif rule.type == 'static' and rule.translated_source is defined %}
+ip nat inside source static {{ rule.source | first }} {{ rule.translated_source }}
+{%     elif rule.type == 'destination' and rule.translated_destination is defined %}
+ip nat outside source static {{ rule.destination | first }} {{ rule.translated_destination }}
+{%     endif %}
+{%   endfor %}
+{% endif %}
diff --git a/netsim/extra/nat/panos.j2 b/netsim/extra/nat/panos.j2
new file mode 100644
index 0000000..4aa764d
--- /dev/null
+++ b/netsim/extra/nat/panos.j2
@@ -0,0 +1,45 @@
+{#
+  Palo Alto PAN-OS NAT.
+
+  NAT LIVES HERE, NOT IN firewall.policy. PAN-OS NAT is its own rulebase
+  (`rulebase nat rules`), entirely separate from `rulebase security rules`, so it
+  belongs to the nat plugin like every other platform. Before this template
+  existed panos was declared `features.nat: True` and rendered NOTHING: it was
+  easy to assume firewall.policy/panos.j2 covered it, but that template only ever
+  emitted SECURITY rules. One place for NAT, so there is nothing to reconcile.
+
+  PAN-OS is ZONE-based, not interface-based. Zones come from the rule itself
+  (`inside:` / `outside:`, which the plugin normalizes to lists); the outside
+  INTERFACE is still needed for interface-address translation, and comes from
+  nat._roles.outside.
+#}
+{% set rules = nat.rules | default([]) | rejectattr('enabled','equalto',False) | list %}
+{% set outside_if = (nat._roles.outside | default([]))[0] | default({}) %}
+{% for rule in rules %}
+{%   if rule.inside is not defined or rule.outside is not defined %}
+# NAT NOT APPLIED for rule {{ rule.name }}: PAN-OS NAT is zone-based and needs
+# both `inside:` and `outside:` zones on the rule. Got inside={{ rule.inside | default('<unset>') }}
+# outside={{ rule.outside | default('<unset>') }}.
+{%   else %}
+set rulebase nat rules "{{ rule.name }}" from [{% for z in rule.inside %} "{{ z }}"{% endfor %} ]
+set rulebase nat rules "{{ rule.name }}" to "{{ rule.outside | first }}"
+set rulebase nat rules "{{ rule.name }}" source [{% for s in rule.source | default(['any']) %} "{{ s }}"{% endfor %} ]
+set rulebase nat rules "{{ rule.name }}" destination [{% for d in rule.destination | default(['any']) %} "{{ d }}"{% endfor %} ]
+set rulebase nat rules "{{ rule.name }}" service {{ (rule.service | default(['any']) | first) }}
+{%     if rule.type in ['source','static'] %}
+{%       if rule.translated_source is not defined or rule.translated_source == 'interface' %}
+{%         if outside_if.ifname is defined %}
+set rulebase nat rules "{{ rule.name }}" source-translation dynamic-ip-and-port interface-address interface {{ outside_if.ifname }}
+{%         else %}
+# NAT NOT APPLIED for rule {{ rule.name }}: translated_source is `interface` but no
+# interface carries nat.role: outside, so there is no address to translate to.
+{%         endif %}
+{%       else %}
+set rulebase nat rules "{{ rule.name }}" source-translation dynamic-ip-and-port translated-address [ "{{ rule.translated_source }}" ]
+{%       endif %}
+{%     endif %}
+{%     if rule.type in ['destination','static'] and rule.translated_destination is defined %}
+set rulebase nat rules "{{ rule.name }}" destination-translation translated-address "{{ rule.translated_destination }}"
+{%     endif %}
+{%   endif %}
+{% endfor %}
diff --git a/netsim/extra/nat/vsrx.j2 b/netsim/extra/nat/vsrx.j2
new file mode 100644
index 0000000..5679a59
--- /dev/null
+++ b/netsim/extra/nat/vsrx.j2
@@ -0,0 +1,70 @@
+{#
+  Junos (vSRX) NAT -- source NAT as `security nat source rule-set`.
+
+  NAMED vsrx.j2, NOT junos.j2. netlab resolves a plugin template by
+  netlab_device_type (vsrx) before ansible_network_os (junos), so both names
+  work at render time -- but the capability projection the server embeds
+  (internal/netlabdefaultsgen) looks for `<device>.j2` and would record
+  `nat declared, renders_config: false` for a junos.j2, which is a lie in a
+  committed artifact. Other Junos-family devices do not declare features.nat.
+
+  Junos NAT is written in ZONE terms: a rule-set is `from zone X to zone Y`
+  and the rule inside it matches source/destination addresses. The zones come
+  from, in order:
+    1. the rule's own inside/outside lists (zone names, as on the ASA), or
+    2. the zones of the interfaces carrying nat.role inside/outside
+       (nat._zones, filled by the plugin from firewall.zone).
+  A rule with neither renders a commented-out stub rather than a rule-set
+  bound to no zone, which Junos would refuse to commit.
+
+  translated_source `interface` -> `then source-nat interface`; any other
+  value is a pool name -> `then source-nat pool <name>` (the pool must exist:
+  this template does not invent pool address ranges).
+  Destination and static NAT are not rendered here (no seed has asked yet).
+#}
+{% set rules = nat.rules | default([]) | rejectattr('enabled','equalto',False) | list %}
+{% set zin = nat._zones.inside | default([]) %}
+{% set zout = nat._zones.outside | default([]) %}
+security {
+  nat {
+    source {
+{% for rule in rules if rule.type | default('') == 'source' %}
+{%   set from_zones = rule.inside | default([], true) or zin %}
+{%   set to_zones = rule.outside | default([], true) or zout %}
+{%   if from_zones and to_zones %}
+      rule-set {{ rule.name }} {
+{%     for z in from_zones %}
+        from zone {{ z }};
+{%     endfor %}
+{%     for z in to_zones %}
+        to zone {{ z }};
+{%     endfor %}
+        rule {{ rule.name }} {
+          match {
+{%     for a in rule.source | default(['0.0.0.0/0'], true) %}
+            source-address {{ a }};
+{%     endfor %}
+{%     for a in rule.destination | default(['0.0.0.0/0'], true) %}
+            destination-address {{ a }};
+{%     endfor %}
+          }
+          then {
+            source-nat {
+{%     if rule.translated_source | default('interface') == 'interface' %}
+              interface;
+{%     else %}
+              pool {
+                {{ rule.translated_source }};
+              }
+{%     endif %}
+            }
+          }
+        }
+      }
+{%   else %}
+      /* NAT rule {{ rule.name }} NOT APPLIED: no from/to zone (set inside/outside on the rule or nat.role + firewall.zone on interfaces) */
+{%   endif %}
+{% endfor %}
+    }
+  }
+}
