diff --git a/netsim/extra/firewall/zonebased/fortios.j2 b/netsim/extra/firewall/zonebased/fortios.j2
index 5ff6f45..312d6f9 100644
--- a/netsim/extra/firewall/zonebased/fortios.j2
+++ b/netsim/extra/firewall/zonebased/fortios.j2
@@ -1,2 +1,112 @@
-{# dummy #}
+{#
+  firewall.zonebased on FortiOS, as CLI.
 
+  This template used to be an empty "dummy" comment, and the zones were left
+  to deploy.fortios.yml (fortinet.fortios REST modules, failures swallowed by a
+  rescue). That task list was never reached (it is removed): the custom
+  config is named `firewall.zonebased`, and the deploy-task lookup
+  (paths.custom.tasks, `<custom_config>/deploy.<device>.yml`) searches
+  extra/firewall.zonebased/, which does not exist. Every lane therefore sent
+  this empty template -- the KNE user_data, the KNE SSH replay, the generic
+  config-script lane -- and no zone was ever created. firewall.policy rules
+  that name a zone then fail on the box (`node_check_object fail! for name
+  LB_DMZ ... Return code -651`). Rendering the model here puts it on the same
+  lanes as every other FortiOS module.
+
+  Semantics are the REST task list's:
+    * one zone per interface firewall.zone, holding those interfaces
+    * intrazone allow|deny from a default rule whose from_zone == to_zone
+      (permit -> allow), else deny
+    * every other default rule is a firewall policy, zone to zone, all/ALL,
+      schedule always, full traffic log, named "<from>-><to> (default)"
+
+  Policy IDs: the REST task used 10 * <index in default_rules>, which starts at
+  0 (`edit 0` on the CLI means "allocate the next free ID", so a replay would
+  add a duplicate) and collides with firewall.policy's 10, 20, ... sequence.
+  Default rules take 10000 + 10 * index instead; the plugin refuses a
+  firewall.policy/nat sequence in that range on FortiOS.
+
+  Evaluation order is list position, not ID. The default rules are catch-alls
+  and must sit BELOW every firewall.policy rule; firewall.policy renders (and
+  is deployed) first, and the `move` lines keep the order when a replay adds a
+  rule to a box that already holds the defaults.
+
+  The zone block is repeated at the top of firewall/policy/fortios.j2 so the
+  zones exist before the first policy that names one (firewall.policy runs
+  before this plugin). Keep the two blocks identical.
+#}
+{% set zb_zones = {} %}
+{% for intf in interfaces|default([]) if intf.firewall.zone is defined %}
+{%   set _ = zb_zones.setdefault(intf.firewall.zone, []).append(intf.ifname) %}
+{% endfor %}
+{% set zb_intra = {} %}
+{% for rule in firewall.zonebased.default_rules|default([]) if rule.from_zone == rule.to_zone %}
+{%   set _ = zb_intra.update({ rule.from_zone: 'allow' if rule.action == 'permit' else 'deny' }) %}
+{% endfor %}
+{% if zb_zones %}
+config system zone
+{%   for zname, zifs in zb_zones.items() %}
+edit "{{ zname }}"
+set intrazone {{ zb_intra[zname]|default('deny') }}
+set interface "{{ zifs|join('" "') }}"
+next
+{%   endfor %}
+end
+{% endif %}
+{% set zb_ids = [] %}
+{% for rule in firewall.zonebased.default_rules|default([]) %}
+{%   if rule.from_zone != rule.to_zone %}
+{%     set _ = zb_ids.append(10000 + loop.index0 * 10) %}
+{%   endif %}
+{% endfor %}
+{% if firewall.zonebased.default_policy|default('deny') == 'permit' %}
+{%   set _ = zb_ids.append(19990) %}
+{% endif %}
+{% if zb_ids %}
+config firewall policy
+{%   for rule in firewall.zonebased.default_rules|default([]) %}
+{%     if rule.from_zone != rule.to_zone %}
+edit {{ 10000 + loop.index0 * 10 }}
+set name "{{ rule.from_zone }}->{{ rule.to_zone }} (default)"
+set srcintf "{{ rule.from_zone }}"
+set dstintf "{{ rule.to_zone }}"
+set action {{ 'accept' if rule.action == 'permit' else 'deny' }}
+set srcaddr "all"
+set dstaddr "all"
+set srcaddr6 "all"
+set dstaddr6 "all"
+set schedule "always"
+set service "ALL"
+set logtraffic all
+set logtraffic-start enable
+set status enable
+next
+{%     endif %}
+{%   endfor %}
+{%   if firewall.zonebased.default_policy|default('deny') == 'permit' %}
+{#     vSRX `default-policy permit-all`: FortiOS has no such knob (its implicit
+       last policy is deny), so permit-all is an explicit any->any accept, last. #}
+edit 19990
+set name "default-policy permit-all"
+set srcintf "any"
+set dstintf "any"
+set action accept
+set srcaddr "all"
+set dstaddr "all"
+set srcaddr6 "all"
+set dstaddr6 "all"
+set schedule "always"
+set service "ALL"
+set logtraffic all
+set status enable
+next
+{%   endif %}
+{%   set ns = namespace(prev=(firewall.policy.rules|default([])|map(attribute='sequence')|list|last) if firewall.policy.rules|default([]) else none) %}
+{%   if ns.prev is not none %}
+{%     for id in zb_ids %}
+move {{ id }} after {{ ns.prev }}
+{%       set ns.prev = id %}
+{%     endfor %}
+{%   endif %}
+end
+{% endif %}
diff --git a/netsim/extra/firewall/zonebased/panos.j2 b/netsim/extra/firewall/zonebased/panos.j2
new file mode 100644
index 0000000..9aa099d
--- /dev/null
+++ b/netsim/extra/firewall/zonebased/panos.j2
@@ -0,0 +1,25 @@
+{#
+  firewall.zonebased on PAN-OS, as configuration-mode set commands -- same
+  single-transport port as firewall.policy/panos.j2 (see the header there for
+  the reasoning). Default rules first, then explicit rules; declaration order
+  is evaluation order on a fresh device.
+#}
+{% macro zb_rule(rule, rname) -%}
+set rulebase security rules "{{ rname }}" description "{{ rule.description|default('netlab firewall.zonebased rule') }}"
+set rulebase security rules "{{ rname }}" from [ {{ rule.from_zone }} ]
+set rulebase security rules "{{ rname }}" to [ {{ rule.to_zone }} ]
+set rulebase security rules "{{ rname }}" source [ {{ rule.source|default(['any'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" destination [ {{ rule.destination|default(['any'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" application [ {{ rule.application|default(['any'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" service [ {{ rule.service|default(['application-default'])|join(' ') }} ]
+set rulebase security rules "{{ rname }}" action {{ 'allow' if rule.action == 'permit' else 'deny' }}
+set rulebase security rules "{{ rname }}" rule-type {{ 'intrazone' if rule.from_zone == rule.to_zone else 'interzone' }}
+set rulebase security rules "{{ rname }}" log-start {{ 'yes' if rule.log_start|default(false) else 'no' }}
+set rulebase security rules "{{ rname }}" log-end {{ 'yes' if rule.log_end|default(true) else 'no' }}
+{%- endmacro %}
+{% for rule in firewall.zonebased.default_rules|default([]) %}
+{{ zb_rule(rule, rule.name|default('netlab-default-' ~ (loop.index - 1))) }}
+{% endfor %}
+{% for rule in firewall.zonebased.rules|default([]) %}
+{{ zb_rule(rule, rule.name|default('netlab-rule-' ~ (loop.index - 1))) }}
+{% endfor %}
