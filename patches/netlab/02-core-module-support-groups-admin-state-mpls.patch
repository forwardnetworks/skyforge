From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Sun, 27 Sep 2026 12:00:00 +0000
Subject: [PATCH] core: provider-scoped module support is additive, groups.all
 is the global module list, extra-module check skips interface-VLAN links,
 explicit interface admin state, MPLS/L3VPN fixes

---
diff --git a/netsim/ansible/templates/initial/eos.j2 b/netsim/ansible/templates/initial/eos.j2
index 420bf9e..5a45a0a 100644
--- a/netsim/ansible/templates/initial/eos.j2
+++ b/netsim/ansible/templates/initial/eos.j2
@@ -106,9 +106,32 @@ interface {{ l.ifname }}
 {% if l.mac_address is defined %}
  mac-address {{ l.mac_address }}
 {% endif %}
-{% if l.virtual_interface is not defined and not l.shutdown|default(False) %}
+{% if l.virtual_interface is not defined %}
 !
+{#
+  EMIT THE ADMIN STATE EXPLICITLY, BOTH WAYS.
+
+  This used to render ` no shutdown` when the interface was up and NOTHING when
+  shutdown was true, which is only correct on a platform whose interfaces come
+  up admin-down and only on a COLD boot. EOS interfaces default to ENABLED, so
+  omitting a line never disabled anything -- and on a warm reconfigure, dropping
+  a line from the rendered config cannot undo what the device is already
+  running, whether the apply is a `configure terminal` merge or a `configure
+  replace` onto this file.
+
+  Result: `shutdown: true` on an interface was silently a no-op on EOS, while
+  bgp neighbour shutdown worked, because that renders a real command.
+  Reported 2026-09-03.
+
+  ios.j2, nxos.j2, iosxr.j2, asa.j2, arubacx.j2 and dellos10.j2 already emit the
+  explicit form, and junos/vyos/sros/routeros7/csrx emit their own disable
+  syntax; EOS and the IOL ifstate templates were the outliers.
+#}
+{%   if l.shutdown|default(False) %}
+ shutdown
+{%   else %}
  no shutdown
+{%   endif %}
 {% endif %}
 !
 {% endfor %}
diff --git a/netsim/augment/devices.py b/netsim/augment/devices.py
index b1e006f..a5d61a7 100644
--- a/netsim/augment/devices.py
+++ b/netsim/augment/devices.py
@@ -283,6 +283,14 @@ def add_device_module_support(
         mdata.supported_on[dname][provider] = True
       else:
         mdata.supported_on[dname] = True
+    elif provider and isinstance(mdata.supported_on[dname],Box):
+      # A SECOND provider declaring the same feature. The device is already in
+      # the list -- registered by the first provider block, as a per-provider
+      # dict -- so the guard above skipped it and the second provider's support
+      # was never recorded: linux declared vlan under clab and under kne, and
+      # kne still failed "does not support module vlan with provider kne"
+      # (2026-09-12). Provider-scoped support is additive per provider.
+      mdata.supported_on[dname][provider] = True
 
     if provider:
       features[m]._provider = provider              # Remember we're dealing with provider-specific features
diff --git a/netsim/augment/groups.py b/netsim/augment/groups.py
index 324e411..258a88b 100644
--- a/netsim/augment/groups.py
+++ b/netsim/augment/groups.py
@@ -474,6 +474,29 @@ def reverse_topsort(topology: Box) -> list:
 '''
 Copy group-level module or device setting into node data
 '''
+def device_supports_module(ndata: Box, module: str, topology: Box) -> bool:
+  """Does this node's device (under its provider) declare support for module?
+
+  Mirrors the check modules.check_supported_node_devices makes later, so a
+  default handed out here is one that check will accept: the device must be in
+  the module's supported_on list, and where that entry is provider-scoped the
+  node's provider must be enabled in it.
+  """
+  device = ndata.get('device',None) or topology.defaults.get('device',None)
+  if not device:
+    return False
+  mod_def = topology.defaults.get(module,None)
+  if not isinstance(mod_def,Box) or 'supported_on' not in mod_def:
+    return False
+  supported = mod_def.supported_on
+  if device not in supported:
+    return False
+  entry = supported[device]
+  if isinstance(entry,Box):
+    provider = ndata.get('provider',None) or topology.get('provider',None) or topology.defaults.get('provider',None)
+    return bool(entry.get(provider,False))
+  return True
+
 def copy_group_device_module(topology: Box) -> None:
   sorted_groups = reverse_topsort(topology)
   for grp in sorted_groups:                                 # First, set the device type
@@ -522,13 +545,59 @@ def copy_group_device_module(topology: Box) -> None:
         continue
 
       ndata = topology.nodes[name]                          # Get node data
+
+      # THE 'all' GROUP IS THE GLOBAL MODULE LIST, and the global list already
+      # skips hosts: augment_node_module copies topology.module only where
+      # propagate_global_modules says so (non-host, or a host running a daemon).
+      # This loop appended groups.all.module to EVERY member regardless, so a
+      # fleet-wide default set through groups.all -- which is the only way a
+      # defaults file can set one -- reached hosts the global list would have
+      # spared. MEASURED 2026-09-11: the OTG traffic generators (role: host,
+      # driven over their own API, netlab_initial: never) were being handed the
+      # services module and had to LIE that they support it, with no-op
+      # templates, just to compile. A default that a host cannot act on is not
+      # a default, it is a refusal waiting to fire. Explicit membership in any
+      # OTHER group is an authored request and is left exactly as it was.
+      #
+      # REFINED 2026-09-12: "host" is a ROLE, not a capability. An eos switch
+      # with role: host (a LAG/MLAG client) can run services and MUST -- the
+      # rendered node-file contract requires an SNMP carrier on every device
+      # the collector collects, and it failed a user's MLAG lab at boot with "node
+      # client1 device=eos has no SNMP carrier". So a host is spared only the
+      # modules its DEVICE cannot act on (OTG: none of them), and is handed the
+      # ones it can. The device's own declaration decides, never the role.
+      g_modules = list(gdata.module) if isinstance(gdata.module,list) else []
+      if grp == 'all' and not propagate_global_modules(ndata,topology):
+        g_modules = [ m for m in g_modules if device_supports_module(ndata,m,topology) ]
+        if not g_modules:
+          if log.debug_active('groups'):
+            print(f'... not adding module {gdata.module} to host {name} from group all')
+          continue
+
       if 'module' not in ndata:                             # Group can set module(s) to empty, so we have to
         ndata.module = []                                   # ... start with an empty list
+        # ... AND, for the 'all' group only, start with the topology-level list.
+        # Upstream's rule is that node- and group modules take precedence over the
+        # global list, and augment_node_module honours it by copying topology.module
+        # only into nodes that have NO module attribute yet. Group 'all' runs
+        # first, so a platform default set through groups.all in a defaults file
+        # ("every node runs services") left every node WITH a module list -- and
+        # the topology's own `module: [ ospf ]` was never copied. MEASURED
+        # 2026-09-12 in the runtime image: `module: [ ospf ]` at topology level
+        # rendered normalize,initial,services,ceos-bootstrap and no ospf; the same
+        # lab with per-node `module:` rendered ospf. 56 of 180 blueprints declare
+        # modules at topology level. 'all' IS the global list, so its modules are
+        # ADDED to the topology list, never a replacement for it. Any other group
+        # keeps upstream's precedence exactly as documented.
+        # (and only where the global list would reach: a host keeps upstream's
+        # exemption from it, it just gets the device-capable defaults below)
+        if grp == 'all' and topology.get('module',[]) and propagate_global_modules(ndata,topology):
+          ndata.module = list(topology.module)
 
       if not isinstance(ndata.module,list):                 # We'll let someone else deal with incorrect
         continue                                            # ... ndata.module data type
 
-      for m in gdata.module:                                # ... iterate over group modules
+      for m in g_modules:                                   # ... iterate over group modules
         data.append_to_list(ndata,'module',m)               # ... and append group modules to node.module list
 
       if log.debug_active('groups'):
@@ -563,6 +632,21 @@ def copy_group_node_data(topology: Box,pfx: str) -> None:
         for m in topo_modules:
           if not m in topology.nodes[name].module:
             merge_data.pop(m,None)
+      # The same rule for the 'all' group's OWN modules: a host that was not
+      # handed groups.all.module (see the module loop above) must not receive
+      # that module's attributes either, or netlab rightly refuses with "uses an
+      # attribute from module X which is not enabled". This is the existing
+      # global-list behaviour three lines up, applied to the group that IS the
+      # global list.
+      # REFINED 2026-09-12 with the module loop: a host DOES receive the
+      # modules its device can run, so it must receive their attributes too --
+      # services without services.server.snmp renders an empty cfglet, and the
+      # node-file contract then fails the boot exactly as if the module were
+      # missing (measured on r96 render: client1 got `services`, 0 snmp lines).
+      if g_type == 'node' and grp == 'all' and not propagate_global_modules(topology.nodes[name],topology):
+        for m in gdata.get('module',[]):
+          if not device_supports_module(topology.nodes[name],m,topology):
+            merge_data.pop(m,None)
 
       if topology[g_ns][name] is None:                                # We're early in data processing, some objects
         topology[g_ns][name] = {}                                     # ... might not have been initialized
diff --git a/netsim/augment/nodes.py b/netsim/augment/nodes.py
index 064eac4..16a49c6 100644
--- a/netsim/augment/nodes.py
+++ b/netsim/augment/nodes.py
@@ -16,6 +16,7 @@ from ..data import append_to_list, global_vars, is_true_int
 from ..data.types import must_be_device, must_be_id, must_be_int, must_be_string
 from ..data.validate import get_object_attributes, validate_attributes
 from ..devices._common import requires_plugin
+from ..modules import propagate_global_modules
 from ..modules._dataplane import extend_id_set, get_next_id, is_id_used, set_id_counter
 from ..utils import log
 from . import addressing, devices, groups, links
@@ -374,7 +375,18 @@ def find_node_device(n: Box, topology: Box) -> bool:
     n.provider = dev_def.provider
 
   if dev_def.get('node.module') and 'module' not in n:      # Have to copy default device module into node data
-    n.module = dev_def.node.module                          # ... before modules are initialized
+    n.module = list(dev_def.node.module)                    # ... before modules are initialized
+    # A device default is the SAME KIND of thing as groups.all: a platform-wide
+    # "every node of this device also runs X". It is not an authored node module
+    # list, so it must not trigger the node-over-global precedence rule in
+    # augment_node_module -- that rule exists so a topology author can narrow a
+    # node, not so a device file can silently discard the topology's own
+    # `module:` list. MEASURED 2026-09-12: `module: [ isis ]` at topology level
+    # with a device whose node.module is [ services ] rendered services and no
+    # isis. Daemons keep upstream's replace semantics: their node.module IS the
+    # device (dhcp on dnsmasq) and global routing modules do not apply to them.
+    if topology.get('module',[]) and not dev_def.get('daemon',False) and propagate_global_modules(n,topology):
+      n.module = list(topology.module) + [ m for m in n.module if m not in topology.module ]
 
   for group in dev_def.features.get('group',[]):
     groups.add_node_to_group(n.name,group,topology)
diff --git a/netsim/devices/linux.py b/netsim/devices/linux.py
index 193dcf4..44b8e4d 100644
--- a/netsim/devices/linux.py
+++ b/netsim/devices/linux.py
@@ -48,6 +48,10 @@ class Linux(_Quirks):
     check_indirect_static_routes(node)
     etc_resolv_mapping(node,topology)
 
-    if devices.get_provider(node,topology) != 'clab':
+    # Container providers share the clab contract (devices.uses_clab_contract):
+    # a KNE linux pod is the same vanilla image reached over its network
+    # namespace, not an Ubuntu VM with netplan, so the VM-only quirks (no VLAN
+    # subinterfaces, no dummy loopbacks) do not apply to it either.
+    if not devices.uses_clab_contract(node,topology.defaults):
       check_vm_modules(node,topology)
       check_extra_loopbacks(node,topology)
diff --git a/netsim/modules/__init__.py b/netsim/modules/__init__.py
index 09971ab..587df64 100644
--- a/netsim/modules/__init__.py
+++ b/netsim/modules/__init__.py
@@ -529,6 +529,16 @@ def check_extra_modules(l: Box, mod_list: dict, topology: Box, topo_mods: list)
   """Checks whether the link has attributes from modules that no attached node uses"""
   if 'vlan' in l:                               # Do not check VLAN links
     return                                      # ... we don't have full visibility at this point
+  # The same blind spot exists when the VLAN attachment is declared on an
+  # INTERFACE (`- sw: { vlan.access: v101 }`, the access-port form): the VLAN
+  # module copies the VLAN's gateway/vrf onto that link before this check runs
+  # and the SVI owners that actually use those modules (the csw pair carrying
+  # the VRRP gateway, the VTEPs carrying the anycast gateway) are not attached
+  # to the access link -- only the bridge port and the host are. Measured on
+  # demo-lab: 32 spurious "gateway ... no attached nodes use" warnings,
+  # one per host access link, all on VLANs whose gateway lived on other nodes.
+  if any('vlan' in intf for intf in l.get('interfaces',[]) if isinstance(intf,Box)):
+    return
 
   extra_mod = [ m for m in topo_mods if m in l and m not in mod_list ]
   if not extra_mod:                             # Nope?
diff --git a/netsim/modules/mpls.py b/netsim/modules/mpls.py
index 10468ff..0ec7a02 100644
--- a/netsim/modules/mpls.py
+++ b/netsim/modules/mpls.py
@@ -189,12 +189,20 @@ def node_adjust_mplsvpn(node: Box, topology: Box, features: Box) -> None:
     # mpls.vpn dictionary and we run L3VPN AF over the session type with this neighbor
     #
     for af in AF_LIST:
-      if af in node.mpls.vpn and n.type in node.mpls.vpn[af] and af in ngb_node.get('mpls.vpn'):
+      # `or {}`: a neighbour running MPLS *without* mpls.vpn returns None here,
+      # and `af in None` is a TypeError that aborts the whole compile. That is
+      # not an exotic shape -- it is the ordinary PE-P-PE lab, where the P runs
+      # LDP and carries no VPN address family.
+      if af in node.mpls.vpn and n.type in node.mpls.vpn[af] and af in (ngb_node.get('mpls.vpn') or {}):
         n['vpn'+af.replace('ip','')] = n.ipv4     # Activate L3VPN AF with the neighbor
         l3vpn_af = True
 
     if not l3vpn_af:                              # No L3VPN AFs activated with this neighbor
-      return                                      # ... no need for further checks
+      continue                                    # ... move on to the NEXT neighbour.
+                                                  # This was `return`, which left the
+                                                  # whole function on the first neighbour
+                                                  # without a VPN AF -- so every neighbour
+                                                  # after it silently lost its activation.
 
     # Finally, we have to check if the user enabled extended BGP communities on the BGP session type
     # used for this BGP neighbor. Cache the per-node warning status to prevent multiple
@@ -258,12 +266,42 @@ class MPLS(_Module):
           log.MissingValue,
           'mpls')
 
+
   def node_post_transform(self, node: Box, topology: Box) -> None:
     global FEATURE_NAME
 
     if not node.mpls:     
       return
 
+    # VRFs that nothing will ever advertise. This lives in POST-transform on
+    # purpose: a PE commonly acquires its VRFs from its links, not from its own
+    # node stanza, and in the earlier hook node.vrfs is still empty for exactly
+    # those nodes -- the check ran and found nothing on a real defect.
+    #
+    # A node can carry vrf + bgp + mpls, render RDs, route-targets and
+    # redistribution, bring up LDP and establish iBGP -- and move no customer
+    # traffic at all, because without mpls.vpn no VPN address family is
+    # configured and no neighbour is ever activated in it. Measured on a live
+    # lab: LDP adjacency operational, iBGP Established, "show running-config"
+    # carrying NO address-family vpn-ipv4, CE-to-CE 100% packet loss, and every
+    # monitoring condition green -- collection runs over the management
+    # interface, so a dead data plane still certifies healthy.
+    #
+    # A warning rather than an error: EVPN carries VRFs over its own transport
+    # and is correct without mpls.vpn, and a topology may supply the address
+    # family through a custom config template instead.
+    if node.get('vrfs',None) and 'bgp' in node.module and 'vpn' not in node.mpls:
+      if 'evpn' not in node.module:
+        log.warning(
+          text=f'Node {node.name} has VRFs and the bgp+mpls modules but no mpls.vpn, '
+               'so no VPN address family will be configured and VRF routes will not '
+               'be advertised to other PEs',
+          module='mpls',
+          flag='vrf_without_vpn_af',
+          more_hints=[
+            'Set mpls.vpn on the PE nodes (not on P routers) to activate the VPN address family',
+            'This is expected if the VRFs are carried by EVPN or by a custom config template'])
+
     features = devices.get_device_features(node,topology.defaults)
     if 'ldp' in node.mpls:
       node_adjust_ldp(node,topology,features)
diff --git a/netsim/templates/provider/clab/iol/ifstate.j2 b/netsim/templates/provider/clab/iol/ifstate.j2
index b4b78e5..df98619 100644
--- a/netsim/templates/provider/clab/iol/ifstate.j2
+++ b/netsim/templates/provider/clab/iol/ifstate.j2
@@ -1,7 +1,16 @@
 {% for ifdata in interfaces %}
 !
 interface {{ ifdata.ifname }}
-{%   if not ifdata.shutdown|default(False) %}
+{#
+  Emit the admin state explicitly, both ways. Rendering nothing for a shut
+  interface relies on the interface already being admin-down, which is true of a
+  COLD IOS boot and false of a warm reconfigure -- there, omitting a line cannot
+  undo what the device is running, so `shutdown: true` was a silent no-op.
+  Reported 2026-09-03.
+#}
+{%   if ifdata.shutdown|default(False) %}
+ shutdown
+{%   else %}
  no shutdown
 {%   endif %}
 {% endfor %}
