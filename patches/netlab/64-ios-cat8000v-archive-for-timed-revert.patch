From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:00:00 +0000
Subject: [PATCH] SKYFORGE-SPECIFIC: cat8000v renders the archive stanza with
 bootflash: so the device can arm a revert timer

---
diff --git a/netsim/ansible/templates/initial/ios.j2 b/netsim/ansible/templates/initial/ios.j2
index 2badc42..a489216 100644
--- a/netsim/ansible/templates/initial/ios.j2
+++ b/netsim/ansible/templates/initial/ios.j2
@@ -31,6 +31,17 @@ archive
  path unix:skyforge-archive
 !
 {% endif %}
+{% if netlab_device_type == 'cat8000v' %}
+{#
+    SKYFORGE-SPECIFIC. Same revert-timer prerequisite as the iol block above, on IOS-XE. A Rollback Confirmed Change is
+    refused until `archive` carries a path ("%Turn config archive on before using Rollback Confirmed Change", cat8000v
+    17.18.03a, 2026-10-24). The device's own file system here is bootflash: (unix: is IOL's). Rendered at day 0 so the
+    stanza is part of the approved baseline, not written by the change applier.
+#}
+archive
+ path bootflash:skyforge-archive
+!
+{% endif %}
 lldp run
 {#
   CDP is OFF by default, as upstream has it (#3807). netlab_cdp_enable -- a
-- 
2.56.0

