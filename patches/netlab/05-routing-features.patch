+++ b/netsim/extra/ospf/instances/iosxr.j2
@@ -0,0 +1,13 @@
+{#
+  Extra OSPF processes on IOS-XR, plus cross-process redistribution.
+  XR defines its macro inside ospf/iosxr.j2 rather than a separate file.
+#}
+{% import "ospf/iosxr.j2" as xrospf with context %}
