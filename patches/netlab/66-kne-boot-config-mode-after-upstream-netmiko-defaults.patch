From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Mon, 2 Nov 2026 12:00:00 -0600
Subject: [PATCH] SKYFORGE-SPECIFIC: KNE devices that boot their config keep
 the startup lane after upstream's netmiko defaults

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/netsim/devices/asav.yml b/netsim/devices/asav.yml
index 0dfb1d6..23b7427 100644
--- a/netsim/devices/asav.yml
+++ b/netsim/devices/asav.yml
@@ -199,3 +199,25 @@ clab:
     ansible_user: admin
     netlab_config_mode: netmiko
     netlab_ready: [ ssh ]
+# KNE: ASAv boots its rendered config from the KubeVirt day-0 (startup.cfg) AND gets it again over
+# Ansible after boot (tasks/deploy-config/asa.yml). Both follow from netlab_config_mode being UNSET:
+# the KNE provider then defaults to startup, netlab initial to Ansible. Upstream #3986 set
+# netlab_config_mode: netmiko in the clab block, and a KNE device WITHOUT its own kne block falls back
+# to clab wholesale, so the KNE provider would have rendered no startup-config and booted the ASAv
+# unconfigured. This block is the clab block without that key and without `node:` (kind/env are
+# containerlab pod settings the KNE provider never applied through the fallback; copying them would
+# change the KNE pod spec). The block's existence is what stops the fallback.
+kne:
+  image: vrnetlab/cisco_asav:9-16-4-57
+  features:
+    initial:
+      healthcheck: true
+  build: https://containerlab.dev/manual/kinds/cisco_asav/
+  group_vars:
+    ansible_ssh_pass: CiscoAsa1!
+    ansible_become_password: CiscoAsa1!
+    ansible_user: admin
+    netlab_ready: [ ssh ]
+    # Connect-only readiness, as on the old pin: the runtime's NETLAB_DEVICES_ASAV_KNE_IMAGE already gave KNE asav a
+    # kne block there, so the base value "" (patch 31) was live, not dead. Upstream #4006's `exit` is for clab.
+    netlab_check_command: ""
diff --git a/netsim/devices/cat8000v.yml b/netsim/devices/cat8000v.yml
index fd63eda..11be407 100644
--- a/netsim/devices/cat8000v.yml
+++ b/netsim/devices/cat8000v.yml
@@ -95,3 +95,6 @@ kne:
     # never: nothing is pushed after boot); a warm reconfigure is delivered
     # over netmiko to the running VM. Before this it had no reconfigure lane.
     netlab_reconfigure_mode: netmiko
+    # Bring-up stays on the config-drive day-0: upstream #3997 made netmiko the base IOS
+    # netlab_config_mode, which the KNE provider would otherwise read as the boot lane.
+    netlab_config_mode: startup
diff --git a/netsim/devices/csr.yml b/netsim/devices/csr.yml
index f3c0214..0a39d9a 100644
--- a/netsim/devices/csr.yml
+++ b/netsim/devices/csr.yml
@@ -49,3 +49,8 @@ libvirt:
       --graphics none --import
 kne:
   interface.name: eth{ifindex-1}
+  group_vars:
+    # KNE BOOTS THIS DEVICE'S CONFIG (KubeVirt config-drive day-0). Upstream #3997 made
+    # netmiko the base IOS netlab_config_mode; without this pin the KNE provider reads it,
+    # renders no startup-config and leaves the node to a post-boot netmiko push.
+    netlab_config_mode: startup
diff --git a/netsim/devices/iosv.yml b/netsim/devices/iosv.yml
index 27e95f5..c563749 100644
--- a/netsim/devices/iosv.yml
+++ b/netsim/devices/iosv.yml
@@ -51,3 +51,8 @@ clab:
 
 kne:
   interface.name: eth{ifindex}
+  group_vars:
+    # KNE BOOTS THIS DEVICE'S CONFIG (KubeVirt config-drive day-0). Upstream #3997 made
+    # netmiko the base IOS netlab_config_mode; without this pin the KNE provider reads it,
+    # renders no startup-config and leaves the node to a post-boot netmiko push.
+    netlab_config_mode: startup
diff --git a/netsim/devices/iosvl2.yml b/netsim/devices/iosvl2.yml
index 7810193..f4ccaf4 100644
--- a/netsim/devices/iosvl2.yml
+++ b/netsim/devices/iosvl2.yml
@@ -52,3 +52,8 @@ clab:
 kne:
   node.type: switch
   interface.name: eth{ifindex}
+  group_vars:
+    # KNE BOOTS THIS DEVICE'S CONFIG (KubeVirt config-drive day-0). Upstream #3997 made
+    # netmiko the base IOS netlab_config_mode; without this pin the KNE provider reads it,
+    # renders no startup-config and leaves the node to a post-boot netmiko push.
+    netlab_config_mode: startup
-- 
