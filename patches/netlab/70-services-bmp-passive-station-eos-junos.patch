From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Thu, 5 Nov 2026 08:55:24 -0600
Subject: [PATCH] services: render a passive BMP monitoring station on EOS and
 Junos nodes that run bgp

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/docs/module/services.md b/docs/module/services.md
index acbbcb1..aaeb711 100644
--- a/docs/module/services.md
+++ b/docs/module/services.md
@@ -130,3 +130,15 @@ snmp-server location lab-a
 
 The access level is spelled per platform -- `ro` on EOS, `RO` on IOS -- because
 these strings are written to the device verbatim.
+
+(services-bmp)=
+## BMP Monitoring Station (EOS and Junos)
+
+**services.bmp** (global/node dictionary, Skyforge extension) renders a passive BGP Monitoring Protocol station on the device, as day-0 configuration. It is rendered only on a node that runs the **bgp** module on a device declaring `services.bmp` (EOS, and the Junos devices except vSRX); on any other node the block is removed from the node data. There is no iBGP fallback.
+
+* **station** (string, required): DNS name or address of the BMP station, written to the device verbatim (no resolution by netlab).
+* **port** (int, default 50001): the TCP port the device listens on.
+* **mode** (default and only value: `passive`).
+* **name** (id, default `skyforge`): the station name on the device.
+* **failure_handling**: carried in node data for tooling; not rendered.
+* **enabled** (bool): `false` on a node removes the declaration for that node.
diff --git a/netsim/ansible/templates/services/eos.j2 b/netsim/ansible/templates/services/eos.j2
index 1e50990..5a53ca9 100644
--- a/netsim/ansible/templates/services/eos.j2
+++ b/netsim/ansible/templates/services/eos.j2
@@ -70,3 +70,20 @@ sflow sample {{ services.flow.sampling }}
 {%   endif %}
 sflow run
 {% endif %}
+{% if services.bmp is defined and bgp.as is defined %}
+{#
+  BMP MONITORING STATION, PASSIVE. The device listens on services.bmp.port and the
+  station dials in; `connection address` names the station and is written VERBATIM
+  (a DNS name stays a name -- whether this EOS release accepts a hostname there is
+  proven on a device, not assumed). resolve_bmp() has already dropped the block from
+  any node without the bgp module, so this only guards a template rendered outside
+  the module.
+#}
+router bgp {{ bgp.as }}
+   bgp monitoring
+   monitoring port {{ services.bmp.port|default(50001) }}
+   monitoring station {{ services.bmp.name|default('skyforge') }}
+      connection address {{ services.bmp.station }}
+      connection mode {{ services.bmp.mode|default('passive') }}
+!
+{% endif %}
diff --git a/netsim/ansible/templates/services/junos.j2 b/netsim/ansible/templates/services/junos.j2
index 418f8b3..c1af81f 100644
--- a/netsim/ansible/templates/services/junos.j2
+++ b/netsim/ansible/templates/services/junos.j2
@@ -28,3 +28,24 @@ system {
 {%   endif %}
 {% endfor %}
 }
+{% if services.bmp is defined and bgp.as is defined %}
+{#
+  BMP MONITORING STATION, PASSIVE. Hierarchical on purpose (see vmx.j2: a `set` line
+  in this concatenated file makes mgd reject the whole file). The station address is
+  written verbatim from the declaration. UNVERIFIED on a device: the spelling of the
+  passive connection-mode keyword and whether station-address accepts a hostname.
+#}
+routing-options {
+  bmp {
+    station {{ services.bmp.name|default('skyforge') }} {
+      connection-mode {{ services.bmp.mode|default('passive') }};
+      station-address {{ services.bmp.station }};
+      station-port {{ services.bmp.port|default(50001) }};
+      route-monitoring {
+        pre-policy;
+        post-policy;
+      }
+    }
+  }
+}
+{% endif %}
diff --git a/netsim/devices/eos.yml b/netsim/devices/eos.yml
index 0aff4fb..f52d6e8 100644
--- a/netsim/devices/eos.yml
+++ b/netsim/devices/eos.yml
@@ -178,6 +178,7 @@ features:
   services:
     dns: True
     syslog: True
+    bmp: True
     # sFLOW. EOS speaks sFlow, not NetFlow, on cEOS: `flow tracking hardware`
     # needs an ASIC this image does not have. Declaring only sflow is what makes
     # the module REFUSE `protocol: netflow` here rather than render nothing and
diff --git a/netsim/devices/junos.yml b/netsim/devices/junos.yml
index 6cf656f..dcdaab5 100644
--- a/netsim/devices/junos.yml
+++ b/netsim/devices/junos.yml
@@ -98,6 +98,8 @@ features:
       standard: True
       large: True
   services:
+    # BMP station: the generic Junos template renders it (services/junos.j2). vsrx opts out.
+    bmp: True
     dns:
       ipv4: True
       ipv6: True
diff --git a/netsim/devices/vsrx.yml b/netsim/devices/vsrx.yml
index fc00e70..449146b 100644
--- a/netsim/devices/vsrx.yml
+++ b/netsim/devices/vsrx.yml
@@ -11,6 +11,8 @@ group_vars:
 
 features:
   services:
+    # A firewall persona: no BMP station (the parent declares it).
+    bmp: False
     # SNMP agent: this device answers an NMS. Ported from the
     # snmp_config custom config module.
     server.snmp: True
diff --git a/netsim/modules/services.py b/netsim/modules/services.py
index 5fb7d87..49e0d4a 100644
--- a/netsim/modules/services.py
+++ b/netsim/modules/services.py
@@ -252,6 +252,49 @@ def disable_shared_hosts(ndata: Box) -> None:
   if 'clab.config_templates.hosts' in ndata:
     ndata.clab.config_templates.hosts = ndata.clab.config_templates.hosts.replace(':shared','')
 
+# SKYFORGE: services.bmp -- BGP Monitoring Protocol, passive, on EOS and Junos.
+BMP_DEFAULT_PORT = 50001
+BMP_DEFAULT_NAME = 'skyforge'
+
+def resolve_bmp(ndata: Box, topology: Box) -> None:
+  """
+  Decide whether services.bmp is rendered on this node, and fill in its defaults.
+
+  The block is KEPT only on a node that (a) runs the bgp module with an AS and (b) is a device declaring
+  services.bmp. Anything else has the block REMOVED, not merely ignored by the templates, because the
+  node data (host_vars/<node>/topology.json) is what tooling reads to learn which nodes have a monitoring
+  station: a node that rendered nothing must not look like one that did. The drop is silent on purpose --
+  a fleet-wide declaration is expected to meet FRR, IOS and XR nodes -- and `enabled: false` is the
+  explicit per-node opt-out.
+
+  A declaration without a station is an error: a station-less block would render a device config that
+  names nothing and looks configured.
+  """
+  bmp = ndata.get('services.bmp',None)
+  if bmp is None:
+    return
+
+  if not bmp.get('enabled',True):
+    ndata.services.pop('bmp')
+    return
+
+  features = devices.get_device_features(ndata,topology.defaults)
+  has_bgp = 'bgp' in ndata.get('module',[]) and ndata.get('bgp.as',None) is not None
+  if not has_bgp or not features.get('services',{}).get('bmp',False):
+    ndata.services.pop('bmp')
+    return
+
+  if not bmp.get('station',None):
+    log.error(
+      f'services.bmp on node {ndata.name} has no station (a DNS name or address of the BMP station)',
+      category=log.MissingValue,
+      module='services')
+    return
+
+  bmp.setdefault('name',BMP_DEFAULT_NAME)
+  bmp.setdefault('port',BMP_DEFAULT_PORT)
+  bmp.setdefault('mode','passive')
+
 # SKYFORGE: services.listen -- which network services a LINUX host listens on.
 LISTEN_TRANSPORT = { 'https': 'tcp', 'http': 'tcp', 'tcp-echo': 'tcp', 'iperf3': 'tcp', 'udp-echo': 'udp' }
 LISTEN_RESERVED = { ('tcp',22): 'sshd', ('udp',161): 'the SNMP agent' }
@@ -336,6 +379,7 @@ class Services(_Module):
         continue
 
       svc_nodes.append(ndata)
+      resolve_bmp(ndata,topology)
       resolve_servers(ndata,svc_data,topology,mod_attr,svc_cache)
       set_dns_fields(ndata)
       disable_shared_hosts(ndata)
diff --git a/netsim/modules/services.yml b/netsim/modules/services.yml
index fd4ef2f..3bc66ce 100644
--- a/netsim/modules/services.yml
+++ b/netsim/modules/services.yml
@@ -72,8 +72,24 @@ attributes:
           ipfix: { type: int, min_value: 1, max_value: 65535 }
           sflow: { type: int, min_value: 1, max_value: 65535 }
       transport_vrf: id
+    # BMP MONITORING STATION (EOS and Junos). Neither a client nor a server in the
+    # resolve_servers() sense: the station is named by the author (a DNS name or an
+    # address string, written to the device verbatim -- no resolution here), so it is
+    # a plain dict. The device LISTENS (passive mode) and the station dials it.
+    # Rendered only on a node that runs the bgp module on a device declaring
+    # services.bmp; everywhere else the block is dropped by resolve_bmp().
+    bmp:
+      enabled: bool
+      station: str
+      name: id
+      port: { type: int, min_value: 1, max_value: 65535 }
+      mode: { type: str, valid_values: [ passive ] }
+      failure_handling:
+        type: str
+        valid_values: [ FAIL_DEVICE, SWITCH_TO_CLI, ALWAYS_USE_CLI, ALWAYS_USE_BMP, CONTINUE_WITHOUT_BGP_DATA ]
   node:
     dns: { copy: global }
+    bmp: { copy: global }
     syslog: { copy: global }
     flow: { copy: global }
     # SKYFORGE: network services a LINUX host LISTENS on, declared where netlab can see them (node or group
@@ -157,6 +173,7 @@ _top:
 features:
   dns: DNS client
   syslog: syslog client
+  bmp: BMP monitoring station (device listens, station dials)
   # Split by PROTOCOL, not a flat `flow: True`. Juniper splits by platform --
   # sFlow on the switch, inline IPFIX on the router -- so one capability flag
   # would silently render nothing on half the fleet.
diff --git a/tests/test_services_bmp.py b/tests/test_services_bmp.py
new file mode 100644
index 0000000..8f4c615
--- /dev/null
+++ b/tests/test_services_bmp.py
@@ -0,0 +1,165 @@
+"""services.bmp: a passive BMP station on EOS and Junos, and nowhere else.
+
+These tests compile real topologies through the real module and render the real
+services templates, so they go red if the schema, the device declarations, the
+module's eligibility rule or either template is changed out from under the others.
+The requirement they pin: the station is rendered only on a node that runs the bgp
+module on EOS or Junos, never on any other platform, and a declaration that cannot
+render is removed from the node data rather than left looking configured.
+"""
+import textwrap
+from pathlib import Path
+
+import pytest
+from box import Box
+
+from netsim import augment
+from netsim.utils import log, templates
+from netsim.utils import read as _read
+
+SERVICES = 'ansible/templates/services'
+EXTRA = [str(Path(__file__).parent.parent / 'netsim' / 'ansible' / 'templates')]
+
+TOPOLOGY = """
+defaults.device: eos
+provider: clab
+module: [ bgp, services ]
+services.bmp.station: bmp.example.net
+bgp.as: 65000
+nodes:
+  e1:
+  j1:
+    device: vjunos-router
+    provider: libvirt
+    box: x
+  s1:
+    device: vsrx
+    provider: libvirt
+    box: x
+  f1:
+    device: frr
+  n1:
+    device: iosv
+  e2:
+    services.bmp.enabled: false
+  e3:
+    module: [ services ]
+  e4:
+    services.bmp.port: 50002
+    services.bmp.name: collector
+    services.bmp.failure_handling: SWITCH_TO_CLI
+links: [ e1-j1, e1-f1, e1-n1, e1-e2, e1-e3, e1-s1, e1-e4 ]
+"""
+
+
+def _init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+def compile_topology(tmp_path: Path, text: str, raise_error: bool = False) -> Box:
+  f = tmp_path / 'topology.yml'
+  f.write_text(textwrap.dedent(text).strip() + "\n")
+  _init_log(raise_error)
+  topology = _read.load(str(f),relative_topo_name=True,user_defaults=[])
+  log.exit_on_error()
+  augment.main.transform(topology)
+  return topology
+
+
+@pytest.fixture
+def topo(tmp_path: Path) -> Box:
+  return compile_topology(tmp_path,TOPOLOGY)
+
+
+def render(node: Box, device_template: str) -> str:
+  return templates.render_template(
+    data=node.to_dict(),
+    j2_file=f'{device_template}.j2',
+    path=SERVICES,extra_path=EXTRA)
+
+
+def test_eligible_nodes_keep_the_block_with_defaults_filled(topo: Box):
+  for name in ('e1','j1'):
+    bmp = topo.nodes[name].services.bmp
+    assert bmp.station == 'bmp.example.net'
+    assert bmp.port == 50001
+    assert bmp.mode == 'passive'
+    assert bmp.name == 'skyforge'
+
+
+def test_a_node_value_beats_the_default_and_failure_handling_is_carried(topo: Box):
+  bmp = topo.nodes.e4.services.bmp
+  assert (bmp.port,bmp.name,bmp.failure_handling) == (50002,'collector','SWITCH_TO_CLI')
+  assert 'failure_handling' not in topo.nodes.e1.services.bmp
+
+
+@pytest.mark.parametrize('node,why',[
+  ('f1','frr declares no bmp support'),
+  ('n1','ios declares no bmp support and has no bgp.as'),
+  ('s1','vsrx is a firewall persona that opts out of the junos declaration'),
+  ('e2','explicit enabled: false'),
+  ('e3','eos without the bgp module'),
+])
+def test_every_other_node_has_the_block_removed(topo: Box, node: str, why: str):
+  assert 'bmp' not in topo.nodes[node].get('services',{}), why
+
+
+def test_eos_renders_a_passive_station_under_router_bgp(topo: Box):
+  out = render(topo.nodes.e1,'eos')
+  assert textwrap.dedent("""\
+    router bgp 65000
+       bgp monitoring
+       monitoring port 50001
+       monitoring station skyforge
+          connection address bmp.example.net
+          connection mode passive
+    """) in out
+  assert 'collector' in render(topo.nodes.e4,'eos')
+  assert 'monitoring port 50002' in render(topo.nodes.e4,'eos')
+
+
+def test_junos_renders_hierarchical_config_never_set_lines(topo: Box):
+  out = render(topo.nodes.j1,'vjunos-router')
+  assert 'station skyforge {' in out
+  assert 'connection-mode passive;' in out
+  assert 'station-address bmp.example.net;' in out
+  assert 'station-port 50001;' in out
+  assert 'pre-policy;' in out and 'post-policy;' in out
+  assert not any(l.lstrip().startswith('set ') for l in out.splitlines())
+
+
+def test_no_bmp_text_without_the_declaration(topo: Box):
+  # e3 has no bgp module and e2 opted out: their rendered services must carry no station
+  assert 'monitoring' not in render(topo.nodes.e3,'eos')
+  assert 'bmp' not in render(topo.nodes.e2,'eos')
+  assert 'bmp' not in render(topo.nodes.s1,'vsrx')
+
+
+@pytest.mark.parametrize('template',sorted(
+  p.stem for p in (Path(__file__).parent.parent / 'netsim' / SERVICES).glob('*.j2')
+  if p.stem not in ('eos','junos','vmx','vptx','vsrx','vjunos-router','vjunos-switch')))
+def test_other_platforms_render_identically_with_or_without_the_declaration(topo: Box, template: str):
+  """IOS, IOS-XE, NX-OS, XR, FRR ... : the declaration must change not one byte."""
+  base = topo.nodes.f1.to_dict()
+  with_bmp = Box(base,box_dots=True)
+  with_bmp.services.bmp = {'station':'bmp.example.net','port':50001,'mode':'passive','name':'skyforge'}
+  data = Box(base,default_box=True,box_dots=True)
+  data.services.dns._server_list = ['10.0.0.1']
+  bare = templates.render_template(data=data.to_dict(),j2_file=f'{template}.j2',path=SERVICES,extra_path=EXTRA)
+  data.services.bmp = {'station':'bmp.example.net','port':50001,'mode':'passive','name':'skyforge'}
+  decl = templates.render_template(data=data.to_dict(),j2_file=f'{template}.j2',path=SERVICES,extra_path=EXTRA)
+  assert bare == decl
+
+
+def test_a_declaration_without_a_station_is_an_error(tmp_path: Path):
+  text = TOPOLOGY.replace('services.bmp.station: bmp.example.net','services.bmp.port: 50001')
+  with pytest.raises(log.ErrorAbort):
+    compile_topology(tmp_path,text,raise_error=True)
+
+
+def test_passive_is_the_only_mode(tmp_path: Path):
+  text = TOPOLOGY.replace('services.bmp.station: bmp.example.net',
+                          'services.bmp: { station: x, mode: active }')
+  with pytest.raises(log.ErrorAbort):
+    compile_topology(tmp_path,text,raise_error=True)
