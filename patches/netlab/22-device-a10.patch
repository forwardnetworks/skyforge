 {% endfor %}
diff --git a/netsim/extra/loadbalancer/defaults.yml b/netsim/extra/loadbalancer/defaults.yml
index 957d12b..b5c9884 100644
--- a/netsim/extra/loadbalancer/defaults.yml
+++ b/netsim/extra/loadbalancer/defaults.yml
@@ -108,3 +108,9 @@ attributes:
     pool:
       type: str
       _required: true
+    advertise:
+      type: bool
+      _description: |
+        Advertise the VIP into the node's routing protocols. On A10 ACOS the
+        virtual server is marked redistribution-flagged and OSPF gets
+        `redistribute vip only-flagged`; unflagged VIPs stay local.
diff --git a/tests/test_a10_deploy_and_vip_advertise.py b/tests/test_a10_deploy_and_vip_advertise.py
new file mode 100644
index 0000000..279f63c
--- /dev/null
+++ b/tests/test_a10_deploy_and_vip_advertise.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""
+A10 vThunder (ACOS):
+
+  * every module template the a10 device renders must be delivered -- when
+    deploy-config/a10.yml was missing, deploy-module.yml found the template,
+    found no deploy script and SKIPPED it, and the lab reported configured while
+    the vThunder ran its factory config. It is now delivered over netmiko, so
+    every module must map to the netmiko lane;
+  * loadbalancer.virtual_servers[].advertise renders BOTH halves of ACOS VIP
+    redistribution: `redistribution-flagged` on that virtual server and
+    `redistribute vip only-flagged` under router ospf. Unflagged VIPs stay
+    local, and a node with no flagged VIP gets no redistribution at all.
+"""
+
+import textwrap
+from pathlib import Path
+
+import pytest
+import yaml
+
+from netsim.augment import devices
+from netsim.cli import create
+from netsim.utils import log
+
+NETSIM = Path(__file__).resolve().parents[1] / 'netsim'
+
+
+def init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+def write_topology(tmp_path: Path, advertise: str) -> Path:
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent(f"""
+    provider: kne
+    plugin: [ loadbalancer ]
+    module: [ ospf ]
+    nodes:
+      lb:
+        device: a10
+        module: [ ospf ]              # the demo-lab A10s list their modules too
+        ospf.router_id: 10.254.2.6
+        loadbalancer:
+          pools:
+          - name: web
+            members:
+            - {{ name: s1, address: 10.55.101.11, port: 80 }}
+          virtual_servers:
+          - {{ name: flagged_vip, vip: 210.140.140.140, port: 80, pool: web {advertise} }}
+          - {{ name: local_vip, vip: 210.140.140.141, port: 80, pool: web }}
+      r1: {{ device: iol }}
+    links: [ lb-r1 ]
+    """).strip() + '\n')
+  return topo_file
+
+
+def module_cfg(node: str, module: str) -> str:
+  return Path(f'node_files/{node}/{module}').read_text()
+
+
+def test_a10_vip_advertise_renders_flag_and_ospf_redistribution(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log()
+  create.run(['-o','config','-o','provider',str(write_topology(tmp_path,', advertise: true'))])
+
+  lb = module_cfg('lb','loadbalancer')
+  assert 'slb virtual-server flagged_vip 210.140.140.140\n  redistribution-flagged\n  port 80 tcp\n' in lb
+  assert 'slb virtual-server local_vip 210.140.140.141\n  port 80 tcp\n' in lb   # unflagged stays local
+  assert lb.count('redistribution-flagged') == 1
+
+  ospf = module_cfg('lb','ospf')
+  assert ospf.startswith('router ospf 1\n')
+  assert '  redistribute vip only-flagged\n' in ospf
+
+
+def test_a10_without_advertise_renders_no_redistribution(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log()
+  create.run(['-o','config','-o','provider',str(write_topology(tmp_path,''))])
+
+  assert 'redistribution-flagged' not in module_cfg('lb','loadbalancer')
+  ospf = module_cfg('lb','ospf')
+  assert 'router ospf 1' in ospf                                          # positive control: OSPF did render
+  assert 'redistribute vip' not in ospf
+
+
+def test_a10_advertise_must_be_a_bool(tmp_path: Path) -> None:
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(write_topology(tmp_path,', advertise: sometimes'))])
+
+
+def test_every_a10_module_template_is_delivered_over_netmiko(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  init_log()
+  topology = create.run(['-o','config','-o','provider',str(write_topology(tmp_path,', advertise: true'))])
+  lb = topology.nodes.lb
+
+  assert devices.get_node_group_var(lb,'netlab_config_mode',topology.defaults) == 'netmiko'
+  modules = ['initial','ospf','loadbalancer']
+  for m in modules:
+    assert lb._node_config[m] == ':netmiko', m
+    assert Path(f'node_files/lb/{m}').exists(), m
+  assert set(lb.netlab_ansible_skip_module) >= set(modules)   # nothing left for the Ansible lane
+
+  device = yaml.safe_load((NETSIM / 'devices' / 'a10.yml').read_text())
+  assert device['group_vars']['netmiko_device_type'] == 'a10'
+  assert device['group_vars']['netmiko_save_command'] == 'write memory'
+  # The acos_config lane is retired, not dormant
+  assert not (NETSIM / 'ansible' / 'tasks' / 'deploy-config' / 'a10.yml').exists()
+  assert not (NETSIM / 'ansible' / 'tasks' / 'a10').exists()
+
+  templates = sorted(p.parent.name for p in (NETSIM / 'ansible' / 'templates').glob('*/a10.j2'))
+  assert {'initial','ospf','routing','services','loadbalancer'} <= set(templates)
+
+
+def test_a10_readiness_proves_the_cli_not_just_ssh() -> None:
+  device = yaml.safe_load((NETSIM / 'devices' / 'a10.yml').read_text())
+  assert device['group_vars']['netlab_ready'] == ['ssh','ansible']
+  ready = yaml.safe_load((NETSIM / 'ansible' / 'tasks' / 'readiness-check' / 'a10.yml').read_text())
+  probe = ready[0]
+  cmds = probe['a10.acos_cli.acos_command']['commands']
+  assert 'configure terminal' in cmds and cmds[-1] == 'end'
+  assert probe['until'] == 'a10_ready is succeeded'
+  assert 'a10_config_retries' in str(probe['retries'])
-- 
