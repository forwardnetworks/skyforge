+#!/usr/bin/env python3
+"""
+Primitives added for demo-lab intent parity (2026-09-19). Each one exists so a
+source facet can be DECLARED on the topology instead of injected as a config
+snippet:
+
+  bgp.multipath / bgp.multipath_relax   maximum-paths N (+ as-path multipath-relax)
+  ospf.distance                         administrative distance under router ospf
+  tunnel.registration_timeout           spoke `ip nhrp registration timeout N` (tunnel.dmvpn)
+  mpls.propagate_ttl: false             `no mpls ip propagate-ttl`
+  firewall.policy.inspect               ASA MPF `inspect icmp` in global_policy
+
+Every positive test greps the startup-config netlab writes for a KNE startup
+device; every negative test proves the attribute fails CLOSED on a device
+without the feature (a silent single-path/no-inspect render is the defect these
+primitives replace).
+"""
+
+import textwrap
+from pathlib import Path
+
+import pytest
+
+from netsim.cli import create
+from netsim.utils import log
+
+
+def init_log(raise_error: bool = False) -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True,raise_error=raise_error,warning=False,logging=False,verbose=0)
+
+
+def write_topology(tmp_path: Path, topology: str) -> Path:
+  topo_file = tmp_path / 'topology.yml'
+  topo_file.write_text(textwrap.dedent(topology).strip() + '\n')
+  return topo_file
+
+
+def startup(node: str) -> str:
+  return Path(f'node_files/{node}/startup-config').read_text()
+
+
+def module_cfg(node: str, module: str) -> str:
+  """cEOS is not a startup-config device on KNE: its module configs are
+  delivered by Ansible and land in node_files/<node>/<module>."""
+  return Path(f'node_files/{node}/{module}').read_text()
+
+
+def test_bgp_multipath_renders_on_ios_and_eos(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ bgp ]
+nodes:
+  ce:    { device: iol, bgp.as: 65016, bgp.multipath: 2, bgp.multipath_relax: true }
+  leaf:  { device: eos, bgp.as: 213,   bgp.multipath: 2 }
+  pe1:   { device: iol, bgp.as: 65255 }
+  pe2:   { device: iol, bgp.as: 65355 }
+links: [ ce-pe1, ce-pe2, leaf-pe1, leaf-pe2 ]
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  ce = startup('ce')
+  assert ' bgp bestpath as-path multipath-relax' in ce
+  assert '  maximum-paths 2\n' in ce
+  assert '  maximum-paths ibgp 2' in ce
+
+  leaf = module_cfg('leaf','bgp')
+  assert '  maximum-paths 2 ecmp 2' in leaf
+  assert 'multipath-relax' not in leaf          # not declared on the leaf
+
+  pe1 = startup('pe1')                          # positive control: undeclared => absent
+  assert 'maximum-paths' not in pe1
+
+
+def test_bgp_multipath_relax_needs_a_path_count(tmp_path: Path) -> None:
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ bgp ]
+nodes:
+  ce:  { device: iol, bgp.as: 65016, bgp.multipath_relax: true }
+  pe1: { device: iol, bgp.as: 65255 }
+links: [ ce-pe1 ]
+""")
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(topo_file)])
+
+
+def test_bgp_multipath_fails_closed_on_a_device_without_the_feature(tmp_path: Path) -> None:
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ bgp ]
+nodes:
+  r1: { device: vjunos-router, bgp.as: 65016, bgp.multipath: 2 }
+  r2: { device: iol, bgp.as: 65255 }
+links: [ r1-r2 ]
+""")
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(topo_file)])
+
+
+def test_ospf_distance_renders_on_ios_and_eos(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ ospf ]
+nodes:
+  rr:   { device: iol, ospf.distance: 201 }
+  sw:   { device: eos, ospf.distance: 150 }
+  x:    { device: iol }
+links: [ rr-sw, rr-x, sw-x ]
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  assert ' distance 201\n' in startup('rr')
+  sw = module_cfg('sw','ospf')
+  assert ' distance ospf intra-area 150' in sw
+  assert ' distance ospf external 150' in sw
+  assert ' distance ' not in startup('x')       # positive control
+
+
+def test_ospf_distance_fails_closed_on_a_device_without_the_feature(tmp_path: Path) -> None:
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ ospf ]
+nodes:
+  r1: { device: vjunos-router, ospf.distance: 201 }
+  r2: { device: iol }
+links: [ r1-r2 ]
+""")
+  init_log(raise_error=True)
+  with pytest.raises(log.ErrorAbort):
+    create.run(['-o','none',str(topo_file)])
+
+
+def test_dmvpn_registration_timeout_is_a_spoke_line_only(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+plugin: [ tunnel.dmvpn ]
+nodes:
+  hub:   { device: iol }
+  spoke: { device: iol }
+  inet:  { device: iol }
+links:
+- { hub: {}, inet: {}, role: tp }
+- { spoke: {}, inet: {}, role: tp }
+- hub:   { ipv4: 172.22.150.1/24 }
+  spoke: { ipv4: 172.22.150.2/24 }
+  prefix: { ipv4: 172.22.150.0/24 }
+  tunnel: { mode: dmvpn, hub: hub, nhrp_id: 22, registration_timeout: 10, source: { link: { role: tp } } }
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  spoke = startup('spoke')
+  assert ' ip nhrp registration timeout 10' in spoke
+  assert ' ip nhrp nhs 172.22.150.1' in spoke
+  hub = startup('hub')
+  assert 'registration timeout' not in hub     # hubs do not register
+  assert ' ip nhrp map multicast dynamic' in hub
+
+
+def test_mpls_propagate_ttl_false_renders_the_no_form(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.chdir(tmp_path)
+  topo_file = write_topology(tmp_path,"""
+provider: kne
+module: [ ospf, mpls ]
+mpls.ldp: true
+nodes:
+  pe: { device: iol, mpls.propagate_ttl: false }
+  p:  { device: iol }
+links: [ pe-p ]
+""")
+  init_log()
+  create.run(['-o','config','-o','provider',str(topo_file)])
+
+  assert 'no mpls ip propagate-ttl' in startup('pe')
+  assert 'propagate-ttl' not in startup('p')   # positive control
+
+
