+"""
+check_bgp_multipath: bgp.multipath / bgp.multipath_relax are device features
+(IOS 'maximum-paths N' + 'bgp bestpath as-path multipath-relax', EOS
+'maximum-paths N ecmp N'). A device without the feature fails loudly instead of
+silently installing one path.
+"""
+def check_bgp_multipath(node: Box, topology: Box) -> None:
+  if 'multipath' not in node.bgp and 'multipath_relax' not in node.bgp:
+    return
+  features = devices.get_device_features(node,topology.defaults)
+  if not features.bgp.get('multipath',False):
+    log.error(
+      text=f'{node.name} (device {node.device}) does not support BGP multipath (bgp.multipath / bgp.multipath_relax)',
+      category=log.IncorrectValue,
+      module='bgp')
+  if node.bgp.get('multipath_relax',False) and not node.bgp.get('multipath',0):
+    log.error(
+      text=f'{node.name}: bgp.multipath_relax needs bgp.multipath (the number of paths) as well',
+      category=log.IncorrectValue,
+      module='bgp')
+
 """
 Check the confederation data (if it exists) against node AS numbers
 """
