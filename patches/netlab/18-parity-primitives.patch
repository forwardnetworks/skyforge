diff --git a/netsim/modules/gateway.py b/netsim/modules/gateway.py
index 201fd8d..10f08ef 100644
--- a/netsim/modules/gateway.py
+++ b/netsim/modules/gateway.py
@@ -179,6 +179,36 @@ class FHRP(_Module):
         #
         process_gw_id(vdata.get('gateway.id',None),required=False,path=f'VLAN {vname}')
 
+  '''
+  VLAN access links behind a pure-L2 switch.
+
+  A VLAN definition may carry gateway parameters (protocol, VRRP group ...). The
+  vlan module copies them onto every access link of that VLAN, but the link
+  hook below runs only for links with a gateway-module node attached. A host
+  on an L2 access switch (the switch bridges, the dis pair two hops away owns
+  the VIP) sits on a link with no such node, so its link.gateway stays a bare
+  fragment without id/protocol, set_fhrp_gateway never derives the VIP, and the
+  host ends up with no default gateway -- while a host wired straight to an
+  IRB switch gets one. Same VLAN, different answer.
+
+  Finalize those links here (merge global defaults) so every host on the VLAN
+  learns the same VIP, whatever it is cabled to.
+  '''
+  def module_pre_link_transform(self, topology: Box) -> None:
+    global_gateway = data.get_global_settings(topology,'gateway')
+    if not global_gateway:                      # pragma: no cover
+      return
+    for link in topology.get('links',[]):
+      if not isinstance(link,Box) or not isinstance(link.get('gateway',None),Box):
+        continue
+      intfs = [ i for i in link.get('interfaces',[]) if isinstance(i,Box) and i.get('node') in topology.nodes ]
+      if any('gateway' in topology.nodes[i.node].get('module',[]) for i in intfs):
+        continue                                # A module node is attached: link_pre_link_transform owns it
+      if 'vlan_name' not in link and not any(i.get('vlan.access',None) for i in intfs):
+        continue                                # Not a VLAN access link: nothing to inherit from
+      check_gw_protocol(link.gateway,f'{link._linkname}',topology)
+      link.gateway = global_gateway + link.gateway
+
   def link_pre_link_transform(self, link: Box, topology: Box) -> None:
     #
     # Step#1: deal with 'gateway' interface attributes
