@@ -654,6 +654,20 @@ def transform(topology: Box, defaults: Box, pools: Box) -> None:
 Cleanup non-Ansible configuration file data -- remove all daemon/node config mappings that
 are not used by a module, a plugin (based on "config" data) or a device itself
 '''
+"""
+PLATFORM-SPECIFIC (patch 55): the 'lldp' node/interface attribute exists only on devices that declare the 'lldp' feature
+(today: linux with the kne provider). netlab's usual rule for a device that lacks an optional feature applies: the
+topology is rejected with "Device <device> does not support lldp used in <path>". That includes a link-level 'lldp' that
+propagates onto the interface of a node that cannot do it, and an explicit 'lldp: false' (the attribute is not accepted at all).
+"""
+def check_lldp_support(topology: Box) -> None:
+  for name,node in topology.nodes.items():
+    if 'lldp' in node:
+      devices.check_optional_features(node.lldp,f'nodes.{name}.lldp',node,topology,'lldp')
+    for idx,intf in enumerate(node.get('interfaces',[])):
+      if 'lldp' in intf:
+        devices.check_optional_features(intf.lldp,f'nodes.{name}.interfaces[{idx}].lldp (ifname {intf.get("ifname","?")})',node,topology,'lldp')
+
 def cleanup_non_ansible_config(n: Box) -> None:
   for kw in ('_daemon_config','_node_config'):
     if kw not in n:
diff --git a/netsim/cli/initial/deploy.py b/netsim/cli/initial/deploy.py
index f8084c8..65635f9 100644
--- a/netsim/cli/initial/deploy.py
+++ b/netsim/cli/initial/deploy.py
@@ -5,6 +5,8 @@
 #
 import argparse
 import concurrent.futures
+import os
+import threading
 import typing
 from pathlib import Path
 
@@ -134,12 +136,80 @@ def recreate_configs(topology: Box, args: argparse.Namespace, nodeset: list) ->
       default_suffix="none",
     )
 
+"""
+PLATFORM-SPECIFIC: overlap the Ansible lane with the internal (kubectl exec) fan-out.
+
+Upstream runs deploy_internal_config (a thread pool that execs shell/cEOS fragments into pods) to completion and
+only then starts the Ansible playbook for the nodes that need it (PAN-OS and the other VM NOS). The two lanes touch
+disjoint nodes: a node whose whole configuration set is in netlab_ansible_skip_module is never in the playbook
+(utils.nodeset_ansible_skip) and the internal lane never runs Ansible. fleet40 (2026-10-10): the fan-out took 27 s and
+PAN-OS config could not start until it ended; at 4,000 nodes the fan-out is ~8 minutes while a PAN-OS guest is
+usually ready long before.
+
+SKYFORGE_NETLAB_OVERLAP_ANSIBLE_LANE = 1 | true | yes | on: run() calls start_overlapped_ansible_lane() just before the
+internal fan-out; it starts the playbook in a thread. The unchanged call to deploy_ansible_playbook() further down then
+JOINS that thread and returns its (used, status) instead of running the playbook a second time. Unset or anything else:
+nothing is started and every line below runs exactly as upstream. The verdicts are unchanged: a failing lane still
+fails the run with the same message, a failure in one lane never skips the other (it did not before either), and an
+exception in the playbook thread is re-raised from that call, after the internal lane finished.
+"""
+_OVERLAPPED_LANE: typing.Optional[dict] = None
+_LANE_THREAD = threading.local()
+
+def overlap_ansible_lane_enabled() -> bool:
+  return os.environ.get('SKYFORGE_NETLAB_OVERLAP_ANSIBLE_LANE','').strip().lower() in ('1','true','yes','on')
+
+def start_overlapped_ansible_lane(
+      topology: Box,
+      args: argparse.Namespace,
+      nodeset: list,
+      rest: list) -> bool:
+  """Start the Ansible lane in a thread when the switch is on and some node needs it. Returns whether it started."""
+  global _OVERLAPPED_LANE
+  _OVERLAPPED_LANE = None
+  if not overlap_ansible_lane_enabled() or is_dry_run() or args.normalize:
+    return False
+  ansible_skip_list = utils.nodeset_ansible_skip(nodeset, topology, args)
+  if len(ansible_skip_list) == len(nodeset):                # Nothing needs Ansible: nothing to overlap
+    return False
+
+  outcome: dict = {}
+  def ansible_lane() -> None:
+    _LANE_THREAD.active = True                              # deploy_ansible_playbook must RUN, not join, in this thread
+    try:
+      outcome['result'] = deploy_ansible_playbook(topology,args,nodeset,rest,'deploy')
+    except BaseException as ex:                             # Re-raised by the joining call
+      outcome['error'] = ex
+
+  log.info(
+    f'Running the Ansible playbook for {len(nodeset) - len(ansible_skip_list)} node(s) while the other nodes are configured '
+    f'directly (SKYFORGE_NETLAB_OVERLAP_ANSIBLE_LANE)')
+  lane = threading.Thread(target=ansible_lane,name='ansible-lane')
+  _OVERLAPPED_LANE = { 'thread': lane, 'outcome': outcome }
+  lane.start()
+  return True
+
+def join_overlapped_ansible_lane() -> typing.Optional[typing.Tuple[bool, bool]]:
+  """The overlapped lane's (used, status) once it finished; None when no lane was started (run the playbook as upstream)."""
+  global _OVERLAPPED_LANE
+  lane, _OVERLAPPED_LANE = _OVERLAPPED_LANE, None
+  if lane is None:
+    return None
+  lane['thread'].join()
+  if 'error' in lane['outcome']:
+    raise lane['outcome']['error']
+  return lane['outcome']['result']
+
