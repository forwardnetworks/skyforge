+#
+# a plugin that edits a device table in place between two lookups
+#
+
+_EDIT_PLUGIN = '''
+def pre_node_transform(topology):
+  # the features of every eos node have been looked up (and cached) by now; change the table in place
+  topology.defaults.devices.eos.features.bfd = False
+  topology.defaults.devices.eos.features.bgp.multipath = False
+'''
+
+
+def _compile_with_plugin(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, name: str, fast: bool) -> tuple:
+  lab = tmp_path / name / 'lab'
+  lab.mkdir(parents=True)
+  monkeypatch.chdir(lab)
+  monkeypatch.setattr(memo, 'DISABLED', not fast)
+  monkeypatch.setattr(fastbox, 'ENABLED', fast)
+  memo.invalidate()
+  (lab / 'edit_features.py').write_text(_EDIT_PLUGIN)
+  (lab / 'topology.yml').write_text('plugin: [ edit_features ]\n' + textwrap.dedent(_TOPOLOGY).strip() + '\n')
+  _init_log()
+  create.run(['-o', 'config', '-o', 'provider', '-o', 'ansible:dir', '-o', 'pickle', str(lab / 'topology.yml')])
+  return lab
+
+
+def test_a_plugin_editing_a_device_table_gives_the_same_output(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  _warm_up(tmp_path, monkeypatch)
+  off = _tree(_compile_with_plugin(tmp_path, monkeypatch, 'off', fast=False), tmp_path / 'off')
+  on = _tree(_compile_with_plugin(tmp_path, monkeypatch, 'on', fast=True), tmp_path / 'on')
+  assert set(on) == set(off) and [k for k in on if on[k] != off[k]] == []
+
+
+def test_without_the_guards_the_same_plugin_is_caught_by_verify_mode(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """Positive control: break the invalidation AND the content guard on purpose; the stale cache must be reported."""
+  real = memo.memo
+  monkeypatch.setattr(memo, 'invalidate', lambda: None)
+  monkeypatch.setattr(memo, 'memo', lambda name, key, refs, compute, watch=(): real(name, key, refs, compute))
+  monkeypatch.setattr(memo, 'VERIFY', True)
+  with pytest.raises(SystemExit):
+    _compile_with_plugin(tmp_path, monkeypatch, 'broken', fast=True)
+
+
+def test_the_content_guard_alone_keeps_the_plugin_case_correct(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """Invalidation off, content guard on: an in-place edit is still noticed (verify mode would abort otherwise)."""
+  _warm_up(tmp_path, monkeypatch)
+  monkeypatch.setattr(memo, 'invalidate', lambda: None)
+  monkeypatch.setattr(memo, 'VERIFY', True)
+  off = _tree(_compile_with_plugin(tmp_path, monkeypatch, 'off', fast=False), tmp_path / 'off')
+  monkeypatch.setattr(memo, 'DISABLED', False)
+  on = _tree(_compile_with_plugin(tmp_path, monkeypatch, 'on', fast=True), tmp_path / 'on')
+  assert [k for k in on if on[k] != off[k]] == []
+
