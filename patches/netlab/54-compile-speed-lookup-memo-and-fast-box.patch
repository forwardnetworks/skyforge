+#
+# validate_attributes: the merged attribute table is modified while it validates (get_valid_attributes strips the
+# _required flags from tables it shares with the copy); the NEXT validation must start from an untouched table
+#
+
+def test_every_validation_starts_from_its_own_merged_attribute_table(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  from netsim.data import validate
+  _, topology = _compile(tmp_path, monkeypatch, 'val', fast=True)
+  attrs = topology.defaults.attributes
+  extra = validate.get_object_attributes(['providers', 'outputs'], topology)
+  memo.invalidate()
+  first = validate.resolve_attributes(attrs, extra, ['node'])
+  second = validate.resolve_attributes(attrs, extra, ['node'])
+  assert first[0] is not second[0]                    # a table of its own for every call
+  # what a validation does to its own table: recursive calls without extra attributes strip the required flags
+  for ns in validate.get_attribute_namespaces(first[0], ['node']):
+    validate.get_valid_attributes(first[0], [ns])
+  validate.resolve_attributes(first[0], None, ['link'])
+  third = validate.resolve_attributes(attrs, extra, ['node'])
+  monkeypatch.setattr(memo, 'DISABLED', True)
+  expected = validate.resolve_attributes(attrs, extra, ['node'])
+  assert third[0] == expected[0] and third[1] == expected[1] and third[2] == expected[2]
+
