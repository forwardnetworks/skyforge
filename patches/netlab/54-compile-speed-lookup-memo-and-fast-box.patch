diff --git a/tests/test_compile_speed.py b/tests/test_compile_speed.py
new file mode 100644
index 0000000..e3c433e
--- /dev/null
+++ b/tests/test_compile_speed.py
@@ -0,0 +1,424 @@
+#!/usr/bin/env python3
+"""
+Compile-speed patch (SKYFORGE-SPECIFIC, patch 50): the caches and the fast box conversions must change how long a
+compile takes, never what it produces.
+
+The tests are written from that requirement, not from the implementation: every one of them compares a result
+computed with the speed-ups ON against the same result computed with them OFF (python-box / uncached netlab).
+"""
+
+import copy
+import ipaddress
+import textwrap
+from pathlib import Path
+
+import pytest
+import yaml
+from box import Box, BoxList
+
+from netsim.augment import devices
+from netsim.cli import create
+from netsim.data import fastbox, get_box, memo
+from netsim.utils import log
+
+_OPTS = dict(default_box=True, default_box_none_transform=False, box_dots=True)
+
+
+def _init_log() -> None:
+  log.init_log_system(header=False)
+  log.set_flag(quiet=True, raise_error=False, warning=False, logging=False, verbose=0)
+
+
+def _same(a, b, path='') -> None:
+  """Independent comparator: values, container TYPES, key order, and python-box's own bookkeeping."""
+  assert type(a) is type(b), f'{path}: {type(a).__name__} != {type(b).__name__}'
+  if isinstance(a, dict):
+    assert list(a.keys()) == list(b.keys()), f'{path}: keys differ'
+    if isinstance(a, Box):
+      assert a._box_config == b._box_config, f'{path}: _box_config differs'
+    for k in a.keys():
+      _same(dict.__getitem__(a, k), dict.__getitem__(b, k), f'{path}.{k}')
+  elif isinstance(a, list):
+    assert len(a) == len(b), f'{path}: length differs'
+    if isinstance(a, BoxList):
+      assert a.box_options == b.box_options, f'{path}: box_options differ'
+    for i, (x, y) in enumerate(zip(a, b)):
+      _same(x, y, f'{path}[{i}]')
+  else:
+    assert a == b, f'{path}: {a!r} != {b!r}'
+
+
+_STRUCTURES = {
+  'scalars': {'a': 1, 'b': 'x', 'c': 2.5, 'd': True, 'e': None, 'f': b'raw', 'g': {1, 2}, 'h': (1, 2)},
+  'nested': {'a': {'b': {'c': [1, {'d': [2, [3, {'e': 'f'}]]}]}}},
+  'ip objects stay as they are': {'pfx': ipaddress.ip_network('10.0.0.0/24'), 'l': [ipaddress.ip_address('10.0.0.1')]},
+  'int and tuple keys': {1: 'one', (1, 2): 'pair', 'x': {2: {3: 4}}},
+  'keys that are not attribute names': {'a-b': 1, 'class': 2, '1x': 3, 'ü': 4},
+  'empty containers': {'a': {}, 'b': [], 'c': [[], {}]},
+  'dotted key splits into nested boxes': {'a.b': 1, 'c': {'d.e': {'f': 2}}},
+  'bracket key': {'a[0]': 1},
+  'list of lists of dicts': {'a': [[{'x': 1}], [{'y': [{'z': 2}]}]]},
+  'self reference': None,    # built below
+}
+
+
+def _self_ref() -> dict:
+  d: dict = {'a': 1}
+  d['me'] = d
+  return d
+
+
+@pytest.mark.parametrize('name', [n for n in _STRUCTURES if n != 'self reference'])
+def test_from_plain_equals_python_box(name: str) -> None:
+  expected = Box(copy.deepcopy(_STRUCTURES[name]), **_OPTS)
+  got = fastbox.from_plain(copy.deepcopy(_STRUCTURES[name]))
+  _same(got, expected)
+  # and the usual Box behaviour on top of it: attribute access, defaults, dotted access
+  if name == 'nested':
+    assert got.a.b.c[1].d[1][1].e == 'f'
+    assert got.missing.deep.value == {}              # default_box
+  if name == 'dotted key splits into nested boxes':
+    assert got.a.b == 1 and got.c.d.e.f == 2
+
+
+def test_from_plain_hands_a_self_referencing_dictionary_to_python_box() -> None:
+  got = fastbox.from_plain(_self_ref())
+  expected = Box(_self_ref(), **_OPTS)
+  _same(got, expected)
+
+
+def test_from_plain_is_a_true_copy() -> None:
+  src = {'a': {'b': [1, {'c': 2}]}}
+  box = fastbox.from_plain(src)
+  box.a.b[1].c = 99
+  box.a.b.append(3)
+  assert src == {'a': {'b': [1, {'c': 2}]}}
+
+
+def test_get_box_of_a_box_keeps_python_box_semantics() -> None:
+  """get_box(Box) must not take the fast path: python-box re-uses the BoxList objects of its source."""
+  src = get_box({'l': [{'a': 1}], 'd': {'x': 1}})
+  copy_ = get_box(src)
+  assert copy_.d is not src.d                         # dictionaries are re-created
+  assert copy_.l is src.l                             # ... and lists are shared, exactly as python-box does it
+
+
+@pytest.mark.parametrize('name', [n for n in _STRUCTURES if n != 'self reference'])
+def test_to_dict_equals_python_box(name: str) -> None:
+  box = Box(copy.deepcopy(_STRUCTURES[name]), **_OPTS)
+  got, expected = fastbox.to_dict(box), box.to_dict()
+  _same(got, expected)
+  assert type(got) is dict
+
+
+@pytest.mark.parametrize('name', [n for n in _STRUCTURES if n != 'self reference'])
+def test_copy_box_equals_python_box_copy(name: str) -> None:
+  src = get_box(copy.deepcopy(_STRUCTURES[name]))
+  _same(fastbox.copy_box(src), src.copy())
+
+
+def test_copy_box_shares_lists_exactly_like_python_box() -> None:
+  src = get_box({'l': [{'a': 1}], 'd': {'x': 1}})
+  for c in (fastbox.copy_box(src), src.copy()):
+    assert c.d is not src.d
+    assert c.l is src.l
+
+
+def test_get_box_of_a_box_equals_python_box() -> None:
+  src = get_box({'l': [{'a': 1}], 'd': {'x': [1, {'y': 2}]}, 'e': {}})
+  _same(get_box(src), Box(src, **_OPTS))
+
+
+def test_speedups_can_be_switched_off(monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.setattr(fastbox, 'ENABLED', False)
+  monkeypatch.setattr(memo, 'DISABLED', True)
+  _same(fastbox.from_plain({'a': {'b': [1]}}), Box({'a': {'b': [1]}}, **_OPTS))
+  calls = []
+  assert memo.memo('t', 1, (), lambda: calls.append(1) or 'v') == 'v'
+  assert memo.memo('t', 1, (), lambda: calls.append(1) or 'v') == 'v'
+  assert len(calls) == 2                              # nothing cached
+
+
+#
+# memo: a hit needs the SAME source objects; everything else recomputes
+#
+
+def test_memo_recomputes_when_the_source_object_is_replaced() -> None:
+  memo.invalidate()
+  t1, t2 = Box({'v': 1}), Box({'v': 1})
+  n = []
+  assert memo.memo('t', 'k', (t1,), lambda: n.append(1) or 'a') == 'a'
+  assert memo.memo('t', 'k', (t1,), lambda: n.append(1) or 'b') == 'a' and len(n) == 1          # hit
+  assert memo.memo('t', 'k', (t2,), lambda: n.append(1) or 'c') == 'c' and len(n) == 2          # equal but not the same object
+  memo.invalidate()
+  assert memo.memo('t', 'k', (t2,), lambda: n.append(1) or 'd') == 'd' and len(n) == 3          # invalidated
+
+
+def test_memo_verify_mode_aborts_on_a_stale_entry(monkeypatch: pytest.MonkeyPatch) -> None:
+  _init_log()
+  memo.invalidate()
+  monkeypatch.setattr(memo, 'VERIFY', True)
+  src = Box({'v': 1})
+  state = {'v': 'old'}
+  memo.memo('t', 'k', (src,), lambda: state['v'])
+  state['v'] = 'new'                                  # the table was edited in place behind the cache's back
+  with pytest.raises(SystemExit):
+    memo.memo('t', 'k', (src,), lambda: state['v'])
+  memo.invalidate()
+
+
+def test_verify_all_catches_a_caller_that_modified_a_shared_result() -> None:
+  _init_log()
+  memo.invalidate()
+  src = Box({'v': 1})
+  shared = memo.memo('t', 'k', (src,), lambda: Box({'x': {'y': 1}}))
+  memo.verify_all('before')                           # untouched: fine
+  shared.x.y = 2                                      # a caller edits the shared object
+  with pytest.raises(SystemExit):
+    memo.verify_all('after')
+  memo.invalidate()
+
+
+#
+# device lookups: cached == uncached for every device, provider and attribute
+#
+
+_TOPOLOGY = """
+provider: kne
+module: [ ospf, bgp, vxlan, evpn, vlan ]
+bgp.as: 65000
+addressing:
+  loopback: { ipv4: 10.0.0.0/16, prefix: 32 }
+  mgmt: { ipv4: 10.200.0.0/14 }
+vlans:
+  tenant0: { id: 100, mode: bridge, prefix: 10.100.0.0/24 }
+  tenant1: { id: 101, mode: bridge, prefix: 10.104.0.0/24 }
+defaults.device: eos
+nodes:
+  s1: { bgp.rr: true }
+  s2: { bgp.rr: true }
+  l1: { vlans: { tenant0: {}, tenant1: {} } }
+  l2: { vlans: { tenant0: {}, tenant1: {} } }
+  h1: { device: linux }
+  h2: { device: linux }
+  h3: { device: linux }
+links:
+- { s1: , l1: }
+- { s1: , l2: }
+- { s2: , l1: }
+- { s2: , l2: }
+- { l1: , h1: , vlan.access: tenant0 }
+- { l1: , h2: , vlan.access: tenant1 }
+- { l2: , h3: , vlan.access: tenant0 }
+"""
+
+_ATTRS = ['features', 'group_vars', 'interface_name', 'ifindex_offset', 'role', 'mgmt_if', 'daemon',
+          'features.initial.normalize', 'features.vlan', 'features.bgp', 'features.routing', 'clab', 'kne']
+
+
+def _compile(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, name: str, fast: bool) -> tuple:
+  lab = tmp_path / name / 'lab'
+  lab.mkdir(parents=True)
+  monkeypatch.chdir(lab)
+  monkeypatch.setattr(memo, 'DISABLED', not fast)
+  monkeypatch.setattr(fastbox, 'ENABLED', fast)
+  memo.invalidate()
+  (lab / 'topology.yml').write_text(textwrap.dedent(_TOPOLOGY).strip() + '\n')
+  _init_log()
+  topology = create.run(['-o', 'config', '-o', 'provider', '-o', 'ansible:dir', '-o', 'pickle', str(lab / 'topology.yml')])
+  return lab, topology
+
+
+def _warm_up(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """netlab caches the parsed defaults on first use and the key order of a cold and a warm start differ: compare warm starts."""
+  _compile(tmp_path, monkeypatch, 'warmup', fast=False)
+
+
+def _tree(lab: Path, root: Path) -> dict:
+  out = {}
+  for p in sorted(lab.rglob('*')):
+    if p.is_file() and '__pycache__' not in p.parts:
+      rel = str(p.relative_to(lab))
+      raw = p.read_bytes()
+      if rel.endswith('.pickle'):
+        import pickle
+        data = pickle.loads(raw)
+        data.get('defaults', {}).get('_cache', {}).pop('timestamp', None)
+        raw = repr(data).encode()
+      out[rel] = raw.replace(str(root).encode(), b'<ROOT>')
+  return out
+
+
+def test_compile_output_is_identical_with_and_without_the_speedups(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  _warm_up(tmp_path, monkeypatch)
+  lab_off, _ = _compile(tmp_path, monkeypatch, 'off', fast=False)
+  off = _tree(lab_off, tmp_path / 'off')
+  lab_on, _ = _compile(tmp_path, monkeypatch, 'on', fast=True)
+  on = _tree(lab_on, tmp_path / 'on')
+  assert set(on) == set(off) and len(on) > 20
+  assert [k for k in on if on[k] != off[k]] == []
+
+
+@pytest.mark.parametrize('provider', [None, 'clab', 'kne'])
+def test_device_lookups_return_what_the_uncached_code_returns(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, provider: str) -> None:
+  _, topology = _compile(tmp_path, monkeypatch, 'dev', fast=True)
+  defaults = topology.defaults
+  checked = 0
+  for dev in defaults.devices.keys():
+    node = Box({'device': dev, 'name': 'x'} | ({'provider': provider} if provider else {}), **_OPTS)
+    for attr in _ATTRS:
+      monkeypatch.setattr(memo, 'DISABLED', True)
+      expected = devices.get_device_attribute(node, attr, defaults)
+      monkeypatch.setattr(memo, 'DISABLED', False)
+      memo.invalidate()
+      first = devices.get_device_attribute(node, attr, defaults)
+      second = devices.get_device_attribute(node, attr, defaults)                # served from the cache
+      assert first == expected and second == expected, f'{dev}/{provider}/{attr}'
+      checked += 1
+    monkeypatch.setattr(memo, 'DISABLED', True)
+    expected = devices.get_device_features(node, defaults)
+    monkeypatch.setattr(memo, 'DISABLED', False)
+    assert devices.get_device_features(node, defaults) == expected
+    assert devices.get_device_features(node, defaults) == expected
+    # a node with its own features must never be handed the shared table
+    node2 = Box(dict(node) | {'_features': {'x_test_only': True}}, **_OPTS)
+    got = devices.get_device_features(node2, defaults)
+    assert got.get('x_test_only') is True
+    assert 'x_test_only' not in devices.get_device_features(node, defaults)
+  assert checked > 500
+
+
+def test_features_returned_to_a_caller_are_private_copies(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  """python-box creates a key when a missing one is read; that must never leak from one caller to the next."""
+  _, topology = _compile(tmp_path, monkeypatch, 'sh', fast=True)
+  node = Box({'device': 'eos', 'name': 'x'}, **_OPTS)
+  first = devices.get_device_features(node, topology.defaults)
+  assert 'x_never_defined' not in first
+  _ = first.x_never_defined.deeper                    # default_box: reading creates the key in THIS copy
+  first.bfd = 'scribble'
+  assert 'x_never_defined' in first
+  second = devices.get_device_features(node, topology.defaults)
+  assert 'x_never_defined' not in second and second.bfd != 'scribble'
+  assert topology.defaults.devices.eos.features.get('bfd') != 'scribble'
+
+
+def test_merged_device_attributes_are_private_copies(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+  _, topology = _compile(tmp_path, monkeypatch, 'sh2', fast=True)
+  node = Box({'device': 'eos', 'name': 'x', 'provider': 'kne'}, **_OPTS)
+  first = devices.get_device_attribute(node, 'group_vars', topology.defaults)
+  first.ansible_user = 'scribble'
+  _ = first.x_never_defined.deeper
+  second = devices.get_device_attribute(node, 'group_vars', topology.defaults)
+  assert second.ansible_user != 'scribble' and 'x_never_defined' not in second
+
