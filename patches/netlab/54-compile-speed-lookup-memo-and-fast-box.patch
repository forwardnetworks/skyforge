+#
+# the fast paths check themselves against the INSTALLED python-box before first use (the runtime image ships a
+# different build than developers have; the first version of this patch killed every compile in the image)
+#
+
+def test_a_fast_path_that_disagrees_with_python_box_switches_the_module_off(monkeypatch: pytest.MonkeyPatch) -> None:
+  monkeypatch.setattr(fastbox, '_self_test_state', None)
+  monkeypatch.setattr(fastbox, '_copy_fast', lambda src, ns=(): Box({'wrong': 1}, **_OPTS))
+  assert fastbox.enabled() is False
+  src = get_box({'a': {'b': [1]}})
+  _same(fastbox.copy_box(src), src.copy())             # python-box's own result
+  _same(fastbox.add(src, {'c': 1}), src + {'c': 1})
+
+
+def test_a_fast_path_that_raises_switches_the_module_off(monkeypatch: pytest.MonkeyPatch) -> None:
+  def boom(*a, **k):
+    raise TypeError('merge_update expected at most 1 argument, got 2')
+  monkeypatch.setattr(fastbox, '_self_test_state', None)
+  monkeypatch.setattr(fastbox, '_from_plain_fast', boom)
+  assert fastbox.enabled() is False
+  _same(fastbox.from_plain({'a': [{'b': 1}]}), Box({'a': [{'b': 1}]}, **_OPTS))
+
