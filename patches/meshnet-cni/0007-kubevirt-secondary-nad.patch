+func linksForCNIRequest(links []*mpb.Link, ifName string, requireMatch bool) ([]*mpb.Link, error) {
+	ifName = strings.TrimSpace(ifName)
+	if ifName == "" {
+		if requireMatch {
+			return nil, fmt.Errorf("requested CNI interface is required for kubevirt secondary meshnet ADD/DEL")
+		}
+		return links, nil
+	}
+	filtered := make([]*mpb.Link, 0, 1)
+	for _, link := range links {
+		if link != nil && strings.TrimSpace(link.LocalIntf) == ifName {
+			filtered = append(filtered, link)
+		}
+	}
+	if len(filtered) == 0 {
+		if requireMatch {
+			return nil, fmt.Errorf("requested CNI interface %q does not match any meshnet topology link", ifName)
+		}
+		return links, nil
+	}
+	return filtered, nil
+}
+
+func kubeVirtSecondaryWaitDuration(seconds int) time.Duration {
+	if seconds <= 0 {
+		seconds = 240
+	}
+	return time.Duration(seconds) * time.Second
+}
+
+func isPodAlive(pod *mpb.Pod) bool {
+	return pod != nil && strings.TrimSpace(pod.SrcIp) != "" && strings.TrimSpace(pod.NetNs) != ""
+}
+
+func waitForPeerPodAlive(ctx context.Context, meshnetClient mpb.LocalClient, podName, ns, localPodName, localIntf string, wait time.Duration) (*mpb.Pod, error) {
+	if wait <= 0 {
+		wait = kubeVirtSecondaryWaitDuration(0)
+	}
+	deadline := time.Now().Add(wait)
+	var lastErr error
+	for {
+		peerPod, err := meshnetClient.Get(ctx, &mpb.PodQuery{
+			Name:   podName,
+			KubeNs: ns,
+		})
+		if err == nil && isPodAlive(peerPod) {
+			return peerPod, nil
+		}
+		if err != nil {
+			lastErr = err
+		}
+		if time.Now().After(deadline) {
+			if lastErr != nil {
+				return nil, fmt.Errorf("kubevirt secondary interface %s on pod %s timed out waiting %.0fs for peer pod %s topology/alive metadata: %w", localIntf, localPodName, wait.Seconds(), podName, lastErr)
+			}
+			return nil, fmt.Errorf("kubevirt secondary interface %s on pod %s timed out waiting %.0fs for peer pod %s to become alive", localIntf, localPodName, wait.Seconds(), podName)
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(2 * time.Second):
+		}
+	}
+}
+
 // perRPCTimeout is a grpc unary interceptor that bounds every RPC with
 // rpcTimeout while still honouring the caller's overall command budget
 // carried by the parent context.
@@ -244,6 +311,48 @@ func dialGRPC(ctx context.Context, target string) (*grpc.ClientConn, error) {
 	return conn, nil
 }
 
+func requestedIfName(args *skel.CmdArgs) string {
+	if args == nil {
+		return ""
+	}
+	if ifName := strings.TrimSpace(args.IfName); ifName != "" {
+		return ifName
+	}
+	return strings.TrimSpace(os.Getenv("CNI_IFNAME"))
+}
+
+func alignResultInterfaceName(result *current.Result, ifName string) {
+	if result == nil {
+		return
+	}
+	ifName = strings.TrimSpace(ifName)
+	if ifName == "" {
+		return
+	}
+	if len(result.Interfaces) == 0 {
+		result.Interfaces = []*current.Interface{{Name: ifName}}
+		return
+	}
+	result.Interfaces[len(result.Interfaces)-1].Name = ifName
+}
+
+func printKubeVirtSecondaryResult(result *current.Result, version, ifName string) error {
+	alignResultInterfaceName(result, ifName)
+	return types.PrintResult(result, version)
+}
+
+func isKubeVirtLauncherDefaultCNI(podName, ifName string, kubeVirtSecondary bool) bool {
+	if kubeVirtSecondary {
+		return false
+	}
+	podName = strings.TrimSpace(podName)
+	ifName = strings.TrimSpace(ifName)
+	if ifName != "" && ifName != "eth0" {
+		return false
+	}
+	return strings.HasPrefix(podName, "virt-launcher-")
+}
