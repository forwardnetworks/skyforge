+package main
+
+import (
+	"testing"
+	"time"
+
+	"github.com/containernetworking/cni/pkg/types/current"
+	mpb "github.com/networkop/meshnet-cni/daemon/proto/meshnet/v1beta1"
+)
+
+func TestLinksForCNIRequestMatchesRequestedInterface(t *testing.T) {
+	links := []*mpb.Link{{LocalIntf: "eth1"}, {LocalIntf: "eth2"}}
+	got, err := linksForCNIRequest(links, "eth2", true)
+	if err != nil {
+		t.Fatalf("linksForCNIRequest() returned error: %v", err)
+	}
+	if len(got) != 1 || got[0].LocalIntf != "eth2" {
+		t.Fatalf("linksForCNIRequest() = %#v, want only eth2", got)
+	}
+}
+
+func TestLinksForCNIRequestFailsClosedForUnknownRequestedInterface(t *testing.T) {
+	links := []*mpb.Link{{LocalIntf: "eth1"}, {LocalIntf: "eth2"}}
+	if _, err := linksForCNIRequest(links, "eth9", true); err == nil {
+		t.Fatal("expected unknown requested interface to fail closed")
+	}
+}
+
+func TestLinksForCNIRequestRequiresInterfaceForSecondary(t *testing.T) {
+	links := []*mpb.Link{{LocalIntf: "eth1"}}
+	if _, err := linksForCNIRequest(links, "", true); err == nil {
+		t.Fatal("expected missing requested interface to fail closed for kubevirt secondary")
+	}
+}
+
+func TestLinksForCNIRequestFallsBackForDefaultTopologyAdd(t *testing.T) {
+	links := []*mpb.Link{{LocalIntf: "eth1"}, {LocalIntf: "eth2"}}
+	got, err := linksForCNIRequest(links, "eth0", false)
+	if err != nil {
+		t.Fatalf("linksForCNIRequest() returned error: %v", err)
+	}
+	if len(got) != len(links) {
+		t.Fatalf("default topology ADD got %d links, want %d", len(got), len(links))
+	}
+}
+
+func TestKubeVirtSecondaryWaitDurationDefaultAndOverride(t *testing.T) {
+	if got := kubeVirtSecondaryWaitDuration(0); got != 240*time.Second {
+		t.Fatalf("kubeVirtSecondaryWaitDuration(0) = %s, want 240s", got)
+	}
+	if got := kubeVirtSecondaryWaitDuration(17); got != 17*time.Second {
+		t.Fatalf("kubeVirtSecondaryWaitDuration(17) = %s, want 17s", got)
+	}
+}
+
+func TestIsPodAliveRequiresSourceAndNetNS(t *testing.T) {
+	if isPodAlive(nil) {
+		t.Fatal("nil pod must not be alive")
+	}
+	if isPodAlive(&mpb.Pod{SrcIp: "192.0.2.1"}) {
+		t.Fatal("pod without netns must not be alive")
+	}
+	if isPodAlive(&mpb.Pod{NetNs: "/proc/1/ns/net"}) {
+		t.Fatal("pod without source IP must not be alive")
+	}
+	if !isPodAlive(&mpb.Pod{SrcIp: "192.0.2.1", NetNs: "/proc/1/ns/net"}) {
+		t.Fatal("pod with source IP and netns must be alive")
+	}
+}
+
+func TestAlignResultInterfaceNameUsesRequestedInterface(t *testing.T) {
+	result := &current.Result{Interfaces: []*current.Interface{{Name: "meshnet"}}}
+	alignResultInterfaceName(result, "pod123")
+	if len(result.Interfaces) != 1 || result.Interfaces[0].Name != "pod123" {
+		t.Fatalf("alignResultInterfaceName() = %#v, want pod123", result.Interfaces)
+	}
+}
+
+func TestAlignResultInterfaceNameAddsMissingInterface(t *testing.T) {
+	result := &current.Result{}
+	alignResultInterfaceName(result, "pod123")
+	if len(result.Interfaces) != 1 || result.Interfaces[0].Name != "pod123" {
+		t.Fatalf("alignResultInterfaceName() = %#v, want new pod123 interface", result.Interfaces)
+	}
+}
+
+func TestKubeVirtLauncherDefaultCNIIsSkipped(t *testing.T) {
+	if !isKubeVirtLauncherDefaultCNI("virt-launcher-router1-abcd", "eth0", false) {
+		t.Fatal("expected default launcher eth0 CNI call to be skipped")
+	}
+	if !isKubeVirtLauncherDefaultCNI("virt-launcher-router1-abcd", "", false) {
+		t.Fatal("expected default launcher CNI call without explicit ifName to be skipped")
+	}
+}
+
+func TestKubeVirtLauncherSecondaryCNIIsNotSkipped(t *testing.T) {
+	if isKubeVirtLauncherDefaultCNI("virt-launcher-router1-abcd", "eth1", true) {
+		t.Fatal("kubevirtSecondary NAD call must not be skipped")
+	}
+	if isKubeVirtLauncherDefaultCNI("virt-launcher-router1-abcd", "eth1", false) {
+		t.Fatal("non-default launcher interface must not be skipped")
+	}
+	if isKubeVirtLauncherDefaultCNI("container-ceos1", "eth0", false) {
+		t.Fatal("container topology pod default CNI call must not be skipped")
+	}
+}
