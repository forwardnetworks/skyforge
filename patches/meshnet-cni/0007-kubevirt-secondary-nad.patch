+	if isKubeVirtLauncherDefaultCNI(string(cniArgs.K8S_POD_NAME), requestedIntf, n.KubeVirtSecondary) {
+		log.Infof("Del[%s]: KubeVirt launcher default interface %q is owned by the primary CNI; skipping meshnet cleanup", string(cniArgs.K8S_POD_NAME), requestedIntf)
+		return types.PrintResult(result, n.CNIVersion)
