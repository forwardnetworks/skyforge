 // Deletes interfaces from a POD
+func cleanupKubeVirtSecondaryInterface(ctx context.Context, meshnetClient mpb.LocalClient, args *skel.CmdArgs, cniArgs *k8sArgs, localPod *mpb.Pod, requestedIntf string) error {
+	links, err := linksForCNIRequest(localPod.Links, requestedIntf, true)
+	if err != nil {
+		return err
+	}
+	log.Infof("Del[%s]: kubevirt secondary cleanup for interface %q (%d of %d links); preserving pod alive status", string(cniArgs.K8S_POD_NAME), requestedIntf, len(links), len(localPod.Links))
+	for _, link := range links {
+		linkType := "veth"
+		log.Infof("Del[%s]: kubevirt secondary cleanup retrieving peer pod %s for local interface %s", string(cniArgs.K8S_POD_NAME), link.PeerPod, link.LocalIntf)
+		peerPod, _ := meshnetClient.Get(ctx, &mpb.PodQuery{
+			Name:   link.PeerPod,
+			KubeNs: string(cniArgs.K8S_POD_NAMESPACE),
+		})
+		if peerPod != nil && peerPod.SrcIp != localPod.SrcIp {
+			if interNodeLinkType == wireutil.INTER_NODE_LINK_GRPC {
+				if err := MakeGRPCChanDown(link, localPod, peerPod, ctx); err != nil {
+					log.Errorf("Del[%s]: failed to remove secondary grpc wire for interface %s: %v", string(cniArgs.K8S_POD_NAME), link.LocalIntf, err)
+				}
+				linkType = "grpc"
+			} else {
+				linkType = "vxlan"
+			}
+		}
+
+		myVeth, err := makeVeth(args.Netns, link.LocalIntf, link.LocalIp)
+		if err != nil {
+			log.Errorf("Del[%s]: failed to construct secondary Veth %s in netns %s; continuing best-effort cleanup: %v", string(cniArgs.K8S_POD_NAME), link.LocalIntf, args.Netns, err)
+		} else if err = myVeth.RemoveVethLink(); err != nil {
+			log.Errorf("Del[%s]: error removing secondary link %s (%s) on pod %s: %v", string(cniArgs.K8S_POD_NAME), link.LocalIntf, linkType, localPod.Name, err)
+		}
+
+		ok, err := meshnetClient.SkipReverse(ctx, &mpb.SkipQuery{
+			Pod:    localPod.Name,
+			Peer:   link.PeerPod,
+			LinkId: link.Uid,
+			KubeNs: string(cniArgs.K8S_POD_NAMESPACE),
+		})
+		if err != nil || !ok.Response {
+			log.Errorf("Del[%s]: failed to set secondary skip-reverse flag on peer %s", string(cniArgs.K8S_POD_NAME), link.PeerPod)
+			return err
+		}
+	}
+	return nil
+}
