--- /dev/null
+++ b/daemon/meshnet/crossns_test.go
@@ -0,0 +1,93 @@
+package meshnet
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	topologyv1 "github.com/networkop/meshnet-cni/api/types/v1beta1"
+	mpb "github.com/networkop/meshnet-cni/daemon/proto/meshnet/v1beta1"
+	"github.com/networkop/meshnet-cni/daemon/vxlan"
+	"github.com/networkop/meshnet-cni/utils/wireutil"
+	koko "github.com/redhat-nfvpe/koko/api"
+)
+
+const (
+	labNs     = "user-skyforge-lab-1234abcd"
+	sandboxNs = "sandbox-u1"
+)
+
+func TestSkipEntryNameQualifiesOnlyCrossNamespaceEntries(t *testing.T) {
+	if got := skipEntryName("r1", labNs, labNs); got != "r1" {
+		t.Fatalf("same-namespace entry = %q, want bare r1", got)
+	}
+	if got := skipEntryName("r1", labNs, ""); got != "r1" {
+		t.Fatalf("unset-namespace entry = %q, want bare r1", got)
+	}
+	if got := skipEntryName("r1", labNs, sandboxNs); got != sandboxNs+"/r1" {
+		t.Fatalf("cross-namespace entry = %q", got)
+	}
+}
+
+func TestVerifyUpdateAcceptsADeclaredCrossNamespaceLink(t *testing.T) {
+	const netns = "/var/run/netns/cni-attach"
+	uid := int64(900)
+	attach := topologyv1.Topology{}
+	attach.Name = "sandbox-attach"
+	attach.Namespace = labNs
+	attach.Status.NetNS = netns
+	attach.Spec.Links = []topologyv1.Link{{LocalIntf: "eth9", PeerPod: "tool", PeerNamespace: sandboxNs, UID: int(uid)}}
+	m := &Meshnet{tClient: &fakeTopologyClient{byNS: map[string]*fakeTopologyInterface{
+		labNs: {items: []topologyv1.Topology{attach}},
+	}}}
+
+	// What the sandbox pod's plugin sends: the peer's namespace, and the VNI
+	// from the pair key.
+	vni := int64(wireutil.VxlanID(wireutil.LinkKeyNamespace(sandboxNs, labNs), uid))
+	if err := m.verifyUpdateIsDeclared(nil, &mpb.RemotePod{KubeNs: labNs, NetNs: netns, IntfName: "eth9", Vni: vni}); err != nil {
+		t.Fatalf("declared cross-namespace update refused: %v", err)
+	}
+	// A VNI keyed on one namespace alone is not this link.
+	bad := int64(wireutil.VxlanID(sandboxNs, uid))
+	if err := m.verifyUpdateIsDeclared(nil, &mpb.RemotePod{KubeNs: labNs, NetNs: netns, IntfName: "eth9", Vni: bad}); err == nil {
+		t.Fatalf("update keyed on a single namespace was accepted")
+	}
+}
+
+func TestReconcileFindsACrossNamespacePeerAndBothEndsAgreeOnTheVNI(t *testing.T) {
+	uid := 900
+	sandboxEnd := topo("tool", sandboxNs, "10.0.0.1", nsLocal, "c1",
+		topologyv1.Link{LocalIntf: "eth1", PeerIntf: "eth9", PeerPod: "sandbox-attach", PeerNamespace: labNs, UID: uid})
+	labEnd := topo("sandbox-attach", labNs, "10.0.0.2", "/var/run/netns/cni-remote", "c2",
+		topologyv1.Link{LocalIntf: "eth9", PeerIntf: "eth1", PeerPod: "tool", PeerNamespace: sandboxNs, UID: uid})
+
+	f := &fakeDeps{
+		usableNS:   map[string]bool{nsLocal: true},
+		vxlanState: map[string]vxlan.Health{nsLocal + "/eth1": vxlan.HealthBroken},
+	}
+	runPod(t, f, 1, sandboxEnd, labEnd)
+	if len(f.vxlanRepairs) != 1 {
+		t.Fatalf("repairs = %v: the peer in the other namespace was not found", f.vxlanRepairs)
+	}
+	want := wireutil.VxlanID(wireutil.LinkKeyNamespace(labNs, sandboxNs), int64(uid))
+	if !strings.Contains(f.vxlanRepairs[0], fmt.Sprintf("vni=%d", want)) {
+		t.Fatalf("repair %v did not use the pair-keyed VNI %d the lab end derives", f.vxlanRepairs, want)
+	}
+}
+
+func TestReconcileSameNodeCrossNamespaceAliasMatchesThePlugin(t *testing.T) {
+	uid := 901
+	sandboxEnd := topo("tool", sandboxNs, "10.0.0.1", nsLocal, "c1",
+		topologyv1.Link{LocalIntf: "eth1", PeerIntf: "eth9", PeerPod: "sandbox-attach", PeerNamespace: labNs, UID: uid})
+	labEnd := topo("sandbox-attach", labNs, "10.0.0.1", nsPeer, "c2",
+		topologyv1.Link{LocalIntf: "eth9", PeerIntf: "eth1", PeerPod: "tool", PeerNamespace: sandboxNs, UID: uid})
+	f := &fakeDeps{
+		usableNS:   map[string]bool{nsLocal: true, nsPeer: true},
+		vethHealth: map[string]koko.WireHealth{nsLocal + "/eth1": koko.WireHealthBroken},
+	}
+	runPod(t, f, 1, sandboxEnd, labEnd)
+	want := koko.VethWireAlias(wireutil.LinkKeyNamespace(labNs, sandboxNs), int64(uid))
+	if len(f.vethRepairs) != 1 || !strings.HasSuffix(f.vethRepairs[0], "alias="+want) {
+		t.Fatalf("veth repairs = %v, want one with alias %s", f.vethRepairs, want)
+	}
+}
