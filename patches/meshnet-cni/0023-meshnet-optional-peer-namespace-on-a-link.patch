new file mode 100644
index 0000000..465080e
--- /dev/null
+++ b/utils/wireutil/wire-util_test.go
@@ -0,0 +1,34 @@
+package wireutil
+
+import "testing"
+
+func TestLinkKeyNamespaceLeavesSameNamespaceLinksUnchanged(t *testing.T) {
+	for _, peer := range []string{"", "lab"} {
+		if got := LinkKeyNamespace("lab", peer); got != "lab" {
+			t.Fatalf("LinkKeyNamespace(lab, %q) = %q, want lab: an existing wire's VNI and alias would move", peer, got)
+		}
+	}
+}
+
+func TestLinkKeyNamespaceIsSymmetricAcrossNamespaces(t *testing.T) {
+	a := LinkKeyNamespace("lab", "sandbox-u1")
+	b := LinkKeyNamespace("sandbox-u1", "lab")
+	if a != b {
+		t.Fatalf("ends disagree: %q vs %q", a, b)
+	}
+	if VxlanID(a, 900) != VxlanID(b, 900) {
+		t.Fatalf("ends derive different VNIs")
+	}
+	if a == "lab" || a == "sandbox-u1" {
+		t.Fatalf("cross-namespace key %q collides with a single namespace's key", a)
+	}
+}
+
+func TestPeerNamespaceDefaultsToLocal(t *testing.T) {
+	if got := PeerNamespace("lab", ""); got != "lab" {
+		t.Fatalf("got %q", got)
+	}
+	if got := PeerNamespace("lab", "sandbox-u1"); got != "sandbox-u1" {
+		t.Fatalf("got %q", got)
+	}
+}
