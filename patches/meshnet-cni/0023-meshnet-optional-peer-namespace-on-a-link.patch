index ac5c306..202d91c 100644
--- a/utils/wireutil/wire-util.go
+++ b/utils/wireutil/wire-util.go
@@ -40,6 +40,33 @@ func VxlanID(namespace string, uid int64) int {
 	return VxlanBaseMin + int(h.Sum32()%uint32(VxlanBaseMax-VxlanBaseMin))
 }
 
+// PeerNamespace is the namespace a link's peer Topology lives in: the
+// declared peer namespace, or the local one when none is declared (every
+// link KNE generates).
+func PeerNamespace(localNs, declaredPeerNs string) string {
+	if declaredPeerNs == "" {
+		return localNs
+	}
+	return declaredPeerNs
+}
+
+// LinkKeyNamespace is the namespace string both ends of a link feed into
+// VxlanID and the veth wire alias. For a same-namespace link it is that
+// namespace, so every existing wire keeps its VNI and alias byte-for-byte. A
+// cross-namespace link is declared once in each namespace, and each end only
+// knows its own side, so the key is the ordered pair: both ends derive the
+// same VNI without coordinating.
+func LinkKeyNamespace(localNs, declaredPeerNs string) string {
+	peerNs := PeerNamespace(localNs, declaredPeerNs)
+	if peerNs == localNs {
+		return localNs
+	}
+	if peerNs < localNs {
+		return peerNs + "/" + localNs
+	}
+	return localNs + "/" + peerNs
+}
