+// skipPeerNs is the namespace of a skip query's peer Topology.
+func skipPeerNs(skip *mpb.SkipQuery) string {
+	return wireutil.PeerNamespace(skip.KubeNs, skip.PeerKubeNs)
+}
+
+// skipEntryName is how a skipped-list entry stored in a Topology living in
+// ownerNs names a pod living in subjectNs. Same-namespace entries stay bare
+// pod names (the only form that existed before cross-namespace links); a
+// cross-namespace entry is "ns/pod" so a same-named pod in the owner's own
+// namespace can never satisfy it.
+func skipEntryName(subject, ownerNs, subjectNs string) string {
+	if subjectNs == "" || subjectNs == ownerNs {
+		return subject
+	}
+	return subjectNs + "/" + subject
+}
+
 // keepSkippedEntry reports whether a skipped-list entry survives removal of
 // the (peer, linkId) tuple. An entry is removed only when BOTH fields match.
 // The historical condition (entryPod != peer && entryLink != linkId) dropped
