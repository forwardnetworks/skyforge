 package wireutil
 
 import (
+	"encoding/binary"
 	"fmt"
+	"hash/fnv"
 
 	"github.com/containernetworking/plugins/pkg/ns"
 	"github.com/safchain/ethtool"
@@ -11,8 +13,33 @@ const (
 	GRPCDefaultPort       = 51111
 	INTER_NODE_LINK_VXLAN = "VXLAN"
 	INTER_NODE_LINK_GRPC  = "GRPC"
+
+	// VxlanBaseMin / VxlanBaseMax bound the VNI space 0006 hashes into.
+	VxlanBaseMin = 4096
+	VxlanBaseMax = 1<<24 - 1
 )
 
+// VxlanID returns the deterministic, topology-scoped VNI for one link.
+//
+// THIS MUST HAVE EXACTLY ONE DEFINITION. 0006 made the VNI a pure function of
+// (topology namespace, link uid) so that both ends of a wire, and every
+// kubelet retry, compute the same value. That property only holds while there
+// is one implementation: the CNI plugin picks the VNI on ADD, the daemon must
+// derive the SAME one when it reconciles a wire nobody is currently adding,
+// and a second copy that drifted by a byte would put the two ends on
+// different VNIs -- a fabric that is up from every angle except traffic.
+// plugin/meshnet.go's makeVxlanID is a thin wrapper over this.
+func VxlanID(namespace string, uid int64) int {
+	h := fnv.New32a()
+	_, _ = h.Write([]byte(namespace))
+	_, _ = h.Write([]byte{0})
+	var uidBytes [8]byte
+	binary.LittleEndian.PutUint64(uidBytes[:], uint64(uid))
+	_, _ = h.Write(uidBytes[:])
+
+	return VxlanBaseMin + int(h.Sum32()%uint32(VxlanBaseMax-VxlanBaseMin))
+}
