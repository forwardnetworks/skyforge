diff --git a/daemon/vxlan/inspect.go b/daemon/vxlan/inspect.go
new file mode 100644
index 0000000..fb187fd
--- /dev/null
+++ b/daemon/vxlan/inspect.go
@@ -0,0 +1,101 @@
+package vxlan
+
+import (
+	"fmt"
+	"net"
+	"strings"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+)
+
+// Health is the read-only verdict about one vxlan wire end.
+//
+// CreateOrUpdate answers "make this end correct" and is free to delete and
+// rebuild whatever it finds. A reconciler must first answer "IS it correct?",
+// and its default has to be the opposite one: against a live lab, tearing
+// down a wire whose state could not be established is worse than the fault
+// being looked for. So HealthBroken requires positive evidence and everything
+// unproven is HealthUnknown, which the caller must not act on.
+type Health int
+
+const (
+	// HealthUnknown: the wire's state could NOT be established. Not broken.
+	HealthUnknown Health = iota
+	// HealthOK: a vxlan with the desired VNI and remote VTEP occupies the slot.
+	HealthOK
+	// HealthBroken: positive evidence -- the slot is empty, or holds a vxlan
+	// programmed for a different VNI or a different remote VTEP.
+	HealthBroken
+)
+
+func (h Health) String() string {
+	switch h {
+	case HealthUnknown:
+		return "unknown"
+	case HealthOK:
+		return "ok"
+	case HealthBroken:
+		return "broken"
+	}
+	return "invalid"
+}
+
+// classifyLink is the pure decision core of Inspect: given whatever occupies
+// the slot (nil when nothing does), say whether the desired wire is realized.
+//
+// found == nil is BROKEN and not UNKNOWN only because Inspect has already
+// established that the namespace is enterable -- an absent link in a
+// namespace we could enter is a fact, an absent link in a namespace we could
+// not enter is nothing at all.
+//
+// An occupant that is not a vxlan is UNKNOWN, deliberately. CreateOrUpdate
+// deletes such an occupant because a CNI ADD owns the name outright; a
+// reconciler does not know why a veth (or a KubeVirt tap) is sitting there
+// and must say so rather than guess.
+func classifyLink(found netlink.Link, wantVNI int, wantVTEP net.IP) (Health, string) {
+	if found == nil {
+		return HealthBroken, "no link occupies the slot"
+	}
+	existing, ok := found.(*netlink.Vxlan)
+	if !ok {
+		return HealthUnknown, fmt.Sprintf("slot is occupied by a %T, not a vxlan", found)
+	}
+	if existing.VxlanId != wantVNI {
+		return HealthBroken, fmt.Sprintf("vxlan has VNI %d, want %d", existing.VxlanId, wantVNI)
+	}
+	if !existing.Group.Equal(wantVTEP) {
+		return HealthBroken, fmt.Sprintf("vxlan points at remote VTEP %s, want %s", existing.Group, wantVTEP)
+	}
+	return HealthOK, fmt.Sprintf("vxlan vni=%d remote=%s is realized", wantVNI, wantVTEP)
+}
+
+// Inspect reports the health of ONE end of a cross-node wire -- the end that
+// lives in nsName -- without modifying anything.
+//
+// It looks for the KubeVirt bridge-binding form of the name as well
+// (0013/0014): virt-launcher renames "podXXXX" to "XXXX-nic" and enslaves it,
+// so the original name being absent is emphatically not evidence the wire is
+// gone.
+//
+// A namespace that cannot be entered yields HealthUnknown: the sandbox is
+// going away or has not been created, and neither says anything about the
+// wire.
+func Inspect(nsName, linkName string, wantVNI int, wantVTEP net.IP) (Health, string) {
+	if strings.TrimSpace(nsName) == "" {
+		return HealthUnknown, "no network namespace recorded for the pod"
+	}
+	netNS, err := ns.GetNS(nsName)
+	if err != nil {
+		return HealthUnknown, fmt.Sprintf("network namespace %s is not usable: %v", nsName, err)
+	}
+	_ = netNS.Close()
+
+	found := getLinkFromNS(nsName, linkName)
+	if found == nil {
+		if renamed := kubevirtRenamedLink(nsName, linkName); renamed != nil {
+			found = renamed
+		}
+	}
+	return classifyLink(found, wantVNI, wantVTEP)
+}
diff --git a/daemon/vxlan/inspect_test.go b/daemon/vxlan/inspect_test.go
new file mode 100644
index 0000000..96d5836
--- /dev/null
+++ b/daemon/vxlan/inspect_test.go
@@ -0,0 +1,73 @@
+package vxlan
+
+import (
+	"net"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+func vxlanLink(name string, vni int, group string) netlink.Link {
+	return &netlink.Vxlan{
+		LinkAttrs: netlink.LinkAttrs{Name: name},
+		VxlanId:   vni,
+		Group:     net.ParseIP(group),
+	}
+}
+
+// TestClassifyLink pins the evidence rules the reconciler is allowed to act
+// on. The rows that matter most are the two UNKNOWN ones: a reconciler that
+// treated either as broken would delete a wire it does not understand.
+func TestClassifyLink(t *testing.T) {
+	want := net.ParseIP("10.10.0.7")
+	cases := []struct {
+		name   string
+		found  netlink.Link
+		health Health
+	}{
+		{"desired vxlan is healthy", vxlanLink("eth1", 4242, "10.10.0.7"), HealthOK},
+		{"empty slot is broken", nil, HealthBroken},
+		{"wrong VNI is broken", vxlanLink("eth1", 9999, "10.10.0.7"), HealthBroken},
+		{"stale remote VTEP is broken (the peer moved)", vxlanLink("eth1", 4242, "10.10.0.9"), HealthBroken},
+		{"a veth in the slot is unknown, not broken",
+			&netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: "eth1"}}, HealthUnknown},
+		{"a bridge in the slot is unknown, not broken",
+			&netlink.Bridge{LinkAttrs: netlink.LinkAttrs{Name: "eth1"}}, HealthUnknown},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, reason := classifyLink(tc.found, 4242, want)
+			if got != tc.health {
+				t.Fatalf("classifyLink() = %v (%s), want %v", got, reason, tc.health)
+			}
+			if reason == "" {
+				t.Fatal("every verdict must name its evidence")
+			}
+		})
+	}
+}
+
+// TestInspectTreatsAnUnusableNamespaceAsUnknown is the guard on the ONE
+// precondition classifyLink's "nil means broken" rule depends on. Without it,
+// every pod whose sandbox had gone away would read as a lab full of dead
+// wires and the reconciler would try to rebuild all of them.
+func TestInspectTreatsAnUnusableNamespaceAsUnknown(t *testing.T) {
+	InitLogger()
+	for _, nsName := range []string{"", "   ", "/var/run/netns/absent-0015"} {
+		got, reason := Inspect(nsName, "eth1", 4242, net.ParseIP("10.10.0.7"))
+		if got != HealthUnknown {
+			t.Fatalf("Inspect(%q) = %v (%s), want unknown", nsName, got, reason)
+		}
+	}
+}
+
+func TestHealthStringsAreDistinct(t *testing.T) {
+	seen := map[string]bool{}
+	for _, h := range []Health{HealthUnknown, HealthOK, HealthBroken} {
+		s := h.String()
+		if s == "" || s == "invalid" || seen[s] {
+			t.Fatalf("Health(%d).String() = %q is empty or not distinct", h, s)
+		}
+		seen[s] = true
+	}
+}
