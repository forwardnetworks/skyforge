 }
 
 // -------------------------------------------------------------------------------------------------
+// Creates a deterministic topology-scoped VNI so active topologies do not
+// collide just because they reuse the same low link UID values.
+func makeVxlanID(namespace string, idx int64) int {
+	h := fnv.New32a()
+	_, _ = h.Write([]byte(namespace))
+	_, _ = h.Write([]byte{0})
+	var uidBytes [8]byte
+	binary.LittleEndian.PutUint64(uidBytes[:], uint64(idx))
+	_, _ = h.Write(uidBytes[:])
+
+	return vxlanBaseMin + int(h.Sum32()%uint32(vxlanBaseMax-vxlanBaseMin))
+}
