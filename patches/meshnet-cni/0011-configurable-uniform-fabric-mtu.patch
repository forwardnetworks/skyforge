diff --git a/daemon/cni/cni.go b/daemon/cni/cni.go
index 79b3645..a022269 100644
--- a/daemon/cni/cni.go
+++ b/daemon/cni/cni.go
@@ -8,11 +8,11 @@ import (
 	"os"
 	"path/filepath"
 	"sort"
+	"strconv"
 	"strings"
 	"time"
 
 	"github.com/containernetworking/cni/libcni"
-	"github.com/containernetworking/cni/pkg/types"
 	log "github.com/sirupsen/logrus"
 )
 
@@ -120,9 +120,14 @@ func Init() error {
 	// We can safely access and type-cast since all of the checks have already been done in the `loadConfList()`
 	plugins := conf["plugins"].([]interface{})
 
-	plugins = append(plugins, &types.NetConf{
-		Type: defaultPluginName,
-		Name: defaultPluginName,
+	fabricMTU, err := fabricMTUFromEnv()
+	if err != nil {
+		return err
+	}
+	plugins = append(plugins, map[string]interface{}{
+		"type":      defaultPluginName,
+		"name":      defaultPluginName,
+		"fabricMTU": fabricMTU,
 	})
 
 	conf["cniVersion"] = "0.3.0"
@@ -136,6 +141,18 @@ func Init() error {
 	return saveConfList(conf)
 }
 
+func fabricMTUFromEnv() (int, error) {
+	raw := strings.TrimSpace(os.Getenv("MESHNET_FABRIC_MTU"))
+	if raw == "" {
+		return 1450, nil
+	}
+	mtu, err := strconv.Atoi(raw)
+	if err != nil || mtu < 1280 || mtu > 65535 {
+		return 0, fmt.Errorf("MESHNET_FABRIC_MTU must be an integer in [1280,65535], got %q", raw)
+	}
+	return mtu, nil
+}
+
 // InitOrWaitForBaseConfig installs the meshnet CNI configuration, waiting for
 // a base (non-meshnet) CNI config to show up in /etc/cni/net.d first. At node
 // boot meshnetd races the primary CNI's conflist write; failing hard here
diff --git a/daemon/cni/cni_mtu_test.go b/daemon/cni/cni_mtu_test.go
new file mode 100644
index 0000000..8854242
--- /dev/null
+++ b/daemon/cni/cni_mtu_test.go
@@ -0,0 +1,18 @@
+package cni
+
+import "testing"
+
+func TestFabricMTUFromEnv(t *testing.T) {
+	t.Setenv("MESHNET_FABRIC_MTU", "")
+	if got, err := fabricMTUFromEnv(); err != nil || got != 1450 {
+		t.Fatalf("default = %d,%v, want 1450,nil", got, err)
+	}
+	t.Setenv("MESHNET_FABRIC_MTU", "8950")
+	if got, err := fabricMTUFromEnv(); err != nil || got != 8950 {
+		t.Fatalf("jumbo = %d,%v, want 8950,nil", got, err)
+	}
+	t.Setenv("MESHNET_FABRIC_MTU", "invalid")
+	if _, err := fabricMTUFromEnv(); err == nil {
+		t.Fatal("invalid MTU accepted")
+	}
+}
