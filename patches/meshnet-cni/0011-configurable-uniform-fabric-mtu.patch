diff --git a/plugin/meshnet_test.go b/plugin/meshnet_test.go
index a149d43..dd87714 100644
--- a/plugin/meshnet_test.go
+++ b/plugin/meshnet_test.go
@@ -1,6 +1,7 @@
 package main
 
 import (
+	"encoding/json"
 	"testing"
 	"time"
 
@@ -8,6 +9,25 @@ import (
 	mpb "github.com/networkop/meshnet-cni/daemon/proto/meshnet/v1beta1"
 )
 
+func TestLoadConfFabricMTUDefaultAndJumbo(t *testing.T) {
+	base := map[string]interface{}{"cniVersion": "0.3.0", "name": "meshnet", "type": "meshnet"}
+	data, _ := json.Marshal(base)
+	conf, _, err := loadConf(data)
+	if err != nil || conf.FabricMTU != 1450 {
+		t.Fatalf("default fabric MTU = %d,%v, want 1450,nil", conf.FabricMTU, err)
+	}
+	base["fabricMTU"] = 8950
+	data, _ = json.Marshal(base)
+	conf, _, err = loadConf(data)
+	if err != nil || conf.FabricMTU != 8950 {
+		t.Fatalf("jumbo fabric MTU = %d,%v, want 8950,nil", conf.FabricMTU, err)
+	}
+	vxlan := makeVxlan("bond0", "192.0.2.1", 4096, conf.FabricMTU)
+	if vxlan.MTU != 8950 {
+		t.Fatalf("VXLAN MTU = %d, want 8950", vxlan.MTU)
+	}
+}
