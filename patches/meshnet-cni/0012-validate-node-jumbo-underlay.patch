 2 files changed, 105 insertions(+), 3 deletions(-)

diff --git a/daemon/meshnet/handler.go b/daemon/meshnet/handler.go
index a88cc58..38d0a26 100644
--- a/daemon/meshnet/handler.go
+++ b/daemon/meshnet/handler.go
@@ -5,6 +5,7 @@ import (
 	"fmt"
 	"net"
 	"os"
+	"strconv"
 	"strings"
 
 	"github.com/networkop/meshnet-cni/api/types/v1beta1"
@@ -21,6 +22,13 @@ import (
 	mpb "github.com/networkop/meshnet-cni/daemon/proto/meshnet/v1beta1"
 )
 
+const (
+	defaultFabricMTU       = 1450
+	vxlanIPv4Overhead      = 50
+	fabricMTULabel         = "skyforge.example.com/meshnet-fabric-mtu"
+	underlayInterfaceLabel = "skyforge.example.com/meshnet-underlay-interface"
+)
+
 func ipv4FromAddr(addr net.Addr) net.IP {
 	var ip net.IP
 	switch v := addr.(type) {
@@ -74,6 +82,67 @@ func nodeSource(nodeIP, nodeIntf string) (string, string) {
 	return srcIP, nodeIntf
 }
 
+// declaredUnderlayContract returns the host interface and minimum interface
+// MTU required by a node's advertised meshnet fabric capability. An unlabeled
+// node remains on the legacy HOST_INTF/HOST_IP path. A labeled node fails
+// closed unless the declaration is jumbo and complete.
+func declaredUnderlayContract(labels map[string]string, configuredMTU int) (string, int, bool, error) {
+	rawMTU := strings.TrimSpace(labels[fabricMTULabel])
+	if rawMTU == "" {
+		return "", 0, false, nil
+	}
+	declaredMTU, err := strconv.Atoi(rawMTU)
+	if err != nil || declaredMTU <= defaultFabricMTU {
+		return "", 0, true, fmt.Errorf("node label %s=%q is not a jumbo fabric MTU greater than %d", fabricMTULabel, rawMTU, defaultFabricMTU)
+	}
+	if declaredMTU < configuredMTU {
+		return "", 0, true, fmt.Errorf("node advertises meshnet fabric MTU %d below configured MTU %d", declaredMTU, configuredMTU)
+	}
+
+	nodeIntf := strings.TrimSpace(labels[underlayInterfaceLabel])
+	if nodeIntf == "" {
+		return "", 0, true, fmt.Errorf("node advertising %s=%d must also set %s", fabricMTULabel, declaredMTU, underlayInterfaceLabel)
+	}
+	return nodeIntf, declaredMTU + vxlanIPv4Overhead, true, nil
+}
+
+func (m *Meshnet) nodeSourceForCurrentNode(ctx context.Context) (string, string, error) {
+	nodeIP := os.Getenv("HOST_IP")
+	legacyIntf := os.Getenv("HOST_INTF")
+	nodeName := strings.TrimSpace(os.Getenv("NODE_NAME"))
+	if nodeName == "" || m == nil || m.kClient == nil {
+		nodeIP, legacyIntf = nodeSource(nodeIP, legacyIntf)
+		return nodeIP, legacyIntf, nil
+	}
+
+	node, err := m.kClient.CoreV1().Nodes().Get(ctx, nodeName, metav1.GetOptions{})
+	if err != nil {
+		return "", "", fmt.Errorf("read meshnet underlay declaration for node %q: %w", nodeName, err)
+	}
+	nodeIntf, requiredMTU, advertised, err := declaredUnderlayContract(node.Labels, envInt("MESHNET_FABRIC_MTU", defaultFabricMTU))
+	if err != nil {
+		return "", "", fmt.Errorf("node %q meshnet underlay contract: %w", nodeName, err)
+	}
+	if !advertised {
+		nodeIP, legacyIntf = nodeSource(nodeIP, legacyIntf)
+		return nodeIP, legacyIntf, nil
+	}
+
+	iface, err := net.InterfaceByName(nodeIntf)
+	if err != nil {
+		return "", "", fmt.Errorf("node %q advertised meshnet underlay interface %q: %w", nodeName, nodeIntf, err)
+	}
+	if iface.MTU < requiredMTU {
+		return "", "", fmt.Errorf("node %q advertised meshnet underlay interface %q has MTU %d, need at least %d", nodeName, nodeIntf, iface.MTU, requiredMTU)
+	}
+	sourceIP, err := nodeSourceFromInterface(nodeIntf)
+	if err != nil {
+		return "", "", fmt.Errorf("node %q advertised meshnet underlay interface %q: %w", nodeName, nodeIntf, err)
+	}
+	mnetdLogger.Infof("Using declared meshnet underlay for node %s: interface=%s source_ip=%s fabric_mtu=%d", nodeName, nodeIntf, sourceIP, requiredMTU-vxlanIPv4Overhead)
+	return sourceIP, nodeIntf, nil
+}
+
 func (m *Meshnet) getPod(ctx context.Context, name, ns string) (*unstructured.Unstructured, error) {
 	mnetdLogger.Infof("Reading pod %s from K8s", name)
 	result, err := m.tClient.Topology(ns).Unstructured(ctx, name, metav1.GetOptions{})
@@ -144,9 +213,11 @@ func (m *Meshnet) Get(ctx context.Context, pod *mpb.PodQuery) (*mpb.Pod, error)
 	srcIP, _, _ := unstructured.NestedString(result.Object, "status", "src_ip")
 	netNs, _, _ := unstructured.NestedString(result.Object, "status", "net_ns")
 	containerId, _, _ := unstructured.NestedString(result.Object, "status", "container_id")
-	nodeIP := os.Getenv("HOST_IP")
-	nodeIntf := os.Getenv("HOST_INTF")
-	nodeIP, nodeIntf = nodeSource(nodeIP, nodeIntf)
+	nodeIP, nodeIntf, err := m.nodeSourceForCurrentNode(ctx)
+	if err != nil {
+		mnetdLogger.Errorf("Failed to resolve meshnet node underlay: %v", err)
+		return nil, err
+	}
 
 	return &mpb.Pod{
 		Name:        result.GetName(),
diff --git a/daemon/meshnet/handler_test.go b/daemon/meshnet/handler_test.go
index df03a29..7853053 100644
--- a/daemon/meshnet/handler_test.go
+++ b/daemon/meshnet/handler_test.go
@@ -2,6 +2,37 @@ package meshnet
 
 import "testing"
 
+func TestDeclaredUnderlayContract(t *testing.T) {
+	tests := []struct {
+		name       string
+		labels     map[string]string
+		configured int
+		wantIntf   string
+		wantMTU    int
+		advertised bool
+		wantErr    bool
+	}{
+		{name: "unlabeled legacy node", labels: map[string]string{}, configured: 1450},
+		{name: "jumbo declaration", labels: map[string]string{fabricMTULabel: "8950", underlayInterfaceLabel: "bond0"}, configured: 8950, wantIntf: "bond0", wantMTU: 9000, advertised: true},
+		{name: "validated jumbo node during safe default stage", labels: map[string]string{fabricMTULabel: "8950", underlayInterfaceLabel: "ens192"}, configured: 1450, wantIntf: "ens192", wantMTU: 9000, advertised: true},
+		{name: "1450 is not a jumbo advertisement", labels: map[string]string{fabricMTULabel: "1450", underlayInterfaceLabel: "bond0"}, configured: 1450, advertised: true, wantErr: true},
+		{name: "missing interface", labels: map[string]string{fabricMTULabel: "8950"}, configured: 8950, advertised: true, wantErr: true},
+		{name: "advertisement below configured", labels: map[string]string{fabricMTULabel: "8950", underlayInterfaceLabel: "bond0"}, configured: 9166, advertised: true, wantErr: true},
+		{name: "invalid MTU", labels: map[string]string{fabricMTULabel: "jumbo", underlayInterfaceLabel: "bond0"}, configured: 8950, advertised: true, wantErr: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			gotIntf, gotMTU, gotAdvertised, err := declaredUnderlayContract(tc.labels, tc.configured)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("declaredUnderlayContract() error = %v, wantErr %t", err, tc.wantErr)
+			}
+			if gotIntf != tc.wantIntf || gotMTU != tc.wantMTU || gotAdvertised != tc.advertised {
+				t.Fatalf("declaredUnderlayContract() = (%q, %d, %t), want (%q, %d, %t)", gotIntf, gotMTU, gotAdvertised, tc.wantIntf, tc.wantMTU, tc.advertised)
+			}
+		})
+	}
+}
+
 // TestKeepSkippedEntryRemovesOnlyExactTuple is the regression test for the
 // SkipReverse filter: an entry leaves the pod's own skipped list only when
 // BOTH the peer name AND the link id match the tuple being cleared.
