diff --git a/plugin/meshnet_damping_test.go b/plugin/meshnet_damping_test.go
new file mode 100644
index 0000000..056a943
--- /dev/null
+++ b/plugin/meshnet_damping_test.go
@@ -0,0 +1,33 @@
+package main
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	koko "github.com/redhat-nfvpe/koko/api"
+)
+
+func TestPeerNotReadyClassifiesPeerNamespaceOnly(t *testing.T) {
+	peerNS := "/var/run/netns/cni-peer"
+	localNS := "/var/run/netns/cni-local"
+
+	peerGone := fmt.Errorf("ensure failed: %w",
+		&koko.NamespaceGoneError{NsName: peerNS, Err: errors.New("no such file or directory")})
+	if !peerNotReady(peerGone, peerNS) {
+		t.Fatal("vanished PEER namespace must classify as peer-not-ready")
+	}
+
+	localGone := fmt.Errorf("ensure failed: %w",
+		&koko.NamespaceGoneError{NsName: localNS, Err: errors.New("no such file or directory")})
+	if peerNotReady(localGone, peerNS) {
+		t.Fatal("vanished LOCAL namespace must NOT classify as peer-not-ready")
+	}
+
+	if peerNotReady(errors.New("file exists"), peerNS) {
+		t.Fatal("generic errors must not classify as peer-not-ready")
+	}
+	if peerNotReady(peerGone, "") {
+		t.Fatal("empty peer netns must not classify as peer-not-ready")
+	}
+}
