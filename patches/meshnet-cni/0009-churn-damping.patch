--- /dev/null
+++ b/daemon/meshnet/handler_test.go
@@ -0,0 +1,30 @@
+package meshnet
+
+import "testing"
+
+// TestKeepSkippedEntryRemovesOnlyExactTuple is the regression test for the
+// SkipReverse filter: an entry leaves the pod's own skipped list only when
+// BOTH the peer name AND the link id match the tuple being cleared.
+func TestKeepSkippedEntryRemovesOnlyExactTuple(t *testing.T) {
+	cases := []struct {
+		name      string
+		entryPod  string
+		entryLink int64
+		peer      string
+		linkID    int64
+		keep      bool
+	}{
+		{"exact match is removed", "br1", 4, "br1", 4, false},
+		{"same peer different link survives", "br1", 5, "br1", 4, true},
+		{"different peer same link survives", "br2", 4, "br1", 4, true},
+		{"unrelated entry survives", "br2", 9, "br1", 4, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := keepSkippedEntry(tc.entryPod, tc.entryLink, tc.peer, tc.linkID); got != tc.keep {
+				t.Fatalf("keepSkippedEntry(%q,%d,%q,%d) = %t, want %t",
+					tc.entryPod, tc.entryLink, tc.peer, tc.linkID, got, tc.keep)
+			}
+		})
+	}
+}
