+// peerNotReady reports whether err means the PEER pod's network namespace
+// vanished (its sandbox is being torn down or recreated). That is a normal
+// transient during churn: the link is parked exactly like the
+// peer-not-alive case and the peer completes the wire on its own next ADD,
+// instead of this pod failing its whole ADD and feeding the teardown loop.
+// A vanished LOCAL namespace is NOT peer-not-ready: our own sandbox is bad
+// and the ADD must fail so kubelet replaces it.
+func peerNotReady(err error, peerNetNS string) bool {
+	var nsErr *koko.NamespaceGoneError
+	if !errors.As(err, &nsErr) {
+		return false
+	}
+	return strings.TrimSpace(peerNetNS) != "" && nsErr.NsName == peerNetNS
+}
+
 // rollbackCreatedLinks removes the local ends of fabric links realized by a
 // failed CNI ADD so the next attempt starts from a clean slate. Only
 // local-namespace ends are recorded by cmdAdd: removing one veth end removes
@@ -475,6 +491,11 @@ func cmdAdd(args *skel.CmdArgs) (retErr error) {
 		return err
 	}
 	log.Infof("Add[%s]: Starting to traverse %d of %d links for CNI interface %q", string(cniArgs.K8S_POD_NAME), len(links), len(localPod.Links), requestedIntf)
+	// Genuine same-node wiring failures are collected per link instead of
+	// aborting at the first one, so one bad link does not hide the state of
+	// the rest; infrastructure failures (daemon RPCs, vxlan/grpc wiring)
+	// still fail fast.
+	var linkErrs []error
 	for _, link := range links { // Iterate over each link of the local pod
 		// Build koko's veth struct for local intf
 		myVeth, err := makeVeth(args.Netns, link.LocalIntf, link.LocalIp)
@@ -544,8 +565,31 @@ func cmdAdd(args *skel.CmdArgs) (retErr error) {
 				// fatal to the entire multi-link ADD.
 				alias := koko.VethWireAlias(string(cniArgs.K8S_POD_NAMESPACE), link.Uid)
 				if err := koko.EnsureVethWire(*myVeth, *peerVeth, alias); err != nil {
+					if peerNotReady(err, peerPod.NetNs) {
+						// The peer's sandbox vanished mid-wire (it is being
+						// recreated). Park this link like the peer-not-alive
+						// case: set the skip flag and move on; the peer
+						// completes the wire on its own next ADD.
+						log.Warnf("Add[%s]: parking link %s (link id %d): peer pod %s not ready: %v", string(cniArgs.K8S_POD_NAME), link.LocalIntf, link.Uid, peerPod.Name, err)
+						ok, serr := meshnetClient.Skip(ctx, &mpb.SkipQuery{
+							Pod:    localPod.Name,
+							Peer:   peerPod.Name,
+							LinkId: link.Uid,
+							KubeNs: string(cniArgs.K8S_POD_NAMESPACE),
+						})
+						if serr != nil {
+							log.Errorf("Add[%s]: Failed to set a skipped flag on peer %s: %v", string(cniArgs.K8S_POD_NAME), peerPod.Name, serr)
+							return serr
+						}
+						if !ok.Response {
+							log.Errorf("Add[%s]: Failed to set a skipped flag on peer %s", string(cniArgs.K8S_POD_NAME), peerPod.Name)
+							return fmt.Errorf("could not set skipped flag on peer %s for link %d", peerPod.Name, link.Uid)
+						}
+						continue
+					}
 					log.Errorf("Add[%s]: Error ensuring VEth wire %s (link id %d) with koko: %s", string(cniArgs.K8S_POD_NAME), link.LocalIntf, link.Uid, err)
-					return err
+					linkErrs = append(linkErrs, fmt.Errorf("link %d (%s): %w", link.Uid, link.LocalIntf, err))
+					continue
 				}
 				// Record only the local end for rollback: removing it removes
 				// the pair, and this sandbox is abandoned on ADD failure
@@ -624,6 +668,10 @@ func cmdAdd(args *skel.CmdArgs) (retErr error) {
 		}
 	}
 
