diff --git a/daemon/grpcwire/grpcwire.go b/daemon/grpcwire/grpcwire.go
index 45de3cc..9cf93c6 100644
--- a/daemon/grpcwire/grpcwire.go
+++ b/daemon/grpcwire/grpcwire.go
@@ -214,11 +214,13 @@ func DeleteWire(wire *GRPCWire) int {
 // This function clear up the in-memory data base as well as the K8S Datastore.
 func DeletePodWires(namespace string, podName string) error {
 	var errs errlist.List
+	removed := 0
 	for {
 		aW, _ := ExtractOneWireByPod(namespace, podName)
 		if aW == nil {
 			break
 		}
+		removed++
 
 		// Since this wire is already extracted, so it no more preset in in-memory-map. Next we need to clear only the K8S data store.
 		if err := RemoveWireAcrosAll(aW, false); err != nil {
@@ -231,7 +233,14 @@ func DeletePodWires(namespace string, podName string) error {
 	if errs.Err() != nil {
 		return fmt.Errorf("[WIRE-DELETE]:failed to remove all grpc-wires for pod %s@%s: %w", podName, namespace, errs.Err())
 	}
-	grpcOvrlyLogger.Infof("[WIRE-DELETE]:All grpc-wires for pod %s:%s is deleted", namespace, podName)
+	if removed > 0 {
+		grpcOvrlyLogger.Infof("[WIRE-DELETE]:All %d grpc-wires for pod %s:%s are deleted", removed, namespace, podName)
+	} else {
+		// Pods without grpc wires (same-node links, VXLAN mode) hit this on
+		// every CNI DEL; an Info line here reads like overlay churn during
+		// sandbox retry loops, so keep the no-op case quiet.
+		grpcOvrlyLogger.Debugf("[WIRE-DELETE]:No grpc-wires to delete for pod %s:%s", namespace, podName)
+	}
 	return nil
 }
 
diff --git a/daemon/meshnet/handler.go b/daemon/meshnet/handler.go
index 9e6295e..a88cc58 100644
--- a/daemon/meshnet/handler.go
+++ b/daemon/meshnet/handler.go
@@ -243,6 +243,15 @@ func (m *Meshnet) Skip(ctx context.Context, skip *mpb.SkipQuery) (*mpb.BoolRespo
 	return &mpb.BoolResponse{Response: true}, nil
 }
 
+// keepSkippedEntry reports whether a skipped-list entry survives removal of
+// the (peer, linkId) tuple. An entry is removed only when BOTH fields match.
+// The historical condition (entryPod != peer && entryLink != linkId) dropped
+// every entry sharing EITHER the pod name OR the link id, silently wiping
+// unrelated skip state for multi-link peers.
+func keepSkippedEntry(entryPod string, entryLink int64, peer string, linkID int64) bool {
+	return entryPod != peer || entryLink != linkID
+}
+
 // Clean up function SkipReverse is called when a pod is getting deleted. It gets called once for every link the pod has.
 // Anytime a pod is destroyed, for a link, it inserts itself along with its link-id in the skip list of its' peers on the link.
 // It removes the the peer (and connecting link UID) from its own skip list.
@@ -358,7 +367,7 @@ func (m *Meshnet) SkipReverse(ctx context.Context, skip *mpb.SkipQuery) (*mpb.Bo
 				mnetdLogger.Errorf("skipReverse : unable to retrieve Skipped: %v", err)
 				continue
 			}
-			if skipped.PodName != skip.Peer && skipped.LinkId != skip.LinkId {
+			if keepSkippedEntry(skipped.PodName, skipped.LinkId, skip.Peer, skip.LinkId) {
 				mnetdLogger.Infof("Appending new element %s@%d", skipped.PodName, skipped.LinkId)
 				newThisSkipped = append(newThisSkipped, elSkipped)
 			}
diff --git a/daemon/meshnet/handler_test.go b/daemon/meshnet/handler_test.go
new file mode 100644
