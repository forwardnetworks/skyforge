+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	koko "github.com/redhat-nfvpe/koko/api"
+
+	mpb "github.com/networkop/meshnet-cni/daemon/proto/meshnet/v1beta1"
+)
+
+func testLinks(n int) []*mpb.Link {
+	links := make([]*mpb.Link, n)
+	for i := range links {
+		links[i] = &mpb.Link{LocalIntf: fmt.Sprintf("eth%d", i+1), Uid: int64(i + 1)}
+	}
+	return links
+}
+
+// TestRunLinksKeepsOutcomeOrder: rollback order and the "realized N of M"
+// message both depend on outcomes lining up with links, and completion order
+// under concurrency does not.
+func TestRunLinksKeepsOutcomeOrder(t *testing.T) {
+	links := testLinks(8)
+	outcomes := runLinks(context.Background(), links, 4, func(ctx context.Context, link *mpb.Link) linkOutcome {
+		// Finish in reverse order of submission.
+		time.Sleep(time.Duration(10-link.Uid) * 2 * time.Millisecond)
+		return linkOutcome{created: &koko.VEth{LinkName: link.LocalIntf}}
+	})
+	if len(outcomes) != len(links) {
+		t.Fatalf("got %d outcomes for %d links", len(outcomes), len(links))
+	}
+	for i, o := range outcomes {
+		if o.created == nil || o.created.LinkName != links[i].LocalIntf {
+			t.Fatalf("outcome %d = %#v, want the outcome of %s", i, o.created, links[i].LocalIntf)
+		}
+	}
+}
+
+// TestRunLinksBoundsConcurrency is the POSITIVE CONTROL for the whole change:
+// it proves links overlap at all (limit 4 must reach 4 in flight) AND that the
+// bound is respected (never more than 4). With the old serial loop the peak
+// would be 1, and an unbounded fan-out would reach 12.
+func TestRunLinksBoundsConcurrency(t *testing.T) {
+	const total, limit = 12, 4
+	var inFlight, peak int64
+	var mu sync.Mutex
+	release := make(chan struct{})
+	entered := make(chan struct{}, total)
+
+	done := make(chan []linkOutcome, 1)
+	go func() {
+		done <- runLinks(context.Background(), testLinks(total), limit, func(ctx context.Context, link *mpb.Link) linkOutcome {
+			cur := atomic.AddInt64(&inFlight, 1)
+			mu.Lock()
+			if cur > peak {
+				peak = cur
+			}
+			mu.Unlock()
+			entered <- struct{}{}
+			<-release
+			atomic.AddInt64(&inFlight, -1)
+			return linkOutcome{}
+		})
+	}()
+
+	for i := 0; i < limit; i++ {
+		select {
+		case <-entered:
+		case <-time.After(5 * time.Second):
+			close(release)
+			t.Fatalf("only %d of %d links started; the phase is not running them concurrently", i, limit)
+		}
+	}
+	// Give an unbounded implementation every chance to overshoot: nothing has
+	// been released yet, so any worker beyond the limit that starts anyway
+	// lands in `entered` and is still there after this grace period.
+	time.Sleep(300 * time.Millisecond)
+	if extra := len(entered); extra != 0 {
+		close(release)
+		t.Fatalf("%d links started beyond the limit of %d: the bound is not enforced", extra, limit)
+	}
+	if got := atomic.LoadInt64(&inFlight); got != limit {
+		close(release)
+		t.Fatalf("%d links in flight, want exactly the limit %d", got, limit)
+	}
+	close(release)
+
+	select {
+	case outcomes := <-done:
+		if len(outcomes) != total {
+			t.Fatalf("got %d outcomes, want %d", len(outcomes), total)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("runLinks did not finish")
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if peak != limit {
+		t.Fatalf("peak concurrency = %d, want exactly the limit %d (below it means the phase is still serial)", peak, limit)
+	}
+}
+
+// TestRunLinksWithLimitOneIsStrictlySerial: the documented escape hatch has to
+// actually be an escape hatch.
+func TestRunLinksWithLimitOneIsStrictlySerial(t *testing.T) {
+	var inFlight, peak int64
+	runLinks(context.Background(), testLinks(6), 1, func(ctx context.Context, link *mpb.Link) linkOutcome {
+		cur := atomic.AddInt64(&inFlight, 1)
+		for {
+			p := atomic.LoadInt64(&peak)
+			if cur <= p || atomic.CompareAndSwapInt64(&peak, p, cur) {
+				break
+			}
+		}
+		time.Sleep(2 * time.Millisecond)
+		atomic.AddInt64(&inFlight, -1)
+		return linkOutcome{}
+	})
+	if peak != 1 {
+		t.Fatalf("peak concurrency with limit 1 = %d, want 1", peak)
+	}
+}
+
+// TestRunLinksFatalCancelsTheRest preserves the serial loop's "abort at the
+// first fatal error": the still-running links must be told to stop rather
+// than run to completion for a pod that is already lost.
+func TestRunLinksFatalCancelsTheRest(t *testing.T) {
+	fatal := errors.New("remote meshnet daemon rejected the update")
+	cancelled := make(chan struct{}, 8)
+
+	outcomes := runLinks(context.Background(), testLinks(4), 4, func(ctx context.Context, link *mpb.Link) linkOutcome {
+		if link.Uid == 1 {
+			return linkOutcome{fatal: fatal}
+		}
+		select {
+		case <-ctx.Done():
+			cancelled <- struct{}{}
+			return linkOutcome{}
+		case <-time.After(5 * time.Second):
+			return linkOutcome{}
+		}
+	})
+	if !errors.Is(outcomes[0].fatal, fatal) {
+		t.Fatalf("outcome 0 = %#v, want the fatal error", outcomes[0])
+	}
+	if len(cancelled) != 3 {
+		t.Fatalf("%d of 3 sibling links saw the cancellation", len(cancelled))
+	}
+}
+
+// TestRunLinksStillCollectsWhatACancelledSiblingCreated: a link that created
+// its local end before the fatal arrived must still be reported, or the ADD's
+// rollback leaks it.
+func TestRunLinksStillCollectsWhatACancelledSiblingCreated(t *testing.T) {
+	outcomes := runLinks(context.Background(), testLinks(2), 2, func(ctx context.Context, link *mpb.Link) linkOutcome {
+		if link.Uid == 2 {
+			time.Sleep(20 * time.Millisecond)
+			return linkOutcome{fatal: errors.New("boom")}
+		}
+		return linkOutcome{created: &koko.VEth{LinkName: link.LocalIntf, NsName: "/var/run/netns/cni-x"}}
+	})
+	if outcomes[0].created == nil || outcomes[0].created.LinkName != "eth1" {
+		t.Fatalf("the created link of the surviving worker was lost: %#v", outcomes[0])
+	}
+	if outcomes[1].fatal == nil {
+		t.Fatal("the fatal outcome was lost")
+	}
+}
+
+func TestRunLinksHandlesNoLinks(t *testing.T) {
+	if got := runLinks(context.Background(), nil, 4, func(context.Context, *mpb.Link) linkOutcome {
+		t.Fatal("wire called for an empty link set")
+		return linkOutcome{}
+	}); len(got) != 0 {
+		t.Fatalf("runLinks(nil) = %#v, want empty", got)
+	}
+}
+
+func TestLinkConcurrency(t *testing.T) {
+	cases := []struct {
+		name  string
+		conf  int
+		env   string
+		links int
+		want  int
+	}{
+		{"default", 0, "", 8, defaultLinkConcurrency},
+		{"conf wins over default", 2, "", 8, 2},
+		{"env wins over conf", 2, "6", 8, 6},
+		{"never exceeds the link count", 0, "", 2, 2},
+		{"one link is one worker", 0, "", 1, 1},
+		{"conf 1 restores serial", 1, "", 8, 1},
+		{"env 1 restores serial", 8, "1", 8, 1},
+		{"invalid env is ignored", 3, "banana", 8, 3},
+		{"negative env is ignored", 3, "-4", 8, 3},
+		{"zero links still yields at least one worker", 0, "", 0, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("MESHNET_LINK_CONCURRENCY", tc.env)
+			if got := linkConcurrency(&netConf{LinkConcurrency: tc.conf}, tc.links); got != tc.want {
+				t.Fatalf("linkConcurrency(conf=%d env=%q links=%d) = %d, want %d", tc.conf, tc.env, tc.links, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestLoadConfReadsLinkConcurrency(t *testing.T) {
+	conf, _, err := loadConf([]byte(`{"cniVersion":"0.3.0","name":"meshnet","type":"meshnet","linkConcurrency":6}`))
+	if err != nil || conf.LinkConcurrency != 6 {
+		t.Fatalf("loadConf linkConcurrency = %d, %v; want 6, nil", conf.LinkConcurrency, err)
+	}
+	conf, _, err = loadConf([]byte(`{"cniVersion":"0.3.0","name":"meshnet","type":"meshnet"}`))
+	if err != nil || conf.LinkConcurrency != 0 {
+		t.Fatalf("absent linkConcurrency = %d, %v; want 0 (meaning the default), nil", conf.LinkConcurrency, err)
+	}
+}
