+// linkOutcome is the result of realizing ONE link of a pod.
+//
+// The three fields are the three things the serial loop used to express with
+// control flow, which a concurrent phase cannot use:
+//   - created: the LOCAL end that now exists and must be rolled back if the
+//     ADD as a whole fails (removing one veth end removes its pair peer too).
+//   - soft:    this link failed, but the state of the others still matters --
+//     the loop used to append to linkErrs and continue.
+//   - fatal:   an infrastructure failure (a daemon RPC, vxlan or grpc wiring)
+//     that must fail the whole ADD -- the loop used to `return err`.
+//
+// All three may be zero: a link that was legitimately parked (peer not alive,
+// peer sandbox vanished mid-wire) produces nothing at all.
+type linkOutcome struct {
+	created *koko.VEth
+	soft    error
+	fatal   error
+}
+
+// linkConcurrency is how many of a pod's links may be realized at once.
+//
+// WHAT WAS ACTUALLY SERIAL. Every link of a pod was realized one after
+// another, and each one blocks on IO that the others do not share: a
+// meshnetClient.Get RPC to the local daemon, koko.EnsureVethWire (two netns
+// entries plus link creation) or koko.MakeVxLan, a remote gRPC dial and
+// Update to the PEER NODE's daemon, and two SetTxChecksumOff netns entries.
+// On a KNE bringup that latency is paid once per link, inside one 90s ADD
+// budget.
+//
+// WHY IT IS SAFE TO OVERLAP. Nothing in the per-link path shares mutable
+// state: the accumulators are gone (each link returns its own outcome),
+// every namespace entry goes through ns.Do, which runs its callback on its
+// OWN locked OS thread and is therefore goroutine-safe, gRPC client conns are
+// safe for concurrent use, and the only package-level variable the path reads
+// (interNodeLinkType) is set once before cmdAdd runs. The two koko creation
+// paths serialize themselves exactly where they must: EnsureVethWire locks
+// both wire ENDPOINT slots (koko 0006) and MakeVxLan locks its target slot
+// and its host VNI tuple (koko 0010). Two links of one pod always have
+// different local ifnames and different deterministic VNIs, so they never
+// contend with each other.
+//
+// Deliberately bounded rather than unbounded: a pod with 40 links must not
+// open 40 concurrent gRPC dials to one peer node's daemon. A value of 1
+// restores the old, strictly serial behaviour.
+func linkConcurrency(n *netConf, linkCount int) int {
+	limit := n.LinkConcurrency
+	if raw := strings.TrimSpace(os.Getenv("MESHNET_LINK_CONCURRENCY")); raw != "" {
+		if v, err := strconv.Atoi(raw); err == nil && v > 0 {
+			limit = v
+		} else {
+			log.Warnf("Ignoring invalid MESHNET_LINK_CONCURRENCY=%q, using %d", raw, limit)
 		}
+	}
+	if limit <= 0 {
+		limit = defaultLinkConcurrency
+	}
+	if limit > linkCount {
+		limit = linkCount
+	}
+	if limit < 1 {
+		limit = 1
+	}
+	return limit
+}
 
