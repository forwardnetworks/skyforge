+// runLinks realizes links with at most `limit` in flight and returns the
+// outcomes in the SAME ORDER as links, so rollback order and error reporting
+// stay deterministic regardless of completion order.
+//
+// The first fatal outcome cancels the context handed to the still-running
+// workers, which is how the serial loop's "abort at the first fatal error" is
+// preserved: the others stop at their next RPC instead of running to
+// completion for a pod that is already lost. Their outcomes are still
+// collected, so anything they DID create is still rolled back.
+func runLinks(ctx context.Context, links []*mpb.Link, limit int, wire func(context.Context, *mpb.Link) linkOutcome) []linkOutcome {
+	outcomes := make([]linkOutcome, len(links))
+	if len(links) == 0 {
+		return outcomes
+	}
+	if limit < 1 {
+		limit = 1
+	}
+
+	linkCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	sem := make(chan struct{}, limit)
+	var wg sync.WaitGroup
+	var once sync.Once
+	for i, link := range links {
+		wg.Add(1)
+		go func(i int, link *mpb.Link) {
+			defer wg.Done()
+			sem <- struct{}{}
+			defer func() { <-sem }()
+			outcomes[i] = wire(linkCtx, link)
+			if outcomes[i].fatal != nil {
+				once.Do(cancel)
 			}
-			peerPod, err = waitForPeerPodAlive(ctx, meshnetClient, link.PeerPod, string(cniArgs.K8S_POD_NAMESPACE), localPod.Name, link.LocalIntf, kubeVirtSecondaryWaitDuration(n.SecondaryWaitSeconds))
+		}(i, link)
+	}
+	wg.Wait()
+	return outcomes
+}
