@@ -95,15 +96,56 @@ func loadConf(bytes []byte) (*netConf, *current.Result, error) {
 	return n, result, nil
 }
 
-// getVxlanSource uses netlink to get the iface reliably given an IP address.
-// when IP and Interface both are present then Interface is going to take preference
-// nodeIntf is specified by the user and it's not auto discovered. The user has to be careful that the peer is reachable though this interface otherwise, VxLAN may not work.
-// daemonset.yaml meshnet container env required for host_intf override
-//
-//	       env:
-//	         - name: HOST_INTF
-//			value: breth2
+func ipv4FromAddr(addr net.Addr) net.IP {
+	var ip net.IP
+	switch v := addr.(type) {
+	case *net.IPNet:
+		ip = v.IP
+	case *net.IPAddr:
+		ip = v.IP
+	}
+	if ip == nil {
+		return nil
+	}
+	return ip.To4()
+}
+
+func vxlanSourceFromInterface(nodeIntf string) (string, string, error) {
+	nodeIntf = strings.TrimSpace(nodeIntf)
+	if nodeIntf == "" {
+		return "", "", fmt.Errorf("node interface is empty")
+	}
+	iface, err := net.InterfaceByName(nodeIntf)
+	if err != nil {
+		return "", "", fmt.Errorf("lookup node interface %q: %w", nodeIntf, err)
+	}
+	addrs, err := iface.Addrs()
+	if err != nil {
+		return "", "", fmt.Errorf("read addresses for node interface %q: %w", nodeIntf, err)
+	}
+	for _, addr := range addrs {
+		ip := ipv4FromAddr(addr)
+		if ip != nil && !ip.IsLoopback() {
+			return ip.String(), nodeIntf, nil
+		}
+	}
+	return "", "", fmt.Errorf("node interface %q has no non-loopback IPv4 address", nodeIntf)
+}
+
+// getVxlanSource selects the VTEP source address. Explicit HOST_INTF wins over
+// Kubernetes hostIP because routed clusters can use a node IP that is reachable
+// only through a tunnel interface.
 func getVxlanSource(nodeIP string, nodeIntf string) (string, string, error) {
+	nodeIP = strings.TrimSpace(nodeIP)
+	nodeIntf = strings.TrimSpace(nodeIntf)
+	if nodeIntf != "" {
+		srcIP, srcIntf, err := vxlanSourceFromInterface(nodeIntf)
+		if err != nil {
+			return "", "", err
+		}
+		log.Infof("Using configured meshnet source interface %s with address %s instead of HOST_IP=%s", srcIntf, srcIP, nodeIP)
+		return srcIP, srcIntf, nil
+	}
 	if nodeIntf == "" && nodeIP == "" {
 		return "", "", fmt.Errorf("meshnetd provided no HOST_IP address: %s or HOST_INTF: %s", nodeIP, nodeIntf)
 	}
@@ -122,11 +164,6 @@ func getVxlanSource(nodeIP string, nodeIntf string) (string, string, error) {
 			case *net.IPAddr:
 				ip = v.IP
 			}
-			if nodeIntf != "" {
-				if i.Name == nodeIntf {
-					return ip.String(), nodeIntf, nil
-				}
-			}
 			if nIP != nil && nIP.Equal(ip) {
 				log.Infof("Found iface %s for address %s", i.Name, nodeIP)
 				return nodeIP, i.Name, nil
diff --git a/plugin/meshnet_vtep_test.go b/plugin/meshnet_vtep_test.go
new file mode 100644
index 0000000..6190580
--- /dev/null
+++ b/plugin/meshnet_vtep_test.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"net"
+	"testing"
+)
+
+func TestIPv4FromAddrSkipsIPv6OnlyAddress(t *testing.T) {
+	addr := &net.IPNet{IP: net.ParseIP("2001:db8::1"), Mask: net.CIDRMask(64, 128)}
+	if got := ipv4FromAddr(addr); got != nil {
+		t.Fatalf("ipv4FromAddr() = %v, want nil for IPv6-only address", got)
+	}
+}
+
+func TestGetVxlanSourcePrefersConfiguredInterface(t *testing.T) {
+	ifaces, err := net.Interfaces()
+	if err != nil {
+		t.Fatalf("net.Interfaces(): %v", err)
+	}
+	for _, iface := range ifaces {
+		addrs, err := iface.Addrs()
+		if err != nil {
+			continue
+		}
+		for _, addr := range addrs {
+			ip := ipv4FromAddr(addr)
+			if ip == nil || ip.IsLoopback() {
+				continue
+			}
+			gotIP, gotIntf, err := getVxlanSource("192.0.2.1", iface.Name)
+			if err != nil {
+				t.Fatalf("getVxlanSource() returned error for interface %s: %v", iface.Name, err)
+			}
+			if gotIP != ip.String() || gotIntf != iface.Name {
+				t.Fatalf("getVxlanSource() = %s/%s, want %s/%s", gotIP, gotIntf, ip.String(), iface.Name)
+			}
+			return
+		}
+	}
+	t.Skip("no non-loopback IPv4 interface available")
+}
