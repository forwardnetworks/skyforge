 plugin/meshnet.go           | 63 +++++++++++++++++++++++++++++--------
 plugin/meshnet_vtep_test.go | 41 ++++++++++++++++++++++++
 3 files changed, 148 insertions(+), 13 deletions(-)
 create mode 100644 plugin/meshnet_vtep_test.go

diff --git a/daemon/meshnet/handler.go b/daemon/meshnet/handler.go
index 7a452f3..8eeb72b 100644
--- a/daemon/meshnet/handler.go
+++ b/daemon/meshnet/handler.go
@@ -2,7 +2,10 @@ package meshnet
 
 import (
 	"context"
+	"fmt"
+	"net"
 	"os"
+	"strings"
 
 	"github.com/networkop/meshnet-cni/api/types/v1beta1"
 	"github.com/networkop/meshnet-cni/daemon/grpcwire"
@@ -17,6 +20,59 @@ import (
 	mpb "github.com/networkop/meshnet-cni/daemon/proto/meshnet/v1beta1"
 )
 
+func ipv4FromAddr(addr net.Addr) net.IP {
+	var ip net.IP
+	switch v := addr.(type) {
+	case *net.IPNet:
+		ip = v.IP
+	case *net.IPAddr:
+		ip = v.IP
+	}
+	if ip == nil {
+		return nil
+	}
+	return ip.To4()
+}
+
+func nodeSourceFromInterface(nodeIntf string) (string, error) {
+	nodeIntf = strings.TrimSpace(nodeIntf)
+	if nodeIntf == "" {
+		return "", fmt.Errorf("node interface is empty")
+	}
+	iface, err := net.InterfaceByName(nodeIntf)
+	if err != nil {
+		return "", fmt.Errorf("lookup node interface %q: %w", nodeIntf, err)
+	}
+	addrs, err := iface.Addrs()
+	if err != nil {
+		return "", fmt.Errorf("read addresses for node interface %q: %w", nodeIntf, err)
+	}
+	for _, addr := range addrs {
+		ip := ipv4FromAddr(addr)
+		if ip != nil && !ip.IsLoopback() {
+			return ip.String(), nil
+		}
+	}
+	return "", fmt.Errorf("node interface %q has no non-loopback IPv4 address", nodeIntf)
+}
+
+func nodeSource(nodeIP, nodeIntf string) (string, string) {
+	nodeIP = strings.TrimSpace(nodeIP)
+	nodeIntf = strings.TrimSpace(nodeIntf)
+	if nodeIntf == "" {
+		return nodeIP, nodeIntf
+	}
+	srcIP, err := nodeSourceFromInterface(nodeIntf)
+	if err != nil {
+		mnetdLogger.Warnf("HOST_INTF=%s could not be resolved, falling back to HOST_IP=%s: %v", nodeIntf, nodeIP, err)
+		return nodeIP, nodeIntf
+	}
+	if srcIP != nodeIP {
+		mnetdLogger.Infof("Resolved meshnet node source from HOST_INTF=%s: HOST_IP=%s source_ip=%s", nodeIntf, nodeIP, srcIP)
+	}
+	return srcIP, nodeIntf
+}
+
 func (m *Meshnet) getPod(ctx context.Context, name, ns string) (*unstructured.Unstructured, error) {
 	mnetdLogger.Infof("Reading pod %s from K8s", name)
 	return m.tClient.Topology(ns).Unstructured(ctx, name, metav1.GetOptions{})
@@ -65,6 +121,7 @@ func (m *Meshnet) Get(ctx context.Context, pod *mpb.PodQuery) (*mpb.Pod, error)
 	containerId, _, _ := unstructured.NestedString(result.Object, "status", "container_id")
 	nodeIP := os.Getenv("HOST_IP")
 	nodeIntf := os.Getenv("HOST_INTF")
+	nodeIP, nodeIntf = nodeSource(nodeIP, nodeIntf)
 
 	return &mpb.Pod{
 		Name:        pod.Name,
