-// -------------------------------------------------------------------------------------------------
-// Adds interfaces to a POD. the POD name and the POD Namespace is passed as arguments.
-func cmdAdd(args *skel.CmdArgs) error {
-	ctx, cancel := context.WithCancel(context.Background())
+// perRPCTimeout is a grpc unary interceptor that bounds every RPC with
+// rpcTimeout while still honouring the caller's overall command budget
+// carried by the parent context.
+func perRPCTimeout(ctx context.Context, method string, req, reply interface{}, cc *grpc.ClientConn, invoker grpc.UnaryInvoker, opts ...grpc.CallOption) error {
+	rpcCtx, cancel := context.WithTimeout(ctx, rpcTimeout)
 	defer cancel()
+	return invoker(rpcCtx, method, req, reply, cc, opts...)
+}
 
+// dialGRPC dials a meshnet daemon with a bounded blocking dial and installs
+// the per-RPC timeout interceptor on the returned connection.
+func dialGRPC(ctx context.Context, target string) (*grpc.ClientConn, error) {
+	dialCtx, cancel := context.WithTimeout(ctx, rpcTimeout)
+	defer cancel()
+	conn, err := grpc.DialContext(dialCtx, target,
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithBlock(),
+		grpc.WithUnaryInterceptor(perRPCTimeout),
+	)
+	if err != nil {
+		return nil, fmt.Errorf("dialing meshnet daemon %s: %w", target, err)
+	}
+	return conn, nil
+}
+
+// -------------------------------------------------------------------------------------------------
+// Adds interfaces to a POD. the POD name and the POD Namespace is passed as arguments.
+func cmdAdd(args *skel.CmdArgs) (retErr error) {
