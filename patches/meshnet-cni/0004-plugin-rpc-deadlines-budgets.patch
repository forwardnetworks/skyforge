-					log.Infof("Add[%s]: Failed to dial remote gRPC url %s", string(cniArgs.K8S_POD_NAME), url)
+					log.Infof("Add[%s]: Failed to dial remote gRPC url %s: %v", string(cniArgs.K8S_POD_NAME), url, err)
 					return err
 				}
 				remoteClient := mpb.NewRemoteClient(remote)
@@ -406,14 +451,24 @@ func cmdAdd(args *skel.CmdArgs) error {
 
