+
+	// rpcTimeout bounds the daemon dial and every individual RPC so a wedged
+	// meshnetd (or API server) cannot stall a CNI command indefinitely.
+	rpcTimeout = 30 * time.Second
+	// addBudget is the overall CNI ADD deadline. Without it a stuck ADD holds
+	// kubelet/containerd CRI workers past their own timeouts and wedges the
+	// node's sandbox creation pipeline.
+	addBudget = 90 * time.Second
+	// delBudget is the best-effort CNI DEL deadline; on expiry we log and
+	// return success so pod teardown is never blocked by meshnet cleanup.
+	delBudget = 45 * time.Second
 )
 
