+func TestReconcileFindsAHealthySameNodeWireUnderItsKubeVirtRenamedSlot(t *testing.T) {
+	// koko-side counterpart of TestReconcileRepairsACrossNodeWireDespiteThe...
+	// below: inspecting under the resolved "-nic" slot (kubevirt_veth_slot.go)
+	// finds the wire genuinely healthy -- exactly what was measured live on
+	// example-lab-shared 2026-09-21 (siteC-dc-fw01's two same-node KubeVirt links
+	// were UP and correctly bridge-enslaved the whole time; the reconciler
+	// just never asked under the right name and left them permanently
+	// "skipped" instead of confirming health).
+	f := &fakeDeps{
+		usableNS:   map[string]bool{nsLocal: true, nsPeer: true},
+		vethHealth: map[string]koko.WireHealth{nsLocal + "/980816f36b7-nic": koko.WireHealthOK},
+		renamed:    map[string]bool{nsLocal + "/pod980816f36b7": true},
+		resolved:   map[string]string{nsLocal + "/pod980816f36b7": "980816f36b7-nic"},
+	}
+	local := topo("virt-launcher-siteC-dc-fw01", "example-lab", "10.0.0.1", nsLocal, "c1",
+		topologyv1.Link{LocalIntf: "pod980816f36b7", PeerIntf: "eth3", PeerPod: "siteC-dc-leaf01", UID: 21})
+	peer := topo("siteC-dc-leaf01", "example-lab", "10.0.0.1", nsPeer, "c2")
+
+	_, stats := runPod(t, f, 1, local, peer)
+	if stats.Healthy != 1 || stats.Repaired != 0 || len(f.vethRepairs) != 0 {
+		t.Fatalf("a healthy same-node KubeVirt wire was not recognized via its resolved slot: %s %v", stats.summary(), f.vethRepairs)
+	}
+	if n := stats.Skipped["a-link-exists-under-the-KubeVirt-renamed-form-of-this-name"]; n != 0 {
+		t.Fatalf("healthy resolved same-node wire was still bucketed as an unverifiable skip: %s", stats.summary())
+	}
+}
+
+func TestReconcileNeverAutoRepairsAGenuinelyBrokenSameNodeKubeVirtWire(t *testing.T) {
+	// Resolution can also confirm the wire IS broken even under its correct
+	// slot. That must still not become verdictRepair: koko.EnsureVethWire has
+	// no notion of the KubeVirt bridge, and recreating a plain veth under (or
+	// beside) the "-nic" name would not restore what virt-launcher's own
+	// binding put there. This stays a skip -- deliberately -- until a
+	// bridge-aware same-node repair exists.
+	f := &fakeDeps{
+		usableNS:   map[string]bool{nsLocal: true, nsPeer: true},
+		vethHealth: map[string]koko.WireHealth{nsLocal + "/980816f36b7-nic": koko.WireHealthBroken},
+		renamed:    map[string]bool{nsLocal + "/pod980816f36b7": true},
+		resolved:   map[string]string{nsLocal + "/pod980816f36b7": "980816f36b7-nic"},
+	}
+	local := topo("virt-launcher-siteC-dc-fw01", "example-lab", "10.0.0.1", nsLocal, "c1",
+		topologyv1.Link{LocalIntf: "pod980816f36b7", PeerIntf: "eth3", PeerPod: "siteC-dc-leaf01", UID: 21})
+	peer := topo("siteC-dc-leaf01", "example-lab", "10.0.0.1", nsPeer, "c2")
+
+	_, stats := runPod(t, f, 1, local, peer)
+	if stats.Repaired != 0 || len(f.vethRepairs) != 0 {
+		t.Fatalf("a genuinely-broken same-node KubeVirt wire was auto-repaired via plain EnsureVethWire: %s %v", stats.summary(), f.vethRepairs)
+	}
+}
