 		repairVeth:     koko.EnsureVethWire,
@@ -556,7 +558,22 @@ func (w wireRepair) inspect(d reconcileDeps) (wireHealth, string, error) {
 		return healthUnknown, "wire could not be derived from the Topology CR", w.buildErr
