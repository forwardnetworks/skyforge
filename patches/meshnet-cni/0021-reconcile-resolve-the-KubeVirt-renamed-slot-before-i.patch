+		// KubeVirt's own binding put there -- that is a distinct, still-open
+		// gap, not something to paper over with an unsafe auto-repair.
+		local, peer := w.local, w.peer
+		local.LinkName = d.resolveSlot(w.local.NsName, w.local.LinkName)
+		peer.LinkName = d.resolveSlot(w.peer.NsName, w.peer.LinkName)
+		h, reason, err := d.inspectVeth(local, peer, w.alias)
 		switch h {
 		case koko.WireHealthOK:
 			return healthOK, reason, err
