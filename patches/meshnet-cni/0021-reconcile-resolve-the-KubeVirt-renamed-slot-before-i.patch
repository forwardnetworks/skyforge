From 7a908ace4531d81a804c58a7cfa59efd503fccfc Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Mon, 21 Sep 2026 10:14:40 -0500
Subject: [PATCH] reconcile: resolve the KubeVirt-renamed slot before
 inspecting a same-node veth wire

koko.InspectVethWire has no notion of virt-launcher's bridge-binding
rename, so a same-node wire on a KubeVirt pod was always inspected under
the bare pod<id> name -- which after binding is occupied only by a DOWN
dummy placeholder. That correctly-broken verdict was then discarded by
classifyWire's RenamedFormPresent skip, exactly like the cross-node vxlan
case before 0020, leaving the wire permanently unverified.

Adds resolveVethSlot (mirrors daemon/vxlan.resolveSlot) and uses it only
for inspection, not repair: koko.EnsureVethWire is not KubeVirt-bridge-
aware, so a genuinely broken resolved wire still does not auto-repair.

Measured live on example-lab-shared 2026-09-21: siteC-dc-fw01 had two same-node
KubeVirt links sitting in this skip bucket that were, in fact, up and
correctly bridge-enslaved the whole time.
---
 daemon/meshnet/kubevirt_veth_slot.go | 68 ++++++++++++++++++++++++++++
 daemon/meshnet/reconcile.go          | 19 +++++++-
 daemon/meshnet/reconcile_test.go     | 60 ++++++++++++++++++++++++
 3 files changed, 146 insertions(+), 1 deletion(-)
 create mode 100644 daemon/meshnet/kubevirt_veth_slot.go

diff --git a/daemon/meshnet/kubevirt_veth_slot.go b/daemon/meshnet/kubevirt_veth_slot.go
new file mode 100644
index 0000000..7ec78d4
--- /dev/null
+++ b/daemon/meshnet/kubevirt_veth_slot.go
@@ -0,0 +1,68 @@
+package meshnet
+
+import (
+	"strings"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+)
+
+// resolveVethSlot returns the link name a same-node veth wire's end actually
+// lives under inside nsName, resolving virt-launcher's KubeVirt
+// bridge-binding rename the same way daemon/vxlan.resolveSlot already does
+// for cross-node wires (0020).
+//
+// Without this, koko.InspectVethWire is handed the bare "podXXXX" name on
+// every call, same-node or not. On a plain container that is correct. On a
+// KubeVirt VM pod whose binding has already run, "podXXXX" is occupied by
+// nothing but virt-launcher's DOWN dummy placeholder and the real wire sits
+// under "XXXX-nic" inside "k6t-XXXX" -- so InspectVethWire correctly reports
+// the bare name as broken (an end that is not a veth), and classifyWire, on
+// seeing RenamedFormPresent, discards that verdict as unverifiable and skips
+// forever. Measured live 2026-09-21 (example-lab-shared siteC-dc-fw01): both of its
+// same-node KubeVirt links were, in fact, UP and correctly bridge-enslaved
+// under their "-nic" names the whole time -- the reconciler just never asked
+// the right question. This is the koko-side half of the same gap 0020 closed
+// for vxlan.
+//
+// Returns linkName UNCHANGED (the caller inspects under the original name,
+// same as before this fix) when: the namespace can't be entered, the name is
+// not KubeVirt-shaped, the renamed form isn't present, or a same-named
+// bridge isn't there to explain it. An unresolved case is a plain container,
+// or a VM pod whose binding has not run yet -- never guess past that.
+func resolveVethSlot(nsName, linkName string) string {
+	renamed := kubevirtRenamedName(linkName)
+	if renamed == "" || !netNSUsable(nsName) {
+		return linkName
+	}
+	netNS, err := ns.GetNS(nsName)
+	if err != nil {
+		return linkName
+	}
+	defer netNS.Close()
+
+	bridgeName := "k6t-" + strings.TrimPrefix(linkName, "pod")
+	resolved := linkName
+	_ = netNS.Do(func(_ ns.NetNS) error {
+		nic, err := netlink.LinkByName(renamed)
+		if err != nil {
+			// The renamed form is not there: binding has not run, or this
+			// was never a KubeVirt pod. Keep inspecting the original name.
+			return nil
+		}
+		br, err := netlink.LinkByName(bridgeName)
+		if err != nil || br.Type() != "bridge" {
+			// Something named "<id>-nic" exists but no matching KubeVirt
+			// bridge does -- do not guess this is the same mechanism.
+			return nil
+		}
+		if nic.Attrs().MasterIndex != br.Attrs().Index {
+			// A "-nic"-named link exists but is not actually enslaved to
+			// the bridge we expect it under. Not the pattern this resolves.
+			return nil
+		}
+		resolved = renamed
+		return nil
+	})
+	return resolved
+}
