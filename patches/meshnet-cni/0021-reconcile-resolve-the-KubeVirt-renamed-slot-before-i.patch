 	if w.sameNode {
-		h, reason, err := d.inspectVeth(w.local, w.peer, w.alias)
+		// Inspect under the slot the wire actually lives in, not necessarily
+		// the bare name meshnet gave it: virt-launcher's KubeVirt bridge
+		// binding can have moved it to "<id>-nic" already (see
+		// kubevirt_veth_slot.go). koko has no notion of this rename, so
