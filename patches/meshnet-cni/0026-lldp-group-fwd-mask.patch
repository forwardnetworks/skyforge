+	waitFor(t, "first watch", func() bool { _, w := src.counts(); return len(w) == 1 })
+	w1.Error(&metav1.Status{Status: metav1.StatusFailure, Reason: metav1.StatusReasonExpired, Code: 410})
+	waitFor(t, "relist", func() bool { l, _ := src.counts(); return l == 2 })
+	if _, ok := c.snapshot(); !ok {
