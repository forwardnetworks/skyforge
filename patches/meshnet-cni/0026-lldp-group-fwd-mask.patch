+// ---------------------------------------------------------------------------
+// Netlink encoding/decoding, and the real thing when this process may.
+// ---------------------------------------------------------------------------
+
+func buildLinkMsg(kind string, mask *uint16) []byte {
+	m := nl.NewIfInfomsg(unix.AF_UNSPEC)
+	m.Index = 42
+	li := nl.NewRtAttr(unix.IFLA_LINKINFO, nil)
+	nl.NewRtAttrChild(li, nl.IFLA_INFO_KIND, nl.NonZeroTerminated(kind))
+	if mask != nil {
+		d := nl.NewRtAttrChild(li, nl.IFLA_INFO_DATA, nil)
+		nl.NewRtAttrChild(d, nl.IFLA_BR_GROUP_FWD_MASK, nl.Uint16Attr(*mask))
+	}
+	return append(m.Serialize(), li.Serialize()...)
+}
+
+func TestParseBridgeGroupFwdMask(t *testing.T) {
+	m := uint16(0x4000)
+	idx, got, found, err := parseBridgeGroupFwdMask(buildLinkMsg("bridge", &m))
+	if err != nil || !found || got != 0x4000 || idx != 42 {
+		t.Fatalf("idx=%d mask=%#x found=%v err=%v", idx, got, found, err)
+	}
+	if _, got, found, _ := parseBridgeGroupFwdMask(buildLinkMsg("bridge", nil)); !found || got != 0 {
+		t.Fatalf("a bridge without the attribute reads as 0: %#x %v", got, found)
+	}
+	// anything that is not a bridge is never reported as one
+	if _, _, found, _ := parseBridgeGroupFwdMask(buildLinkMsg("dummy", nil)); found {
+		t.Fatal("a dummy must not be treated as a bridge")
+	}
+	if _, _, _, err := parseBridgeGroupFwdMask([]byte{1, 2, 3}); err == nil {
+		t.Fatal("a short message must be an error")
+	}
+}
