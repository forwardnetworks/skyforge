+// ---------------------------------------------------------------------------
+// The Topology cache: one list, then events.
+// ---------------------------------------------------------------------------
+
+type fakeWatcher struct {
+	mu       sync.Mutex
+	lists    int
+	watches  []string // resourceVersion of each Watch call
+	listRV   string
+	items    []topologyv1.Topology
+	streams  chan *watch.FakeWatcher
+	watchErr error
+}
+
+func (f *fakeWatcher) List(context.Context, metav1.ListOptions) (*topologyv1.TopologyList, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.lists++
+	l := &topologyv1.TopologyList{Items: append([]topologyv1.Topology(nil), f.items...)}
+	l.SetResourceVersion(f.listRV)
+	return l, nil
+}
+
+func (f *fakeWatcher) Watch(_ context.Context, o metav1.ListOptions) (watch.Interface, error) {
+	f.mu.Lock()
+	f.watches = append(f.watches, o.ResourceVersion)
+	err := f.watchErr
+	f.mu.Unlock()
+	if err != nil {
+		return nil, err
+	}
+	return <-f.streams, nil
+}
+
+func (f *fakeWatcher) counts() (int, []string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.lists, append([]string(nil), f.watches...)
+}
+
+func vmTopo(name, rv string) *topologyv1.Topology {
+	tp := topo(name, "lab", "10.0.0.1", nsLocal, "c", topologyv1.Link{LocalIntf: "podabc", PeerIntf: "eth1", PeerPod: "x", UID: 1})
+	tp.SetResourceVersion(rv)
+	return tp
+}
