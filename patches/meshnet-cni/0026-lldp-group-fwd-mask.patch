+type fakeBridges struct {
+	usable map[string]bool
+	// masks is keyed "netns#bridge"; an absent key is "no such bridge".
+	masks   map[string]uint16
+	readErr map[string]error
+	setErr  map[string]error
+
+	reads []string
+	sets  []string
+}
+
+func (f *fakeBridges) deps() lldpMaskDeps {
+	return lldpMaskDeps{
+		netNSUsable: func(nsName string) bool { return f.usable[nsName] },
+		bridgeMask: func(nsName, br string) (uint16, bool, error) {
+			k := nsName + "#" + br
+			f.reads = append(f.reads, k)
+			if err := f.readErr[k]; err != nil {
+				return 0, false, err
+			}
+			m, ok := f.masks[k]
+			return m, ok, nil
+		},
+		setMask: func(nsName, br string, mask uint16) error {
+			k := nsName + "#" + br
+			if err := f.setErr[k]; err != nil {
+				return err
+			}
+			f.sets = append(f.sets, k+"="+hex16(mask))
+			f.masks[k] = mask
+			return nil
+		},
+	}
+}
+
+func hex16(m uint16) string {
+	const d = "0123456789abcdef"
+	return "0x" + string([]byte{d[m>>12&15], d[m>>8&15], d[m>>4&15], d[m&15]})
+}
+
+func newMasker(f *fakeBridges, targets ...maskTarget) *lldpMasker {
+	InitLogger()
+	return &lldpMasker{
+		deps:     f.deps(),
+		targets:  func() ([]maskTarget, bool) { return targets, true },
+		nodeIP:   func(context.Context) (string, error) { return "10.0.0.1", nil },
+		interval: time.Second,
+	}
+}
