+func TestCacheListsOnceThenFollowsWatchEvents(t *testing.T) {
+	InitLogger()
+	w1, w2 := watch.NewFake(), watch.NewFake()
+	src := &fakeWatcher{listRV: "10", items: []topologyv1.Topology{*vmTopo("vm1", "9")}, streams: make(chan *watch.FakeWatcher, 2)}
+	src.streams <- w1
+	src.streams <- w2
+	c := newMaskCache(src)
+	c.backoff = time.Millisecond
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go c.run(ctx)
+
+	names := func() []string {
+		ts, _ := c.snapshot()
+		var n []string
+		for _, x := range ts {
+			n = append(n, x.Name)
+		}
+		return n
+	}
+	waitFor(t, "initial list", func() bool { return len(names()) == 1 })
+
+	w1.Add(vmTopo("vm2", "11"))
+	waitFor(t, "added vm2", func() bool { return len(names()) == 2 })
+	// a Modified event that removes the KubeVirt slot drops the target
+	plain := topo("vm2", "lab", "10.0.0.1", nsLocal, "c", topologyv1.Link{LocalIntf: "eth1", PeerIntf: "eth1", PeerPod: "x", UID: 1})
+	plain.SetResourceVersion("12")
+	w1.Modify(plain)
+	waitFor(t, "vm2 no longer a slot", func() bool { return len(names()) == 1 })
+	w1.Delete(vmTopo("vm1", "13"))
+	waitFor(t, "vm1 deleted", func() bool { return len(names()) == 0 })
+
+	// the server ends the watch: it is resumed from the LAST resourceVersion,
+	// not relisted.
+	w1.Stop()
+	waitFor(t, "second watch", func() bool { _, w := src.counts(); return len(w) == 2 })
+	lists, watches := src.counts()
+	if lists != 1 || watches[0] != "10" || watches[1] != "13" {
+		t.Fatalf("lists=%d watches=%v (want 1 list, watch from 10 then resumed from 13)", lists, watches)
+	}
+	w2.Add(vmTopo("vm3", "14"))
+	waitFor(t, "event on resumed watch", func() bool { return len(names()) == 1 })
+}
