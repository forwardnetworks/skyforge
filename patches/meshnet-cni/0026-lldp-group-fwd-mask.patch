+// TestRealBridgeMaskRoundTrip drives the hand-built netlink messages against
+// the kernel. It needs CAP_NET_ADMIN in the current netns, so it skips unless
+// it has it; run it unprivileged with: unshare -Urn go test -run RealBridge
+func TestRealBridgeMaskRoundTrip(t *testing.T) {
+	if os.Getenv("MESHNET_REAL_NETLINK_TEST") != "1" {
+		t.Skip("set MESHNET_REAL_NETLINK_TEST=1 and run under `unshare -Urn` (needs CAP_NET_ADMIN)")
+	}
+	const self = "/proc/self/ns/net"
+	netNS, err := ns.GetNS(self)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer netNS.Close()
+	if err := netNS.Do(func(ns.NetNS) error {
+		if err := netlink.LinkAdd(&netlink.Bridge{LinkAttrs: netlink.LinkAttrs{Name: "k6t-test"}}); err != nil {
+			return err
+		}
+		return netlink.LinkAdd(&netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "podtest"}})
+	}); err != nil {
+		t.Skipf("cannot create links here (%v): not run", err)
+	}
+
+	mask, found, err := readBridgeGroupFwdMask(self, "k6t-test")
+	if err != nil || !found || mask != 0 {
+		t.Fatalf("fresh bridge: mask=%#x found=%v err=%v", mask, found, err)
+	}
+	if err := writeBridgeGroupFwdMask(self, "k6t-test", 0x4000); err != nil {
+		t.Fatal(err)
+	}
+	if mask, _, _ = readBridgeGroupFwdMask(self, "k6t-test"); mask != 0x4000 {
+		t.Fatalf("after set: %#x", mask)
+	}
+	// iproute2 is the independent witness, if present
+	if out, err := exec.Command("ip", "-d", "link", "show", "k6t-test").CombinedOutput(); err == nil {
+		if !strings.Contains(string(out), "group_fwd_mask 0x4000") {
+			t.Fatalf("ip does not see the mask: %s", out)
+		}
+	}
+	if _, found, err := readBridgeGroupFwdMask(self, "podtest"); err != nil || found {
+		t.Fatalf("a dummy is not a bridge: found=%v err=%v", found, err)
+	}
+	if _, found, err := readBridgeGroupFwdMask(self, "k6t-nope"); err != nil || found {
+		t.Fatalf("a missing link is not an error: found=%v err=%v", found, err)
+	}
+	if err := writeBridgeGroupFwdMask(self, "k6t-nope", 0x4000); err == nil {
+		t.Fatal("setting a missing bridge must fail")
+	}
+}
