+func TestCacheRelistsAfterAWatchError(t *testing.T) {
+	InitLogger()
+	w1, w2 := watch.NewFake(), watch.NewFake()
+	src := &fakeWatcher{listRV: "1", streams: make(chan *watch.FakeWatcher, 2)}
+	src.streams <- w1
