From fda5aad9a25c2e59aea809ad59cb037efdccb323 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Fri, 25 Sep 2026 11:20:31 -0500
Subject: [PATCH] daemon: add RepairLinkNow RPC for on-demand wire rebuild

Exposes the periodic wire reconciler's repair path (buildRepair/apply,
already proven by patch 0015) as an on-demand gRPC RPC on the Local
service, bypassing only the reconciler's multi-pass corroboration --
appropriate here because the caller is an explicit, deliberate request
to rebuild one named pod's declared wires, not a passive heuristic
guessing whether a wire is actually broken.

wireReconciler is now stored on *Meshnet (it never was before), so
this and future RPC handlers can reach it. On a grpc-wire-mode
cluster the reconciler is never started, so wireReconciler stays nil;
RepairLinkNow treats that as zero repairs, not an error -- grpc wires
are rebuilt by a fresh AddGRPCWireLocal/Remote call at pod creation,
a separate mechanism this RPC does not touch.
---
 daemon/meshnet/handler.go                     |  22 +
 daemon/meshnet/meshnet.go                     |   1 +
 daemon/meshnet/reconcile.go                   |  60 ++
 daemon/proto/meshnet/v1beta1/meshnet.pb.go    | 608 ++++++++++--------
 daemon/proto/meshnet/v1beta1/meshnet.proto    |  20 +-
 .../proto/meshnet/v1beta1/meshnet_grpc.pb.go  | 135 ++--
 6 files changed, 529 insertions(+), 317 deletions(-)

diff --git a/daemon/meshnet/handler.go b/daemon/meshnet/handler.go
index 68b913f..b73a0dc 100644
--- a/daemon/meshnet/handler.go
+++ b/daemon/meshnet/handler.go
@@ -706,3 +706,25 @@ func (m *Meshnet) GenerateNodeInterfaceName(ctx context.Context, in *mpb.Generat
 	}
 	return &mpb.GenerateNodeInterfaceNameResponse{Ok: true, NodeIntfName: locIfNm}, nil
 }
+
+// RepairLinkNow rebuilds every wire declared on the given pod's Topology CR
+// immediately, reusing the periodic wire reconciler's own repair path (see
+// daemon/meshnet/reconcile.go) without waiting for its normal multi-pass
+// corroboration. In grpc-wire-mode clusters (INTER_NODE_LINK_TYPE=GRPC) the
+// reconciler is never started, so m.wireReconciler is nil there -- that is
+// not a bug to work around, it means this call has nothing to do on such a
+// cluster (grpc wires are rebuilt by a fresh AddGRPCWireLocal/Remote call at
+// pod creation, an entirely different mechanism this RPC does not touch),
+// so it reports zero repairs rather than erroring.
+func (m *Meshnet) RepairLinkNow(ctx context.Context, pod *mpb.PodQuery) (*mpb.RepairLinkNowResponse, error) {
+	if m.wireReconciler == nil {
+		mnetdLogger.Infof("RepairLinkNow(%s/%s): wire reconciler is not active on this node (grpc-wire mode, or disabled)", pod.KubeNs, pod.Name)
+		return &mpb.RepairLinkNowResponse{}, nil
+	}
+	repaired, failed, err := m.wireReconciler.repairPodLinksNow(ctx, pod.KubeNs, pod.Name)
+	if err != nil {
+		mnetdLogger.Errorf("RepairLinkNow(%s/%s) failed: %v", pod.KubeNs, pod.Name, err)
+		return nil, err
+	}
+	return &mpb.RepairLinkNowResponse{Repaired: int32(repaired), Failed: int32(failed)}, nil
+}
