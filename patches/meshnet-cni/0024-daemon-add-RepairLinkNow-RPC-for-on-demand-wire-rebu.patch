index 8a0a8ce..d15c941 100644
--- a/daemon/meshnet/reconcile.go
+++ b/daemon/meshnet/reconcile.go
@@ -373,6 +373,7 @@ func (m *Meshnet) StartWireReconciler(ctx context.Context) {
 		return
 	}
 	r := newReconciler(m)
+	m.wireReconciler = r
 	if r.interval <= 0 {
 		mnetdLogger.Infof("Wire reconciler disabled by MESHNET_RECONCILE_INTERVAL=0")
 		return
@@ -606,6 +607,65 @@ func (w wireRepair) apply(d reconcileDeps) error {
 	return d.repairVxlan(w.remote)
 }
 
+// repairPodLinksNow rebuilds every wire declared on ns/podName's Topology CR
+// immediately, reusing the exact same buildRepair/apply path the periodic
+// reconciler uses for a genuine repair (so a rebuilt wire is
+// indistinguishable from one meshnet built at pod creation), but bypassing
+// classifyWire/r.confirm's multi-pass corroboration entirely: that
+// corroboration exists to protect against ACTING ON A HEURISTIC (an
+// inspection that might be wrong, or might be racing an in-flight CNI ADD/
+// DEL), which doesn't apply here -- this is called only in response to an
+// explicit external request to rebuild a specific, named link, not a
+// passive periodic guess. A link the caller didn't ask about is never
+// touched: only ns/podName's own declared links are considered, never its
+// peers' (the caller is expected to have already, or separately, triggered
+// the same call on the peer's own node if that side also needs rebuilding
+// -- same-node veths are a single call, cross-node vxlan wires are one call
+// per side, matching how buildRepair itself is already one-sided per node).
+func (r *reconciler) repairPodLinksNow(ctx context.Context, ns, podName string) (repaired, failed int, err error) {
+	ns = strings.TrimSpace(ns)
+	podName = strings.TrimSpace(podName)
+	if ns == "" || podName == "" {
+		return 0, 0, fmt.Errorf("namespace and pod name are required")
+	}
+	topo, err := r.m.tClient.Topology(ns).Get(ctx, podName, metav1.GetOptions{})
+	if err != nil {
+		return 0, 0, fmt.Errorf("get topology %s/%s: %w", ns, podName, err)
+	}
+	_, nodeIntf, err := r.m.nodeSourceForCurrentNode(ctx)
+	if err != nil {
+		return 0, 0, fmt.Errorf("resolve node source: %w", err)
+	}
+	list, err := r.m.tClient.Topology(metav1.NamespaceAll).List(ctx, metav1.ListOptions{})
+	if err != nil {
+		return 0, 0, fmt.Errorf("list topologies: %w", err)
+	}
+	byKey := map[string]*topologyv1.Topology{}
+	for i := range list.Items {
+		t := &list.Items[i]
+		byKey[t.GetNamespace()+"/"+t.GetName()] = t
+	}
+	for _, link := range topo.Spec.Links {
+		if link.PeerPod == "" || link.PeerPod == "localhost" {
+			continue // macvlan/hostlink: no peer to build a wire to
+		}
+		if protectedLinkName(link.LocalIntf) || protectedLinkName(link.PeerIntf) {
+			continue
+		}
+		peerNs := wireutil.PeerNamespace(ns, link.PeerNamespace)
+		peer := byKey[peerNs+"/"+link.PeerPod]
+		repair := r.buildRepair(topo, peer, link, ns, nodeIntf)
+		if err := repair.apply(r.deps); err != nil {
+			failed++
+			mnetdLogger.Errorf("Wire repair-now: %s/%s link %d (%s -> %s@%s): %v", ns, podName, link.UID, link.LocalIntf, link.PeerIntf, link.PeerPod, err)
+			continue
+		}
+		repaired++
+		mnetdLogger.Infof("Wire repair-now: %s/%s link %d (%s -> %s@%s): repaired on demand", ns, podName, link.UID, link.LocalIntf, link.PeerIntf, link.PeerPod)
+	}
+	return repaired, failed, nil
+}
+
 func (r *reconciler) buildRepair(topo, peer *topologyv1.Topology, link topologyv1.Link, ns, nodeIntf string) wireRepair {
 	if peer == nil {
 		return wireRepair{buildErr: fmt.Errorf("peer topology %s/%s not found", wireutil.PeerNamespace(ns, link.PeerNamespace), link.PeerPod)}
