@@ -0,0 +1,170 @@
+package vxlan
+
+import (
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+// The fixtures below are the link table of virt-launcher-siteE-rr-rt02 on
+// example-lab-shared, 2026-09-21 (`ip -d link` in the pod), reduced to the fields
+// resolveSlot reads. Each test names the wire it reproduces.
+
+func bridgeLink(name string, index int) netlink.Link {
+	return &netlink.Bridge{LinkAttrs: netlink.LinkAttrs{Name: name, Index: index}}
+}
+
+func dummyLink(name string) netlink.Link {
+	return &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: name}}
+}
+
+func bridgedVxlan(name string, vni int, group string, master int) netlink.Link {
+	l := vxlanLink(name, vni, group).(*netlink.Vxlan)
+	l.MasterIndex = master
+	return l
+}
+
+func table(links ...netlink.Link) func(string) netlink.Link {
+	byName := map[string]netlink.Link{}
+	for _, l := range links {
+		byName[l.Attrs().Name] = l
+	}
+	return func(name string) netlink.Link { return byName[name] }
+}
+
+const (
+	wantVNI  = 14101293
+	wantVTEP = "192.0.2.126"
+)
+
+func TestResolveSlotSeesThroughTheKubeVirtDummy(t *testing.T) {
+	// 24bf8ab8fca on rr-rt02: the healthy shape. pod<id> is a dummy, the wire
+	// is <id>-nic inside k6t-<id>.
+	lookup := table(
+		bridgeLink("k6t-24bf8ab8fca", 10),
+		dummyLink("pod24bf8ab8fca"),
+		bridgedVxlan("24bf8ab8fca-nic", wantVNI, wantVTEP, 10),
+	)
+	slot := resolveSlot(lookup, "pod24bf8ab8fca")
+	if slot.found == nil || slot.found.Attrs().Name != "24bf8ab8fca-nic" {
+		t.Fatalf("found = %+v, want the -nic", slot.found)
+	}
+	if slot.name != "24bf8ab8fca-nic" || slot.bridge != "k6t-24bf8ab8fca" || slot.bridgeIndex != 10 {
+		t.Fatalf("slot = %+v, want name/bridge of the bound form", slot)
+	}
+	if slot.dummy == nil || len(slot.strays) != 0 {
+		t.Fatalf("dummy=%v strays=%v, want the placeholder reported and no strays", slot.dummy, slot.strays)
+	}
+	h, reason := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP))
+	if h != HealthOK {
+		t.Fatalf("healthy VM wire classified %v (%s)", h, reason)
+	}
+}
+
+func TestClassifySlotBrokenRenamedWireIsBrokenNotUnknown(t *testing.T) {
+	// The bug: with the dummy under the original name, Inspect used to say
+	// "occupied by a *netlink.Dummy" (unknown) and the reconciler skipped
+	// forever. The -nic carries the wrong remote VTEP: that is broken.
+	lookup := table(
+		bridgeLink("k6t-bd1fd6e84b9", 13),
+		dummyLink("podbd1fd6e84b9"),
+		bridgedVxlan("bd1fd6e84b9-nic", wantVNI, "192.0.2.203", 13),
+	)
+	h, reason := classifySlot(resolveSlot(lookup, "podbd1fd6e84b9"), wantVNI, net.ParseIP(wantVTEP))
+	if h != HealthBroken || !strings.Contains(reason, "remote VTEP") {
+		t.Fatalf("classify = %v (%s), want broken on the stale VTEP", h, reason)
+	}
+}
+
+func TestClassifySlotBareVxlanOutsideTheBridgeIsBroken(t *testing.T) {
+	// pod63c8fdd4323 on rr-rt02: a dummy-blind repair deleted the dummy and
+	// built the vxlan under the original name; k6t-63c8fdd4323 holds only
+	// the tap. Right VNI, right VTEP, unreachable from the VM.
+	lookup := table(
+		bridgeLink("k6t-63c8fdd4323", 16),
+		vxlanLink("pod63c8fdd4323", wantVNI, wantVTEP),
+	)
+	slot := resolveSlot(lookup, "pod63c8fdd4323")
+	if slot.found == nil || slot.found.Attrs().Name != "pod63c8fdd4323" || slot.name != "63c8fdd4323-nic" {
+		t.Fatalf("slot = %+v, want the bare vxlan found and the -nic name as the target", slot)
+	}
+	h, reason := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP))
+	if h != HealthBroken || !strings.Contains(reason, "not enslaved") {
+		t.Fatalf("classify = %v (%s), want broken for being outside the bridge", h, reason)
+	}
+}
+
+func TestClassifySlotStrayBesideTheBridgedWireIsBroken(t *testing.T) {
+	// pod151b6d47576 on rr-rt02: a bare vxlan under the original name
+	// beside a correct 151b6d47576-nic in the bridge.
+	lookup := table(
+		bridgeLink("k6t-151b6d47576", 7),
+		vxlanLink("pod151b6d47576", wantVNI, wantVTEP),
+		bridgedVxlan("151b6d47576-nic", wantVNI, wantVTEP, 7),
+	)
+	slot := resolveSlot(lookup, "pod151b6d47576")
+	if slot.found.Attrs().Name != "151b6d47576-nic" || len(slot.strays) != 1 || slot.strays[0].Attrs().Name != "pod151b6d47576" {
+		t.Fatalf("slot = %+v, want the -nic found and the bare vxlan as a stray", slot)
+	}
+	h, reason := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP))
+	if h != HealthBroken || !strings.Contains(reason, "stray") {
+		t.Fatalf("classify = %v (%s), want broken on the stray", h, reason)
+	}
+}
+
+func TestClassifySlotDummyOnlyInABridgeIsBroken(t *testing.T) {
+	// Bridge and tap exist, the -nic is gone and only the placeholder is
+	// left under the original name: the slot is empty, and the placeholder
+	// must not read as occupancy.
+	lookup := table(
+		bridgeLink("k6t-eb0005074cc", 19),
+		dummyLink("podeb0005074cc"),
+	)
+	slot := resolveSlot(lookup, "podeb0005074cc")
+	if slot.found != nil || slot.name != "eb0005074cc-nic" || slot.bridge != "k6t-eb0005074cc" {
+		t.Fatalf("slot = %+v, want an empty slot targeting the -nic in the bridge", slot)
+	}
+	h, reason := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP))
+	if h != HealthBroken || !strings.Contains(reason, "placeholder") {
+		t.Fatalf("classify = %v (%s), want broken naming the placeholder", h, reason)
+	}
+}
+
+func TestResolveSlotLeavesNonKubeVirtWiresAlone(t *testing.T) {
+	// A container wire (eth1) and a VM pod whose binding has not run yet
+	// (pod<id> is the vxlan itself, no bridge, no -nic) both resolve to the
+	// original name with no bridge, exactly as before.
+	for _, name := range []string{"eth1", "pod0123456789a"} {
+		lookup := table(vxlanLink(name, wantVNI, wantVTEP))
+		slot := resolveSlot(lookup, name)
+		if slot.found == nil || slot.found.Attrs().Name != name || slot.name != name || slot.bridge != "" || len(slot.strays) != 0 {
+			t.Fatalf("%s: slot = %+v, want the original name, no bridge", name, slot)
+		}
+		if h, reason := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP)); h != HealthOK {
+			t.Fatalf("%s: classify = %v (%s)", name, h, reason)
+		}
+	}
+	// A dummy with neither bridge nor -nic is a state we do not understand:
+	// unknown, never repaired.
+	slot := resolveSlot(table(dummyLink("pod0123456789a")), "pod0123456789a")
+	if h, _ := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP)); h != HealthUnknown {
+		t.Fatalf("dummy with no bridge classified %v, want unknown", h)
+	}
+}
+
+func TestResolveSlotDoesNotTrustANonVxlanUnderTheNicName(t *testing.T) {
+	// Something that is not a vxlan under <id>-nic is found (so a repair
+	// removes it by that name) but classified unknown by classifyLink: the
+	// reconciler must not act on it.
+	lookup := table(
+		bridgeLink("k6t-24bf8ab8fca", 10),
+		dummyLink("pod24bf8ab8fca"),
+		&netlink.Veth{LinkAttrs: netlink.LinkAttrs{Name: "24bf8ab8fca-nic", MasterIndex: 10}},
+	)
+	slot := resolveSlot(lookup, "pod24bf8ab8fca")
+	if h, reason := classifySlot(slot, wantVNI, net.ParseIP(wantVTEP)); h != HealthUnknown {
+		t.Fatalf("classify = %v (%s), want unknown for a non-vxlan occupant", h, reason)
+	}
+}
