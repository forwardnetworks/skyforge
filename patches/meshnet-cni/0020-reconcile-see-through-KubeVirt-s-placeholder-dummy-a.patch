diff --git a/daemon/vxlan/kubevirt_slot.go b/daemon/vxlan/kubevirt_slot.go
new file mode 100644
index 0000000..f37d865
--- /dev/null
+++ b/daemon/vxlan/kubevirt_slot.go
@@ -0,0 +1,173 @@
+package vxlan
+
+import (
+	"fmt"
+	"net"
+	"strings"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+)
+
+// wireSlot is where ONE end of a cross-node wire lives inside a pod once the
+// pod's own networking has had its say.
+//
+// For a plain container the answer is trivial: the wire is the vxlan under
+// the name meshnet gave it. KubeVirt bridge binding rearranges that. Measured
+// on example-lab-shared 2026-09-21 (virt-launcher-siteE-rr-rt02, `ip -d link`),
+// every healthy VM link looks like this:
+//
+//	k6t-<id>      bridge
+//	tap<id>       the VM's tap, master k6t-<id>
+//	<id>-nic      OUR vxlan, renamed by virt-launcher, master k6t-<id>
+//	pod<id>       a DUMMY, state DOWN -- virt-launcher's placeholder so the
+//	              pod still lists an interface under the original name
+//
+// So on a VM pod the original name is OCCUPIED, by a dummy, and the wire is
+// the "-nic" inside the bridge. Code that looks the wire up by its original
+// name, finds the dummy, and reasons from there gets every verdict wrong:
+// the inspector reports "occupied by a *netlink.Dummy" (unknown, so the
+// reconciler never repairs), and CreateOrUpdate deletes the dummy and builds
+// a fresh vxlan under pod<id> that no bridge contains -- the same pod showed
+// exactly that: pod63c8fdd4323 as a bare vxlan, k6t-63c8fdd4323 holding only
+// the tap, and a stray pod151b6d47576 sitting beside a correct
+// 151b6d47576-nic. The VM's traffic enters the tap, crosses the bridge, and
+// finds nothing on the other side.
+//
+// resolveSlot answers the only two questions that matter: WHICH link carries
+// this wire, and WHERE a rebuilt one must go.
+type wireSlot struct {
+	// found is the link that carries (or should carry) the wire: the "-nic"
+	// when KubeVirt has bound the interface, otherwise whatever sits under
+	// the original name. nil when nothing does.
+	found netlink.Link
+	// name is the name a rebuilt wire must be created under.
+	name string
+	// bridge is the KubeVirt bridge the wire must be enslaved to, "" when the
+	// pod has none for this interface. bridgeIndex is its ifindex.
+	bridge      string
+	bridgeIndex int
+	// strays are bare vxlans under the original name that exist BESIDE the
+	// bridged wire. Nothing in the pod uses them (the VM's path is
+	// tap -> bridge -> "-nic"), they only hold a VNI hostage, and they are
+	// what an earlier, dummy-blind repair leaves behind.
+	strays []netlink.Link
+	// dummy is virt-launcher's placeholder. It is reported so the caller can
+	// say so, and it is never touched: KubeVirt owns it.
+	dummy netlink.Link
+}
+
+// kubevirtNames returns the bridge-binding names for a meshnet wire name, or
+// "" when the name is not one meshnet hands to KubeVirt pods.
+func kubevirtNames(linkName string) (nic, bridge string) {
+	if !strings.HasPrefix(linkName, "pod") {
+		return "", ""
+	}
+	id := strings.TrimPrefix(linkName, "pod")
+	return id + "-nic", "k6t-" + id
+}
+
+// resolveSlot is pure given a lookup; production passes a getLinkFromNS
+// closure and the tests pass a map.
+func resolveSlot(lookup func(string) netlink.Link, linkName string) wireSlot {
+	slot := wireSlot{name: linkName}
+	original := lookup(linkName)
+	nicName, bridgeName := kubevirtNames(linkName)
+	if nicName == "" {
+		slot.found = original
+		return slot
+	}
+	if br, ok := lookup(bridgeName).(*netlink.Bridge); ok {
+		slot.bridge = bridgeName
+		slot.bridgeIndex = br.Attrs().Index
+	}
+	nic := lookup(nicName)
+	if nic == nil && slot.bridge == "" {
+		// No sign of KubeVirt: a plain container wire, or a VM pod whose
+		// binding has not run yet. Either way the original name is the slot.
+		// A dummy here, with no bridge to explain it, stays what it is: an
+		// occupant classifyLink does not understand (unknown, never repaired).
+		slot.found = original
+		return slot
+	}
+	if d, ok := original.(*netlink.Dummy); ok {
+		// virt-launcher's placeholder: not the wire, never touched.
+		slot.dummy = d
+		original = nil
+	}
+	// KubeVirt has bound (or is binding) this interface: the wire belongs
+	// under the "-nic" name inside the bridge.
+	slot.name = nicName
+	if nic != nil {
+		slot.found = nic
+		if original != nil {
+			if _, isVxlan := original.(*netlink.Vxlan); isVxlan {
+				slot.strays = append(slot.strays, original)
+			}
+		}
+		return slot
+	}
+	// Bridge present, "-nic" absent: the wire was rebuilt under the original
+	// name by something that could not see the bridge. That link IS the wire,
+	// it is just not where the VM can reach it.
+	slot.found = original
+	return slot
+}
+
+// classifySlot extends classifyLink with the two facts only a slot knows: a
+// wire the VM cannot reach because it is not in its bridge is broken, and a
+// stray under the original name is broken too (it is evidence of a bad repair
+// and the VNI it holds blocks a clean rebuild).
+func classifySlot(slot wireSlot, wantVNI int, wantVTEP net.IP) (Health, string) {
+	h, reason := classifyLink(slot.found, wantVNI, wantVTEP)
+	if h != HealthOK {
+		if slot.found == nil && slot.dummy != nil {
+			reason = "only virt-launcher's placeholder dummy occupies the slot"
+		}
+		return h, reason
+	}
+	if slot.bridge != "" && slot.found.Attrs().MasterIndex != slot.bridgeIndex {
+		return HealthBroken, fmt.Sprintf("vxlan %s is not enslaved to KubeVirt bridge %s (master ifindex %d, want %d)",
+			slot.found.Attrs().Name, slot.bridge, slot.found.Attrs().MasterIndex, slot.bridgeIndex)
+	}
+	if len(slot.strays) > 0 {
+		names := make([]string, 0, len(slot.strays))
+		for _, s := range slot.strays {
+			names = append(names, s.Attrs().Name)
+		}
+		return HealthBroken, fmt.Sprintf("stray vxlan %s sits under the original name beside the bridged wire %s",
+			strings.Join(names, ","), slot.found.Attrs().Name)
+	}
+	return h, reason
+}
+
+// enslaveToBridge puts linkName under bridgeName inside nsName and brings it
+// up. It is the last step of a KubeVirt-aware rebuild: koko has already
+// created the vxlan under the "-nic" name.
+func enslaveToBridge(nsName, linkName, bridgeName string) error {
+	vethNs, err := ns.GetNS(nsName)
+	if err != nil {
+		return fmt.Errorf("enter %s: %w", nsName, err)
+	}
+	defer vethNs.Close()
+	return vethNs.Do(func(_ ns.NetNS) error {
+		link, err := netlink.LinkByName(linkName)
+		if err != nil {
+			return fmt.Errorf("lookup %s: %w", linkName, err)
+		}
+		br, err := netlink.LinkByName(bridgeName)
+		if err != nil {
+			return fmt.Errorf("lookup bridge %s: %w", bridgeName, err)
+		}
+		if _, ok := br.(*netlink.Bridge); !ok {
+			return fmt.Errorf("%s is a %T, not a bridge", bridgeName, br)
+		}
+		if err := netlink.LinkSetMaster(link, br); err != nil {
+			return fmt.Errorf("enslave %s to %s: %w", linkName, bridgeName, err)
+		}
+		if err := netlink.LinkSetUp(link); err != nil {
+			return fmt.Errorf("set %s up: %w", linkName, err)
+		}
+		return nil
+	})
+}
diff --git a/daemon/vxlan/kubevirt_slot_test.go b/daemon/vxlan/kubevirt_slot_test.go
