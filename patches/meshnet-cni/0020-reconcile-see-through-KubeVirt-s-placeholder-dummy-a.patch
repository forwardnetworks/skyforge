+func TestReconcileRepairsACrossNodeWireDespiteTheKubeVirtRenamedForm(t *testing.T) {
+	// Cross-node counterpart of the test above. vxlan.Inspect already looks
+	// through the KubeVirt rename and compared the renamed link's VNI and
+	// remote VTEP against the topology, so HealthBroken here is a verdict
+	// about the wire the VM is actually using, not about a missing name. The
+	// bare renamed-form check must not be allowed to veto it: that is exactly
+	// how example-lab-shared sat with twelve broken wires "skipped" on every pass.
+	f := &fakeDeps{
+		usableNS:   map[string]bool{nsLocal: true},
+		vxlanState: map[string]vxlan.Health{nsLocal + "/pod980816f36b7": vxlan.HealthBroken},
+		renamed:    map[string]bool{nsLocal + "/pod980816f36b7": true},
+	}
+	local := topo("virt-launcher-siteE-rr-rt02", "example-lab", "10.0.0.1", nsLocal, "c1",
+		topologyv1.Link{LocalIntf: "pod980816f36b7", PeerIntf: "eth3", PeerPod: "siteE-rr-rt01", UID: 21})
+	peer := topo("siteE-rr-rt01", "example-lab", "10.0.0.2", "/var/run/netns/cni-remote", "c3")
+
+	_, stats := runPod(t, f, 1, local, peer)
+	if stats.Repaired != 1 || len(f.vxlanRepairs) != 1 {
+		t.Fatalf("a broken cross-node wire hid behind its renamed form: %s %v", stats.summary(), f.vxlanRepairs)
+	}
+	if !strings.Contains(f.vxlanRepairs[0], fmt.Sprintf("vni=%d", wireVNI("example-lab", 21))) || !strings.Contains(f.vxlanRepairs[0], "peer=10.0.0.2") {
