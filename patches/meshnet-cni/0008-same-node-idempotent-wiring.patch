+				// Idempotently realize the wire. Both directions of a link may
+				// attempt this concurrently (both pods' ADDs); koko serializes
+				// all wire creators node-wide and either adopts a wire the
+				// peer already realized correctly, replaces stale halves, or
+				// fails loudly when a different wire owns the name. This
+				// replaces the old check-then-MakeVeth branches, whose
+				// existence checks were racy and whose rename collisions were
+				// fatal to the entire multi-link ADD.
+				alias := koko.VethWireAlias(string(cniArgs.K8S_POD_NAMESPACE), link.Uid)
+				if err := koko.EnsureVethWire(*myVeth, *peerVeth, alias); err != nil {
+					log.Errorf("Add[%s]: Error ensuring VEth wire %s (link id %d) with koko: %s", string(cniArgs.K8S_POD_NAME), link.LocalIntf, link.Uid, err)
+					return err
 				}
+				// Record only the local end for rollback: removing it removes
+				// the pair, and this sandbox is abandoned on ADD failure
+				// whether the wire was created or adopted.
+				createdLinks = append(createdLinks, myVeth)
 				if err := wireutil.SetTxChecksumOff(myVeth.LinkName, myVeth.NsName); err != nil {
 					log.Errorf("Add[%s]: Error in setting tx checksum-off on interface %s, ns %s, pod %s: %v", string(cniArgs.K8S_POD_NAME), myVeth.LinkName, myVeth.NsName, localPod.Name, err)
 					// not returning
@@ -586,6 +577,7 @@ func cmdAdd(args *skel.CmdArgs) (retErr error) {
 					log.Infof("Add[%s]: Error when creating a Vxlan interface with koko: %s", string(cniArgs.K8S_POD_NAME), err)
 					return err
