+package main
+
+import "testing"
+
+func TestProtectedIfName(t *testing.T) {
+	for _, name := range []string{"", "   ", "eth0", "lo"} {
+		if !protectedIfName(name) {
+			t.Fatalf("protectedIfName(%q) = false, want true", name)
+		}
+	}
+	for _, name := range []string{"eth1", "eth10", "e1-1", "net1"} {
+		if protectedIfName(name) {
+			t.Fatalf("protectedIfName(%q) = true, want false", name)
+		}
+	}
+}
