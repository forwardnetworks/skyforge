+// protectedIfName reports whether an interface name must never be removed by
+// meshnet: eth0 belongs to the delegated/primary CNI chain and lo to the
+// kernel. Topology links never legitimately use these names; the guard is
+// defense in depth for every retry/rollback/cleanup path.
+func protectedIfName(name string) bool {
+	name = strings.TrimSpace(name)
+	return name == "" || name == "eth0" || name == "lo"
+}
+
+// rollbackCreatedLinks removes the local ends of fabric links realized by a
+// failed CNI ADD so the next attempt starts from a clean slate. Only
+// local-namespace ends are recorded by cmdAdd: removing one veth end removes
+// its pair peer as well, and the peer pod's namespace is never touched
+// directly here. Delegated interfaces are never removed.
+func rollbackCreatedLinks(podName string, links []*koko.VEth) {
+	for i := len(links) - 1; i >= 0; i-- {
+		link := links[i]
+		if link == nil || protectedIfName(link.LinkName) || strings.TrimSpace(link.NsName) == "" {
+			continue
+		}
+		if err := link.RemoveVethLink(); err != nil {
+			log.Warnf("Add[%s]: rollback could not remove link %s in netns %s after failed CNI ADD: %v", podName, link.LinkName, link.NsName, err)
+			continue
+		}
+		log.Infof("Add[%s]: rolled back link %s in netns %s after failed CNI ADD", podName, link.LinkName, link.NsName)
+	}
+}
+
