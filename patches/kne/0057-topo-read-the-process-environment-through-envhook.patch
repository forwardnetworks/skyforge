diff --git a/topo/envhook/envhook.go b/topo/envhook/envhook.go
new file mode 100644
index 0000000..2a36554
--- /dev/null
+++ b/topo/envhook/envhook.go
@@ -0,0 +1,61 @@
+// Package envhook is the one place the platform fork reads configuration that upstream KNE (and the first the platform
+// patches) read straight from the process environment with os.Getenv / os.LookupEnv.
+//
+// WHY. A program that embeds the fork as a library (netlab-go's adapters/kne drives topo.Manager in-process, with
+// no kne_cli child) used to have to os.Setenv the per-lab values (image pull secret, node selector, placement, ...)
+// before an operation and restore them afterwards. The process environment is shared with everything else in the
+// process, and the platform server reads about ten SKYFORGE_KNE_* keys of its own from it (for example
+// SKYFORGE_KNE_PRIORITY_CLASS_NAME and the cleanup force-finalize pair), so a per-lab os.Setenv would change the
+// server's behaviour. Reading through this package lets the embedder answer the fork's questions from a value it
+// owns and leave os.Environ() untouched.
+//
+// DEFAULT. With no hook installed Lookup is os.LookupEnv, so the fork behaves exactly as before for the kne_cli
+// binary, for tests that use t.Setenv, and for every caller that never installs a hook.
+//
+// SCOPE. The hook is a process-global function value. It answers for every goroutine of the process, so two
+// operations that need different answers must not overlap: the embedder serialises them (adapters/kne holds a
+// lease and only lets operations with an identical answer set run concurrently).
+package envhook
+
+import (
+	"os"
+	"sync/atomic"
+)
+
+// Func answers one lookup the way os.LookupEnv does: the value and whether the name is set.
+type Func func(name string) (string, bool)
+
+var hook atomic.Pointer[Func]
+
+// Lookup is os.LookupEnv unless a hook is installed, in which case it is the hook.
+func Lookup(name string) (string, bool) {
+	if f := hook.Load(); f != nil {
+		return (*f)(name)
+	}
+	return os.LookupEnv(name)
+}
+
+// Getenv is os.Getenv through Lookup: the value, or "" when the name is not set.
+func Getenv(name string) string {
+	v, _ := Lookup(name)
+	return v
+}
+
+// Set installs fn as the answer to every Lookup in the process (nil restores the default, os.LookupEnv) and returns
+// a function that reinstates what was installed before the call. The restore function is idempotent.
+func Set(fn Func) (restore func()) {
+	var next *Func
+	if fn != nil {
+		next = &fn
+	}
+	prev := hook.Swap(next)
+	var done atomic.Bool
+	return func() {
+		if done.CompareAndSwap(false, true) {
+			hook.Store(prev)
+		}
+	}
+}
+
+// Installed reports whether a hook is installed (for diagnostics and tests).
+func Installed() bool { return hook.Load() != nil }
diff --git a/topo/envhook/envhook_test.go b/topo/envhook/envhook_test.go
new file mode 100644
index 0000000..b7c14d4
--- /dev/null
+++ b/topo/envhook/envhook_test.go
@@ -0,0 +1,93 @@
+package envhook
+
+import (
+	"os"
+	"sync"
+	"testing"
+)
+
+const probe = "SKYFORGE_ENVHOOK_TEST_PROBE"
+
+func TestDefaultIsTheProcessEnvironment(t *testing.T) {
+	t.Setenv(probe, "from-os")
+	if v, ok := Lookup(probe); !ok || v != "from-os" {
+		t.Fatalf("Lookup = %q, %v", v, ok)
+	}
+	if got := Getenv(probe); got != "from-os" {
+		t.Fatalf("Getenv = %q", got)
+	}
+	if Installed() {
+		t.Fatal("no hook should be installed by default")
+	}
+}
+
+func TestSetAnswersInsteadOfTheProcessEnvironmentAndLeavesItUntouched(t *testing.T) {
+	t.Setenv(probe, "from-os")
+	before := os.Environ()
+	restore := Set(func(name string) (string, bool) {
+		if name == probe {
+			return "from-hook", true
+		}
+		return "", false
+	})
+	if got := Getenv(probe); got != "from-hook" {
+		t.Fatalf("Getenv through the hook = %q", got)
+	}
+	if v, ok := Lookup("HOME"); ok {
+		t.Fatalf("the hook says HOME is not set, Lookup = %q", v)
+	}
+	if got := os.Getenv(probe); got != "from-os" {
+		t.Fatalf("os.Getenv changed to %q", got)
+	}
+	restore()
+	restore() // idempotent
+	if got := Getenv(probe); got != "from-os" {
+		t.Fatalf("after restore Getenv = %q", got)
+	}
+	after := os.Environ()
+	if len(before) != len(after) {
+		t.Fatalf("os.Environ changed: %d -> %d entries", len(before), len(after))
+	}
+}
+
+func TestSetNilRestoresTheDefaultAndRestoreReinstatesThePreviousHook(t *testing.T) {
+	outer := Set(func(string) (string, bool) { return "outer", true })
+	defer outer()
+	inner := Set(func(string) (string, bool) { return "inner", true })
+	if got := Getenv("X"); got != "inner" {
+		t.Fatalf("inner = %q", got)
+	}
+	inner()
+	if got := Getenv("X"); got != "outer" {
+		t.Fatalf("after inner restore = %q", got)
+	}
+	clear := Set(nil)
+	if Installed() {
+		t.Fatal("Set(nil) must remove the hook")
+	}
+	clear()
+	if got := Getenv("X"); got != "outer" {
+		t.Fatalf("after clear restore = %q", got)
+	}
+}
+
+func TestConcurrentLookupsAndSwapsAreRaceFree(t *testing.T) {
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				_ = Getenv(probe)
+			}
+		}()
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				r := Set(func(string) (string, bool) { return "v", true })
+				r()
+			}
+		}()
+	}
+	wg.Wait()
+}
