From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Tue, 20 Oct 2026 19:04:53 -0500
Subject: [PATCH 36/41] meshnet: a labelled node's identity is its declared
 VTEP source (M0012 fix)

---
diff --git a/third_party/meshnet/daemon/meshnet/meshnet.go b/third_party/meshnet/daemon/meshnet/meshnet.go
index a8b8a47..a57378b 100644
--- a/third_party/meshnet/daemon/meshnet/meshnet.go
+++ b/third_party/meshnet/daemon/meshnet/meshnet.go
@@ -146,6 +146,17 @@ func New(cfg Config) (*Meshnet, error) {
 	mpb.RegisterWireProtocolServer(m.s, m)
 	reflection.Register(m.s)
 
+	// The plugin writes the VTEP source into status.src_ip, and every local
+	// check compares that field with m.nodeIP. On a labelled node the VTEP is
+	// the labelled interface, so the daemon's identity must be that source too.
+	// Resolving it here (not only HOST_IP) keeps the local checks consistent.
+	// Fail closed: if the node cannot be read, the daemon does not start.
+	if id, err := m.resolveNodeIdentity(context.Background()); err != nil {
+		return nil, fmt.Errorf("resolve node VTEP identity: %w", err)
+	} else {
+		m.nodeIP = id
+	}
+
 	// After server is registered, reduce logging if link type is GRPC
 	if lnkTyp == wireutil.INTER_NODE_LINK_GRPC {
 		// Stop all Info, Warning, Error
diff --git a/third_party/meshnet/daemon/meshnet/underlay_contract.go b/third_party/meshnet/daemon/meshnet/underlay_contract.go
index 707881d..972baba 100644
--- a/third_party/meshnet/daemon/meshnet/underlay_contract.go
+++ b/third_party/meshnet/daemon/meshnet/underlay_contract.go
@@ -48,6 +48,16 @@ func declaredUnderlayContract(labels map[string]string, configuredMTU int) (intf
 	return nodeIntf, declared + vxlanIPv4Overhead, true, nil
 }
 
+// resolveNodeIdentity returns the address this daemon's node is known by in
+// status.src_ip: the declared VTEP source on a labelled node, HOST_IP otherwise.
+func (m *Meshnet) resolveNodeIdentity(ctx context.Context) (string, error) {
+	ip, _, err := m.nodeSourceForCurrentNode(ctx)
+	if err != nil {
+		return "", err
+	}
+	return ip, nil
+}
+
 // nodeSourceForCurrentNode returns the VTEP source IP and interface for this
 // node. Labels win when present; otherwise HOST_IP and HOST_INTF are used as
 // before.
diff --git a/third_party/meshnet/daemon/meshnet/underlay_contract_test.go b/third_party/meshnet/daemon/meshnet/underlay_contract_test.go
index 2763b1b..e0dcafe 100644
--- a/third_party/meshnet/daemon/meshnet/underlay_contract_test.go
+++ b/third_party/meshnet/daemon/meshnet/underlay_contract_test.go
@@ -2,6 +2,7 @@ package meshnet
 
 import (
 	"context"
+	"net"
 	"strings"
 	"testing"
 
@@ -72,3 +73,49 @@ func TestNodeSourceUnlabelledKeepsLegacyEnv(t *testing.T) {
 		t.Fatalf("legacy source = %q %q %v", ip, intf, err)
 	}
 }
+
+// The plugin writes the VTEP source into status.src_ip, and the daemon's local
+// checks compare that with its own identity. On a labelled node the identity
+// must be the declared source, not HOST_IP (found live 2026-10-20: a pod on a
+// labelled node was never treated as local and never got its VXLAN).
+func TestNodeIdentityIsDeclaredVTEPOnLabelledNode(t *testing.T) {
+	InitLogger()
+	t.Setenv("NODE_NAME", "n3")
+	t.Setenv("HOST_IP", "172.18.0.7")
+	t.Setenv("HOST_INTF", "eth0")
+	node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n3", Labels: map[string]string{
+		fabricMTULabel: "8950", underlayInterfaceLabel: "lo",
+	}}}
+	iface, err := net.InterfaceByName("lo")
+	if err != nil {
+		t.Skipf("no loopback interface to declare: %v", err)
+	}
+	want, err := nodeSourceFromInterface(iface)
+	if err != nil {
+		t.Skipf("loopback has no IPv4 in this environment: %v", err)
+	}
+	m := &Meshnet{kClient: fakekube.NewSimpleClientset(node)}
+	id, err := m.resolveNodeIdentity(context.Background())
+	if err != nil {
+		t.Fatalf("resolveNodeIdentity: %v", err)
+	}
+	if id == "172.18.0.7" {
+		t.Fatalf("labelled node identity = HOST_IP %q; want the declared source %q", id, want)
+	}
+	if id != want {
+		t.Fatalf("labelled node identity = %q, want declared source %q", id, want)
+	}
+}
+
+// An unlabelled node keeps HOST_IP as its identity, as before.
+func TestNodeIdentityUnlabelledIsHostIP(t *testing.T) {
+	t.Setenv("NODE_NAME", "n4")
+	t.Setenv("HOST_IP", "172.18.0.8")
+	t.Setenv("HOST_INTF", "eth0")
+	node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n4"}}
+	m := &Meshnet{kClient: fakekube.NewSimpleClientset(node)}
+	id, err := m.resolveNodeIdentity(context.Background())
+	if err != nil || id != "172.18.0.8" {
+		t.Fatalf("unlabelled identity = %q, %v; want HOST_IP", id, err)
+	}
+}
