+package versa
+
+import (
+	"fmt"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+	"google.golang.org/protobuf/proto"
+)
+
+var defaultNode = tpb.Node{
+	Name: "default_versa_node",
+	Config: &tpb.Config{
+		EntryCommand: fmt.Sprintf("kubectl exec -it %s -- bash", "default_versa_node"),
+	},
+}
+
+func New(nodeImpl *node.Impl) (node.Node, error) {
+	if nodeImpl == nil {
+		return nil, fmt.Errorf("nodeImpl cannot be nil")
+	}
+	if nodeImpl.Proto == nil {
+		return nil, fmt.Errorf("nodeImpl.Proto cannot be nil")
+	}
+	nodeImpl.Proto = defaults(nodeImpl.Proto)
+	return &Node{Impl: nodeImpl}, nil
+}
+
+type Node struct {
+	*node.Impl
+}
+
+func defaults(pb *tpb.Node) *tpb.Node {
+	defaultNodeClone := proto.Clone(&defaultNode).(*tpb.Node)
+	if pb == nil {
+		pb = &tpb.Node{Name: defaultNodeClone.Name}
+	}
+	if pb.Config == nil {
+		pb.Config = &tpb.Config{}
+	}
+	if pb.Config.EntryCommand == "" {
+		pb.Config.EntryCommand = fmt.Sprintf("kubectl exec -it %s -- bash", pb.Name)
+	}
+	if pb.Config.Image == "" {
+		switch pb.Model {
+		case "director":
+			pb.Config.Image = "registry.example.com/skyforge/kubevirt/vr-versa-director:21.1.2-kne-r1"
+		case "flexvnf":
+			pb.Config.Image = "registry.example.com/skyforge/kubevirt/vr-versa-flexvnf:23.1.1-B-kne-r1"
+		}
+	}
+	if pb.Model == "" {
+		pb.Model = defaultNodeClone.Model
+	}
+	if pb.Os == "" {
+		pb.Os = "versa"
+	}
+	if pb.Labels == nil {
+		pb.Labels = map[string]string{}
+	}
+	if pb.Labels["vendor"] == "" {
+		pb.Labels["vendor"] = tpb.Vendor_VERSA.String()
+	}
+	if pb.Labels["model"] == "" {
+		pb.Labels["model"] = pb.Model
+	}
+	if pb.Labels["os"] == "" {
+		pb.Labels["os"] = pb.Os
+	}
+	return pb
+}
+
+func init() {
+	node.Vendor(tpb.Vendor_VERSA, New)
+}
