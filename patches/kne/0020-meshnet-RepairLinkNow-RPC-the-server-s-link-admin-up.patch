new file mode 100644
index 0000000..da9024d
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/repair_test.go
@@ -0,0 +1,67 @@
+package meshnet
+
+import (
+	"context"
+	"testing"
+
+	fakeTopology "github.com/openconfig/kne/third_party/meshnet/api/clientset/v1beta1/fake"
+	topologyv1 "github.com/openconfig/kne/third_party/meshnet/api/types/v1beta1"
+	mpb "github.com/openconfig/kne/third_party/meshnet/daemon/proto/meshnet/v1beta1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+)
+
+// The contract the server relies on (RepairLinkNow, server link-admin up):
+// an unknown pod is an error; a pod with no links is zero repaired and no
+// error; a pod whose links cannot be built reports them as failed.
+func newRepairMeshnet(t *testing.T, objs ...*topologyv1.Topology) *Meshnet {
+	t.Helper()
+	InitLogger()
+	robjs := make([]runtime.Object, 0, len(objs))
+	for _, o := range objs {
+		robjs = append(robjs, o)
+	}
+	c, err := fakeTopology.NewSimpleClientset(robjs...)
+	if err != nil {
+		t.Fatalf("topology clientset: %v", err)
+	}
+	return &Meshnet{tClient: c, topoCache: NewTopologyCache()}
+}
+
+func TestRepairLinkNowUnknownPodIsNotFound(t *testing.T) {
+	m := newRepairMeshnet(t)
+	_, err := m.RepairLinkNow(context.Background(), &mpb.PodQuery{Name: "nope", KubeNs: "default"})
+	if !apierrors.IsNotFound(err) {
+		t.Fatalf("RepairLinkNow(nope) err = %v, want NotFound", err)
+	}
+}
+
+func TestRepairLinkNowPodWithoutLinksRepairsNothing(t *testing.T) {
+	m := newRepairMeshnet(t, &topologyv1.Topology{ObjectMeta: metav1.ObjectMeta{Name: "r1", Namespace: "default"}})
+	resp, err := m.RepairLinkNow(context.Background(), &mpb.PodQuery{Name: "r1", KubeNs: "default"})
+	if err != nil || resp.GetRepaired() != 0 || resp.GetFailed() != 0 {
+		t.Fatalf("RepairLinkNow(r1) = %v, %v; want zero counts, nil", resp, err)
+	}
+}
+
+// Links that cannot be built here (no netns for the pod, so the wire is
+// refused) are counted as failed, not returned as an error.
+func TestRepairLinkNowCountsUnbuildableLinksAsFailed(t *testing.T) {
+	topo := &topologyv1.Topology{
+		ObjectMeta: metav1.ObjectMeta{Name: "r2", Namespace: "default"},
+		Spec: topologyv1.TopologySpec{Links: []topologyv1.Link{
+			{UID: 1, PeerPod: "p", LocalIntf: "eth1", PeerIntf: "eth1", LocalIP: "10.0.0.1/30", PeerIP: "10.0.0.2/30"},
+			{UID: 2, PeerPod: "q", LocalIntf: "eth2", PeerIntf: "eth2", LocalIP: "10.0.1.1/30", PeerIP: "10.0.1.2/30"},
+		}},
+		Status: topologyv1.TopologyStatus{SrcIP: "/proc/1/ns/net"},
+	}
+	m := newRepairMeshnet(t, topo)
+	resp, err := m.RepairLinkNow(context.Background(), &mpb.PodQuery{Name: "r2", KubeNs: "default"})
+	if err != nil {
+		t.Fatalf("RepairLinkNow(r2) returned error %v; want counts only", err)
+	}
+	if resp.GetRepaired()+resp.GetFailed() != 2 {
+		t.Fatalf("repaired=%d failed=%d; want the two declared links accounted for", resp.GetRepaired(), resp.GetFailed())
+	}
+}
