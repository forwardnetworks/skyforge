+
+// RepairLinkNow rebuilds every wire declared on the pod's Topology CR now. It
+// is the server's explicit "bring this link back up" action (link-admin up,
+// after it deliberately removes a link interface). It runs the same
+// ReconcilePodLinks path as the controller, without waiting for a second pass.
+//
+// A pod with no declared links is not an error. A link that cannot be rebuilt
+// is counted in Failed, and the reason lands in the Topology status, which
+// ReconcilePodLinks already writes. The error is not returned, so the server
+// can report the counts.
+func (m *Meshnet) RepairLinkNow(ctx context.Context, pod *mpb.PodQuery) (*mpb.RepairLinkNowResponse, error) {
+	topo, err := m.getPod(ctx, pod.GetName(), pod.GetKubeNs())
+	if err != nil {
+		return nil, err
+	}
+	links, err := parsePodLinks(topo)
+	if err != nil {
+		return nil, err
+	}
+	if len(links) == 0 {
+		return &mpb.RepairLinkNowResponse{}, nil
+	}
+	if err := m.ReconcilePodLinks(ctx, topo); err != nil {
+		mnetdLogger.Warnf("RepairLinkNow(%s/%s): %d link(s) not rebuilt: %v", pod.GetKubeNs(), pod.GetName(), len(links), err)
+		return &mpb.RepairLinkNowResponse{Failed: int32(len(links))}, nil
+	}
+	return &mpb.RepairLinkNowResponse{Repaired: int32(len(links))}, nil
+}
