+// dummy) neither sends nor applies state: the dummy's admin state is not the
+// guest's, and the peer must not be turned off by it.
+func TestKubeVirtEndNeitherSendsNorApplies(t *testing.T) {
+	c := newCluster(t)
+	c.k.addLink(nsA, "pod24bf8ab8fca", linkVni)
+	c.k.setAdmin(nsA, "pod24bf8ab8fca", false) // the virt-launcher dummy is DOWN
+	vm := LinkEnd{NetNs: nsA, IntfName: "pod24bf8ab8fca", Vni: linkVni, LinkUID: linkUID, KubeNs: "lab", PeerIP: ipB, PeerNetNs: nsB, PeerIntf: "eth1"}
+	c.reg[ipA].Ensure(vm)
+	c.reg[ipB].Ensure(c.endB())
+	quiet()
+	if got := c.count("10.0.0.1->"); got != 0 {
