+// oldPeerSend answers Unimplemented to calls to ip while old is set, as a node
+// that has not been rolled to a daemon with SetWireCarrier does.
+func (c *cluster) oldPeerSend(ip string, old *atomic.Bool) {
+	c.sendFn = func(peerIP string, req *mpb.WireCarrier) (bool, error) {
+		if peerIP == ip && old.Load() {
+			return false, status.Error(codes.Unimplemented, "old daemon")
+		}
+		return c.reg[peerIP].SetLinkCarrier(req)
+	}
+}
