+func TestDaemonRestartResyncsBothWays(t *testing.T) {
+	c := newCluster(t)
+	c.ensureBoth()
+	c.k.setAdmin(nsB, "eth1", false)
+	eventually(t, "A NO-CARRIER", func() bool { return !c.k.carrier(nsA, "eth1") })
+
+	// A's daemon restarts: its memory is gone, the kernel keeps carrier state.
+	// The first pass of the new daemon must not undo it (B is still down).
+	c.restart(ipA)
+	c.reg[ipA].Ensure(c.endA())
+	quiet()
+	if c.k.carrier(nsA, "eth1") {
+		t.Fatal("restart of A's daemon must not restore carrier while B is admin down")
+	}
+
+	// While A's daemon was down, A went admin down and B's daemon missed the push.
+	c.k.setAdmin(nsB, "eth1", true)
+	eventually(t, "A carrier back", func() bool { return c.k.carrier(nsA, "eth1") })
+	c.restart(ipB) // B's daemon restarts too
+	c.k.mu.Lock()
+	c.k.links[nsA+"|eth1"].adminUp = false // changed with nobody watching
+	c.k.mu.Unlock()
+	c.reg[ipB].Ensure(c.endB())
+	c.restart(ipA)
+	c.reg[ipA].Ensure(c.endA()) // A's new daemon reports the state it finds
+	eventually(t, "B NO-CARRIER from the state A's new daemon found", func() bool { return !c.k.carrier(nsB, "eth1") })
