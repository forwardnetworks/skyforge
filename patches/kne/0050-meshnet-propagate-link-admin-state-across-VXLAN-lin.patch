diff --git a/third_party/meshnet/utils/wireutil/protodown.go b/third_party/meshnet/utils/wireutil/protodown.go
new file mode 100644
index 0000000..cfffd9a
--- /dev/null
+++ b/third_party/meshnet/utils/wireutil/protodown.go
@@ -0,0 +1,54 @@
+package wireutil
+
+import (
+	"fmt"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+// SetLinkCarrier sets the carrier (IFLA_PROTO_DOWN) of the interface with the
+// given ifindex in the network namespace at nsPath: carrier is off while up is
+// false. The interface is named by index so that a caller who resolved a
+// renamed link acts on that link and not on whatever now holds the old name.
+//
+// A VXLAN interface cannot have its carrier set the way a TAP can
+// (TUNSETCARRIER), but it accepts protodown, which the kernel implements as
+// carrier off. The admin state (IFF_UP) is not touched, so the NOS in the pod
+// keeps its own idea of admin state and sees only NO-CARRIER. The change is
+// idempotent and works on any link whose driver supports protodown (vxlan,
+// veth, bridge, macvlan). The kernel returns EOPNOTSUPP for the others.
+func SetLinkCarrier(nsPath string, index int, up bool) error {
+	if index <= 0 {
+		return fmt.Errorf("invalid ifindex %d", index)
+	}
+	podNs, err := ns.GetNS(nsPath)
+	if err != nil {
+		return fmt.Errorf("could not open netns %s: %w", nsPath, err)
+	}
+	defer podNs.Close()
+	return podNs.Do(func(_ ns.NetNS) error {
+		if _, err := netlink.LinkByIndex(index); err != nil {
+			return fmt.Errorf("could not find ifindex %d in %s: %w", index, nsPath, err)
+		}
+		return setProtoDown(index, !up)
+	})
+}
+
+// setProtoDown sets IFLA_PROTO_DOWN on the link with the given index in the
+// network namespace of the calling thread.
+func setProtoDown(index int, down bool) error {
+	req := nl.NewNetlinkRequest(unix.RTM_NEWLINK, unix.NLM_F_ACK)
+	msg := nl.NewIfInfomsg(unix.AF_UNSPEC)
+	msg.Index = int32(index)
+	req.AddData(msg)
+	var v uint8
+	if down {
+		v = 1
+	}
+	req.AddData(nl.NewRtAttr(unix.IFLA_PROTO_DOWN, nl.Uint8Attr(v)))
+	_, err := req.Execute(unix.NETLINK_ROUTE, 0)
+	return err
+}
