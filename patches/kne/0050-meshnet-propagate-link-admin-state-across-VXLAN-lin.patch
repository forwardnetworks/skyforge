+package wireutil
+
+import (
+	"net"
+	"os"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+	"golang.org/x/sys/unix"
+)
+
+// TestSetLinkCarrierOnVxlan needs CAP_NET_ADMIN in a network namespace of its
+// own. Run it unprivileged with:
+//
+//	go test -c -o /tmp/wireutil.test ./utils/wireutil && unshare -Urn /tmp/wireutil.test -test.run SetLinkCarrier -test.v
+//
+// It skips (and says so) when the namespace cannot be changed.
+func TestSetLinkCarrierOnVxlan(t *testing.T) {
+	if os.Getenv("KNE_TEST_OWN_NETNS") == "" && os.Geteuid() != 0 {
+		t.Skip("NOT RUN: needs root or `unshare -Urn` (see test comment)")
+	}
+	lo, err := netlink.LinkByName("lo")
+	if err != nil {
+		t.Skipf("NOT RUN: no lo: %v", err)
+	}
+	_ = netlink.LinkSetUp(lo)
+	vx := &netlink.Vxlan{LinkAttrs: netlink.LinkAttrs{Name: "vxtest0"}, VxlanId: 4242, Group: net.ParseIP("192.0.2.2"), Port: 4789}
+	if err := netlink.LinkAdd(vx); err != nil {
+		t.Skipf("NOT RUN: cannot add a vxlan here: %v", err)
+	}
+	defer netlink.LinkDel(vx)
+	link, _ := netlink.LinkByName("vxtest0")
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatal(err)
+	}
+	const ns = "/proc/thread-self/ns/net"
+	idx := link.Attrs().Index
+	flags := func() uint32 {
+		l, err := netlink.LinkByName("vxtest0")
+		if err != nil {
+			t.Fatal(err)
+		}
+		return l.Attrs().RawFlags
+	}
+	if flags()&unix.IFF_LOWER_UP == 0 {
+		t.Fatal("fixture: a new up vxlan has carrier")
+	}
+	if err := SetLinkCarrier(ns, idx, false); err != nil {
+		t.Fatalf("SetLinkCarrier(false): %v", err)
+	}
+	if f := flags(); f&unix.IFF_LOWER_UP != 0 || f&unix.IFF_UP == 0 {
+		t.Errorf("after carrier off flags=%#x: want admin UP kept and LOWER_UP cleared", f)
+	}
+	if err := SetLinkCarrier(ns, idx, false); err != nil {
+		t.Errorf("setting the same state again must be a no-op, got %v", err)
+	}
+	if err := SetLinkCarrier(ns, idx, true); err != nil {
+		t.Fatalf("SetLinkCarrier(true): %v", err)
+	}
+	if flags()&unix.IFF_LOWER_UP == 0 {
+		t.Error("carrier did not come back")
+	}
+	if err := SetLinkCarrier(ns, 99999, true); err == nil {
+		t.Error("an unknown ifindex must be an error")
+	}
+}
