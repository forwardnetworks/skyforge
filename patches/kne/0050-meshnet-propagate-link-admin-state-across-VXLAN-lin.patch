+	}
+	if !c.k.carrier(nsB, "eth1") {
+		t.Error("the peer of a VM end lost carrier")
+	}
+	c.k.mu.Lock()
+	calls := c.k.carrierCalls
+	c.k.mu.Unlock()
+	ok, err := c.reg[ipA].SetLinkCarrier(&mpb.WireCarrier{NetNs: nsA, IntfName: "pod24bf8ab8fca", Vni: linkVni, PeerAdminUp: false})
+	c.k.mu.Lock()
+	after := c.k.carrierCalls
+	c.k.mu.Unlock()
+	if !ok || err != nil || after != calls {
+		t.Errorf("request for a VM end: %v, %v, %d kernel calls; want acknowledged with no kernel call", ok, err, after-calls)
+	}
+}
