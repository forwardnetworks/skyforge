+func TestUnappliedPushIsRetriedThenLeftToTheNextPass(t *testing.T) {
+	c := newCluster(t)
+	var mu sync.Mutex
+	calls := 0
+	accept := false
+	c.sendFn = func(peerIP string, req *mpb.WireCarrier) (bool, error) {
+		mu.Lock()
+		defer mu.Unlock()
+		calls++
+		if !accept {
+			return false, nil // the peer has no such link yet
+		}
+		return c.reg[peerIP].SetLinkCarrier(req)
+	}
+	c.reg[ipA].Ensure(c.endA())
+	eventually(t, "pusher gives up", func() bool { mu.Lock(); defer mu.Unlock(); return calls >= carrierGiveUpAfter })
+	quiet()
+	mu.Lock()
+	settled := calls
+	mu.Unlock()
+	quiet()
+	mu.Lock()
+	if calls != settled || calls != carrierGiveUpAfter {
+		t.Errorf("calls=%d settled=%d; want exactly %d and then silence", calls, settled, carrierGiveUpAfter)
+	}
+	accept = true
+	mu.Unlock()
+	c.reg[ipB].Ensure(c.endB())      // B's daemon has the link now
+	c.k.setAdmin(nsA, "eth1", false) // a new state change re-arms it
+	eventually(t, "B NO-CARRIER once the peer accepts", func() bool { return !c.k.carrier(nsB, "eth1") })
+}
