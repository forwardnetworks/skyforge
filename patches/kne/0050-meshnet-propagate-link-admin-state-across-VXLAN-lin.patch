diff --git a/third_party/meshnet/daemon/vxlan/carrier.go b/third_party/meshnet/daemon/vxlan/carrier.go
new file mode 100644
index 0000000..add8211
--- /dev/null
+++ b/third_party/meshnet/daemon/vxlan/carrier.go
@@ -0,0 +1,589 @@
+package vxlan
+
+// This file gives VXLAN links the carrier semantics of a veth pair, the same
+// semantics grpcwire/carrier.go gives grpc-wires: an end of a link has carrier
+// (IFF_LOWER_UP) only while the other end is administratively up (IFF_UP).
+// Same-node links are veth pairs and get this from the kernel. A VXLAN
+// interface knows nothing about its remote end, so the daemons carry the state.
+//
+// Each daemon watches the admin state of the pod-side VXLAN interfaces of the
+// links it reconciles (one netlink subscription per pod netns, the same watch
+// the grpc-wires use) and pushes it to the daemon that owns the other end with
+// the existing Remote.SetWireCarrier RPC. A VXLAN end has no wire interface id,
+// so the request names the receiver's end by its pod netns, interface name and
+// VNI (wire_if_id is 0). The receiver sets the carrier of its interface with
+// protodown (wireutil.SetLinkCarrier). Carrier is never reported by the watch,
+// so a carrier we set cannot echo back as an admin change.
+//
+// The node of the peer is known the way it is for the VXLAN itself: the
+// reconciler already resolved the peer pod's node IP and netns from its
+// Topology status. Every reconcile pass calls Carriers.Ensure for every link,
+// so a link is re-registered after a daemon restart, and a changed peer netns
+// or a re-created local interface (new ifindex) makes the daemon send its state
+// again and ask the peer to send its own back.
+//
+// KubeVirt VM ends take no part: the wire of a VM pod is a bridge port under a
+// renamed link, the guest's admin state is not visible in the pod netns, and
+// carrier on a bridge port does not reach the guest. A VM end neither sends nor
+// applies state; a request for one is acknowledged and ignored.
+//
+// The receiver applies a request only to an end it has registered itself (a
+// link of a pod on this node, from its own Topology), with the same VNI.
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/vishvananda/netlink"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/status"
+
+	mpb "github.com/openconfig/kne/third_party/meshnet/daemon/proto/meshnet/v1beta1"
+	"github.com/openconfig/kne/third_party/meshnet/utils/wireutil"
+)
+
+// Hooks replaced by tests.
+var (
+	// sendCarrier sends req to the daemon at peerIP and reports whether the
+	// peer applied it.
+	sendCarrier = grpcSendCarrier
+	// setLinkCarrier sets the carrier of the interface with an ifindex in a pod netns.
+	setLinkCarrier = wireutil.SetLinkCarrier
+	// watchAdminState watches the admin state of the interfaces in a netns and
+	// calls onEnd when the watch ends.
+	watchAdminState = wireutil.WatchAdminStateNotify
+	// wireIndex returns the ifindex of the VXLAN wire ifName names in nsPath
+	// (following KubeVirt renames) and its VNI, or 0 if there is none.
+	wireIndex = findWireIndex
+	// now is the clock of the idle check.
+	now = time.Now
+)
+
+const (
+	carrierRPCTimeout = 5 * time.Second
+	// carrierGiveUpAfter is the number of failed pushes after which a pusher
+	// waits for the next reconcile pass instead of retrying.
+	carrierGiveUpAfter = 8
+)
+
+var (
+	carrierInitialBackoff = 100 * time.Millisecond
+	carrierMaxBackoff     = 5 * time.Second
+	// carrierIdleAfter is how long an end may go without a reconcile pass
+	// before it is dropped (its link or pod is gone).
+	carrierIdleAfter    = 5 * time.Minute
+	carrierIdleInterval = time.Minute
+	// unsupportedPeerFor is how long a peer that answered Unimplemented is left
+	// alone. It is about one reconcile pass: a daemon that is rolled to a version
+	// with the RPC is found again by the next pass, or at once when it asks for our
+	// state (SetLinkCarrier clears the mark).
+	unsupportedPeerFor = time.Minute
+)
+
+// LinkEnd names the local end of a cross-node VXLAN link and the end it
+// connects to.
+type LinkEnd struct {
+	NetNs     string // the local pod netns path
+	IntfName  string // the local pod-side interface
+	Vni       int64
+	LinkUID   int64
+	KubeNs    string // the topology namespace
+	PeerIP    string // the node IP of the daemon that owns the peer end
+	PeerNetNs string // the peer pod netns path, on the peer node
+	PeerIntf  string // the peer pod-side interface
+}
+
+func (e LinkEnd) key() string { return e.NetNs + "|" + e.IntfName }
+
+// carrierEnd pushes the admin state of the local end of a link to the peer.
+type carrierEnd struct {
+	notify chan struct{} // capacity 1; signals that state may need sending
+
+	mu          sync.Mutex
+	link        LinkEnd
+	ifindex     int
+	known       bool // adminUp has been observed
+	adminUp     bool
+	dirty       bool // the peer may not have the latest state
+	requestSync bool // ask the peer to send its state back
+	failures    int
+	lastEnsure  time.Time
+
+	// The carrier last applied to this end for the peer (receiver side).
+	// applyMu serializes the check and the kernel call.
+	applyMu    sync.Mutex
+	applied    bool
+	appliedIdx int
+	appliedUp  bool
+
+	stopOnce sync.Once
+	stop     chan struct{}
+}
+
+func newCarrierEnd(l LinkEnd) *carrierEnd {
+	return &carrierEnd{
+		notify:     make(chan struct{}, 1),
+		stop:       make(chan struct{}),
+		link:       l,
+		lastEnsure: now(),
+	}
+}
+
+func (e *carrierEnd) kick() {
+	select {
+	case e.notify <- struct{}{}:
+	default:
+	}
+}
+
+// setAdmin records the admin state of the local end. Only a change is sent.
+func (e *carrierEnd) setAdmin(up bool) {
+	e.mu.Lock()
+	changed := !e.known || e.adminUp != up
+	e.known = true
+	e.adminUp = up
+	if changed {
+		e.dirty = true
+		e.failures = 0
+	}
+	e.mu.Unlock()
+	if changed {
+		e.kick()
+	}
+}
+
+// resend sends the current admin state again. If requestSync is set, the peer
+// is also asked to send its state back.
+func (e *carrierEnd) resend(requestSync bool) {
+	e.mu.Lock()
+	e.dirty = true
+	e.failures = 0
+	if requestSync {
+		e.requestSync = true
+	}
+	e.mu.Unlock()
+	e.kick()
+}
+
+// kickPending retries what is pending, giving a pusher that gave up a new budget.
+func (e *carrierEnd) kickPending() {
+	e.mu.Lock()
+	e.dirty = true
+	e.failures = 0
+	e.mu.Unlock()
+	e.kick()
+}
+
+func (e *carrierEnd) close() { e.stopOnce.Do(func() { close(e.stop) }) }
+
+// next returns the request to send, or false if there is nothing to send yet.
+// It clears the pending state; a failed send restores it with retry.
+func (e *carrierEnd) next() (*mpb.WireCarrier, string, string, bool) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if !e.dirty || !e.known {
+		return nil, "", "", false
+	}
+	e.dirty = false
+	req := &mpb.WireCarrier{
+		LinkUid:     e.link.LinkUID,
+		TopoNs:      e.link.KubeNs,
+		PeerAdminUp: e.adminUp,
+		RequestSync: e.requestSync,
+		NetNs:       e.link.PeerNetNs,
+		IntfName:    e.link.PeerIntf,
+		Vni:         e.link.Vni,
+	}
+	e.requestSync = false
+	return req, e.link.PeerIP, e.link.IntfName, true
+}
+
+// retry restores the pending state of a request that was not applied. After
+// carrierGiveUpAfter failures the end stays quiet until the next change or
+// reconcile pass (see Ensure).
+func (e *carrierEnd) retry(req *mpb.WireCarrier) (giveUp bool) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.failures++
+	if req != nil && req.RequestSync {
+		e.requestSync = true
+	}
+	if e.failures >= carrierGiveUpAfter {
+		return true
+	}
+	e.dirty = true
+	return false
+}
+
+// requeue puts a request that could not be sent back as pending, without
+// counting it as a failed attempt. The state is sent when the peer is next
+// tried (Ensure, or the peer asking for our state).
+func (e *carrierEnd) requeue(req *mpb.WireCarrier) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.dirty = true
+	if req != nil && req.RequestSync {
+		e.requestSync = true
+	}
+}
+
+func (e *carrierEnd) run(r *carrierRegistry) {
+	backoff := carrierInitialBackoff
+	idle := time.NewTicker(carrierIdleInterval)
+	defer idle.Stop()
+	for {
+		select {
+		case <-e.stop:
+			return
+		case <-idle.C:
+			e.mu.Lock()
+			gone := now().Sub(e.lastEnsure) > carrierIdleAfter
+			e.mu.Unlock()
+			if gone {
+				r.remove(e)
+				return
+			}
+			continue
+		case <-e.notify:
+		}
+		for {
+			req, peerIP, ifName, pending := e.next()
+			if !pending {
+				backoff = carrierInitialBackoff
+				break
+			}
+			if r.peerUnsupported(peerIP) {
+				e.requeue(req)
+				break
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), carrierRPCTimeout)
+			applied, err := sendCarrier(ctx, peerIP, req)
+			cancel()
+			if status.Code(err) == codes.Unimplemented {
+				r.markUnsupported(peerIP)
+				e.requeue(req)
+				break
+			}
+			if err == nil && applied {
+				vxLanOvrlyLogger.Infof("[CARRIER] sent admin up=%t of %s (link %d) to peer %s", req.PeerAdminUp, ifName, req.LinkUid, peerIP)
+				e.mu.Lock()
+				e.failures = 0
+				e.mu.Unlock()
+				backoff = carrierInitialBackoff
+				continue
+			}
+			vxLanOvrlyLogger.Debugf("[CARRIER] peer %s did not apply admin up=%t for link %d (err: %v), retrying in %v", peerIP, req.PeerAdminUp, req.LinkUid, err, backoff)
+			if e.retry(req) {
+				vxLanOvrlyLogger.Warnf("[CARRIER] peer %s did not apply the state of link %d (%s); will try again on the next reconcile pass", peerIP, req.LinkUid, ifName)
+				break
+			}
+			select {
+			case <-e.stop:
+				return
+			case <-time.After(backoff):
+			}
+			backoff *= 2
+			if backoff > carrierMaxBackoff {
+				backoff = carrierMaxBackoff
+			}
+		}
+	}
+}
+
+// nsWatch is the admin-state watch of one pod network namespace.
+type nsWatch struct {
+	stop    func()
+	ends    map[string]*carrierEnd // by interface name
+	adminUp map[string]bool        // last observed admin state by interface name
+}
+
+// carrierRegistry tracks the VXLAN ends whose admin state is being watched.
+type carrierRegistry struct {
+	mu          sync.Mutex
+	watches     map[string]*nsWatch // by netns path
+	unsupported map[string]time.Time
+	wg          sync.WaitGroup // the end goroutines
+}
+
+func newCarrierRegistry() *carrierRegistry {
+	return &carrierRegistry{
+		watches:     map[string]*nsWatch{},
+		unsupported: map[string]time.Time{},
+	}
+}
+
+// Carriers is the daemon's registry of VXLAN link ends.
+var Carriers = newCarrierRegistry()
+
+// onAdminChange is called by the watch of netNS.
+func (r *carrierRegistry) onAdminChange(netNS, ifName string, adminUp bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	nw, ok := r.watches[netNS]
+	if !ok {
+		return
+	}
+	nw.adminUp[ifName] = adminUp
+	if e := nw.ends[ifName]; e != nil {
+		e.setAdmin(adminUp)
+	}
+}
+
+func (r *carrierRegistry) peerUnsupported(peerIP string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.peerUnsupportedLocked(peerIP)
+}
+
+func (r *carrierRegistry) peerUnsupportedLocked(peerIP string) bool {
+	until, ok := r.unsupported[peerIP]
+	return ok && now().Before(until)
+}
+
+func (r *carrierRegistry) markUnsupported(peerIP string) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if until, ok := r.unsupported[peerIP]; !ok || !now().Before(until) {
+		vxLanOvrlyLogger.Warnf("[CARRIER] peer %s does not support SetWireCarrier; carrier of links to it will not follow their peer", peerIP)
+	}
+	r.unsupported[peerIP] = now().Add(unsupportedPeerFor)
+}
+
+// Ensure registers the local end of a link, or refreshes its registration. The
+// reconciler calls it for every cross-node VXLAN link on every pass, after the
+// link has been created or confirmed.
+func (r *carrierRegistry) Ensure(l LinkEnd) {
+	if isKubeVirtWire(l.IntfName) {
+		return // see the KubeVirt note at the top of this file
+	}
+	index, _ := wireIndex(l.NetNs, l.IntfName)
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	nw, ok := r.watches[l.NetNs]
+	if !ok {
+		nw = &nsWatch{ends: map[string]*carrierEnd{}, adminUp: map[string]bool{}}
+		// The watch reports existing interfaces from its own goroutine, which
+		// needs r.mu in onAdminChange, so it only starts reporting once we return.
+		netNS, w := l.NetNs, nw
+		stop, err := watchAdminState(l.NetNs, func(ifName string, adminUp bool) {
+			r.onAdminChange(netNS, ifName, adminUp)
+		}, func() { r.watchEnded(netNS, w) })
+		if err != nil {
+			vxLanOvrlyLogger.Warnf("[CARRIER] cannot watch admin state of %s in %s; peer carrier will not follow it: %v", l.IntfName, l.NetNs, err)
+			return
+		}
+		nw.stop = stop
+		r.watches[l.NetNs] = nw
+	}
+	e, exists := nw.ends[l.IntfName]
+	if !exists {
+		e = newCarrierEnd(l)
+		nw.ends[l.IntfName] = e
+		r.wg.Add(1)
+		go func() {
+			defer r.wg.Done()
+			e.run(r)
+		}()
+	}
+	e.mu.Lock()
+	e.lastEnsure = now()
+	recreated := exists && (e.ifindex != index || e.link.PeerIP != l.PeerIP || e.link.PeerNetNs != l.PeerNetNs ||
+		e.link.PeerIntf != l.PeerIntf || e.link.Vni != l.Vni)
+	retryable := exists && (e.failures >= carrierGiveUpAfter || (e.dirty && !r.peerUnsupportedLocked(l.PeerIP)))
+	e.link = l
+	e.ifindex = index
+	e.mu.Unlock()
+	if up, known := nw.adminUp[l.IntfName]; known && !exists {
+		e.setAdmin(up)
+	}
+	switch {
+	case !exists, recreated:
+		// A new end has not had the peer's state yet; ask for it.
+		e.resend(true)
+	case retryable:
+		e.kickPending()
+	}
+}
+
+// watchEnded drops the watch of a netns that ended without being stopped (the
+// netlink subscription failed, or the netns went away) together with its ends,
+// so that the next reconcile pass starts a new watch and re-syncs both sides.
+func (r *carrierRegistry) watchEnded(netNS string, nw *nsWatch) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.watches[netNS] != nw {
+		return // stopped on purpose, or already replaced
+	}
+	vxLanOvrlyLogger.Infof("[CARRIER] admin-state watch of %s ended; it is started again on the next reconcile pass", netNS)
+	delete(r.watches, netNS)
+	for _, e := range nw.ends {
+		e.close()
+	}
+}
+
+// isKubeVirtWire reports whether ifName is the name meshnet gives the wire of
+// a KubeVirt VM pod (see kubevirt_slot.go).
+func isKubeVirtWire(ifName string) bool {
+	nic, _ := kubevirtNames(ifName)
+	return nic != ""
+}
+
+// shutdown stops every end and waits for them. The daemon never calls it; tests do.
+func (r *carrierRegistry) shutdown() {
+	r.mu.Lock()
+	for _, nw := range r.watches {
+		for _, e := range nw.ends {
+			e.close()
+		}
+	}
+	r.mu.Unlock()
+	r.wg.Wait()
+}
+
+// remove drops an end that stopped being reconciled.
+func (r *carrierRegistry) remove(e *carrierEnd) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	e.mu.Lock()
+	l := e.link
+	e.mu.Unlock()
+	nw, ok := r.watches[l.NetNs]
+	if !ok || nw.ends[l.IntfName] != e {
+		return
+	}
+	delete(nw.ends, l.IntfName)
+	e.close()
+	if len(nw.ends) == 0 {
+		delete(r.watches, l.NetNs)
+		if nw.stop != nil {
+			// stop waits for the watch goroutine, which may be waiting for r.mu.
+			go nw.stop()
+		}
+	}
+}
+
+// peerSpoke is called when the peer of the local end (netNS, ifName) has just
+// sent us a request in the VXLAN form, so it supports it: forget any mark that
+// it does not, and send our state if a send was held back. sync asks for our
+// state to be sent again regardless.
+func (r *carrierRegistry) peerSpoke(netNS, ifName string, sync bool) {
+	r.mu.Lock()
+	nw := r.watches[netNS]
+	var e *carrierEnd
+	if nw != nil {
+		e = nw.ends[ifName]
+	}
+	if e != nil {
+		e.mu.Lock()
+		peerIP := e.link.PeerIP
+		e.mu.Unlock()
+		delete(r.unsupported, peerIP)
+	}
+	r.mu.Unlock()
+	if e == nil {
+		return
+	}
+	e.mu.Lock()
+	pending := e.dirty
+	e.mu.Unlock()
+	if sync || pending {
+		e.resend(false)
+	}
+}
+
+// SetLinkCarrier applies the admin state of the peer's end of a VXLAN link as
+// the carrier of the local end named by req. It reports whether the request
+// was applied. Only an end this daemon registered (Ensure) with the same VNI is
+// touched; the kernel call is made only when the state differs from what was
+// last applied to that interface (same ifindex).
+func (r *carrierRegistry) SetLinkCarrier(req *mpb.WireCarrier) (bool, error) {
+	nsPath, ifName := req.GetNetNs(), req.GetIntfName()
+	if nsPath == "" || ifName == "" || req.GetVni() == 0 {
+		return false, nil
+	}
+	if isKubeVirtWire(ifName) {
+		// A VM end does not follow its peer (see the top of this file). Say it
+		// was applied so that the sender does not retry.
+		return true, nil
+	}
+	r.mu.Lock()
+	var e *carrierEnd
+	if nw := r.watches[nsPath]; nw != nil {
+		e = nw.ends[ifName]
+	}
+	r.mu.Unlock()
+	if e == nil {
+		vxLanOvrlyLogger.Debugf("[CARRIER] SetLinkCarrier: %s in %s is not a link end of this node (link %d)", ifName, nsPath, req.GetLinkUid())
+		return false, nil
+	}
+	up := req.GetPeerAdminUp()
+	e.applyMu.Lock()
+	index, vni := wireIndex(nsPath, ifName)
+	if index == 0 || vni != req.GetVni() {
+		// Missing, or re-created for another link: never touch it.
+		e.applyMu.Unlock()
+		vxLanOvrlyLogger.Debugf("[CARRIER] SetLinkCarrier: no VXLAN %s with VNI %d in %s (link %d)", ifName, req.GetVni(), nsPath, req.GetLinkUid())
+		return false, nil
+	}
+	if !e.applied || e.appliedIdx != index || e.appliedUp != up {
+		if err := setLinkCarrier(nsPath, index, up); err != nil {
+			e.applyMu.Unlock()
+			return false, fmt.Errorf("setting carrier of %s in %s: %w", ifName, nsPath, err)
+		}
+		e.applied, e.appliedIdx, e.appliedUp = true, index, up
+		vxLanOvrlyLogger.Infof("[CARRIER] set carrier of %s (link %d) to %t", ifName, req.GetLinkUid(), up)
+	}
+	e.applyMu.Unlock()
+	r.peerSpoke(nsPath, ifName, req.GetRequestSync())
+	return true, nil
+}
+
+// findWireIndex returns the ifindex and VNI of the VXLAN wire named ifName in
+// the pod netns nsPath, following KubeVirt renames (resolveSlot).
+func findWireIndex(nsPath, ifName string) (int, int64) {
+	slot := resolveSlot(func(name string) netlink.Link { return getLinkFromNS(nsPath, name) }, ifName)
+	v, ok := slot.found.(*netlink.Vxlan)
+	if !ok {
+		return 0, 0
+	}
+	return v.Attrs().Index, int64(v.VxlanId)
+}
+
+// peer connections are cached by address.
+var carrierConns = struct {
+	mu    sync.Mutex
+	conns map[string]*grpc.ClientConn
+}{conns: map[string]*grpc.ClientConn{}}
+
+func carrierConn(peerIP string) (*grpc.ClientConn, error) {
+	url := strings.TrimSpace(fmt.Sprintf("%s:%d", peerIP, wireutil.GRPCDefaultPort))
+	carrierConns.mu.Lock()
+	defer carrierConns.mu.Unlock()
+	if c, ok := carrierConns.conns[url]; ok {
+		return c, nil
+	}
+	c, err := grpc.NewClient(url, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		return nil, err
+	}
+	carrierConns.conns[url] = c
+	return c, nil
+}
+
+func grpcSendCarrier(ctx context.Context, peerIP string, req *mpb.WireCarrier) (bool, error) {
+	conn, err := carrierConn(peerIP)
+	if err != nil {
+		return false, err
+	}
+	resp, err := mpb.NewRemoteClient(conn).SetWireCarrier(ctx, req)
+	if err != nil {
+		return false, err
+	}
+	return resp.GetResponse(), nil
+}
diff --git a/third_party/meshnet/daemon/vxlan/carrier_test.go b/third_party/meshnet/daemon/vxlan/carrier_test.go
new file mode 100644
index 0000000..82f6544
--- /dev/null
+++ b/third_party/meshnet/daemon/vxlan/carrier_test.go
@@ -0,0 +1,558 @@
+package vxlan
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	mpb "github.com/openconfig/kne/third_party/meshnet/daemon/proto/meshnet/v1beta1"
+	"github.com/openconfig/kne/third_party/meshnet/utils/wireutil"
+)
+
+// fakeKernel models the parts of two nodes' kernels the carrier code uses: pod
+// netns with VXLAN interfaces that have an admin state and a carrier. Setting
+// carrier never reports an admin change, which is how the real watch behaves
+// (WatchAdminState ignores IFF_LOWER_UP).
+type fakeKernel struct {
+	mu           sync.Mutex
+	links        map[string]*fakeLink // ns|name
+	watchers     map[string][]func(string, bool)
+	onEnd        map[string][]func()
+	nextIdx      int
+	carrierCalls int
+}
+
+type fakeLink struct {
+	index   int
+	vni     int64
+	adminUp bool
+	carrier bool
+}
+
+func newFakeKernel() *fakeKernel {
+	return &fakeKernel{links: map[string]*fakeLink{}, watchers: map[string][]func(string, bool){}, onEnd: map[string][]func(){}, nextIdx: 10}
+}
+
+func (k *fakeKernel) addLink(ns, name string, vni int64) {
+	k.mu.Lock()
+	k.nextIdx++
+	k.links[ns+"|"+name] = &fakeLink{index: k.nextIdx, vni: vni, adminUp: true, carrier: true}
+	cbs := append([]func(string, bool){}, k.watchers[ns]...)
+	k.mu.Unlock()
+	for _, cb := range cbs {
+		cb(name, true)
+	}
+}
+
+// recreate deletes and re-adds a link: a new ifindex, admin up, carrier on.
+func (k *fakeKernel) recreate(ns, name string) {
+	k.mu.Lock()
+	vni := k.links[ns+"|"+name].vni
+	delete(k.links, ns+"|"+name)
+	k.mu.Unlock()
+	k.addLink(ns, name, vni)
+}
+
+func (k *fakeKernel) setAdmin(ns, name string, up bool) {
+	k.mu.Lock()
+	k.links[ns+"|"+name].adminUp = up
+	cbs := append([]func(string, bool){}, k.watchers[ns]...)
+	k.mu.Unlock()
+	for _, cb := range cbs {
+		cb(name, up)
+	}
+}
+
+func (k *fakeKernel) carrier(ns, name string) bool {
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	return k.links[ns+"|"+name].carrier
+}
+
+func (k *fakeKernel) watch(ns string, cb wireutil.AdminStateFunc, onEnd func()) (func(), error) {
+	k.mu.Lock()
+	k.watchers[ns] = append(k.watchers[ns], cb)
+	k.onEnd[ns] = append(k.onEnd[ns], onEnd)
+	existing := map[string]bool{}
+	for key, l := range k.links {
+		if len(key) > len(ns) && key[:len(ns)+1] == ns+"|" {
+			existing[key[len(ns)+1:]] = l.adminUp
+		}
+	}
+	k.mu.Unlock()
+	go func() {
+		for name, up := range existing {
+			cb(name, up)
+		}
+	}()
+	return func() {}, nil
+}
+
+func (k *fakeKernel) index(ns, name string) (int, int64) {
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	if l, ok := k.links[ns+"|"+name]; ok {
+		return l.index, l.vni
+	}
+	return 0, 0
+}
+
+// setCarrier acts on the link with that ifindex in ns, as the kernel does: a
+// call by a stale index does not reach a link that now holds the same name.
+func (k *fakeKernel) setCarrier(ns string, index int, up bool) error {
+	k.mu.Lock()
+	defer k.mu.Unlock()
+	for key, l := range k.links {
+		if strings.HasPrefix(key, ns+"|") && l.index == index {
+			l.carrier = up
+			k.carrierCalls++
+			return nil
+		}
+	}
+	return fmt.Errorf("no ifindex %d in %s", index, ns)
+}
+
+// endWatches ends every watch of ns as a failed netlink subscription does.
+func (k *fakeKernel) endWatches(ns string) {
+	k.mu.Lock()
+	ends := k.onEnd[ns]
+	delete(k.onEnd, ns)
+	delete(k.watchers, ns)
+	k.mu.Unlock()
+	for _, f := range ends {
+		f()
+	}
+}
+
+// cluster is two nodes, A (10.0.0.1) and B (10.0.0.2), with one link between
+// pod-a/eth1 and pod-b/eth1.
+type cluster struct {
+	k      *fakeKernel
+	reg    map[string]*carrierRegistry // by node IP
+	mu     sync.Mutex
+	sent   []string // "A->B up=false"
+	sendFn func(peerIP string, req *mpb.WireCarrier) (bool, error)
+	old    []*carrierRegistry // registries of restarted daemons
+}
+
+const (
+	nsA, nsB = "/ns/a", "/ns/b"
+	ipA, ipB = "10.0.0.1", "10.0.0.2"
+	linkVni  = 5001
+	linkUID  = 7
+)
+
+func newCluster(t *testing.T) *cluster {
+	t.Helper()
+	InitLogger()
+	c := &cluster{k: newFakeKernel(), reg: map[string]*carrierRegistry{ipA: newCarrierRegistry(), ipB: newCarrierRegistry()}}
+	oldSend, oldSet, oldWatch, oldIdx := sendCarrier, setLinkCarrier, watchAdminState, wireIndex
+	oldBackoff, oldMax := carrierInitialBackoff, carrierMaxBackoff
+	carrierInitialBackoff, carrierMaxBackoff = time.Millisecond, 5*time.Millisecond
+	sendCarrier = func(ctx context.Context, peerIP string, req *mpb.WireCarrier) (bool, error) {
+		from := ipA
+		if peerIP == ipA {
+			from = ipB
+		}
+		c.mu.Lock()
+		c.sent = append(c.sent, fmt.Sprintf("%s->%s up=%t sync=%t", from, peerIP, req.GetPeerAdminUp(), req.GetRequestSync()))
+		fn := c.sendFn
+		c.mu.Unlock()
+		if fn != nil {
+			return fn(peerIP, req)
+		}
+		return c.reg[peerIP].SetLinkCarrier(req)
+	}
+	setLinkCarrier = c.k.setCarrier
+	watchAdminState = c.k.watch
+	wireIndex = c.k.index
+	t.Cleanup(func() {
+		c.mu.Lock()
+		regs := append([]*carrierRegistry{}, c.old...)
+		for _, r := range c.reg {
+			regs = append(regs, r)
+		}
+		c.mu.Unlock()
+		for _, r := range regs {
+			r.shutdown()
+		}
+		sendCarrier, setLinkCarrier, watchAdminState, wireIndex = oldSend, oldSet, oldWatch, oldIdx
+		carrierInitialBackoff, carrierMaxBackoff = oldBackoff, oldMax
+	})
+	c.k.addLink(nsA, "eth1", linkVni)
+	c.k.addLink(nsB, "eth1", linkVni)
+	return c
+}
+
+// restart replaces a node's daemon state with a fresh registry.
+func (c *cluster) restart(ip string) {
+	c.mu.Lock()
+	c.old = append(c.old, c.reg[ip])
+	c.reg[ip] = newCarrierRegistry()
+	c.mu.Unlock()
+}
+
+func (c *cluster) endA() LinkEnd {
+	return LinkEnd{NetNs: nsA, IntfName: "eth1", Vni: linkVni, LinkUID: linkUID, KubeNs: "lab", PeerIP: ipB, PeerNetNs: nsB, PeerIntf: "eth1"}
+}
+func (c *cluster) endB() LinkEnd {
+	return LinkEnd{NetNs: nsB, IntfName: "eth1", Vni: linkVni, LinkUID: linkUID, KubeNs: "lab", PeerIP: ipA, PeerNetNs: nsA, PeerIntf: "eth1"}
+}
+
+// ensureBoth runs a reconcile pass on both nodes and waits until each daemon
+// has sent the initial state of its end (the watch reports existing links
+// asynchronously, as the real one does).
+func (c *cluster) ensureBoth() {
+	c.reg[ipA].Ensure(c.endA())
+	c.reg[ipB].Ensure(c.endB())
+	deadline := time.Now().Add(3 * time.Second)
+	for (c.count("10.0.0.1->") < 1 || c.count("10.0.0.2->") < 1) && time.Now().Before(deadline) {
+		time.Sleep(2 * time.Millisecond)
+	}
+	quiet()
+}
+func (c *cluster) sends() []string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]string{}, c.sent...)
+}
+func (c *cluster) count(prefix string) int {
+	n := 0
+	for _, s := range c.sends() {
+		if len(s) >= len(prefix) && s[:len(prefix)] == prefix {
+			n++
+		}
+	}
+	return n
+}
+
+func eventually(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		if cond() {
+			return
+		}
+		time.Sleep(2 * time.Millisecond)
+	}
+	t.Fatalf("timed out waiting for %s", what)
+}
+
+// quiet waits long enough for a wrongly sent push to have happened.
+func quiet() { time.Sleep(60 * time.Millisecond) }
+
+func TestCarrierFollowsPeerAdminStateBothDirections(t *testing.T) {
+	c := newCluster(t)
+	c.ensureBoth()
+	eventually(t, "initial state pushed", func() bool { return c.count("10.0.0.1->") >= 1 && c.count("10.0.0.2->") >= 1 })
+	quiet()
+	if !c.k.carrier(nsA, "eth1") || !c.k.carrier(nsB, "eth1") {
+		t.Fatal("both ends are admin up, so both must have carrier")
+	}
+
+	c.k.setAdmin(nsA, "eth1", false) // NOS shutdown on A
+	eventually(t, "B NO-CARRIER after A admin down", func() bool { return !c.k.carrier(nsB, "eth1") })
+	if !c.k.carrier(nsA, "eth1") {
+		t.Fatal("A's own carrier must not follow its own admin state")
+	}
+	c.k.setAdmin(nsA, "eth1", true)
+	eventually(t, "B carrier back after A admin up", func() bool { return c.k.carrier(nsB, "eth1") })
+
+	c.k.setAdmin(nsB, "eth1", false)
+	eventually(t, "A NO-CARRIER after B admin down", func() bool { return !c.k.carrier(nsA, "eth1") })
+	if !c.k.carrier(nsB, "eth1") {
+		t.Fatal("B's own carrier must not follow its own admin state")
+	}
+	c.k.setAdmin(nsB, "eth1", true)
+	eventually(t, "A carrier back after B admin up", func() bool { return c.k.carrier(nsA, "eth1") })
+}
+
+func TestCarrierDoesNotLoopOrRepeat(t *testing.T) {
+	c := newCluster(t)
+	c.ensureBoth()
+	eventually(t, "initial pushes", func() bool { return c.count("10.0.0.1->") >= 1 && c.count("10.0.0.2->") >= 1 })
+	quiet()
+	baseA, baseB, baseCalls := c.count("10.0.0.1->"), c.count("10.0.0.2->"), c.k.carrierCalls
+
+	c.k.setAdmin(nsA, "eth1", false)
+	eventually(t, "B NO-CARRIER", func() bool { return !c.k.carrier(nsB, "eth1") })
+	// The same admin state reported again (a netlink flag-only update) sends nothing.
+	c.k.setAdmin(nsA, "eth1", false)
+	c.k.setAdmin(nsA, "eth1", false)
+	quiet()
+	if got := c.count("10.0.0.1->") - baseA; got != 1 {
+		t.Errorf("A sent %d pushes for one admin change, want 1", got)
+	}
