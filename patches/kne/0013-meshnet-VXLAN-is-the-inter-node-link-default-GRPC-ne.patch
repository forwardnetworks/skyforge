diff --git a/third_party/meshnet/manifests/link_type_test.go b/third_party/meshnet/manifests/link_type_test.go
new file mode 100644
index 0000000..ac57362
--- /dev/null
+++ b/third_party/meshnet/manifests/link_type_test.go
@@ -0,0 +1,92 @@
+package manifests
+
+import (
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// The requirement (KNE rebase plan R4): the meshnet DaemonSet that ships
+// without an overlay carries INTER_NODE_LINK_TYPE=VXLAN, and GRPC is selected
+// only by an overlay that says so. A manifest that quietly ships GRPC is the
+// failure this test exists to stop.
+var envValue = regexp.MustCompile(`^\s*value:\s*(\S+)\s*$`)
+
+// linkTypeValue returns the value of INTER_NODE_LINK_TYPE in a manifest, or
+// "" when the manifest does not set it. A commented-out line never counts.
+func linkTypeValue(t *testing.T, path string) string {
+	t.Helper()
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	lines := strings.Split(string(raw), "\n")
+	for i, line := range lines {
+		if strings.TrimSpace(line) != "- name: INTER_NODE_LINK_TYPE" && strings.TrimSpace(line) != "name: INTER_NODE_LINK_TYPE" {
+			continue
+		}
+		for _, next := range lines[i+1:] {
+			if m := envValue.FindStringSubmatch(next); m != nil {
+				return strings.Trim(m[1], `"'`)
+			}
+			if strings.TrimSpace(next) == "" || strings.HasPrefix(strings.TrimSpace(next), "#") {
+				continue
+			}
+			break
+		}
+	}
+	return ""
+}
+
+func TestBaseDaemonSetDefaultsToVXLAN(t *testing.T) {
+	got := linkTypeValue(t, "base/daemonset.yaml")
+	if got != "VXLAN" {
+		t.Fatalf("base DaemonSet INTER_NODE_LINK_TYPE = %q, want VXLAN", got)
+	}
+}
+
+// GRPC is allowed only where an overlay names it. Walk every manifest and
+// fail on a GRPC value outside an overlay directory.
+func TestGRPCOnlyFromExplicitOverlay(t *testing.T) {
+	var checked int
+	err := filepath.WalkDir(".", func(path string, d os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() || !strings.HasSuffix(path, ".yaml") {
+			return nil
+		}
+		if strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		v := linkTypeValue(t, path)
+		if v == "" {
+			return nil
+		}
+		checked++
+		if v == "GRPC" && !strings.HasPrefix(path, filepath.Join("overlays", "grpc-link")) {
+			t.Errorf("%s selects GRPC inter-node links without an explicit grpc-link overlay", path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if checked == 0 {
+		t.Fatal("found no manifest that sets INTER_NODE_LINK_TYPE; the gate would pass over nothing")
+	}
+}
+
+// Positive control for the overlay: the grpc-link overlay must still select
+// GRPC, so the gate above is not passing because no overlay sets it.
+func TestGRPCOverlaySelectsGRPC(t *testing.T) {
+	raw, err := os.ReadFile(filepath.Join("overlays", "grpc-link", "kustomization.yaml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), "value: GRPC") {
+		t.Fatal("grpc-link overlay no longer selects GRPC")
+	}
+}
