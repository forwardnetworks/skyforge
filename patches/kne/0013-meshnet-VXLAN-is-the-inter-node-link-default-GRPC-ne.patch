diff --git a/third_party/meshnet/utils/wireutil/inter_node_link.go b/third_party/meshnet/utils/wireutil/inter_node_link.go
new file mode 100644
index 0000000..21bc48a
--- /dev/null
+++ b/third_party/meshnet/utils/wireutil/inter_node_link.go
@@ -0,0 +1,26 @@
+package wireutil
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ResolveInterNodeLinkType maps the INTER_NODE_LINK_TYPE value to the link type
+// used for cross-node links. VXLAN is the default: an unset or empty value is
+// VXLAN. Only the exact value GRPC selects the gRPC wire overlay. Any other
+// value is an error, so a typo such as "grpc" cannot silently pick VXLAN or
+// GRPC without the operator asking for it.
+//
+// Upstream's own default was GRPC. Skyforge runs VXLAN (MTU 1450 on a 1500
+// underlay; see the KNE rebase plan R4), and the manifests set it explicitly.
+func ResolveInterNodeLinkType(value string) (string, error) {
+	v := strings.TrimSpace(value)
+	switch v {
+	case "", INTER_NODE_LINK_VXLAN:
+		return INTER_NODE_LINK_VXLAN, nil
+	case INTER_NODE_LINK_GRPC:
+		return INTER_NODE_LINK_GRPC, nil
+	default:
+		return "", fmt.Errorf("INTER_NODE_LINK_TYPE must be %q, %q or unset, got %q", INTER_NODE_LINK_VXLAN, INTER_NODE_LINK_GRPC, value)
+	}
+}
diff --git a/third_party/meshnet/utils/wireutil/inter_node_link_test.go b/third_party/meshnet/utils/wireutil/inter_node_link_test.go
new file mode 100644
index 0000000..bd28d4a
--- /dev/null
+++ b/third_party/meshnet/utils/wireutil/inter_node_link_test.go
@@ -0,0 +1,36 @@
+package wireutil
+
+import "testing"
+
+// The requirement: unset means VXLAN, GRPC needs the explicit word, and
+// anything else is refused rather than guessed.
+func TestResolveInterNodeLinkType(t *testing.T) {
+	cases := []struct {
+		name    string
+		value   string
+		want    string
+		wantErr bool
+	}{
+		{name: "unset defaults to VXLAN", value: "", want: INTER_NODE_LINK_VXLAN},
+		{name: "blank defaults to VXLAN", value: "  ", want: INTER_NODE_LINK_VXLAN},
+		{name: "explicit VXLAN", value: "VXLAN", want: INTER_NODE_LINK_VXLAN},
+		{name: "explicit GRPC", value: "GRPC", want: INTER_NODE_LINK_GRPC},
+		{name: "GRPC with surrounding space", value: " GRPC\n", want: INTER_NODE_LINK_GRPC},
+		{name: "lowercase grpc is refused", value: "grpc", wantErr: true},
+		{name: "unknown value is refused", value: "VXLANX", wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ResolveInterNodeLinkType(tc.value)
+			if tc.wantErr {
+				if err == nil {
+					t.Fatalf("ResolveInterNodeLinkType(%q) = %q, want error", tc.value, got)
+				}
+				return
+			}
+			if err != nil || got != tc.want {
+				t.Fatalf("ResolveInterNodeLinkType(%q) = %q, %v; want %q", tc.value, got, err, tc.want)
+			}
+		})
+	}
+}
