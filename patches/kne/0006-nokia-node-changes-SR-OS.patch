+func TestDeleteSROSUsesKubeVirtDeletePath(t *testing.T) {
+	ctx := context.Background()
+	client := fake.NewSimpleClientset(&corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "service-sros1",
+			Namespace: "test-ns",
+		},
+	})
+	n := &Node{
+		Impl: &node.Impl{
+			KubeClient: client,
+			Namespace:  "test-ns",
+			RestConfig: &rest.Config{Host: "http://127.0.0.1:1"},
+			Proto: &topopb.Node{
+				Name:   "sros1",
+				Vendor: topopb.Vendor_NOKIA,
+				Model:  "sros",
+				Config: &topopb.Config{Image: "registry.example.com/skyforge/kubevirt/vr-sros:22.10.R2-eve-l1"},
+			},
+		},
+	}
+
+	// Upstream Impl.Delete returns the joined service and resource errors
+	// (it used to log and return nil). The RestConfig points at a dead
+	// endpoint, so the VirtualMachine delete must fail, and that error must
+	// surface. The service delete runs first and must still happen.
+	err := n.Delete(ctx)
+	if err == nil || !strings.Contains(err.Error(), "error deleting resource") {
+		t.Fatalf("Delete() error = %v, want the resource delete error", err)
+	}
+	if _, err := client.CoreV1().Services("test-ns").Get(ctx, "service-sros1", metav1.GetOptions{}); err == nil {
+		t.Fatal("Delete() did not delete SROS service through generic KubeVirt path")
+	}
+}
