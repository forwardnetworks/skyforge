+func TestFailedKubeVirtLauncherPodDoesNotCancelWatcher(t *testing.T) {
+	var buf strings.Builder
+	canceled := false
+	cancel := func() { canceled = true }
+	stop := func() {}
+
+	w := newWatcher(context.TODO(), cancel, nil, stop)
+	w.stdout = &buf
+	w.SetProgress(true)
+	w.warningf = func(f string, v ...any) {
+		fmt.Fprintf(&buf, f+"\n", v...)
+	}
+
+	ok := w.updatePod(&PodStatus{
+		Name:      "virt-launcher-node-abcde",
+		UID:       types.UID("uid-virt-launcher"),
+		Namespace: "ns",
+		Phase:     PodFailed,
+		Pod: corev1.Pod{
+			ObjectMeta: metav1.ObjectMeta{
+				Labels: map[string]string{
+					"kubevirt.io":         "virt-launcher",
+					"vm.kubevirt.io/name": "node",
+				},
+				OwnerReferences: []metav1.OwnerReference{{
+					APIVersion: "kubevirt.io/v1",
+					Kind:       "VirtualMachineInstance",
+					Name:       "node",
+				}},
+			},
+		},
+	})
+	if !ok {
+		t.Fatalf("updatePod returned false for retryable KubeVirt launcher failure")
+	}
+	if canceled {
+		t.Fatalf("watcher canceled on retryable KubeVirt launcher failure")
+	}
+	select {
+	case err := <-w.errCh:
+		t.Fatalf("unexpected watcher error: %v", err)
+	default:
+	}
+	if got := buf.String(); !strings.Contains(got, "Ignoring failed KubeVirt launcher pod virt-launcher-node-abcde") {
+		t.Fatalf("missing retry warning in output: %q", got)
+	}
+}
