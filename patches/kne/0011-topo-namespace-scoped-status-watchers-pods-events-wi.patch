+type meshnetCreateSpy struct {
+	mu         sync.Mutex
+	current    int
+	maxCurrent int
+	started    chan struct{}
+	release    chan struct{}
+}
+
+// blockingMeshnetDynamicClient wraps a dynamic client so every topology create
+// blocks until the spy releases it, recording the peak concurrency. It wraps
+// the Create call itself: the fake client's reactor chain holds a lock, which
+// would serialize the creates this test exists to observe.
+type blockingMeshnetDynamicClient struct {
+	dynamic.Interface
+	spy *meshnetCreateSpy
+}
+
+func (b blockingMeshnetDynamicClient) Resource(gvr schema.GroupVersionResource) dynamic.NamespaceableResourceInterface {
+	return blockingMeshnetNamespaceable{NamespaceableResourceInterface: b.Interface.Resource(gvr), spy: b.spy}
+}
+
+type blockingMeshnetNamespaceable struct {
+	dynamic.NamespaceableResourceInterface
+	spy *meshnetCreateSpy
+}
+
+func (n blockingMeshnetNamespaceable) Namespace(ns string) dynamic.ResourceInterface {
+	return blockingMeshnetResource{ResourceInterface: n.NamespaceableResourceInterface.Namespace(ns), spy: n.spy}
+}
+
+type blockingMeshnetResource struct {
+	dynamic.ResourceInterface
+	spy *meshnetCreateSpy
+}
+
+func (r blockingMeshnetResource) Create(_ context.Context, obj *unstructured.Unstructured, _ metav1.CreateOptions, _ ...string) (*unstructured.Unstructured, error) {
+	r.spy.mu.Lock()
+	r.spy.current++
+	if r.spy.current > r.spy.maxCurrent {
+		r.spy.maxCurrent = r.spy.current
+	}
+	r.spy.mu.Unlock()
+	r.spy.started <- struct{}{}
+	<-r.spy.release
+	r.spy.mu.Lock()
+	r.spy.current--
+	r.spy.mu.Unlock()
+	return obj, nil
+}
+
+func TestCreateMeshnetTopologiesWithLimitParallelizesCreates(t *testing.T) {
+	spy := &meshnetCreateSpy{
+		started: make(chan struct{}, 3),
+		release: make(chan struct{}),
+	}
+	m := &Manager{
+		topo:    &tpb.Topology{Name: "test"},
+		dClient: blockingMeshnetDynamicClient{Interface: dfake.NewSimpleDynamicClient(topologyv1.Scheme), spy: spy},
+	}
+	topologies := []*topologyv1.Topology{
+		{ObjectMeta: metav1.ObjectMeta{Name: "t1"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "t2"}},
+		{ObjectMeta: metav1.ObjectMeta{Name: "t3"}},
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		done <- m.createMeshnetTopologiesWithLimit(context.Background(), topologies)
+	}()
+
+	for range topologies {
+		select {
+		case <-spy.started:
+		case <-time.After(5 * time.Second):
+			t.Fatal("timed out waiting for concurrent meshnet topology create calls")
+		}
+	}
+
+	spy.mu.Lock()
+	if spy.maxCurrent < 2 {
+		t.Fatalf("max concurrent creates = %d, want at least 2", spy.maxCurrent)
+	}
+	spy.mu.Unlock()
+
+	close(spy.release)
+	if err := <-done; err != nil {
+		t.Fatalf("createMeshnetTopologiesWithLimit() failed: %v", err)
+	}
+}
