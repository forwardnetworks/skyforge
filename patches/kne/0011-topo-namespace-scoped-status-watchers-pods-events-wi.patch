+// recreatableNode is a regular (container) node whose Delete/Create/Pods are
+// observable: RecreateNode must delete, wait for the pods to be gone, then
+// create -- in that order -- and never touch anything else on the Manager.
+type recreatableNode struct {
+	*node.Impl
+	name    string
+	calls   []string
+	deleted bool
+	dErr    string
+	cErr    string
+}
+
+func (n *recreatableNode) Name() string { return n.name }
+func (n *recreatableNode) Delete(_ context.Context) error {
+	n.calls = append(n.calls, "delete")
+	if n.dErr != "" {
+		return fmt.Errorf("%s", n.dErr)
+	}
+	n.deleted = true
+	return nil
+}
+func (n *recreatableNode) Create(_ context.Context) error {
+	n.calls = append(n.calls, "create")
+	if n.cErr != "" {
+		return fmt.Errorf("%s", n.cErr)
+	}
+	return nil
+}
+func (n *recreatableNode) Pods(_ context.Context) ([]*corev1.Pod, error) {
+	n.calls = append(n.calls, "pods")
+	if n.deleted {
+		return nil, nil
+	}
+	return []*corev1.Pod{{ObjectMeta: metav1.ObjectMeta{Name: n.name}}}, nil
+}
+
+type kubeVirtRecreatableNode struct {
+	recreatableNode
+}
+
+func (n *kubeVirtRecreatableNode) UsesKubeVirtVM() bool { return true }
+
+func TestRecreateNode(t *testing.T) {
+	regular := &recreatableNode{name: "iol1"}
+	deleteFails := &recreatableNode{name: "iol2", dErr: "api down"}
+	createFails := &recreatableNode{name: "iol3", cErr: "quota"}
+	vm := &kubeVirtRecreatableNode{recreatableNode{name: "vsrx1"}}
+	m := &Manager{nodes: map[string]node.Node{
+		"iol1": regular, "iol2": deleteFails, "iol3": createFails, "vsrx1": vm,
+	}}
+	tests := []struct {
+		desc      string
+		name      string
+		wantErr   string
+		wantCalls []string
+	}{{
+		desc:      "regular node is deleted, waited on, then created",
+		name:      "iol1",
+		wantCalls: []string{"delete", "pods", "create"},
+	}, {
+		desc:      "delete failure stops the rebuild before create",
+		name:      "iol2",
+		wantErr:   "delete regular node iol2 for recovery: api down",
+		wantCalls: []string{"delete"},
+	}, {
+		desc:      "create failure is reported as the recreate step",
+		name:      "iol3",
+		wantErr:   "recreate regular node iol3 for recovery: quota",
+		wantCalls: []string{"delete", "pods", "create"},
+	}, {
+		desc:      "kubevirt node is refused, untouched",
+		name:      "vsrx1",
+		wantErr:   "KubeVirt-backed",
+		wantCalls: nil,
+	}, {
+		desc:    "unknown node is refused by name",
+		name:    "dne",
+		wantErr: "not found",
+	}}
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			err := m.RecreateNode(context.Background(), tt.name)
+			if s := errdiff.Substring(err, tt.wantErr); s != "" {
+				t.Fatalf("RecreateNode(%q): %s", tt.name, s)
+			}
+			var got []string
+			switch n := m.nodes[tt.name].(type) {
+			case *recreatableNode:
+				got = n.calls
+			case *kubeVirtRecreatableNode:
+				got = n.calls
+			}
+			if diff := cmp.Diff(tt.wantCalls, got); diff != "" {
+				t.Fatalf("RecreateNode(%q) call order diff (-want +got):\n%s", tt.name, diff)
+			}
+		})
+	}
+	if _, ok := m.nodes["iol1"]; !ok || len(m.nodes) != 4 {
+		t.Fatalf("RecreateNode must not change the manager's node set: %v", m.nodes)
+	}
+}
