+// n.Delete never calls DeleteConfig (see recreateRegularNode), so a node's
+// "<name>-config" ConfigMap from its first Create survives every delete. A
+// stale one here reproduces the collision recovery must clear before it
+// recreates the node, or CreateConfig's own Create call fails AlreadyExists.
+func TestMaybeRecoverRegularNodeAdmissionClearsStaleConfigMap(t *testing.T) {
+	created := time.Now().Add(-time.Minute)
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:              "r1",
+			Namespace:         "test",
+			CreationTimestamp: metav1.NewTime(created),
+			UID:               "old-pod",
+		},
+		Status: corev1.PodStatus{
+			Phase: corev1.PodPending,
+		},
+	}
+	staleConfigMap := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{Name: "r1-config", Namespace: "test"},
+		Data:       map[string]string{"config": "! stale config from the first create"},
+	}
+	event := &corev1.Event{
+		ObjectMeta: metav1.ObjectMeta{Name: "r1.1", Namespace: "test"},
+		InvolvedObject: corev1.ObjectReference{
+			Kind:      "Pod",
+			Namespace: "test",
+			Name:      pod.Name,
+		},
+		Type:          corev1.EventTypeWarning,
+		Reason:        "FailedCreatePodSandBox",
+		Message:       `plugin type="cilium-cni" failed (add): unable to create endpoint: [429] putEndpointIdTooManyRequests`,
+		LastTimestamp: metav1.Now(),
+	}
+	client := kfake.NewSimpleClientset(pod, staleConfigMap, event)
+	// A config-bearing node: CreateConfig only attempts the ConfigMap create
+	// (the call the stale object collides with) when the proto actually
+	// carries boot config data, unlike regularRecoveryTestNode's bare fixture.
+	n := &configurable{Impl: &node.Impl{
+		Namespace:  "test",
+		KubeClient: client,
+		Proto: &tpb.Node{
+			Name:  "r1",
+			Model: "iol",
+			Config: &tpb.Config{
+				Image:      "ghcr.io/openconfig/network-device:latest",
+				ConfigFile: "startup.cfg",
+				ConfigData: &tpb.Config_Data{Data: []byte("! recreated config\n")},
+			},
+		},
+	}}
+	state := &regularNodeAdmissionRecoveryState{}
+	recovered, err := (&Manager{kClient: client}).maybeRecoverRegularNodeAdmission(context.Background(), context.Background(), n, state)
+	if err != nil {
+		t.Fatalf("maybeRecoverRegularNodeAdmission() error = %v, want recovery to clear the stale config-map and succeed", err)
+	}
+	if !recovered {
+		t.Fatal("maybeRecoverRegularNodeAdmission() recovered = false, want true")
+	}
+	recreated, err := client.CoreV1().Pods("test").Get(context.Background(), "r1", metav1.GetOptions{})
+	if err != nil {
+		t.Fatalf("recreated pod get failed: %v", err)
+	}
+	if recreated.UID == "old-pod" {
+		t.Fatalf("pod UID = %q, want recreated pod", recreated.UID)
+	}
+}
