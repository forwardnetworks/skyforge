+package topo
+
+import (
+	"context"
+	"reflect"
+	"sync"
+	"testing"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+	kfake "k8s.io/client-go/kubernetes/fake"
+)
+
+func TestHeavyCreateGateNodesDefaultIsEveryRegularNode(t *testing.T) {
+	t.Setenv(heavyEarlyCreateEnv, "")
+	heavy := []node.Node{mk("pa", "ceos1")}
+	regular := []node.Node{mk("ceos1", "pa"), mk("ceos2"), mk("h1")}
+	got, _ := heavyCreateGateNodes(heavy, regular)
+	if want := []string{"ceos1", "ceos2", "h1"}; !reflect.DeepEqual(names(got), want) {
+		t.Fatalf("default gate = %v, want every regular node %v", names(got), want)
+	}
+	for _, v := range []string{"false", "0", "garbage", "off"} {
+		t.Setenv(heavyEarlyCreateEnv, v)
+		got, _ := heavyCreateGateNodes(heavy, regular)
+		if len(got) != 3 {
+			t.Fatalf("value %q must keep today's gate, got %v", v, names(got))
+		}
+	}
+}
+
+func TestHeavyCreateGateNodesLinkedPeersOnly(t *testing.T) {
+	heavy := []node.Node{mk("pa", "ceos1", "ceos3")}
+	// ceos1 and ceos3 are linked to pa; ceos4 declares the link only on ITS side; ceos2/h1 are unlinked.
+	regular := []node.Node{mk("ceos1", "pa"), mk("ceos2"), mk("ceos3"), mk("ceos4", "pa"), mk("h1")}
+	for _, v := range []string{"linked-peers", "true", "1", " LINKED-PEERS "} {
+		t.Setenv(heavyEarlyCreateEnv, v)
+		got, _ := heavyCreateGateNodes(heavy, regular)
+		if want := []string{"ceos1", "ceos3", "ceos4"}; !reflect.DeepEqual(names(got), want) {
+			t.Fatalf("value %q: gate = %v, want %v", v, names(got), want)
+		}
+	}
+}
+
+func TestHeavyCreateGateNodesNoRegularPeerMeansNoWait(t *testing.T) {
+	t.Setenv(heavyEarlyCreateEnv, "linked-peers")
+	got, _ := heavyCreateGateNodes([]node.Node{mk("pa")}, []node.Node{mk("ceos1"), mk("h1")})
+	if len(got) != 0 {
+		t.Fatalf("gate = %v, want empty", names(got))
+	}
+}
+
+// pushOrder runs push() on a lab with one heavy node (linked to peer1), a linked regular peer and an unlinked
+// regular node, and returns the recorded event order.
+func pushOrder(t *testing.T) []string {
+	t.Helper()
+	var mu sync.Mutex
+	events := []string{}
+	record := func(e string) {
+		mu.Lock()
+		defer mu.Unlock()
+		events = append(events, e)
+	}
+	peer := &admissionOrderNode{name: "peer1", record: record, proto: &tpb.Node{Name: "peer1", Model: "ceos",
+		Interfaces: map[string]*tpb.Interface{"eth1": {PeerName: "heavy1"}}}}
+	other := &admissionOrderNode{name: "other1", record: record, proto: &tpb.Node{Name: "other1", Model: "ceos"}}
+	heavy := &admissionOrderNode{name: "heavy1", record: record, proto: &tpb.Node{Name: "heavy1", Vendor: tpb.Vendor_A10, Model: "a10",
+		Interfaces: map[string]*tpb.Interface{"eth1": {PeerName: "peer1"}}}}
+	m := &Manager{
+		topo:    &tpb.Topology{Name: "test"},
+		kClient: kfake.NewSimpleClientset(),
+		nodes:   map[string]node.Node{peer.Name(): peer, other.Name(): other, heavy.Name(): heavy},
+	}
+	if err := m.push(context.Background()); err != nil {
+		t.Fatalf("push() failed: %v", err)
+	}
+	return events
+}
+
+func TestPushHeavyEarlyCreateWaitsOnlyForLinkedPeers(t *testing.T) {
+	t.Setenv(heavyEarlyCreateEnv, "linked-peers")
+	ev := pushOrder(t)
+	peerPods, otherPods, heavyCreate := indexOfEvent(ev, "peer1:pods"), indexOfEvent(ev, "other1:pods"), indexOfEvent(ev, "heavy1:create")
+	if peerPods == -1 || otherPods == -1 || heavyCreate == -1 {
+		t.Fatalf("missing events: %v", ev)
+	}
+	// The wiring-order guarantee: the linked peer has a stable sandbox BEFORE the VM is created.
+	if !(peerPods < heavyCreate) {
+		t.Fatalf("linked peer must be sandbox-stable before the heavy node is created: %v", ev)
+	}
+	// The optimisation: the unlinked node is not waited on.
+	if !(heavyCreate < otherPods) {
+		t.Fatalf("heavy create must not wait for the unlinked regular node: %v", ev)
+	}
+}
+
+func TestPushHeavyDefaultStillWaitsForEveryRegularNode(t *testing.T) {
+	t.Setenv(heavyEarlyCreateEnv, "")
+	ev := pushOrder(t)
+	peerPods, otherPods, heavyCreate := indexOfEvent(ev, "peer1:pods"), indexOfEvent(ev, "other1:pods"), indexOfEvent(ev, "heavy1:create")
+	if peerPods == -1 || otherPods == -1 || heavyCreate == -1 {
+		t.Fatalf("missing events: %v", ev)
+	}
+	if !(peerPods < heavyCreate && otherPods < heavyCreate) {
+		t.Fatalf("default must wait for every regular node before creating the heavy node: %v", ev)
+	}
+}
diff --git a/topo/heavy_group_admission_test.go b/topo/heavy_group_admission_test.go
new file mode 100644
index 0000000..c7e0cb1
--- /dev/null
+++ b/topo/heavy_group_admission_test.go
@@ -0,0 +1,407 @@
+package topo
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+)
+
+// demoLabHeavyShape is the heavy lane of demo-lab, which is the topology every
+// measurement in this file was taken on: one six-node linked component, one
+// pair, and seven nodes whose only peers are light pods.
+func demoLabHeavyShape() []node.Node {
+	type spec struct {
+		name  string
+		model string
+		peers []string
+	}
+	specs := []spec{
+		// the CDG component: access -> distribution -> core -> firewall -> edge
+		{"cdg-acc-sw01", "vjunos-switch", []string{"cdg-dis-sw01", "cdg-dis-sw02"}},
+		{"cdg-dis-sw01", "vjunos-router", []string{"cdg-acc-sw01", "cdg-cor-sw01"}},
+		{"cdg-dis-sw02", "vjunos-router", []string{"cdg-acc-sw01", "cdg-cor-sw01"}},
+		{"cdg-cor-sw01", "vjunos-router", []string{"cdg-dis-sw01", "cdg-dis-sw02", "cdg-fw01"}},
+		{"cdg-fw01", "asav", []string{"cdg-cor-sw01", "cdg-vedge01"}},
+		{"cdg-vedge01", "cat8000v", []string{"cdg-fw01"}},
+		// the JFK-DC pair
+		{"jfk-dc-fw01", "asav", []string{"jfk-dc-vedge01"}},
+		{"jfk-dc-vedge01", "cat8000v", []string{"jfk-dc-fw01"}},
+		// singles: every heavy peer of these is a light pod, already alive
+		{"jfk-fw01", "panos", []string{"jfk-cor-sw01"}},
+		{"lax-fw01", "panos", []string{"lax-cor-sw01"}},
+		{"jfk-vedge01", "cat8000v", nil},
+		{"lhr-vedge01", "cat8000v", nil},
+		{"vmanage", "vmanage", nil},
+		{"vsmart", "vsmart", nil},
+		{"vbond", "vbond", nil},
+	}
+	out := make([]node.Node, 0, len(specs))
+	for _, s := range specs {
+		intfs := map[string]*tpb.Interface{}
+		for i, peer := range s.peers {
+			intfs[fmt.Sprintf("eth%d", i+1)] = &tpb.Interface{PeerName: peer}
+		}
+		out = append(out, &configurable{Impl: &node.Impl{
+			Proto: &tpb.Node{Name: s.name, Model: s.model, Interfaces: intfs},
+		}})
+	}
+	return out
+}
+
+func groupShape(groups [][]node.Node) []string {
+	out := make([]string, 0, len(groups))
+	for _, g := range groups {
+		names := make([]string, 0, len(g))
+		for _, n := range g {
+			names = append(names, n.GetProto().GetName())
+		}
+		sort.Strings(names)
+		out = append(out, strings.Join(names, "+"))
+	}
+	sort.Strings(out)
+	return out
+}
+
+// A LINKED COMPONENT IS THE UNIT OF ADMISSION.
+//
+// MEASURED on demo-lab 2026-09-11: cdg-cor-sw01 had both of its vJunos peers
+// alive at 14:52:20 and still could not get a sandbox, because its THIRD heavy
+// peer (cdg-fw01) was not created for another ten minutes. Splitting a
+// component across pacing windows is what makes meshnet's 180s peer wait
+// unwinnable, so the component is what must be admitted together.
+func TestHeavyAdmissionGroupsArePerLinkedComponent(t *testing.T) {
+	got := groupShape(heavyAdmissionGroups(demoLabHeavyShape()))
+	want := []string{
+		"cdg-acc-sw01+cdg-cor-sw01+cdg-dis-sw01+cdg-dis-sw02+cdg-fw01+cdg-vedge01",
+		"jfk-dc-fw01+jfk-dc-vedge01",
+		"jfk-fw01",
+		"jfk-vedge01",
+		"lax-fw01",
+		"lhr-vedge01",
+		"vbond",
+		"vmanage",
+		"vsmart",
+	}
+	if strings.Join(got, " ") != strings.Join(want, " ") {
+		t.Fatalf("heavyAdmissionGroups() =\n  %v\nwant\n  %v", got, want)
+	}
+}
+
+// A node that is not in a group at all is a node that never boots.
+func TestHeavyAdmissionGroupsPreserveTheSet(t *testing.T) {
+	in := demoLabHeavyShape()
+	// a node naming a peer that is not in this lane, and a malformed one
+	in = append(in, &configurable{Impl: &node.Impl{Proto: &tpb.Node{
+		Name: "dangling", Model: "asav",
+		Interfaces: map[string]*tpb.Interface{"eth1": {PeerName: "not-in-this-lane"}},
+	}}})
+	in = append(in, &configurable{Impl: &node.Impl{}})
+
+	seen := 0
+	for _, g := range heavyAdmissionGroups(in) {
+		seen += len(g)
+	}
+	if seen != len(in) {
+		t.Fatalf("grouping covered %d of %d nodes; a node outside every group never boots", seen, len(in))
+	}
+}
+
+func TestHeavyAdmissionGroupsAreDeterministic(t *testing.T) {
+	first := groupShape(heavyAdmissionGroups(demoLabHeavyShape()))
+	for i := 0; i < 20; i++ {
+		if got := groupShape(heavyAdmissionGroups(demoLabHeavyShape())); strings.Join(got, " ") != strings.Join(first, " ") {
+			t.Fatalf("run %d produced a different grouping:\n %v\nvs\n %v", i, got, first)
+		}
+	}
+}
+
+// groupTracker records in-flight counts per model and overall, plus the order
+// of create/settle events, so the tests can assert on what actually happened
+// rather than on timing.
+type groupTracker struct {
+	mu       sync.Mutex
+	live     map[string]string // name -> model, currently past Create and not yet Ready
+	peak     map[string]int
+	peakAll  int
+	events   []string
+	together map[string][]string // model -> the widest set seen in flight beside it
+}
+
+func newGroupTracker() *groupTracker {
+	return &groupTracker{live: map[string]string{}, peak: map[string]int{}, together: map[string][]string{}}
+}
+
+func (g *groupTracker) created(model, name string) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.live[name] = model
+	g.events = append(g.events, "create:"+name)
+	byModel := map[string]int{}
+	names := make([]string, 0, len(g.live))
+	for n, m := range g.live {
+		byModel[m]++
+		names = append(names, n)
+	}
+	for m, c := range byModel {
+		if c > g.peak[m] {
+			g.peak[m] = c
+		}
+		if len(g.live) > len(g.together[m]) {
+			sort.Strings(names)
+			g.together[m] = append([]string(nil), names...)
+		}
+	}
+	if len(g.live) > g.peakAll {
+		g.peakAll = len(g.live)
+	}
+}
+
+func (g *groupTracker) polled(name string) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.events = append(g.events, "status:"+name)
+}
+
+func (g *groupTracker) done(name string) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	delete(g.live, name)
+}
+
+type groupTestNode struct {
+	*node.Impl
+	tracker *groupTracker
+
+	mu     sync.Mutex
+	polls  int
+	booted bool
+}
+
+func (n *groupTestNode) Create(_ context.Context) error {
+	n.tracker.created(strings.ToLower(n.GetProto().GetModel()), n.GetProto().GetName())
+	return nil
+}
+
+func (n *groupTestNode) Status(_ context.Context) (node.Status, error) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.tracker.polled(n.GetProto().GetName())
+	if n.booted {
+		return node.StatusRunning, nil
+	}
+	n.polls++
+	if n.polls < 3 {
+		return node.StatusPending, nil
+	}
+	n.booted = true
+	n.tracker.done(n.GetProto().GetName())
+	return node.StatusRunning, nil
+}
+
+func instrument(nodes []node.Node, tr *groupTracker) []node.Node {
+	out := make([]node.Node, 0, len(nodes))
+	for _, n := range nodes {
+		out = append(out, &groupTestNode{Impl: &node.Impl{Proto: n.GetProto()}, tracker: tr})
+	}
+	return out
+}
+
+func withFastPacing(t *testing.T) {
+	t.Helper()
+	prevSettle, prevPace := heavyCreateSettlePollInterval, admissionPacerPollInterval
+	heavyCreateSettlePollInterval = 2 * time.Millisecond
+	admissionPacerPollInterval = time.Millisecond
+	t.Cleanup(func() {
+		heavyCreateSettlePollInterval = prevSettle
+		admissionPacerPollInterval = prevPace
+	})
+}
+
+// policy installs a per-model runtime policy for the duration of the test, the
+// same way the server's SKYFORGE_KNE_ADMISSION_POLICY_JSON would.
+func withPolicy(t *testing.T, policies map[string]runtimeAdmissionPolicy) {
+	t.Helper()
+	prev := admissionPolicyByModel
+	admissionPolicyByModel = policies
+	t.Cleanup(func() { admissionPolicyByModel = prev })
+}
+
+func heavyPolicy(width int, exclusive bool) runtimeAdmissionPolicy {
+	return runtimeAdmissionPolicy{
+		Lane:              admissionLaneHeavy,
+		MaxParallelism:    width,
+		AdmissionDeadline: heavyNodeAdmissionTimeout,
+		Exclusive:         exclusive,
+		RetryEligible:     true,
+	}
+}
+
+// A NARROW MODEL MUST NARROW ONLY ITSELF.
+//
+// This is the defect that cost demo-lab 150 minutes of pacing: the lane width was
+// the MINIMUM MaxParallelism across the lane, so panos (1) serialized 13 VMs
+// that had no such constraint. The negative control below asserts the fixture
+// really does reproduce it -- min-over-lane on this same lane is 1.
+func TestHeavyAdmissionPacerHoldsPerModelNotPerLane(t *testing.T) {
+	withFastPacing(t)
+	withPolicy(t, map[string]runtimeAdmissionPolicy{
+		"panos":         heavyPolicy(1, false),
+		"asav":          heavyPolicy(16, false),
+		"cat8000v":      heavyPolicy(16, false),
+		"vjunos-switch": heavyPolicy(16, false),
+		"vjunos-router": heavyPolicy(16, false),
+		"vmanage":       heavyPolicy(16, false),
+		"vsmart":        heavyPolicy(16, false),
+		"vbond":         heavyPolicy(16, false),
+	})
+
+	shape := demoLabHeavyShape()
+
+	// NEGATIVE CONTROL: the behaviour this replaces. If this stops being 1 the
+	// fixture has stopped reproducing the defect and the test below proves less.
+	minOverLane := 1 << 30
+	for _, n := range shape {
+		if p := runtimeAdmissionPolicyForNode(n); p.MaxParallelism < minOverLane {
+			minOverLane = p.MaxParallelism
+		}
+	}
+	if minOverLane != 1 {
+		t.Fatalf("control: min-over-lane = %d, want 1 (the fixture no longer reproduces the collapse this fixes)", minOverLane)
+	}
+
+	tr := newGroupTracker()
+	nodes := instrument(shape, tr)
+	pacer := newHeavyAdmissionPacer(nodes)
+	if pacer.laneWidth != 16 {
+		t.Fatalf("lane width = %d, want 16: one narrow model is still narrowing the lane", pacer.laneWidth)
+	}
+
+	m := &Manager{}
+	if err := m.createHeavyNodeResourcesGrouped(context.Background(), nodes, pacer, m.waitForHeavyGroupLaunch); err != nil {
+		t.Fatalf("grouped create: %v", err)
+	}
+
+	if got := tr.peak["panos"]; got != 1 {
+		t.Errorf("peak concurrent panos = %d, want 1: the per-model semaphore is not holding", got)
+	}
+	if got := tr.peakAll; got < 8 {
+		t.Errorf("peak concurrent heavy nodes = %d, want at least 8: the lane is still serialized behind its narrowest model", got)
+	}
+}
+
+// EVERY MEMBER OF A GROUP EXISTS BEFORE ANY MEMBER IS WAITED ON.
+//
+// That ordering is the whole point: meshnet can wire a component's members to
+// each other within seconds once they all exist, and cannot wire them at all
+// while they are ten minutes apart.
+func TestHeavyGroupMembersAreCreatedBeforeTheGroupSettles(t *testing.T) {
+	withFastPacing(t)
+	withPolicy(t, map[string]runtimeAdmissionPolicy{
+		"panos": heavyPolicy(1, false), "asav": heavyPolicy(16, false),
+		"cat8000v": heavyPolicy(16, false), "vjunos-switch": heavyPolicy(16, false),
+		"vjunos-router": heavyPolicy(16, false), "vmanage": heavyPolicy(16, false),
+		"vsmart": heavyPolicy(16, false), "vbond": heavyPolicy(16, false),
+	})
+
+	tr := newGroupTracker()
+	nodes := instrument(demoLabHeavyShape(), tr)
+	pacer := newHeavyAdmissionPacer(nodes)
+	m := &Manager{}
+	if err := m.createHeavyNodeResourcesGrouped(context.Background(), nodes, pacer, m.waitForHeavyGroupLaunch); err != nil {
+		t.Fatalf("grouped create: %v", err)
+	}
+
+	at := map[string]int{}
+	for i, e := range tr.events {
+		if _, seen := at[e]; !seen {
+			at[e] = i
+		}
+	}
+	for _, group := range heavyAdmissionGroups(nodes) {
+		lastCreate, firstStatus := -1, 1<<30
+		for _, n := range group {
+			name := n.GetProto().GetName()
+			if i, ok := at["create:"+name]; ok && i > lastCreate {
+				lastCreate = i
+			}
+			if i, ok := at["status:"+name]; ok && i < firstStatus {
+				firstStatus = i
+			}
+		}
+		if firstStatus < lastCreate {
+			t.Errorf("group [%s] was waited on before all of its members existed: that is the peer-wait deadlock this fixes", groupNames(group))
+		}
+	}
+}
+
+// A GROUP WIDER THAN ITS WIDTH IS STILL ADMITTED -- into a quiet lane.
+// Splitting a linked component recreates the deadlock; refusing it never
+// starts the lab. So it goes, alone, and says so.
+func TestHeavyAdmissionPacerAdmitsAnOversizedGroupIntoAnIdleLane(t *testing.T) {
+	withFastPacing(t)
+	withPolicy(t, map[string]runtimeAdmissionPolicy{
+		"panos": heavyPolicy(1, false), "asav": heavyPolicy(2, false),
+		"cat8000v": heavyPolicy(2, false), "vjunos-switch": heavyPolicy(2, false),
+		"vjunos-router": heavyPolicy(2, false), "vmanage": heavyPolicy(2, false),
+		"vsmart": heavyPolicy(2, false), "vbond": heavyPolicy(2, false),
+	})
+
+	tr := newGroupTracker()
+	nodes := instrument(demoLabHeavyShape(), tr)
+	pacer := newHeavyAdmissionPacer(nodes)
+	if pacer.laneWidth != 2 {
+		t.Fatalf("lane width = %d, want 2", pacer.laneWidth)
+	}
+	m := &Manager{}
+	if err := m.createHeavyNodeResourcesGrouped(context.Background(), nodes, pacer, m.waitForHeavyGroupLaunch); err != nil {
+		t.Fatalf("grouped create: %v", err)
+	}
+	// The 6-node CDG component exceeds both the lane width (2) and the
+	// vjunos-router width (2), so it may only run alone.
+	if got := tr.peakAll; got < 6 {
+		t.Errorf("peak in flight = %d: the oversized linked component was split, which is the deadlock this fixes", got)
+	}
+	if got := tr.peak["panos"]; got != 1 {
+		t.Errorf("peak concurrent panos = %d, want 1", got)
+	}
+}
+
+// An EXCLUSIVE model keeps the lane to itself. Nothing declares this today --
+// it exists so a NOS that turns out to dislike a busy host is quarantined by
+// config rather than by a rebuild.
+func TestHeavyAdmissionPacerKeepsAnExclusiveModelAlone(t *testing.T) {
+	withFastPacing(t)
+	withPolicy(t, map[string]runtimeAdmissionPolicy{
+		"panos": heavyPolicy(1, true), "asav": heavyPolicy(16, false),
+		"cat8000v": heavyPolicy(16, false), "vjunos-switch": heavyPolicy(16, false),
+		"vjunos-router": heavyPolicy(16, false), "vmanage": heavyPolicy(16, false),
+		"vsmart": heavyPolicy(16, false), "vbond": heavyPolicy(16, false),
+	})
+
+	tr := newGroupTracker()
+	nodes := instrument(demoLabHeavyShape(), tr)
+	pacer := newHeavyAdmissionPacer(nodes)
+	m := &Manager{}
+	if err := m.createHeavyNodeResourcesGrouped(context.Background(), nodes, pacer, m.waitForHeavyGroupLaunch); err != nil {
+		t.Fatalf("grouped create: %v", err)
+	}
+
+	tr.mu.Lock()
+	defer tr.mu.Unlock()
+	if got := tr.together["panos"]; len(got) != 1 {
+		t.Errorf("an exclusive panos shared the lane with %v; exclusive means alone", got)
+	}
+	// CONTROL: the non-exclusive models really did overlap, so the assertion
+	// above is about exclusivity and not about a lane that never ran anything
+	// concurrently.
+	if got := tr.peakAll; got < 6 {
+		t.Errorf("peak in flight = %d: nothing ever overlapped, so the exclusive assertion proves nothing", got)
+	}
+}
