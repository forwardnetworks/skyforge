+// A NARROW MODEL MUST NOT NARROW THE LANE. This is the regression test for the
+// defect that made demo-lab take 150 minutes to create 15 VMs: the lane width was
+// the MINIMUM across the lane, so two PAN-OS nodes (width 1) serialized 13 other
+// VMs that had no such constraint. The width is now the maximum, and panos is
+// held by its own per-model semaphore instead (TestHeavyAdmissionPacer*).
+func TestHeavyLaneWidthForNodes(t *testing.T) {
+	mkNode := func(model string) node.Node {
+		return &configurable{Impl: &node.Impl{
+			Proto: &tpb.Node{Name: model, Model: model},
+		}}
+	}
+	tests := []struct {
+		name  string
+		nodes []node.Node
+		want  int
+	}{
+		{
+			name: "empty defaults to one",
+			want: 1,
+		},
+		{
+			name:  "heavy without panos uses default heavy parallelism",
+			nodes: []node.Node{mkNode("a10"), mkNode("fortios"), mkNode("sros")},
+			want:  heavyPhaseParallelism,
+		},
+		{
+			name:  "panos no longer collapses the lane it shares",
+			nodes: []node.Node{mkNode("a10"), mkNode("panos"), mkNode("fortios")},
+			want:  heavyPhaseParallelism,
+		},
+		{
+			name:  "a lane of nothing but panos is still serial",
+			nodes: []node.Node{mkNode("panos"), mkNode("panos")},
+			want:  1,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := heavyLaneWidthForNodes(tt.nodes); got != tt.want {
+				t.Fatalf("heavyLaneWidthForNodes() = %d, want %d", got, tt.want)
+			}
+		})
+	}
+}
