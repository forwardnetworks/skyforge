+func (m *Manager) createNodeResources(ctx context.Context, nodes []node.Node, parallelism int) error {
+	return m.createNodeResourcesPaced(ctx, nodes, parallelism, nil)
+}
+
+// createNodeResourcesPaced is createNodeResources with a SETTLE step, and the
+// settle step is the whole point.
+//
+// A SEMAPHORE ONLY PACES WHAT IS INSIDE IT. Every slot here used to hold nothing
+// but n.Create(), which for a KubeVirt node POSTs a VirtualMachine object with
+// running: true and returns -- microseconds. virt-controller then starts the VMI
+// on its own clock, so the limit paced API calls and paced NOTHING about the
+// thing it exists to protect: the qcow2 extraction and guest boot that actually
+// contend for host IO.
+//
+// MEASURED on demo-lab (deployment c83e1600), 2026-09-08. KNE said, verbatim:
+//
+//	16:04:52.631980  topo.go:740  Creating 15 heavy node resource(s) after
+//	                              regular sandbox stability, parallelism=1
+//
+// and all fifteen VirtualMachine objects existed by 16:04:54 -- fifteen heavy VMs
+// booting at once under a limit of ONE. PAN-OS then diagnosed the result itself
+// on the console: "*** CRITICAL WARNING *** RPMS vfy timeout on VM, please check
+// VM oversubscription". jfk-fw01 resolved its version as None, failed FIPS-CC
+// Stage-1, dropped into the Maintenance Recovery Tool, and the whole apply failed
+// with 39 nodes never configured. Resetting that one node alone into a quiet
+// cluster booted it clean in 8 minutes, same image, same node, same spec.
+//
+// So the slot is now held until the node it started is actually up. The limit
+// finally means what its log line and its condition message have always claimed.
+//
+// BEST EFFORT, DELIBERATELY. settle never fails the create: a node that does not
+// come up inside its budget releases the slot and is judged by the admission and
+// readiness phases that follow, exactly as before. Pacing must not become a new
+// way for a bring-up to fail.
+func (m *Manager) createNodeResourcesPaced(ctx context.Context, nodes []node.Node, parallelism int, settle func(context.Context, node.Node) error) error {
+	if len(nodes) == 0 {
+		return nil
+	}
+	if parallelism < 1 {
+		parallelism = 1
+	}
+	g, ctx := errgroup.WithContext(ctx)
+	g.SetLimit(parallelism)
+	for _, n := range nodes {
+		n := n
+		g.Go(func() error {
+			for key, service := range n.GetProto().Services {
+				updateServicePortName(service, key)
+			}
+
+			if err := n.Create(ctx); err != nil {
+				return fmt.Errorf("failed to create node %s: %w", n, err)
+			}
+			log.Infof("Node %s resource created", n)
+			if settle != nil {
+				if err := settle(ctx, n); err != nil {
+					return err
+				}
+			}
+			return nil
+		})
+	}
+	return g.Wait()
+}
+
+// heavyCreateSettleTimeout bounds how long ONE heavy node may hold a create slot.
+//
+// A cold PAN-OS or vManage really can take many minutes, and the point of pacing
+// is to give it a quiet host while it does. But a node that is never coming up
+// must not hold the lane shut for the rest of the bring-up, so the wait is
+// bounded and its expiry is a WARNING, not a failure -- admission still judges
+// readiness afterwards.
+const heavyCreateSettleTimeout = 10 * time.Minute
+
+// heavyCreateSettlePollInterval is a var, not a const, ONLY so the pacing test
+// can run in milliseconds instead of minutes. Nothing in production changes it.
+var heavyCreateSettlePollInterval = 5 * time.Second
+
+// waitForHeavyNodeLaunch holds a heavy node's create slot until its pod is Ready.
+//
+// POD READY, NOT POD SCHEDULED. For a KubeVirt node the containerDisk copy and
+// the qcow2 extraction happen inside virt-launcher before the guest is handed
+// the disk, and virt-launcher does not report Ready until the VMI is running.
+// That makes Ready the first moment the expensive IO is DONE -- which is exactly
+// the boundary a pacing lane wants, and why waiting on the sandbox (Running, not
+// Ready) would release the slot in the middle of the extraction it is meant to
+// serialize.
+// createHeavyNodeResourcesGrouped creates the heavy lane one LINKED GROUP at a
+// time, paced by lane width and per-model width.
+//
+// The whole group's objects are POSTed back to back and only then is the group
+// settled on, because that is what the CNI on the other end is waiting for: a
+// component's members can wire each other within seconds once they all exist,
+// and cannot wire at all while they are ten minutes apart. Every member of a
+// group therefore holds the slot until the LAST of them is up.
+//
+// BEST EFFORT, as before: settle never fails a create. A node that does not
+// come up inside its budget releases the slot and is judged by the admission
+// and readiness phases that follow.
+func (m *Manager) createHeavyNodeResourcesGrouped(ctx context.Context, nodes []node.Node, pacer *heavyAdmissionPacer, settle func(context.Context, []node.Node) error) error {
+	groups := heavyAdmissionGroups(nodes)
+	if len(groups) == 0 {
+		return nil
+	}
+	g, ctx := errgroup.WithContext(ctx)
+	g.SetLimit(len(groups))
+	for _, group := range groups {
+		group := group
+		g.Go(func() error {
+			if err := pacer.admit(ctx, group); err != nil {
+				return err
+			}
+			defer pacer.release(group)
+			for _, n := range group {
+				for key, service := range n.GetProto().Services {
+					updateServicePortName(service, key)
+				}
+				if err := n.Create(ctx); err != nil {
+					return fmt.Errorf("failed to create node %s: %w", n, err)
+				}
+				log.Infof("Node %s resource created", n)
+			}
+			if settle == nil {
+				return nil
+			}
+			return settle(ctx, group)
+		})
+	}
+	return g.Wait()
+}
+
+// waitForHeavyGroupLaunch holds a group's slot until EVERY member is up.
+//
+// POD READY, NOT POD SCHEDULED -- see waitForHeavyNodeLaunch for why Ready is
+// the boundary that actually bounds the expensive IO. The budget covers the
+// group, not each member, so a group cannot multiply the lane's pacing.
+func (m *Manager) waitForHeavyGroupLaunch(ctx context.Context, group []node.Node) error {
+	if len(group) == 0 {
+		return nil
+	}
+	budget := heavyCreateSettleTimeout
+	for _, n := range group {
+		if d := nodeAdmissionTimeoutForNode(n); d > 0 && d < budget {
+			budget = d
+		}
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, budget)
+	defer cancel()
+	ticker := time.NewTicker(heavyCreateSettlePollInterval)
+	defer ticker.Stop()
+	start := time.Now()
+	settled := make(map[string]bool, len(group))
+	for {
+		pending := make([]string, 0, len(group))
+		for _, n := range group {
+			name := n.String()
+			if settled[name] {
+				continue
+			}
+			status, err := n.Status(waitCtx)
+			if err != nil {
+				pending = append(pending, name)
+				continue
+			}
+			switch status {
+			case node.StatusRunning:
+				settled[name] = true
+			case node.StatusFailed:
+				// Not this function's verdict to make; admission reports it.
+				log.Warningf("Heavy node %s reported Failed while holding a bring-up slot; releasing it for admission to judge", n)
+				settled[name] = true
+			default:
+				pending = append(pending, name)
+			}
+		}
+		if len(pending) == 0 {
+			log.Infof("Heavy group [%s] reached Ready in %s; releasing its bring-up slot", groupNames(group), time.Since(start).Truncate(time.Second))
+			return nil
+		}
+		select {
+		case <-waitCtx.Done():
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			// Name what is still down. A group that expires here is the one
+			// case where a reader needs to know WHICH member held the lane.
+			log.Warningf("Heavy group [%s] did not reach Ready within %s (still pending: %s); releasing its bring-up slot so the lane can continue (admission still judges readiness)", groupNames(group), budget, strings.Join(pending, ","))
+			return nil
+		case <-ticker.C:
+		}
+	}
+}
+
+func (m *Manager) waitForHeavyNodeLaunch(ctx context.Context, n node.Node) error {
+	budget := heavyCreateSettleTimeout
+	if d := nodeAdmissionTimeoutForNode(n); d > 0 && d < budget {
+		budget = d
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, budget)
+	defer cancel()
+	ticker := time.NewTicker(heavyCreateSettlePollInterval)
+	defer ticker.Stop()
+	start := time.Now()
+	for {
+		status, err := n.Status(waitCtx)
+		if err == nil {
+			switch status {
+			case node.StatusRunning:
+				log.Infof("Heavy node %s reached Ready in %s; releasing its bring-up slot", n, time.Since(start).Truncate(time.Second))
+				return nil
+			case node.StatusFailed:
+				// Not this function's verdict to make. Release the slot and let
+				// the admission phase report it with its own diagnosis.
+				log.Warningf("Heavy node %s reported Failed while holding a bring-up slot; releasing it for admission to judge", n)
+				return nil
+			}
+		}
+		select {
+		case <-waitCtx.Done():
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			log.Warningf("Heavy node %s did not reach Ready within %s; releasing its bring-up slot so the lane can continue (admission still judges readiness)", n, budget)
+			return nil
+		case <-ticker.C:
+		}
+	}
+}
+
+func (m *Manager) waitForNodeSandboxStability(ctx context.Context, nodes []node.Node, timeout time.Duration) error {
+	if len(nodes) == 0 {
+		return nil
+	}
+	waitCtx := ctx
+	cancel := func() {}
+	if timeout > 0 {
+		waitCtx, cancel = context.WithTimeout(ctx, timeout)
+	}
+	defer cancel()
+	ticker := time.NewTicker(500 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		pending := make([]string, 0)
+		for _, n := range nodes {
+			stable, err := nodePodSandboxStable(waitCtx, n)
+			if err != nil {
+				return err
+			}
+			if !stable {
+				pending = append(pending, n.Name())
+			}
+		}
+		if len(pending) == 0 {
+			log.Infof("Regular-node sandbox stability reached for %d node(s)", len(nodes))
+			return nil
+		}
+		select {
+		case <-waitCtx.Done():
+			if waitCtx.Err() == context.DeadlineExceeded {
+				return fmt.Errorf("%w waiting for regular node sandbox stability; pending=%s", waitCtx.Err(), strings.Join(pending, ","))
+			}
+			return waitCtx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+func (m *Manager) admitNodesAndGenerateCerts(ctx context.Context, nodes []node.Node, parallelism int) error {
+	if len(nodes) == 0 {
+		return nil
+	}
+	if parallelism < 1 {
+		parallelism = 1
+	}
+	g, ctx := errgroup.WithContext(ctx)
+	g.SetLimit(parallelism)
+	for _, n := range nodes {
+		n := n
+		g.Go(func() error {
+			if err := m.waitForNodeAdmission(ctx, n, nodeAdmissionTimeoutForNode(n)); err != nil {
+				return fmt.Errorf("failed waiting for node %s pod admission: %w", n, err)
+			}
+
+			log.Infof("Generating Self-Signed Certificates for node %s", n)
+			err := m.GenerateSelfSigned(ctx, n.Name())
+			switch {
+			case err == nil, status.Code(err) == codes.Unimplemented:
+				return nil
+			default:
+				return fmt.Errorf("failed to generate cert for node %s: %w", n, err)
+			}
+		})
+	}
+	return g.Wait()
+}
+
+func waitForNodeAdmission(ctx context.Context, n node.Node, timeout time.Duration) error {
+	return (&Manager{}).waitForNodeAdmission(ctx, n, timeout)
+}
+
+func (m *Manager) waitForNodeAdmission(ctx context.Context, n node.Node, timeout time.Duration) error {
+	waitCtx := ctx
+	cancel := func() {}
+	if timeout > 0 {
+		waitCtx, cancel = context.WithTimeout(ctx, timeout)
+	}
+	defer cancel()
+	resetAdmissionDeadline := func() {
+		if timeout <= 0 {
+			return
+		}
+		cancel()
+		waitCtx, cancel = context.WithTimeout(ctx, timeout)
+	}
+
+	ticker := time.NewTicker(250 * time.Millisecond)
+	defer ticker.Stop()
+	kubeVirtRecoveryState := kubeVirtAdmissionRecoveryState{}
+	regularRecoveryState := regularNodeAdmissionRecoveryState{}
+	for {
+		admitted, err := nodePodsAdmitted(waitCtx, n)
+		if err != nil {
+			return err
+		}
+		if admitted {
+			if recovered, err := m.maybeRecoverRegularNodeAdmission(waitCtx, ctx, n, &regularRecoveryState); err != nil {
+				return err
+			} else if recovered {
+				resetAdmissionDeadline()
+				continue
+			}
+			if err := m.regularNodeAdmissionRecoveryExhausted(ctx, n, &regularRecoveryState); err != nil {
+				return err
+			}
+			if recovered, err := m.maybeRecoverKubeVirtAdmission(waitCtx, ctx, n, &kubeVirtRecoveryState); err != nil {
+				log.Warningf("KubeVirt admission recovery check failed for node %s: %v", n.Name(), err)
+			} else if recovered {
+				resetAdmissionDeadline()
+				continue
+			}
+			if err := m.kubeVirtAdmissionRecoveryExhausted(ctx, n, &kubeVirtRecoveryState); err != nil {
+				return err
+			}
+			if !m.kubeVirtNodeAdmissionReady(waitCtx, n) {
+				select {
+				case <-waitCtx.Done():
+					if waitCtx.Err() == context.DeadlineExceeded {
+						return fmt.Errorf("%w; %s", waitCtx.Err(), m.nodeAdmissionDebugSnapshot(ctx, n))
+					}
+					return waitCtx.Err()
+				case <-ticker.C:
+				}
+				continue
+			}
+			return nil
+		}
+		if recovered, err := m.maybeRecoverRegularNodeAdmission(waitCtx, ctx, n, &regularRecoveryState); err != nil {
+			return err
+		} else if recovered {
+			resetAdmissionDeadline()
+			continue
+		}
+		if err := m.regularNodeAdmissionRecoveryExhausted(ctx, n, &regularRecoveryState); err != nil {
+			return err
+		}
+		if recovered, err := m.maybeRecoverKubeVirtAdmission(waitCtx, ctx, n, &kubeVirtRecoveryState); err != nil {
+			log.Warningf("KubeVirt admission recovery check failed for node %s: %v", n.Name(), err)
+		} else if recovered {
+			resetAdmissionDeadline()
+			continue
+		}
+		if err := m.kubeVirtAdmissionRecoveryExhausted(ctx, n, &kubeVirtRecoveryState); err != nil {
+			return err
+		}
+		select {
+		case <-waitCtx.Done():
+			if waitCtx.Err() == context.DeadlineExceeded {
+				return fmt.Errorf("%w; %s", waitCtx.Err(), m.nodeAdmissionDebugSnapshot(ctx, n))
+			}
+			return waitCtx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+type kubeVirtAdmissionRecoveryState struct {
+	attempts      int
+	lastAttempt   time.Time
+	blockedLogged bool
+}
+
+type regularNodeAdmissionRecoveryState struct {
+	attempts      int
+	lastAttempt   time.Time
+	blockedLogged bool
+}
+
+var kubeVirtVMIGVRForAdmissionRecovery = schema.GroupVersionResource{
+	Group:    "kubevirt.io",
+	Version:  "v1",
+	Resource: "virtualmachineinstances",
+}
+
+var kubeVirtVMGVRForAdmissionRecovery = schema.GroupVersionResource{
+	Group:    "kubevirt.io",
+	Version:  "v1",
+	Resource: "virtualmachines",
+}
+
+func (m *Manager) maybeRecoverKubeVirtAdmission(observeCtx, actionParentCtx context.Context, n node.Node, state *kubeVirtAdmissionRecoveryState) (bool, error) {
+	if m == nil || n == nil || state == nil || !nodeUsesKubeVirtVM(n) {
+		return false, nil
+	}
+	if !runtimeAdmissionPolicyForNode(n).RetryEligible {
+		return false, nil
+	}
+	if state.attempts >= maxKubeVirtAdmissionRecoveries {
+		return false, nil
+	}
+	if !state.lastAttempt.IsZero() && time.Since(state.lastAttempt) < kubeVirtAdmissionRecoveryMinInterval {
+		return false, nil
+	}
+	pods, err := n.Pods(observeCtx)
+	if err != nil || len(pods) == 0 {
+		return false, nil
+	}
+	for _, pod := range pods {
+		if !m.kubeVirtPodNeedsAdmissionRecovery(observeCtx, n, pod) {
+			continue
+		}
+		// Recreating the VMI replaces its launcher pod, and meshnet rebuilds
+		// every link of it on both ends. A running peer that cannot adopt a
+		// re-created interface (XRd, another VM) would be left with a dead
+		// link and a lab that reads healthy; refuse and let the admission
+		// deadline name this node instead. See regularNodeRecoveryBlockedByPeers.
+		if reason := m.recoveryWouldStrandRunningPeer(observeCtx, n); reason != "" {
+			if !state.blockedLogged {
+				log.Warningf("Not recreating stuck KubeVirt node %s (pod=%s): %s", n.Name(), pod.Name, reason)
+				state.blockedLogged = true
+			}
+			return false, nil
+		}
+		state.lastAttempt = time.Now()
+		actionCtx, cancel := context.WithTimeout(actionParentCtx, kubeVirtAdmissionRecoveryActionTimeout)
+		if err := m.recreateKubeVirtVMI(actionCtx, n, pod); err != nil {
+			cancel()
+			return false, err
+		}
+		cancel()
+		state.attempts++
+		log.Warningf("Recovering stuck KubeVirt admission for node %s by recreating VMI after retryable launcher admission failure (attempt=%d pod=%s)",
+			n.Name(), state.attempts, pod.Name)
+		return true, nil
+	}
+	return false, nil
+}
+
+func (m *Manager) kubeVirtAdmissionRecoveryExhausted(ctx context.Context, n node.Node, state *kubeVirtAdmissionRecoveryState) error {
+	if m == nil || n == nil || state == nil || !nodeUsesKubeVirtVM(n) || state.attempts < maxKubeVirtAdmissionRecoveries {
+		return nil
+	}
+	if m.kubeVirtVMIHasRetryableNetworkSyncFailure(ctx, n) || m.kubeVirtVMHasCrashLoopStartFailure(ctx, n) {
+		return fmt.Errorf("KubeVirt admission recovery exhausted for node %s after %d attempt(s); %s", n.Name(), state.attempts, m.nodeAdmissionDebugSnapshot(ctx, n))
+	}
+	return nil
+}
+
+func (m *Manager) maybeRecoverRegularNodeAdmission(observeCtx, actionParentCtx context.Context, n node.Node, state *regularNodeAdmissionRecoveryState) (bool, error) {
+	if m == nil || n == nil || state == nil || nodeUsesKubeVirtVM(n) {
+		return false, nil
+	}
+	if !runtimeAdmissionPolicyForNode(n).RetryEligible {
+		return false, nil
+	}
+	if state.attempts >= maxRegularNodeAdmissionRecoveries {
+		return false, nil
+	}
+	if !state.lastAttempt.IsZero() && time.Since(state.lastAttempt) < regularNodeAdmissionRecoveryMinInterval {
+		return false, nil
+	}
+	pods, err := n.Pods(observeCtx)
+	if err != nil || len(pods) == 0 {
+		return false, nil
+	}
+	for _, pod := range pods {
+		if !m.regularNodePodNeedsAdmissionRecovery(observeCtx, pod) {
+			continue
+		}
+		// Recreating a node rebuilds EVERY link it has, on both ends. Two
+		// ways that makes things worse rather than better (demo-lab,
+		// 2026-09-27: sjc-dc1-ce01 recreated at 18:56 while its PAN VM peer
+		// was still booting; the rebuild handed the already-running XRd PE a
+		// fresh eth3 it never binds, and the PAN VM a link it never saw --
+		// DC-to-DC traffic 0/4 with every pod Running):
+		//   - a peer whose pod is not Running has not created its end yet;
+		//     the "missing" interface is a slow peer, not a stale node, and
+		//     meshnet wires it the moment the peer comes up;
+		//   - a Running peer that cannot adopt a re-created interface (XRd
+		//     binds its XR_INTERFACES once at boot; a KubeVirt VM's NIC is
+		//     wired at VM start) is left with a dead link by the rebuild.
+		// Either way: do not recreate. Keep waiting; if the node really is
+		// stuck, the admission deadline fails it by name.
+		if reason := m.regularNodeRecoveryBlockedByPeers(observeCtx, n); reason != "" {
+			if !state.blockedLogged {
+				log.Warningf("Not recreating stuck regular node %s (pod=%s): %s", n.Name(), pod.Name, reason)
+				state.blockedLogged = true
+			}
+			return false, nil
+		}
+		state.lastAttempt = time.Now()
+		actionCtx, cancel := context.WithTimeout(actionParentCtx, regularNodeAdmissionRecoveryActionTimeout)
+		if err := m.recreateRegularNode(actionCtx, n); err != nil {
+			cancel()
+			return false, err
+		}
+		cancel()
+		state.attempts++
+		log.Warningf("Recovering stuck regular-node admission for node %s by recreating node resources after retryable substrate failure (attempt=%d pod=%s)",
+			n.Name(), state.attempts, pod.Name)
+		return true, nil
+	}
+	return false, nil
+}
+
+// regularNodeRecoveryBlockedByPeers says why recreating n would not help or
+// would break a link that already works, or "" when a recreate is safe.
+func (m *Manager) regularNodeRecoveryBlockedByPeers(ctx context.Context, n node.Node) string {
+	if m == nil || m.topo == nil || n == nil {
+		return ""
+	}
+	for _, peerName := range m.linkPeers(n.Name()) {
+		peer := m.nodes[peerName]
+		if peer == nil {
+			continue
+		}
+		pods, err := peer.Pods(ctx)
+		if err != nil || len(pods) == 0 {
+			return fmt.Sprintf("peer %s has no pod yet, so its end of the link cannot exist", peerName)
+		}
+		for _, pod := range pods {
+			if pod.Status.Phase != corev1.PodRunning {
+				return fmt.Sprintf("peer %s is %s, so its end of the link is not wired yet", peerName, pod.Status.Phase)
+			}
+		}
+	}
+	return m.recoveryWouldStrandRunningPeer(ctx, n)
+}
+
+// recoveryWouldStrandRunningPeer names a RUNNING peer of n that cannot adopt a
+// re-created interface, or returns "".
+func (m *Manager) recoveryWouldStrandRunningPeer(ctx context.Context, n node.Node) string {
+	if m == nil || m.topo == nil || n == nil {
+		return ""
+	}
+	for _, peerName := range m.linkPeers(n.Name()) {
+		peer := m.nodes[peerName]
+		if peer == nil || !nodeCannotAdoptRecreatedLink(peer) {
+			continue
+		}
+		pods, err := peer.Pods(ctx)
+		if err != nil {
+			continue
+		}
+		for _, pod := range pods {
+			if pod.Status.Phase == corev1.PodRunning {
+				return fmt.Sprintf("peer %s is running and cannot adopt a re-created interface (XRd/KubeVirt); a rebuild would leave its link dead", peerName)
+			}
+		}
+	}
+	return ""
+}
+
+// linkPeers lists the distinct nodes linked to name.
+func (m *Manager) linkPeers(name string) []string {
+	var out []string
+	seen := map[string]bool{}
+	for _, l := range m.topo.Links {
+		peer := ""
+		switch name {
+		case l.ANode:
+			peer = l.ZNode
+		case l.ZNode:
+			peer = l.ANode
+		}
+		if peer == "" || peer == name || seen[peer] {
+			continue
+		}
+		seen[peer] = true
+		out = append(out, peer)
+	}
+	return out
+}
+
+// nodeCannotAdoptRecreatedLink reports whether a running node keeps using the
+// interface it had at boot, so a link rebuilt under it is dead to it.
+func nodeCannotAdoptRecreatedLink(n node.Node) bool {
+	if n == nil {
+		return false
+	}
+	if nodeUsesKubeVirtVM(n) {
+		return true
+	}
+	p := n.GetProto()
+	return p != nil && p.GetVendor() == tpb.Vendor_CISCO && strings.EqualFold(strings.TrimSpace(p.GetModel()), "xrd")
+}
+
+func (m *Manager) regularNodeAdmissionRecoveryExhausted(ctx context.Context, n node.Node, state *regularNodeAdmissionRecoveryState) error {
+	if m == nil || n == nil || state == nil || nodeUsesKubeVirtVM(n) || state.attempts < maxRegularNodeAdmissionRecoveries {
+		return nil
+	}
+	pods, err := n.Pods(ctx)
+	if err != nil || len(pods) == 0 {
+		return nil
+	}
+	for _, pod := range pods {
+		if m.regularNodePodNeedsAdmissionRecovery(ctx, pod) {
+			return fmt.Errorf("regular-node admission recovery exhausted for node %s after %d attempt(s); %s", n.Name(), state.attempts, m.nodeAdmissionDebugSnapshot(ctx, n))
+		}
+	}
+	return nil
+}
+
+func (m *Manager) regularNodePodNeedsAdmissionRecovery(ctx context.Context, pod *corev1.Pod) bool {
+	if pod == nil {
+		return false
+	}
+	if pod.CreationTimestamp.IsZero() || time.Since(pod.CreationTimestamp.Time) < regularNodeAdmissionRecoveryMinPodAge {
+		return false
+	}
+	if m.podHasRetryableSandboxFailure(ctx, pod) {
+		return true
+	}
+	return m.podHasRetryableRegularStartupFailure(ctx, pod)
+}
+
+func (m *Manager) podHasRetryableRegularStartupFailure(ctx context.Context, pod *corev1.Pod) bool {
+	for _, event := range m.podAdmissionEvents(ctx, pod) {
+		event = strings.ToLower(event)
+		if strings.Contains(event, "iouyap management bridge reported a fatal interface failure") {
+			return true
+		}
+	}
+	for _, status := range append(append([]corev1.ContainerStatus{}, pod.Status.InitContainerStatuses...), pod.Status.ContainerStatuses...) {
+		waiting := status.State.Waiting
+		if waiting != nil && strings.Contains(strings.ToLower(waiting.Message), "iouyap management bridge reported a fatal interface failure") {
+			return true
+		}
+		terminated := status.State.Terminated
+		if terminated != nil && strings.Contains(strings.ToLower(terminated.Message), "iouyap management bridge reported a fatal interface failure") {
+			return true
+		}
+	}
+	if m.podHasStaleMissingInterfaceInitWait(ctx, pod) {
+		return true
+	}
+	if regularPodRestartedUnreadyAfterInitWait(pod) {
+		return true
+	}
+	return false
+}
+
+func regularPodRestartedUnreadyAfterInitWait(pod *corev1.Pod) bool {
+	if pod == nil || pod.Status.Phase != corev1.PodRunning || pod.CreationTimestamp.IsZero() {
+		return false
+	}
+	if time.Since(pod.CreationTimestamp.Time) < regularNodeMissingInterfaceMinPodAge {
+		return false
+	}
+	if podContainersReady(pod) || !podInitContainersSucceeded(pod) {
+		return false
+	}
+	if !podHasInitWaitInterfaceContract(pod) {
+		return false
+	}
+	for _, status := range pod.Status.ContainerStatuses {
+		if status.Ready || status.State.Running == nil || status.RestartCount == 0 {
+			continue
+		}
+		if status.LastTerminationState.Terminated != nil {
+			return true
+		}
+	}
+	return false
+}
+
+func podContainersReady(pod *corev1.Pod) bool {
+	if pod == nil {
+		return false
+	}
+	for _, condition := range pod.Status.Conditions {
+		if condition.Type == corev1.ContainersReady {
+			return condition.Status == corev1.ConditionTrue
+		}
+	}
+	for _, status := range pod.Status.ContainerStatuses {
+		if !status.Ready {
+			return false
+		}
+	}
+	return len(pod.Status.ContainerStatuses) > 0
+}
+
+func podHasInitWaitInterfaceContract(pod *corev1.Pod) bool {
+	if pod == nil {
+		return false
+	}
+	for _, spec := range pod.Spec.InitContainers {
+		if isInitWaitContainerForPod(pod, spec) && initWaitExpectedInterfaceCount(spec) > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) podHasStaleMissingInterfaceInitWait(ctx context.Context, pod *corev1.Pod) bool {
+	if m == nil || m.kClient == nil || pod == nil || pod.CreationTimestamp.IsZero() {
+		return false
+	}
+	if time.Since(pod.CreationTimestamp.Time) < regularNodeMissingInterfaceMinPodAge {
+		return false
+	}
+	initSpecs := initContainerSpecsByName(pod)
+	for _, status := range pod.Status.InitContainerStatuses {
+		if status.State.Running == nil {
+			continue
+		}
+		spec, ok := initSpecs[status.Name]
+		if !ok || !isInitWaitContainerForPod(pod, spec) {
+			continue
+		}
+		expectedInterfaces := initWaitExpectedInterfaceCount(spec)
+		tail := int64(40)
+		raw, err := m.kClient.CoreV1().Pods(pod.Namespace).GetLogs(pod.Name, &corev1.PodLogOptions{
+			Container: status.Name,
+			TailLines: &tail,
+		}).DoRaw(ctx)
+		if err == nil {
+			logText := string(raw)
+			if regularInitWaitLogHasMissingInterfaces(logText) {
+				return true
+			}
+			if regularInitWaitLogShowsComplete(logText) {
+				continue
+			}
+		}
+		if expectedInterfaces > 1 {
+			return true
+		}
+	}
+	return false
+}
+
+func initContainerSpecsByName(pod *corev1.Pod) map[string]corev1.Container {
+	out := make(map[string]corev1.Container, len(pod.Spec.InitContainers))
+	for _, spec := range pod.Spec.InitContainers {
+		out[spec.Name] = spec
+	}
+	return out
+}
+
+func isInitWaitContainerForPod(pod *corev1.Pod, spec corev1.Container) bool {
+	image := strings.ToLower(strings.TrimSpace(spec.Image))
+	if strings.Contains(image, "init-wait") {
+		return true
+	}
+	name := strings.ToLower(strings.TrimSpace(spec.Name))
+	if pod == nil || name != "init-"+strings.ToLower(strings.TrimSpace(pod.Name)) {
+		return false
+	}
+	return initWaitExpectedInterfaceCount(spec) > 1 && len(spec.Args) >= 2
+}
+
+func initWaitExpectedInterfaceCount(spec corev1.Container) int {
+	if len(spec.Args) == 0 {
+		return 0
+	}
+	expected, err := strconv.Atoi(strings.TrimSpace(spec.Args[0]))
+	if err != nil || expected < 0 {
+		return 0
+	}
+	return expected
+}
+
+func regularInitWaitLogHasMissingInterfaces(raw string) bool {
+	for _, line := range strings.Split(raw, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		var connected, expected int
+		if _, err := fmt.Sscanf(line, "Connected %d interfaces out of %d", &connected, &expected); err != nil {
+			continue
+		}
+		if expected > 0 && connected >= 0 && connected < expected {
+			return true
+		}
+	}
+	return false
+}
+
+func regularInitWaitLogShowsComplete(raw string) bool {
+	for _, line := range strings.Split(raw, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		if strings.HasPrefix(line, "Sleeping ") && strings.Contains(line, " before boot") {
+			return true
+		}
+		var connected, expected int
+		if _, err := fmt.Sscanf(line, "Connected %d interfaces out of %d", &connected, &expected); err != nil {
+			continue
+		}
+		if expected > 0 && connected >= expected {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) recreateRegularNode(ctx context.Context, n node.Node) error {
+	if n == nil {
+		return fmt.Errorf("regular-node recovery requires a node")
+	}
+	if err := n.Delete(ctx); err != nil {
+		return fmt.Errorf("delete regular node %s for recovery: %w", n.Name(), err)
+	}
+	if err := m.waitForRegularNodeCleanup(ctx, n); err != nil {
+		return err
+	}
+	// n.Delete (base Impl AND every vendor override, e.g. arista.Node) never
+	// calls DeleteConfig -- it is a standalone method nothing in the delete
+	// path invokes -- so the "<node>-config" ConfigMap CreateConfig writes
+	// survives every delete. A bare recreate then hits Create -> CreateConfig
+	// -> AlreadyExists and aborts the whole kne_cli process, leaving the
+	// node's pod gone with nothing left to recreate it (observed live,
+	// demo-lab 2026-09-22: two nodes stuck this way, their peers
+	// waiting on links that could never be wired). Clear it explicitly so
+	// recovery is actually idempotent.
+	if err := m.deleteRegularNodeConfigMap(ctx, n); err != nil {
+		return fmt.Errorf("clear stale config-map for regular node %s recovery: %w", n.Name(), err)
+	}
+	if err := n.Create(ctx); err != nil {
+		return fmt.Errorf("recreate regular node %s for recovery: %w", n.Name(), err)
+	}
+	return nil
+}
+
+func (m *Manager) deleteRegularNodeConfigMap(ctx context.Context, n node.Node) error {
+	if m == nil || m.kClient == nil || n == nil {
+		return nil
+	}
+	name := fmt.Sprintf("%s-config", n.Name())
+	if err := m.kClient.CoreV1().ConfigMaps(n.GetNamespace()).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	return nil
+}
+
+func (m *Manager) kubeVirtVMHasCrashLoopStartFailure(ctx context.Context, n node.Node) bool {
+	vm, ok := m.kubeVirtVMForNode(ctx, n)
+	if !ok {
+		return false
+	}
+	status, _, _ := unstructured.NestedString(vm.Object, "status", "printableStatus")
+	if !strings.EqualFold(strings.TrimSpace(status), "CrashLoopBackOff") {
+		return false
+	}
+	count, found, err := unstructured.NestedInt64(vm.Object, "status", "startFailure", "consecutiveFailCount")
+	return err == nil && found && count > 0
+}
+
+func (m *Manager) kubeVirtPodNeedsAdmissionRecovery(ctx context.Context, n node.Node, pod *corev1.Pod) bool {
+	if pod == nil {
+		return false
+	}
+	if pod.CreationTimestamp.IsZero() || time.Since(pod.CreationTimestamp.Time) < kubeVirtAdmissionRecoveryMinPodAge {
+		return false
+	}
+	if pod.Status.Phase == corev1.PodPending && !kubeVirtPodSandboxReady(pod) {
+		return m.podHasRetryableSandboxFailure(ctx, pod)
+	}
+	if m.kubeVirtVMIHasRetryableNetworkSyncFailure(ctx, n) {
+		return true
+	}
+	return false
+}
+
+func (m *Manager) kubeVirtNodeAdmissionReady(ctx context.Context, n node.Node) bool {
+	if !nodeUsesKubeVirtVM(n) {
+		return true
+	}
+	if m == nil || m.rCfg == nil || n == nil {
+		return true
+	}
+	vmi, ok := m.kubeVirtVMIForNode(ctx, n)
+	if !ok {
+		return false
+	}
+	phase, _, _ := unstructured.NestedString(vmi.Object, "status", "phase")
+	if phase != "Running" {
+		return false
+	}
+	conditions, _, _ := unstructured.NestedSlice(vmi.Object, "status", "conditions")
+	hasReady := false
+	for _, raw := range conditions {
+		condition, ok := raw.(map[string]any)
+		if !ok {
+			continue
+		}
+		conditionType, _ := condition["type"].(string)
+		status, _ := condition["status"].(string)
+		if conditionType == "Synchronized" && status == "False" {
+			return false
+		}
+		if conditionType == "Ready" && status == "True" {
+			hasReady = true
+		}
+	}
+	return hasReady
+}
+
+func (m *Manager) kubeVirtVMIHasRetryableNetworkSyncFailure(ctx context.Context, n node.Node) bool {
+	vmi, ok := m.kubeVirtVMIForNode(ctx, n)
+	if !ok {
+		return false
+	}
+	conditions, _, _ := unstructured.NestedSlice(vmi.Object, "status", "conditions")
+	for _, raw := range conditions {
+		condition, ok := raw.(map[string]any)
+		if !ok {
+			continue
+		}
+		conditionType, _ := condition["type"].(string)
+		status, _ := condition["status"].(string)
+		if conditionType != "Synchronized" || status != "False" {
+			continue
+		}
+		message, _ := condition["message"].(string)
+		reason, _ := condition["reason"].(string)
+		if kubeVirtRetryableNetworkSyncText(message) || kubeVirtRetryableNetworkSyncText(reason) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) kubeVirtVMIForNode(ctx context.Context, n node.Node) (*unstructured.Unstructured, bool) {
+	return m.kubeVirtObjectForNode(ctx, n, kubeVirtVMIGVRForAdmissionRecovery)
+}
+
+func (m *Manager) kubeVirtVMForNode(ctx context.Context, n node.Node) (*unstructured.Unstructured, bool) {
+	return m.kubeVirtObjectForNode(ctx, n, kubeVirtVMGVRForAdmissionRecovery)
+}
+
+func (m *Manager) kubeVirtObjectForNode(ctx context.Context, n node.Node, gvr schema.GroupVersionResource) (*unstructured.Unstructured, bool) {
+	if m == nil || m.rCfg == nil || n == nil {
+		return nil, false
+	}
+	dClient, err := newDynamicClient(m.rCfg)
+	if err != nil || dClient == nil {
+		return nil, false
+	}
+	ns := strings.TrimSpace(n.GetNamespace())
+	name := strings.TrimSpace(n.Name())
+	if ns == "" || name == "" {
+		return nil, false
+	}
+	obj, err := dClient.Resource(gvr).Namespace(ns).Get(ctx, name, metav1.GetOptions{})
+	if err != nil || obj == nil {
+		return nil, false
+	}
+	return obj, true
+}
+
+func kubeVirtRetryableNetworkSyncText(text string) bool {
+	text = strings.ToLower(strings.TrimSpace(text))
+	return strings.Contains(text, "failed to configure vmi network") &&
+		strings.Contains(text, "pod link") &&
+		strings.Contains(text, " is missing")
+}
+
+func (m *Manager) podHasRetryableSandboxFailure(ctx context.Context, pod *corev1.Pod) bool {
+	for _, event := range m.podAdmissionEvents(ctx, pod) {
+		event = strings.ToLower(event)
+		if !strings.Contains(event, "failedcreatepodsandbox") {
+			continue
+		}
+		switch {
+		case strings.Contains(event, "context deadline exceeded"),
+			strings.Contains(event, "failed to reserve sandbox name"),
+			strings.Contains(event, " is reserved for "),
+			strings.Contains(event, "unable to create endpoint"),
+			strings.Contains(event, "too many requests"),
+			strings.Contains(event, "toomanyrequests"),
+			strings.Contains(event, " 429"),
+			strings.Contains(event, "[429]"),
+			strings.Contains(event, "rst_stream"),
+			strings.Contains(event, "deadlineexceeded"):
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) recreateKubeVirtVMI(ctx context.Context, n node.Node, pod *corev1.Pod) error {
+	ns := strings.TrimSpace(n.GetNamespace())
+	name := strings.TrimSpace(n.Name())
+	if ns == "" || name == "" {
+		return fmt.Errorf("node namespace/name is empty")
+	}
+	if m.rCfg != nil {
+		dClient, err := newDynamicClient(m.rCfg)
+		if err != nil {
+			return fmt.Errorf("create dynamic client: %w", err)
+		}
+		err = dClient.Resource(kubeVirtVMIGVRForAdmissionRecovery).Namespace(ns).Delete(ctx, name, metav1.DeleteOptions{})
+		switch {
+		case err == nil:
+		case !apierrors.IsNotFound(err):
+			return fmt.Errorf("delete kubevirt vmi %s/%s: %w", ns, name, err)
+		}
+	}
+	if m.kClient == nil || pod == nil || pod.Name == "" {
+		if pod == nil || pod.Name == "" {
+			return nil
+		}
+		return fmt.Errorf("kubevirt vmi %s/%s recovery requires launcher pod cleanup but kubernetes client is unavailable", ns, name)
+	}
+	gracePeriodSeconds := int64(0)
+	if err := m.kClient.CoreV1().Pods(ns).Delete(ctx, pod.Name, metav1.DeleteOptions{GracePeriodSeconds: &gracePeriodSeconds}); err != nil && !apierrors.IsNotFound(err) {
+		return fmt.Errorf("delete kubevirt launcher pod %s/%s: %w", ns, pod.Name, err)
+	}
+	return m.waitForKubeVirtLauncherCleanup(ctx, ns, pod.Name)
+}
+
+func (m *Manager) waitForRegularNodeCleanup(ctx context.Context, n node.Node) error {
+	if m == nil || n == nil {
+		return nil
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, regularNodeAdmissionCleanupTimeout)
+	defer cancel()
+	ticker := time.NewTicker(regularNodeAdmissionCleanupPollInterval)
+	defer ticker.Stop()
+	for {
+		pods, err := n.Pods(waitCtx)
+		if err != nil || len(pods) == 0 {
+			return nil
+		}
+		allDeleting := true
+		for _, pod := range pods {
+			if pod != nil && pod.DeletionTimestamp.IsZero() {
+				allDeleting = false
+				break
+			}
+		}
+		if allDeleting {
+			log.Infof("Waiting for regular-node pods for %s deletion to complete before retrying admission", n.Name())
+		}
+		select {
+		case <-waitCtx.Done():
+			return fmt.Errorf("timed out waiting for regular node %s cleanup: %w", n.Name(), waitCtx.Err())
+		case <-ticker.C:
+		}
+	}
+}
+
+func (m *Manager) waitForKubeVirtLauncherCleanup(ctx context.Context, namespace, podName string) error {
+	if m == nil || m.kClient == nil || strings.TrimSpace(namespace) == "" || strings.TrimSpace(podName) == "" {
+		return nil
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, kubeVirtAdmissionCleanupTimeout)
+	defer cancel()
+	ticker := time.NewTicker(kubeVirtAdmissionCleanupPollInterval)
+	defer ticker.Stop()
+	for {
+		pod, err := m.kClient.CoreV1().Pods(namespace).Get(waitCtx, podName, metav1.GetOptions{})
+		switch {
+		case apierrors.IsNotFound(err):
+			return nil
+		case err != nil:
+			return fmt.Errorf("wait for kubevirt launcher pod cleanup %s/%s: %w", namespace, podName, err)
+		case pod != nil && !pod.DeletionTimestamp.IsZero():
+			log.Infof("Waiting for KubeVirt launcher pod %s/%s deletion to complete before retrying admission", namespace, podName)
+		}
+		select {
+		case <-waitCtx.Done():
+			return fmt.Errorf("timed out waiting for kubevirt launcher pod cleanup %s/%s: %w", namespace, podName, waitCtx.Err())
+		case <-ticker.C:
+		}
+	}
+}
