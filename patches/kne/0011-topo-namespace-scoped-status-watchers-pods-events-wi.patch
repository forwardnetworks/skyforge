+package topo
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	kfake "k8s.io/client-go/kubernetes/fake"
+)
+
+// demo-lab, 2026-09-27: sjc-dc1-ce01 was recreated while its PAN VM
+// peer was still booting. The rebuild handed the already-running XRd PE a new
+// eth3 it never binds and the VM a link it never saw -- DC-to-DC traffic 0/4
+// with every pod Running. Recovery must not recreate a node whose peers are
+// not up yet, nor one whose running peer cannot adopt a re-created interface.
+
+// stuckR1 is the r1 of the Cilium-429 test: a pod the recovery DOES want to
+// recreate on its own merits, so every outcome below is decided by the peer.
+func stuckR1() (*corev1.Pod, *corev1.Event) {
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: "r1", Namespace: "test", CreationTimestamp: metav1.NewTime(time.Now().Add(-time.Minute)), UID: "old-pod"},
+		Status:     corev1.PodStatus{Phase: corev1.PodPending},
+	}
+	event := &corev1.Event{
+		ObjectMeta:     metav1.ObjectMeta{Name: "r1.1", Namespace: "test"},
+		InvolvedObject: corev1.ObjectReference{Kind: "Pod", Namespace: "test", Name: "r1"},
+		Type:           corev1.EventTypeWarning,
+		Reason:         "FailedCreatePodSandBox",
+		Message:        `plugin type="cilium-cni" failed (add): unable to create endpoint: [429] putEndpointIdTooManyRequests`,
+		LastTimestamp:  metav1.Now(),
+	}
+	return pod, event
+}
+
+func peerNode(client *kfake.Clientset, name string, vendor tpb.Vendor, model string) node.Node {
+	return peerNodeWithImage(client, name, vendor, model, "img")
+}
+
+func peerNodeWithImage(client *kfake.Clientset, name string, vendor tpb.Vendor, model, image string) node.Node {
+	return &configurable{Impl: &node.Impl{
+		Namespace:  "test",
+		KubeClient: client,
+		Proto:      &tpb.Node{Name: name, Vendor: vendor, Model: model, Config: &tpb.Config{Image: image}},
+	}}
+}
+
+func runRecovery(t *testing.T, peerPhase corev1.PodPhase, peerVendor tpb.Vendor, peerModel string) (bool, string) {
+	t.Helper()
+	return runRecoveryWithPeer(t, peerPhase, func(client *kfake.Clientset) node.Node {
+		return peerNode(client, "p1", peerVendor, peerModel)
+	})
+}
+
+// runRecoveryWithPeer drives the REAL recovery for a stuck r1 linked to p1.
+func runRecoveryWithPeer(t *testing.T, peerPhase corev1.PodPhase, peer func(*kfake.Clientset) node.Node) (bool, string) {
+	t.Helper()
+	pod, event := stuckR1()
+	// Named for a pod-backed peer (found by name) and labelled for a KubeVirt
+	// one (found by vm.kubevirt.io/name), so either peer kind sees its pod.
+	peerPod := &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "p1", Namespace: "test", Labels: map[string]string{"vm.kubevirt.io/name": "p1"}}, Status: corev1.PodStatus{Phase: peerPhase}}
+	client := kfake.NewSimpleClientset(pod, event, peerPod)
+	n := regularRecoveryTestNode(client)
+	m := &Manager{
+		kClient: client,
+		topo:    &tpb.Topology{Links: []*tpb.Link{{ANode: "r1", AInt: "eth2", ZNode: "p1", ZInt: "eth3"}}},
+		nodes:   map[string]node.Node{"r1": n, "p1": peer(client)},
+	}
+	recovered, err := m.maybeRecoverRegularNodeAdmission(context.Background(), context.Background(), n, &regularNodeAdmissionRecoveryState{})
+	if err != nil {
+		t.Fatalf("maybeRecoverRegularNodeAdmission() error = %v", err)
+	}
+	got, err := client.CoreV1().Pods("test").Get(context.Background(), "r1", metav1.GetOptions{})
+	if err != nil {
+		t.Fatalf("r1 pod get: %v", err)
+	}
+	return recovered, string(got.UID)
+}
+
+func TestRegularRecoveryWaitsForAPeerThatIsNotRunningYet(t *testing.T) {
+	recovered, uid := runRecovery(t, corev1.PodPending, tpb.Vendor_PALOALTO, "panos")
+	if recovered || uid != "old-pod" {
+		t.Fatalf("recovered=%v uid=%q: a peer still coming up has not wired its end; recreating cannot help", recovered, uid)
+	}
+}
+
+func TestRegularRecoveryDoesNotStrandARunningXRdPeer(t *testing.T) {
+	recovered, uid := runRecovery(t, corev1.PodRunning, tpb.Vendor_CISCO, "xrd")
+	if recovered || uid != "old-pod" {
+		t.Fatalf("recovered=%v uid=%q: XRd binds its interfaces once at boot; a rebuilt link is dead to it", recovered, uid)
+	}
+}
+
+func TestRegularRecoveryDoesNotStrandARunningKubeVirtPeer(t *testing.T) {
+	// The CE's inside PAN on demo-lab 2026-09-27: a KubeVirt VM whose NIC was
+	// wired once at boot. The REAL recovery must leave r1 alone while it runs.
+	recovered, uid := runRecoveryWithPeer(t, corev1.PodRunning, func(client *kfake.Clientset) node.Node {
+		return peerNodeWithImage(client, "p1", tpb.Vendor_PALOALTO, "panos", "registry.example.com/skyforge/kubevirt/vr-pan:11.0.0-kne-r8")
+	})
+	if recovered || uid != "old-pod" {
+		t.Fatalf("recovered=%v uid=%q: a running KubeVirt VM cannot adopt a rebuilt link", recovered, uid)
+	}
+}
+
+// CONTROL: a running peer that adopts new interfaces (cEOS, IOL, linux) leaves
+// the recovery exactly as it was -- the guard only removes the two harmful cases.
+func TestRegularRecoveryStillRecreatesWhenPeersAreRunningAndHotplugCapable(t *testing.T) {
+	recovered, uid := runRecovery(t, corev1.PodRunning, tpb.Vendor_ARISTA, "ceos")
+	if !recovered || uid == "old-pod" {
+		t.Fatalf("recovered=%v uid=%q: with a healthy hot-plug-capable peer the recovery must still recreate", recovered, uid)
+	}
+}
+
+// The VM recovery path recreates the launcher pod, which rebuilds the VM's
+// links: a running XRd peer must stop it, a not-yet-running one must not.
+func TestKubeVirtRecoveryRefusesToStrandARunningXRdPeer(t *testing.T) {
+	client := kfake.NewSimpleClientset(&corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "p1", Namespace: "test"}, Status: corev1.PodStatus{Phase: corev1.PodRunning}})
+	vm := kubeVirtTestNode(client)
+	m := &Manager{
+		kClient: client,
+		topo:    &tpb.Topology{Links: []*tpb.Link{{ANode: "r1", AInt: "eth1", ZNode: "p1", ZInt: "eth3"}}},
+		nodes:   map[string]node.Node{"r1": vm, "p1": peerNode(client, "p1", tpb.Vendor_CISCO, "xrd")},
+	}
+	if reason := m.recoveryWouldStrandRunningPeer(context.Background(), vm); reason == "" {
+		t.Fatal("a running XRd peer must block the VM recreate")
+	}
+	pending := kfake.NewSimpleClientset(&corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: "p1", Namespace: "test"}, Status: corev1.PodStatus{Phase: corev1.PodPending}})
+	m.nodes["p1"] = peerNode(pending, "p1", tpb.Vendor_CISCO, "xrd")
+	if reason := m.recoveryWouldStrandRunningPeer(context.Background(), vm); reason != "" {
+		t.Fatalf("an XRd peer that is not running yet binds at boot and is not stranded: %s", reason)
+	}
+}
