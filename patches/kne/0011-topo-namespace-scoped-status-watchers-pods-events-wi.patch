+++ b/topo/topo_adjacency_test.go
@@ -0,0 +1,130 @@
+package topo
+
+import (
+	"testing"
+
+	topopb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+)
+
+type fakeNode struct {
+	node.Node
+	pb *topopb.Node
+}
+
+func (f *fakeNode) GetProto() *topopb.Node { return f.pb }
+
+func mk(name string, peers ...string) node.Node {
+	intfs := map[string]*topopb.Interface{}
+	for i, p := range peers {
+		intfs[string(rune('a'+i))] = &topopb.Interface{PeerName: p}
+	}
+	return &fakeNode{pb: &topopb.Node{Name: name, Interfaces: intfs}}
+}
+
+func names(ns []node.Node) []string {
+	out := make([]string, 0, len(ns))
+	for _, n := range ns {
+		out = append(out, n.GetProto().GetName())
+	}
+	return out
+}
+
+// distance between a node and its peer in admission order. With parallelism P,
+// a distance < P means they are admitted in the SAME window.
+func dist(order []string, a, b string) int {
+	ia, ib := -1, -1
+	for i, n := range order {
+		if n == a {
+			ia = i
+		}
+		if n == b {
+			ib = i
+		}
+	}
+	if ia < 0 || ib < 0 {
+		return 1 << 30
+	}
+	if ia > ib {
+		return ia - ib
+	}
+	return ib - ia
+}
+
+// THE demo-lab CASE. An adversarial input order puts cdg-acc-sw01 and its peer
+// cdg-dis-sw01 at opposite ends; measured on the real lab they were admitted 45
+// minutes apart against a 180s peer-wait.
+func TestOrderNodesByAdjacencyPutsPeersTogether(t *testing.T) {
+	in := []node.Node{
+		mk("cdg-acc-sw01", "cdg-dis-sw01"),
+		mk("far-a", "far-b"),
+		mk("far-b", "far-a"),
+		mk("far-c", "far-d"),
+		mk("far-d", "far-c"),
+		mk("cdg-dis-sw01", "cdg-acc-sw01"),
+	}
+	before := dist(names(in), "cdg-acc-sw01", "cdg-dis-sw01")
+	got := orderNodesByAdjacency(in)
+	after := dist(names(got), "cdg-acc-sw01", "cdg-dis-sw01")
+
+	if len(got) != len(in) {
+		t.Fatalf("lost nodes: %d in, %d out", len(in), len(got))
+	}
+	t.Logf("peer distance before=%d after=%d order=%v", before, after, names(got))
+	if after >= before {
+		t.Fatalf("ordering did not bring peers closer: before=%d after=%d", before, after)
+	}
+	if after != 1 {
+		t.Fatalf("peers should be ADJACENT so parallelism 2 co-admits them, distance=%d", after)
+	}
+}
+
+// Every peer pair must be co-admittable at parallelism 2.
+func TestOrderNodesByAdjacencyEveryPairWithinTheWindow(t *testing.T) {
+	in := []node.Node{
+		mk("a1", "a2"), mk("b1", "b2"), mk("a2", "a1"),
+		mk("c1", "c2"), mk("b2", "b1"), mk("c2", "c1"),
+	}
+	order := names(orderNodesByAdjacency(in))
+	for _, pair := range [][2]string{{"a1", "a2"}, {"b1", "b2"}, {"c1", "c2"}} {
+		if d := dist(order, pair[0], pair[1]); d != 1 {
+			t.Fatalf("%v distance=%d, want 1 (order=%v)", pair, d, order)
+		}
+	}
+}
+
+// It must never drop or duplicate a node, whatever the input.
+func TestOrderNodesByAdjacencyPreservesTheSet(t *testing.T) {
+	in := []node.Node{
+		mk("x", "missing-peer"), mk("y"), mk("z", "x"), mk("w", "z"),
+	}
+	got := orderNodesByAdjacency(in)
+	if len(got) != len(in) {
+		t.Fatalf("set size changed: %d -> %d", len(in), len(got))
+	}
+	seen := map[string]int{}
+	for _, n := range got {
+		seen[n.GetProto().GetName()]++
+	}
+	for _, n := range in {
+		if seen[n.GetProto().GetName()] != 1 {
+			t.Fatalf("node %q appears %d times", n.GetProto().GetName(), seen[n.GetProto().GetName()])
+		}
+	}
+}
+
+// Determinism: same input, same output.
+func TestOrderNodesByAdjacencyIsDeterministic(t *testing.T) {
+	build := func() []node.Node {
+		return []node.Node{mk("n1", "n2"), mk("n3", "n4"), mk("n2", "n1"), mk("n4", "n3")}
+	}
+	a := names(orderNodesByAdjacency(build()))
+	for i := 0; i < 20; i++ {
+		b := names(orderNodesByAdjacency(build()))
+		for j := range a {
+			if a[j] != b[j] {
+				t.Fatalf("non-deterministic: %v vs %v", a, b)
+			}
+		}
+	}
+}
