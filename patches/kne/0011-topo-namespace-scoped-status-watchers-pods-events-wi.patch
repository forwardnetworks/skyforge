+func nodeAdmissionDebugSnapshot(ctx context.Context, n node.Node) string {
+	return (&Manager{}).nodeAdmissionDebugSnapshot(ctx, n)
+}
+
+func (m *Manager) nodeAdmissionDebugSnapshot(ctx context.Context, n node.Node) string {
+	pods, err := n.Pods(ctx)
+	if err != nil {
+		return fmt.Sprintf("admission-debug=pods-fetch-error:%v", err)
+	}
+	if len(pods) == 0 {
+		return "admission-debug=no-pods-observed"
+	}
+	lines := make([]string, 0, len(pods))
+	for _, pod := range pods {
+		if pod == nil {
+			lines = append(lines, "nil-pod")
+			continue
+		}
+		reason := strings.TrimSpace(pod.Status.Reason)
+		msg := strings.TrimSpace(pod.Status.Message)
+		if len(msg) > 160 {
+			msg = msg[:160] + "..."
+		}
+		conditions := podConditionSummary(pod.Status.Conditions)
+		initWaiting := containerStateSummary(pod.Status.InitContainerStatuses)
+		waiting := containerStateSummary(pod.Status.ContainerStatuses)
+		events := m.podAdmissionEvents(ctx, pod)
+		kubeVirtStatus := m.kubeVirtStatusEvidence(ctx, n)
+		lines = append(lines, fmt.Sprintf("pod=%s phase=%s ip=%q reason=%q init=%q containers=%q conditions=%q kubevirt=%q events=%q msg=%q",
+			pod.Name, pod.Status.Phase, strings.TrimSpace(pod.Status.PodIP), reason, initWaiting, waiting, conditions, strings.Join(kubeVirtStatus, ";"), strings.Join(events, ";"), msg))
+	}
+	return "admission-debug=" + strings.Join(lines, " | ")
+}
+
+func podConditionSummary(conditions []corev1.PodCondition) string {
+	if len(conditions) == 0 {
+		return ""
+	}
+	out := make([]string, 0, len(conditions))
+	for _, condition := range conditions {
+		part := fmt.Sprintf("%s:%s", condition.Type, condition.Status)
+		if reason := strings.TrimSpace(condition.Reason); reason != "" {
+			part += ":" + reason
+		}
+		out = append(out, part)
+	}
+	return strings.Join(out, ",")
+}
+
+func containerStateSummary(statuses []corev1.ContainerStatus) string {
+	if len(statuses) == 0 {
+		return ""
+	}
+	out := make([]string, 0, len(statuses))
+	for _, status := range statuses {
+		switch {
+		case status.State.Waiting != nil:
+			reason := strings.TrimSpace(status.State.Waiting.Reason)
+			if reason == "" {
+				reason = "Waiting"
+			}
+			out = append(out, status.Name+":"+reason)
+		case status.State.Terminated != nil:
+			reason := strings.TrimSpace(status.State.Terminated.Reason)
+			if reason == "" {
+				reason = fmt.Sprintf("exit-%d", status.State.Terminated.ExitCode)
+			}
+			out = append(out, status.Name+":"+reason)
+		}
+	}
+	return strings.Join(out, ",")
+}
+
+func (m *Manager) podAdmissionEvents(ctx context.Context, pod *corev1.Pod) []string {
+	if m == nil || m.kClient == nil || pod == nil || pod.Namespace == "" || pod.Name == "" {
+		return nil
+	}
+	events, err := m.kClient.CoreV1().Events(pod.Namespace).List(ctx, metav1.ListOptions{
+		FieldSelector: fmt.Sprintf("involvedObject.name=%s", pod.Name),
+	})
+	if err != nil || events == nil || len(events.Items) == 0 {
+		return nil
+	}
+	items := append([]corev1.Event(nil), events.Items...)
+	sort.Slice(items, func(i, j int) bool {
+		return eventTimestamp(items[i]).Before(eventTimestamp(items[j]))
+	})
+	out := make([]string, 0, len(items))
+	podCreated := pod.CreationTimestamp.Time
+	for _, event := range items {
+		if !pod.CreationTimestamp.IsZero() && eventTimestamp(event).Before(podCreated.Add(-1*time.Second)) {
+			continue
+		}
+		reason := strings.TrimSpace(event.Reason)
+		message := truncateDebugMessage(strings.TrimSpace(event.Message), 160)
+		if reason == "" {
+			reason = strings.TrimSpace(event.Type)
+		}
+		if message == "" {
+			out = append(out, reason)
+			continue
+		}
+		out = append(out, reason+":"+message)
+	}
+	if len(out) > maxAdmissionDebugEvents {
+		out = out[len(out)-maxAdmissionDebugEvents:]
+	}
+	return out
+}
+
+func eventTimestamp(event corev1.Event) time.Time {
+	switch {
+	case !event.EventTime.IsZero():
+		return event.EventTime.Time
+	case !event.LastTimestamp.IsZero():
+		return event.LastTimestamp.Time
+	case !event.FirstTimestamp.IsZero():
+		return event.FirstTimestamp.Time
+	default:
+		return event.CreationTimestamp.Time
+	}
+}
+
+func truncateDebugMessage(message string, limit int) string {
+	if limit <= 0 || len(message) <= limit {
+		return message
+	}
+	return message[:limit] + "..."
+}
+
+func (m *Manager) kubeVirtStatusEvidence(ctx context.Context, n node.Node) []string {
+	if m == nil || m.rCfg == nil || n == nil || n.GetProto() == nil {
+		return nil
+	}
+	dClient, err := newDynamicClient(m.rCfg)
+	if err != nil || dClient == nil {
+		return nil
+	}
+	ns := strings.TrimSpace(n.GetNamespace())
+	name := strings.TrimSpace(n.Name())
+	if ns == "" || name == "" {
+		return nil
+	}
+	resources := []struct {
+		label string
+		gvr   schema.GroupVersionResource
+	}{
+		{
+			label: "vm",
+			gvr: schema.GroupVersionResource{
+				Group:    "kubevirt.io",
+				Version:  "v1",
+				Resource: "virtualmachines",
+			},
+		},
+		{
+			label: "vmi",
+			gvr: schema.GroupVersionResource{
+				Group:    "kubevirt.io",
+				Version:  "v1",
+				Resource: "virtualmachineinstances",
+			},
+		},
+	}
+	out := []string{}
+	for _, resource := range resources {
+		obj, err := dClient.Resource(resource.gvr).Namespace(ns).Get(ctx, name, metav1.GetOptions{})
+		if err != nil || obj == nil {
+			continue
+		}
+		if status := kubeVirtObjectStatus(resource.label, obj); status != "" {
+			out = append(out, status)
+		}
+	}
+	return out
+}
+
+func kubeVirtObjectStatus(label string, obj *unstructured.Unstructured) string {
+	if obj == nil {
+		return ""
+	}
+	parts := []string{label}
+	if phase, _, _ := unstructured.NestedString(obj.Object, "status", "phase"); strings.TrimSpace(phase) != "" {
+		parts = append(parts, "phase="+strings.TrimSpace(phase))
+	}
+	conditions, _, _ := unstructured.NestedSlice(obj.Object, "status", "conditions")
+	conditionParts := []string{}
+	for _, raw := range conditions {
+		condition, ok := raw.(map[string]any)
+		if !ok {
+			continue
+		}
+		conditionType, _ := condition["type"].(string)
+		conditionStatus, _ := condition["status"].(string)
+		if strings.TrimSpace(conditionType) == "" || strings.TrimSpace(conditionStatus) == "" {
+			continue
+		}
+		part := strings.TrimSpace(conditionType) + ":" + strings.TrimSpace(conditionStatus)
+		if reason, _ := condition["reason"].(string); strings.TrimSpace(reason) != "" {
+			part += ":" + strings.TrimSpace(reason)
+		}
+		conditionParts = append(conditionParts, part)
+	}
+	if len(conditionParts) > 0 {
+		parts = append(parts, "conditions="+strings.Join(conditionParts, ","))
+	}
+	if len(parts) == 1 {
+		return ""
+	}
+	return strings.Join(parts, " ")
+}
+
+func nodePodsAdmitted(ctx context.Context, n node.Node) (bool, error) {
+	pods, err := n.Pods(ctx)
+	if err != nil {
+		return false, nil
+	}
+	if len(pods) == 0 {
+		return false, nil
+	}
+	for _, pod := range pods {
+		if pod == nil {
+			return false, nil
+		}
+		switch pod.Status.Phase {
+		case "":
+			continue
+		case corev1.PodFailed:
+			continue
+		}
+		if !podInitContainersSucceeded(pod) {
+			return false, nil
+		}
+		switch pod.Status.Phase {
+		case corev1.PodSucceeded, corev1.PodRunning:
+			continue
+		}
+		if pod.UID == "" && pod.CreationTimestamp.IsZero() {
+			continue
+		}
+		if strings.TrimSpace(pod.Status.PodIP) == "" {
+			return false, nil
+		}
+		if nodeUsesKubeVirtVM(n) && !kubeVirtPodSandboxReady(pod) {
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+func podInitContainersSucceeded(pod *corev1.Pod) bool {
+	if pod == nil || len(pod.Spec.InitContainers) == 0 {
+		return true
+	}
+	statuses := make(map[string]corev1.ContainerStatus, len(pod.Status.InitContainerStatuses))
+	for _, status := range pod.Status.InitContainerStatuses {
+		statuses[status.Name] = status
+	}
+	for _, initContainer := range pod.Spec.InitContainers {
+		// A NATIVE SIDECAR (an init container with restartPolicy: Always) runs
+		// for the whole life of the pod and NEVER terminates -- that is its
+		// definition, not a failure. Demanding Terminated+exit0 from one is a
+		// predicate that can never be satisfied.
+		//
+		// KubeVirt v1.9.0 (this cluster upgraded 2026-08-22) injects exactly
+		// such a sidecar, `guest-console-log`, into every virt-launcher pod. So
+		// from that upgrade onward EVERY KubeVirt VM node -- nxos, panos, sros,
+		// a10, asav, fortios, dellos10, versa, viptela, vjunos -- hung here
+		// until its admission deadline expired, while the VM itself was
+		// perfectly healthy (vmi phase=Running conditions=Ready:True, pod
+		// Ready:True). The failure names the deadline, never the sidecar.
+		if initContainer.RestartPolicy != nil && *initContainer.RestartPolicy == corev1.ContainerRestartPolicyAlways {
+			continue
+		}
+		status, ok := statuses[initContainer.Name]
+		if !ok || status.State.Terminated == nil || status.State.Terminated.ExitCode != 0 {
+			return false
+		}
+	}
+	return true
+}
+
+func nodePodSandboxStable(ctx context.Context, n node.Node) (bool, error) {
+	pods, err := n.Pods(ctx)
+	if err != nil {
+		return false, nil
+	}
+	if len(pods) == 0 {
+		return false, nil
+	}
+	for _, pod := range pods {
+		if podSandboxStable(pod) {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+func podSandboxStable(pod *corev1.Pod) bool {
+	if pod == nil {
+		return false
+	}
+	switch pod.Status.Phase {
+	case corev1.PodRunning, corev1.PodSucceeded:
+		return true
+	case corev1.PodFailed:
+		return false
+	}
+	if strings.TrimSpace(pod.Status.PodIP) == "" {
+		return false
+	}
+	for _, condition := range pod.Status.Conditions {
+		if condition.Type == corev1.PodReadyToStartContainers {
+			return condition.Status == corev1.ConditionTrue
+		}
+	}
+	return true
+}
+
+func nodeUsesKubeVirtVM(n node.Node) bool {
+	kubeVirtNode, ok := n.(interface{ UsesKubeVirtVM() bool })
+	return ok && kubeVirtNode.UsesKubeVirtVM()
+}
+
+func kubeVirtPodSandboxReady(pod *corev1.Pod) bool {
+	if pod == nil {
+		return false
+	}
+	for _, condition := range pod.Status.Conditions {
+		if condition.Type == corev1.PodReadyToStartContainers {
+			return condition.Status == corev1.ConditionTrue
+		}
+	}
+	// Older Kubernetes versions may not publish PodReadyToStartContainers.
+	// Preserve the existing PodIP-based behavior when the condition is absent.
+	return true
+}
+
+func updateServicePortName(s *tpb.Service, port uint32) {
+	i := 0
+	for _, name := range s.Names {
+		if name != "" {
+			s.Names[i] = name
+			i++
+		}
+	}
+	s.Names = s.Names[:i]
+
+	if s.Name == "" && len(s.Names) > 0 {
+		s.Name = s.Names[0]
+	} else if s.Name == "" {
+		s.Name = fmt.Sprintf("port-%d", port)
+	}
+}
+
+// createMeshnetTopologies creates meshnet resources for all available nodes.
+func (m *Manager) createMeshnetTopologies(ctx context.Context) error {
+	log.Infof("Getting topology specs for namespace %s", m.topo.Name)
+	topologies, err := m.topologySpecs(ctx)
+	if err != nil {
+		return fmt.Errorf("could not get meshnet topologies: %v", err)
+	}
+	log.V(2).Infof("Got topology specs for namespace %s: %+v", m.topo.Name, topologies)
+	return m.createMeshnetTopologiesWithLimit(ctx, topologies)
+}
+
+// createMeshnetTopologiesWithLimit creates the meshnet Topology CRs with a bounded
+// fan-out (patch 0010). The create itself moved from the networkop typed client to
+// the dynamic client on meshnetGVR (upstream 9bad8f5).
+func (m *Manager) createMeshnetTopologiesWithLimit(ctx context.Context, topologies []*topologyv1.Topology) error {
+	if len(topologies) == 0 {
+		return nil
+	}
+	g, ctx := errgroup.WithContext(ctx)
+	g.SetLimit(meshnetTopologyParallelism(len(topologies)))
+	for _, t := range topologies {
+		topo := t
+		g.Go(func() error {
+			log.Infof("Creating topology for meshnet node %s", topo.ObjectMeta.Name)
+			topo.TypeMeta = metav1.TypeMeta{
+				Kind:       "Topology",
+				APIVersion: topologyv1.SchemeGroupVersion.String(),
+			}
+			obj, err := runtime.DefaultUnstructuredConverter.ToUnstructured(topo)
+			if err != nil {
+				return fmt.Errorf("could not convert topology for meshnet node %s to unstructured: %w", topo.ObjectMeta.Name, err)
+			}
+			sT, err := m.dClient.Resource(meshnetGVR).Namespace(m.topo.Name).Create(ctx, &unstructured.Unstructured{Object: obj}, metav1.CreateOptions{})
+			if err != nil {
+				return fmt.Errorf("could not create topology for meshnet node %s: %v", topo.ObjectMeta.Name, err)
+			}
+			log.V(1).Infof("Meshnet Node:\n%+v\n", sT)
+			return nil
+		})
+	}
+	return g.Wait()
+}
+
+func meshnetTopologyParallelism(total int) int {
+	if total <= 0 {
+		return 1
+	}
+	if total > maxMeshnetTopologyParallelism {
+		return maxMeshnetTopologyParallelism
+	}
+	return total
+}
+
+func nodeCreateParallelism(total int) int {
+	if total <= 0 {
+		return 1
+	}
+	if total > maxNodeCreateParallelism {
+		return maxNodeCreateParallelism
+	}
+	return total
+}
+
+func nodeCreateParallelismForNodes(nodes []node.Node) int {
+	limit := nodeCreateParallelism(len(nodes))
+	for _, n := range nodes {
+		policy := runtimeAdmissionPolicyForNode(n)
+		if policy.MaxParallelism > 0 && limit > policy.MaxParallelism {
+			limit = policy.MaxParallelism
+		}
+	}
+	return limit
+}
+
+func nodeCreatePriority(n node.Node) int {
+	if n == nil || n.GetProto() == nil {
+		return 100
+	}
+	model := strings.ToLower(strings.TrimSpace(n.GetProto().GetModel()))
+	switch model {
+	case "a10", "asav", "cat8000v", "dellos10", "f5-bigip", "fortios", "nxos", "panos", "sros", "vbond", "vedge", "vmanage", "vsmart", "vjunos-switch", "vmx":
+		return 0
+	case "iol", "ioll2":
+		return 20
+	default:
+		return 10
+	}
+}
+
+func nodeAdmissionTimeoutForNode(n node.Node) time.Duration {
+	return runtimeAdmissionPolicyForNode(n).AdmissionDeadline
+}
+
+// heavyLaneWidthForNodes is how many heavy nodes may be settling AT ONCE.
+//
+// IT IS THE MAXIMUM, NOT THE MINIMUM. It used to be the minimum MaxParallelism
+// across every node in the lane, which meant ONE model with a width of 1
+// collapsed the lane for everything else. MEASURED on demo-lab 2026-09-11: two
+// PAN-OS nodes (panos: 1) took a lane holding 4 vJunos, 4 cat8000v, 2 ASAv and
+// 3 SD-WAN controllers down to width 1, and the whole bring-up then ran at one
+// VM per 10 minutes -- 150 minutes of pacing before the last VM existed.
+//
+// A per-model width is a statement about THAT model, not about the lane, so it
+// is now enforced per model by heavyAdmissionPacer and the lane keeps the width
+// the policy actually asked for. The lane width is the widest any model in it
+// allows, because a narrower model is already held back by its own semaphore.
+func heavyLaneWidthForNodes(nodes []node.Node) int {
+	width := 0
+	for _, n := range nodes {
+		policy := runtimeAdmissionPolicyForNode(n)
+		if policy.Lane != admissionLaneHeavy {
+			continue
+		}
+		if policy.MaxParallelism > width {
+			width = policy.MaxParallelism
+		}
+	}
+	if width < 1 {
+		return 1
+	}
+	return width
+}
+
+// heavyAdmissionGroups partitions a lane into the sets that must be created
+// TOGETHER: the connected components of the lane's OWN link graph.
+//
+// WHY A COMPONENT IS THE UNIT. meshnet's KubeVirt secondary path cannot wire a
+// VM's interface until the pod on the other end of that link is alive, and a
+// VM needs its WHOLE heavy neighbourhood, not one peer. MEASURED on demo-lab
+// 2026-09-11: cdg-cor-sw01 had both vJunos peers alive at 14:52:20 and still
+// sat in Scheduling until cdg-fw01, its third heavy peer, was created ten
+// minutes later. Admitting one node at a time out of a linked component makes
+// the peer wait unwinnable BY CONSTRUCTION -- every member burns its 180s CNI
+// budget, the sandbox fails, kubelet retries, and a new cilium /32 is spent on
+// each attempt (20 FailedCreatePodSandBox in 50 minutes on that run).
+//
+// Peers in the OTHER lane are ignored: the regular lane is created first and is
+// already alive, so a heavy node whose only peers are light pods is a group of
+// one and wires immediately.
+//
+// Deterministic: components are emitted in the order their first member appears
+// in the input, members in breadth-first interface-declaration order. Nothing is
+// dropped -- a malformed node becomes its own group rather than disappearing.
+func heavyAdmissionGroups(nodes []node.Node) [][]node.Node {
+	if len(nodes) == 0 {
+		return nil
+	}
+	index := make(map[string]node.Node, len(nodes))
+	order := make([]string, 0, len(nodes))
+	loose := make([]node.Node, 0)
+	for _, n := range nodes {
+		if n == nil || n.GetProto() == nil || n.GetProto().GetName() == "" {
+			loose = append(loose, n)
+			continue
+		}
+		name := n.GetProto().GetName()
+		if _, dup := index[name]; dup {
+			continue
+		}
+		index[name] = n
+		order = append(order, name)
+	}
+	adj := make(map[string][]string, len(index))
+	for _, name := range order {
+		for _, intf := range index[name].GetProto().GetInterfaces() {
+			peer := intf.GetPeerName()
+			if peer == "" || peer == name {
+				continue
+			}
+			if _, inLane := index[peer]; !inLane {
+				continue
+			}
+			adj[name] = append(adj[name], peer)
+			adj[peer] = append(adj[peer], name)
+		}
+	}
+	visited := make(map[string]bool, len(index))
+	groups := make([][]node.Node, 0, len(index))
+	for _, seed := range order {
+		if visited[seed] {
+			continue
+		}
+		queue := []string{seed}
+		visited[seed] = true
+		group := make([]node.Node, 0, 4)
+		for len(queue) > 0 {
+			cur := queue[0]
+			queue = queue[1:]
+			group = append(group, index[cur])
+			for _, peer := range adj[cur] {
+				if visited[peer] {
+					continue
+				}
+				visited[peer] = true
+				queue = append(queue, peer)
+			}
+		}
+		groups = append(groups, group)
+	}
+	for _, n := range loose {
+		groups = append(groups, []node.Node{n})
+	}
+	return groups
+}
+
+func nodeAdmissionModel(n node.Node) string {
+	if n == nil || n.GetProto() == nil {
+		return ""
+	}
+	return strings.ToLower(strings.TrimSpace(n.GetProto().GetModel()))
+}
+
+func groupNames(group []node.Node) string {
+	names := make([]string, 0, len(group))
+	for _, n := range group {
+		if n == nil || n.GetProto() == nil {
+			names = append(names, "<malformed>")
+			continue
+		}
+		names = append(names, n.GetProto().GetName())
+	}
+	return strings.Join(names, ",")
+}
+
+// admissionPacerPollInterval is a var ONLY so tests run in milliseconds.
+var admissionPacerPollInterval = 250 * time.Millisecond
+
+// heavyAdmissionPacer admits LINKED GROUPS under a lane width and a per-model
+// width, which is the pair of constraints the old single lane limit conflated.
+//
+//	lane width  -- how much boot IO the host should carry at once
+//	model width -- how many of ONE model may boot together (panos: 1)
+//
+// An OVERSIZED group -- one that on its own exceeds a width it needs -- is
+// admitted anyway, but only into a completely quiet lane, and it says so. The
+// alternative is a deadlock or the 10-minute-per-node chain this replaces; a
+// component cannot be split without recreating the peer-wait that broke.
+type heavyAdmissionPacer struct {
+	mu             sync.Mutex
+	laneWidth      int
+	laneInUse      int
+	modelWidth     map[string]int
+	modelInUse     map[string]int
+	exclusiveModel map[string]bool
+	exclusiveHeld  bool
+}
+
+func newHeavyAdmissionPacer(nodes []node.Node) *heavyAdmissionPacer {
+	p := &heavyAdmissionPacer{
+		laneWidth:      heavyLaneWidthForNodes(nodes),
+		modelWidth:     map[string]int{},
+		modelInUse:     map[string]int{},
+		exclusiveModel: map[string]bool{},
+	}
+	for _, n := range nodes {
+		policy := runtimeAdmissionPolicyForNode(n)
+		if policy.Lane != admissionLaneHeavy {
+			continue
+		}
+		model := nodeAdmissionModel(n)
+		width := policy.MaxParallelism
+		if width < 1 {
+			width = 1
+		}
+		if cur, ok := p.modelWidth[model]; !ok || width < cur {
+			p.modelWidth[model] = width
+		}
+		if policy.Exclusive {
+			p.exclusiveModel[model] = true
+		}
+	}
+	return p
+}
+
+func (p *heavyAdmissionPacer) widthFor(model string) int {
+	if w, ok := p.modelWidth[model]; ok && w > 0 {
+		return w
+	}
+	return p.laneWidth
+}
+
+// tryAdmit takes the whole group or nothing. The second return value is a
+// non-empty explanation when the group was admitted OVER a width.
+func (p *heavyAdmissionPacer) tryAdmit(group []node.Node) (bool, string) {
+	need := map[string]int{}
+	exclusive := false
+	for _, n := range group {
+		model := nodeAdmissionModel(n)
+		need[model]++
+		if p.exclusiveModel[model] {
+			exclusive = true
+		}
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.exclusiveHeld {
+		return false, ""
+	}
+	oversize := ""
+	if len(group) > p.laneWidth {
+		oversize = fmt.Sprintf("lane width %d", p.laneWidth)
+	}
+	for model, count := range need {
+		if w := p.widthFor(model); count > w {
+			oversize = fmt.Sprintf("%s width %d", model, w)
+		}
+	}
+	if oversize != "" || exclusive {
+		// An oversized or exclusive group needs the lane to itself.
+		if p.laneInUse > 0 {
+			return false, ""
+		}
+	} else {
+		if p.laneInUse+len(group) > p.laneWidth {
+			return false, ""
+		}
+		for model, count := range need {
+			if p.modelInUse[model]+count > p.widthFor(model) {
+				return false, ""
+			}
+		}
+	}
+	p.laneInUse += len(group)
+	for model, count := range need {
+		p.modelInUse[model] += count
+	}
+	if exclusive {
+		p.exclusiveHeld = true
+	}
+	return true, oversize
+}
+
+func (p *heavyAdmissionPacer) release(group []node.Node) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.laneInUse -= len(group)
+	if p.laneInUse < 0 {
+		p.laneInUse = 0
+	}
+	for _, n := range group {
+		model := nodeAdmissionModel(n)
+		if p.modelInUse[model] > 0 {
+			p.modelInUse[model]--
+		}
+		if p.exclusiveModel[model] {
+			p.exclusiveHeld = false
+		}
+	}
+}
+
+// describeModelWidths renders the per-model widths for the lane's log line, so
+// an operator reading it can see WHICH model narrows the lane instead of
+// inferring it from a single collapsed number -- the thing that hid the
+// min-over-lane defect for three weeks.
+func (p *heavyAdmissionPacer) describeModelWidths() string {
+	models := make([]string, 0, len(p.modelWidth))
+	for model := range p.modelWidth {
+		models = append(models, model)
+	}
+	sort.Strings(models)
+	parts := make([]string, 0, len(models))
+	for _, model := range models {
+		part := fmt.Sprintf("%s=%d", model, p.modelWidth[model])
+		if p.exclusiveModel[model] {
+			part += " (exclusive)"
+		}
+		parts = append(parts, part)
+	}
+	if len(parts) == 0 {
+		return "none"
+	}
+	return strings.Join(parts, " ")
+}
+
+func (p *heavyAdmissionPacer) admit(ctx context.Context, group []node.Node) error {
+	for {
+		ok, oversize := p.tryAdmit(group)
+		if ok {
+			if oversize != "" {
+				log.Warningf("Heavy group [%s] exceeds %s on its own; admitting it into an idle lane rather than splitting a linked component (splitting one is what makes meshnet's peer wait unwinnable)", groupNames(group), oversize)
+			}
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(admissionPacerPollInterval):
+		}
+	}
+}
+
+func hasHeavyAdmissionNodes(nodes []node.Node) bool {
+	for _, n := range nodes {
+		if runtimeAdmissionPolicyForNode(n).Lane == admissionLaneHeavy {
+			return true
+		}
+	}
+	return false
+}
+
+func isHeavyAdmissionModel(model string) bool {
+	return runtimeAdmissionPolicyForModel(model).Lane == admissionLaneHeavy
+}
+
+// orderNodesByAdjacency returns nodes reordered so that LINKED PEERS SIT NEXT
+// TO EACH OTHER, which is what lets a paced lane admit both ends of a link
+// close together in time.
+//
+// WHY THIS EXISTS. createNodeResources runs an errgroup with
+// SetLimit(parallelism) over this slice IN ORDER, so the slice order IS the
+// admission order. The heavy lane runs at parallelism 2. Fed an arbitrary
+// order, the two ends of a link can land many batches apart -- and meshnet's
+// KubeVirt path BLOCKS the peer's CNI add waiting for it.
+//
+// MEASURED 2026-09-10 on demo-lab (15 heavy VMs, parallelism 2):
+//
+//	cdg-acc-sw01 created 00:51:12
+//	cdg-dis-sw01 created 01:36:08   <- its PEER, 45 minutes later
+//
+// against a 180s peer-wait. Unwinnable by construction: the sandbox failed,
+// kubelet retried, and one bring-up logged 24 FailedCreatePodSandBox events.
+//
+// Breadth-first over the link graph puts each node next to its peers, so with
+// parallelism P a node and its peer are almost always inside the same or the
+// next window. This does NOT relax the pacing that exists to avoid a boot
+// storm -- the lane still admits P at a time. It only stops the ORDER from
+// being adversarial.
+//
+// Deterministic: peers are visited in the order the node declares its
+// interfaces, and disconnected components are picked up in input order, so the
+// same topology always admits in the same sequence. A node whose peers are in
+// the OTHER lane is unaffected -- this reorders within a lane, it does not move
+// nodes between lanes.
+func orderNodesByAdjacency(nodes []node.Node) []node.Node {
+	if len(nodes) < 3 {
+		return nodes
+	}
+	index := make(map[string]node.Node, len(nodes))
+	for _, n := range nodes {
+		if n == nil || n.GetProto() == nil {
+			continue
+		}
+		index[n.GetProto().GetName()] = n
+	}
+	visited := make(map[string]bool, len(nodes))
+	ordered := make([]node.Node, 0, len(nodes))
+
+	for _, seed := range nodes {
+		if seed == nil || seed.GetProto() == nil {
+			// keep anything malformed, in place, rather than dropping it
+			ordered = append(ordered, seed)
+			continue
+		}
+		name := seed.GetProto().GetName()
+		if visited[name] {
+			continue
+		}
+		queue := []string{name}
+		visited[name] = true
+		for len(queue) > 0 {
+			cur := queue[0]
+			queue = queue[1:]
+			n, ok := index[cur]
+			if !ok {
+				continue
+			}
+			ordered = append(ordered, n)
+			for _, intf := range n.GetProto().GetInterfaces() {
+				peer := intf.GetPeerName()
+				// only peers in THIS lane matter; the other lane is admitted
+				// separately and cannot be co-scheduled from here
+				if peer == "" || visited[peer] {
+					continue
+				}
+				if _, inLane := index[peer]; !inLane {
+					continue
+				}
+				visited[peer] = true
+				queue = append(queue, peer)
+			}
+		}
+	}
+	if len(ordered) != len(nodes) {
+		// never return a short list: fall back rather than drop a node
+		return nodes
+	}
+	return ordered
+}
+
+func splitNodesByAdmissionWeight(nodes []node.Node) ([]node.Node, []node.Node) {
+	heavy := make([]node.Node, 0, len(nodes))
+	regular := make([]node.Node, 0, len(nodes))
+	for _, n := range nodes {
+		if runtimeAdmissionPolicyForNode(n).Lane == admissionLaneHeavy {
+			heavy = append(heavy, n)
+			continue
+		}
+		regular = append(regular, n)
+	}
+	return heavy, regular
+}
+
+func runtimeAdmissionPolicyForNode(n node.Node) runtimeAdmissionPolicy {
+	if n == nil || n.GetProto() == nil {
+		return runtimeAdmissionPolicyForModel("")
+	}
+	return runtimeAdmissionPolicyForModel(n.GetProto().GetModel())
+}
+
+func runtimeAdmissionPolicyForModel(model string) runtimeAdmissionPolicy {
+	model = strings.ToLower(strings.TrimSpace(model))
+	// A BIG-IP node is a durable licensed slot. Runtime policy overrides must not
+	// turn on automatic VMI recovery or parallelize licensed carrier admission.
+	if model == "f5-bigip" {
+		return fallbackRuntimeAdmissionPolicyForModel(model)
+	}
+	if policy, ok := admissionPolicyByModel[model]; ok {
+		return policy
+	}
+	fallback := fallbackRuntimeAdmissionPolicyForModel(model)
+	if policy, ok := admissionPolicyByModel["default"]; ok && fallback.Lane == admissionLaneRegular {
+		return policy
+	}
+	return fallback
+}
+
+type runtimeAdmissionPolicyJSON struct {
+	ModelClass               string `json:"modelClass"`
+	Lane                     string `json:"lane"`
+	MaxParallelism           int    `json:"maxParallelism"`
+	AdmissionDeadlineSeconds int    `json:"admissionDeadlineSeconds"`
+	Exclusive                *bool  `json:"exclusive"`
+	RetryEligible            *bool  `json:"retryEligible"`
+}
+
+func loadRuntimeAdmissionPoliciesFromEnv() map[string]runtimeAdmissionPolicy {
+	raw := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_ADMISSION_POLICY_JSON"))
+	if raw == "" {
+		return nil
+	}
+	decoded := map[string]runtimeAdmissionPolicyJSON{}
+	if err := json.Unmarshal([]byte(raw), &decoded); err != nil {
+		log.Warningf("Ignoring invalid SKYFORGE_KNE_ADMISSION_POLICY_JSON: %v", err)
+		return nil
+	}
+	out := map[string]runtimeAdmissionPolicy{}
+	for model, item := range decoded {
+		model = strings.ToLower(strings.TrimSpace(model))
+		if model == "" {
+			continue
+		}
+		policy := runtimeAdmissionPolicy{
+			ModelClass:        strings.TrimSpace(item.ModelClass),
+			Lane:              normalizeAdmissionLane(item.Lane),
+			MaxParallelism:    item.MaxParallelism,
+			AdmissionDeadline: time.Duration(item.AdmissionDeadlineSeconds) * time.Second,
+			RetryEligible:     true,
+		}
+		if item.Exclusive != nil {
+			policy.Exclusive = *item.Exclusive
+		}
+		if item.RetryEligible != nil {
+			policy.RetryEligible = *item.RetryEligible
+		}
+		fallback := fallbackRuntimeAdmissionPolicyForModel(model)
+		if policy.ModelClass == "" {
+			policy.ModelClass = fallback.ModelClass
+		}
+		if policy.Lane == "" {
+			policy.Lane = fallback.Lane
+		}
+		if policy.MaxParallelism <= 0 {
+			policy.MaxParallelism = fallback.MaxParallelism
+		}
+		if policy.AdmissionDeadline <= 0 {
+			policy.AdmissionDeadline = fallback.AdmissionDeadline
+		}
+		out[model] = policy
+	}
+	return out
+}
+
+func normalizeAdmissionLane(raw string) admissionLane {
+	switch strings.ToLower(strings.TrimSpace(raw)) {
+	case string(admissionLaneHeavy):
+		return admissionLaneHeavy
+	case string(admissionLaneRegular):
+		return admissionLaneRegular
+	default:
+		return ""
+	}
+}
+
+func fallbackRuntimeAdmissionPolicyForModel(model string) runtimeAdmissionPolicy {
+	model = strings.ToLower(strings.TrimSpace(model))
+	if model == "default" {
+		model = ""
+	}
+	switch model {
+	case "f5-bigip":
+		return runtimeAdmissionPolicy{
+			ModelClass:        "licensed-slot-heavy-vm",
+			Lane:              admissionLaneHeavy,
+			MaxParallelism:    1,
+			AdmissionDeadline: f5AdmissionTimeout,
+			RetryEligible:     false,
+		}
+	case "panos":
+		return runtimeAdmissionPolicy{
+			ModelClass:        "heavy-vm",
+			Lane:              admissionLaneHeavy,
+			MaxParallelism:    1,
+			AdmissionDeadline: panosAdmissionTimeout,
+			RetryEligible:     true,
+		}
+	case "a10", "asav", "cat8000v", "dellos10", "fortios", "nxos", "sros", "vbond", "vedge", "vmanage", "vsmart", "vjunos-switch", "vmx":
+		return runtimeAdmissionPolicy{
+			ModelClass:        "heavy-vm",
+			Lane:              admissionLaneHeavy,
+			MaxParallelism:    heavyPhaseParallelism,
+			AdmissionDeadline: heavyNodeAdmissionTimeout,
+			RetryEligible:     true,
+		}
+	default:
+		return runtimeAdmissionPolicy{
+			ModelClass:        "light",
+			Lane:              admissionLaneRegular,
+			MaxParallelism:    maxNodeCreateParallelism,
+			AdmissionDeadline: nodeAdmissionTimeout,
+			RetryEligible:     true,
+		}
+	}
+}
+
+// deleteMeshnetTopologies deletes meshnet resources for all available nodes.
+func (m *Manager) deleteMeshnetTopologies(ctx context.Context) error {
+	nodes, err := m.topologyResources(ctx)
+	if err != nil {
+		return fmt.Errorf("failed to get meshnet nodes: %w", err)
+	}
+	var errs errlist.List
+	for _, n := range nodes {
+		if err := m.dClient.Resource(meshnetGVR).Namespace(m.topo.Name).Delete(ctx, n.Name, metav1.DeleteOptions{}); err != nil {
+			errs.Add(fmt.Errorf("failed to delete meshnet node %q: %w", n.Name, err))
+		}
+	}
+	return errs.Err()
+}
+
+// checkNodeStatus reports node status, ignores for unimplemented nodes.
+func (m *Manager) checkNodeStatus(ctx context.Context, timeout time.Duration) error {
+	foundAll := false
+	processed := make(map[string]bool)
+
+	// Check until end state or timeout sec expired
+	start := time.Now()
+	for (timeout == 0 || time.Since(start) < timeout) && !foundAll {
+		foundAll = true
+		for name, n := range m.nodes {
+			if _, ok := processed[name]; ok {
+				continue
+			}
+
+			phase, err := n.Status(ctx)
+			if err != nil {
+				if isRetryableKubeTransportError(err) {
+					log.Warningf("Transient node status error for %s: %v", n, err)
+					foundAll = false
+					continue
+				}
+				return fmt.Errorf("Node %s: Status %s Reason %v", n, phase, err)
+			}
+			if phase == node.StatusFailed {
+				return fmt.Errorf("Node %s: Status %s Reason %v", n, phase, err)
+			}
+			if phase == node.StatusRunning {
+				log.Infof("Node %s: Status %s", n, phase)
+				processed[name] = true
+			} else {
+				foundAll = false
+			}
+		}
+		time.Sleep(100 * time.Millisecond)
+	}
+	if !foundAll {
+		log.Warningf("Failed to determine status of some node resources in %d sec", timeout)
+	}
+	return nil
+}
+
+func isRetryableKubeTransportError(err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return true
+	}
+	msg := strings.ToLower(strings.TrimSpace(err.Error()))
+	return strings.Contains(msg, "timeout") ||
+		strings.Contains(msg, "deadline exceeded") ||
+		strings.Contains(msg, "temporarily unavailable") ||
+		strings.Contains(msg, "connection refused") ||
+		strings.Contains(msg, "connection reset") ||
+		strings.Contains(msg, "unexpected eof") ||
+		msg == "eof" ||
+		strings.Contains(msg, "no route to host") ||
+		strings.Contains(msg, "client connection lost") ||
+		strings.Contains(msg, "transport is closing")
+}
+
+type Resources struct {
+	Services   map[string][]*corev1.Service
+	Pods       map[string][]*corev1.Pod
+	ConfigMaps map[string]*corev1.ConfigMap
