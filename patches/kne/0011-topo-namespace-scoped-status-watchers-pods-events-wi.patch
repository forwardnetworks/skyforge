+func TestPushAdmitsRegularNodesWhileHeavyAdmissionIsBlocked(t *testing.T) {
+	var mu sync.Mutex
+	events := []string{}
+	record := func(event string) {
+		mu.Lock()
+		defer mu.Unlock()
+		events = append(events, event)
+	}
+	countEvent := func(want string) int {
+		mu.Lock()
+		defer mu.Unlock()
+		count := 0
+		for _, event := range events {
+			if event == want {
+				count++
+			}
+		}
+		return count
+	}
+	eventSnapshot := func() []string {
+		mu.Lock()
+		defer mu.Unlock()
+		return append([]string(nil), events...)
+	}
+	heavyPodsStarted := make(chan struct{})
+	releaseHeavyPods := make(chan struct{})
+	regular := &admissionOrderNode{
+		name:   "regular1",
+		proto:  &tpb.Node{Name: "regular1", Model: "ceos"},
+		record: record,
+	}
+	heavy := &admissionOrderNode{
+		name: "heavy1",
+		proto: &tpb.Node{
+			Name:   "heavy1",
+			Vendor: tpb.Vendor_A10,
+			Model:  "a10",
+		},
+		record:      record,
+		podsStarted: heavyPodsStarted,
+		podsBlock:   releaseHeavyPods,
+	}
+	m := &Manager{
+		topo:    &tpb.Topology{Name: "test"},
+		kClient: kfake.NewSimpleClientset(),
+		nodes: map[string]node.Node{
+			regular.Name(): regular,
+			heavy.Name():   heavy,
+		},
+	}
+	errCh := make(chan error, 1)
+	go func() {
+		errCh <- m.push(context.Background())
+	}()
+
+	select {
+	case <-heavyPodsStarted:
+	case err := <-errCh:
+		t.Fatalf("push returned before heavy admission blocked: %v events=%v", err, eventSnapshot())
+	case <-time.After(time.Second):
+		t.Fatalf("heavy admission did not start; events=%v", eventSnapshot())
+	}
+
+	deadline := time.After(time.Second)
+	for countEvent("regular1:pods") < 2 {
+		select {
+		case err := <-errCh:
+			t.Fatalf("push returned before regular admission ran: %v events=%v", err, eventSnapshot())
+		case <-deadline:
+			t.Fatalf("regular admission did not run while heavy admission was blocked; events=%v", eventSnapshot())
+		case <-time.After(10 * time.Millisecond):
+		}
+	}
+
+	close(releaseHeavyPods)
+	select {
+	case err := <-errCh:
+		if err != nil {
+			t.Fatalf("push() failed: %v events=%v", err, eventSnapshot())
+		}
+	case <-time.After(time.Second):
+		t.Fatalf("push did not finish after heavy admission was released; events=%v", eventSnapshot())
+	}
+}
+
+func indexOfEvent(events []string, want string) int {
+	for i, event := range events {
+		if event == want {
+			return i
+		}
+	}
+	return -1
+}
