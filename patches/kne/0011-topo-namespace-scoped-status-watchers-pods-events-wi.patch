@@ -184,6 +184,10 @@ func (w *Watcher) updatePod(s *PodStatus) bool {
 	}
 	switch newState {
 	case "failed":
+		if isKubeVirtLauncherPod(s) {
+			w.warningf("Ignoring failed KubeVirt launcher pod %s; VM controller retry and node status remain authoritative", s.Name)
+			return true
+		}
 		w.errCh <- fmt.Errorf("Pod %s failed to deploy", s.Name)
