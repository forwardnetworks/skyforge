+func TestLifecycleProbeExecutionUsesAdapterAndFailsClosedByDefault(t *testing.T) {
+	probe := &tpb.ReadinessProbe{
+		Name: "controllers-trusted", Node: "controller", Kind: "vendor",
+		Vendor: "catalyst", Check: "vsmart-control-connections",
+		Success: "certificate-valid && vbond-connected", Timeout: "1s",
+	}
+	phase := &tpb.LifecyclePhase{Name: "controllers-trusted", Probes: []*tpb.ReadinessProbe{probe}}
+	runner := &recordingLifecycleProbeRunner{}
+	m := &Manager{
+		nodes:                map[string]node.Node{"controller": nil},
+		lifecycleProbeRunner: runner,
+	}
+	if err := m.runLifecyclePhaseProbes(context.Background(), phase); err != nil {
+		t.Fatalf("runLifecyclePhaseProbes() failed: %v", err)
+	}
+	if diff := cmp.Diff([]string{"controllers-trusted"}, runner.calls); diff != "" {
+		t.Fatalf("probe calls mismatch (-want +got):\n%s", diff)
+	}
+
+	m.lifecycleProbeRunner = failClosedLifecycleProbeRunner{}
+	err := m.runLifecyclePhaseProbes(context.Background(), phase)
+	if err == nil || !strings.Contains(err.Error(), "refusing to advance lifecycle") {
+		t.Fatalf("default readiness adapter did not fail closed: %v", err)
+	}
+}
