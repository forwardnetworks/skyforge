+// RecreateNode deletes ONE regular (container) node's pod, service and boot
+// ConfigMap and creates them again from this topology -- the same per-node
+// delete -> cleanup wait -> Create that the admission engine already uses to
+// recover a node that never admitted (recreateRegularNode), exposed so a
+// caller can ask for it on a node that admitted long ago and later stopped
+// coming back.
+//
+// It is a REBUILD of one node, never a topology delete: the namespace, the
+// meshnet Topology CRs and every other node are untouched, and meshnet rewires
+// the new pod (and its peers' veth ends) on CNI ADD from the Topology CR that
+// survives. The pod spec is the node's own Create; the boot ConfigMap is
+// rebuilt from the config file the topology names, so what the node boots is
+// whatever the caller's working tree renders -- nothing here writes config.
+//
+// KubeVirt-backed nodes are refused: a VM's day-0 is delivered per image
+// (serial injectors, cloud-init) and "delete the launcher pod" is not a
+// rebuild of the device. Unknown nodes are refused by name.
+func (m *Manager) RecreateNode(ctx context.Context, nodeName string) error {
+	n, ok := m.nodes[nodeName]
+	if !ok {
+		return fmt.Errorf("node %q not found", nodeName)
+	}
+	if nodeUsesKubeVirtVM(n) {
+		return status.Errorf(codes.Unimplemented, "node %q is KubeVirt-backed; recreate only rebuilds container nodes", nodeName)
+	}
+	log.Infof("Recreating node %s (delete pod/service/config, wait for cleanup, create)", nodeName)
+	if err := m.recreateRegularNode(ctx, n); err != nil {
+		return err
+	}
+	return nil
+}
+
+// WaitNodeAdmission waits, bounded by timeout, for ONE node's pod(s) to admit
+// through the same admission engine `create` uses -- including its bounded
+// per-node recovery. It is the wait half of RecreateNode, kept separate so a
+// caller that runs its own readiness contract can skip it.
+func (m *Manager) WaitNodeAdmission(ctx context.Context, nodeName string, timeout time.Duration) error {
+	n, ok := m.nodes[nodeName]
+	if !ok {
+		return fmt.Errorf("node %q not found", nodeName)
+	}
+	return m.waitForNodeAdmission(ctx, n, timeout)
+}
