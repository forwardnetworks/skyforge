@@ -0,0 +1,34 @@
+package topo
+
+import "testing"
+
+func TestF5AdmissionPolicyIsSerializedAndNonDestructive(t *testing.T) {
+	got := runtimeAdmissionPolicyForModel("f5-bigip")
+	if got.ModelClass != "licensed-slot-heavy-vm" || got.Lane != admissionLaneHeavy {
+		t.Fatalf("F5 admission class/lane = %q/%q", got.ModelClass, got.Lane)
+	}
+	if got.MaxParallelism != 1 || got.AdmissionDeadline != f5AdmissionTimeout {
+		t.Fatalf("F5 admission sizing = %#v", got)
+	}
+	if got.RetryEligible {
+		t.Fatalf("F5 automatic destructive admission recovery must remain disabled: %#v", got)
+	}
+}
+
+func TestF5AdmissionPolicyCannotBeRelaxedByRuntimeOverride(t *testing.T) {
+	previous := admissionPolicyByModel
+	t.Cleanup(func() { admissionPolicyByModel = previous })
+	admissionPolicyByModel = map[string]runtimeAdmissionPolicy{
+		"f5-bigip": {
+			ModelClass:        "light",
+			Lane:              admissionLaneRegular,
+			MaxParallelism:    8,
+			AdmissionDeadline: nodeAdmissionTimeout,
+			RetryEligible:     true,
+		},
+	}
+	got := runtimeAdmissionPolicyForModel("f5-bigip")
+	if got.Lane != admissionLaneHeavy || got.MaxParallelism != 1 || got.RetryEligible {
+		t.Fatalf("unsafe F5 runtime override was accepted: %#v", got)
+	}
+}
