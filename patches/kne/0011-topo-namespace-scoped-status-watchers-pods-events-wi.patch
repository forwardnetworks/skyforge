+	regularCreate := indexOfEvent(events, "regular1:create")
+	regularSandbox := indexOfEvent(events, "regular1:pods")
+	heavyCreate := indexOfEvent(events, "heavy1:create")
+	if regularCreate == -1 || regularSandbox == -1 || heavyCreate == -1 {
+		t.Fatalf("missing expected events: %v", events)
+	}
+	if !(regularCreate < regularSandbox && regularSandbox < heavyCreate) {
+		t.Fatalf("heavy create must wait for regular sandbox stability, got events: %v", events)
