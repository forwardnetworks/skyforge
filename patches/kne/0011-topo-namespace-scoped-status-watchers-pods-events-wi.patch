 }
+
+func isKubeVirtLauncherPod(s *PodStatus) bool {
+	if s == nil {
+		return false
+	}
+	if s.Pod.Labels["kubevirt.io"] == "virt-launcher" || s.Pod.Labels["vm.kubevirt.io/name"] != "" {
+		return true
+	}
+	for _, owner := range s.Pod.OwnerReferences {
+		if owner.Kind == "VirtualMachineInstance" && strings.HasPrefix(owner.APIVersion, "kubevirt.io/") {
+			return true
+		}
+	}
+	return false
+}
