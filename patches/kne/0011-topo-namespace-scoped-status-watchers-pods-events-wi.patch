new file mode 100644
index 0000000..3d139b7
--- /dev/null
+++ b/topo/heavy_lane_pacing_test.go
@@ -0,0 +1,133 @@
+package topo
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+)
+
+// pacedTracker records how many nodes are simultaneously PAST Create() and not
+// yet Ready -- which is the population that actually contends for host IO.
+type pacedTracker struct {
+	mu       sync.Mutex
+	inFlight int
+	maxSeen  int
+}
+
+func (p *pacedTracker) enter() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.inFlight++
+	if p.inFlight > p.maxSeen {
+		p.maxSeen = p.inFlight
+	}
+}
+
+func (p *pacedTracker) leave() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.inFlight--
+}
+
+func (p *pacedTracker) peak() int {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.maxSeen
+}
+
+// pacedTestNode boots "slowly": Create returns at once (as a KubeVirt VM object
+// POST does) and Status stays PENDING for a few polls before reporting RUNNING.
+type pacedTestNode struct {
+	*node.Impl
+	tracker *pacedTracker
+
+	mu     sync.Mutex
+	polls  int
+	booted bool
+}
+
+func (n *pacedTestNode) Create(_ context.Context) error {
+	n.tracker.enter()
+	return nil
+}
+
+func (n *pacedTestNode) Status(_ context.Context) (node.Status, error) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	if n.booted {
+		return node.StatusRunning, nil
+	}
+	n.polls++
+	if n.polls < 3 {
+		return node.StatusPending, nil
+	}
+	n.booted = true
+	n.tracker.leave()
+	return node.StatusRunning, nil
+}
+
+// A SEMAPHORE ONLY PACES WHAT IS INSIDE IT.
+//
+// The heavy lane's limit used to wrap n.Create() alone, which for a KubeVirt
+// node is a VirtualMachine POST that returns in microseconds -- so the limit
+// paced API calls and paced nothing about the qcow2 extraction and guest boot it
+// exists to protect.
+//
+// MEASURED on demo-lab (deployment c83e1600) 2026-09-08, KNE's own log line:
+//
+//	16:04:52.631980 topo.go:740 Creating 15 heavy node resource(s) after regular
+//	                            sandbox stability, parallelism=1
+//
+// and all fifteen VirtualMachine objects existed by 16:04:54. Fifteen heavy VMs
+// booting at once under a limit of one.
+//
+// The two halves of this test are each other's control: settle=nil reproduces
+// the old behaviour and MUST show every node in flight at once; the real settle
+// MUST hold the line at the declared limit.
+func TestHeavyCreateSlotIsHeldUntilTheNodeIsReady(t *testing.T) {
+	prev := heavyCreateSettlePollInterval
+	heavyCreateSettlePollInterval = 2 * time.Millisecond
+	defer func() { heavyCreateSettlePollInterval = prev }()
+
+	const total, limit = 6, 2
+
+	newNodes := func(tr *pacedTracker) []node.Node {
+		out := make([]node.Node, 0, total)
+		for i := 0; i < total; i++ {
+			out = append(out, &pacedTestNode{
+				Impl:    &node.Impl{Proto: &tpb.Node{Name: "h", Model: "panos"}},
+				tracker: tr,
+			})
+		}
+		return out
+	}
+
+	m := &Manager{}
+
+	// CONTROL: the behaviour before this fix. Pacing only the create call lets
+	// every node boot at once, whatever the limit says.
+	unpaced := &pacedTracker{}
+	if err := m.createNodeResourcesPaced(context.Background(), newNodes(unpaced), limit, nil); err != nil {
+		t.Fatalf("unpaced create: %v", err)
+	}
+	if got := unpaced.peak(); got != total {
+		t.Fatalf("control did not reproduce the defect: peak in-flight = %d, want %d "+
+			"(if this is no longer %d, the control has stopped controlling anything)", got, total, total)
+	}
+
+	// THE FIX: the slot is held until the node it started is Ready.
+	paced := &pacedTracker{}
+	if err := m.createNodeResourcesPaced(context.Background(), newNodes(paced), limit, m.waitForHeavyNodeLaunch); err != nil {
+		t.Fatalf("paced create: %v", err)
+	}
+	if got := paced.peak(); got > limit {
+		t.Errorf("heavy lane started %d node(s) at once under a limit of %d: the semaphore is still wrapping the create call rather than the boot", got, limit)
+	}
+	if got := paced.peak(); got == 0 {
+		t.Error("nothing was ever in flight; the test asserted nothing")
+	}
+}
