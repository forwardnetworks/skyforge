+// A native sidecar (init container with restartPolicy: Always) never terminates.
+// KubeVirt v1.9.0 injects one -- guest-console-log -- into every virt-launcher
+// pod, so treating "not terminated" as "not admitted" made EVERY KubeVirt VM
+// node unadmittable while the VM was perfectly healthy. The failure surfaced as
+// an admission deadline, never naming the sidecar, which is why it reads as a
+// slow NOS rather than a broken predicate.
+func TestPodInitContainersSucceededIgnoresNativeSidecars(t *testing.T) {
+	always := corev1.ContainerRestartPolicyAlways
+	pod := &corev1.Pod{
+		Spec: corev1.PodSpec{InitContainers: []corev1.Container{
+			{Name: "guest-console-log", RestartPolicy: &always},
+			{Name: "volumecontainerdisk"},
+		}},
+		Status: corev1.PodStatus{InitContainerStatuses: []corev1.ContainerStatus{
+			// The sidecar is RUNNING, exactly as KubeVirt leaves it.
+			{Name: "guest-console-log", State: corev1.ContainerState{Running: &corev1.ContainerStateRunning{}}},
+			{Name: "volumecontainerdisk", State: corev1.ContainerState{Terminated: &corev1.ContainerStateTerminated{ExitCode: 0}}},
+		}},
+	}
+	if !podInitContainersSucceeded(pod) {
+		t.Fatal("a running native sidecar must not block admission")
+	}
+
+	// A REAL init container that has not finished must still block: the fix
+	// must not turn the check into a no-op.
+	pod.Status.InitContainerStatuses[1].State = corev1.ContainerState{Running: &corev1.ContainerStateRunning{}}
+	if podInitContainersSucceeded(pod) {
+		t.Fatal("an unfinished ordinary init container must still block admission")
+	}
+
+	// And a real init container that failed must block.
+	pod.Status.InitContainerStatuses[1].State = corev1.ContainerState{Terminated: &corev1.ContainerStateTerminated{ExitCode: 1}}
+	if podInitContainersSucceeded(pod) {
+		t.Fatal("a failed ordinary init container must still block admission")
+	}
+}
