Subject: [PATCH 19/35] meshnet: find a VM's wire behind KubeVirt's rename, do
 not rebuild it (M0013, M0020, M0021, A0009)

---
diff --git a/third_party/meshnet/daemon/vxlan/kubevirt_slot.go b/third_party/meshnet/daemon/vxlan/kubevirt_slot.go
new file mode 100644
index 0000000..4790e0a
--- /dev/null
+++ b/third_party/meshnet/daemon/vxlan/kubevirt_slot.go
@@ -0,0 +1,119 @@
+package vxlan
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+)
+
+// KubeVirt slot resolution for cross-node VXLAN wires.
+//
+// A VM pod's wire is created under the name the CNI gives it, "pod<id>". When
+// KubeVirt binds the VM's secondary interface, virt-launcher renames that link
+// to "<id>-nic", enslaves it to a bridge "k6t-<id>", and leaves a DOWN, NOARP
+// dummy under the original name. A reconciler that looks only at "pod<id>"
+// then sees a dummy, not a VXLAN. It removes the dummy and builds a second
+// VXLAN with the same VNI, every pass (measured 2026-10-20: a stop and start
+// of the VM left the real wire under "980816f36b7-nic" and the daemon
+// recreated "pod980816f36b7" every 30 to 60 seconds).
+//
+// This is the cross-node half of patches/meshnet-cni 0020 and 0021. The
+// same-node half is koko-side and is not in this tree.
+
+// wireSlot is where a wire actually lives inside a pod netns.
+type wireSlot struct {
+	found       netlink.Link // the link that carries the wire, or nil
+	name        string       // the name found lives under
+	bridge      string       // "k6t-<id>" when the KubeVirt bridge exists, else ""
+	bridgeIndex int
+	dummy       netlink.Link // virt-launcher's placeholder under the original name
+	strays      []netlink.Link
+}
+
+// kubevirtNames returns the renamed NIC and the bridge KubeVirt uses for a
+// "pod<id>" link. It returns "" for any other name (a plain container).
+func kubevirtNames(linkName string) (nic, bridge string) {
+	if !strings.HasPrefix(linkName, "pod") {
+		return "", ""
+	}
+	id := strings.TrimPrefix(linkName, "pod")
+	return id + "-nic", "k6t-" + id
+}
+
+// resolveSlot finds the wire for linkName. lookup returns the link with that
+// name in the pod netns, or nil. For a non-KubeVirt name, or when neither the
+// renamed NIC nor the bridge exists, the result is the original name, which is
+// the pre-KubeVirt behaviour.
+func resolveSlot(lookup func(string) netlink.Link, linkName string) wireSlot {
+	slot := wireSlot{name: linkName}
+	original := lookup(linkName)
+	nicName, bridgeName := kubevirtNames(linkName)
+	if nicName == "" {
+		slot.found = original
+		return slot
+	}
+	if br, ok := lookup(bridgeName).(*netlink.Bridge); ok {
+		slot.bridge = bridgeName
+		slot.bridgeIndex = br.Attrs().Index
+	}
+	nic := lookup(nicName)
+	if nic == nil && slot.bridge == "" {
+		slot.found = original
+		return slot
+	}
+	if d, ok := original.(*netlink.Dummy); ok {
+		slot.dummy = d
+		original = nil
+	}
+	if nic != nil {
+		slot.found = nic
+		slot.name = nicName
+		if _, isVxlan := original.(*netlink.Vxlan); isVxlan {
+			slot.strays = append(slot.strays, original)
+		}
+		return slot
+	}
+	slot.found = original
+	return slot
+}
+
+// bridgeOK reports whether a found wire is enslaved to the KubeVirt bridge the
+// slot expects. With no bridge there is nothing to enslave to, so it is true.
+func (s wireSlot) bridgeOK() bool {
+	if s.bridge == "" || s.found == nil {
+		return true
+	}
+	return s.found.Attrs().MasterIndex == s.bridgeIndex
+}
+
+// enslaveToBridge sets the link's master to bridgeName and brings it up, inside
+// the pod netns.
+func enslaveToBridge(nsName, linkName, bridgeName string) error {
+	netNS, err := ns.GetNS(nsName)
+	if err != nil {
+		return fmt.Errorf("enter %s: %w", nsName, err)
+	}
+	defer netNS.Close()
+	return netNS.Do(func(_ ns.NetNS) error {
+		link, err := netlink.LinkByName(linkName)
+		if err != nil {
+			return fmt.Errorf("lookup %s: %w", linkName, err)
+		}
+		br, err := netlink.LinkByName(bridgeName)
+		if err != nil {
+			return fmt.Errorf("lookup bridge %s: %w", bridgeName, err)
+		}
+		if _, ok := br.(*netlink.Bridge); !ok {
+			return fmt.Errorf("%s is a %T, not a bridge", bridgeName, br)
+		}
+		if err := netlink.LinkSetMaster(link, br); err != nil {
+			return fmt.Errorf("enslave %s to %s: %w", linkName, bridgeName, err)
+		}
+		if err := netlink.LinkSetUp(link); err != nil {
+			return fmt.Errorf("set %s up: %w", linkName, err)
+		}
+		return nil
+	})
+}
diff --git a/third_party/meshnet/daemon/vxlan/kubevirt_slot_test.go b/third_party/meshnet/daemon/vxlan/kubevirt_slot_test.go
new file mode 100644
index 0000000..18b531d
--- /dev/null
+++ b/third_party/meshnet/daemon/vxlan/kubevirt_slot_test.go
@@ -0,0 +1,102 @@
+package vxlan
+
+import (
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+// fakeNS is a pod netns: name -> link. A missing name returns a nil interface,
+// the same as getLinkFromNS does.
+type fakeNS map[string]netlink.Link
+
+func (f fakeNS) lookup(name string) netlink.Link {
+	if l, ok := f[name]; ok {
+		return l
+	}
+	return nil
+}
+
+func vxlanNamed(name string, index, master int) *netlink.Vxlan {
+	return &netlink.Vxlan{LinkAttrs: netlink.LinkAttrs{Name: name, Index: index, MasterIndex: master}, VxlanId: 9820001}
+}
+
+// The state KubeVirt leaves after a VM stop and start (observed on the kind
+// cluster 2026-10-20): the wire is "<id>-nic", enslaved to "k6t-<id>", and a
+// DOWN dummy sits under "pod<id>".
+func TestResolveSlotFindsRenamedWireBehindPlaceholder(t *testing.T) {
+	bridge := &netlink.Bridge{LinkAttrs: netlink.LinkAttrs{Name: "k6t-abc", Index: 7}}
+	ns := fakeNS{
+		"podabc":  &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "podabc", Index: 8}},
+		"abc-nic": vxlanNamed("abc-nic", 9, 7),
+		"k6t-abc": bridge,
+	}
+	slot := resolveSlot(ns.lookup, "podabc")
+	if slot.found == nil || slot.found.Attrs().Name != "abc-nic" {
+		t.Fatalf("found = %v, want abc-nic", slot.found)
+	}
+	if slot.dummy == nil {
+		t.Fatal("placeholder dummy not recorded")
+	}
+	if slot.bridge != "k6t-abc" || !slot.bridgeOK() {
+		t.Fatalf("bridge=%q bridgeOK=%v, want k6t-abc enslaved", slot.bridge, slot.bridgeOK())
+	}
+	if len(slot.strays) != 0 {
+		t.Fatalf("strays = %d, want 0", len(slot.strays))
+	}
+}
+
+// The renamed wire exists but is not enslaved yet: the caller must enslave it,
+// not rebuild it.
+func TestResolveSlotReportsUnenslavedRenamedWire(t *testing.T) {
+	ns := fakeNS{
+		"podabc":  &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "podabc", Index: 8}},
+		"abc-nic": vxlanNamed("abc-nic", 9, 0),
+		"k6t-abc": &netlink.Bridge{LinkAttrs: netlink.LinkAttrs{Name: "k6t-abc", Index: 7}},
+	}
+	slot := resolveSlot(ns.lookup, "podabc")
+	if slot.bridgeOK() {
+		t.Fatal("bridgeOK = true for a wire with master 0; want false")
+	}
+}
+
+// A VXLAN still under the original name beside the renamed one is stray.
+func TestResolveSlotMarksStrayVxlanUnderOriginalName(t *testing.T) {
+	ns := fakeNS{
+		"podabc":  vxlanNamed("podabc", 5, 0),
+		"abc-nic": vxlanNamed("abc-nic", 9, 7),
+		"k6t-abc": &netlink.Bridge{LinkAttrs: netlink.LinkAttrs{Name: "k6t-abc", Index: 7}},
+	}
+	slot := resolveSlot(ns.lookup, "podabc")
+	if len(slot.strays) != 1 || slot.strays[0].Attrs().Name != "podabc" {
+		t.Fatalf("strays = %v, want the vxlan under podabc", slot.strays)
+	}
+}
+
+// Before KubeVirt binds anything, the wire is the vxlan under the original name.
+func TestResolveSlotBeforeBindingKeepsOriginalName(t *testing.T) {
+	ns := fakeNS{"podabc": vxlanNamed("podabc", 5, 0)}
+	slot := resolveSlot(ns.lookup, "podabc")
+	if slot.found == nil || slot.found.Attrs().Name != "podabc" || slot.bridge != "" {
+		t.Fatalf("found=%v bridge=%q, want podabc with no bridge", slot.found, slot.bridge)
+	}
+}
+
+// A plain container link (not pod-shaped) is never resolved to a renamed name.
+func TestResolveSlotPlainContainerUnchanged(t *testing.T) {
+	ns := fakeNS{"eth1": vxlanNamed("eth1", 5, 0), "eth1-nic": vxlanNamed("eth1-nic", 6, 0)}
+	slot := resolveSlot(ns.lookup, "eth1")
+	if slot.found.Attrs().Name != "eth1" || slot.bridge != "" || len(slot.strays) != 0 {
+		t.Fatalf("plain container resolved to %s bridge=%q", slot.found.Attrs().Name, slot.bridge)
+	}
+}
+
+// A dummy with no renamed wire and no bridge is absent for this purpose: the
+// caller removes it and builds.
+func TestResolveSlotDummyOnlyIsNotAWire(t *testing.T) {
+	ns := fakeNS{"podabc": &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "podabc", Index: 8}}}
+	slot := resolveSlot(ns.lookup, "podabc")
+	if _, isVxlan := slot.found.(*netlink.Vxlan); isVxlan {
+		t.Fatal("dummy-only slot reported as a vxlan")
+	}
+}
