+	}
 
-			// We remove the existing link and add a new one
-			vxLanOvrlyLogger.Infof("Vxlan attrs are different: %d!=%d or %v!=%v or mtu %d!=%d", vxlanLink.VxlanId, vxlan.ID, vxlanLink.Group, vxlan.IPAddr, vxlanLink.Attrs().MTU, vxlan.MTU)
-			if err = removeLink(v.NetNs, v.IntfName); err != nil {
-				return fmt.Errorf(" MESHNETD: Error when removing an old Vxlan interface: %s", err)
+	// MTU is an attribute: a wire is kept only when VNI, VTEP and MTU match.
+	vxlanLink, isVxlan := slot.found.(*netlink.Vxlan)
+	if isVxlan && vxlanAttrsMatch(vxlanLink, vxlan) {
+		// Already the wire we want. Keep it under its current name, and only
+		// fix its bridge membership when KubeVirt has not enslaved it yet.
+		if !slot.bridgeOK() {
+			vxLanOvrlyLogger.Infof("Enslaving %s to KubeVirt bridge %s", vxlanLink.Attrs().Name, slot.bridge)
+			if err = enslaveToBridge(v.NetNs, vxlanLink.Attrs().Name, slot.bridge); err != nil {
