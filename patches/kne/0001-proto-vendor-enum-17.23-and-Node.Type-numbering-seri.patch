From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Tue, 20 Oct 2026 13:45:28 -0500
Subject: [PATCH 01/35] proto: vendor enum 17..23 and Node.Type numbering
 (series 0002, 0081)

---
diff --git a/proto/topo.proto b/proto/topo.proto
index 4ff6115..352272c 100644
--- a/proto/topo.proto
+++ b/proto/topo.proto
@@ -25,6 +25,30 @@ message Topology {
   string name = 1;  // Name of the topology - will be linked to the cluster name
   repeated Node nodes = 2;  // List of nodes in the topology
   repeated Link links = 3;  // connections between Nodes.
+  // Declarative admission/readiness barriers authored by the topology compiler.
+  repeated LifecyclePhase lifecycle_phases = 4;
+}
+
+// LifecyclePhase is an ordered, dependency-checked admission unit. Nodes in a
+// phase are not created until every required phase and probe has succeeded.
+message LifecyclePhase {
+  string name = 1;
+  repeated string requires = 2;
+  repeated string nodes = 3;
+  repeated ReadinessProbe probes = 4;
+}
+
+// ReadinessProbe is an application readiness assertion. KNE must fail closed
+// when a probe kind or vendor check is unsupported; pod/VM Running is never a
+// substitute for this contract.
+message ReadinessProbe {
+  string name = 1;
+  string node = 2;
+  string kind = 3;
+  string vendor = 4;
+  string check = 5;
+  string success = 6;
+  string timeout = 7;
 }
 
 // Vendor of the node. Topology manager uses this enum to dispatch the node to
@@ -47,6 +71,15 @@ enum Vendor {
   IN_CLUSTER_PROXY = 14;
   SONIC = 15;
   CIENA = 16;
+  // Skyforge vendor surface (0002), renumbered: 15 and 16 are taken upstream by SONIC and CIENA.
+  A10 = 17;
+  ARUBA = 18;
+  DELL = 19;
+  FORTINET = 20;
+  PALOALTO = 21;
+  VERSA = 22;
+  // F5 is 21 in patch 0022 on the old base. Renumbered to 23 after PALOALTO took 21.
+  F5 = 23;
 }
 
 // Node is a single container inside the topology
@@ -188,6 +221,15 @@ message Config {
   string init_image = 10;
   // Vendor-specific data
   google.protobuf.Any vendor_data = 11;
+  // Secret-backed, multi-file day-0 material. Values are copied by KNE from a
+  // SOPS-materialized source Secret and are never embedded in the topology.
+  repeated BootstrapBundle bootstrap_bundles = 12;
+}
+
+message BootstrapBundle {
+  string name = 1;
+  string secret_name = 2;
+  repeated string required_keys = 3;
 }
 
 message CertificateCfg {
