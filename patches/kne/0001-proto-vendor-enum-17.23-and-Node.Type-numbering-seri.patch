diff --git a/proto/topo/vendor_enum_test.go b/proto/topo/vendor_enum_test.go
new file mode 100644
index 0000000..71ac5ed
--- /dev/null
+++ b/proto/topo/vendor_enum_test.go
@@ -0,0 +1,54 @@
+package topo
+
+import "testing"
+
+// The Vendor and Node_Type numbers are a wire contract (kne_cli, the server and
+// the meshnet images read them by number). These values are the approved
+// 2026-10-20 numbering: SONIC and CIENA keep upstream's 15 and 16, Skyforge
+// vendors take 17..23, and Node.Type IN_CLUSTER_PROXY matches upstream's 15.
+// The test pins the NAMES to the NUMBERS, so a renumbering that is not also
+// approved fails here rather than on a live lab.
+func TestVendorEnumNumbersArePinned(t *testing.T) {
+	want := map[string]int32{
+		"UNKNOWN":          0,
+		"HOST":             1,
+		"ARISTA":           2,
+		"CISCO":            3,
+		"JUNIPER":          4,
+		"KEYSIGHT":         5,
+		"FRR":              6,
+		"QUAGGA":           7,
+		"GOBGP":            8,
+		"NOKIA":            9,
+		"OPENCONFIG":       10,
+		"ALPINE":           11,
+		"DRIVENETS":        12,
+		"FORWARD":          13,
+		"IN_CLUSTER_PROXY": 14,
+		"SONIC":            15,
+		"CIENA":            16,
+		"A10":              17,
+		"ARUBA":            18,
+		"DELL":             19,
+		"FORTINET":         20,
+		"PALOALTO":         21,
+		"VERSA":            22,
+		"F5":               23,
+	}
+	if len(Vendor_value) != len(want) {
+		t.Errorf("Vendor has %d values, want %d", len(Vendor_value), len(want))
+	}
+	for name, num := range want {
+		got, ok := Vendor_value[name]
+		if !ok {
+			t.Errorf("Vendor %s missing", name)
+			continue
+		}
+		if got != num {
+			t.Errorf("Vendor %s = %d, want %d", name, got, num)
+		}
+	}
+	if got := Node_Type_value["IN_CLUSTER_PROXY"]; got != 15 {
+		t.Errorf("Node.Type IN_CLUSTER_PROXY = %d, want 15", got)
+	}
+}
