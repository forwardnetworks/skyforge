diff --git a/topo/node/alpine/node_antiaffinity_test.go b/topo/node/alpine/node_antiaffinity_test.go
new file mode 100644
index 0000000..0783114
--- /dev/null
+++ b/topo/node/alpine/node_antiaffinity_test.go
@@ -0,0 +1,115 @@
+package alpine
+
+import (
+	"context"
+	"testing"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	kfake "k8s.io/client-go/kubernetes/fake"
+	"k8s.io/client-go/rest"
+)
+
+// THE ANTI-AFFINITY MUST SELECT THE PODS IT REPELS.
+//
+// This pod spec labels itself `topo: <namespace>` and then builds a preferred
+// podAntiAffinity to spread same-lab pods across hosts. Upstream selected
+// `topo In [pb.Name]` -- the pod's own DEVICE name -- which no pod anywhere
+// carries, so the term selected zero pods and repelled nothing.
+//
+// kne 0059 fixed the generic node.Impl.CreatePod. This vendor builds its OWN
+// pod spec from a byte-identical copy of the same literal, and kept the broken
+// value. MEASURED 2026-09-11 on the live demo-lab namespace: all 80 pods
+// labelled topo=<namespace>, 17 selecting the namespace and 40 selecting a
+// device name, with 64 of the 80 packed onto one node.
+//
+// Assert the LABEL and the SELECTOR agree -- the property that makes the term
+// able to bind at all. The control is that this test FAILS when pb.Name is
+// restored: the selector then names the device and the label names the
+// namespace.
+func TestPodAntiAffinitySelectorMatchesTheTopoLabel(t *testing.T) {
+	ctx := context.Background()
+	const ns = "user-x-demo-lab"
+	nImpl := &node.Impl{
+		Namespace:  ns,
+		KubeClient: kfake.NewSimpleClientset(),
+		RestConfig: &rest.Config{},
+		Proto: &tpb.Node{
+			Name:   "cdg-lan-pc01",
+			Vendor: tpb.Vendor_ALPINE,
+			Config: &tpb.Config{Image: "example/alpine:test"},
+		},
+	}
+	n, err := New(nImpl)
+	if err != nil {
+		t.Fatalf("New() failed: %v", err)
+	}
+	if err := n.(*Node).CreatePod(ctx); err != nil {
+		t.Fatalf("creating the pod: %v", err)
+	}
+	pod, err := nImpl.KubeClient.CoreV1().Pods(ns).Get(ctx, nImpl.Proto.Name, metav1.GetOptions{})
+	if err != nil {
+		t.Fatalf("reading back the created pod: %v", err)
+	}
+
+	label, ok := pod.ObjectMeta.Labels["topo"]
+	if !ok {
+		t.Fatal("pod carries no topo label")
+	}
+	terms := pod.Spec.Affinity.PodAntiAffinity.PreferredDuringSchedulingIgnoredDuringExecution
+	if len(terms) != 1 {
+		t.Fatalf("anti-affinity terms = %d, want 1", len(terms))
+	}
+	sel := terms[0].PodAffinityTerm.LabelSelector.MatchExpressions[0]
+	if sel.Key != "topo" {
+		t.Fatalf("selector key = %q, want topo", sel.Key)
+	}
+	if len(sel.Values) != 1 || sel.Values[0] != label {
+		t.Fatalf("selector selects %v but the label is %q -- the term matches NOTHING and spreads nothing",
+			sel.Values, label)
+	}
+	if sel.Values[0] != ns {
+		t.Fatalf("selector = %q, want the namespace %q so SAME-LAB pods repel each other", sel.Values[0], ns)
+	}
+	if terms[0].PodAffinityTerm.TopologyKey != "kubernetes.io/hostname" {
+		t.Fatalf("topologyKey = %q, want kubernetes.io/hostname", terms[0].PodAffinityTerm.TopologyKey)
+	}
+}
+
+// This vendor builds its OWN pod spec (byte-identical copy of the generic
+// literal) -- the container soft-avoid-SSD preference has to be wired here
+// too, or it silently half-applies exactly like the anti-affinity fix above
+// once did.
+func TestCreatePodCarriesContainerNodeAffinity(t *testing.T) {
+	ctx := context.Background()
+	t.Setenv("SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON", `{"skyforge.example.com/disk-class":"ssd"}`)
+	const ns = "user-x-demo-lab"
+	nImpl := &node.Impl{
+		Namespace:  ns,
+		KubeClient: kfake.NewSimpleClientset(),
+		RestConfig: &rest.Config{},
+		Proto: &tpb.Node{
+			Name:   "cdg-lan-pc01",
+			Vendor: tpb.Vendor_ALPINE,
+			Config: &tpb.Config{Image: "example/alpine:test"},
+		},
+	}
+	n, err := New(nImpl)
+	if err != nil {
+		t.Fatalf("New() failed: %v", err)
+	}
+	if err := n.(*Node).CreatePod(ctx); err != nil {
+		t.Fatalf("creating the pod: %v", err)
+	}
+	pod, err := nImpl.KubeClient.CoreV1().Pods(ns).Get(ctx, nImpl.Proto.Name, metav1.GetOptions{})
+	if err != nil {
+		t.Fatalf("reading back the created pod: %v", err)
+	}
+	if pod.Spec.Affinity.NodeAffinity == nil {
+		t.Fatal("emitted pod carries no nodeAffinity -- the container soft-avoid-SSD preference steers nothing")
+	}
+	if pod.Spec.Affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution != nil {
+		t.Fatal("emitted pod carries a REQUIRED node affinity; the policy must only rank")
+	}
+}
