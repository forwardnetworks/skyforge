+// Dell OS10 (vr-ftosv) day-0 is NOT disk-deliverable: OS10 exposes no config-drive/
+// cloud-init datasource and scans no attached disk/ISO for a startup-config (its startup
+// lives internally at config://startup.xml; USB requires an explicit CLI copy — verified:
+// a root "userdata" ISO is ignored). vrnetlab's vr-ftosv instead injects config command-
+// by-command over the ttyS0 serial console from launch.py: log in (admin/admin), cancel
+// ZTD, `configure terminal`, paste each line, `copy running-configuration
+// startup-configuration`. This is the only headless path — ZTD (DHCP opt 240) is the sole
+// network alternative and vrnetlab deliberately disables it at image-prep, so it is not
+// available on our image and is far more invasive to wire into the Cilium/masquerade mgmt
+// path. We therefore replicate launch.py as a per-node companion pod (the serial config-
+// injector) rather than mint an inert secret-disk that would silently drop intent.
+//
+// The injector connects to the guest serial console via `virtctl console`, which streams
+// the KubeVirt virtualmachineinstances/console subresource — the same ttyS0 that
+// autoattachSerialConsole wires as an isa-serial device. It sources the SAME netlab-
+// authored startup-config that every other VM NOS day-0 uses (n.readConfig()), delivered
+// to the pod as a Secret.
+const (
+	kubeVirtDellOS10InjectorConfigFileName = "startup-config.cfg"
+	kubeVirtDellOS10InjectorScriptKey      = "inject.py"
+	// kubeVirtDellOS10InjectorLoginUser/Pass are the OS10 factory credentials the
+	// vr-ftosv image ships with; the injector uses them to reach the enable prompt,
+	// mirroring vrnetlab launch.py (admin/admin).
+	kubeVirtDellOS10InjectorLoginUser = "admin"
+	kubeVirtDellOS10InjectorLoginPass = "admin"
+)
+
+// kubeVirtDellOS10InjectorResourceName is the shared name for the injector's SA, Role,
+// RoleBinding, Secret, ConfigMap and Pod, bounded to 63 chars like the TFTP helper.
+func kubeVirtDellOS10InjectorResourceName(nodeName string) string {
+	base := strings.ToLower(strings.TrimSpace(nodeName + "-os10-inject"))
+	base = strings.Trim(base, "-")
+	if len(base) <= 63 {
+		return base
+	}
+	sum := sha256.Sum256([]byte(base))
+	return strings.TrimRight(base[:54], "-") + "-" + fmt.Sprintf("%x", sum[:])[:8]
+}
+
+// kubeVirtDellOS10InjectorImage resolves the container image for the serial injector. It
+// MUST bundle `virtctl`, python3 and pexpect. It reuses the skyforge netlab-runtime image
+// when that carries virtctl; a dedicated override takes precedence. There is deliberately
+// no plain-python default (unlike the TFTP helper): without virtctl the pod cannot reach
+// the console, so an unset image is a loud misconfiguration at pod start rather than a
+// silent no-op.
+func kubeVirtDellOS10InjectorImage() string {
+	for _, key := range []string{"SKYFORGE_KUBEVIRT_SERIAL_INJECTOR_IMAGE", "SKYFORGE_NETLAB_RUNTIME_IMAGE"} {
+		if image := strings.TrimSpace(os.Getenv(key)); image != "" {
+			return image
+		}
+	}
+	return "registry.example.com/skyforge/kubevirt/serial-injector:latest"
+}
+
+func kubeVirtDellOS10InjectorPullPolicy() corev1.PullPolicy {
+	policy := strings.TrimSpace(os.Getenv("SKYFORGE_NETLAB_RUNTIME_PULL_POLICY"))
+	if policy == "" {
+		return corev1.PullIfNotPresent
+	}
+	return corev1.PullPolicy(policy)
+}
+
+func kubeVirtDellOS10InjectorLabels(nodeName string, labels map[string]string) map[string]string {
+	out := map[string]string{}
+	for key, value := range labels {
+		out[key] = value
+	}
+	out["app"] = kubeVirtDellOS10InjectorResourceName(nodeName)
+	out["kneBootstrap"] = "os10-serial-inject"
+	return out
+}
+
+// kubeVirtDellOS10InjectorScript is the embedded expect-style driver, faithful to
+// vrnetlab dell/ftosv/docker/launch.py + the netlab libvirt/dellos10 build recipe. It
+// spawns `virtctl console` on the node's VMI, waits (patiently — OS10 first boot is slow)
+// for the login prompt, authenticates, cancels ZTD, then pastes the netlab startup-config
+// line-by-line and saves it to startup. OS10 config is declarative, so a re-run (pod
+// restart before success) is safe; RestartPolicy OnFailure means it runs once to success.
+const kubeVirtDellOS10InjectorScript = `#!/usr/bin/env python3
+import os, sys, time
+import pexpect
+
+VMI   = os.environ["VMI_NAME"]
+NS    = os.environ["VMI_NAMESPACE"]
+USER  = os.environ.get("OS10_USER", "admin")
+PASS  = os.environ.get("OS10_PASS", "admin")
+CFG   = os.environ.get("OS10_CONFIG_FILE", "/config/` + kubeVirtDellOS10InjectorConfigFileName + `")
+BOOT_TIMEOUT = int(os.environ.get("OS10_BOOT_TIMEOUT_SECONDS", "1800"))
+
+PROMPT = r"OS10#|[A-Za-z0-9._-]+#"
+CONFIG_PROMPT = r"\(conf[^)]*\)#"
+
+def wait_login(child):
+    deadline = time.time() + BOOT_TIMEOUT
+    while time.time() < deadline:
+        child.sendline("")
+        i = child.expect([r"login:", r"[Pp]assword:", PROMPT, pexpect.TIMEOUT], timeout=20)
+        if i == 0: return "login"
+        if i == 1: return "password"
+        if i == 2: return "prompt"
+    sys.exit("timed out after %ds waiting for OS10 login/enable prompt on ttyS0 "
+             "(is the vr-ftosv image an INSTALLED, serial-console image? an empty/"
+             "placeholder boot disk never reaches a login prompt)" % BOOT_TIMEOUT)
+
+def login(child):
+    st = wait_login(child)
+    if st == "prompt":
+        return
+    if st == "password":
+        child.sendline(PASS); child.expect(PROMPT, timeout=90); return
+    child.sendline(USER)
+    child.expect(r"[Pp]assword:", timeout=60)
+    child.sendline(PASS)
+    i = child.expect([PROMPT, r"(?i)current password:", r"(?i)new password:"], timeout=90)
+    if i == 1:
+        child.sendline(PASS); child.expect(r"(?i)new password:", timeout=30)
+        child.sendline(PASS); child.expect(r"(?i)(re-?enter|confirm).*password:", timeout=30)
+        child.sendline(PASS); child.expect(PROMPT, timeout=60)
+    elif i == 2:
+        child.sendline(PASS); child.expect(r"(?i)(re-?enter|confirm).*password:", timeout=30)
+        child.sendline(PASS); child.expect(PROMPT, timeout=60)
+
+def cancel_ztd(child):
+    # Factory OS10 runs Zero-Touch Deployment which can lock config. vrnetlab cancels
+    # it at image-prep; our containerDisk may not be prepped, so cancel at runtime.
+    # Idempotent: tolerate "% Error"/already-canceled.
+    child.sendline("ztd cancel")
+    i = child.expect([r"(?i)\[confirm[^\]]*\]|\(y/n\)|\[yes/no\]", PROMPT], timeout=30)
+    if i == 0:
+        child.sendline("yes"); child.expect(PROMPT, timeout=30)
+
+def apply_config(child, lines):
+    child.sendline("configure terminal")
+    child.expect(CONFIG_PROMPT, timeout=30)
+    for ln in lines:
+        child.sendline(ln)
+        child.expect(r"#", timeout=45)
+    child.sendline("end")
+    child.expect(PROMPT, timeout=30)
+    child.sendline("copy running-configuration startup-configuration")
+    i = child.expect([r"(?i)\[confirm[^\]]*\]|\(y/n\)", PROMPT], timeout=180)
+    if i == 0:
+        child.sendline("yes"); child.expect(PROMPT, timeout=180)
+
+def main():
+    with open(CFG) as f:
+        lines = [l.rstrip() for l in f if l.strip() and not l.lstrip().startswith("#")]
+    if not lines:
+        print("no OS10 day-0 config to inject; exiting")
+        return
+    child = pexpect.spawn("virtctl console %s -n %s" % (VMI, NS), encoding="utf-8", timeout=90)
+    child.logfile_read = sys.stdout
+    login(child)
+    cancel_ztd(child)
+    apply_config(child, lines)
+    print("\nOS10 day-0 config injected over ttyS0 and saved to startup-configuration")
+    try:
+        child.sendcontrol("]")
+    except Exception:
+        pass
+
+if __name__ == "__main__":
+    main()
+`
+
+func kubeVirtDellOS10InjectorRoleRules() []rbacv1.PolicyRule {
+	return []rbacv1.PolicyRule{
+		{
+			// virtctl console streams this subresource.
+			APIGroups: []string{"subresources.kubevirt.io"},
+			Resources: []string{"virtualmachineinstances/console"},
+			Verbs:     []string{"get", "update"},
+		},
+		{
+			APIGroups: []string{"kubevirt.io"},
+			Resources: []string{"virtualmachineinstances"},
+			Verbs:     []string{"get", "list", "watch"},
+		},
+	}
+}
+
+// ensureKubeVirtDellOS10SerialInjector creates the per-node serial config-injector: an
+// RBAC-scoped companion pod that logs into the OS10 guest over ttyS0 and pastes the
+// netlab startup-config. No-op for non-dellos10 nodes or nodes carrying no config. Mirrors
+// ensureKubeVirtBootstrapTFTP's shape (Secret/ConfigMap/Pod) plus the SA+Role+RoleBinding
+// virtctl console requires.
+func (n *Impl) ensureKubeVirtDellOS10SerialInjector(ctx context.Context, labels map[string]string, configData []byte) error {
+	if n == nil || n.Proto == nil || !kubeVirtIsDellOS10(n.Proto.Model) {
+		return nil
+	}
+	if len(bytes.TrimSpace(configData)) == 0 {
+		return nil
+	}
+	name := kubeVirtDellOS10InjectorResourceName(n.Name())
+	injLabels := kubeVirtDellOS10InjectorLabels(n.Name(), labels)
+
+	sa := &corev1.ServiceAccount{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+	}
+	saClient := n.KubeClient.CoreV1().ServiceAccounts(n.Namespace)
+	if _, err := saClient.Create(ctx, sa, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return err
+	}
+
+	role := &rbacv1.Role{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Rules:      kubeVirtDellOS10InjectorRoleRules(),
+	}
+	roleClient := n.KubeClient.RbacV1().Roles(n.Namespace)
+	if _, err := roleClient.Create(ctx, role, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		if cur, err := roleClient.Get(ctx, name, metav1.GetOptions{}); err == nil {
+			cur.Rules = role.Rules
+			cur.Labels = injLabels
+			if _, err := roleClient.Update(ctx, cur, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+
+	rb := &rbacv1.RoleBinding{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		RoleRef:    rbacv1.RoleRef{APIGroup: "rbac.authorization.k8s.io", Kind: "Role", Name: name},
+		Subjects:   []rbacv1.Subject{{Kind: "ServiceAccount", Name: name, Namespace: n.Namespace}},
+	}
+	rbClient := n.KubeClient.RbacV1().RoleBindings(n.Namespace)
+	if _, err := rbClient.Create(ctx, rb, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return err
+	}
+
+	cfg := append(bytes.TrimRight(configData, "\r\n"), '\n')
+	secret := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Type:       corev1.SecretTypeOpaque,
+		Data:       map[string][]byte{kubeVirtDellOS10InjectorConfigFileName: cfg},
+	}
+	secClient := n.KubeClient.CoreV1().Secrets(n.Namespace)
+	if _, err := secClient.Create(ctx, secret, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		if cur, err := secClient.Get(ctx, name, metav1.GetOptions{}); err == nil {
+			cur.Data = secret.Data
+			cur.Labels = injLabels
+			if _, err := secClient.Update(ctx, cur, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+
+	cm := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Data:       map[string]string{kubeVirtDellOS10InjectorScriptKey: kubeVirtDellOS10InjectorScript},
+	}
+	cmClient := n.KubeClient.CoreV1().ConfigMaps(n.Namespace)
+	if _, err := cmClient.Create(ctx, cm, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		if cur, err := cmClient.Get(ctx, name, metav1.GetOptions{}); err == nil {
+			cur.Data = cm.Data
+			cur.Labels = injLabels
+			if _, err := cmClient.Update(ctx, cur, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Spec: corev1.PodSpec{
+			RestartPolicy:      corev1.RestartPolicyOnFailure,
+			ServiceAccountName: name,
+			Tolerations:        KNETolerations(),
+			NodeSelector:       KNENodeSelector(),
+			Containers: []corev1.Container{{
+				Name:            "os10-serial-inject",
+				Image:           kubeVirtDellOS10InjectorImage(),
+				ImagePullPolicy: kubeVirtDellOS10InjectorPullPolicy(),
+				Command:         []string{"python3", "/inject/" + kubeVirtDellOS10InjectorScriptKey},
+				Env: []corev1.EnvVar{
+					{Name: "VMI_NAME", Value: n.Name()},
+					{Name: "VMI_NAMESPACE", Value: n.Namespace},
+					{Name: "OS10_USER", Value: kubeVirtDellOS10InjectorLoginUser},
+					{Name: "OS10_PASS", Value: kubeVirtDellOS10InjectorLoginPass},
+				},
+				VolumeMounts: []corev1.VolumeMount{
+					{Name: "config", MountPath: "/config", ReadOnly: true},
+					{Name: "script", MountPath: "/inject", ReadOnly: true},
+				},
+			}},
+			Volumes: []corev1.Volume{
+				{Name: "config", VolumeSource: corev1.VolumeSource{Secret: &corev1.SecretVolumeSource{SecretName: name}}},
+				{Name: "script", VolumeSource: corev1.VolumeSource{ConfigMap: &corev1.ConfigMapVolumeSource{LocalObjectReference: corev1.LocalObjectReference{Name: name}}}},
+			},
+		},
+	}
+	podClient := n.KubeClient.CoreV1().Pods(n.Namespace)
+	if _, err := podClient.Create(ctx, pod, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return err
+	}
+	return nil
+}
+
+// deleteKubeVirtDellOS10SerialInjector tears down the injector's per-node resources.
+func (n *Impl) deleteKubeVirtDellOS10SerialInjector(ctx context.Context) error {
+	if n == nil || n.Proto == nil || !kubeVirtIsDellOS10(n.Proto.Model) {
+		return nil
+	}
+	name := kubeVirtDellOS10InjectorResourceName(n.Name())
+	if err := n.KubeClient.CoreV1().Pods(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.CoreV1().ConfigMaps(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.CoreV1().Secrets(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.RbacV1().RoleBindings(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.RbacV1().Roles(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.CoreV1().ServiceAccounts(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	return nil
+}
+
+func kubeVirtSrosBootstrapUserData(startupCfg []byte) ([]byte, error) {
+	startupCfg = bytes.TrimSpace(startupCfg)
+	if len(startupCfg) == 0 {
+		return nil, fmt.Errorf("sros bootstrap startup-config is empty")
+	}
+	return append(append([]byte{}, startupCfg...), '\n'), nil
+}
+
+func kubeVirtSrosBootstrapDiskAndVolume(secretName string, startupCfg []byte) (map[string]any, map[string]any, []byte, error) {
+	secretData, err := kubeVirtSrosBootstrapUserData(startupCfg)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	return map[string]any{
+			"name": kubeVirtSrosBootstrapDiskName,
+			"cdrom": map[string]any{
+				"bus": "sata",
+			},
+		},
+		kubeVirtConfigDriveSecretVolume(kubeVirtSrosBootstrapDiskName, secretName),
+		secretData,
+		nil
+}
+
+func kubeVirtBootstrapTFTPResourceName(nodeName string) string {
+	base := strings.ToLower(strings.TrimSpace(nodeName + "-bootstrap-tftp"))
+	base = strings.Trim(base, "-")
+	if len(base) <= 63 {
+		return base
+	}
+	sum := sha256.Sum256([]byte(base))
+	return strings.TrimRight(base[:54], "-") + "-" + fmt.Sprintf("%x", sum[:])[:8]
+}
+
+func kubeVirtBootstrapTFTPImage() string {
+	for _, key := range []string{"SKYFORGE_KUBEVIRT_BOOTSTRAP_IMAGE", "SKYFORGE_NETLAB_RUNTIME_IMAGE"} {
+		if image := strings.TrimSpace(os.Getenv(key)); image != "" {
+			return image
+		}
+	}
+	return "python:3.12-slim"
+}
+
+func kubeVirtTolerations() []map[string]any {
+	tolerations := KNETolerations()
+	if len(tolerations) == 0 {
+		return nil
+	}
+	out := make([]map[string]any, 0, len(tolerations))
+	for _, toleration := range tolerations {
+		item := map[string]any{}
+		if toleration.Key != "" {
+			item["key"] = toleration.Key
+		}
+		if toleration.Operator != "" {
+			item["operator"] = string(toleration.Operator)
+		}
+		if toleration.Value != "" {
+			item["value"] = toleration.Value
+		}
+		if toleration.Effect != "" {
+			item["effect"] = string(toleration.Effect)
+		}
+		if toleration.TolerationSeconds != nil {
+			item["tolerationSeconds"] = *toleration.TolerationSeconds
+		}
+		out = append(out, item)
+	}
+	return out
+}
+
+func kubeVirtBootstrapTFTPPullPolicy() corev1.PullPolicy {
+	policy := strings.TrimSpace(os.Getenv("SKYFORGE_NETLAB_RUNTIME_PULL_POLICY"))
+	if policy == "" {
+		return corev1.PullIfNotPresent
+	}
+	return corev1.PullPolicy(policy)
+}
+
+func kubeVirtBootstrapTFTPTimeout() time.Duration {
+	const defaultTimeout = 10 * time.Minute
+	raw := strings.TrimSpace(os.Getenv("SKYFORGE_KUBEVIRT_BOOTSTRAP_TFTP_TIMEOUT_SECONDS"))
+	if raw == "" {
+		return defaultTimeout
+	}
+	seconds, err := strconv.Atoi(raw)
+	if err != nil || seconds <= 0 {
+		return defaultTimeout
+	}
+	return time.Duration(seconds) * time.Second
+}
+
+func kubeVirtBootstrapTFTPLabels(nodeName string, labels map[string]string) map[string]string {
+	out := map[string]string{}
+	for key, value := range labels {
+		out[key] = value
+	}
+	out["app"] = kubeVirtBootstrapTFTPResourceName(nodeName)
+	out["kneBootstrap"] = "tftp"
+	return out
+}
+
+func kubeVirtBootstrapTFTPAffinity() *corev1.Affinity {
+	reqs := []corev1.NodeSelectorRequirement{
+		{
+			Key:      "kubevirt.io/schedulable",
+			Operator: corev1.NodeSelectorOpIn,
+			Values:   []string{"true"},
+		},
+	}
+	if KNENodeSelectorHostname() == "" {
+		reqs = append(reqs, corev1.NodeSelectorRequirement{
+			Key:      "skyforge.example.com/labs",
+			Operator: corev1.NodeSelectorOpIn,
+			Values:   []string{"true"},
+		})
+	}
+	return &corev1.Affinity{
+		NodeAffinity: &corev1.NodeAffinity{
+			RequiredDuringSchedulingIgnoredDuringExecution: &corev1.NodeSelector{
+				NodeSelectorTerms: []corev1.NodeSelectorTerm{{
+					MatchExpressions: reqs,
+				}},
+			},
+		},
+	}
+}
+
+func (n *Impl) ensureKubeVirtBootstrapTFTP(ctx context.Context, labels map[string]string, configData []byte) (string, string, time.Time, error) {
+	if n == nil || n.Proto == nil || !kubeVirtUsesBootstrapTFTP(n.Proto.Model) {
+		return "", "", time.Time{}, nil
+	}
+	licenseData, machineUUID, licenseClockBase, err := kubeVirtBootstrapTFTPLicense(n.Proto.Model)
+	if err != nil {
+		return "", "", time.Time{}, err
+	}
+	// NOTHING TO SERVE, NO SERVER. With an image-local license and no bootstrap
+	// config the VM's SMBIOS points at cf3:\lic and cf3:\config.cfg
+	// (kubeVirtSrosSMBIOSProduct) and never contacts TFTP, yet a TFTP pod and
+	// Service were still created for every SR OS node. That pod carries the node's
+	// labels, so the platform counted it as a TOPOLOGY POD: an SR OS pair
+	// (2026-09-30, _smoke/nos/sros/fabric) reached DeviceConfigApplied=True and
+	// LinksReady=True and was still failed at RuntimeReady with
+	// "expected=2 observed=4 ready=4" -- two VMs plus two idle TFTP servers.
+	// The machine UUID and license clock base above are all the VM needs here.
+	if strings.TrimSpace(licenseData) == "" && len(bytes.TrimSpace(configData)) == 0 {
+		log.Infof("Node %q: image-local license and no bootstrap config; no TFTP bootstrap server is created", n.Name())
+		return "", machineUUID, licenseClockBase, nil
+	}
+	name := kubeVirtBootstrapTFTPResourceName(n.Name())
+	tftpLabels := kubeVirtBootstrapTFTPLabels(n.Name(), labels)
+	cm := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: n.Namespace,
+			Labels:    tftpLabels,
+		},
+		Data: map[string]string{
+			kubeVirtBootstrapTFTPServerKey: kubeVirtBootstrapTFTPServerScript,
+		},
+	}
+	if strings.TrimSpace(licenseData) != "" {
+		cm.Data[kubeVirtBootstrapTFTPLicenseKey] = licenseData
+	}
+	if trimmed := bytes.TrimRight(configData, "\r\n"); len(bytes.TrimSpace(trimmed)) > 0 {
+		cm.Data[kubeVirtBootstrapTFTPConfigKey] = string(append(trimmed, '\n'))
+	}
+	cmClient := n.KubeClient.CoreV1().ConfigMaps(n.Namespace)
+	if _, err := cmClient.Create(ctx, cm, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return "", "", time.Time{}, err
+		}
+		current, err := cmClient.Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return "", "", time.Time{}, err
+		}
+		current.Labels = tftpLabels
+		current.Data = cm.Data
+		if _, err := cmClient.Update(ctx, current, metav1.UpdateOptions{}); err != nil {
+			return "", "", time.Time{}, err
+		}
+	}
+
+	service := &corev1.Service{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: n.Namespace,
+			Labels:    tftpLabels,
+		},
+		Spec: corev1.ServiceSpec{
+			Ports: []corev1.ServicePort{{
+				Name:       "tftp",
+				Protocol:   corev1.ProtocolUDP,
+				Port:       69,
+				TargetPort: intstr.FromInt(69),
+			}},
+			Selector: map[string]string{
+				"app":          name,
+				"kneBootstrap": "tftp",
+			},
+			Type: corev1.ServiceTypeClusterIP,
+		},
+	}
+	svcClient := n.KubeClient.CoreV1().Services(n.Namespace)
+	if _, err := svcClient.Create(ctx, service, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return "", "", time.Time{}, err
+		}
+		current, err := svcClient.Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return "", "", time.Time{}, err
+		}
+		current.Labels = tftpLabels
+		current.Spec.Ports = service.Spec.Ports
+		current.Spec.Selector = service.Spec.Selector
+		if _, err := svcClient.Update(ctx, current, metav1.UpdateOptions{}); err != nil {
+			return "", "", time.Time{}, err
+		}
+	}
+	currentService, err := svcClient.Get(ctx, name, metav1.GetOptions{})
+	if err != nil {
+		return "", "", time.Time{}, err
+	}
+	tftpHost := strings.TrimSpace(currentService.Spec.ClusterIP)
+	if tftpHost == "" || strings.EqualFold(tftpHost, "none") {
+		return "", "", time.Time{}, fmt.Errorf("TFTP bootstrap service %q has no ClusterIP", name)
+	}
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: n.Namespace,
+			Labels:    tftpLabels,
+		},
+		Spec: corev1.PodSpec{
+			RestartPolicy: corev1.RestartPolicyAlways,
+			Tolerations:   KNETolerations(),
+			NodeSelector:  KNENodeSelector(),
+			Affinity:      kubeVirtBootstrapTFTPAffinity(),
+			Containers: []corev1.Container{{
+				Name:            "tftp",
+				Image:           kubeVirtBootstrapTFTPImage(),
+				ImagePullPolicy: kubeVirtBootstrapTFTPPullPolicy(),
+				Command:         []string{"python3", "/tftpboot/" + kubeVirtBootstrapTFTPServerKey, "/tftpboot"},
+				Ports: []corev1.ContainerPort{{
+					Name:          "tftp",
+					ContainerPort: 69,
+					Protocol:      corev1.ProtocolUDP,
+				}},
+				VolumeMounts: []corev1.VolumeMount{{
+					Name:      "tftpboot",
+					MountPath: "/tftpboot",
+					ReadOnly:  true,
+				}},
+			}},
+			Volumes: []corev1.Volume{{
+				Name: "tftpboot",
+				VolumeSource: corev1.VolumeSource{
+					ConfigMap: &corev1.ConfigMapVolumeSource{
+						LocalObjectReference: corev1.LocalObjectReference{Name: name},
+					},
+				},
+			}},
+		},
+	}
+	podClient := n.KubeClient.CoreV1().Pods(n.Namespace)
+	if _, err := podClient.Create(ctx, pod, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return "", "", time.Time{}, err
+	}
+	timeout := kubeVirtBootstrapTFTPTimeout()
+	deadline := time.Now().Add(timeout)
+	for {
+		current, err := podClient.Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return "", "", time.Time{}, err
+		}
+		if current.Status.Phase == corev1.PodRunning {
+			if strings.TrimSpace(current.Status.PodIP) == "" {
+				return "", "", time.Time{}, fmt.Errorf("TFTP bootstrap pod %q has no PodIP", name)
+			}
+			return tftpHost, machineUUID, licenseClockBase, nil
+		}
+		if time.Now().After(deadline) {
+			return "", "", time.Time{}, fmt.Errorf("timed out after %s waiting for TFTP bootstrap pod %q to run (phase %s)", timeout, name, current.Status.Phase)
+		}
+		select {
+		case <-ctx.Done():
+			return "", "", time.Time{}, ctx.Err()
+		case <-time.After(1 * time.Second):
+		}
+	}
+}
