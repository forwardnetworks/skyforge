+		InterfaceModel:     "e1000",
+		BootstrapTransport: "image-owned",
+		IdentityInputs:     []string{"model"},
+		ReadinessProbes:    []string{"ansible"},
+		// PAN-OS VM-series on 1 vCPU crawls: the mgmt/web (443) plane never comes
+		// up inside the readiness window (timed out at 1512s). PA-VM needs >=4 vCPU
+		// / ~6.5Gi; floor at 4 / 8Gi.
+		MinimumCPU:          4,
+		MinimumMemory:       "8Gi",
+		ConfigApplyRequires: []string{"VMReady", "ManagementReady"},
+		ContainerDisks: []kubeVirtContainerDiskSpec{{
+			Name: "containerdisk",
+			Bus:  "virtio",
+			Path: "",
+		}},
+	},
+	"sros": {
+		CPUModel: "host-passthrough",
+		// e1000. THIS RATIONALE WAS WRITTEN ONCE AND THEN DELETED -- restored here
+		// verbatim from kne fork 505045f (2026-06-08), which a series consolidation
+		// on 2026-06-21 (8d4fdfb) dropped along with a libvirt hook that had forced
+		// e1000 onto every interface:
+		//
+		//   "SR-OS license and bootrom acceptance are sensitive to the emulated
+		//    hardware tuple. Keep this aligned with the proven KubeVirt contract:
+		//    q35 avoids PCI slot exhaustion, transitional virtio preserves the
+		//    legacy disk shape SR-OS bootrom expects, and e1000 matches the
