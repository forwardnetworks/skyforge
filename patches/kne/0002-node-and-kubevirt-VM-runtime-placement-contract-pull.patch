+// SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON env var KNEIOHeavyNodeAffinity reads,
+// just with NotIn instead of In, so the two preferences can never name
+// different nodes and drift apart -- there is still only one policy input,
+// same principle KNEIOHeavyNodeAffinityUnstructured's own doc states for its
+// half of this mechanism.
+func KNEContainerNodeAffinity() *corev1.NodeAffinity {
+	raw := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON"))
+	if raw == "" {
+		return nil
+	}
+	labels := map[string]string{}
+	if err := json.Unmarshal([]byte(raw), &labels); err != nil {
+		log.Errorf("invalid SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON: %v", err)
+		return nil
+	}
+	if len(labels) == 0 {
+		return nil
+	}
+	keys := make([]string, 0, len(labels))
+	for k := range labels {
+		keys = append(keys, k)
+	}
+	slices.Sort(keys)
+	exprs := make([]corev1.NodeSelectorRequirement, 0, len(keys))
+	for _, k := range keys {
+		exprs = append(exprs, corev1.NodeSelectorRequirement{
+			Key:      k,
+			Operator: corev1.NodeSelectorOpNotIn,
+			Values:   []string{labels[k]},
+		})
+	}
+	return &corev1.NodeAffinity{
+		PreferredDuringSchedulingIgnoredDuringExecution: []corev1.PreferredSchedulingTerm{{
+			Weight:     100,
+			Preference: corev1.NodeSelectorTerm{MatchExpressions: exprs},
+		}},
+	}
+}
