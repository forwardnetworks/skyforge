+func (n *Impl) kubeVirtBootstrapSecretData(ctx context.Context) (string, []byte, error) {
+	_ = ctx
+	if n == nil || n.Proto == nil || n.Proto.Config == nil || n.Proto.Config.ConfigData == nil {
+		return "", nil, nil
+	}
+	if kubeVirtUsesBootstrapTFTP(n.Proto.Model) {
+		return "", nil, nil
+	}
+	configData, err := n.readConfig()
+	if err != nil {
+		return "", nil, err
+	}
+	if kubeVirtIsF5(n.Proto.Model) {
+		secretData, err := kubeVirtF5BootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtF5BootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsFortios(n.Proto.Model) {
+		secretData, err := kubeVirtFortiosBootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtFortiosBootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsPanos(n.Proto.Model) {
+		secretData, err := kubeVirtPanosBootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtPanosBootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsASAv(n.Proto.Model) {
+		secretData, err := kubeVirtASAvBootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtASAvBootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsIOSXE(n.Proto.Model) {
+		secretData, err := kubeVirtIOSXEBootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtIOSXEBootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsViptelaDay0(n.Proto.Model) {
+		secretData, err := kubeVirtViptelaBootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtViptelaBootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsVJunos(n.Proto.Model) {
+		secretData, err := kubeVirtVJunosBootstrapUserData(configData)
+		if err != nil {
+			return "", nil, err
+		}
+		return kubeVirtBootstrapSecretName(n.Name(), kubeVirtVJunosBootstrapDiskName), secretData, nil
+	}
+	if kubeVirtIsDellOS10(n.Proto.Model) {
+		// OS10 (vr-ftosv) consumes NO bootstrap DISK: it has no config-drive/
+		// cloud-init/scanned-file day-0 consumer (verified — a root "userdata"
+		// ISO is ignored). Its day-0 is delivered instead by the serial config-
+		// injector companion pod (ensureKubeVirtDellOS10SerialInjector), which
+		// replicates vrnetlab launch.py: log in over ttyS0 and paste the netlab
+		// startup-config. So attach no bootstrap-disk secret here — return the
+		// empty (no-disk) result rather than the former fail-closed error.
+		return "", nil, nil
+	}
+	if kubeVirtIsA10(n.Proto.Model) {
+		// No bootstrap secret for A10: see kubeVirtIsA10. Falling through to the
+		// generic passthrough would ship a CVAC-named ISO the image never reads.
+		return "", nil, nil
+	}
+	// Default: generic NX-OS-style secret-disk passthrough for any remaining
+	// image-owned model carrying a startup-config. The nxos CVAC filename is
+	// applied via kubeVirtBootstrapSecretKey. Models needing a bespoke bootstrap
+	// format are special-cased above (fortios/panos/asav/ios-xe/viptela;
+	// dellos10 uses its serial injector).
+	secretData, err := kubeVirtNxosBootstrapUserData(configData)
+	if err != nil {
+		return "", nil, err
+	}
+	return kubeVirtBootstrapSecretName(n.Name(), kubeVirtNxosBootstrapDiskName), secretData, nil
+}
+
+func (n *Impl) ensureKubeVirtBootstrapSecret(ctx context.Context, name string, userData []byte, labels map[string]string) error {
+	if strings.TrimSpace(name) == "" || len(userData) == 0 {
+		return nil
+	}
+	secret := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: n.Namespace,
+			Labels:    labels,
+		},
+		Type: corev1.SecretTypeOpaque,
+		Data: map[string][]byte{
+			kubeVirtBootstrapSecretKeyFor(n.Proto.GetModel(), userData): userData,
+		},
+	}
+	client := n.KubeClient.CoreV1().Secrets(n.Namespace)
+	if _, err := client.Create(ctx, secret, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		current, err := client.Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return err
+		}
+		current.Labels = labels
+		current.Type = corev1.SecretTypeOpaque
+		current.Data = secret.Data
+		if _, err := client.Update(ctx, current, metav1.UpdateOptions{}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
