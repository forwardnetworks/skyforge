+func kubeVirtBootstrapSecretName(nodeName, diskName string) string {
+	base := strings.ToLower(strings.TrimSpace(nodeName + "-" + diskName))
+	base = strings.Trim(base, "-")
+	if len(base) <= 63 {
+		return base
+	}
+	sum := sha256.Sum256([]byte(base))
+	return strings.TrimRight(base[:54], "-") + "-" + fmt.Sprintf("%x", sum[:])[:8]
+}
+
+func kubeVirtBootstrapBundleResourceName(nodeName, bundleName string) string {
+	base := strings.ToLower(strings.TrimSpace(nodeName + "-" + bundleName))
+	var normalized strings.Builder
+	for _, char := range base {
+		if (char >= 'a' && char <= 'z') || (char >= '0' && char <= '9') || char == '-' {
+			normalized.WriteRune(char)
+		} else {
+			normalized.WriteRune('-')
+		}
+	}
+	base = strings.Trim(normalized.String(), "-")
+	if base == "" {
+		base = "bootstrap-bundle"
+	}
+	if len(base) <= 63 {
+		return base
+	}
+	sum := sha256.Sum256([]byte(base))
+	return strings.TrimRight(base[:54], "-") + "-" + fmt.Sprintf("%x", sum[:])[:8]
+}
+
+func kubeVirtBootstrapBundleDiskAndVolume(nodeName string, bundle *tpb.BootstrapBundle) (map[string]any, map[string]any, error) {
+	if bundle == nil {
+		return nil, nil, fmt.Errorf("bootstrap bundle is nil")
+	}
+	if strings.TrimSpace(bundle.GetName()) == "" {
+		return nil, nil, fmt.Errorf("bootstrap bundle name is empty")
+	}
+	if strings.TrimSpace(bundle.GetSecretName()) == "" {
+		return nil, nil, fmt.Errorf("bootstrap bundle %q source secret name is empty", bundle.GetName())
+	}
+	if len(bundle.GetRequiredKeys()) == 0 {
+		return nil, nil, fmt.Errorf("bootstrap bundle %q has no required keys", bundle.GetName())
+	}
+	name := kubeVirtBootstrapBundleResourceName(nodeName, bundle.GetName())
+	return map[string]any{
+			"name": name,
+			"cdrom": map[string]any{
+				"bus": "sata",
+			},
+		},
+		kubeVirtSecretDiskVolume(name, name),
+		nil
+}
