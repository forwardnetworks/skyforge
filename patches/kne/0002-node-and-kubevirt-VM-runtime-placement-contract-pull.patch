+func kubeVirtSrosSystemBaseMAC(nodeName string) string {
+	if configured := strings.TrimSpace(os.Getenv("SKYFORGE_SROS_SYSTEM_BASE_MAC")); configured != "" {
+		if hw, err := net.ParseMAC(configured); err == nil && len(hw) == 6 {
+			return strings.ToUpper(hw.String())
+		}
+	}
+	sum := sha256.Sum256([]byte(strings.TrimSpace(nodeName)))
+	b2, b3, b4 := sum[0], sum[1], sum[2]
+	if b2 == 0 && b3 == 0 && b4 == 0 {
+		b4 = 1
+	}
+	return fmt.Sprintf("0C:00:%02X:%02X:%02X:00", b2, b3, b4)
+}
+
+func kubeVirtSrosSMBIOSProduct(nodeName, tftpHost string, hasBootstrapConfig bool, timosLine string) string {
+	tftpHost = strings.TrimSpace(tftpHost)
+	if tftpHost == "" {
+		tftpHost = "10.0.2.1"
+	}
+	timosLine = strings.TrimSpace(timosLine)
+	if timosLine == "" {
+		timosLine = kubeVirtSrosDefaultTimosLine
+	}
+	parts := []string{
+		"TIMOS:address=10.0.2.2/24@active",
+		"address=200::1/127@active",
+		"static-route=0.0.0.0/0@10.0.2.1",
+	}
+	if kubeVirtSrosResolvedLicenseSource() == "image-local" {
+		parts = append(parts, `license-file=cf3:\lic`)
+		if hasBootstrapConfig {
+			parts = append(parts, fmt.Sprintf("primary-config=tftp://%s/config.txt", tftpHost))
+		} else {
+			parts = append(parts, `primary-config=cf3:\config.cfg`)
+		}
+	} else {
+		parts = append(parts, fmt.Sprintf("license-file=tftp://%s/license.txt", tftpHost))
+		if hasBootstrapConfig {
+			parts = append(parts, fmt.Sprintf("primary-config=tftp://%s/config.txt", tftpHost))
+		}
+	}
+	parts = append(parts,
+		"system-base-mac="+kubeVirtSrosSystemBaseMAC(nodeName),
+		timosLine,
+	)
+	return strings.Join(parts, " ")
+}
+
+func kubeVirtSrosTimosLineForVariant(variant string) (string, error) {
+	variant = strings.TrimSpace(variant)
+	if variant == "" || strings.EqualFold(variant, "sr-1") {
+		return kubeVirtSrosDefaultTimosLine, nil
+	}
+	if line, ok := kubeVirtSrosVariantTimosLines[variant]; ok {
+		return line, nil
+	}
+	return "", fmt.Errorf("SR-OS variant %q is missing the KNE timos-line contract", variant)
+}
