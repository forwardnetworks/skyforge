+func kubeVirtIOSXEBootstrapDiskAndVolume(secretName string, startupCfg []byte) (map[string]any, map[string]any, []byte, error) {
+	secretData, err := kubeVirtIOSXEBootstrapUserData(startupCfg)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	// CVAC secret-disk CD-ROM, keyed iosxe_config.txt -- NOT the OpenStack
+	// config-drive this function returned between patches 0020 and 0031.
+	//
+	// The config-drive shape was adopted because the 17.06.03 image did not
+	// ingest the cdrom under q35. The fleet now runs 17.18.03a, where the
+	// preference INVERTS -- measured on a live probe VM (2026-08-28):
+	//
+	//   config-drive user_data (this function's prior shape):
+	//     "No startup-config, starting autoinstall/pnp/ztp..." -- ignored
+	//     entirely; the guest fell through to PnP, generated an SSH host key
+	//     and answered on :22 with NO usable credential. That is exactly the
+	//     demo-lab vedge AUTHENTICATION_FAILED signature.
+	//
+	//   iso9660 secret-disk with /iosxe_config.txt on a SATA cdrom:
+	//     "%CVAC-4-CONFIG_DONE: Configuration generated from file
+	//      objstore:/iosxe_config was applied and saved to NVRAM."
+	//     (CVAC copies the cdrom file into objstore first, then applies; the
+	//      companion FILE_IGNORED line about cdrom0: means "already staged",
+	//      not failure.) admin/admin login verified over SSH.
+	//
+	// Same delivery pattern as ASAv: plain secret volume (each key a root
+	// file) on a SATA cdrom.
+	return map[string]any{
+			"name": kubeVirtIOSXEBootstrapDiskName,
+			"cdrom": map[string]any{
+				"bus": "sata",
+			},
+		},
+		kubeVirtSecretDiskVolume(kubeVirtIOSXEBootstrapDiskName, secretName),
+		secretData,
+		nil
+}
