+func TestKubeVirtPanosBootstrapUserData(t *testing.T) {
+	initCfg := "type=dhcp-client\nhostname=panos-test\npublic-key=test-key\n"
+	got, err := kubeVirtPanosBootstrapUserData([]byte(initCfg))
+	if err != nil {
+		t.Fatalf("kubeVirtPanosBootstrapUserData() failed: %v", err)
+	}
+
+	gz, err := gzip.NewReader(bytes.NewReader(got))
+	if err != nil {
+		t.Fatalf("kubeVirtPanosBootstrapUserData() did not produce gzip data: %v", err)
+	}
+	defer gz.Close()
+
+	entries := map[string]string{}
+	dirs := map[string]bool{}
+	tr := tar.NewReader(gz)
+	for {
+		hdr, err := tr.Next()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("failed to read bootstrap tar: %v", err)
+		}
+		if hdr.Typeflag == tar.TypeDir {
+			dirs[hdr.Name] = true
+			continue
+		}
+		data, err := io.ReadAll(tr)
+		if err != nil {
+			t.Fatalf("failed to read %s: %v", hdr.Name, err)
+		}
+		entries[hdr.Name] = string(data)
+	}
+
+	for _, dir := range []string{"config/", "license/", "software/", "content/"} {
+		if !dirs[dir] {
+			t.Fatalf("bootstrap archive missing directory %s", dir)
+		}
+	}
+	if got := entries["config/init-cfg.txt"]; got != initCfg {
+		t.Fatalf("bootstrap init-cfg.txt got %q, want %q", got, initCfg)
+	}
+}
