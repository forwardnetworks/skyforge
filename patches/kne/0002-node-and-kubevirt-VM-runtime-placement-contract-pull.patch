+func kubeVirtBootstrapBundleSourceNamespace() string {
+	namespace := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_BOOTSTRAP_SECRET_SOURCE_NAMESPACE"))
+	if namespace == "" {
+		return "skyforge"
+	}
+	return namespace
+}
