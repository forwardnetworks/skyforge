+func kubeVirtSrosClockOffsetSeconds(now time.Time, clockBase time.Time) int64 {
+	if now.IsZero() {
+		now = time.Now()
+	}
+	if clockBase.IsZero() {
+		clockBase = kubeVirtSrosEvalClockBase
+	}
+	offset := clockBase.UTC().Sub(now.UTC()).Round(time.Second) / time.Second
+	return int64(offset)
+}
+
+// kubeVirtSMBIOSHookConfigMapName derives the per-node ConfigMap name that carries a
+// NOS's onDefineDomain hook script. suffix names the NOS lane ("sros-smbios-hook",
+// "vjunos-smbios-hook") so two NOSes on the same node name never collide, and the
+// sha256 tail keeps the result inside the 63-char object-name limit.
+func kubeVirtSMBIOSHookConfigMapName(nodeName, suffix string) string {
+	base := strings.ToLower(strings.TrimSpace(nodeName + "-" + suffix))
+	base = strings.Trim(base, "-")
+	if len(base) <= 63 {
+		return base
+	}
+	sum := sha256.Sum256([]byte(base))
+	return strings.TrimRight(base[:54], "-") + "-" + fmt.Sprintf("%x", sum[:])[:8]
+}
+
+func kubeVirtSrosSMBIOSHookConfigMapName(nodeName string) string {
+	return kubeVirtSMBIOSHookConfigMapName(nodeName, "sros-smbios-hook")
+}
+
+func kubeVirtVJunosSMBIOSHookConfigMapName(nodeName string) string {
+	return kubeVirtSMBIOSHookConfigMapName(nodeName, "vjunos-smbios-hook")
+}
+
+// kubeVirtSMBIOSHookAnnotations renders the KubeVirt hook-sidecar annotation that binds
+// configMapName's onDefineDomain script to the VM. The sidecar contract (args, key,
+// hookPath) is KubeVirt's, identical for every NOS -- only the ConfigMap differs.
+func kubeVirtSMBIOSHookAnnotations(configMapName string) map[string]string {
+	hookSpec := []map[string]any{{
+		"args": []string{"--version", "v1alpha2"},
+		"configMap": map[string]any{
+			"name":     configMapName,
+			"key":      kubeVirtSMBIOSHookKey,
+			"hookPath": "/usr/bin/onDefineDomain",
+		},
+	}}
+	data, err := json.Marshal(hookSpec)
+	if err != nil {
+		return nil
+	}
+	return map[string]string{
+		"hooks.kubevirt.io/hookSidecars": string(data),
+	}
+}
+
+func kubeVirtSrosHookAnnotations(nodeName string) map[string]string {
+	return kubeVirtSMBIOSHookAnnotations(kubeVirtSrosSMBIOSHookConfigMapName(nodeName))
+}
+
+// kubeVirtSMBIOSHookAnnotationsForModel returns the hook-sidecar annotation a model needs,
+// or nil when the model needs no SMBIOS hook at all. ONE dispatch point, so the VM renderer
+// and the ConfigMap lifecycle can never disagree about which models carry a hook.
+func kubeVirtSMBIOSHookAnnotationsForModel(nodeName, model string) map[string]string {
+	switch {
+	case kubeVirtIsSros(model):
+		return kubeVirtSrosHookAnnotations(nodeName)
+	case kubeVirtVJunosNeedsVMXSMBIOS(model):
+		return kubeVirtSMBIOSHookAnnotations(kubeVirtVJunosSMBIOSHookConfigMapName(nodeName))
+	}
+	return nil
+}
