+type kubeVirtVMRenderContract struct {
+	srosMachineUUID string
+	srosClockBase   time.Time
+	// srosNoTFTPServer: ensureKubeVirtBootstrapTFTP created no TFTP server
+	// (nothing to serve), so the VM must not require co-location with one --
+	// a required podAffinity to a pod that does not exist is unschedulable.
+	srosNoTFTPServer bool
+}
+
+// kubeVirtVMRenderContractFor is what CreateKubeVirtVM hands kubeVirtVMObject
+// after ensureKubeVirtBootstrapTFTP: one place, so a test can drive the same
+// seam (a TFTP server that was not created must not be required by the VM).
+func kubeVirtVMRenderContractFor(model, tftpHost, machineUUID string, clockBase time.Time) kubeVirtVMRenderContract {
+	return kubeVirtVMRenderContract{
+		srosMachineUUID:  machineUUID,
+		srosClockBase:    clockBase,
+		srosNoTFTPServer: kubeVirtUsesBootstrapTFTP(model) && strings.TrimSpace(tftpHost) == "",
+	}
+}
+
+func (n *Impl) kubeVirtVMObject(contract ...kubeVirtVMRenderContract) (*unstructured.Unstructured, error) {
+	if n.Proto == nil || n.Proto.Config == nil {
+		return nil, fmt.Errorf("node %q is missing config", n.Name())
+	}
+	var f5Identity kubeVirtF5SlotIdentity
+	if kubeVirtIsF5(n.Proto.Model) {
+		var err error
+		f5Identity, err = kubeVirtF5SlotIdentityFromNode(n.Proto)
+		if err != nil {
+			return nil, err
+		}
+	}
+	var renderContract kubeVirtVMRenderContract
+	if len(contract) > 0 {
+		renderContract = contract[0]
+	}
+	var bootstrapDisk map[string]any
+	var bootstrapVolume map[string]any
+	if n.Proto.Config.ConfigData != nil && !kubeVirtUsesBootstrapTFTP(n.Proto.Model) {
+		// Each VM NOS ingests day-0 in the shape its image consumes. ASAv and
+		// NX-OS use vendor-native plain secret ISOs; IOS-XE and Viptela share
+		// the SATA OpenStack config-drive path; other families keep their
+		// established bespoke transports.
+		configData, err := n.readConfig()
+		if err != nil {
+			return nil, err
+		}
+		if kubeVirtIsF5(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtF5BootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtF5BootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsFortios(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtFortiosBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtFortiosBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsPanos(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtPanosBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtPanosBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsSros(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtSrosBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtSrosBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsASAv(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtASAvBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtASAvBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsIOSXE(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtIOSXEBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtIOSXEBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsViptelaDay0(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtViptelaBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtViptelaBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsVJunos(n.Proto.Model) {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtVJunosBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtVJunosBootstrapDiskAndVolume(secretName, configData)
+		} else if kubeVirtIsA10(n.Proto.Model) {
+			// A10 attaches NO bootstrap disk (see kubeVirtIsA10): day-0 is applied
+			// over network_cli, so leave bootstrapDisk/bootstrapVolume nil.
+		} else if kubeVirtIsDellOS10(n.Proto.Model) {
+			// OS10 attaches NO bootstrap disk (see kubeVirtBootstrapSecretData):
+			// its day-0 arrives over the serial console via the injector pod, not
+			// a disk. Leave bootstrapDisk/bootstrapVolume nil and fall through.
+		} else {
+			secretName := kubeVirtBootstrapSecretName(n.Name(), kubeVirtNxosBootstrapDiskName)
+			bootstrapDisk, bootstrapVolume, _, err = kubeVirtNxosBootstrapDiskAndVolume(secretName, configData)
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	labelsMap := n.kubeVirtLabels()
+	requests := kubeVirtResourceRequests(n.Proto.Model, n.Proto.GetConstraints())
+	diskSpecs := kubeVirtContainerDiskSpecs(n.Proto.Model, n.Proto.Config.Image)
+	disks := make([]any, 0, len(diskSpecs))
+	volumes := make([]any, 0, len(diskSpecs))
+	for _, spec := range diskSpecs {
+		disks = append(disks, map[string]any{
+			"name": spec.Name,
+			"disk": map[string]any{
+				"bus": spec.Bus,
+			},
+		})
+		if kubeVirtIsF5(n.Proto.Model) && spec.Name == "containerdisk" {
+			volumes = append(volumes, map[string]any{
+				"name": spec.Name,
+				"persistentVolumeClaim": map[string]any{
+					"claimName": f5Identity.RootPVC,
+				},
+			})
+			continue
+		}
+		containerDisk := map[string]any{"image": n.Proto.Config.Image}
+		if spec.Path != "" {
+			containerDisk["path"] = spec.Path
+		}
+		volumes = append(volumes, map[string]any{"name": spec.Name, "containerDisk": containerDisk})
+	}
+	for _, spec := range kubeVirtEmptyDiskSpecs(n.Proto.Model) {
+		disks = append(disks, map[string]any{
+			"name": spec.Name,
+			"disk": map[string]any{"bus": spec.Bus},
+		})
+		volumes = append(volumes, map[string]any{
+			"name":      spec.Name,
+			"emptyDisk": map[string]any{"capacity": spec.Capacity},
+		})
+	}
+	if bootstrapDisk != nil {
+		disks = append(disks, bootstrapDisk)
+		volumes = append(volumes, bootstrapVolume)
+	}
+	for _, bundle := range n.Proto.Config.GetBootstrapBundles() {
+		disk, volume, err := kubeVirtBootstrapBundleDiskAndVolume(n.Name(), bundle)
+		if err != nil {
+			return nil, err
+		}
+		disks = append(disks, disk)
+		volumes = append(volumes, volume)
+	}
+	cpuSpec := map[string]any{
+		"cores": kubeVirtCPUCores(n.Proto.Model, n.Proto.GetConstraints()),
+	}
+	if model := kubeVirtCPUModel(n.Proto.Model); model != "" {
+		cpuSpec["model"] = model
+	}
+	devicesSpec := map[string]any{
+		"interfaces": kubeVirtInterfaces(n.Namespace, n.Proto),
+		"disks":      disks,
+	}
+	if kubeVirtIsSros(n.Proto.Model) {
+		// SR-OS 22.x trips during early boot when KubeVirt attaches its default
+		// virtio memory balloon. Its bootrom also requires the legacy PCI device
+		// shape declared by the SR-OS hardware profile.
+		devicesSpec["autoattachMemBalloon"] = false
+	}
+	if kubeVirtUseVirtioTransitional(n.Proto.Model) {
+		devicesSpec["useVirtioTransitional"] = true
+	}
+	if kubeVirtIsVJunosSwitch(n.Proto.Model) {
+		// cdg-acc-sw01 (demo-lab, 2026-09-20): every one of this VM's THREE data
+		// interfaces showed 100% RX drop on the host-side tap (RX dropped ==
+		// RX packets, "missed" counter incrementing -- QEMU/vhost never
+		// draining the queue), reproduced identically across a clean guest
+		// reboot, on IDENTICAL host-side config (resources, CPU model,
+		// virtio-transitional, bridge flags, promiscuity) to a sibling
+		// vjunos-router VM on the SAME node whose own data interfaces work
+		// (a low single-digit-percent baseline drop, not 100%). Only the
+		// SMBIOS persona differs (VM-VEX/EX9214 switch vs VM-VMX/vMX router,
+		// patch 0066). Junos itself reported the symptom from the inside:
+		// `show interfaces ge-0/0/2 extensive` showed "Autonegotiation ...
+		// Incomplete" and non-zero "Input DA rejects" at the physical layer
+		// while the logical (bridged) interface stayed at 0 input -- an
+		// EX9214 PFE that never finished bringing its (virtio-emulated) MACs
+		// out of a half-initialized state. vJunos-switch emulates a
+		// multi-queue ASIC internally; a single-queue virtio-net interface is
+		// the one thing this device profile does differently from every
+		// other KubeVirt device here, including its OWN vjunos-router
+		// sibling, that is a documented libvirt/QEMU/KubeVirt knob rather
+		// than a guess at Junos-internal state.
+		devicesSpec["networkInterfaceMultiqueue"] = true
+	}
+	domainSpec := map[string]any{
+		"cpu": cpuSpec,
+		"resources": map[string]any{
+			"requests": requests,
+		},
+		"devices": devicesSpec,
+	}
+	// Always pin an explicit machine type. kubeVirtMachineType defaults to q35
+	// (kubeVirtDefaultMachineType) for profiles that do not set one, so the VM
+	// CR never inherits the cluster default — Talos-era KubeVirt rejects the
+	// legacy "pc"/i440fx type its default would otherwise supply.
+	domainSpec["machine"] = map[string]any{
+		"type": kubeVirtMachineType(n.Proto.Model),
+	}
+	if firmware := kubeVirtFirmware(n.Proto.Model); firmware != nil {
+		domainSpec["firmware"] = firmware
+	}
+	if kubeVirtIsF5(n.Proto.Model) {
+		firmware, _ := domainSpec["firmware"].(map[string]any)
+		if firmware == nil {
+			firmware = map[string]any{}
+		}
+		firmware["uuid"] = f5Identity.FirmwareUUID
+		domainSpec["firmware"] = firmware
+	}
+	if machineUUID := strings.TrimSpace(renderContract.srosMachineUUID); kubeVirtIsSros(n.Proto.Model) && machineUUID != "" {
+		firmware, _ := domainSpec["firmware"].(map[string]any)
+		if firmware == nil {
+			firmware = map[string]any{}
+		}
+		firmware["uuid"] = machineUUID
+		domainSpec["firmware"] = firmware
+	}
+	if clock := kubeVirtClock(n.Proto.Model, time.Time{}, renderContract.srosClockBase); clock != nil {
+		domainSpec["clock"] = clock
+	}
+	templateMetadata := map[string]any{
+		"labels": labelsToAny(labelsMap),
+	}
+	if hookAnnotations := kubeVirtSMBIOSHookAnnotationsForModel(n.Name(), n.Proto.Model); len(hookAnnotations) > 0 {
+		templateMetadata["annotations"] = labelsToAny(hookAnnotations)
+	}
+
+	vm := &unstructured.Unstructured{
+		Object: map[string]any{
+			"apiVersion": "kubevirt.io/v1",
+			"kind":       "VirtualMachine",
+			"metadata": map[string]any{
+				"name":      n.Name(),
+				"namespace": n.Namespace,
+				"labels":    labelsToAny(labelsMap),
+			},
+			"spec": map[string]any{
+				"runStrategy": "Always",
+				"template": map[string]any{
+					"metadata": templateMetadata,
+					"spec": func() map[string]any {
+						spec := map[string]any{
+							"terminationGracePeriodSeconds": int64(0),
+							"domain":                        domainSpec,
+							"networks":                      kubeVirtNetworks(n.Proto),
+							"volumes":                       volumes,
+						}
+						if tolerations := kubeVirtTolerations(); len(tolerations) > 0 {
+							spec["tolerations"] = tolerations
+						}
+						if ns := kubeVirtNodeSelector(n.Proto.Model); len(ns) > 0 {
+							spec["nodeSelector"] = labelsToAny(ns)
+						}
+						if kubeVirtUsesBootstrapTFTP(n.Proto.Model) && !renderContract.srosNoTFTPServer {
+							spec["affinity"] = kubeVirtBootstrapTFTPPodAffinity(n.Name())
+						}
+						// IO-HEAVY PLACEMENT. THE ONLY site that applies it,
+						// and it needs NO model check.
+						//
+						// "IO-heavy" means exactly "boots a KubeVirt disk" --
+						// that is the single predicate the server builds its
+						// heavy set from. Reaching this function already proves
+						// it: UsesKubeVirtVM() gated on imageLooksLikeKubeVirtDisk(),
+						// and Impl.Create() sends only those nodes here. So every
+						// VM built here is IO-heavy by definition.
+						//
+						// DO NOT reintroduce a model list. The first attempt
+						// matched n.Proto.Model against device keys exported by
+						// the server, and the two are different namespaces:
+						// netlab's KNE_NODE_MAP writes model "vmanage" for the
+						// device key "cisco_sdwan-manager". They never matched,
+						// so vManage -- the appliance this whole policy exists
+						// for -- was never steered.
+						//
+						// MERGE, never assign: bootstrap-TFTP models already
+						// wrote a podAffinity into spec["affinity"] two lines
+						// up, and a bare assignment would silently drop it.
+						// SCOPED 2026-09-23 (owner): only models whose profile
+						// declares IOHeavy -- vManage and Versa Director -- are
+						// steered onto the SSD node. Every other VM gets no SSD
+						// preference, so the fast node stays free for the
+						// appliances whose first boot actually writes tens of GB.
+						if nodeAffinity := KNEIOHeavyNodeAffinityUnstructured(); nodeAffinity != nil && kubeVirtHardwareProfileFor(n.Proto.Model, "").IOHeavy {
+							affinity, _ := spec["affinity"].(map[string]any)
+							if affinity == nil {
+								affinity = map[string]any{}
+							}
+							affinity["nodeAffinity"] = nodeAffinity
+							spec["affinity"] = affinity
+						}
+						// Applies to every KubeVirt model, not just the IO-heavy
+						// subset above -- harmless for a singleton model, since
+						// the anti-affinity term never finds a conflicting pod
+						// to repel. See KNESameModelPodAntiAffinity's doc comment.
+						if podAntiAffinity := KNESameModelPodAntiAffinityUnstructured(n.Proto.Model); podAntiAffinity != nil {
+							affinity, _ := spec["affinity"].(map[string]any)
+							if affinity == nil {
+								affinity = map[string]any{}
+							}
+							affinity["podAntiAffinity"] = podAntiAffinity
+							spec["affinity"] = affinity
+						}
+						if probe := kubeVirtMgmtLivenessProbe(n.Proto.Model); probe != nil {
+							spec["livenessProbe"] = probe
+						}
+						return spec
+					}(),
+				},
+			},
+		},
+	}
+	return vm, nil
+}
+
+func (n *Impl) CreateKubeVirtVM(ctx context.Context) error {
+	if err := n.ensureImagePullSecret(ctx); err != nil {
+		return err
+	}
+	bootstrapSecretName, bootstrapSecretData, err := n.kubeVirtBootstrapSecretData(ctx)
+	if err != nil {
+		return err
+	}
+	labelsMap := n.kubeVirtLabels()
+	var tftpHost string
+	var machineUUID string
+	var licenseClockBase time.Time
+	var hasBootstrapConfig bool
+	if kubeVirtUsesBootstrapTFTP(n.Proto.Model) {
+		configData, err := n.readConfig()
+		if err != nil {
+			return err
+		}
+		hasBootstrapConfig = len(bytes.TrimSpace(configData)) > 0
+		tftpHost, machineUUID, licenseClockBase, err = n.ensureKubeVirtBootstrapTFTP(ctx, labelsMap, configData)
+		if err != nil {
+			return err
+		}
+	}
+	if err := n.ensureKubeVirtSMBIOSHook(ctx, labelsMap, tftpHost, hasBootstrapConfig, machineUUID); err != nil {
+		return err
+	}
+	vm, err := n.kubeVirtVMObject(kubeVirtVMRenderContractFor(n.Proto.Model, tftpHost, machineUUID, licenseClockBase))
+	if err != nil {
+		return err
+	}
+
+	dc, err := dynamic.NewForConfig(n.RestConfig)
+	if err != nil {
+		return err
+	}
+	if err := n.ensureKubeVirtMeshnetNAD(ctx, dc); err != nil {
+		return err
+	}
+	if err := n.ensureKubeVirtBootstrapSecret(ctx, bootstrapSecretName, bootstrapSecretData, labelsMap); err != nil {
+		return err
+	}
+	if err := n.ensureKubeVirtBootstrapBundles(ctx, labelsMap); err != nil {
+		return err
+	}
+
+	resource := dc.Resource(kubeVirtVMGVR).Namespace(n.Namespace)
+	created := false
+	for attempt := 1; attempt <= 3; attempt++ {
+		if _, err := resource.Create(ctx, vm, metav1.CreateOptions{}); err != nil {
+			if apierrors.IsAlreadyExists(err) {
+				if _, err := resource.Update(ctx, vm, metav1.UpdateOptions{}); err != nil {
+					return err
+				}
+				created = true
+				break
+			}
+			if !isRetryableKubeVirtAdmissionError(err) || attempt == 3 {
+				return err
+			}
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(kubeVirtAdmissionRetryBackoff(attempt)):
+			}
+			continue
+		}
+		created = true
+		break
+	}
+	if !created {
+		return nil
+	}
+	// dellos10 (vr-ftosv) carries no bootstrap disk; its netlab day-0 config is
+	// injected over the serial console by a per-node companion pod once the VM boots.
+	// No-op for every other model. Runs after the VM exists so the injector's
+	// `virtctl console` target is present.
+	if kubeVirtIsDellOS10(n.Proto.Model) && n.Proto.Config != nil && n.Proto.Config.ConfigData != nil {
+		configData, err := n.readConfig()
+		if err != nil {
+			return err
+		}
+		if err := n.ensureKubeVirtDellOS10SerialInjector(ctx, labelsMap, configData); err != nil {
+			return err
+		}
+	}
+	// Viptela (vEdge/vSmart) ALSO attaches a cloud-init config-drive, but that
+	// drive is never consumed on this image: /etc/sv/cloud-init/run exits early
+	// on /etc/viptela/cdb_init_done, which /etc/sv/confd-p1/finish writes, and
+	// runsvdir starts both in parallel with no ordering. Measured live: one
+	// `cloud-init init --local` line on the console and nothing after it, VPN
+	// 512 unconfigured, port 22 closed for 900s. The drive is left attached
+	// (harmless, and it works if cloud-init ever wins the race); the serial
+	// injector is the path that actually lands the config. Runs after the VM
+	// exists so `virtctl console` has a target.
+	if kubeVirtIsViptelaSerialInject(n.Proto.Model) && n.Proto.Config != nil && n.Proto.Config.ConfigData != nil {
+		configData, err := n.readConfig()
+		if err != nil {
+			return err
+		}
+		if err := n.ensureKubeVirtViptelaSerialInjector(ctx, labelsMap, configData); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (n *Impl) kubeVirtPods(ctx context.Context) ([]*corev1.Pod, error) {
+	selector := labels.SelectorFromSet(map[string]string{
+		"vm.kubevirt.io/name": n.Name(),
+	})
+	podList, err := n.KubeClient.CoreV1().Pods(n.Namespace).List(ctx, metav1.ListOptions{
+		LabelSelector: selector.String(),
+	})
+	if err != nil {
+		return nil, err
+	}
+	if len(podList.Items) == 0 {
+		return nil, nil
+	}
+	items := make([]corev1.Pod, len(podList.Items))
+	copy(items, podList.Items)
+	var active []corev1.Pod
+	for _, pod := range items {
+		if pod.DeletionTimestamp != nil {
+			continue
+		}
+		if pod.Status.Phase == corev1.PodFailed || pod.Status.Phase == corev1.PodSucceeded {
+			continue
+		}
+		active = append(active, pod)
+	}
+	items = active
+	sort.Slice(items, func(i, j int) bool {
+		return items[i].CreationTimestamp.After(items[j].CreationTimestamp.Time)
+	})
+	out := make([]*corev1.Pod, 0, len(items))
+	for i := range items {
+		pod := items[i]
+		out = append(out, &pod)
+	}
+	return out, nil
+}
+
+func labelsToAny(in map[string]string) map[string]any {
+	out := map[string]any{}
+	for key, value := range in {
+		out[key] = value
+	}
+	return out
+}
+
+func kubeVirtMeshnetNADConfig() map[string]any {
+	cfg := map[string]any{
+		"cniVersion":           "0.3.0",
+		"name":                 "meshnet",
+		"type":                 "meshnet",
+		"kubevirtSecondary":    true,
+		"secondaryWaitSeconds": 180,
+		"ipam":                 map[string]any{},
+		"dns":                  map[string]any{},
+	}
+	// THE FABRIC MTU HAS TO BE IN HERE, OR EVERY VM LINK SILENTLY RUNS 1450.
+	//
+	// A KubeVirt VM takes its meshnet wires through THIS NetworkAttachmentDefinition,
+	// not through /etc/cni/net.d's meshnet conflist. The conflist carries
+	// "fabricMTU": 8950. This config carried no fabricMTU at all, so the plugin
+	// fell back to its 1450 default -- and since a veth pair is created ONCE
+	// with a single MTU, BOTH ends landed at 1450, the container end included.
+	//
+	// MEASURED 2026-09-08 on demo-lab: dc-sdwan-sw01, a CONTAINER, held
+	// eth1/eth4/eth6 at 8950 and eth3/eth5 at 1450 -- and the 1450 pair were
+	// exactly its links to VM peers. Same pod, same node, two different MTUs,
+	// decided by what was on the other end.
+	//
+	// It surfaced three layers away, looking nothing like a CNI config gap:
+	// IOS-XE clamped its vNIC below the 1500 its interface claimed
+	// ("%VXE_VNIC_IF-4-MTUERROR ... setting MTU minimum to 1450"), OSPF padded
+	// DBD to the configured MTU, EXSTART never completed ("Too many
+	// retransmissions"), no site prefix reached OMP, and 6 of 7 demo-lab overlay
+	// paths were dead while every SD-WAN control-plane gate read PROVEN --
+	// because DTLS control connections PMTU-discover and use small packets.
+	//
+	// ABSENT MEANS ABSENT. If the value is not in the environment we omit the
+	// key rather than writing a guess: the plugin's own default then applies,
+	// which is exactly today's behaviour, and a wrong number written here would
+	// be far harder to spot than a missing one.
+	if mtu := kubeVirtMeshnetFabricMTU(); mtu > 0 {
+		cfg["fabricMTU"] = mtu
+	}
+	return cfg
+}
+
+// kubeVirtMeshnetFabricMTU reads the fabric MTU the platform resolved for this
+// deployment. The platform sets MESHNET_FABRIC_MTU on the runtime from the same
+// value it refuses to assume elsewhere (it will not default to 1450, because
+// doing so silently pins every lab to one node), so the VM path and the
+// container path end up reading ONE number from ONE source.
+func kubeVirtMeshnetFabricMTU() int {
+	raw := strings.TrimSpace(os.Getenv("MESHNET_FABRIC_MTU"))
+	if raw == "" {
+		return 0
+	}
+	mtu, err := strconv.Atoi(raw)
+	if err != nil || mtu < 1280 || mtu > 65535 {
+		// A malformed value is not a reason to invent one.
+		return 0
+	}
+	return mtu
+}
+
+func (n *Impl) ensureKubeVirtMeshnetNAD(ctx context.Context, dc dynamic.Interface) error {
+	if len(kubeVirtDataInterfaces(n.Proto)) == 0 {
+		return nil
+	}
+	config, err := json.Marshal(kubeVirtMeshnetNADConfig())
+	if err != nil {
+		return err
+	}
+	nad := &unstructured.Unstructured{
+		Object: map[string]any{
+			"apiVersion": "k8s.cni.cncf.io/v1",
+			"kind":       "NetworkAttachmentDefinition",
+			"metadata": map[string]any{
+				"name":      "meshnet",
+				"namespace": n.Namespace,
+				"labels": map[string]any{
+					"kne/topologyOwner": n.Namespace,
+				},
+			},
+			"spec": map[string]any{
+				"config": string(config),
+			},
+		},
+	}
+	resource := dc.Resource(networkAttachmentDefinitionGVR).Namespace(n.Namespace)
+	if _, err := resource.Create(ctx, nad, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		// CREATE-ONCE IS NOT ENSURE. This returned nil on AlreadyExists, so a
+		// namespace that already held a NAD kept whatever config it was first
+		// created with -- FOREVER, across every later deploy of that lab.
+		//
+		// MEASURED 2026-09-08: demo-lab's namespace held a NAD with no fabricMTU,
+		// written before this config carried one. Redeploying with the fixed
+		// binary changed nothing, because this function saw AlreadyExists and
+		// returned success. The fix looked inert and the evidence said the code
+		// was correct -- the object simply never got rewritten. The stale NAD had
+		// to be deleted by hand for the corrected config to take.
+		//
+		// It is the same shape as the bug this NAD change exists to fix
+		// (meshnet adopting an existing wire without checking its MTU): treat
+		// "it is already there" as "it is already right". A lab namespace
+		// outlives many deploys, so anything created once and never reconciled
+		// pins that lab to whatever was true the first time it ran.
+		existing, getErr := resource.Get(ctx, "meshnet", metav1.GetOptions{})
+		if getErr != nil {
+			return getErr
+		}
+		if current, _, _ := unstructured.NestedString(existing.Object, "spec", "config"); current == string(config) {
+			return nil // already what we want; do not churn the object
+		}
+		if err := unstructured.SetNestedField(existing.Object, string(config), "spec", "config"); err != nil {
+			return err
+		}
+		if _, err := resource.Update(ctx, existing, metav1.UpdateOptions{}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
