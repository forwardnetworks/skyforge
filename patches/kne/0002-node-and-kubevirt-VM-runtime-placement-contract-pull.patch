+	if got != kubeVirtSrosSystemBaseMAC("sros1") {
+		t.Fatal("SR-OS system base MAC must be stable for the same node name")
+	}
+	if got == kubeVirtSrosSystemBaseMAC("sros2") {
+		t.Fatal("SR-OS system base MAC should differ across node names")
+	}
+}
