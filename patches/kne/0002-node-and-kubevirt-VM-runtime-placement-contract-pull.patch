+func TestKubeVirtVJunosDay0Contract(t *testing.T) {
+	for _, model := range []string{"vjunos-router", "vjunos-switch", "VJunos-Router"} {
+		if !kubeVirtIsVJunos(model) {
+			t.Fatalf("kubeVirtIsVJunos(%q) = false, want true", model)
+		}
+		if got := kubeVirtBootstrapSecretKey(model); got != "juniper.conf" {
+			t.Fatalf("kubeVirtBootstrapSecretKey(%q) = %q, want juniper.conf", model, got)
+		}
+	}
+	for _, model := range []string{"nxos", "sros", "panos", "vmx"} {
+		if kubeVirtIsVJunos(model) {
+			t.Fatalf("kubeVirtIsVJunos(%q) = true, want false", model)
+		}
+	}
+
+	disk, volume, data, err := kubeVirtVJunosBootstrapDiskAndVolume("vjt1-vjunos-bootstrap", []byte("system { host-name vjt1; }"))
+	if err != nil {
+		t.Fatalf("kubeVirtVJunosBootstrapDiskAndVolume() error: %v", err)
+	}
+	cdrom, ok := disk["cdrom"].(map[string]any)
+	if !ok {
+		t.Fatalf("vjunos bootstrap disk is not a cdrom: %#v", disk)
+	}
+	if cdrom["bus"] != "sata" {
+		t.Fatalf("vjunos cdrom bus = %v, want sata", cdrom["bus"])
+	}
+	// A secret volume renders as iso9660 with key->file at the ROOT. A
+	// cloudInitConfigDrive would bury it at openstack/latest/user_data, which
+	// rc.juniper never reads.
+	if _, ok := volume["secret"]; !ok {
+		t.Fatalf("vjunos bootstrap volume is not a secret disk: %#v", volume)
+	}
+	if _, bad := volume["cloudInitConfigDrive"]; bad {
+		t.Fatal("vjunos bootstrap volume must NOT be cloudInitConfigDrive")
+	}
+	if !bytes.HasSuffix(data, []byte("\n")) {
+		t.Fatalf("vjunos day-0 payload must end in a newline, got %q", data)
+	}
+
+	if _, _, _, err := kubeVirtVJunosBootstrapDiskAndVolume("vjt1", []byte("   ")); err == nil {
+		t.Fatal("empty vjunos startup-config must be rejected")
+	}
+}
