+func TestKubeVirtIOSXEBootstrapSecretKeyFollowsContent(t *testing.T) {
+	cvac := []byte("hostname r1\n!\ninterface GigabitEthernet1\n ip address dhcp\n")
+	if got := kubeVirtBootstrapSecretKeyFor("cat8000v", cvac); got != kubeVirtIOSXECvacFileName {
+		t.Fatalf("CVAC startup-config keyed %q, want %q", got, kubeVirtIOSXECvacFileName)
+	}
+	mime := []byte("Content-Type: multipart/mixed; boundary=\"==BOUNDARY==\"\nMIME-Version: 1.0\n\n--==BOUNDARY==\n#cloud-config\nvinitparam:\n - otp : x\n")
+	if got := kubeVirtBootstrapSecretKeyFor("cat8000v", mime); got != kubeVirtIOSXESDWANBootstrapFileName {
+		t.Fatalf("cloud-init bootstrap keyed %q, want %q", got, kubeVirtIOSXESDWANBootstrapFileName)
+	}
+	bare := []byte("#cloud-config\nvinitparam:\n - otp : x\n")
+	if got := kubeVirtBootstrapSecretKeyFor("cat8000v", bare); got != kubeVirtIOSXESDWANBootstrapFileName {
+		t.Fatalf("bare #cloud-config keyed %q, want %q", got, kubeVirtIOSXESDWANBootstrapFileName)
+	}
+	// The content rule is IOS-XE only: a Viptela seed keeps the generic key
+	// whatever it starts with, and the model-only accessor is unchanged.
+	if got := kubeVirtBootstrapSecretKeyFor("vedge", mime); got != kubeVirtBootstrapSecretDataKey {
+		t.Fatalf("vedge keyed %q, want %q", got, kubeVirtBootstrapSecretDataKey)
+	}
+	if got := kubeVirtBootstrapSecretKey("cat8000v"); got != kubeVirtIOSXECvacFileName {
+		t.Fatalf("model-only key %q, want %q", got, kubeVirtIOSXECvacFileName)
+	}
+}
