@@ -0,0 +1,355 @@
+package node
+
+import (
+	"regexp"
+	"strings"
+	"testing"
+)
+
+func TestKubeVirtIsViptelaSerialInject(t *testing.T) {
+	for _, model := range []string{"vedge", "vSmart", "  VEDGE  ", "vmanage", "vbond", "VBOND", "validator"} {
+		if !kubeVirtIsViptelaSerialInject(model) {
+			t.Errorf("expected %q to use the serial injector", model)
+		}
+	}
+	for _, model := range []string{"eos", "cat8000v", ""} {
+		if kubeVirtIsViptelaSerialInject(model) {
+			t.Errorf("expected %q NOT to use the serial injector", model)
+		}
+	}
+}
+
+func TestKubeVirtViptelaInjectorResourceNameIsDNSSafe(t *testing.T) {
+	long := strings.Repeat("n", 90)
+	for _, node := range []string{"ve1", "VS1", long} {
+		got := kubeVirtViptelaInjectorResourceName(node)
+		if len(got) > 63 {
+			t.Errorf("%q -> %q is %d chars, over the 63-char limit", node, got, len(got))
+		}
+		if got != strings.ToLower(got) {
+			t.Errorf("%q -> %q is not lowercase", node, got)
+		}
+		if strings.HasSuffix(got, "-") {
+			t.Errorf("%q -> %q ends in a hyphen", node, got)
+		}
+	}
+	// Distinct nodes must not collide after truncation.
+	a := kubeVirtViptelaInjectorResourceName(long + "a")
+	b := kubeVirtViptelaInjectorResourceName(long + "b")
+	if a == b {
+		t.Errorf("two distinct long node names collided: %q", a)
+	}
+}
+
+func TestKubeVirtViptelaInjectorRoleIsLeastPrivilege(t *testing.T) {
+	rules := kubeVirtViptelaInjectorRoleRules()
+	if len(rules) == 0 {
+		t.Fatal("injector role has no rules")
+	}
+	granted := map[string]map[string]bool{}
+	for _, r := range rules {
+		for _, res := range r.Resources {
+			if granted[res] == nil {
+				granted[res] = map[string]bool{}
+			}
+			for _, v := range r.Verbs {
+				granted[res][v] = true
+			}
+		}
+	}
+
+	// The injector reaches ttyS0 through the virt-launcher pod, so it needs to
+	// exec. `pods/exec` legitimately requires the create verb -- that is how the
+	// exec subresource is invoked, not a mutation of anything.
+	if !granted["pods/exec"]["create"] {
+		t.Error("injector cannot exec into virt-launcher, so it cannot reach the console")
+	}
+	if !granted["pods"]["get"] && !granted["pods"]["list"] {
+		t.Error("injector cannot find the virt-launcher pod backing its VMI")
+	}
+
+	// It must never be able to destroy or rewrite the lab it is configuring.
+	for res, verbs := range granted {
+		if res == "pods/exec" {
+			continue
+		}
+		for _, forbidden := range []string{"delete", "deletecollection", "patch", "update", "create"} {
+			if verbs[forbidden] {
+				t.Errorf("injector role grants %q on %q, which it must not have", forbidden, res)
+			}
+		}
+	}
+
+	// The console subresource is deliberately NOT granted: KubeVirt serves it
+	// only while the VMI is Running, and these NOS images never leave Scheduled.
+	// If it reappears here, someone has gone back to the path that cannot work.
+	if granted["virtualmachineinstances/console"] != nil {
+		t.Error("injector requests the console subresource again; that path EOFs on Scheduled VMIs")
+	}
+}
+
+// The whole point of this delivery channel is that netlab's config reaches the
+// device UNCHANGED. Guard the properties that would silently corrupt it.
+func TestKubeVirtViptelaInjectorScriptPastesVerbatim(t *testing.T) {
+	s := kubeVirtViptelaInjectorScript
+
+	// It must not reformat, sort, strip or otherwise normalise the config that
+	// it PASTES. The paste loop is apply_config; other functions in the script
+	// may strip a line to match a marker (cloud_config_overlay does, and only
+	// compares the stripped copy), so the banned-pattern check is scoped to the
+	// paste loop rather than the whole script.
+	paste := pythonFuncBody(t, s, "apply_config")
+	for _, banned := range []string{".strip()", ".sort(", ".upper()", ".lower()", ".replace("} {
+		if strings.Contains(paste, "line"+banned) {
+			t.Errorf("paste loop appears to mutate config lines via %q", banned)
+		}
+	}
+	// The overlay that cloud_config_overlay extracts is sliced from the raw line,
+	// so what reaches apply_config is the rendered text, not a stripped copy.
+	if !strings.Contains(s, "out.append(line[content_indent:])") {
+		t.Error("overlay extraction no longer slices content lines verbatim")
+	}
+	// Blank lines and `!` separators are meaningful in the Viptela hierarchy, so
+	// the paste loop must not skip empties.
+	if strings.Contains(s, "if not line: continue") || strings.Contains(s, "if not line.strip(): continue") {
+		t.Error("script skips blank config lines; `!` and blanks are structural in Viptela CLI")
+	}
+	if !strings.Contains(s, "child.sendline(line)") {
+		t.Error("script does not send config lines verbatim")
+	}
+	// Guard the transport itself: virtctl console cannot work here. Match the
+	// BINARY NAME anywhere, not a formatted call expression -- the spawn is
+	// multi-line, so `pexpect.spawn("virtctl"` would never appear even if
+	// someone switched back, and the guard would pass while the injector broke.
+	if strings.Contains(s, "\"virtctl\"") {
+		t.Error("script invokes virtctl; that EOFs while the VMI sits in Scheduled")
+	}
+	if !strings.Contains(s, "virt-serial0") {
+		t.Error("script no longer reaches the virt-launcher serial socket")
+	}
+	// Password rotation on first login would lock netlab-initial out, since the
+	// day-0 declares admin/admin and netlab authenticates with it afterwards.
+	if !strings.Contains(s, "child.sendline(PASS)") {
+		t.Error("script does not reuse the declared password on a forced change")
+	}
+	// A commit that is not verified is a config that silently did not land.
+	if !strings.Contains(s, "commit complete") {
+		t.Error("script does not confirm the commit succeeded")
+	}
+	// The operational prompt must not also match the config prompt, or the paste
+	// loop mistakes "(config)#" for the top level on its very first line.
+	if !strings.Contains(s, `PROMPT        = r"[A-Za-z0-9._-]+#(?!\S)"`) {
+		t.Error("operational prompt pattern changed; confirm it cannot match (config)#")
+	}
+}
+
+// The embedded script lives in a Go RAW string, which is backtick-delimited, so
+// it cannot contain a backtick and cannot splice Go constants with `+ x +`. A
+// broken splice still COMPILES -- it just becomes literal text in the script --
+// and that shipped once: the config path became
+// "/config/ + kubeVirtViptelaInjectorConfigFileName + " and the pod died at
+// runtime on FileNotFoundError. Unit tests passed the whole time.
+func TestKubeVirtViptelaInjectorScriptHasNoUnresolvedGoSplice(t *testing.T) {
+	s := kubeVirtViptelaInjectorScript
+	if strings.Contains(s, "kubeVirtViptela") {
+		t.Error("script contains an unresolved Go identifier; a raw-string splice is broken")
+	}
+	if strings.ContainsRune(s, '\u0060') { // U+0060 GRAVE ACCENT
+		t.Error("script contains a backtick; that would terminate the Go raw string")
+	}
+	// The path the pod reads must match the Secret key the pod mounts.
+	if !strings.Contains(s, "/config/"+kubeVirtViptelaInjectorConfigFileName) {
+		t.Errorf("script does not read /config/%s, so it cannot find the config the pod mounts",
+			kubeVirtViptelaInjectorConfigFileName)
+	}
+}
+
+// 20.7.1 forces an initial admin password on first login, with wording that
+// matches none of the usual phrasings. Captured verbatim from a live console:
+//
+//	Welcome to Viptela CLI
+//	You must set an initial admin password.
+//	Password:
+//	Re-enter password:
+//
+// Missing it was the entire failure -- the injector authenticated and then sat
+// at an unrecognised prompt until timeout, and a botched exchange can drop the
+// session into a SHELL ("ve1:~$"), which does not look like a NOS problem at all.
+func TestKubeVirtViptelaInjectorHandlesForcedInitialPassword(t *testing.T) {
+	s := kubeVirtViptelaInjectorScript
+	if !strings.Contains(s, "you must set an initial admin password") {
+		t.Error("script does not recognise the forced initial-password banner")
+	}
+	if !strings.Contains(s, "re-?enter password:") {
+		t.Error("script does not answer the Re-enter password: confirmation")
+	}
+	// Both the first-login and already-provisioned paths must exist, or a rerun
+	// against a device whose password is already set hangs.
+	for _, want := range []string{"CONFIG_PROMPT, PROMPT", "wait_login"} {
+		if !strings.Contains(s, want) {
+			t.Errorf("script is missing %q; the already-provisioned path is broken", want)
+		}
+	}
+}
+
+// Confirmed against a live vEdge 20.7.1: `config terminal` enters config mode,
+// the netlab running-config format pastes verbatim (including bare `!`), and
+// `commit` answers "Commit complete."
+func TestKubeVirtViptelaInjectorUsesTheConfirmedCliDialogue(t *testing.T) {
+	s := kubeVirtViptelaInjectorScript
+	if !strings.Contains(s, "config terminal") {
+		t.Error("script does not enter config mode the way the device accepts")
+	}
+	if !strings.Contains(s, "commit complete") {
+		t.Error("script does not confirm the commit the way the device reports it")
+	}
+	// The operational prompt must not match "vedge(config-system)#", whose last
+	// char before # is ')'.
+	re := regexp.MustCompile(`\[A-Za-z0-9._-\]\+#\(\?!`)
+	if !re.MatchString(s) {
+		t.Error("operational prompt lost its guard against matching a (config-*)# prompt")
+	}
+}
+
+// A companion pod must never be mistaken for the NOS node it configures.
+func TestKubeVirtViptelaInjectorLabelsCarryNoNodeIdentity(t *testing.T) {
+	// A realistic node label set, including every key the server maps to a node.
+	nodeLabels := map[string]string{
+		"kne/topologyNode":                  "ve1",
+		"kne.example.com/node-name": "ve1",
+		"vm.kubevirt.io/name":               "ve1",
+		"vmi.kubevirt.io/id":                "ve1",
+		"kubevirt.io/domain":                "ve1",
+		"topo":                              "user-alice-lab",
+		"app":                               "ve1",
+	}
+	got := kubeVirtViptelaInjectorLabels("ve1", nodeLabels)
+
+	for _, banned := range kubeVirtViptelaInjectorNodeIdentityLabels {
+		if _, present := got[banned]; present {
+			t.Errorf("injector pod carries node-identity label %q; a helper crash would be "+
+				"reported as a NOS node startup failure", banned)
+		}
+	}
+	if got["app"] == "ve1" {
+		t.Error("injector pod kept the node's app label")
+	}
+	// Ownership/cleanup labels must survive, or the companion becomes orphan-prone.
+	if got["topo"] != "user-alice-lab" {
+		t.Error("injector pod lost the topology label it needs for cleanup")
+	}
+	if got["skyforge.example.com/injector-for"] != "ve1" {
+		t.Error("injector pod does not record which node it belongs to")
+	}
+	// The caller's map must not be mutated.
+	if nodeLabels["kne/topologyNode"] != "ve1" {
+		t.Error("injector mutated the caller's label map")
+	}
+}
+
+func TestKubeVirtViptelaInjectorLoginMatchesDay0Credentials(t *testing.T) {
+	// netlab's day-0 template declares `aaa / user admin / password admin`, and
+	// defaults.yml sets ansible_user/ansible_ssh_pass to the same. If these
+	// drift, the injector logs into a device netlab can no longer reach.
+	if kubeVirtViptelaInjectorLoginUser != "admin" || kubeVirtViptelaInjectorLoginPass != "admin" {
+		t.Errorf("injector credentials %q/%q no longer match the netlab day-0 declaration",
+			kubeVirtViptelaInjectorLoginUser, kubeVirtViptelaInjectorLoginPass)
+	}
+}
+
+// THE GUARD MUST MATCH WHAT THE DEVICE ACTUALLY SAYS.
+//
+// vManage 20.18.4 prints "The account is locked due to 5 failed logins." The
+// pattern this guard carried until 2026-09-09 was "account locked due to",
+// with no "is", so it matched nothing on that release and the lockout guard
+// never fired: on demo-lab (c83e1600, 2026-09-08) the injector read the sentence
+// 43 times and kept retrying, while its own FATAL message appears zero times in
+// the same Loki window. Both wordings are asserted, because the 20.7.1 form is
+// still in the field.
+func TestKubeVirtViptelaInjectorLockoutPatternMatchesTheDevice(t *testing.T) {
+	m := regexp.MustCompile(`(?m)^LOCKED_OUT\s*=\s*r"(.*)"\s*$`).FindStringSubmatch(kubeVirtViptelaInjectorScript)
+	if m == nil {
+		t.Fatal("LOCKED_OUT is not declared in the injector script")
+	}
+	re, err := regexp.Compile(m[1])
+	if err != nil {
+		t.Fatalf("LOCKED_OUT does not compile: %v", err)
+	}
+	for _, tc := range []struct {
+		name string
+		line string
+	}{
+		// Captured verbatim from the demo-lab vmanage guest console, 2026-09-08
+		// 16:16:54 UTC.
+		{"vmanage 20.18.4", "The account is locked due to 5 failed logins."},
+		// The wording the pattern was originally written for.
+		{"viptela 20.7.1", "account locked due to 7 failed logins"},
+	} {
+		if !re.MatchString(tc.line) {
+			t.Errorf("LOCKED_OUT %q does not match the %s console line %q", m[1], tc.name, tc.line)
+		}
+	}
+
+	u := regexp.MustCompile(`(?m)^UNLOCK_IN\s*=\s*r"(.*)"\s*$`).FindStringSubmatch(kubeVirtViptelaInjectorScript)
+	if u == nil {
+		t.Fatal("UNLOCK_IN is not declared: the injector cannot read how long the lock has left")
+	}
+	ure, err := regexp.Compile(u[1])
+	if err != nil {
+		t.Fatalf("UNLOCK_IN does not compile: %v", err)
+	}
+	if got := ure.FindStringSubmatch("(10 minutes left to unlock)"); got == nil || got[1] != "10" {
+		t.Errorf("UNLOCK_IN %q did not read the countdown off the console line, got %v", u[1], got)
+	}
+}
+
+// A BARE NEWLINE AT A getty LOGIN PROMPT IS A FAILED LOGIN.
+//
+// wait_login used to open every iteration with child.sendline(""), and login()
+// calls wait_login once per attempt -- so a single run could spend all five
+// failed logins (the lock threshold on 20.18.4) before offering one credential.
+// Measured on demo-lab 2026-09-08: the first credential the injector ever typed
+// met an already-locked account, and the declared password was correct all
+// along. The nudge is now the answer to a TIMEOUT, never the opening move.
+func TestKubeVirtViptelaInjectorDoesNotNudgeBeforeListening(t *testing.T) {
+	i := strings.Index(kubeVirtViptelaInjectorScript, "def wait_login(child):")
+	if i < 0 {
+		t.Fatal("wait_login is not declared in the injector script")
+	}
+	j := strings.Index(kubeVirtViptelaInjectorScript[i:], "\ndef settle_after_password(")
+	if j < 0 {
+		t.Fatal("could not bound wait_login")
+	}
+	body := kubeVirtViptelaInjectorScript[i : i+j]
+	k := strings.Index(body, "while time.time() < deadline:")
+	if k < 0 {
+		t.Fatal("wait_login has no deadline loop")
+	}
+	rest := body[k+len("while time.time() < deadline:"):]
+	// The first statement of the loop must not be an unconditional newline.
+	if strings.HasPrefix(strings.TrimLeft(rest, " \n"), `child.sendline("")`) {
+		t.Error("wait_login still opens its loop with an unconditional bare newline: " +
+			"that submits an empty username and burns a failed login on every attempt")
+	}
+	if !strings.Contains(body, "nudge = True") || !strings.Contains(body, "if nudge:") {
+		t.Error("wait_login no longer gates its nudge on a quiet console")
+	}
+	if !strings.Contains(body, "LOCKED_OUT") {
+		t.Error("wait_login does not watch for a locked account before typing a credential")
+	}
+}
+
+// pythonFuncBody returns the source of the top-level python `def name(` in the
+// injector script, up to the next top-level definition.
+func pythonFuncBody(t *testing.T, script, name string) string {
+	t.Helper()
+	start := strings.Index(script, "\ndef "+name+"(")
+	if start < 0 {
+		t.Fatalf("injector script has no def %s", name)
+	}
+	rest := script[start+1:]
+	if end := strings.Index(rest[1:], "\ndef "); end >= 0 {
+		return rest[:end+1]
+	}
+	return rest
+}
diff --git a/topo/node/kubevirt_vmanage_disks_test.go b/topo/node/kubevirt_vmanage_disks_test.go
new file mode 100644
index 0000000..5f628ae
--- /dev/null
+++ b/topo/node/kubevirt_vmanage_disks_test.go
@@ -0,0 +1,126 @@
+package node
+
+import "testing"
+
+// vManage's containerDisk image carries TWO qcow2 files -- the real disk and a
+// blank 100GiB virtiob.qcow2. KubeVirt refuses a containerDisk whose /disk
+// holds more than one file:
+//
+//	failed to find disk file from ImageVolume: more than one file found in
+//	folder /var/run/kubevirt-image-volume/disk_0/disk, only one disk is allowed
+//
+// With no explicit path the VM never boots -- measured 2026-08-27, the launcher
+// died with exit 2 before qemu started and KubeVirt restarted it in a loop.
+// This is specifically about images with MORE THAN ONE disk file under /disk
+// (vmanage, nxos, dellos10 all declare explicit paths for this reason).
+// Single-disk images whose file lives under /disk (panos, a10, asav) use
+// Path: "" and let KubeVirt auto-discover it. FortiOS is the outlier that
+// needs a DERIVED path -- see the test below.
+func TestKubeVirtVmanageDeclaresExplicitContainerDiskPath(t *testing.T) {
+	specs := kubeVirtContainerDiskSpecs("vmanage", "example/vr-vmanage:20.7.1-kne-r1")
+	if len(specs) == 0 {
+		t.Fatal("vmanage must declare a container disk")
+	}
+	if got := specs[0].Path; got != "/disk/disk.qcow2" {
+		t.Errorf("vmanage containerDisk path = %q, want /disk/disk.qcow2 -- "+
+			"without it KubeVirt sees two files in /disk and the VM never boots", got)
+	}
+}
+
+// THE REGRESSION GUARD for BOTH FortiOS container-disk defects of 2026-09-14
+// (demo-lab). They pull in opposite directions, so this pins the one
+// value that satisfies both.
+//
+//  1. WRONG FILENAME. kubeVirtContainerDiskPath() took everything after the
+//     LAST ':' in the raw image reference as the "tag". Correct for a plain
+//     tag, but netlab pins by digest and the last ':' of
+//     "...fortios:7.0.9-build0444-kne-r1@sha256:<hex>" sits inside the digest,
+//     so it derived "/fortios-<64-char-hex>.qcow2" -- a file that never
+//     existed, and KubeVirt's SyncFailed event named exactly that path.
+//
+//  2. WRONG DIRECTORY. The first fix for (1) swapped the profile to Path ""
+//     (auto-discovery), which looks for a "disk/" DIRECTORY inside the
+//     ImageVolume mount. FortiOS is the one image with no such directory --
+//     its qcow2 sits at the image root. Measured by exec'ing into both
+//     launcher pods: a working panos VM has
+//     disk_0/disk/disk.qcow2, the failing FortiOS VM has
+//     disk_0/fortios-7.0.9-build0444.qcow2 and no disk/ at all. Every FortiOS
+//     VM then failed to boot with "failed to check ImageVolume path
+//     .../disk_0/disk: no such file or directory".
+//
+// So the path must be DERIVED (not "") and derived from the TAG (not the
+// digest). The expected value below is the exact filename inside the live
+// registry image, confirmed with tar -tzv on its only layer.
+func TestKubeVirtFortiosDigestPinnedImageDerivesRootLevelPath(t *testing.T) {
+	specs := kubeVirtContainerDiskSpecs("fortios",
+		"registry.example.com/skyforge/kubevirt/fortios:7.0.9-build0444-kne-r1@sha256:23ef32c326a1ab50bd7ff49e2b21e4139685002173dda9b57e09716908ec225c")
+	if len(specs) != 1 {
+		t.Fatalf("fortios container disks = %d, want 1", len(specs))
+	}
+	const want = "/fortios-7.0.9-build0444.qcow2"
+	got := specs[0].Path
+	if got == "" {
+		t.Fatalf("fortios containerDisk path is empty (auto-discovery) -- the FortiOS image has no /disk directory, so KubeVirt cannot find its root-level qcow2 and the VM never boots")
+	}
+	if got != want {
+		t.Fatalf("fortios containerDisk path = %q, want %q -- a path derived from the digest hex instead of the tag names a file that does not exist", got, want)
+	}
+}
+
+// vManage keeps its database on a second disk and will not initialise without
+// one. It is DECLARED rather than shipped: the blank disk inside the image is
+// 100GiB virtual and entirely unallocated, so carrying it through a registry
+// buys nothing and breaks the one-file rule above.
+func TestKubeVirtVmanageDeclaresDataDisk(t *testing.T) {
+	specs := kubeVirtEmptyDiskSpecs("vmanage")
+	if len(specs) != 1 {
+		t.Fatalf("vmanage must declare exactly one empty data disk, got %d", len(specs))
+	}
+	if specs[0].Capacity != "100Gi" {
+		t.Errorf("vmanage data disk capacity = %q, want 100Gi", specs[0].Capacity)
+	}
+	if specs[0].Bus != "virtio" {
+		t.Errorf("vmanage data disk bus = %q, want virtio", specs[0].Bus)
+	}
+}
+
+// Every other model must be unaffected -- emptyDisk is opt-in per profile.
+func TestKubeVirtEmptyDisksAreOptIn(t *testing.T) {
+	for _, model := range []string{"vedge", "vsmart", "asav", "cat8000v", "panos", "nxos"} {
+		if specs := kubeVirtEmptyDiskSpecs(model); len(specs) != 0 {
+			t.Errorf("model %q must declare no empty disks, got %d", model, len(specs))
+		}
+	}
+}
+
+// THE NAD IS THE VM PATH'S ONLY SOURCE OF TRUTH FOR MTU. A KubeVirt VM's
+// meshnet wires come through this NetworkAttachmentDefinition, not through
+// /etc/cni/net.d's meshnet conflist, so a fabricMTU missing here is a fabricMTU
+// the VM path never learns. demo-lab 2026-09-08: absent -> plugin default 1450 ->
+// both ends of every VM link at 1450 while container-to-container links on the
+// same node ran 8950 -> OSPF stuck in EXSTART -> 6 of 7 overlay paths dead.
+func TestKubeVirtMeshnetNADCarriesTheFabricMTU(t *testing.T) {
+	t.Setenv("MESHNET_FABRIC_MTU", "8950")
+	got := kubeVirtMeshnetNADConfig()
+	if got["fabricMTU"] != 8950 {
+		t.Fatalf("NAD fabricMTU = %v, want 8950 -- without it the plugin defaults to 1450 "+
+			"and every VM link silently runs below the fabric", got["fabricMTU"])
+	}
+	// The rest of the contract must survive.
+	if got["kubevirtSecondary"] != true || got["type"] != "meshnet" {
+		t.Fatalf("NAD lost its identity: %+v", got)
+	}
+}
+
+// ABSENT MEANS ABSENT. With no value in the environment we must omit the key
+// rather than write a guess: the plugin's own default then applies, which is
+// exactly the previous behaviour. A wrong number written here would be much
+// harder to notice than a missing one.
+func TestKubeVirtMeshnetNADOmitsAnUnknownFabricMTU(t *testing.T) {
+	for _, raw := range []string{"", "   ", "not-a-number", "0", "80", "70000"} {
+		t.Setenv("MESHNET_FABRIC_MTU", raw)
+		if _, ok := kubeVirtMeshnetNADConfig()["fabricMTU"]; ok {
+			t.Errorf("MESHNET_FABRIC_MTU=%q must leave fabricMTU unset, not guessed", raw)
+		}
+	}
+}
diff --git a/topo/node/node.go b/topo/node/node.go
index bd36f49..4ebe83b 100644
--- a/topo/node/node.go
+++ b/topo/node/node.go
@@ -2,12 +2,15 @@ package node
 
 import (
 	"context"
+	"encoding/json"
 	"errors"
 	"fmt"
+	"hash/fnv"
 	"io"
 	"math"
 	"os"
 	"path/filepath"
+	"slices"
 	"sort"
 	"strconv"
 	"strings"
@@ -27,15 +30,331 @@ import (
 	apierrors "k8s.io/apimachinery/pkg/api/errors"
 	"k8s.io/apimachinery/pkg/api/resource"
 	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
 	"k8s.io/apimachinery/pkg/util/intstr"
+	"k8s.io/client-go/dynamic"
 	"k8s.io/client-go/kubernetes"
 	"k8s.io/client-go/kubernetes/scheme"
 	"k8s.io/client-go/rest"
 	"k8s.io/client-go/tools/remotecommand"
+	"k8s.io/client-go/util/retry"
 	log "k8s.io/klog/v2"
 	"k8s.io/utils/pointer"
 )
 
+func kneAllowTaintedNodes() bool {
+	for _, name := range []string{"SKYFORGE_KNE_ALLOW_TAINTED_NODES", "KNE_ALLOW_TAINTED_NODES"} {
+		switch strings.ToLower(strings.TrimSpace(os.Getenv(name))) {
+		case "1", "true", "yes", "on":
+			return true
+		}
+	}
+	return false
+}
+
+func KNETolerations() []corev1.Toleration {
+	if !kneAllowTaintedNodes() {
+		return nil
+	}
+	key := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_TAINT_KEY"))
+	if key == "" {
+		key = "skyforge.example.com/forward-track"
+	}
+	value := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_TAINT_VALUE"))
+	if value == "" {
+		value = "stable-release"
+	}
+	effect := corev1.TaintEffect(strings.TrimSpace(os.Getenv("SKYFORGE_KNE_TAINT_EFFECT")))
+	if effect == "" {
+		effect = corev1.TaintEffectNoSchedule
+	}
+	return []corev1.Toleration{{
+		Key: key, Operator: corev1.TolerationOpEqual, Value: value, Effect: effect,
+	}}
+}
+
+func KNENodeSelectorHostname() string {
+	for _, name := range []string{"SKYFORGE_SMOKE_NODE_SELECTOR_HOSTNAME", "KNE_NODE_SELECTOR_HOSTNAME"} {
+		if val := strings.TrimSpace(os.Getenv(name)); val != "" {
+			return val
+		}
+	}
+	return ""
+}
+
+func KNENodeSelector() map[string]string {
+	selector := map[string]string{}
+	if raw := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_NODE_SELECTOR_JSON")); raw != "" {
+		if err := json.Unmarshal([]byte(raw), &selector); err != nil {
+			log.Errorf("invalid SKYFORGE_KNE_NODE_SELECTOR_JSON: %v", err)
+			return map[string]string{"skyforge.example.com/placement-error": "invalid-selector-json"}
+		}
+	}
+	if hn := KNENodeSelectorHostname(); hn != "" {
+		selector["kubernetes.io/hostname"] = hn
+	}
+	return selector
+}
+
+// KNEIOHeavyNodeAffinity returns a PREFERRED node affinity steering IO-heavy
+// nodes onto fast storage, and nil for everything else.
+//
+// WHY PREFERRED AND NOT A SELECTOR. A KubeVirt NOS boots a qcow2 through a
+// copy-on-write overlay on the node's own disk, so its first boot is a large
+// sustained write -- vManage 20.18.4 writes ~28 GB before 443 can listen, every
+// boot, and it cannot be seeded (see patches/kne 0055, reverted). MEASURED
+// 2026-09-10: 7.5 GB/min on an SSD-backed node versus 2 GB/min on a spinning
+// one, i.e. ~4 minutes against ~15 for that one appliance. Steering matters.
+//
+// But it must never REFUSE a lab. A required selector turns "the fast node is
+// full" into "the lab does not start", which is a worse failure than a slow
+// boot. Preferred affinity is a RANKING: fill the fast nodes first, spill to the
+// rest when they are full, never block. Containers -- IOL, cEOS, linux -- are
+// the low-IO remainder and get no preference, which is what leaves the fast
+// node free for the nodes that actually need it.
+//
+// WHICH NODES ARE IO-HEAVY IS NOT LISTED HERE. The server passes the set it
+// already derives for the heavy BRING-UP LANE, whose membership is computed
+// from the device catalog (a containerDisk under /kubevirt/ is a VM), so
+// onboarding a VM NOS onboards it to this placement in the same edit. A second
+// hand-maintained list is exactly the drift that classification was created to
+// end.
+//
+// Fails open in every direction: no labels configured, no model set, an
+// unparseable value, or a model that is not IO-heavy all return nil.
+// KNEIOHeavyNodeAffinityUnstructured returns exactly what
+// KNEIOHeavyNodeAffinity returns, rendered into the map[string]any form the
+// KubeVirt VM object has to be built in.
+//
+// WHY THIS EXISTS. KNE emits placement in TWO representations. The container
+// path builds a typed corev1.PodSpec; the VM path builds an
+// unstructured.Unstructured, because kubevirt.io/api is not a dependency of
+// this module and the VM object is assembled as maps. A placement rule added
+// to only one of them half-applies IN SILENCE -- which is what happened to the
+// IO-heavy SSD preference on its first outing: it was added to the five
+// CreatePod sites, and vManage, which is a VM, never saw it and unpacked its
+// mandatory ~28 GB on an HDD node at 2.0 GB/min instead of 7.5.
+//
+// THERE IS STILL ONLY ONE POLICY. This function contains no rule of its own --
+// it calls KNEIOHeavyNodeAffinity and converts. Add a placement rule THERE and
+// both paths get it. If you find yourself writing a condition in this
+// function, the policy has started to fork again.
+//
+// Fails open exactly like the policy it wraps: on a conversion error it logs
+// and returns nil, because this is a PREFERENCE and must never be able to
+// refuse a node.
+func KNEIOHeavyNodeAffinityUnstructured() map[string]any {
+	affinity := KNEIOHeavyNodeAffinity()
+	if affinity == nil {
+		return nil
+	}
+	// Vendor SDK conversion, not a hand-written map literal: the typed struct
+	// is the contract and its json tags are what the apiserver reads back.
+	rendered, err := runtime.DefaultUnstructuredConverter.ToUnstructured(&corev1.Affinity{NodeAffinity: affinity})
+	if err != nil {
+		log.Errorf("rendering IO-heavy node affinity: %v", err)
+		return nil
+	}
+	nodeAffinity, ok := rendered["nodeAffinity"].(map[string]any)
+	if !ok {
+		log.Errorf("rendered IO-heavy node affinity has no nodeAffinity")
+		return nil
+	}
+	return nodeAffinity
+}
+
+func KNEIOHeavyNodeAffinity() *corev1.NodeAffinity {
+	raw := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON"))
+	if raw == "" {
+		return nil
+	}
+	labels := map[string]string{}
+	if err := json.Unmarshal([]byte(raw), &labels); err != nil {
+		log.Errorf("invalid SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON: %v", err)
+		return nil
+	}
+	if len(labels) == 0 {
+		return nil
+	}
+	keys := make([]string, 0, len(labels))
+	for k := range labels {
+		keys = append(keys, k)
+	}
+	slices.Sort(keys)
+	exprs := make([]corev1.NodeSelectorRequirement, 0, len(keys))
+	for _, k := range keys {
+		exprs = append(exprs, corev1.NodeSelectorRequirement{
+			Key:      k,
+			Operator: corev1.NodeSelectorOpIn,
+			Values:   []string{labels[k]},
+		})
+	}
+	return &corev1.NodeAffinity{
+		PreferredDuringSchedulingIgnoredDuringExecution: []corev1.PreferredSchedulingTerm{{
+			// WEIGHT 25, NOT 100 -- deliberately lowered (2026-09-14) so that
+			// KNESameModelPodAntiAffinity (weight 100, below) can outscore this
+			// preference when two same-model VMs would otherwise land on the
+			// same node. Both weights cap at 100 (k8s API validation), so the
+			// only way to make the anti-affinity WIN a real conflict is to
+			// lower this one, not raise the other. Worked example: the
+			// SSD node already holding one same-model VM scores +25 (this
+			// preference) - 100 (the conflict penalty) = -75; any other node
+			// scores 0. The other node wins. In the no-conflict case (a
+			// singleton model, or the SSD node is empty) this is still a
+			// real, unambiguous preference toward the SSD node -- just
+			// weaker than before. See KNESameModelPodAntiAffinity's own doc
+			// comment for the other half of this design.
+			Weight:     25,
+			Preference: corev1.NodeSelectorTerm{MatchExpressions: exprs},
+		}},
+	}
+}
+
+// KNESameModelPodAntiAffinityUnstructured is KNESameModelPodAntiAffinity
+// rendered for a KubeVirt VM object built as unstructured maps (the KubeVirt
+// VM/VMI CRDs have no typed corev1.Affinity field to assign to directly).
+// Fails open exactly like the policy it wraps: on a conversion error it logs
+// and returns nil, because this is a PREFERENCE and must never be able to
+// refuse a node.
+func KNESameModelPodAntiAffinityUnstructured(model string) map[string]any {
+	affinity := KNESameModelPodAntiAffinity(model)
+	if affinity == nil {
+		return nil
+	}
+	rendered, err := runtime.DefaultUnstructuredConverter.ToUnstructured(&corev1.Affinity{PodAntiAffinity: affinity})
+	if err != nil {
+		log.Errorf("rendering same-model pod anti-affinity: %v", err)
+		return nil
+	}
+	podAntiAffinity, ok := rendered["podAntiAffinity"].(map[string]any)
+	if !ok {
+		log.Errorf("rendered same-model pod anti-affinity has no podAntiAffinity")
+		return nil
+	}
+	return podAntiAffinity
+}
+
+// KNESameModelPodAntiAffinity returns a PREFERRED pod anti-affinity steering
+// two KubeVirt VMs of the SAME NOS model away from sharing a node, and nil
+// for an empty model (fail open -- never refuse a lab over an empty string).
+//
+// WHY. KNEIOHeavyNodeAffinity steers heavy VMs onto the SSD-labeled node(s).
+// With one SSD node cluster-wide, two VMs of the same model (e.g. two
+// FortiOS firewalls) both land there and, admitted concurrently, can hit a
+// KubeVirt ImageVolume mount race under the resulting I/O contention --
+// measured live 2026-09-14 on demo-lab (SyncFailed: "failed to find
+// disk file from ImageVolume ... no such file or directory", crash-looping).
+// A same-model admission throttle (config, not code) serializes their
+// START but does not stop them landing on the same node once each is
+// individually scheduled.
+//
+// This is generic (parameterized by model), not fortios-specific, because
+// any heavy model with 2+ instances in a topology has the same exposure.
+// It is scoped to KubeVirt VMs only -- container-backed models (IOL, cEOS)
+// routinely run 10-50+ identical instances by design and same-model spread
+// there would badly fragment normal lab placement; that path has its own,
+// different anti-affinity (same-LAB spread, not same-MODEL) and is
+// untouched by this function.
+//
+// PREFERRED, NEVER REQUIRED -- same "must never refuse a lab" contract as
+// KNEIOHeavyNodeAffinity and KNEContainerNodeAffinity. A hard anti-affinity
+// could make a VM unschedulable if every other node were full; soft keeps
+// that impossible while still winning the ordinary case (see the weight
+// comment on KNEIOHeavyNodeAffinity above for how the two preferences are
+// balanced so SSD/HDD split is an accepted trade, not a bug).
+func KNESameModelPodAntiAffinity(model string) *corev1.PodAntiAffinity {
+	model = strings.TrimSpace(model)
+	if model == "" {
+		return nil
+	}
+	return &corev1.PodAntiAffinity{
+		PreferredDuringSchedulingIgnoredDuringExecution: []corev1.WeightedPodAffinityTerm{{
+			Weight: 100,
+			PodAffinityTerm: corev1.PodAffinityTerm{
+				LabelSelector: &metav1.LabelSelector{
+					MatchExpressions: []metav1.LabelSelectorRequirement{{
+						Key:      kneVMModelLabel,
+						Operator: metav1.LabelSelectorOpIn,
+						Values:   []string{model},
+					}},
+				},
+				TopologyKey: "kubernetes.io/hostname",
+			},
+		}},
+	}
+}
+
+// kneVMModelLabel is the pod-template label KNESameModelPodAntiAffinity
+// selects on; kubeVirtLabels() in kubevirt.go is what sets it. Named as a
+// constant so the setter and the selector can never drift apart -- the same
+// reason KNEIOHeavyNodeAffinity and KNEContainerNodeAffinity both derive
+// from the one SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON env var.
+const kneVMModelLabel = "skyforge.example.com/model"
+
+// KNEContainerNodeAffinity returns a PREFERRED node affinity steering
+// container-backed nodes (IOL, cEOS, linux, ...) AWAY from the same
+// SKYFORGE_KNE_IO_HEAVY_NODE_LABELS_JSON-labeled node(s) that
+// KNEIOHeavyNodeAffinity steers VM-backed nodes ONTO, and nil for everything
+// else (same fail-open contract: no labels configured, unparseable value, or
+// no labels present all return nil).
+//
+// WHY THE COMPLEMENT, NOT JUST "NO PREFERENCE". KNEIOHeavyNodeAffinity's own
+// doc already explains that containers get no preference so the fast node
+// stays free for the VMs that need it -- that holds when the fast-node pool
+// has slack. It stops holding once the fast-node pool is small (today, ONE
+// node cluster-wide) and busy: even with the topology-spread PodAntiAffinity
+// fix (see the "n.Namespace, NOT pb.Name" comment on the generic CreatePod
+// site), containers still land on the fast node roughly evenly with everyone
+// else, competing with the VMs for the exact write throughput this whole
+// mechanism exists to protect. An explicit soft PREFERENCE (never a
+// requirement -- same "must never refuse a lab" contract as the VM side) to
+// avoid that node frees its capacity for the workloads that actually
+// benefit from it, at zero cost to containers (which don't need SSD I/O).
