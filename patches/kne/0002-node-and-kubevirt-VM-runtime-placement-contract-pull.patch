+func TestKubeVirtVMObjectAllowsSrosBootstrapConfig(t *testing.T) {
+	n := &Impl{
+		Namespace: "test",
+		Proto: &topopb.Node{
+			Name:   "sros1",
+			Vendor: topopb.Vendor_NOKIA,
+			Model:  "sros",
+			Config: &topopb.Config{
+				Image:      "registry.example.com/skyforge/kubevirt/vr-sros:22.10.R2-eve-l1",
+				ConfigPath: "/tftpboot",
+				ConfigFile: "config.txt",
+				ConfigData: &topopb.Config_Data{
+					Data: []byte("system { hostname sros-test }\n"),
+				},
+			},
+		},
+	}
+	vm, err := n.kubeVirtVMObject()
+	if err != nil {
+		t.Fatalf("kubeVirtVMObject() failed: %v", err)
+	}
+	disks, _, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "domain", "devices", "disks")
+	if err != nil {
+		t.Fatalf("failed to read VM disks: %v", err)
+	}
+	volumes, _, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "volumes")
+	if err != nil {
+		t.Fatalf("failed to read VM volumes: %v", err)
+	}
+
+	if containsNamedUnstructuredItem(disks, kubeVirtSrosBootstrapDiskName) {
+		t.Fatalf("VM disks unexpectedly include config-drive %q: %#v", kubeVirtSrosBootstrapDiskName, disks)
+	}
+	if containsNamedUnstructuredItem(volumes, kubeVirtSrosBootstrapDiskName) {
+		t.Fatalf("VM volumes unexpectedly include config-drive %q: %#v", kubeVirtSrosBootstrapDiskName, volumes)
+	}
+	cpu, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "domain", "cpu")
+	if err != nil {
+		t.Fatalf("failed to read VM CPU: %v", err)
+	}
+	if !found || cpu["model"] != "host-passthrough" {
+		t.Fatalf("VM CPU should use host-passthrough for sros, got %#v", cpu)
+	}
+	if cpu["cores"] != int64(2) {
+		t.Fatalf("VM CPU should enforce upstream vr-sros minimum 2 cores, got %#v", cpu)
+	}
+	resources, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "domain", "resources", "requests")
+	if err != nil {
+		t.Fatalf("failed to read VM resource requests: %v", err)
+	}
+	if !found || resources["memory"] != "5120Mi" {
+		t.Fatalf("VM memory request should enforce upstream vr-sros minimum 5120Mi, got %#v", resources)
+	}
+	machine, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "domain", "machine")
+	if err != nil {
+		t.Fatalf("failed to read VM machine type: %v", err)
+	}
+	if !found || machine["type"] != "q35" {
+		t.Fatalf("VM machine type should match the admitted KubeVirt q35 contract for sros, got %#v", machine)
+	}
+	clock, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "domain", "clock", "utc")
+	if err != nil {
+		t.Fatalf("failed to read VM clock: %v", err)
+	}
+	if !found {
+		t.Fatal("VM clock utc offset missing for sros")
+	}
+	offsetValue, ok := clock["offsetSeconds"]
+	if !ok {
+		t.Fatalf("VM clock utc offsetSeconds missing: %#v", clock)
+	}
+	offsetSeconds, ok := offsetValue.(int64)
+	if !ok {
+		t.Fatalf("VM clock utc offsetSeconds type got %T (%#v), want int64", offsetValue, offsetValue)
+	}
+	guestTime := time.Now().UTC().Add(time.Duration(offsetSeconds) * time.Second)
+	if guestTime.Sub(kubeVirtSrosEvalClockBase).Abs() > 5*time.Second {
+		t.Fatalf("VM clock offset maps guest time to %s, want near SROS license eval base %s", guestTime, kubeVirtSrosEvalClockBase)
+	}
+	devices, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "domain", "devices")
+	if err != nil {
+		t.Fatalf("failed to read VM devices: %v", err)
+	}
+	if !found || devices["autoattachMemBalloon"] != false {
+		t.Fatalf("VM devices should disable mem balloon for sros, got %#v", devices)
+	}
+	if _, found := devices["useVirtioTransitional"]; !found {
+		t.Fatalf("VM devices should enable transitional virtio for stock vr-sros, got %#v", devices)
+	}
+	annotations, found, err := unstructured.NestedStringMap(vm.Object, "spec", "template", "metadata", "annotations")
+	if err != nil {
+		t.Fatalf("failed to read VM annotations: %v", err)
+	}
+	if !found || annotations["hooks.kubevirt.io/hookSidecars"] == "" {
+		t.Fatalf("VM template missing SR-OS hook annotations: %#v", annotations)
+	}
+	interfaces, found, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "domain", "devices", "interfaces")
+	if err != nil {
+		t.Fatalf("failed to read VM interfaces: %v", err)
+	}
+	if !found || len(interfaces) == 0 {
+		t.Fatalf("VM interfaces missing: %#v", interfaces)
+	}
+	firstInterface, ok := interfaces[0].(map[string]any)
+	if !ok || firstInterface["model"] != "e1000" {
+		t.Fatalf("VM default interface should declare SR-OS e1000 model, got %#v", interfaces[0])
+	}
+	affinity, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "affinity", "podAffinity")
+	if err != nil {
+		t.Fatalf("failed to read VM pod affinity: %v", err)
+	}
+	if !found {
+		t.Fatal("VM template missing SR-OS bootstrap TFTP pod affinity")
+	}
+	required, ok := affinity["requiredDuringSchedulingIgnoredDuringExecution"].([]any)
+	if !ok || len(required) != 1 {
+		t.Fatalf("VM bootstrap TFTP pod affinity should have one required term, got %#v", affinity)
+	}
+	term, ok := required[0].(map[string]any)
+	if !ok {
+		t.Fatalf("VM bootstrap TFTP pod affinity term has unexpected shape: %#v", required[0])
+	}
+	if term["topologyKey"] != "kubernetes.io/hostname" {
+		t.Fatalf("VM bootstrap TFTP pod affinity topologyKey = %v", term["topologyKey"])
+	}
+	selector, ok := term["labelSelector"].(map[string]any)
+	if !ok {
+		t.Fatalf("VM bootstrap TFTP pod affinity selector missing: %#v", term)
+	}
+	matchLabels, ok := selector["matchLabels"].(map[string]any)
+	if !ok {
+		t.Fatalf("VM bootstrap TFTP pod affinity matchLabels missing: %#v", selector)
+	}
+	if matchLabels["app"] != "sros1-bootstrap-tftp" || matchLabels["kneBootstrap"] != "tftp" {
+		t.Fatalf("VM bootstrap TFTP pod affinity labels mismatch: %#v", matchLabels)
+	}
+}
