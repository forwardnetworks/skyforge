+		MachineType:           "q35",
+		MinimumCPU:            2,
+		MinimumMemory:         "5120Mi",
+		UseVirtioTransitional: true,
+		BootstrapTFTP:         true,
+		BootstrapTransport:    "tftp",
+		IdentityInputs: []string{
+			"clock-offset",
+			"firmware-uuid",
+			"license-uuid",
+			"smbios-product",
+		},
