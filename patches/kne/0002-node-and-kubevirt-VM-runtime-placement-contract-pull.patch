+func kubeVirtSATAConfigDriveDiskAndVolume(diskName, secretName string, secretData []byte) (map[string]any, map[string]any, []byte, error) {
+	// OpenStack CONFIG-DRIVE on a SATA HARD DISK (not a CD-ROM):
+	// the prior shape (plain secret-disk iso9660 with /iosxe_config.txt, presented as a
+	// SATA cdrom) did NOT ingest on the deployed 17.06.03 image under q35 — the guest ran
+	// the interactive SETUP dialog, left its data interface shut, and never applied day-0.
+	// The documented+repo-proven legacy CVAC path is an IDE cdrom, which the q35-only Talos
+	// admission contract forbids. IOS-XE also natively supports OpenStack config-drive
+	// user_data (Cisco day-0 config-drive guide), which KubeVirt's cloudInitConfigDrive
+	// renders as a labelled config-drive volume (openstack/latest/user_data) on a second
+	// disk — a clean q35/SATA shape. Secret key is the generic "userdata" (see
+	// kubeVirtBootstrapSecretKey). A HARD DISK (not cdrom) matches the repo's known-working
+	// libvirt cat8000v second-drive and avoids the IDE-cdrom-only CVAC enumeration path.
+	// Viptela reuses this exact disk/volume path; only its netlab-authored
+	// startup-config content differs.
+	return map[string]any{
+			"name": diskName,
+			"disk": map[string]any{
+				"bus": "sata",
+			},
+		},
+		kubeVirtConfigDriveSecretVolume(diskName, secretName),
+		secretData,
+		nil
+}
