+func TestKubeVirtBootstrapDiskAndSecretNamesAgree(t *testing.T) {
+	cases := []struct {
+		model    string
+		diskName string
+	}{
+		{"vjunos-router", kubeVirtVJunosBootstrapDiskName},
+		{"vjunos-switch", kubeVirtVJunosBootstrapDiskName},
+		{"nxos", kubeVirtNxosBootstrapDiskName},
+		{"asav", kubeVirtASAvBootstrapDiskName},
+	}
+	for _, tc := range cases {
+		t.Run(tc.model, func(t *testing.T) {
+			n := &Impl{Proto: &topopb.Node{
+				Vendor: topopb.Vendor_JUNIPER,
+				Model:  tc.model,
+				Config: &topopb.Config{Image: "registry.example.com/skyforge/kubevirt/x:test"},
+			}}
+			want := kubeVirtBootstrapSecretName("n1", tc.diskName)
+
+			var disk, volume map[string]any
+			var err error
+			switch {
+			case kubeVirtIsVJunos(tc.model):
+				disk, volume, _, err = kubeVirtVJunosBootstrapDiskAndVolume(want, []byte("cfg"))
+			case kubeVirtIsASAv(tc.model):
+				disk, volume, _, err = kubeVirtASAvBootstrapDiskAndVolume(want, []byte("cfg"))
+			default:
+				disk, volume, _, err = kubeVirtNxosBootstrapDiskAndVolume(want, []byte("cfg"))
+			}
+			if err != nil {
+				t.Fatalf("disk/volume: %v", err)
+			}
+			if disk["name"] != tc.diskName || volume["name"] != tc.diskName {
+				t.Fatalf("disk=%v volume=%v, want both %q", disk["name"], volume["name"], tc.diskName)
+			}
+			// The volume must reference the SAME secret name the bootstrap
+			// secret is actually created under.
+			var got string
+			if sec, ok := volume["secret"].(map[string]any); ok {
+				got, _ = sec["secretName"].(string)
+			} else if cd, ok := volume["cloudInitConfigDrive"].(map[string]any); ok {
+				if ref, ok := cd["secretRef"].(map[string]any); ok {
+					got, _ = ref["name"].(string)
+				}
+			}
+			if got != want {
+				t.Fatalf("volume references secret %q, but the secret is created as %q", got, want)
+			}
+			_ = n
+		})
+	}
+}
