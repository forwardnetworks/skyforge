+type kubeVirtHardwareProfile struct {
+	CPUModel string
+	// InterfaceModel is the vNIC model for the DATA interfaces. virtio unless a
+	// guest cannot drive it: it is the faster path and costs the host less CPU.
+	InterfaceModel string
+	// MgmtInterfaceModel overrides the model on the MASQUERADE management
+	// interface alone, falling back to InterfaceModel when empty.
+	//
+	// It exists because the two interfaces face different things. The data
+	// interfaces carry a meshnet bridge and nothing else; the management one
+	// faces KubeVirt's own masquerade DHCP server, whose reply is generated on
+	// the host with CHECKSUM_PARTIAL and handed to a tap advertising TX checksum
+	// offload. A guest whose stack will not accept an uncomputed UDP checksum
+	// drops the OFFER and never gets an address -- and that is a property of the
+	// MANAGEMENT path only. Downgrading the data plane to e1000 to fix it would
+	// pay for a management-plane defect with dataplane throughput on every
+	// interface of the node.
+	//
+	// WHICH PROFILES SHOULD USE IT IS AN OPEN QUESTION. Five profiles set
+	// InterfaceModel: "e1000" for the whole VM. Only asav records WHY, and its
+	// reason is a dataplane one -- lina segfaults in DPDK when it binds a virtio
+	// NIC -- so asav must keep e1000 on the data interfaces. fortios, nxos,
+	// panos and sros record no reason at all. If any of those was actually a
+	// management-plane symptom, it is paying for it with dataplane throughput on
+	// every interface and could take this override instead. That is a
+	// measurement nobody has taken, and guessing at it is how a working NOS gets
+	// broken; it is written down here so the next person inherits the question
+	// rather than rediscovering it.
+	MgmtInterfaceModel    string
+	MachineType           string
+	MinimumCPU            int64
+	MinimumMemory         string
+	// IOHeavy opts a model into the SSD node preference (KNEIOHeavyNodeAffinity).
+	// It is a property of the appliance, declared on its own profile -- keyed by
+	// the SAME KNE model name as n.Proto.Model, so it cannot suffer the
+	// netlab-device-key vs KNE-model mismatch that sank the first model list.
+	// Only appliances whose first boot is a large mandatory disk write earn it
+	// (vManage: ~28 GB before 443 listens; 7.5 GB/min on SSD vs 2 GB/min
+	// spinning). Every other VM used to inherit it by default, which pulled
+	// A10s, PAN-OS, FortiGates and the rest onto the one SSD node for no benefit.
+	IOHeavy               bool
+	Firmware              map[string]any
+	RequiredNodeSelector  map[string]string
+	UseVirtioTransitional bool
+	PersistentRoot        bool
+	SlotBound             bool
+	BootstrapTFTP         bool
+	BootstrapTransport    string
+	IdentityInputs        []string
+	ReadinessProbes       []string
+	ConfigApplyRequires   []string
+	// MgmtLivenessTCPPort, when non-zero, emits a VMI-level tcpSocket
+	// livenessProbe against this port so a guest whose management plane dies
+	// while the VM stays healthy is restarted by KubeVirt (day-0 re-runs on
+	// restart and restores config). Motivated by vJunos: all four demo-lab
+	// switches dropped SSH/NETCONF in-guest ~5h after boot on 2026-08-31 with
+	// the VMs Running, 0 restarts and the console silent -- nothing above the
+	// guest could see it, and the collector reported every one "Device not
+	// reachable" until a manual virt-launcher restart. The probe is executed
+	// by virt-launcher against the pod IP, so the port must be in
+	// kubeVirtMgmtMasqueradePorts.
+	MgmtLivenessTCPPort int
+	ContainerDisks      []kubeVirtContainerDiskSpec
+	EmptyDisks          []kubeVirtEmptyDiskSpec
+}
