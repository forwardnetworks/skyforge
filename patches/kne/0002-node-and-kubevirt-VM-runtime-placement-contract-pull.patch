+// kubeVirtVJunosNeedsVMXSMBIOS reports whether a model is one of the vMX-derived
+// vJunos images whose Linux wrapper picks its packet-forwarding path from SMBIOS.
+//
+// Our vjunos-router / vjunos-switch qcow2 is the vendor image with every vrnetlab
+// layer stripped: a Linux host that boots the Junos RE nested behind its own
+// br-ext bridge, and a `riot` PFE beside it. With no SMBIOS hint the wrapper takes
+// the PERFORMANCE PFE path (start_vmxt_perf.sh), which wants /etc/vmxt/init.conf,
+// /boot/loader.conf and a hugepage pool -- none of which exist here. riot then
+// panics in populate_dmem() ("cannot map 65536 frames for edmem"), and the PFE
+// restart loop pulls eth0 OUT of br-ext at ~159s and never puts it back, severing
+// the RE's only path off the VM. Measured on a live VMI: with product=VM-VMX and
+// family=lab stamped, the perf path, the riot panics and the missing-init.conf
+// errors all go to zero, eth0 stays forwarding in br-ext, and the RE answers SSH
+// and NETCONF on the pod IP. vrnetlab reaches the same place with exactly
+// `self.smbios = ["type=1,product=VM-VMX,family=lab"]`; family=lab is the entry
+// that selects the lab PFE.
+//
+// NOT hugepages: vrnetlab runs this NOS with plain ram=5120 and no hugepage pool.
+//
+// vsrx is deliberately EXCLUDED even though kubeVirtIsVJunos matches it. vSRX is a
+// first-class Junos VM, not the vMX wrapper -- it has no riot PFE and no perf/lab
+// fork to select, vrnetlab stamps it no SMBIOS at all, and we have measured nothing
+// for it. kubeVirtIsVJunos exists to share the juniper.conf DAY-0 contract, which
+// vsrx genuinely shares; the PFE-path contract is narrower than that, so it gets
+// its own predicate rather than silently widening the day-0 one.
+func kubeVirtVJunosNeedsVMXSMBIOS(model string) bool {
+	switch normalizeKubeVirtModel(model) {
+	case "vjunos-router", "vjunos-switch":
+		return true
+	}
+	return false
+}
+
+// kubeVirtIsVJunosSwitch selects the VM-VEX personality (see
+// kubeVirtVJunosSwitchSMBIOSProduct).
+func kubeVirtIsVJunosSwitch(model string) bool {
+	return normalizeKubeVirtModel(model) == "vjunos-switch"
+}
+
+const (
+	// The exact pair vrnetlab stamps for vMX-family images. product selects the
+	// wrapper's vMX personality; family=lab selects the LAB PFE over the perf PFE.
+	kubeVirtVJunosSMBIOSProduct = "VM-VMX"
+	kubeVirtVJunosSMBIOSFamily  = "lab"
+	// vJunos-switch is a DIFFERENT contract: the vendor image carries both
+	// personalities and picks the switch (EX9214, ethernet-switching, VLANs)
+	// from `product=VM-VEX`; Juniper's KVM guide is explicit that any other
+	// value makes it "act as a vMX", and that is exactly what happened here
+	// until 2026-09-19 -- every vjunos-switch node was stamped VM-VMX, booted
+	// as `Model: vmx`, and silently ignored every `family ethernet-switching`
+	// block ("configuration block ignored: unsupported platform (vmx)").
+	// Measured on demo-lab cdg-acc-sw01: same disk, hook changed to
+	// VM-VEX, VMI restarted -> `Model: ex9214`, the VLAN present with its
+	// three ports as members and MACs learned on all of them. No family entry:
+	// Juniper stamps product only for the switch, and the RE stayed reachable
+	// well past the ~159s mark at which the router wrapper's perf path kills
+	// eth0.
+	kubeVirtVJunosSwitchSMBIOSProduct = "VM-VEX"
+)
+
+// kubeVirtVJunosSMBIOSHookScript is the libvirt onDefineDomain hook for vJunos. Unlike
+// SR-OS's, it is fully STATIC: no per-node identity, no TFTP host, no license line, no
+// chassis variant -- just the two SMBIOS entries the wrapper reads.
+//
+// Two deliberate differences from the SR-OS script, both load-bearing:
+//   - it SETS family (SR-OS removes it). family=lab IS the PFE selector; dropping it
+//     puts the wrapper straight back on the perf path.
+//   - it leaves KubeVirt's own manufacturer/serial/uuid entries in place. The measured
+//     working sysinfo was manufacturer=KubeVirt, product=VM-VMX, serial=<uuid>,
+//     uuid=<uuid>, family=lab -- stripping the identity entries was never part of what
+//     was proven, and SR-OS strips them only to match stock vr-sros's shape.
+//
+// It likewise does NOT remove virtio controllers: that is an SR-OS-specific trim.
+func kubeVirtVJunosSMBIOSHookScript(model string) string {
+	product := kubeVirtVJunosSMBIOSProduct
+	familyLine := `    upsert_system_entry(system, "family", FAMILY)`
+	if kubeVirtIsVJunosSwitch(model) {
+		product = kubeVirtVJunosSwitchSMBIOSProduct
+		familyLine = `    pass  # vJunos-switch: product only, no family entry`
+	}
+	return `#!/usr/bin/env python3
+import argparse
+import sys
+import xml.etree.ElementTree as ET
+
+PRODUCT = "` + product + `"
+FAMILY = "` + kubeVirtVJunosSMBIOSFamily + `"
+
+
+def child(parent, name):
+    found = parent.find(name)
+    if found is not None:
+        return found
+    return ET.SubElement(parent, name)
+
+
+def upsert_system_entry(system, name, value):
+    for entry in list(system.findall("entry")):
+        if entry.attrib.get("name") == name:
+            system.remove(entry)
+    entry = ET.SubElement(system, "entry", {"name": name})
+    entry.text = value
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--vmi", required=False)
+    parser.add_argument("--domain", required=True)
+    args, _ = parser.parse_known_args()
+
+    root = ET.fromstring(args.domain)
+    os_node = child(root, "os")
+    smbios = child(os_node, "smbios")
+    smbios.set("mode", "sysinfo")
+
+    sysinfo = child(root, "sysinfo")
+    sysinfo.set("type", "smbios")
+    system = child(sysinfo, "system")
+    upsert_system_entry(system, "product", PRODUCT)
+` + familyLine + `
+
+    sys.stdout.write(ET.tostring(root, encoding="unicode"))
+
+
+if __name__ == "__main__":
+    main()
+`
+}
