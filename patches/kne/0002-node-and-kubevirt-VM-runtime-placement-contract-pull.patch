+func TestKubeVirtHardwareProfileForReturnsClonedProfiles(t *testing.T) {
+	profile := kubeVirtHardwareProfileFor("nxos", "registry.example.com/skyforge/kubevirt/nxos:9.3.8")
+	if len(profile.ContainerDisks) == 0 {
+		t.Fatal("kubeVirtHardwareProfileFor(nxos) returned no container disks")
+	}
+	profile.ContainerDisks[0].Path = "/mutated.qcow2"
+	profile.Firmware["bootloader"] = "mutated"
+	profile.IdentityInputs[0] = "mutated"
+	profile.ReadinessProbes[0] = "mutated"
+	profile.ConfigApplyRequires[0] = "mutated"
+
+	got := kubeVirtHardwareProfileFor("nxos", "registry.example.com/skyforge/kubevirt/nxos:9.3.8")
+	if got.ContainerDisks[0].Path != "/disk/disk.qcow2" {
+		t.Fatalf("ContainerDisks[0].Path got %q, want immutable default path", got.ContainerDisks[0].Path)
+	}
+	bootloader, ok := got.Firmware["bootloader"].(map[string]any)
+	if !ok {
+		t.Fatalf("Firmware[bootloader] got %#v, want nested map", got.Firmware["bootloader"])
+	}
+	if _, ok := bootloader["efi"].(map[string]any); !ok {
+		t.Fatalf("Firmware[bootloader][efi] got %#v, want nested map", bootloader["efi"])
+	}
+	if got.IdentityInputs[0] == "mutated" {
+		t.Fatalf("IdentityInputs were not cloned: %#v", got.IdentityInputs)
+	}
+	if got.ReadinessProbes[0] == "mutated" {
+		t.Fatalf("ReadinessProbes were not cloned: %#v", got.ReadinessProbes)
+	}
+	if got.ConfigApplyRequires[0] == "mutated" {
+		t.Fatalf("ConfigApplyRequires were not cloned: %#v", got.ConfigApplyRequires)
+	}
+}
