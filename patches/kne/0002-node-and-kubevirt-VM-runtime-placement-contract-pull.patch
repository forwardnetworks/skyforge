+func kubeVirtSrosSMBIOSHookScript(nodeName, tftpHost string, hasBootstrapConfig bool, timosLine string) string {
+	return `#!/usr/bin/env python3
+import argparse
+import sys
+import xml.etree.ElementTree as ET
+
+PRODUCT = "` + kubeVirtSrosSMBIOSProduct(nodeName, tftpHost, hasBootstrapConfig, timosLine) + `"
+
+
+def child(parent, name):
+    found = parent.find(name)
+    if found is not None:
+        return found
+    created = ET.SubElement(parent, name)
+    return created
+
+
+def upsert_system_entry(system, name, value):
+    for entry in list(system.findall("entry")):
+        if entry.attrib.get("name") == name:
+            system.remove(entry)
+    entry = ET.SubElement(system, "entry", {"name": name})
+    entry.text = value
+
+
+def remove_system_entries(system, names):
+    names = set(names)
+    for entry in list(system.findall("entry")):
+        if entry.attrib.get("name") in names:
+            system.remove(entry)
+
+
+def remove_matching(parent, predicate):
+    for child_node in list(parent):
+        if predicate(child_node):
+            parent.remove(child_node)
+
+
+def remove_unused_virtio_devices(root):
+    devices = root.find("devices")
+    if devices is None:
+        return
+    remove_matching(
+        devices,
+        lambda node: node.tag == "controller"
+        and node.attrib.get("type") in ("scsi", "virtio-serial")
+        and "virtio" in node.attrib.get("model", ""),
+    )
+    remove_matching(
+        devices,
+        lambda node: node.tag == "channel"
+        and node.find("target") is not None
+        and node.find("target").attrib.get("name") == "org.qemu.guest_agent.0",
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--vmi", required=False)
+    parser.add_argument("--domain", required=True)
+    args, _ = parser.parse_known_args()
+
+    root = ET.fromstring(args.domain)
+    os_node = child(root, "os")
+    smbios = child(os_node, "smbios")
+    smbios.set("mode", "sysinfo")
+
+    sysinfo = child(root, "sysinfo")
+    sysinfo.set("type", "smbios")
+    system = child(sysinfo, "system")
+    remove_system_entries(system, ("manufacturer", "serial", "family"))
+    upsert_system_entry(system, "product", PRODUCT)
+    remove_unused_virtio_devices(root)
+
+    sys.stdout.write(ET.tostring(root, encoding="unicode"))
+
+
+if __name__ == "__main__":
+    main()
+`
+}
