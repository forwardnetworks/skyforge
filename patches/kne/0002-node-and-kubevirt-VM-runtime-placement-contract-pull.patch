+func TestKubeVirtHardwareProfileFor(t *testing.T) {
+	tests := []struct {
+		model      string
+		cpuModel   string
+		ifaceModel string
+		// mgmtIfaceModel is the model on the MASQUERADE interface. Empty means
+		// "same as ifaceModel", which is the fallback and must be asserted rather
+		// than assumed -- a profile that silently stopped falling back would put a
+		// management NIC on a tap its guest cannot take DHCP from.
+		mgmtIfaceModel     string
+		machineType        string
+		minMemory          string
+		transitional       bool
+		tftp               bool
+		bootstrapTransport string
+		readinessProbes    []string
+		firstDiskBus       string
+	}{
+		{model: "a10", cpuModel: "host-passthrough", ifaceModel: "virtio", machineType: "q35", minMemory: "4Gi", transitional: true, bootstrapTransport: "image-owned", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "asav", cpuModel: "host-passthrough", ifaceModel: "e1000", machineType: "q35", minMemory: "4Gi", bootstrapTransport: "config-drive", readinessProbes: []string{"ssh"}, firstDiskBus: "sata"},
+		{model: "fortios", ifaceModel: "virtio", bootstrapTransport: "image-owned", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "nxos", ifaceModel: "e1000", minMemory: "8Gi", bootstrapTransport: "config-drive", readinessProbes: []string{"ssh", "ansible"}, firstDiskBus: "sata"},
+		{model: "panos", ifaceModel: "e1000", minMemory: "8Gi", bootstrapTransport: "image-owned", readinessProbes: []string{"ansible"}, firstDiskBus: "virtio"},
+		{model: "vedge", cpuModel: "host-passthrough", ifaceModel: "e1000", machineType: "q35", minMemory: "4Gi", bootstrapTransport: "config-drive", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "vsmart", cpuModel: "host-passthrough", ifaceModel: "e1000", machineType: "q35", minMemory: "4Gi", bootstrapTransport: "config-drive", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "vbond", cpuModel: "host-passthrough", ifaceModel: "e1000", machineType: "q35", minMemory: "4Gi", bootstrapTransport: "image-owned", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "vmanage", cpuModel: "host-passthrough", ifaceModel: "e1000", machineType: "q35", minMemory: "4Gi", bootstrapTransport: "config-drive", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "director", cpuModel: "host-passthrough", ifaceModel: "virtio", machineType: "q35", minMemory: "16Gi", bootstrapTransport: "image-owned", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "flexvnf", cpuModel: "host-passthrough", ifaceModel: "virtio", machineType: "q35", minMemory: "4Gi", bootstrapTransport: "image-owned", readinessProbes: []string{"ssh"}, firstDiskBus: "virtio"},
+		{model: "sros", cpuModel: "host-passthrough", ifaceModel: "e1000", machineType: "q35", minMemory: "5120Mi", transitional: true, tftp: true, bootstrapTransport: "tftp", readinessProbes: []string{"ssh", "ansible", "sros-license"}, firstDiskBus: "virtio"},
+		{model: "vjunos-router", cpuModel: "host-passthrough", ifaceModel: "virtio", machineType: "q35", minMemory: "5Gi", transitional: true, bootstrapTransport: "config-drive", readinessProbes: []string{"ssh", "ansible"}, firstDiskBus: "virtio"},
+		{model: "vjunos-switch", cpuModel: "host-passthrough", ifaceModel: "virtio", machineType: "q35", minMemory: "5Gi", transitional: true, bootstrapTransport: "config-drive", readinessProbes: []string{"ssh", "ansible"}, firstDiskBus: "virtio"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.model, func(t *testing.T) {
+			profile := kubeVirtHardwareProfileFor(tt.model, "registry.example.com/skyforge/kubevirt/"+tt.model+":test")
+			if profile.CPUModel != tt.cpuModel {
+				t.Fatalf("CPUModel got %q, want %q", profile.CPUModel, tt.cpuModel)
+			}
+			if profile.InterfaceModel != tt.ifaceModel {
+				t.Fatalf("InterfaceModel got %q, want %q", profile.InterfaceModel, tt.ifaceModel)
+			}
+			wantMgmt := tt.mgmtIfaceModel
+			if wantMgmt == "" {
+				wantMgmt = tt.ifaceModel
+			}
+			if got := kubeVirtMgmtInterfaceModel(tt.model); got != wantMgmt {
+				t.Fatalf("kubeVirtMgmtInterfaceModel got %q, want %q", got, wantMgmt)
+			}
+			if profile.MachineType != tt.machineType {
+				t.Fatalf("MachineType got %q, want %q", profile.MachineType, tt.machineType)
+			}
+			if profile.MinimumMemory != tt.minMemory {
+				t.Fatalf("MinimumMemory got %q, want %q", profile.MinimumMemory, tt.minMemory)
+			}
