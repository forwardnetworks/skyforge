+// kubeVirtBootstrapSecretKey is the data KEY used in the bootstrap secret, which (for a
+// secret-disk) becomes the filename inside the rendered ISO. ASAv requires
+// "day0-config" and n9kv CVAC requires "nxos_config.txt". IOS-XE and the
+// Viptela families use the generic cloudInitConfigDrive "userdata" key.
+func kubeVirtBootstrapSecretKey(model string) string {
+	return kubeVirtBootstrapSecretKeyFor(model, nil)
+}
+
+// kubeVirtIOSXEIsSDWANBootstrap reports whether an IOS-XE day-0 document is a
+// controller-mode cloud-init bootstrap rather than a CVAC startup-config. A
+// bootstrap netlab renders for a fabric EDGE (initial/cat8000v-kne.j2) is a
+// MIME multipart cloud-init document; Cisco's own generated file starts the
+// same way. CVAC text never does.
+func kubeVirtIOSXEIsSDWANBootstrap(userData []byte) bool {
+	head := bytes.TrimSpace(userData)
+	if len(head) > 512 {
+		head = head[:512]
+	}
+	return bytes.HasPrefix(head, []byte("Content-Type: multipart/mixed")) ||
+		bytes.HasPrefix(head, []byte("#cloud-config"))
+}
+
+// kubeVirtBootstrapSecretKeyFor is kubeVirtBootstrapSecretKey with the day-0
+// CONTENT in hand. For IOS-XE the file name is what selects the boot MODE:
+// iosxe_config.txt is applied by CVAC in autonomous mode, while the very same
+// cdrom carrying ciscosdwan_cloud_init.cfg boots the C8000V into controller
+// mode. Choosing by content keeps one Secret, one disk and one code path for
+// both, and means a topology that turns a cat8000v into an SD-WAN edge changes
+// nothing but the rendered day-0.
+func kubeVirtBootstrapSecretKeyFor(model string, userData []byte) string {
+	if kubeVirtIsASAv(model) {
+		return kubeVirtASAvDay0FileName
+	}
+	if kubeVirtIsIOSXE(model) {
+		if kubeVirtIOSXEIsSDWANBootstrap(userData) {
+			return kubeVirtIOSXESDWANBootstrapFileName
+		}
+		return kubeVirtIOSXECvacFileName
+	}
+	if kubeVirtIsNxos(model) {
+		return kubeVirtNxosCvacFileName
+	}
+	if kubeVirtIsVJunos(model) {
+		return kubeVirtVJunosDay0FileName
+	}
+	return kubeVirtBootstrapSecretDataKey
+}
