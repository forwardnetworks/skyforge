+		},
+	}
+	if diff := cmp.Diff(wantDisk, disk); diff != "" {
+		t.Fatalf("bootstrap disk mismatch (-want +got):\n%s", diff)
+	}
+	// n9kv reads a plain CVAC secret disk, not cloud-init (kubevirt.go, nxos
+	// bootstrap). So the volume is a secret source, never cloudInitConfigDrive.
+	if _, cloudInit := volume["cloudInitConfigDrive"]; cloudInit {
+		t.Fatalf("bootstrap volume = %#v, n9kv must not get a cloudInitConfigDrive source", volume)
+	}
+	source, ok := volume["secret"].(map[string]any)
+	if !ok {
+		t.Fatalf("bootstrap volume = %#v, want secret source", volume)
+	}
+	if got := source["secretName"]; got != secretName {
+		t.Fatalf("bootstrap secret name got %v, want %q", got, secretName)
+	}
