+func TestKubeVirtNxosBootstrapDiskAndVolume(t *testing.T) {
+	secretName := "nxos1-nxos-bootstrap"
+	disk, volume, secretData, err := kubeVirtNxosBootstrapDiskAndVolume(secretName, []byte("hostname nxos-test\n"))
+	if err != nil {
+		t.Fatalf("kubeVirtNxosBootstrapDiskAndVolume() failed: %v", err)
+	}
+	if len(secretData) == 0 {
+		t.Fatalf("bootstrap secret data is empty")
