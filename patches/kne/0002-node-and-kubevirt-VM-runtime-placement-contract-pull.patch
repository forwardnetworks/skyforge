+func kubeVirtF5BootstrapUserData(userData []byte) ([]byte, error) {
+	userData = bytes.TrimSpace(bytes.ReplaceAll(userData, []byte("\r\n"), []byte("\n")))
+	if len(userData) == 0 {
+		return nil, fmt.Errorf("f5-bigip tmos_declared user_data is empty")
+	}
+	if !bytes.HasPrefix(userData, []byte("#cloud-config\n")) {
+		return nil, fmt.Errorf("f5-bigip bootstrap must be Config Drive V2 #cloud-config user_data")
+	}
+	text := string(userData)
+	for _, required := range []string{"\ntmos_declared:", "\n  enabled: true", "\n  do_declaration:"} {
+		if !strings.Contains(text, required) {
+			return nil, fmt.Errorf("f5-bigip bootstrap is missing required tmos_declared field %q", strings.TrimSpace(required))
+		}
+	}
+	lower := strings.ToLower(text)
+	for _, forbidden := range []string{
+		"registrationkey",
+		"registration-key",
+		"regkey",
+		"bigiq",
+		"licensepool",
+		"poollicense",
+		"licensetype",
+		"password:",
+		"chpasswd:",
+		"ssh_authorized_keys:",
+	} {
+		if strings.Contains(lower, forbidden) {
+			return nil, fmt.Errorf("f5-bigip Config Drive V2 user_data must not contain licensing or credential field %q", forbidden)
+		}
+	}
+	return append(append([]byte{}, userData...), '\n'), nil
+}
