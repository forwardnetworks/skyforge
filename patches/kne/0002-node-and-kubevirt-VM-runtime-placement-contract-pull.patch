+func TestKubeVirtDellOS10SerialInjector(t *testing.T) {
+	n := &Impl{
+		Namespace: "test",
+		Proto: &topopb.Node{
+			Name:   "os101",
+			Vendor: topopb.Vendor_DELL,
+			Model:  "dellos10",
+			Config: &topopb.Config{
+				Image:      "registry.example.com/skyforge/kubevirt/vr-ftosv:10.6.1.1.67V-kne-r1",
+				ConfigData: &topopb.Config_Data{Data: []byte("hostname os101\ninterface ethernet1/1/1\n no shutdown\n")},
+			},
+		},
+	}
+	vm, err := n.kubeVirtVMObject()
+	if err != nil {
+		t.Fatalf("kubeVirtVMObject(dellos10 with config) unexpectedly errored (must not fail closed): %v", err)
+	}
+	disks, _, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "domain", "devices", "disks")
+	if err != nil {
+		t.Fatalf("reading disks: %v", err)
+	}
+	for _, d := range disks {
+		dm, _ := d.(map[string]any)
+		name, _ := dm["name"].(string)
+		if strings.Contains(name, "bootstrap") {
+			t.Fatalf("dellos10 VM must carry no bootstrap disk; found %q", name)
+		}
+	}
+
+	if got := kubeVirtDellOS10InjectorResourceName("os101"); got != "os101-os10-inject" {
+		t.Fatalf("injector resource name = %q, want os101-os10-inject", got)
+	}
+	if len(kubeVirtDellOS10InjectorResourceName(strings.Repeat("n", 80))) > 63 {
+		t.Fatalf("injector resource name exceeds 63 chars")
+	}
+	for _, want := range []string{
+		"virtctl console",
+		"ztd cancel",
+		"configure terminal",
+		"copy running-configuration startup-configuration",
+		"login:",
+	} {
+		if !strings.Contains(kubeVirtDellOS10InjectorScript, want) {
+			t.Fatalf("injector script missing vrnetlab step %q", want)
+		}
+	}
+	rules := kubeVirtDellOS10InjectorRoleRules()
+	foundConsole := false
+	for _, r := range rules {
+		for _, res := range r.Resources {
+			if res == "virtualmachineinstances/console" {
+				foundConsole = true
+			}
+		}
+	}
+	if !foundConsole {
+		t.Fatalf("injector Role missing virtualmachineinstances/console (virtctl console cannot attach)")
+	}
+}
