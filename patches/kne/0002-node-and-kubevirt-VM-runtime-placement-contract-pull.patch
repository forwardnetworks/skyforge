+func TestKubeVirtVJunosSMBIOSHookScriptStampsVMXProductAndLabFamily(t *testing.T) {
+	script := kubeVirtVJunosSMBIOSHookScript("vjunos-router")
+	if strings.Contains(script, "\t") {
+		t.Fatal("hook script must not contain tabs")
+	}
+	if !strings.Contains(script, `PRODUCT = "VM-VMX"`) {
+		t.Fatal("vjunos hook script does not stamp product=VM-VMX")
+	}
+	if !strings.Contains(script, `FAMILY = "lab"`) {
+		t.Fatal("vjunos hook script does not stamp family=lab")
+	}
+	if !strings.Contains(script, `upsert_system_entry(system, "product", PRODUCT)`) {
+		t.Fatal("vjunos hook script does not upsert the product SMBIOS entry")
+	}
+	// SR-OS's script REMOVES family to match stock vr-sros's shape. For vJunos family
+	// IS the PFE selector: removing it puts the wrapper straight back on the perf path.
+	if !strings.Contains(script, `upsert_system_entry(system, "family", FAMILY)`) {
+		t.Fatal("vjunos hook script must SET family, not remove it -- family=lab selects the lab PFE")
+	}
+	if strings.Contains(script, "remove_system_entries") {
+		t.Fatal("vjunos hook script must not strip KubeVirt's own SMBIOS identity entries")
+	}
+	// The proven-working sysinfo kept KubeVirt's manufacturer/serial/uuid alongside
+	// product/family. Nothing about removing virtio devices was part of that.
+	if strings.Contains(script, "remove_unused_virtio_devices") {
+		t.Fatal("vjunos hook script must not carry the SR-OS virtio-device trim")
+	}
+	if !strings.Contains(script, `smbios.set("mode", "sysinfo")`) {
+		t.Fatal("vjunos hook script does not put the domain in sysinfo SMBIOS mode")
+	}
+	if !strings.Contains(script, `sysinfo.set("type", "smbios")`) {
+		t.Fatal("vjunos hook script does not declare the sysinfo block as smbios")
+	}
+	// Static by construction: no node name, no TFTP host, no license, no variant.
+	for _, forbidden := range []string{"TIMOS", "license-file", "primary-config", "tftp://"} {
+		if strings.Contains(script, forbidden) {
+			t.Fatalf("vjunos hook script leaked SR-OS-only content %q", forbidden)
+		}
+	}
+}
