+const kubeVirtBootstrapTFTPServerScript = `#!/usr/bin/env python3
+import os
+import socket
+import struct
+import sys
+import threading
+
+ROOT = sys.argv[1] if len(sys.argv) > 1 else "/tftpboot"
+BLOCK_SIZE = 512
+
+def safe_path(name):
+    name = name.lstrip("/").replace("\\", "/")
+    path = os.path.abspath(os.path.join(ROOT, name))
+    root = os.path.abspath(ROOT)
+    if path != root and not path.startswith(root + os.sep):
+        raise FileNotFoundError(name)
+    return path
+
+def encode_netascii(data):
+    out = bytearray()
+    idx = 0
+    while idx < len(data):
+        ch = data[idx]
+        if ch == 0x0a:
+            out.extend(b"\r\n")
+        elif ch == 0x0d:
+            if idx + 1 < len(data) and data[idx + 1] == 0x0a:
+                out.extend(b"\r\n")
+                idx += 1
+            else:
+                out.extend(b"\r\0")
+        else:
+            out.append(ch)
+        idx += 1
+    return bytes(out)
+
+def serve_rrq(addr, filename, mode):
+    try:
+        print(f"RRQ {filename} mode={mode} from {addr[0]}:{addr[1]}", flush=True)
+        with open(safe_path(filename), "rb") as fh:
+            payload = fh.read()
+            if mode.lower() == "netascii":
+                payload = encode_netascii(payload)
+            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+            sock.settimeout(5)
+            block = 1
+            offset = 0
+            while True:
+                data = payload[offset:offset + BLOCK_SIZE]
+                packet = struct.pack("!HH", 3, block) + data
+                for _ in range(5):
+                    sock.sendto(packet, addr)
+                    try:
+                        ack, ack_addr = sock.recvfrom(516)
+                    except socket.timeout:
+                        continue
+                    if ack_addr == addr and len(ack) >= 4 and struct.unpack("!HH", ack[:4]) == (4, block):
+                        break
+                if len(data) < BLOCK_SIZE:
+                    return
+                offset += BLOCK_SIZE
+                block = (block + 1) % 65536
+    except Exception as exc:
+        print(f"ERROR {filename} from {addr[0]}:{addr[1]}: {exc}", flush=True)
+        err = str(exc).encode()[:120]
+        packet = struct.pack("!HH", 5, 1) + err + b"\0"
+        socket.socket(socket.AF_INET, socket.SOCK_DGRAM).sendto(packet, addr)
+
+def main():
+    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    sock.bind(("0.0.0.0", 69))
+    while True:
+        packet, addr = sock.recvfrom(516)
+        if len(packet) < 4:
+            continue
+        opcode = struct.unpack("!H", packet[:2])[0]
+        if opcode != 1:
+            continue
+        parts = packet[2:].split(b"\0")
+        if not parts:
+            continue
+        filename = parts[0].decode(errors="ignore")
+        mode = parts[1].decode(errors="ignore") if len(parts) > 1 and parts[1] else "octet"
+        threading.Thread(target=serve_rrq, args=(addr, filename, mode), daemon=True).start()
+
+if __name__ == "__main__":
+    main()
+`
