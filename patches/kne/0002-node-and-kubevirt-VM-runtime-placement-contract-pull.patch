+// kneStartupPersistenceStorageClass resolves the StorageClass for the per-node writable
+// startup-config PVC, from the environment so gitops can retarget it without a rebuild.
+//
+// WHY the class must be named explicitly instead of being left to the cluster: skyforge
+// clusters mark NO default StorageClass. Several classes exist (local-path, longhorn,
+// longhorn-static) but none carries the storageclass.kubernetes.io/is-default-class
+// annotation, so a PVC created with no storageClassName is never provisioned — it stays
+// Pending forever, and the node Pod that mounts it never schedules. (XRd was the first NOS
+// to hit this, because netlab patch 0009 moved its config_path to /config, which is on the
+// writableStartupConfigPaths allow-list and so takes this PVC path.)
+//
+// WHY local-path and not longhorn: skyforge lab nodes join over the WireGuard hub, and
+// Longhorn replication over WireGuard is banned on this cluster. A per-node startup-config
+// is node-local scratch state anyway — it is re-seeded from the ConfigMap whenever absent —
+// so local-path is both the sanctioned and the correct class.
+//
+// An EMPTY (but set) knob is meaningful and honored: it returns nil, which omits
+// storageClassName entirely and restores upstream behaviour of deferring to the cluster
+// default. That keeps this patch backwards-compatible on clusters that DO mark a default.
+// os.LookupEnv (not os.Getenv) is what makes "explicitly blanked" distinguishable from
+// "unset"; unset falls back to DefaultStartupPersistenceStorageClass.
+func kneStartupPersistenceStorageClass() *string {
+	for _, name := range []string{"SKYFORGE_KNE_STARTUP_PERSISTENCE_STORAGE_CLASS", "KNE_STARTUP_PERSISTENCE_STORAGE_CLASS"} {
+		raw, ok := os.LookupEnv(name)
+		if !ok {
+			continue
+		}
+		if class := strings.TrimSpace(raw); class != "" {
+			return &class
+		}
+		return nil
+	}
+	class := DefaultStartupPersistenceStorageClass
+	return &class
+}
