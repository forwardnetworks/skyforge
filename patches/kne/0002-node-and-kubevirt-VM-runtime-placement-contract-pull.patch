+		// KASLR selftest immediately after "Poking KASLR using RDRAND RDTSC..."
+		// — same boot loop as nxos had before EFI was enabled. EFI (OVMF) boot
+		// uses the EFI memory map which avoids the BIOS-mode KASLR path.
+		// Pin q35 explicitly so the ASAv boot contract is declarative rather
+		// than relying on the KubeVirt cluster's default machine type.
+		MachineType: "q35",
+		Firmware: map[string]any{
+			"bootloader": map[string]any{
+				"efi": map[string]any{
+					"secureBoot": false,
+				},
+			},
+		},
+		// Keep the existing operator-managed ASAv capability admission lane.
+		// CPU vendor is deliberately unrestricted for the KubeVirt VM.
+		RequiredNodeSelector: map[string]string{
+			"skyforge.example.com/kne-asav-capable": "true",
+		},
+		// 4 vCPU floor. On 1 shared vCPU lina's control-plane thread starves
+		// and the ASA watchdog aborts the box ("Abort due to watchdog bark",
+		// watchdog_time 15000ms -- serial console 2026-08-28, deployment
+		// 544407ce / probe 5e3ee4ef). Mirrors the nxos and a10/vThunder
+		// MinimumCPU fixes; ASAv30 is a 4-vCPU appliance. The scheduler-side
+		// guarantee is the cisco_asav entry in the server's
+		// kneVMHardwareFloors.
+		MinimumCPU:         4,
+		MinimumMemory:      "4Gi",
+		BootstrapTransport: "config-drive",
+		IdentityInputs:     []string{"model"},
+		ReadinessProbes:    []string{"ssh"},
+		ConfigApplyRequires: []string{
+			"VMReady",
+			"ApplianceBootstrapAccepted",
+			"ManagementReady",
+		},
+		// SATA disk: universally supported in both BIOS and EFI boot paths.
+		// The virtio-blk-pci-non-transitional (PCI device ID 0x1042) presented
+		// with pc machine type was not causing the KASLR crash directly, but
+		// SATA avoids any virtio compatibility issue on the q35+EFI path.
+		ContainerDisks: []kubeVirtContainerDiskSpec{{
+			Name: "containerdisk",
+			Bus:  "sata",
+			Path: "",
+		}},
+	},
+	"dellos10": {
+		BootstrapTransport:  "image-owned",
+		IdentityInputs:      []string{"model"},
+		ReadinessProbes:     []string{"ssh"},
+		ConfigApplyRequires: []string{"VMReady", "ManagementReady"},
+		ContainerDisks: []kubeVirtContainerDiskSpec{
+			{Name: "containerdisk", Bus: "sata", Path: "/disk/disk.qcow2"},
+			{Name: "installerdisk", Bus: "virtio", Path: "/disk/hdb_OS10-installer.qcow2"},
+			{Name: "platformdisk", Bus: "virtio", Path: "/disk/hdc_OS10-platform.qcow2"},
+		},
+	},
+	"fortios": {
+		// virtio ON BOTH PLANES. e1000 here recorded no reason (0047/0048 left it
+		// alone for want of a boot test) and it cost LLDP: QEMU's e1000 receive
+		// filter does not pass the LLDP group 01:80:c2:00:00:0e to the guest even
+		// with the bridge forwarding it (group_fwd_mask 0x4000, set by the
+		// vm-bridge-agent on every k6t-* bridge), while OSPF multicast is
+		// delivered. Measured 2026-10-02 on demo-lab FortiOS 7.0.9: the
+		// FortiGates TRANSMIT LLDP (A10, PAN-OS and IOS peers list them) and
+		// receive none; `diagnose hardware deviceinfo nic port2` says driver
+		// e1000. vSRX and A10 are virtio and receive. Cause strongly supported,
+		// not proven until the virtio boot test in UPSTREAM.md is run.
+		//
+		// NOT the 0047 split (virtio data, e1000 management): 0049 measured that
+		// guests which name NICs by driver probe order swap them when the two
+		// planes use different drivers, and netlab renders `edit port1 / set mode
+		// dhcp` for the masquerade NIC. One driver on every NIC keeps port1 the
+		// management NIC by construction.
+		//
+		// RISK TO PROVE ON A LIVE BOOT: the Viptela DHCP defect (0047) -- the
+		// masquerade OFFER carries an uncomputed UDP checksum when the tap
+		// advertises TX offload (virtio) -- could hit FortiOS's DHCP client. If
+		// port1 gets no lease on virtio, the fallback is the split plus a check
+		// that port1 is still the masquerade NIC, not a return to silent e1000.
+		InterfaceModel:      "virtio",
+		BootstrapTransport:  "image-owned",
+		IdentityInputs:      []string{"model"},
+		ReadinessProbes:     []string{"ssh"},
+		ConfigApplyRequires: []string{"VMReady", "ManagementReady"},
+		// FortiOS is the ONE image whose qcow2 sits at the image ROOT
+		// ("/fortios-<version>.qcow2") with no "/disk/" directory. KubeVirt's
+		// auto-discovery (Path "") looks for a "disk/" directory inside the
+		// ImageVolume mount and picks the single file within it -- that is
+		// what every other profile's image provides (panos, a10, asav:
+		// disk_0/disk/disk.qcow2). For FortiOS it finds no such directory and
+		// fails deterministically with "failed to check ImageVolume path
+		// .../disk_0/disk: no such file or directory". Measured 2026-09-14 by
+		// exec'ing into the launcher pods of a working panos VM and a failing
+		// FortiOS VM and listing /var/run/kubevirt-image-volume/disk_0/.
+		//
+		// So the path MUST be derived. kubeVirtContainerDiskPath (below) does
+		// that from the image tag; its one real defect -- reading the digest
+		// hex as the tag on a digest-pinned reference -- is fixed there, not
+		// here. An earlier attempt swapped this to Path "" to sidestep that
+		// defect, which traded a wrong filename for a wrong directory and
+		// stopped every FortiOS VM from booting at all.
+		ContainerDisks: []kubeVirtContainerDiskSpec{{
+			Name: "containerdisk",
+			Bus:  "virtio",
+			Path: kubeVirtDynamicContainerDiskPath,
+		}},
+	},
+	"f5-bigip": {
+		CPUModel:           "host-passthrough",
+		InterfaceModel:     "virtio",
+		MachineType:        "q35",
+		MinimumCPU:         4,
+		MinimumMemory:      "12Gi",
+		PersistentRoot:     true,
+		SlotBound:          true,
+		BootstrapTransport: "config-drive-v2/tmos-declared",
+		IdentityInputs: []string{
+			"firmware-uuid",
+			"management-mac",
+			"persistent-root-pvc",
+		},
+		ReadinessProbes: []string{
+			"management-authentication",
+			"active-non-expired-license",
+			"required-provisioning",
+			"mcpd-tmm-usable",
+			"tmsh-read-only-query",
+		},
+		ConfigApplyRequires: []string{
+			"VMReady",
+			"ApplianceIdentityReady",
+			"ApplianceBootstrapAccepted",
+			"ManagementAuthenticated",
