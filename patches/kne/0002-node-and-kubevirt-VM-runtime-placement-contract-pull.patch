+func kubeVirtF5SlotIdentityFromNode(proto *tpb.Node) (kubeVirtF5SlotIdentity, error) {
+	if proto == nil || proto.GetConfig() == nil {
+		return kubeVirtF5SlotIdentity{}, fmt.Errorf("f5-bigip requires a slot config")
+	}
+	env := proto.GetConfig().GetEnv()
+	identity := kubeVirtF5SlotIdentity{
+		FirmwareUUID:  strings.ToLower(strings.TrimSpace(env[kubeVirtF5SlotUUIDEnv])),
+		ManagementMAC: strings.ToLower(strings.TrimSpace(env[kubeVirtF5ManagementMACEnv])),
+		RootPVC:       strings.TrimSpace(env[kubeVirtF5RootPVCEnv]),
+	}
+	if !kubeVirtIsCanonicalUUID(identity.FirmwareUUID) || identity.FirmwareUUID == kubeVirtSrosPlaceholderUUID {
+		return kubeVirtF5SlotIdentity{}, fmt.Errorf("f5-bigip slot %s must be a non-zero canonical UUID", kubeVirtF5SlotUUIDEnv)
+	}
+	hw, err := net.ParseMAC(identity.ManagementMAC)
+	if err != nil || len(hw) != 6 || hw[0]&1 != 0 || hw[0]&2 == 0 {
+		return kubeVirtF5SlotIdentity{}, fmt.Errorf("f5-bigip slot %s must be a locally administered unicast MAC", kubeVirtF5ManagementMACEnv)
+	}
+	identity.ManagementMAC = strings.ToLower(hw.String())
+	if errs := validation.IsDNS1123Subdomain(identity.RootPVC); len(errs) > 0 {
+		return kubeVirtF5SlotIdentity{}, fmt.Errorf("f5-bigip slot %s must name an existing PVC: %s", kubeVirtF5RootPVCEnv, strings.Join(errs, "; "))
