+func (n *Impl) ensureImagePullSecret(ctx context.Context) error {
+	secretName := kneImagePullSecretName()
+	if secretName == "" || n == nil || n.KubeClient == nil {
+		return nil
+	}
+	srcNamespace := strings.TrimSpace(os.Getenv("SKYFORGE_KNE_IMAGE_PULL_SECRET_SOURCE_NAMESPACE"))
+	if srcNamespace == "" {
+		srcNamespace = "skyforge"
+	}
+
+	core := n.KubeClient.CoreV1()
+	if _, err := core.Secrets(n.Namespace).Get(ctx, secretName, metav1.GetOptions{}); err == nil {
+		return nil
+	} else if !apierrors.IsNotFound(err) {
+		return err
+	}
+
+	srcSecret, err := core.Secrets(srcNamespace).Get(ctx, secretName, metav1.GetOptions{})
+	if err != nil {
+		if apierrors.IsNotFound(err) {
+			return nil
+		}
+		return err
+	}
+	dstSecret := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      secretName,
+			Namespace: n.Namespace,
+		},
+		Type: srcSecret.Type,
+		Data: srcSecret.Data,
+	}
+	if _, err := core.Secrets(n.Namespace).Create(ctx, dstSecret, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+	}
+
+	for i := 0; i < 40; i++ {
+		sa, err := core.ServiceAccounts(n.Namespace).Get(ctx, "default", metav1.GetOptions{})
+		if err != nil {
+			if apierrors.IsNotFound(err) {
+				time.Sleep(250 * time.Millisecond)
+				continue
+			}
+			return err
+		}
+		refs := append([]corev1.LocalObjectReference{}, sa.ImagePullSecrets...)
+		seen := false
+		for _, ref := range refs {
+			if strings.TrimSpace(ref.Name) == secretName {
+				seen = true
+				break
+			}
+		}
+		if !seen {
+			updateErr := retry.RetryOnConflict(retry.DefaultRetry, func() error {
+				current, err := core.ServiceAccounts(n.Namespace).Get(ctx, "default", metav1.GetOptions{})
+				if err != nil {
+					return err
+				}
+				refs = append([]corev1.LocalObjectReference{}, current.ImagePullSecrets...)
+				seen := false
+				for _, ref := range refs {
+					if strings.TrimSpace(ref.Name) == secretName {
+						seen = true
+						break
+					}
+				}
+				if seen {
+					return nil
+				}
+				current.ImagePullSecrets = append(refs, corev1.LocalObjectReference{Name: secretName})
+				_, err = core.ServiceAccounts(n.Namespace).Update(ctx, current, metav1.UpdateOptions{})
+				return err
+			})
+			if updateErr != nil {
+				return updateErr
+			}
+		}
+		return nil
+	}
+	return fmt.Errorf("default serviceaccount not ready in topology namespace %s", n.Namespace)
+}
