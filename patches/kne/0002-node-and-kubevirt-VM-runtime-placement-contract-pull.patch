+func startupPVCName(nodeName string) string {
+	normalized := strings.Map(func(r rune) rune {
+		switch {
+		case r >= 'a' && r <= 'z':
+			return r
+		case r >= 'A' && r <= 'Z':
+			return r + ('a' - 'A')
+		case r >= '0' && r <= '9':
+			return r
+		default:
+			return '-'
+		}
+	}, strings.TrimSpace(nodeName))
+	normalized = strings.Trim(normalized, "-")
+	if normalized == "" {
+		normalized = "node"
+	}
+	const prefix = "startup-config-"
+	name := prefix + normalized
+	if len(name) <= 63 {
+		return name
+	}
+	hash := fnv.New32a()
+	_, _ = hash.Write([]byte(nodeName))
+	suffix := fmt.Sprintf("-%08x", hash.Sum32())
+	maxBase := 63 - len(prefix) - len(suffix)
+	if maxBase < 1 {
+		maxBase = 1
+	}
+	return prefix + normalized[:maxBase] + suffix
+}
