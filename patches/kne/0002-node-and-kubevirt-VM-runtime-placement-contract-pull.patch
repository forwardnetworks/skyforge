+func (n *Impl) ensureKubeVirtBootstrapBundles(ctx context.Context, labels map[string]string) error {
+	if n == nil || n.Proto == nil || n.Proto.Config == nil || len(n.Proto.Config.GetBootstrapBundles()) == 0 {
+		return nil
+	}
+	core := n.KubeClient.CoreV1()
+	sourceNamespace := kubeVirtBootstrapBundleSourceNamespace()
+	seenNames := map[string]struct{}{}
+	for _, bundle := range n.Proto.Config.GetBootstrapBundles() {
+		if _, _, err := kubeVirtBootstrapBundleDiskAndVolume(n.Name(), bundle); err != nil {
+			return err
+		}
+		targetName := kubeVirtBootstrapBundleResourceName(n.Name(), bundle.GetName())
+		if _, duplicate := seenNames[targetName]; duplicate {
+			return fmt.Errorf("bootstrap bundle %q produces duplicate target %q", bundle.GetName(), targetName)
+		}
+		seenNames[targetName] = struct{}{}
+
+		source, err := core.Secrets(sourceNamespace).Get(ctx, bundle.GetSecretName(), metav1.GetOptions{})
+		if err != nil {
+			return fmt.Errorf("bootstrap bundle %q source secret %s/%s: %w", bundle.GetName(), sourceNamespace, bundle.GetSecretName(), err)
+		}
+		projected := map[string][]byte{}
+		seenKeys := map[string]struct{}{}
+		for _, key := range bundle.GetRequiredKeys() {
+			key = strings.TrimSpace(key)
+			if key == "" {
+				return fmt.Errorf("bootstrap bundle %q contains an empty required key", bundle.GetName())
+			}
+			if _, duplicate := seenKeys[key]; duplicate {
+				return fmt.Errorf("bootstrap bundle %q repeats required key %q", bundle.GetName(), key)
+			}
+			seenKeys[key] = struct{}{}
+			value, ok := source.Data[key]
+			if !ok || len(bytes.TrimSpace(value)) == 0 {
+				return fmt.Errorf("bootstrap bundle %q source secret %s/%s is missing non-empty key %q", bundle.GetName(), sourceNamespace, bundle.GetSecretName(), key)
+			}
+			projected[key] = append([]byte(nil), value...)
+		}
+		target := &corev1.Secret{
+			ObjectMeta: metav1.ObjectMeta{
+				Name:      targetName,
+				Namespace: n.Namespace,
+				Labels:    labels,
+			},
+			Type: corev1.SecretTypeOpaque,
+			Data: projected,
+		}
+		secrets := core.Secrets(n.Namespace)
+		if _, err := secrets.Create(ctx, target, metav1.CreateOptions{}); err != nil {
+			if !apierrors.IsAlreadyExists(err) {
+				return err
+			}
+			current, err := secrets.Get(ctx, targetName, metav1.GetOptions{})
+			if err != nil {
+				return err
+			}
+			current.Labels = labels
+			current.Type = corev1.SecretTypeOpaque
+			current.Data = projected
+			if _, err := secrets.Update(ctx, current, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
