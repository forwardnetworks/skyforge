+func TestIsRetryableKubeVirtAdmissionError(t *testing.T) {
+	cases := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{
+			name: "mutator deadline",
+			err:  errors.New(`failed calling webhook "virtualmachines-mutator.kubevirt.io": context deadline exceeded`),
+			want: true,
+		},
+		{
+			name: "sandbox name reserved",
+			err:  errors.New(`failed to reserve sandbox name "abc": name "abc" is reserved for "def"`),
+			want: true,
+		},
+		{
+			name: "grpc stream cancel",
+			err:  errors.New("rpc error: code = DeadlineExceeded desc = stream terminated by RST_STREAM with error code: CANCEL"),
+			want: true,
+		},
+		{
+			name: "unrelated",
+			err:  errors.New("something else"),
+			want: false,
+		},
+	}
+	for _, tc := range cases {
+		if got := isRetryableKubeVirtAdmissionError(tc.err); got != tc.want {
+			t.Fatalf("%s: isRetryableKubeVirtAdmissionError()=%v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
