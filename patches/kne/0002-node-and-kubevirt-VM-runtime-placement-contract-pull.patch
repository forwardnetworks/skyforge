+package node
+
+import (
+	"testing"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+)
+
+// TestKubeVirtDataInterfaceMACEnvNameSanitizesInterfaceNames pins the
+// env-key derivation kubeVirtDataInterfaceMAC relies on: a name with slashes
+// (the PAN-OS convention, "ethernet1/1") must turn into a legal env var name.
+func TestKubeVirtDataInterfaceMACEnvNameSanitizesInterfaceNames(t *testing.T) {
+	cases := map[string]string{
+		"ethernet1/1": "SKYFORGE_DATA_MAC_ETHERNET1_1",
+		"eth0":        "SKYFORGE_DATA_MAC_ETH0",
+		"Gi0/1":       "SKYFORGE_DATA_MAC_GI0_1",
+	}
+	for in, want := range cases {
+		if got := kubeVirtDataInterfaceMACEnvName(in); got != want {
+			t.Errorf("kubeVirtDataInterfaceMACEnvName(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+// TestKubeVirtInterfacesPinsDataInterfaceMACFromEnv is the end-to-end pin: a
+// data interface named "ethernet1/1" with SKYFORGE_DATA_MAC_ETHERNET1_1 set
+// in kne.env gets that macAddress on its kubeVirtInterfaces entry, and a
+// data interface with no matching env var gets none at all (today's
+// default, unpinned, behaviour) -- generalizing the F5-only management-MAC
+// override to any model and to data NICs.
+//
+// proto.Interfaces is keyed by the Linux-safe KubeVirt/domain-XML interface
+// identifier ("eth1"/"eth2", what KNE assigns as int_name and what
+// kubeVirtDataInterfaces resolves and returns), NOT by the vendor name --
+// topo.proto's own comment on Interface.name says as much ("Name of the
+// interface provided by Node implementation ... vendor specific name",
+// distinct from int_name, "Assigned by KNE"). An earlier version of this
+// test used the vendor name as the map key too, which accidentally made
+// kubeVirtDataInterfaces's map-key fallback return the vendor name and
+// masked a real bug: kubeVirtInterfaces was looking up the MAC by the
+// "eth1"-style identifier, never the vendor name a kne.env pin is spelled
+// against, so it silently never matched, confirmed live on demo-lab.
+func TestKubeVirtInterfacesPinsDataInterfaceMACFromEnv(t *testing.T) {
+	proto := &tpb.Node{
+		Name:  "us-west-2-pan-fw1",
+		Model: "panos",
+		Config: &tpb.Config{
+			Env: map[string]string{
+				"SKYFORGE_DATA_MAC_ETHERNET1_1": "06:DC:79:C1:B1:FD",
+			},
+		},
+		Interfaces: map[string]*tpb.Interface{
+			"eth1": {Name: "ethernet1/1", IntName: "eth1"},
+			"eth2": {Name: "ethernet1/2", IntName: "eth2"},
+		},
+	}
+
+	interfaces := kubeVirtInterfaces("user-alice-demo-lab", proto)
+
+	pinned := findNamedF5Item(t, interfaces, "eth1")
+	if got, want := pinned["macAddress"], "06:dc:79:c1:b1:fd"; got != want {
+		t.Errorf("eth1 (vendor name ethernet1/1) macAddress = %v, want %v (lower-cased)", got, want)
+	}
+
+	unpinned := findNamedF5Item(t, interfaces, "eth2")
+	if _, present := unpinned["macAddress"]; present {
+		t.Errorf("eth2 (vendor name ethernet1/2) got a macAddress %v, want none set (no matching env var)", unpinned["macAddress"])
+	}
+}
+
+// TestKubeVirtVendorInterfaceNameFallsBackWhenUndeclared confirms the
+// helper degrades to the KubeVirt-identifier string itself (never panics or
+// returns empty) when a device declares no Interfaces map at all, or no
+// entry for the given identifier -- kubeVirtDataInterfaceMAC then simply
+// finds no matching env var and the interface stays unpinned, same as today.
+func TestKubeVirtVendorInterfaceNameFallsBackWhenUndeclared(t *testing.T) {
+	proto := &tpb.Node{Name: "n1"}
+	if got, want := kubeVirtVendorInterfaceName(proto, "eth1"), "eth1"; got != want {
+		t.Errorf("kubeVirtVendorInterfaceName with no Interfaces map = %q, want %q", got, want)
+	}
+
+	proto.Interfaces = map[string]*tpb.Interface{"eth1": {IntName: "eth1"}} // no vendor Name set
+	if got, want := kubeVirtVendorInterfaceName(proto, "eth1"), "eth1"; got != want {
+		t.Errorf("kubeVirtVendorInterfaceName with empty vendor Name = %q, want %q", got, want)
+	}
+}
+
+// TestKubeVirtDataInterfaceMACRejectsMalformedValue confirms a garbage env
+// value is silently ignored (falls back to unpinned) rather than producing
+// a broken interface definition KubeVirt would reject at apply time.
+func TestKubeVirtDataInterfaceMACRejectsMalformedValue(t *testing.T) {
+	proto := &tpb.Node{
+		Name: "n1",
+		Config: &tpb.Config{
+			Env: map[string]string{
+				"SKYFORGE_DATA_MAC_ETH0": "not-a-mac",
+			},
+		},
+	}
+	if got := kubeVirtDataInterfaceMAC(proto, "eth0"); got != "" {
+		t.Errorf("kubeVirtDataInterfaceMAC with malformed env value = %q, want empty", got)
+	}
+}
diff --git a/topo/node/kubevirt_f5_test.go b/topo/node/kubevirt_f5_test.go
new file mode 100644
index 0000000..814bccb
--- /dev/null
+++ b/topo/node/kubevirt_f5_test.go
@@ -0,0 +1,169 @@
+package node
+
+import (
+	"strings"
+	"testing"
+
+	topopb "github.com/openconfig/kne/proto/topo"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+)
+
+const f5SafeCloudConfig = `#cloud-config
+tmos_declared:
+  enabled: true
+  icontrollx_trusted_sources: true
+  icontrollx_package_urls:
+    - https://artifacts.example.invalid/f5/declarative-onboarding.rpm
+  do_declaration:
+    schemaVersion: 1.0.0
+    class: Device
+    async: true
+    Common:
+      class: Tenant
+      provisioningLevels:
+        class: Provision
+        ltm: nominal
+`
+
+func f5TestNode() *Impl {
+	return &Impl{
+		Namespace: "f5-slots",
+		Proto: &topopb.Node{
+			Name:   "f5-slot-001",
+			Vendor: topopb.Vendor_F5,
+			Model:  "f5-bigip",
+			Config: &topopb.Config{
+				Image: "registry.example.invalid/skyforge/f5-bigip:17.5.1.5-0.0.6",
+				ConfigData: &topopb.Config_Data{
+					Data: []byte(f5SafeCloudConfig),
+				},
+				Env: map[string]string{
+					kubeVirtF5SlotUUIDEnv:      "12345678-1234-1234-1234-123456789abc",
+					kubeVirtF5ManagementMACEnv: "02:00:00:00:00:01",
+					kubeVirtF5RootPVCEnv:       "f5-slot-001-root",
+				},
+			},
+			Interfaces: map[string]*topopb.Interface{
+				"eth2": {IntName: "eth2"},
+				"eth1": {IntName: "eth1"},
+			},
+		},
+	}
+}
+
+func findNamedF5Item(t *testing.T, items []any, name string) map[string]any {
+	t.Helper()
+	for _, item := range items {
+		asMap, ok := item.(map[string]any)
+		if ok && asMap["name"] == name {
+			return asMap
+		}
+	}
+	t.Fatalf("item %q not found in %#v", name, items)
+	return nil
+}
+
+func TestKubeVirtF5HardwareProfile(t *testing.T) {
+	profile := kubeVirtHardwareProfileFor("f5-bigip", "registry.example.invalid/skyforge/f5-bigip:test")
+	if profile.MinimumCPU != 4 || profile.MinimumMemory != "12Gi" {
+		t.Fatalf("BIG-IP resources = %d/%s, want 4/12Gi", profile.MinimumCPU, profile.MinimumMemory)
+	}
+	if profile.CPUModel != "host-passthrough" || profile.InterfaceModel != "virtio" || profile.MachineType != "q35" {
+		t.Fatalf("BIG-IP hardware profile = %#v", profile)
+	}
+	if !profile.PersistentRoot || !profile.SlotBound {
+		t.Fatalf("BIG-IP must be a persistent slot profile: %#v", profile)
+	}
+	if profile.BootstrapTransport != "config-drive-v2/tmos-declared" {
+		t.Fatalf("BIG-IP bootstrap transport = %q", profile.BootstrapTransport)
+	}
+	if len(profile.ContainerDisks) != 1 || profile.ContainerDisks[0].Path != "/disk/disk.qcow2" || profile.ContainerDisks[0].Bus != "virtio" {
+		t.Fatalf("BIG-IP source disk contract = %#v", profile.ContainerDisks)
+	}
+}
+
+func TestKubeVirtF5BootstrapUsesConfigDriveAndRejectsSecrets(t *testing.T) {
+	disk, volume, data, err := kubeVirtF5BootstrapDiskAndVolume("f5-slot-001-bootstrap", []byte(f5SafeCloudConfig))
+	if err != nil {
+		t.Fatalf("kubeVirtF5BootstrapDiskAndVolume() failed: %v", err)
+	}
+	if _, ok := disk["cdrom"]; !ok {
+		t.Fatalf("BIG-IP bootstrap disk is not a CD-ROM: %#v", disk)
+	}
+	if _, ok := volume["cloudInitConfigDrive"]; !ok {
+		t.Fatalf("BIG-IP bootstrap does not use Config Drive V2: %#v", volume)
+	}
+	if _, ok := volume["secret"]; ok {
+		t.Fatalf("BIG-IP bootstrap must not use the generic root secret-disk: %#v", volume)
+	}
+	if !strings.Contains(string(data), "tmos_declared:") {
+		t.Fatalf("BIG-IP bootstrap lost tmos_declared: %q", data)
+	}
+
+	for _, forbidden := range []string{
+		f5SafeCloudConfig + "    registrationKey: AAAA-BBBB-CCCC\n",
+		f5SafeCloudConfig + "password: forbidden\n",
+		f5SafeCloudConfig + "    bigIqHost: forbidden.example.invalid\n",
+	} {
+		if _, err := kubeVirtF5BootstrapUserData([]byte(forbidden)); err == nil {
+			t.Fatalf("secret-bearing BIG-IP user-data was accepted: %q", forbidden)
+		}
+	}
+}
+
+func TestKubeVirtF5VMObjectPinsSlotIdentityAndPersistentRoot(t *testing.T) {
+	n := f5TestNode()
+	if !n.UsesKubeVirtVM() {
+		t.Fatal("canonical skyforge/f5-bigip image did not select KubeVirt")
+	}
+	vm, err := n.kubeVirtVMObject()
+	if err != nil {
+		t.Fatalf("kubeVirtVMObject() failed: %v", err)
+	}
+
+	firmware, found, err := unstructured.NestedMap(vm.Object, "spec", "template", "spec", "domain", "firmware")
+	if err != nil || !found || firmware["uuid"] != "12345678-1234-1234-1234-123456789abc" {
+		t.Fatalf("BIG-IP firmware identity = %#v, found=%v err=%v", firmware, found, err)
+	}
+	interfaces, found, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "domain", "devices", "interfaces")
+	if err != nil || !found || len(interfaces) != 3 {
+		t.Fatalf("BIG-IP interfaces = %#v, found=%v err=%v", interfaces, found, err)
+	}
+	management := findNamedF5Item(t, interfaces, "default")
+	if management["macAddress"] != "02:00:00:00:00:01" || management["model"] != "virtio" {
+		t.Fatalf("BIG-IP management interface = %#v", management)
+	}
+	if findNamedF5Item(t, interfaces, "eth1")["model"] != "virtio" || findNamedF5Item(t, interfaces, "eth2")["model"] != "virtio" {
+		t.Fatalf("BIG-IP data interfaces are not virtio: %#v", interfaces)
+	}
+
+	volumes, found, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "volumes")
+	if err != nil || !found {
+		t.Fatalf("BIG-IP volumes missing: found=%v err=%v", found, err)
+	}
+	root := findNamedF5Item(t, volumes, "containerdisk")
+	pvc, ok := root["persistentVolumeClaim"].(map[string]any)
+	if !ok || pvc["claimName"] != "f5-slot-001-root" {
+		t.Fatalf("BIG-IP root is not the slot PVC: %#v", root)
+	}
+	if _, ok := root["containerDisk"]; ok {
+		t.Fatalf("BIG-IP licensed root must not be an ephemeral containerDisk volume: %#v", root)
+	}
+	bootstrap := findNamedF5Item(t, volumes, kubeVirtF5BootstrapDiskName)
+	if _, ok := bootstrap["cloudInitConfigDrive"]; !ok {
+		t.Fatalf("BIG-IP day-0 is not Config Drive V2: %#v", bootstrap)
+	}
+}
+
+func TestKubeVirtF5VMObjectRequiresCompleteSlotIdentity(t *testing.T) {
+	n := f5TestNode()
+	delete(n.Proto.Config.Env, kubeVirtF5RootPVCEnv)
+	if _, err := n.kubeVirtVMObject(); err == nil || !strings.Contains(err.Error(), kubeVirtF5RootPVCEnv) {
+		t.Fatalf("missing slot root PVC error = %v", err)
+	}
+	n = f5TestNode()
+	n.Proto.Config.Env[kubeVirtF5ManagementMACEnv] = "00:1a:a0:00:00:01"
+	if _, err := n.kubeVirtVMObject(); err == nil || !strings.Contains(err.Error(), "locally administered unicast MAC") {
+		t.Fatalf("globally administered slot MAC error = %v", err)
+	}
+}
diff --git a/topo/node/kubevirt_masquerade_ports_test.go b/topo/node/kubevirt_masquerade_ports_test.go
new file mode 100644
index 0000000..f7e4a4d
--- /dev/null
+++ b/topo/node/kubevirt_masquerade_ports_test.go
@@ -0,0 +1,128 @@
+package node
+
+import (
+	"testing"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+)
+
+func masqueradePortSet(t *testing.T, interfaces []any) map[string]bool {
+	t.Helper()
+	for _, item := range interfaces {
+		iface, ok := item.(map[string]any)
+		if !ok || iface["name"] != "default" {
+			continue
+		}
+		if _, ok := iface["masquerade"]; !ok {
+			t.Fatalf("default interface is not masquerade: %#v", iface)
+		}
+		set := map[string]bool{}
+		for _, p := range iface["ports"].([]any) {
+			m := p.(map[string]any)
+			key := m["protocol"].(string) + "/" + itoa64(m["port"].(int64))
+			if set[key] {
+				t.Fatalf("masquerade port %s declared twice: %#v", key, iface["ports"])
+			}
+			set[key] = true
+		}
+		return set
+	}
+	t.Fatalf("no default masquerade interface in %#v", interfaces)
+	return nil
+}
+
+func itoa64(v int64) string {
+	if v == 0 {
+		return "0"
+	}
+	var b []byte
+	for v > 0 {
+		b = append([]byte{byte('0' + v%10)}, b...)
+		v /= 10
+	}
+	return string(b)
+}
+
+// TestKubeVirtMasqueradeCarriesEveryServiceInsidePort is the SR OS gNMI defect of
+// 2026-09-30: the netlab KNE provider declares service gnmi 57400 for sros, the
+// Service targets pod-IP:57400, and the fixed masquerade union (22/443/830/50051/161)
+// never DNATed it to the VM -- refused at the pod while the guest listened. Every
+// inside port a Service targets must be in the masquerade port list.
+func TestKubeVirtMasqueradeCarriesEveryServiceInsidePort(t *testing.T) {
+	proto := &tpb.Node{
+		Name:  "n1",
+		Model: "sros",
+		Services: map[uint32]*tpb.Service{
+			22:    {Name: "ssh", Inside: 22},
+			57400: {Name: "gnmi", Names: []string{"gnmi", "gnoi", "gnsi"}, Inside: 57400},
+			161:   {Name: "snmp", Inside: 161},
+		},
+	}
+	set := masqueradePortSet(t, kubeVirtInterfaces("user-x", proto))
+	for _, want := range []string{"TCP/22", "TCP/57400", "UDP/161"} {
+		if !set[want] {
+			t.Errorf("masquerade ports lack %s (a Service targets it); got %v", want, set)
+		}
+	}
+	// The shared union is kept: a NOS whose services do not name them still gets them.
+	for _, want := range []string{"TCP/443", "TCP/830", "TCP/50051"} {
+		if !set[want] {
+			t.Errorf("masquerade ports lost the shared %s; got %v", want, set)
+		}
+	}
+}
+
+// A service whose outside port differs from its inside port (nxos/asav gnmi 9339 ->
+// 57400) is carried on the INSIDE port -- that is the port the Service targets on the
+// pod, so it is the one the DNAT must forward.
+func TestKubeVirtMasqueradeUsesServiceInsidePortAndProtocol(t *testing.T) {
+	proto := &tpb.Node{
+		Name:  "sw1",
+		Model: "nxos",
+		Services: map[uint32]*tpb.Service{
+			9339: {Name: "gnmi", Inside: 57400},
+			9340: {Name: "gribi", Inside: 57400},
+			161:  {Names: []string{"snmp"}, Inside: 161},
+			0:    {Name: "bogus", Inside: 0},
+		},
+	}
+	set := masqueradePortSet(t, kubeVirtInterfaces("user-x", proto))
+	if !set["TCP/57400"] {
+		t.Errorf("inside port 57400 not carried; got %v", set)
+	}
+	if set["TCP/9339"] || set["TCP/9340"] {
+		t.Errorf("outside ports must not be DNATed to the VM; got %v", set)
+	}
+	if set["TCP/161"] {
+		t.Errorf("snmp service must be carried as UDP, not TCP; got %v", set)
+	}
+	if set["TCP/0"] {
+		t.Errorf("a zero inside port must be skipped; got %v", set)
+	}
+}
+
+// Services is a map; the rendered port list must not depend on map order.
+func TestKubeVirtMasqueradePortsAreDeterministic(t *testing.T) {
+	proto := &tpb.Node{
+		Name: "r1",
+		Services: map[uint32]*tpb.Service{
+			9339:  {Name: "gnmi", Inside: 9339},
+			9340:  {Name: "gribi", Inside: 9340},
+			9559:  {Name: "p4rt", Inside: 9559},
+			57400: {Name: "gnmi2", Inside: 57400},
+		},
+	}
+	first := kubeVirtMgmtMasqueradePorts(proto)
+	for i := 0; i < 50; i++ {
+		got := kubeVirtMgmtMasqueradePorts(proto)
+		if len(got) != len(first) {
+			t.Fatalf("length changed: %d vs %d", len(got), len(first))
+		}
+		for j := range got {
+			a, b := got[j].(map[string]any), first[j].(map[string]any)
+			if a["port"] != b["port"] || a["protocol"] != b["protocol"] {
+				t.Fatalf("port list order is not stable: %v vs %v", got, first)
+			}
+		}
+	}
+}
diff --git a/topo/node/kubevirt_sros_tftp_test.go b/topo/node/kubevirt_sros_tftp_test.go
new file mode 100644
index 0000000..885786c
--- /dev/null
+++ b/topo/node/kubevirt_sros_tftp_test.go
@@ -0,0 +1,122 @@
+package node
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	topopb "github.com/openconfig/kne/proto/topo"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	kfake "k8s.io/client-go/kubernetes/fake"
+)
+
+// An image-local SR OS node with no bootstrap config boots from cf3: and never
+// contacts TFTP. Creating a TFTP pod anyway put a second pod carrying the node's
+// labels next to every SR OS VM, and the platform's runtime verification counted
+// it as a topology pod ("expected=2 observed=4 ready=4", 2026-09-30).
+func TestKubeVirtSrosImageLocalWithoutConfigCreatesNoTFTPServer(t *testing.T) {
+	t.Setenv("SKYFORGE_SROS_LICENSE_B64", "")
+	t.Setenv("SKYFORGE_SROS_LICENSE_B64_FILE", "/does/not/exist")
+	client := kfake.NewSimpleClientset()
+	n := &Impl{
+		KubeClient: client,
+		Namespace:  "test",
+		Proto: &topopb.Node{
+			Name:   "sros1",
+			Vendor: topopb.Vendor_NOKIA,
+			Model:  "sros",
+			Config: &topopb.Config{Image: "registry.example.com/skyforge/kubevirt/sros:22.10.R2-eve-l1"},
+		},
+	}
+
+	host, machineUUID, clockBase, err := n.ensureKubeVirtBootstrapTFTP(context.Background(), map[string]string{"topo": "test"}, nil)
+	if err != nil {
+		t.Fatalf("ensureKubeVirtBootstrapTFTP() failed: %v", err)
+	}
+	if host != "" {
+		t.Errorf("TFTP host = %q, want none (nothing is served)", host)
+	}
+	// The VM still gets its license-derived identity and clock.
+	if machineUUID != kubeVirtSrosPlaceholderUUID {
+		t.Errorf("machine UUID = %q, want the image-local UUID %q", machineUUID, kubeVirtSrosPlaceholderUUID)
+	}
+	if clockBase.IsZero() {
+		t.Error("license clock base is zero; the image-local license would not validate")
+	}
+	ctx := context.Background()
+	if pods, _ := client.CoreV1().Pods("test").List(ctx, metav1.ListOptions{}); len(pods.Items) != 0 {
+		t.Errorf("created %d TFTP pod(s) with nothing to serve", len(pods.Items))
+	}
+	if svcs, _ := client.CoreV1().Services("test").List(ctx, metav1.ListOptions{}); len(svcs.Items) != 0 {
+		t.Errorf("created %d TFTP service(s) with nothing to serve", len(svcs.Items))
+	}
+	if cms, _ := client.CoreV1().ConfigMaps("test").List(ctx, metav1.ListOptions{}); len(cms.Items) != 0 {
+		t.Errorf("created %d TFTP configmap(s) with nothing to serve", len(cms.Items))
+	}
+
+	// And the SMBIOS contract that makes this safe: without a bootstrap config the
+	// image-local product names only cf3: paths.
+	product := kubeVirtSrosSMBIOSProduct("sros1", host, false, "")
+	if strings.Contains(product, "tftp://") {
+		t.Errorf("image-local SMBIOS product still points at TFTP: %q", product)
+	}
+	for _, want := range []string{`license-file=cf3:\lic`, `primary-config=cf3:\config.cfg`} {
+		if !strings.Contains(product, want) {
+			t.Errorf("SMBIOS product lacks %s: %q", want, product)
+		}
+	}
+}
+
+// tftpPodAffinityTerms returns the REQUIRED podAffinity terms of a rendered VM
+// that select a bootstrap TFTP pod.
+func tftpPodAffinityTerms(t *testing.T, n *Impl, contract kubeVirtVMRenderContract) []any {
+	t.Helper()
+	vm, err := n.kubeVirtVMObject(contract)
+	if err != nil {
+		t.Fatalf("kubeVirtVMObject() failed: %v", err)
+	}
+	terms, _, _ := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "affinity", "podAffinity", "requiredDuringSchedulingIgnoredDuringExecution")
+	var out []any
+	for _, term := range terms {
+		m, _ := term.(map[string]any)
+		labels, _, _ := unstructured.NestedStringMap(m, "labelSelector", "matchLabels")
+		if labels["kneBootstrap"] == "tftp" {
+			out = append(out, term)
+		}
+	}
+	return out
+}
+
+// The r3 boot (2026-09-30) showed the other half of the seam: with no TFTP pod
+// created, both SR OS virt-launchers sat Pending ("didn't match pod affinity
+// rules") because the VM still REQUIRED co-location with its TFTP pod. The VM
+// may require only a TFTP server that ensureKubeVirtBootstrapTFTP created.
+func TestKubeVirtSrosVMRequiresOnlyATFTPServerThatExists(t *testing.T) {
+	t.Setenv("SKYFORGE_SROS_LICENSE_B64", "")
+	t.Setenv("SKYFORGE_SROS_LICENSE_B64_FILE", "/does/not/exist")
+	client := kfake.NewSimpleClientset()
+	n := &Impl{
+		KubeClient: client,
+		Namespace:  "test",
+		Proto: &topopb.Node{
+			Name:   "sros1",
+			Vendor: topopb.Vendor_NOKIA,
+			Model:  "sros",
+			Config: &topopb.Config{Image: "registry.example.com/skyforge/kubevirt/sros:22.10.R2-eve-l1"},
+		},
+	}
+	host, uuid, clock, err := n.ensureKubeVirtBootstrapTFTP(context.Background(), map[string]string{"topo": "test"}, nil)
+	if err != nil {
+		t.Fatalf("ensureKubeVirtBootstrapTFTP() failed: %v", err)
+	}
+	if terms := tftpPodAffinityTerms(t, n, kubeVirtVMRenderContractFor(n.Proto.Model, host, uuid, clock)); len(terms) != 0 {
+		t.Fatalf("VM requires a TFTP pod that was never created (unschedulable): %v", terms)
+	}
+
+	// POSITIVE CONTROL: when a TFTP server does exist the VM keeps requiring
+	// co-location with it (it fetches its license/config from there).
+	if terms := tftpPodAffinityTerms(t, n, kubeVirtVMRenderContractFor(n.Proto.Model, "10.43.1.2", uuid, clock)); len(terms) != 1 {
+		t.Fatalf("VM lost its TFTP co-location with a TFTP server present: %v", terms)
+	}
+}
diff --git a/topo/node/kubevirt_viptela_serial.go b/topo/node/kubevirt_viptela_serial.go
new file mode 100644
index 0000000..f2e6978
--- /dev/null
+++ b/topo/node/kubevirt_viptela_serial.go
@@ -0,0 +1,1684 @@
+package node
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+	rbacv1 "k8s.io/api/rbac/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+// Viptela (vEdge / vSmart) day-0 over the SERIAL CONSOLE.
+//
+// WHY THIS EXISTS. Viptela ships a cloud-init config-drive datasource and KNE
+// attaches one (kubeVirtViptelaBootstrapDiskAndVolume), but on this image the
+// user-data is never processed. Established from the shipped rootfs
+// (viptela-edge-20.12.7.1, squashfs at /20.12.7.1/rootfs.img):
+//
+//	/etc/sv/cloud-init/run begins
+//	    test -f /etc/viptela/cdb_init_done && cloud_init_end
+//	and /etc/sv/confd-p1/finish is what WRITES that file. runsvdir starts
+//	services in PARALLEL with no ordering, so confd-p1 finishing first makes the
+//	cloud-init service exit before it ever runs `cloud-init init`,
+//	`modules --mode=config` or `modules --mode=final`.
+//
+// Measured on a live vEdge 2026-08-15: the serial console shows exactly ONE
+// cloud-init line -- the `cloud-init init --local` that /sbin/init runs
+// directly -- and nothing after it. The VM is healthy (reaches "System Ready"
+// ~37s after guest start, presents a `login:` prompt), the config drive is
+// well-formed (valid ISO9660, label config-2, carrying
+// openstack/latest/user_data), and the KubeVirt masquerade already forwards 22.
+// Port 22 was probed every 10s for 900s and stayed CLOSED, because VPN 512 was
+// never configured. The delivery channel is the defect, not the payload -- a
+// multipart-MIME payload was tried and failed identically.
+//
+// The DMI gate in that same script is NOT involved: KubeVirt presents
+// manufacturer=KubeVirt, which does not match its Viptela*|Cisco* skip list.
+//
+// So day-0 goes over ttyS0, the way vrnetlab drives these images. Unlike the
+// dellos10 injector this pattern was modelled on, Viptela ACTUALLY PRESENTS A
+// LOGIN ON ttyS0 (`ve1 login:` observed), so the prerequisite that blocks
+// vr-ftosv is already satisfied here.
+//
+// SOURCE OF TRUTH. The injector pastes n.readConfig() -- the SAME
+// netlab-authored startup-config every other VM NOS day-0 uses -- VERBATIM.
+// It does not template, normalise, reformat or reorder it. netlab is the
+// producer of device config; this is only a delivery channel.
+
+const (
+	kubeVirtViptelaInjectorConfigFileName = "startup-config.cfg"
+	kubeVirtViptelaInjectorScriptKey      = "inject.py"
+
+	// Matches the day-0 templates' `aaa / user admin / password admin`, and the
+	// factory default on these images.
+	kubeVirtViptelaInjectorLoginUser = "admin"
+	kubeVirtViptelaInjectorLoginPass = "admin"
+
+	// The password day-0 DECLARES, which is not always the one the box boots
+	// with. netlab resolves it and passes it through the node's config env; see
+	// add_viptela_credentials in netsim/providers/kne.py.
+	kubeVirtViptelaInjectorPassEnv        = "VIPTELA_PASS"
+	kubeVirtViptelaInjectorFactoryPassEnv = "VIPTELA_FACTORY_PASS"
+	kubeVirtViptelaInjectorUserEnv        = "VIPTELA_USER"
+)
+
+// kubeVirtIsViptelaSerialInject selects the models whose day-0 is delivered over
+// the serial console. Deliberately the same set as kubeVirtIsViptelaDay0 -- the
+// devices netlab produces startup configs for. vbond rides the vedge image and
+// is selected by day-0 content, not by a separate model.
+func kubeVirtIsViptelaSerialInject(model string) bool {
+	return kubeVirtIsViptelaDay0(model)
+}
+
+// kubeVirtViptelaInjectorEnv builds the injector pod's environment.
+//
+// THE PASSWORD IS NOT ALWAYS "admin", and assuming it was is what kept the
+// factory->declared transition out of day-0. These images force a password
+// change on first console login, and the injector answers that prompt; while it
+// answered with a KNE-side constant, the one appliance that MUST change its
+// password could not. vManage refuses to keep the factory value outright --
+// "USER0002: Password for admin user cannot be configured to default/last
+// password" (measured live) -- so admin/admin cannot survive there.
+//
+// netlab is the one that knows the declared credential (it is in the device
+// definition's group_vars, and differs per personality), so it resolves the
+// value and passes it through the node's config env. This reads it back and
+// falls through to the historical constants when the topology says nothing,
+// which keeps a hand-authored Viptela node booting exactly as it did before.
+//
+// LOGIN vs SET are deliberately two variables. The injector logs in with the
+// FACTORY password and sets the DECLARED one; collapsing them is what made this
+// look like a single value to begin with.
+func kubeVirtViptelaInjectorEnv(n *Impl) []corev1.EnvVar {
+	cfgEnv := n.Proto.GetConfig().GetEnv()
+	pick := func(key, fallback string) string {
+		if v := strings.TrimSpace(cfgEnv[key]); v != "" {
+			return v
+		}
+		return fallback
+	}
+	return []corev1.EnvVar{
+		{Name: "VMI_NAME", Value: n.Name()},
+		{Name: "VMI_NAMESPACE", Value: n.Namespace},
+		{Name: kubeVirtViptelaInjectorUserEnv, Value: pick(kubeVirtViptelaInjectorUserEnv, kubeVirtViptelaInjectorLoginUser)},
+		{Name: kubeVirtViptelaInjectorPassEnv, Value: pick(kubeVirtViptelaInjectorPassEnv, kubeVirtViptelaInjectorLoginPass)},
+		{Name: kubeVirtViptelaInjectorFactoryPassEnv, Value: pick(kubeVirtViptelaInjectorFactoryPassEnv, kubeVirtViptelaInjectorLoginPass)},
+	}
+}
+
+func kubeVirtViptelaInjectorResourceName(nodeName string) string {
+	base := strings.ToLower(strings.TrimSpace(nodeName + "-viptela-serial-inject"))
+	if len(base) <= 63 {
+		return base
+	}
+	sum := sha256.Sum256([]byte(base))
+	return strings.TrimRight(base[:54], "-") + "-" + fmt.Sprintf("%x", sum[:])[:8]
+}
+
+// kubeVirtViptelaInjectorImage resolves the injector image. It MUST carry
+// virtctl, python3 and pexpect. There is deliberately no plain-python fallback:
+// without virtctl the pod cannot reach the console at all, so an unset image
+// must fail loudly at pod start rather than sit as a silent no-op.
+func kubeVirtViptelaInjectorImage() string {
+	for _, key := range []string{"SKYFORGE_KUBEVIRT_SERIAL_INJECTOR_IMAGE", "SKYFORGE_NETLAB_RUNTIME_IMAGE"} {
+		if image := strings.TrimSpace(os.Getenv(key)); image != "" {
+			return image
+		}
+	}
+	return "registry.example.com/skyforge/kubevirt/serial-injector:latest"
+}
+
+func kubeVirtViptelaInjectorPullPolicy() corev1.PullPolicy {
+	policy := strings.TrimSpace(os.Getenv("SKYFORGE_NETLAB_RUNTIME_PULL_POLICY"))
+	if policy == "" {
+		return corev1.PullIfNotPresent
+	}
+	return corev1.PullPolicy(policy)
+}
+
+// kubeVirtViptelaInjectorNodeIdentityLabels are the labels the platform uses to map a
+// pod back to a TOPOLOGY NODE (see kubeTopologyNodeNameForPod in the server's
+// taskengine). A companion pod must carry NONE of them.
+//
+// Copying the node's labels wholesale made the platform treat this injector as
+// the node's own pod: when the injector crash-looped, admission reported
+//
+//	NOS node startup failed: node=ve1 pod=ve1-viptela-serial-inject
+//	container=viptela-serial-inject restarts=3
+//
+// and failed the whole deployment -- attributing a helper's failure to the NOS,
+// which is exactly the wrong layer to send someone debugging.
+var kubeVirtViptelaInjectorNodeIdentityLabels = []string{
+	"kne/topologyNode",
+	"kne.example.com/node-name",
+	"vm.kubevirt.io/name",
+	"vmi.kubevirt.io/id",
+	"kubevirt.io/domain",
+}
+
+func kubeVirtViptelaInjectorLabels(nodeName string, labels map[string]string) map[string]string {
+	out := map[string]string{}
+	for key, value := range labels {
+		out[key] = value
+	}
+	for _, key := range kubeVirtViptelaInjectorNodeIdentityLabels {
+		delete(out, key)
+	}
+	out["app"] = kubeVirtViptelaInjectorResourceName(nodeName)
+	out["kneBootstrap"] = "viptela-serial-inject"
+	// Name the node this belongs to under a key NOTHING maps to a topology node,
+	// so cleanup and debugging can still find it.
+	out["skyforge.example.com/injector-for"] = nodeName
+	return out
+}
+
+// Own copy rather than reusing the dellos10 rules: the two injectors must be
+// independently droppable, and an RBAC rule set is cheap to duplicate.
+//
+// NOTE this does NOT grant virtualmachineinstances/console. See the script
+// below -- KubeVirt refuses that subresource while the VMI sits in Scheduled,
+// which is where every one of these NOS images stays. The injector reaches the
+// SAME ttyS0 through the virt-launcher pod instead, so it needs pod exec.
+func kubeVirtViptelaInjectorRoleRules() []rbacv1.PolicyRule {
+	return []rbacv1.PolicyRule{
+		{
+			APIGroups: []string{""},
+			Resources: []string{"pods"},
+			Verbs:     []string{"get", "list"},
+		},
+		{
+			APIGroups: []string{""},
+			Resources: []string{"pods/exec"},
+			Verbs:     []string{"get", "create"},
+		},
+	}
+}
+
+// kubeVirtViptelaInjectorScript drives ttyS0 with pexpect.
+//
+// The config is pasted VERBATIM, line by line, exactly as netlab rendered it.
+// Blank lines and `!` separators are sent as-is because they are meaningful in
+// the Viptela CLI's hierarchy; the only lines skipped are ones the operator
+// could not have meant as config (a leading shebang or a Jinja comment marker
+// would indicate a broken render, and are reported rather than swallowed).
+const kubeVirtViptelaInjectorScript = `#!/usr/bin/env python3
+import os, re, subprocess, sys, time
+import pexpect
+
+VMI  = os.environ["VMI_NAME"]
+NS   = os.environ["VMI_NAMESPACE"]
+USER = os.environ.get("VIPTELA_USER", "admin")
+# PASS is the password day-0 DECLARES and this injector SETS; FACTORY_PASS is
+# the one the appliance boots with and this injector LOGS IN with. They are the
+# same value on a vSmart or vBond and DIFFERENT on a vManage, which refuses to
+# keep the factory value at all ("USER0002: Password for admin user cannot be
+# configured to default/last password", measured live). Treating them as one
+# value is why the factory->declared transition used to happen over REST, behind
+# a passwordReset gate that blocked the very session meant to clear it.
+PASS = os.environ.get("VIPTELA_PASS", "admin")
+FACTORY_PASS = os.environ.get("VIPTELA_FACTORY_PASS", "admin")
+
+# The console has exactly two legitimate credential states and both are ordinary
+# moments in the box's life: FACTORY on a fresh boot, DECLARED once day-0 has run
+# once. Try them in that order and let the existing login-retry loop cycle, so a
+# re-run against an already-configured device is not a failure. Deduped, because
+# on the controllers the two are the same and offering it twice would burn a
+# login attempt for nothing.
+LOGIN_CANDIDATES = [FACTORY_PASS] + ([PASS] if PASS != FACTORY_PASS else [])
+CFG  = os.environ.get("VIPTELA_CONFIG_FILE", "/config/startup-config.cfg")
+BOOT_TIMEOUT = int(os.environ.get("VIPTELA_BOOT_TIMEOUT_SECONDS", "1800"))
+LOGIN_ATTEMPTS = int(os.environ.get("VIPTELA_LOGIN_ATTEMPTS", "5"))
+# THE LOCK IS FINITE AND THE DEVICE STATES ITS LENGTH. This is only the fallback
+# for a release that reports the lock without the countdown; every Viptela we run
+# locks admin for 15 minutes.
+LOCKOUT_DEFAULT_MINUTES = int(os.environ.get("VIPTELA_LOCKOUT_MINUTES", "15"))
+# How many locks are worth sitting out before the honest conclusion is "the
+# declared password is wrong". One: a lock that returns after a full wait AND a
+# clean offer of every candidate is not a timing problem.
+LOCKOUT_WAITS_ALLOWED = int(os.environ.get("VIPTELA_LOCKOUT_WAITS", "1"))
+
+# vEdge/vSmart operational prompt is "<hostname>#"; config mode is
+# "<hostname>(config)#". Keep the operational pattern from matching the config
+# prompt, or the paste loop exits the hierarchy on its first line.
+# DELIBERATELY NOT ANCHORED TO A LINE START. The console is spawned with
+# echo=False instead, and that is what stops a password being mistaken for a
+# prompt: pexpect's pty echoes everything IT WRITES back into the buffer IT
+# READS, so with echo on, typing a password containing '#' matched this pattern
+# as if the device had presented "vmanage#". Measured live 2026-09-01 -- the
+# injector typed a '#'-bearing password, read its own echo as a prompt, sent
+# "config terminal" into the password field, and repeated until the appliance
+# locked the admin account after 27 failed logins. A device never echoes a
+# password, so with echo=False only real device output can ever match here.
+#
+# ANCHORING WAS TRIED AND IS WRONG. vManage precedes its prompt with a terminal
+# escape sequence, so the bytes are "...\r\n\x1b[?7hvmanage# " -- there is no
+# newline adjacent to the identifier and an anchored pattern never matches.
+# Measured on a live vManage 20.7.1 console the same day: an anchored PROMPT
+# timed out against a box that was sitting at a perfectly good prompt.
+PROMPT        = r"[A-Za-z0-9._-]+#(?!\S)"
+CONFIG_PROMPT = r"\(config[^)]*\)#"
+# vshell drops from the CLI to a busybox shell, whose prompt is "<host>:~$".
+# The console is a PERSISTENT device-side session: a previous attempt that ended
+# inside vshell leaves it there, so a later attach lands at a shell and every CLI
+# pattern misses. Seen live -- the injector attached to "ve1:~$" and polled to
+# timeout while the device was perfectly healthy.
+SHELL_PROMPT  = r"[A-Za-z0-9._-]+:~[$#]"
+# A LOGIN PROMPT, NOT THE WORD "login:". The device's post-authentication banner
+# says "Last login: <date>" and "Last failed login: <date>", and a bare "login:"
+# matches inside BOTH -- so a SUCCESSFUL login read as "the console bounced back
+# to a login prompt". Measured live on vManage 20.7.1: the correct password was
+# accepted, the banner printed, and the injector concluded the credential had
+# been refused. On a first boot there is no banner, which is why this survived
+# until the first re-run against an already-booted box.
+LOGIN_PROMPT  = r"(?i)(?<!last )(?<!failed )login:"
+# THE BOX SAYS WHEN IT IS NOT READY, AND IT IS NOT A REFUSAL. Viptela presents a
+# getty long before the CLI is up and answers any login with:
+#
+#     vbond login: admin
+#     System Initializing. Please wait to login...
+#     Login incorrect
+#
+# That is "come back later", not "wrong password", and treating it as an attempt
+# burned all five in ~30 seconds against a perfectly healthy box that was still
+# booting -- measured on a clean boot 2026-09-01, on all three controllers at
+# once. The injector then exited, the pod restarted, and the cycle repeated.
+INITIALIZING  = r"(?i)system initializing|please wait to login"
+# THE FORCED-PASSWORD DIALOG CAN BE PARKED, exactly like the persona menu. The
+# console is a persistent device-side session, so a container that died between
+# "Password:" and "Re-enter password:" leaves the NEXT attach sitting inside the
+# dialog -- and connect_console's opening newline is then read as an empty
+# password, which the device answers with "Passwords did not match. Try again...".
+# Measured on a clean boot 2026-09-01: vsmart attached straight into
+# "Re-enter password:", no expect branch matched it, and the injector died on a
+# 120s timeout naming the regex list rather than the dialog it was standing in.
+RE_ENTER_PW   = r"(?i)re-?enter password:"
+# THE FIRST PASSWORD PROMPT, NOT THE WORD "password:". "Re-enter password:"
+# CONTAINS "password:", so a bare [Pp]assword: matches the CONFIRMATION prompt --
+# and the recovery below then answers the confirmation as though it were the
+# first prompt, guaranteeing a mismatch, forever. Measured on a live vSmart
+# 2026-09-01: three consecutive "Passwords did not match / Try again" rounds, the
+# injector answering the wrong prompt each time. Same failure family as the
+# "Last login:" banner matching a bare "login:".
+FIRST_PW      = r"(?i)(?<!re-enter )(?<!reenter )password:"
+PW_MISMATCH   = r"(?i)passwords did not match"
+
+def log(msg):
+    print("[viptela-inject] %s" % msg, flush=True)
+
+def wait_login(child):
+    """Poll for a usable prompt. The VM reaches 'System Ready' ~37s after guest
+    start, but the containerDisk pull and guest boot in front of that are the
+    slow part, so this waits patiently rather than assuming a fast console."""
+    deadline = time.time() + BOOT_TIMEOUT
+    # LOOK BEFORE YOU TYPE, AND THIS USED TO DO THE OPPOSITE.
+    #
+    # A BARE NEWLINE AT A getty LOGIN PROMPT IS A FAILED LOGIN. It submits an
+    # empty username, and the box answers "Login incorrect" and increments the
+    # counter that locks the account. This loop opened every iteration with one,
+    # and login() calls it once per attempt, so a run spent up to five failed
+    # logins BEFORE it offered a single credential -- and five is exactly the
+    # lock threshold on vManage 20.18.4.
+    #
+    # MEASURED, demo-lab (c83e1600) 2026-09-08, vmanage guest console via Loki:
+    #     16:11:33  Password:
+    #     16:11:39  Login incorrect          <- our newline, no username typed
+    #     ...
+    #     16:16:54  vmanage login: admin
+    #     16:16:54  The account is locked due to 5 failed logins.
+    # The first credential the injector ever typed met an already-locked
+    # account. The DECLARED password was correct the whole time: SSH with it
+    # succeeded on the same box nine hours later.
+    #
+    # The nudge still exists -- a console really can go quiet for ~2 minutes
+    # during package extraction -- but it is now the answer to SILENCE rather
+    # than the opening move. Nothing is typed until the console has been given
+    # 20s to speak for itself.
+    nudge = False
+    while time.time() < deadline:
+        if nudge:
+            child.sendline("")
+            nudge = False
+        i = child.expect([LOGIN_PROMPT, FIRST_PW, CONFIG_PROMPT, PROMPT,
+                          r"(?i)you must set an initial admin password", SHELL_PROMPT,
+                          r"(?i)select persona[^:]*:",
+                          r"(?i)select (the )?storage device[^:]*:",
+                          INITIALIZING, RE_ENTER_PW, PW_MISMATCH,
+                          pexpect.TIMEOUT, CDB_FATAL, REBOOTING, TRY_AGAIN,
+                          LOCKED_OUT], timeout=20)
+        if i == 11:
+            # SILENCE, and the only moment a bare newline is warranted.
+            nudge = True
+            continue
+        if i == 15:
+            # The box is telling us the account is locked before we have even
+            # typed a username -- a leftover from an earlier round. Sit it out
+            # here rather than walking into it with a credential.
+            _on_locked_out(child)
+            continue
+        if i in (12, 13):
+            _die_console_fatal(child)
+        if i == 14:
+            i = 10  # "Try again..." is the device re-presenting the pair
+        if i == 9:
+            # Parked at the confirmation. Complete the pair; the device then
+            # continues into the persona/storage dialogs or a login prompt.
+            log("console is parked at the password confirmation")
+            child.sendline(PASS)
+            if settle_after_password(child, timeout=90) == "login":
+                continue
+            return "prompt"
+        if i == 10:
+            log("console is parked after a password mismatch; re-answering")
+            child.expect(FIRST_PW, timeout=30)
+            child.sendline(PASS)
+            child.expect(RE_ENTER_PW, timeout=30)
+            child.sendline(PASS)
+            if settle_after_password(child, timeout=90) == "login":
+                continue
+            return "prompt"
+        if i == 8:
+            # Still booting. Keep waiting -- this loop is bounded by BOOT_TIMEOUT
+            # and the device will present a usable prompt when it is ready.
+            log("device is still initializing; waiting for the CLI")
+            time.sleep(15)
+            continue
+        if i == 0: return "login"
+        if i == 1: return "password"
+        if i == 2: return "config"
+        if i == 3: return "prompt"
+        if i == 5:
+            # Sitting in vshell. Climb back to the CLI rather than giving up.
+            log("console is in vshell; returning to the CLI")
+            child.sendline("exit")
+            j = child.expect([CONFIG_PROMPT, PROMPT, LOGIN_PROMPT, pexpect.TIMEOUT], timeout=30)
+            if j == 0: return "config"
+            if j == 1: return "prompt"
+            if j == 2: return "login"
+            continue
+        if i == 7:
+            # PARKED at the vManage storage menu -- same persistence story as
+            # the persona parking below; settle answers it.
+            log("console is parked at the vManage storage menu")
+            if settle_after_password(child, timeout=90) == "login":
+                continue
+            return "prompt"
+        if i == 6:
+            # PARKED at the vManage persona menu -- the console is a persistent
+            # device-side session, so a prior attempt that died between the
+            # password set and the persona answer leaves the menu on screen
+            # (exactly like the vshell parking above). Answer it and settle.
+            log("console is parked at the vManage persona menu")
+            if settle_after_password(child, timeout=90) == "login":
+                continue
+            return "prompt"
+        if i == 4:
+            # Landed mid-way through the forced initial-password exchange.
+            child.expect(FIRST_PW, timeout=30)
+            child.sendline(PASS)
+            child.expect(r"(?i)re-?enter password:", timeout=30)
+            child.sendline(PASS)
+            if settle_after_password(child, timeout=90) == "login":
+                continue
+            return "prompt"
+    sys.exit("timed out after %ds waiting for a Viptela login/prompt on ttyS0" % BOOT_TIMEOUT)
+
+
+def settle_after_password(child, timeout=90):
+    """Ride out the post-password first-boot dialogs until a CLI prompt.
+
+    vManage 20.7.1 (and only vManage) runs a first-boot dialog after the
+    initial-password exchange. Captured end-to-end from a live console
+    2026-08-28:
+
+        1) COMPUTE_AND_DATA / 2) DATA / 3) COMPUTE
+        Select persona for vManage [1,2 or 3]: 1
+        You chose persona COMPUTE_AND_DATA (1)
+        Are you sure? [y/n] y
+        1) vdb / 2) sda
+        Select storage device to use: 1
+        Would you like to format vdb? (y/n): y
+        Extracting vManage extra-packages       (~2 minutes)
+        vmanage login:                          (fresh login after init)
+
+    BOTH menus take the OPTION NUMBER. Every answer is sent as a PAIR with
+    the prompt it provokes -- a loop that answers whichever prompt matches
+    next runs one prompt BEHIND the device forever (measured: "1" landed on
+    the confirm, "y" landed on the re-presented menu, alternating without
+    end). The storage init ends at a fresh login prompt, so this returns
+    "login" for the caller to run the login exchange again; "prompt" means
+    a CLI prompt was reached directly. vEdge/vSmart present none of these
+    dialogs, so for them this is the old expect([CONFIG_PROMPT, PROMPT])."""
+    PERSONA_MENU  = r"(?i)select persona[^:]*:"
+    CONFIRM       = r"(?i)are you sure\? *\[y/n\]"
+    STORAGE_MENU  = r"(?i)select (the )?storage device[^:]*:"
+    FORMAT_Q      = r"(?i)would you like to format[^(]*\(y/n\):"
+    RESYNC        = r"(?i)invalid option|you chose persona +\("
+    deadline = time.time() + max(timeout, 600)
+    while time.time() < deadline:
+        i = child.expect([CONFIG_PROMPT, PROMPT, PERSONA_MENU, CONFIRM,
+                          STORAGE_MENU, FORMAT_Q, LOGIN_PROMPT, RESYNC,
+                          pexpect.TIMEOUT], timeout=timeout)
+        if i in (0, 1):
+            return "prompt"
+        if i == 2:
+            log("answering vManage persona menu with 1 (COMPUTE_AND_DATA)")
+            child.sendline("1")
+            j = child.expect([CONFIRM, PERSONA_MENU, CONFIG_PROMPT, PROMPT,
+                              pexpect.TIMEOUT], timeout=20)
+            if j == 0:
+                child.sendline("y")
+        elif i == 3:
+            log("confirming vManage persona choice with y")
+            child.sendline("y")
+        elif i == 4:
+            log("answering vManage storage-device menu with 1")
+            child.sendline("1")
+            j = child.expect([FORMAT_Q, STORAGE_MENU, CONFIG_PROMPT, PROMPT,
+                              pexpect.TIMEOUT], timeout=30)
+            if j == 0:
+                log("confirming vManage storage format with y (blank declared data disk)")
+                child.sendline("y")
+        elif i == 5:
+            log("confirming vManage storage format with y (blank declared data disk)")
+            child.sendline("y")
+        elif i == 6:
+            # Storage init ends in a REBOOTED login prompt; hand control back
+            # to the login flow rather than treating this as a failure.
+            log("vManage re-presented a login prompt after first-boot init")
+            return "login"
+        elif i == 7:
+            # Device rejected a stale answer and will re-present its prompt;
+            # send nothing -- the next loop round matches the fresh prompt.
+            continue
+        else:
+            # Quiet console (package extraction can hold it for ~2 minutes):
+            # nudge a prompt re-present rather than guessing.
+            child.sendline("")
+    sys.exit("vManage first-boot dialogs did not settle to a CLI prompt")
+
+# THE WORDING IS THE DEVICE'S, AND IT IS NOT THE ONE THIS PATTERN USED TO HOLD.
+# vManage 20.18.4 says, verbatim off the guest console (demo-lab c83e1600,
+# 2026-09-08 16:16:54 UTC):
+#
+#     The account is locked due to 5 failed logins.
+#     (10 minutes left to unlock)
+#
+# The old pattern was "account locked due to", with no "is", so it matched
+# NOTHING on this release and the lockout guard below never fired once -- the
+# injector read the sentence 43 times (Loki, pod vmanage-viptela-serial-inject,
+# container viptela-serial-inject) and kept hammering, while its own FATAL
+# message appears ZERO times in the same window. Both wordings are accepted now
+# rather than replacing one guess with another.
+LOCKED_OUT = r"(?i)account (?:is )?locked due to (\d+) failed logins"
+# THE DEVICE ALSO SAYS HOW LONG. Reading it turns "give up" into "wait exactly
+# as long as the box asked", which is the only action that can ever succeed.
+UNLOCK_IN  = r"\((\d+) minutes? left to unlock\)"
+
+# THE BOX NAMING ITS OWN DEFECT. Measured 2026-09-02 on vSmart 20.7.1 with a
+# cloud-init seed whose VPN 0 carried two interfaces: the console printed
+#     CDB boot error: Init transaction failed to validate:
+#       /viptela-vpn:vpn/vpn-instance{0} : Maximum one tunnel interface allowed on vsmart
+#     Stopping services... reboot: Restarting system
+# and the guest rebooted in a loop -- five times in thirty minutes -- while the
+# runtime gate saw only "phase=Running" and waited out its whole budget. Either
+# line is a VERDICT: the day-0 cannot succeed on this boot, and the sentence
+# after "CDB boot error:" is the diagnosis. Exit 2 (not 1) so a reader can tell
+# "the device refused the day-0" from "the console dialog went wrong".
+CDB_FATAL = r"CDB boot error:[^\r\n]*"
+REBOOTING = r"reboot: Restarting system"
+TRY_AGAIN = r"(?i)try again\.\.\."
+
+def _die_console_fatal(child):
+    line = child.after if isinstance(child.after, str) else ""
+    log("FATAL: the device refused its day-0 on the console: %s" % line.strip())
+    sys.exit(2)
+
+def _drain(child, quiet=0.5):
+    """Discard whatever the console has ALREADY printed, so the next expect
+    judges only the device's answer to what we are about to type. Measured
+    2026-09-02: a "Password:" queued by our own opening newline, and a stale
+    "Login incorrect" behind it, were read as the device refusing the real
+    credential -- and the WRONG PASSWORD guard exited on a box that had in fact
+    accepted admin/admin and entered the first-login wizard."""
+    try:
+        while True:
+            child.read_nonblocking(4096, timeout=quiet)
+    except (pexpect.TIMEOUT, pexpect.EOF):
+        pass
+    try:
+        child.buffer = child.string_type()
+    except Exception:
+        pass
+
+def _locked_out_minutes(child):
+    """How long the box says the lock has left, or None if it did not say."""
+    tail = ""
+    for part in (child.after, child.before):
+        if isinstance(part, str):
+            tail += part
+    try:
+        tail += child.read_nonblocking(4096, timeout=2)
+    except Exception:
+        pass
+    m = re.search(UNLOCK_IN, tail)
+    if m:
+        try:
+            return int(m.group(1))
+        except Exception:
+            return None
+    return None
+
+def _wait_out_lockout(child):
+    """A locked account must be WAITED OUT, not retried into and not exited on.
+
+    Two things were wrong here and they compounded.
+
+    ONE: the guard could not fire (see LOCKED_OUT above), so the injector spent
+    every attempt against an account that could not answer.
+
+    TWO: even when it fires, sys.exit() is the wrong verb. This runs as a pod
+    with a restarting policy, so exiting is a RETRY -- a slower one. Measured on
+    demo-lab (c83e1600) 2026-09-08: the vmanage injector restarted at 16:16, 16:22,
+    16:28 ... 18:26, burning three real login attempts per round, and the console
+    countdown went 10 -> 4 -> 10 minutes because every round re-armed the lock.
+    Four hours of that, and the box was never reachable again, so vManage never
+    took its day-0: HTTPS/443 and 8443 were still refusing connections nine hours
+    later while SSH answered on the DECLARED password all along.
+
+    The lock is finite and the device states its length. Sleep it out inside the
+    BOOT_TIMEOUT budget and offer each credential once on the other side. Only a
+    lock that comes back AFTER a clean, unlocked attempt at every candidate is a
+    wrong password, and that is the one case worth exiting on."""
+    if child.match and hasattr(child.match, "group"):
+        try:
+            n = child.match.group(1)
+        except Exception:
+            n = "?"
+    else:
+        n = "?"
+    mins = _locked_out_minutes(child)
+    if mins is None:
+        mins = LOCKOUT_DEFAULT_MINUTES
+    log("admin is LOCKED OUT on %s/%s after %s failed logins; the device says %d "
+        "minute(s) left. Waiting it out -- restarting or retrying only re-arms "
+        "the lock." % (NS, VMI, n, mins))
+    # +30s so we come back AFTER the boundary, never one second before it.
+    time.sleep(mins * 60 + 30)
+    _drain(child)
+
+_LOCKOUT_WAITS = [0]
+
+def _on_locked_out(child):
+    """Every place that can see a lock funnels through here, so the WAIT-then-
+    FAIL decision is made once rather than per call site."""
+    if _LOCKOUT_WAITS[0] >= LOCKOUT_WAITS_ALLOWED:
+        _die_if_locked_out(child)
+    _LOCKOUT_WAITS[0] += 1
+    _wait_out_lockout(child)
+
+def _die_if_locked_out(child):
+    """Kept as the FATAL form, for the one case where waiting cannot help: the
+    lock came back after we had already waited one out and offered every
+    credential on an unlocked account. That is a wrong password, and no amount
+    of waiting turns it into a right one."""
+    sys.exit(
+        "admin is LOCKED OUT on %s/%s AGAIN, after a full lockout had already "
+        "been waited out and all %d declared credential(s) offered against an "
+        "unlocked account. The console password is not one of them. Fix the "
+        "declared credential; do not restart this pod."
+        % (NS, VMI, len(LOGIN_CANDIDATES)))
+
+def login(child):
+    # BOUNDED RETRY around the whole exchange. Measured 2026-08-17 on vSmart
+    # 20.7.1 (viptela-probe, vs1): the injector sent the username, the guest
+    # getty expired ("Login timed out after 60 seconds.") and re-presented
+    # "vsmart login:" -- a prompt the post-auth expect below could not match,
+    # so every injector restart died identically at the same expect. A fresh
+    # login prompt anywhere in the exchange means "start over", not "fail".
+    # vEdge never showed this because its console settles before the injector
+    # attaches; vSmart's takes longer and the first attempt can race the getty.
+    # ATTEMPTS ARE BOUNDED BY CREDENTIALS, NOT BY LOGIN_ATTEMPTS. Retrying is
+    # only meaningful while there is a credential we have not offered yet or a
+    # console race to lose; offering the same rejected password five times is
+    # how the admin account gets locked. LOGIN_ATTEMPTS still caps the
+    # console-race retries (a getty that expires mid-exchange), which is what it
+    # was introduced for.
+    rejected = set()
+    # ATTEMPTS COUNT REAL EXCHANGES ONLY. A round that ends in "System
+    # Initializing" never reached the credential, so counting it spends the
+    # budget on the BOOT rather than on the login -- which is exactly what a
+    # for-loop did on a clean boot: five attempts gone in thirty seconds.
+    attempt = 0
+    while attempt < LOGIN_ATTEMPTS:
+        attempt += 1
+        # Cycle the credential candidates across attempts. A device that has
+        # already been through day-0 holds the DECLARED password, and offering
+        # only the factory one would read as an unreachable console rather than
+        # as "this box is already configured".
+        candidate = LOGIN_CANDIDATES[(attempt - 1) % len(LOGIN_CANDIDATES)]
+        if candidate in rejected and len(rejected) >= len(LOGIN_CANDIDATES):
+            sys.exit(
+                "every declared credential (%d) was rejected by the console on "
+                "%s/%s. This is a WRONG PASSWORD, not an unreachable console: "
+                "the box answered and refused. Retrying would lock the admin "
+                "account (5 failures on 20.18.4 = 15 minutes, extended by each "
+                "attempt)."
+                % (len(LOGIN_CANDIDATES), NS, VMI))
+        st = wait_login(child)
+        if st in ("prompt", "config"):
+            log("console already at a prompt")
+            return st
+        if st == "password":
+            # A "Password:" WE DID NOT ASK FOR BELONGS TO AN EMPTY USERNAME.
+            # wait_login elicits the console with a bare newline; on 20.7.1 the
+            # getty answers that newline with "Password:" for the EMPTY user.
+            # Measured 2026-09-02 (run 75927, vsmart): this branch typed the real
+            # password into that bogus prompt, the getty said "Login incorrect",
+            # the credential was recorded as REJECTED, and the next round exited
+            # "every declared credential was rejected -- WRONG PASSWORD" on a
+            # box that accepts admin/admin. Abort the half-login with a newline
+            # (one failed-login count, of the FIVE that lock the account on
+            # 20.18.4 -- it was written as seven, which is the 20.7.1 figure)
+            # and wait for a clean "login:"
+            # so the username we type is the one the password answers.
+            log("password prompt for a username we never typed; aborting it and waiting for login:")
+            child.sendline("")
+            k = child.expect([LOGIN_PROMPT, INITIALIZING, pexpect.TIMEOUT], timeout=30)
+            if k != 0:
+                attempt -= 1
+                continue
+            # FALL THROUGH to the username path WITHOUT another nudge: nudging a
+            # fresh "login:" is what produced the bogus prompt in the first place,
+            # and abort/nudge/abort would loop forever (caught by the fake console).
+        _drain(child)
+        child.sendline(USER)
+        j = child.expect([FIRST_PW, LOCKED_OUT, INITIALIZING, LOGIN_PROMPT,
+                          pexpect.TIMEOUT], timeout=60)
+        if j == 1:
+            # NOT AN ATTEMPT. The box refused before it ever looked at a
+            # password, so this round must not spend the budget -- exactly the
+            # reasoning the INITIALIZING branch below already uses. And every
+            # candidate must be offered again on the far side of the lock: a
+            # rejection recorded while the account was locked says nothing about
+            # the credential.
+            _on_locked_out(child)
+            rejected.clear()
+            attempt -= 1
+            continue
+        if j == 2:
+            log("device is still initializing; waiting rather than spending a login attempt")
+            attempt -= 1
+            time.sleep(15)
+            continue
+        if j != 0:
+            log("login prompt re-presented before password (attempt %d/%d); retrying" % (attempt, LOGIN_ATTEMPTS))
+            continue
+        _drain(child)
+        child.sendline(candidate)
+        if _post_auth(child, attempt, candidate):
+            return "prompt"
+        rejected.add(candidate)
+    sys.exit("Viptela login did not reach a prompt after %d attempts" % LOGIN_ATTEMPTS)
+
+def _post_auth(child, attempt, candidate=None):
+
+    # 20.7.1 FORCES an initial admin password on the very first login, and its
+    # wording matches none of the usual "current/new password" phrasings.
+    # Captured verbatim from a live vEdge console 2026-08-15:
+    #
+    #     Welcome to Viptela CLI
+    #     admin connected from 127.0.0.1 using console on vedge
+    #     You must set an initial admin password.
+    #     Password:
+    #     Re-enter password:
+    #
+    # Missing this was the whole failure: the injector authenticated, then sat
+    # at a prompt it did not recognise until the boot timeout, and a botched
+    # exchange can drop the session into a SHELL (observed as "ve1:~$"), which
+    # looks nothing like a NOS problem.
+    #
+    # The SAME password is re-used deliberately -- the netlab day-0 declares
+    # admin/admin and netlab-initial authenticates with it afterwards, so
+    # rotating here would lock the platform out of the device it just built.
+    # Verified accepted on 20.7.1.
+    i = child.expect([
+        r"(?i)you must set an initial admin password",
+        r"(?i)current password:",
+        r"(?i)new password:",
+        CONFIG_PROMPT,
+        PROMPT,
+        LOGIN_PROMPT,
+        LOCKED_OUT,
+        r"(?i)login incorrect",
+        RE_ENTER_PW,
+        PW_MISMATCH,
+        pexpect.TIMEOUT,
+        TRY_AGAIN,
+        CDB_FATAL,
+        REBOOTING,
+    ], timeout=120)
+    if i in (12, 13):
+        _die_console_fatal(child)
+    if i == 10:
+        # A TIMEOUT IS A RESULT, NOT A TRACEBACK. 120 s with nothing recognisable
+        # after the password means the console is in a dialog this script does
+        # not know; say what it printed and let the restart re-attach through
+        # wait_login, which knows more states than this list.
+        tail = " ".join(((child.before or "")).split())[-200:]
+        sys.exit("no recognisable prompt within 120s after the password on %s/%s; "
+                 "console said: %r" % (NS, VMI, tail))
+    if i == 11:
+        i = 9  # "Try again..." precedes a fresh "Password:" -- re-answer the pair
+    if i == 8:
+        # Parked halfway through the forced-password dialog: the device is
+        # waiting for the CONFIRMATION of a password we already sent. Finish the
+        # pair rather than starting over -- starting over is what produces the
+        # mismatch below.
+        log("console was parked at the password confirmation; completing it")
+        child.sendline(PASS)
+        if settle_after_password(child, timeout=90) == "login":
+            return False
+        return True
+    if i == 9:
+        # The device rejected a half-finished pair (usually our own opening
+        # newline landing in the dialog). It re-presents "Password:", so answer
+        # the WHOLE pair cleanly.
+        log("device reported a password mismatch; re-answering the pair")
+        child.expect(FIRST_PW, timeout=30)
+        child.sendline(PASS)
+        child.expect(RE_ENTER_PW, timeout=30)
+        child.sendline(PASS)
+        if settle_after_password(child, timeout=90) == "login":
+            return False
+        return True
+    if i == 6:
+        _on_locked_out(child)
+        return False
+    if i == 7:
+        # The device REFUSED the credential and said so. Returning False here
+        # (rather than falling through to the login: match that follows it)
+        # keeps the caller's per-credential accounting honest.
+        log("console refused the credential (attempt %d/%d)" % (attempt, LOGIN_ATTEMPTS))
+        return False
+    if i == 5:
+        log("authentication bounced back to a login prompt (attempt %d/%d); retrying" % (attempt, LOGIN_ATTEMPTS))
+        return False
+    if i == 0:
+        child.expect(FIRST_PW, timeout=30)
+        child.sendline(PASS)
+        child.expect(r"(?i)re-?enter password:", timeout=30)
+        child.sendline(PASS)
+        if settle_after_password(child, timeout=90) == "login":
+            return False
+    elif i == 1:
+        # "Current password:" -- the box is asking what it holds NOW, which is
+        # the credential we just authenticated with, NOT the one being set.
+        # Sending the declared password here fails the change on a factory box
+        # and the error looks like a rejected NEW password.
+        child.sendline(candidate or PASS); child.expect(r"(?i)new password:", timeout=30)
+        child.sendline(PASS); child.expect(r"(?i)(re-?enter|confirm|retype).*password:", timeout=30)
+        child.sendline(PASS)
+        if settle_after_password(child, timeout=60) == "login":
+            return False
+    elif i == 2:
+        child.sendline(PASS); child.expect(r"(?i)(re-?enter|confirm|retype).*password:", timeout=30)
+        child.sendline(PASS)
+        if settle_after_password(child, timeout=60) == "login":
+            return False
+    # i in (3, 4): already at a prompt -- the password was set on an earlier run.
+    return True
+
+class LoginBounce(Exception):
+    """The console fell back to a login prompt mid-exchange. vManage restarts
+    its console session after first-boot storage init (and getty can expire,
+    patch 0028) -- either way the answer is to log in again, not to fail."""
+
+def enter_config(child):
+    """'config terminal' on newer builds, 'config' on older ones. Try the first
+    and fall back rather than guessing from a version string.
+
+    DRAIN FIRST. Without it the expect() below settles on a STALE prompt that is
+    already sitting in the buffer -- PROMPT matches a bare "vsmart#" left over
+    from the previous command -- so the fallback fires even though
+    "config terminal" worked, and a second "config" is typed while already in
+    configuration mode.
+
+    Measured 2026-09-04 on vSmart, the first run that ever reached the overlay
+    commit:
+
+        config terminal
+        Entering configuration mode terminal
+        vsmart(config)# config
+        ----------------^
+        syntax error: unknown command
+        device rejected config line 1: 'vpn 0'
+
+    "config terminal" had SUCCEEDED. The error is entirely self-inflicted, and it
+    then swallowed the real first overlay line. This is the same
+    un-drained-buffer trap _show and report_storage's _sh are commented for;
+    enter_config simply never got the same treatment."""
+    _drain(child)
+    child.sendline("config terminal")
+    i = child.expect([CONFIG_PROMPT, r"(?i)syntax error|unknown command|% *invalid", PROMPT,
+                      LOGIN_PROMPT], timeout=60)
+    if i == 0:
+        return
+    if i == 3:
+        raise LoginBounce()
+
+    # NOT SEEING a config prompt is not the same as "config terminal failed",
+    # and 0044 and 0045 both mistook one for the other. Draining first was
+    # correct and did not help, because the read that matches here is not a
+    # STALE one -- it is a live one this expect cannot order. pexpect returns
+    # the pattern that starts EARLIEST in whatever chunk it has read, so a
+    # partial read that ends before "vsmart(config)#" arrives can settle on
+    # something else entirely while "config terminal" is in fact succeeding.
+    #
+    # So ASK the device what mode it is in instead of inferring it. A bare
+    # newline reprints the prompt, and the prompt IS the mode. Measured
+    # 2026-09-04 on vSmart, from the guest console (not the injector's own
+    # rendering, which is what misled the two previous attempts):
+    #
+    #     vsmart# config terminal
+    #     Entering configuration mode terminal
+    #     vsmart(config)# config          <- this fallback, fired wrongly
+    #     syntax error: unknown command
+    #     vsmart(config)# vpn 0
+    #     vsmart(config-vpn-0)#           <- the overlay applied ANYWAY
+    #
+    # "config terminal" had worked both times. The only real damage was the
+    # error text the stray "config" left behind, which apply_config then
+    # attributed to the next line -- see the drain there.
+    _drain(child)
+    child.sendline("")
+    j = child.expect([CONFIG_PROMPT, PROMPT, LOGIN_PROMPT], timeout=60)
+    if j == 0:
+        return
+    if j == 2:
+        raise LoginBounce()
+    _drain(child)
+    child.sendline("config")
+    child.expect(CONFIG_PROMPT, timeout=60)
+
+def apply_config(child, lines):
+    sent = 0
+    for raw in lines:
+        line = raw.rstrip("\r\n")
+        if line.lstrip().startswith("#!") or line.lstrip().startswith("{#"):
+            sys.exit("refusing to paste line %r: the rendered startup-config looks "
+                     "like a template artefact, not device config" % line[:60])
+        # DRAIN BEFORE THE LINE, so this line is judged on its OWN answer.
+        # Without it the previous command's trailing text is still in the
+        # buffer when the expect below runs, and any error in it is reported
+        # against a line that has not been typed yet. Measured 2026-09-04:
+        # a stray "config" left "syntax error: unknown command" behind, and
+        # this loop exited with "device rejected config line 1: 'vpn 0'" --
+        # a line the device had just ACCEPTED, as the guest console shows.
+        # A wrong verdict on a good line is worse than no verdict.
+        _drain(child)
+        child.sendline(line)
+        sent += 1
+        # Surface a rejection against the line that caused it instead of failing
+        # opaquely at commit time.
+        i = child.expect([CONFIG_PROMPT, r"(?i)syntax error|unknown (element|command)|% *invalid", pexpect.TIMEOUT], timeout=30)
+        if i == 1:
+            try:
+                child.expect([CONFIG_PROMPT, PROMPT, pexpect.TIMEOUT], timeout=15)
+            except Exception:
+                pass
+            detail = " ".join(((child.before or "")).split())
+            sys.exit("device rejected config line %d: %r -- device said: %s"
+                     % (sent, line[:120], detail[:400] or "<no detail>"))
+    log("pasted %d config line(s)" % sent)
+
+def commit_failure(child, what):
+    """Report what the DEVICE said, not just that something failed.
+
+    The first version exited on the match alone and printed "Aborted: v" -- the
+    message truncated exactly where it started being useful. Drain to the next
+    prompt so the operator sees the device's actual objection.
+    """
+    try:
+        child.expect([CONFIG_PROMPT, PROMPT, pexpect.TIMEOUT], timeout=30)
+    except Exception:
+        pass
+    detail = ((child.before or "") + (child.after if isinstance(child.after, str) else ""))
+    detail = " ".join(detail.split())
+    sys.exit("%s -- device said: %s" % (what, detail[:800] or "<no detail>"))
+
+def commit(child):
+    child.sendline("commit")
+    i = child.expect([r"(?i)commit complete", r"(?i)\(yes/no\)|\[confirm", r"(?i)failed|aborted|error", CONFIG_PROMPT], timeout=180)
+    if i == 1:
+        child.sendline("yes")
+        i = child.expect([r"(?i)commit complete", r"(?i)failed|aborted|error", CONFIG_PROMPT], timeout=180)
+        if i == 1:
+            commit_failure(child, "commit failed after confirmation")
+    elif i == 2:
+        commit_failure(child, "commit failed")
+    child.expect(CONFIG_PROMPT, timeout=60)
+    child.sendline("end")
+    child.expect(PROMPT, timeout=60)
+
+def connect_console(pod, attempts=60, delay=10):
+    """Attach to ttyS0, WAITING for it rather than dying.
+
+    The injector is created as soon as the VM object exists, but qemu only binds
+    the serial socket once the guest actually starts, and the cold containerDisk
+    pull in front of that can take minutes. Spawning once and letting the EOF
+    propagate turned that ordinary race into a crash loop -- which the platform
+    then read as a NOS failure. Retry quietly until the socket answers.
+    """
+    for attempt in range(1, attempts + 1):
+        child = pexpect.spawn(
+            "kubectl",
+            ["exec", "-i", "-n", NS, pod, "-c", "compute", "--",
+             "sh", "-c", "exec nc -U $(ls -d /var/run/kubevirt-private/*/virt-serial0 | head -1)"],
+            encoding="utf-8", timeout=60, echo=False)
+        child.sendline("")
+        i = child.expect([pexpect.EOF, pexpect.TIMEOUT,
+                          LOGIN_PROMPT, FIRST_PW, CONFIG_PROMPT, PROMPT,
+                          r"(?i)you must set an initial admin password"], timeout=15)
+        if i != 0:
+            log("console attached on attempt %d" % attempt)
+            child.logfile_read = sys.stdout
+            return child
+        # EOF: the socket is not there yet (or nc could not reach it).
+        try:
+            child.close(force=True)
+        except Exception:
+            pass
+        if attempt % 6 == 0:
+            log("waiting for ttyS0 to appear (attempt %d/%d)" % (attempt, attempts))
+        time.sleep(delay)
+    sys.exit("ttyS0 never became available on %s/%s after %ds"
+             % (NS, VMI, attempts * delay))
+
+def launcher_pod():
+    """Resolve the virt-launcher pod backing this VMI, by KubeVirt's own label."""
+    out = subprocess.run(
+        ["kubectl", "get", "pods", "-n", NS, "-l", "vm.kubevirt.io/name=" + VMI,
+         "--field-selector=status.phase=Running",
+         "-o", "jsonpath={.items[0].metadata.name}"],
+        capture_output=True, text=True, timeout=60)
+    name = (out.stdout or "").strip()
+    if not name:
+        sys.exit("no Running virt-launcher pod for VMI %s/%s (stderr: %s)"
+                 % (NS, VMI, (out.stderr or "").strip()[:200]))
+    return name
+
+def split_payloads(lines):
+    """Separate the CONFIG half of day-0 from the post-commit payloads.
+
+    Almost everything netlab renders is configuration and is pasted inside
+    'config' and committed. The enterprise root CA is not: installing a trust
+    anchor is an EXEC operation ('request root-cert-chain install <path>') with
+    no configuration stanza behind it, so it cannot go through the same path.
+
+    netlab marks the boundary with a sentinel line:
+
+        !! skyforge-post-commit <kind>
+
+    Everything before the first sentinel is config. Each sentinel opens a named
+    payload that runs AFTER the commit.
+
+    THE PAYLOAD IS DATA, NOT COMMANDS. The only kind understood is 'root-ca',
+    and its body is a PEM. The injector -- not the template -- decides what
+    installing a root CA means. That is deliberate: a device template must not
+    become a channel for arbitrary shell on the appliance, and an unknown kind
+    is refused rather than executed.
+    """
+    config, payloads, kind = [], {}, None
+    for raw in lines:
+        line = raw.rstrip("\r\n")
+        marker = line.strip()
+        if marker.startswith("!! skyforge-post-commit"):
+            parts = marker.split()
+            if len(parts) < 3:
+                sys.exit("malformed post-commit sentinel: %r" % marker[:80])
+            kind = parts[2]
+            if kind not in ("root-ca",):
+                sys.exit("unknown post-commit payload kind %r -- the injector "
+                         "refuses payloads it does not understand rather than "
+                         "running them" % kind)
+            payloads.setdefault(kind, [])
+            continue
+        if kind is None:
+            config.append(line)
+        else:
+            payloads[kind].append(line)
+    return config, {k: "\n".join(v).strip() for k, v in payloads.items()}
+
+
+def install_root_ca(child, pem):
+    """Place the fabric's enterprise root CA and install it as a trust anchor.
+
+    WHY DAY-0 CARRIES THIS AT ALL. Every other onboarding step runs on the
+    cisco.catalystwan collection. This one cannot: the SDK has no endpoint that
+    pushes a trust anchor to a device (1025 endpoints across 125 files, zero
+    matches for chain/trust/anchor/bundle/push/distribute). The only root-CA
+    operations store the CA on vManage; install_signed_cert installs the
+    device's OWN LEAF. Measured after doing everything the SDK offers,
+    'show certificate root-ca-cert | include <org>' returned nothing on both
+    controllers -- so the anchor has to arrive out of band, and before
+    certificates work the console is the only channel there is.
+
+    vshell, then a heredoc, then back to the CLI. The device has no other way to
+    receive a file: there is no scp target, and the install command takes a PATH.
+    'request root-cert-chain install' is EXEC-only, which is why this runs after
+    the commit rather than inside the config paste.
+
+    Proven end-to-end on a live vSmart 20.7.1 (2026-09-01): the console places
+    the PEM, the install answers 'Successfully installed the root certificate
+    chain', and the CA then appears in 'show certificate root-ca-cert'.
+    """
+    dest = "/home/admin/skyforge-root-ca.pem"
+    log("installing the enterprise root CA (%d bytes of PEM)" % len(pem))
+
+    child.sendline("vshell")
+    i = child.expect([SHELL_PROMPT, r"(?i)syntax error|unknown command", pexpect.TIMEOUT], timeout=60)
+    if i != 0:
+        sys.exit("vshell did not open a shell, so the root CA cannot be placed "
+                 "(the install command takes a PATH and there is no other way "
+                 "to get a file onto the box)")
+
+    # Quoted delimiter: the shell must not expand anything inside a certificate.
+    child.sendline("cat > %s <<'SKYFORGE_PEM_EOF'" % dest)
+    for line in pem.splitlines():
+        child.sendline(line)
+    child.sendline("SKYFORGE_PEM_EOF")
+    child.expect(SHELL_PROMPT, timeout=120)
+
+    # VERIFY THE FILE BEFORE INSTALLING IT. A PEM mangled in transit makes the
+    # install fail with a message about the CHAIN, which sends the reader after
+    # a trust problem that does not exist.
+    child.sendline("openssl x509 -in %s -noout -subject >/dev/null 2>&1 && echo SKYFORGE_PEM_OK || echo SKYFORGE_PEM_BAD" % dest)
+    j = child.expect([r"SKYFORGE_PEM_OK", r"SKYFORGE_PEM_BAD", pexpect.TIMEOUT], timeout=60)
+    if j != 0:
+        sys.exit("the root CA did not survive the console transfer: openssl "
+                 "cannot parse %s as a certificate" % dest)
+    child.expect(SHELL_PROMPT, timeout=60)
+
+    child.sendline("exit")
+    child.expect(PROMPT, timeout=60)
+
+    child.sendline("request root-cert-chain install %s" % dest)
+    k = child.expect([r"(?i)successfully installed the root certificate chain",
+                      r"(?i)failed to install|error:",
+                      pexpect.TIMEOUT], timeout=240)
+    if k != 0:
+        detail = " ".join(((child.before or "") + (child.after if isinstance(child.after, str) else "")).split())
+        sys.exit("root-cert-chain install failed -- device said: %s" % (detail[:400] or "<no detail>"))
+    child.expect(PROMPT, timeout=60)
+    log("enterprise root CA installed")
+
+
+OVERLAY_PATH = "/home/admin/skyforge-day0-overlay.cli"
+
+def cloud_config_overlay(lines):
+    """The CLI lines netlab rendered INTO the cloud-config for the injector to
+    commit after the seed. Why they exist: vSmart's init-path validator allows
+    one interface per VPN ("Maximum one tunnel interface allowed on vsmart",
+    bisected 2026-09-02), and a controller needs eth0 (management) AND its
+    transport in VPN 0 -- the second one can only be committed at runtime.
+    The document is our own template's output, so this reads the write_files
+    entry by shape (path, then a literal "content: |" block) rather than
+    pulling in a YAML parser the injector image is not required to carry."""
+    out = []
+    in_entry = False
+    content_indent = None
+    for raw in lines:
+        line = raw.rstrip("\r\n")
+        stripped = line.strip()
+        if content_indent is None:
+            if re.match(r"^-?\s*path:\s*%s\s*$" % re.escape(OVERLAY_PATH), stripped):
+                in_entry = True
+                continue
+            if in_entry and re.match(r"^-\s*path:", stripped):
+                in_entry = False
+                continue
+            if in_entry and stripped.startswith("content:"):
+                content_indent = -1
+            continue
+        if not stripped:
+            out.append("")
+            continue
+        indent = len(line) - len(line.lstrip(" "))
+        if content_indent == -1:
+            content_indent = indent
+        if indent < content_indent:
+            break
+        out.append(line[content_indent:])
+    return [l for l in out if l.strip()]
+
+
+def apply_overlay(child, overlay):
+    """Commit the overlay lines, then prove each interface landed."""
+    enter_config(child)
+    apply_config(child, overlay)
+    commit(child)
+    want = [m.group(1) for l in overlay for m in [re.match(r"\s*interface\s+(\S+)", l)] if m]
+    child.sendline("show running-config vpn | include interface | nomore")
+    child.expect(PROMPT, timeout=60)
+    got = child.before or ""
+    missing = [w for w in want if w not in got]
+    if missing:
+        sys.exit("overlay committed but the running config does not show interface(s) %s; "
+                 "device said: %s" % (", ".join(missing), " ".join(got.split())[:300]))
+    log("overlay committed: %s" % ", ".join(want))
+
+
+def is_cloud_config(lines):
+    """A day-0 that starts with '#cloud-config' was DELIVERED BY cloud-init on
+    the config-drive, not typed here. Nothing in it is CLI, and pasting YAML
+    at a ConfD prompt would be exactly wrong."""
+    for l in lines:
+        if l.strip():
+            return l.strip() == "#cloud-config"
+    return False
+
+
+def verify_seed(child):
+    """Cloud-config mode: the seed did the work, this proves it.
+
+    Measured 2026-09-02 on 20.7.1: a cloud-init seed of /etc/confd/init/zcloud.xml
+    (+ /etc/default/inited, /etc/default/personality, and the enterprise root CA
+    written to /usr/share/viptela/root-ca.crt) boots straight to a login prompt
+    with NO wizard, admin/admin logs in, and show certificate root-ca-cert
+    already lists the fabric CA -- no request root-cert-chain install, no
+    vshell, no heredoc. So this pod's job shrinks to the day-0 VERDICT the
+    runtime gate waits on: login (the ordinary, deterministic exchange), read
+    the identity and the trust anchor back, exit 0 only if both are there.
+    """
+    # CAPTURE THE OUTPUT, DO NOT RACE THE PROMPT. Send the command, read to the
+    # NEXT prompt, then test what came back -- the device queues several prompts
+    # during login and matching PROMPT-or-token would settle on a stale prompt
+    # before the command's output arrived (measured against a console replay).
+    def _show(cmd):
+        # Drain anything already buffered so BEFORE holds only this command output.
+        try:
+            while True:
+                child.expect([PROMPT, pexpect.TIMEOUT], timeout=2)
+                if child.after is pexpect.TIMEOUT:
+                    break
+        except Exception:
+            pass
+        child.sendline(cmd)
+        child.expect(PROMPT, timeout=90)
+        return child.before or ""
+
+    def _fail(msg):
+        """Produce the storage report HERE -- on the failure path only.
+
+        It is the densest evidence we have about why a seed did not take (did
+        cloud-init make a filesystem on the data volume at all?), and this is
+        the one moment it is worth the console time. On a healthy boot it told
+        us nothing anyone read, while adding console interaction to the
+        critical path -- and console interaction is the raciest thing this
+        script does.
+        """
+        try:
+            report_storage(child)
+        except Exception as exc:  # a diagnostic must never replace the real error
+            log("storage report unavailable (%s); the failure below is the real one" % exc)
+        sys.exit(msg)
+
+    if not re.search(r"system-ip\s+\d", _show("show running-config system | nomore")):
+        _fail("cloud-config seed did NOT take: no system-ip in running-config "
+              "(the ConfD init file was not ingested)")
+    if not re.search(r"Subject:.*CN=", _show("show certificate root-ca-cert | nomore")):
+        _fail("cloud-config seed did NOT install a root CA chain "
+              "(show certificate root-ca-cert lists no Subject)")
+    log("cloud-config seed verified: identity present, root chain installed")
+    if os.environ.get("SKYFORGE_VIPTELA_STORAGE_REPORT") == "1":
+        log("SKYFORGE_VIPTELA_STORAGE_REPORT=1: producing the storage report on a healthy boot")
+        report_storage(child)
+
+
+def report_storage(child):
+    """Say what cloud-init did with the data volume. EVIDENCE ONLY -- never fatal.
+
+    WHY THIS EXISTS. vManage runs its NMS services in Docker INSIDE the guest,
+    with data-root /var/lib/nms/docker, and that lives on the data filesystem
+    mounted at /opt/data from the second disk. On the 20.7.1 image that volume
+    arrived pre-made as a SECOND IMAGE LAYER, so it was always formatted. The
+    20.18.4 image is a SINGLE layer -- measured: 1 layer vs 2, and its own
+    /dev/sda2 is an empty ext4 that a read-only containerDisk cannot persist to
+    -- so the writable volume is the raw KubeVirt emptyDisk, and something has
+    to make a filesystem on it.
+
+    The cloud-config asks for exactly that (disk_setup + fs_setup ext4 on
+    /dev/vdb, mounts -> /opt/data) and this image's cc_disk_setup honours both
+    keys. But when the API never came up on 20.18.4 there was no way to tell
+    whether those modules ran, failed, or were skipped: the guest reported only
+    "Cannot connect to the Docker daemon", which is a SYMPTOM three layers down
+    from the cause.
+
+    So ask the guest directly, once, and print it. Everything here is read-only
+    -- cloud-init status, lsblk, df, and the tail of cloud-init's own log.
+
+    NOT FATAL, DELIBERATELY. A diagnostic that can fail the run replaces the
+    error it was added to explain; that exact mistake cost a day on the SD-WAN
+    certificate lane. Every failure path here is swallowed and reported as text.
+    """
+    # ASK THE CLI FIRST -- IT IS THE ONLY PRIVILEGED VIEW WE HAVE.
+    #
+    # Measured 2026-09-04: the vshell half of this report came back with
+    # "Permission denied" for stat on /etc/confd/init/, for "sv status", and for
+    # container-manager's log. vshell runs as "admin" (uid 1000, shell
+    # /usr/sbin/viptela_cli) and THERE IS NO sudo BINARY IN THE IMAGE AT ALL --
+    # verified offline against the 20.18.4 rootfs squashfs. So the root-owned
+    # paths that would name container-manager's shut gate directly are simply
+    # unreadable, and no retry or timeout changes that.
+    #
+    # What IS readable is the device's own CLI, which is the vendor's supported
+    # interface and needs no root. "check_interface" gates on confd reporting
+    # that cfgmgr created interfaces with IP addresses -- so asking the CLI
+    # whether the running config actually HOLDS that interface config answers
+    # the same question from the other side. If the config is present and
+    # container-manager still refuses, the cause is one of the other two gates;
+    # if it is absent, day-0 never reached confd and that is the whole story.
+    #
+    # Runs in CLI (PROMPT) mode, BEFORE vshell. Each command is independent: an
+    # unrecognised one returns the device's own error text, which is still
+    # evidence, so a wrong guess here degrades the report rather than breaking it.
+    # EVERY COMMAND ENDS IN "| nomore". THE DEVICE PAGES BY DEFAULT.
+    #
+    # Without it the CLI emits "--More--" and waits for a keypress, so
+    # expect(PROMPT) blocks until its timeout on every single command. Measured
+    # 2026-09-04 on the first run that got this far: vManage returned EMPTY
+    # sections for vpn 0 / interfaces / system status / nms status, and vsmart's
+    # injector burned restarts sitting on a pager with
+    # "14428K buffers, 425388K cache" and "--More--" on the console.
+    #
+    # verify_seed in this same file already does this -- "show certificate
+    # root-ca-cert | nomore" -- so the convention existed and this section simply
+    # failed to follow it. A diagnostic that hangs the reader it runs in is worse
+    # than no diagnostic.
+    for label, cmd in (
+            ("system config",  "show running-config system | nomore"),
+            ("vpn 0 config",   "show running-config vpn 0 | nomore"),
+            ("vpn 512 config", "show running-config vpn 512 | nomore"),
+            ("interfaces",     "show interface | tab | nomore"),
+            ("system status",  "show system status | nomore"),
+            ("nms status",     "request nms all status | nomore"),
+    ):
+        try:
+            child.sendline(cmd)
+            child.expect(PROMPT, timeout=90)
+            body = (child.before or "")
+        except Exception as exc:
+            body = "<failed: %s>" % exc
+        # DRAIN AFTER EVERY READ, INCLUDING THE ONES THAT FAIL.
+        #
+        # These are diagnostics and some of them are legitimately wrong for the
+        # node they run on -- "request nms all status" is vManage-only, and a
+        # vSmart answers it with "syntax error: incomplete path" followed by its
+        # entire command list. That text stays in the buffer, and the NEXT
+        # operation inherits it.
+        #
+        # Measured 2026-09-04 on vSmart: enter_config's expect list contains
+        # "unknown command", so the leftover help dump matched at index 1, the
+        # fallback fired after "config terminal" had already succeeded, a second
+        # "config" was typed in configuration mode, and the overlay's real first
+        # line was consumed. Two patches chased that as a drain-before problem in
+        # enter_config -- which was already correct -- because the poison was
+        # written here, one function earlier.
+        #
+        # Draining after each read is the general fix: it costs one quiet period
+        # per command and it does not require this script to know which commands
+        # are valid on which personality, which it has no way to know.
+        _drain(child)
+        log("cli report [%s]:" % label)
+        lines = [l.rstrip() for l in body.splitlines() if l.strip()]
+        if lines and cmd.split()[0] in lines[0]:
+            lines = lines[1:]
+        for line in (lines[:40] or ["<no output>"]):
+            log("    %s" % line.strip())
+
+    # MARKER FRAMING, NOT PROMPT MATCHING.
+    #
+    # Measured 2026-09-04 on 20.18.4: this function reported
+    #   "could not enter vshell (Timeout exceeded. buffer: 'Cannot connect to
+    #    the Docker daemon at unix:///var/run/docker.sock...')"
+    # and returned nothing at all, on the exact run it existed to explain.
+    #
+    # The guest prints that line to ttyS0 roughly every two seconds from boot
+    # until dockerd starts -- and when dockerd never starts, forever. Waiting
+    # for a PROMPT REGEX on a console that another process is writing to is a
+    # race the flood wins: the prompt is there, but it is interleaved with, and
+    # often split by, a line nobody asked for.
+    #
+    # The fix is not a longer timeout and not a retry -- both would still be
+    # guessing at when the console is quiet, and it is never quiet. Instead
+    # every command is wrapped in a UNIQUE start/end marker and we read BETWEEN
+    # the markers. A marker either arrives or it does not; no amount of
+    # unrelated console traffic can forge or hide one. That also gives a
+    # positive control for the shell itself: if the marker comes back, we are
+    # demonstrably in a shell, which is a stronger claim than "a regex that
+    # looks like a prompt appeared".
+    marker_seq = [0]
+
+    def _marked(cmd, timeout=90):
+        marker_seq[0] += 1
+        tag = "SFDIAG%d_%d" % (os.getpid(), marker_seq[0])
+        try:
+            # THE TAG IS A printf ARGUMENT, NEVER A LITERAL IN THE COMMAND LINE.
+            # The tty echoes back the line we send, so a literal marker there is
+            # matched by expect() as though it were output -- measured: the
+            # capture came back as "\\n'; true; printf '", a fragment of our own
+            # echoed command. Passing the tag as %s keeps the ASSEMBLED marker
+            # out of the echo and present only in the real output.
+            child.sendline("printf '@@%%s_BEGIN@@\\n' %s; %s; printf '@@%%s_END@@\\n' %s" % (tag, cmd, tag))
+            child.expect("@@%s_BEGIN@@" % tag, timeout=timeout)
+            child.expect("@@%s_END@@" % tag, timeout=timeout)
+        except Exception as exc:
+            return None, "<no marker: %s>" % exc
+        body = child.before or ""
+        # Drop the flood lines that are interleaved into every capture. They are
+        # the SYMPTOM this diagnostic is here to explain, so they are reported
+        # once by the caller rather than repeated inside every section.
+        keep = [l.rstrip() for l in body.splitlines()
+                if l.strip() and "Cannot connect to the Docker daemon" not in l
+                and "@@%s_" % tag not in l]
+        return keep, None
+
+    # Enter vshell and PROVE it with a marker rather than a prompt regex.
+    child.sendline("vshell")
+    probe, err = _marked("true")
+    if err is not None:
+        log("storage report: could not confirm a shell (%s); skipping" % err)
+        return
+
+    def _sh(cmd, timeout=90):
+        lines, err = _marked(cmd, timeout=timeout)
+        if err is not None:
+            return ["<failed: %s>" % err]
+        return lines
+
+    # WHAT TO ASK, AND WHY THESE.
+    #
+    # container-manager is the service that unpacks extra-packages.tar.gz and
+    # bind-mounts /opt/data/nms onto /var/lib/nms, which is where dockerd's
+    # data-root lives. Read from its own run script, it refuses in three places:
+    #
+    #     data_partition_mounted  || exit 128     # mountpoint -q /opt/data
+    #     service_running sysmgr  || exit 128
+    #     check_interface         || exit 128     # confd vconfd-initial-read-priority
+    #
+    # so "dockerd is not running" has three candidate causes and the symptom
+    # looks identical for all of them. Ask which gate is shut rather than
+    # inferring it.
+    #
+    # THE ORDERING QUESTION. ConfD loads /etc/confd/init/*.xml only into an
+    # EMPTY CDB at first start, and confd's run script guards that on
+    # /etc/viptela/cdb_init_done. Our day-0 delivers the device config by having
+    # cloud-init WRITE a file into that directory -- so if confd initialised
+    # before the write landed, the config was never read and check_interface can
+    # never pass. That is a claim about ORDERING, and the two mtimes below
+    # settle it as a measurement: if cdb_init_done predates zcloud.xml, the race
+    # is real and the fix is to deliver day-0 earlier (bootcmd runs in
+    # init-local) or through the console. If it does not, the cause is elsewhere
+    # and this rules the theory out instead of confirming it.
+    for label, cmd in (
+            ("cloud-init status", "cloud-init status --long 2>&1 | head -20"),
+            ("block devices",     "lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT 2>&1 | head -20"),
+            ("data filesystem",   "df -h /opt/data /var/lib/nms 2>&1 | head -10"),
+            ("opt/data mounted",  "mountpoint /opt/data 2>&1; ls -la /opt/data 2>&1 | head -12"),
+            ("docker root",       "ls -ld /var/lib/nms /var/lib/nms/docker 2>&1 | head -4"),
+            ("extra-packages",    "ls -la /opt/data/extra-packages 2>&1 | head -8; ls -la /boot/*/extra-packages.tar.gz 2>&1 | head -3"),
+            ("day-0 vs cdb init", "stat -c '%y %n' /etc/confd/init/zcloud.xml /etc/viptela/cdb_init_done 2>&1"),
+            ("confd init dir",    "ls -la /etc/confd/init/ 2>&1 | head -15"),
+            ("read priority",     "CONFD_IPC_ACCESS_FILE=/etc/confd/confd_ipc_secret confd_cmd -o -c 'get vconfd-initial-read-priority' 2>&1 | head -5"),
+            ("sysmgr service",    "sv status sysmgr confd container-manager 2>&1 | head -6"),
+            ("container-mgr log", "tail -30 /var/log/container-manager/* 2>/dev/null | tail -30"),
+            ("disk_setup log",    "grep -iE 'disk_setup|fs_setup|mounts|vdb' /var/log/cloud-init.log 2>&1 | tail -25"),
+    ):
+        lines = _sh(cmd)
+        log("storage report [%s]:" % label)
+        # The first line back is the shell echoing the command we sent, which
+        # contains the printf wrapper; drop exactly that and nothing else.
+        if lines and ("printf" in lines[0] or cmd.split()[0] in lines[0]):
+            lines = lines[1:]
+        for line in (lines or ["<no output>"]):
+            log("    %s" % line.strip())
+
+    # Leaving the shell is best-effort and framed the same way: expect the
+    # marker we can prove, not a prompt the flood can hide.
+    try:
+        child.sendline("exit")
+        _marked("true", timeout=30)
+    except Exception:
+        pass
+
+
+def main():
+    with open(CFG) as fh:
+        lines = fh.read().splitlines()
+    if not [l for l in lines if l.strip()]:
+        sys.exit("startup-config is empty; nothing to inject")
+    if is_cloud_config(lines):
+        pod = launcher_pod()
+        log("day-0 is a cloud-config (delivered by cloud-init); verifying the seed on %s/%s via %s" % (NS, VMI, pod))
+        child = connect_console(pod)
+        for attempt in range(1, LOGIN_ATTEMPTS + 1):
+            try:
+                state = login(child)
+                if state == "config":
+                    child.sendline("end"); child.expect(PROMPT, timeout=60)
+                verify_seed(child)
+                overlay = cloud_config_overlay(lines)
+                if overlay:
+                    log("seed left %d overlay line(s) for the CLI; committing them" % len(overlay))
+                    apply_overlay(child, overlay)
+                break
+            except LoginBounce:
+                log("console bounced to a login prompt (attempt %d/%d); logging in again" % (attempt, LOGIN_ATTEMPTS))
+                continue
+        else:
+            sys.exit("could not hold a session long enough to verify the seed after %d attempts" % LOGIN_ATTEMPTS)
+        log("day-0 applied and committed")
+        child.sendline("exit")
+        time.sleep(1)
+        return 0
+    lines, payloads = split_payloads(lines)
+    if not [l for l in lines if l.strip()]:
+        sys.exit("startup-config has no configuration once post-commit "
+                 "payloads are removed; nothing to inject")
+    pod = launcher_pod()
+    log("connecting to ttyS0 of %s/%s via %s" % (NS, VMI, pod))
+    # NOT virtctl console. KubeVirt serves that subresource only while the VMI
+    # is Running, and these NOS images never leave Scheduled -- measured
+    # 2026-08-15: the qemu domain is Running (virt-launcher logs the "resumed"/
+    # "unpaused" lifecycle event) and the guest reaches "System Ready" with a
+    # login prompt, while the VMI still reports phase=Scheduled /
+    # Ready=False / GuestNotRunning. virtctl console therefore EOFs instantly.
+    # Cluster-wide the split is per-IMAGE, not systemic: acisim and the
+    # linux-family VMs reach Running, every firewall/NOS image does not.
+    #
+    # The virt-launcher pod exposes the very same ttyS0 as a unix socket, so go
+    # straight to it and let KubeVirt hold whatever opinion it likes about phase.
+    # The socket directory is the VMI's UID, but it is globbed rather than
+    # derived so this does not break if that layout changes.
+    child = connect_console(pod)
+    # The whole login->config->paste->commit exchange retries as a UNIT on a
+    # login bounce. Measured on vManage 20.7.1: the first-boot storage init
+    # logs the console out BETWEEN reaching an operational prompt and
+    # 'config terminal', so any single-pass flow dies exactly there.
+    for attempt in range(1, LOGIN_ATTEMPTS + 1):
+        try:
+            state = login(child)
+            if state != "config":
+                enter_config(child)
+            apply_config(child, lines)
+            commit(child)
+            # POST-COMMIT, and inside the same retried unit. The root CA is only
+            # meaningful on a box whose day-0 committed, and commit() leaves the
+            # session at an operational prompt -- which is exactly where an EXEC
+            # command has to run. A login bounce here re-runs the config paste
+            # too, which is safe: both halves are idempotent.
+            if payloads.get("root-ca"):
+                install_root_ca(child, payloads["root-ca"])
+            break
+        except LoginBounce:
+            log("console bounced to a login prompt mid-exchange (attempt %d/%d); logging in again" % (attempt, LOGIN_ATTEMPTS))
+            continue
+    else:
+        sys.exit("could not hold a session long enough to apply day-0 after %d attempts" % LOGIN_ATTEMPTS)
+    log("day-0 applied and committed")
+    child.sendline("exit")
+    time.sleep(1)
+    return 0
+
+if __name__ == "__main__":
+    sys.exit(main())
+`
+
+// ensureKubeVirtViptelaSerialInjector creates the per-node companion that pastes
+// the netlab day-0 over ttyS0. Idempotent: the Viptela config store is
+// declarative, so a pod restart re-applying the same config is a no-op commit.
+func (n *Impl) ensureKubeVirtViptelaSerialInjector(ctx context.Context, labels map[string]string, configData []byte) error {
+	if n == nil || n.Proto == nil || !kubeVirtIsViptelaSerialInject(n.Proto.Model) {
+		return nil
+	}
+	if len(bytes.TrimSpace(configData)) == 0 {
+		return nil
+	}
+	name := kubeVirtViptelaInjectorResourceName(n.Name())
+	injLabels := kubeVirtViptelaInjectorLabels(n.Name(), labels)
+
+	sa := &corev1.ServiceAccount{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+	}
+	if _, err := n.KubeClient.CoreV1().ServiceAccounts(n.Namespace).Create(ctx, sa, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return err
+	}
+
+	role := &rbacv1.Role{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Rules:      kubeVirtViptelaInjectorRoleRules(),
+	}
+	roleClient := n.KubeClient.RbacV1().Roles(n.Namespace)
+	if _, err := roleClient.Create(ctx, role, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		if cur, err := roleClient.Get(ctx, name, metav1.GetOptions{}); err == nil {
+			cur.Rules = role.Rules
+			cur.Labels = injLabels
+			if _, err := roleClient.Update(ctx, cur, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+
+	rb := &rbacv1.RoleBinding{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		RoleRef:    rbacv1.RoleRef{APIGroup: "rbac.authorization.k8s.io", Kind: "Role", Name: name},
+		Subjects:   []rbacv1.Subject{{Kind: "ServiceAccount", Name: name, Namespace: n.Namespace}},
+	}
+	if _, err := n.KubeClient.RbacV1().RoleBindings(n.Namespace).Create(ctx, rb, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return err
+	}
+
+	// VERBATIM. Only trailing newline handling, no reformatting.
+	cfg := append(bytes.TrimRight(configData, "\r\n"), '\n')
+	secret := &corev1.Secret{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Type:       corev1.SecretTypeOpaque,
+		Data:       map[string][]byte{kubeVirtViptelaInjectorConfigFileName: cfg},
+	}
+	secClient := n.KubeClient.CoreV1().Secrets(n.Namespace)
+	if _, err := secClient.Create(ctx, secret, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		if cur, err := secClient.Get(ctx, name, metav1.GetOptions{}); err == nil {
+			cur.Data = secret.Data
+			cur.Labels = injLabels
+			if _, err := secClient.Update(ctx, cur, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+
+	cm := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Data:       map[string]string{kubeVirtViptelaInjectorScriptKey: kubeVirtViptelaInjectorScript},
+	}
+	cmClient := n.KubeClient.CoreV1().ConfigMaps(n.Namespace)
+	if _, err := cmClient.Create(ctx, cm, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		if cur, err := cmClient.Get(ctx, name, metav1.GetOptions{}); err == nil {
+			cur.Data = cm.Data
+			cur.Labels = injLabels
+			if _, err := cmClient.Update(ctx, cur, metav1.UpdateOptions{}); err != nil {
+				return err
+			}
+		}
+	}
+
+	pod := &corev1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: n.Namespace, Labels: injLabels},
+		Spec: corev1.PodSpec{
+			RestartPolicy:      corev1.RestartPolicyOnFailure,
+			ServiceAccountName: name,
+			Tolerations:        KNETolerations(),
+			NodeSelector:       KNENodeSelector(),
+			Containers: []corev1.Container{{
+				Name:            "viptela-serial-inject",
+				Image:           kubeVirtViptelaInjectorImage(),
+				ImagePullPolicy: kubeVirtViptelaInjectorPullPolicy(),
+				Command:         []string{"python3", "/inject/" + kubeVirtViptelaInjectorScriptKey},
+				Env: kubeVirtViptelaInjectorEnv(n),
+				VolumeMounts: []corev1.VolumeMount{
+					{Name: "config", MountPath: "/config", ReadOnly: true},
+					{Name: "script", MountPath: "/inject", ReadOnly: true},
+				},
+			}},
+			Volumes: []corev1.Volume{
+				{Name: "config", VolumeSource: corev1.VolumeSource{Secret: &corev1.SecretVolumeSource{SecretName: name}}},
+				{Name: "script", VolumeSource: corev1.VolumeSource{ConfigMap: &corev1.ConfigMapVolumeSource{LocalObjectReference: corev1.LocalObjectReference{Name: name}}}},
+			},
+		},
+	}
+	if _, err := n.KubeClient.CoreV1().Pods(n.Namespace).Create(ctx, pod, metav1.CreateOptions{}); err != nil && !apierrors.IsAlreadyExists(err) {
+		return err
+	}
+	return nil
+}
+
+// deleteKubeVirtViptelaSerialInjector tears down the injector's per-node resources.
+func (n *Impl) deleteKubeVirtViptelaSerialInjector(ctx context.Context) error {
+	if n == nil || n.Proto == nil || !kubeVirtIsViptelaSerialInject(n.Proto.Model) {
+		return nil
+	}
+	name := kubeVirtViptelaInjectorResourceName(n.Name())
+	if err := n.KubeClient.CoreV1().Pods(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.CoreV1().ConfigMaps(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.CoreV1().Secrets(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.RbacV1().RoleBindings(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.RbacV1().Roles(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	if err := n.KubeClient.CoreV1().ServiceAccounts(n.Namespace).Delete(ctx, name, metav1.DeleteOptions{}); err != nil && !apierrors.IsNotFound(err) {
+		return err
+	}
+	return nil
+}
diff --git a/topo/node/kubevirt_viptela_serial_test.go b/topo/node/kubevirt_viptela_serial_test.go
