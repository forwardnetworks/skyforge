+
+func normalizeKubeVirtModel(model string) string {
+	return strings.ToLower(strings.TrimSpace(model))
+}
+
+func kubeVirtModelSupportedByVendor(vendor tpb.Vendor, model string) bool {
+	models, ok := kubeVirtSupportedVMModelsByVendor[vendor]
+	if !ok {
+		return false
+	}
+	_, ok = models[normalizeKubeVirtModel(model)]
+	return ok
+}
+
+func kubeVirtHardwareProfileFor(model, image string) kubeVirtHardwareProfile {
+	normalizedModel := normalizeKubeVirtModel(model)
+	profile, ok := kubeVirtHardwareProfiles[normalizedModel]
+	if !ok {
+		profile = kubeVirtDefaultHardwareProfile
+	}
+	profile = cloneKubeVirtHardwareProfile(profile)
+	for i := range profile.ContainerDisks {
+		if profile.ContainerDisks[i].Path == kubeVirtDynamicContainerDiskPath {
+			profile.ContainerDisks[i].Path = kubeVirtContainerDiskPath(normalizedModel, image)
+		}
+	}
+	return profile
+}
+
+func cloneKubeVirtHardwareProfile(profile kubeVirtHardwareProfile) kubeVirtHardwareProfile {
+	profile.Firmware = cloneKubeVirtMap(profile.Firmware)
+	profile.RequiredNodeSelector = cloneKubeVirtStringMap(profile.RequiredNodeSelector)
+	profile.IdentityInputs = append([]string(nil), profile.IdentityInputs...)
+	profile.ReadinessProbes = append([]string(nil), profile.ReadinessProbes...)
+	profile.ConfigApplyRequires = append([]string(nil), profile.ConfigApplyRequires...)
+	if profile.ContainerDisks != nil {
+		profile.ContainerDisks = append([]kubeVirtContainerDiskSpec(nil), profile.ContainerDisks...)
+	}
+	return profile
+}
+
+func cloneKubeVirtStringMap(in map[string]string) map[string]string {
+	if in == nil {
+		return nil
+	}
+	out := make(map[string]string, len(in))
+	for key, value := range in {
+		out[key] = value
+	}
+	return out
+}
+
+func cloneKubeVirtMap(in map[string]any) map[string]any {
+	if in == nil {
+		return nil
+	}
+	out := make(map[string]any, len(in))
+	for key, value := range in {
+		out[key] = cloneKubeVirtValue(value)
+	}
+	return out
+}
+
+func cloneKubeVirtValue(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		return cloneKubeVirtMap(typed)
+	case []any:
+		out := make([]any, len(typed))
+		for i, item := range typed {
+			out[i] = cloneKubeVirtValue(item)
+		}
+		return out
+	default:
+		return value
+	}
+}
+
+func kubeVirtCPUModel(model string) string {
+	return kubeVirtHardwareProfileFor(model, "").CPUModel
+}
+
+func kubeVirtResourceRequests(model string, constraints map[string]string) map[string]any {
+	requests := map[string]any{}
+	if cpu := strings.TrimSpace(constraints["cpu"]); cpu != "" {
+		requests["cpu"] = cpu
+	}
+	if memory := strings.TrimSpace(constraints["memory"]); memory != "" {
+		requests["memory"] = memory
+	}
+	if storage := strings.TrimSpace(constraints["ephemeral-storage"]); storage != "" {
+		requests["ephemeral-storage"] = storage
+	}
+	if minimum := strings.TrimSpace(kubeVirtHardwareProfileFor(model, "").MinimumMemory); minimum != "" {
+		current, hasCurrent := requests["memory"].(string)
+		if !hasCurrent || kubeVirtQuantityLessThan(current, minimum) {
+			requests["memory"] = minimum
+		}
+	}
+	return requests
+}
+
+func kubeVirtQuantityLessThan(value, minimum string) bool {
+	qValue, err := resource.ParseQuantity(value)
+	if err != nil {
+		return true
+	}
+	qMinimum, err := resource.ParseQuantity(minimum)
+	if err != nil {
+		return false
+	}
+	return qValue.Cmp(qMinimum) < 0
+}
+
+func kubeVirtContainerDiskPath(model, image string) string {
+	model = strings.ToLower(strings.TrimSpace(model))
+	if model != "fortios" {
+		return ""
+	}
+	tag := image
+	// Strip a digest pin BEFORE looking for the tag. A reference like
+	// "...fortios:7.0.9-build0444-kne-r1@sha256:<hex>" has its LAST ':' inside
+	// "@sha256:", so LastIndex alone returned the 64-char digest as the "tag"
+	// and derived a filename that never existed -- the live demo-lab
+	// ImageVolume failure of 2026-09-14. netlab pins every image by digest.
+	if idx := strings.Index(tag, "@"); idx >= 0 {
+		tag = tag[:idx]
+	}
+	if idx := strings.LastIndex(tag, ":"); idx >= 0 {
+		tag = tag[idx+1:]
+	}
+	tag = strings.TrimSpace(tag)
+	if tag == "" {
+		return ""
+	}
+	if idx := strings.Index(tag, "-kne-"); idx >= 0 {
+		tag = tag[:idx]
+	}
+	tag = strings.TrimSpace(tag)
+	if tag == "" {
+		return ""
+	}
+	return "/fortios-" + tag + ".qcow2"
+}
+
+func kubeVirtInterfaceModel(model string) string {
+	return kubeVirtHardwareProfileFor(model, "").InterfaceModel
+}
+
+// kubeVirtMgmtInterfaceModel is the vNIC model for the masquerade management
+// interface. It falls back to InterfaceModel so a profile that does not care
+// says nothing, and only a profile with a management-specific reason declares
+// the override.
+func kubeVirtMgmtInterfaceModel(model string) string {
+	p := kubeVirtHardwareProfileFor(model, "")
+	if p.MgmtInterfaceModel != "" {
+		return p.MgmtInterfaceModel
+	}
+	return p.InterfaceModel
+}
+
+// kubeVirtDefaultMachineType is the machine type emitted for any VM NOS whose
+// hardware profile does not pin one explicitly. Talos-era KubeVirt (v1.8+)
+// validation only admits the q35 machine family (allowed: [q35* pc-q35*]) and
+// REJECTS the historical i440fx alias "pc". Defaulting to q35 here means no VM
+// CR is ever left to inherit the cluster-configured default machine type — which
+// on this KubeVirt would be rejected at admission (no VMI is created at all).
+const kubeVirtDefaultMachineType = "q35"
+
+func kubeVirtMachineType(model string) string {
+	if machineType := kubeVirtHardwareProfileFor(model, "").MachineType; machineType != "" {
+		return machineType
+	}
+	return kubeVirtDefaultMachineType
+}
+
+func kubeVirtUseVirtioTransitional(model string) bool {
+	return kubeVirtHardwareProfileFor(model, "").UseVirtioTransitional
+}
+
+func kubeVirtFirmware(model string) map[string]any {
+	return kubeVirtHardwareProfileFor(model, "").Firmware
+}
+
+func kubeVirtNodeSelector(model string) map[string]string {
+	profileSelector := kubeVirtHardwareProfileFor(model, "").RequiredNodeSelector
+	nodeSelector := make(map[string]string, len(profileSelector)+1)
+	for key, value := range profileSelector {
+		nodeSelector[key] = value
+	}
+	for key, value := range KNENodeSelector() {
+		nodeSelector[key] = value
+	}
+	return nodeSelector
+}
+
+func kubeVirtUsesBootstrapTFTP(model string) bool {
+	return kubeVirtHardwareProfileFor(model, "").BootstrapTFTP
+}
+
+func kubeVirtValidateSrosLicenseData(data string) error {
+	data = strings.TrimSpace(data)
+	if data == "" {
+		return fmt.Errorf("SROS license payload is empty")
+	}
+	if kubeVirtIsPlaceholderSrosLicenseData(data) {
+		return fmt.Errorf("SROS license payload is the placeholder license")
+	}
+	return nil
+}
+
+const kubeVirtSrosPlaceholderUUID = "00000000-0000-0000-0000-000000000000"
+
+func kubeVirtIsCanonicalUUID(value string) bool {
+	value = strings.ToLower(strings.TrimSpace(value))
+	if len(value) != 36 {
+		return false
+	}
+	for i, ch := range value {
+		switch i {
+		case 8, 13, 18, 23:
+			if ch != '-' {
+				return false
+			}
+		default:
+			if !(ch >= '0' && ch <= '9') && !(ch >= 'a' && ch <= 'f') {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func kubeVirtSrosLicenseUUID(data string) (string, error) {
+	fields := strings.Fields(strings.TrimSpace(data))
+	if len(fields) == 0 {
+		return "", fmt.Errorf("SROS license payload is empty")
+	}
+	uuid := strings.ToLower(strings.TrimSpace(fields[0]))
+	if !kubeVirtIsCanonicalUUID(uuid) {
+		return "", fmt.Errorf("SROS license payload first field is not a UUID")
+	}
+	return uuid, nil
+}
+
+func kubeVirtSrosLicenseMachineUUID(data string) (string, error) {
+	uuid, err := kubeVirtSrosLicenseUUID(data)
+	if err != nil {
+		return "", err
+	}
+	if uuid == kubeVirtSrosPlaceholderUUID {
+		return "", fmt.Errorf("SROS license payload first field must be a non-zero UUID for KubeVirt firmware pinning")
+	}
+	return uuid, nil
+}
+
+func kubeVirtSrosLicenseIdentityMode() string {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv("SKYFORGE_SROS_LICENSE_IDENTITY_MODE"))) {
+	case "", "uuid", "uuid-locked", "locked":
+		return "uuid-locked"
+	case "zero-uuid", "wildcard":
+		return "zero-uuid"
+	default:
+		return strings.ToLower(strings.TrimSpace(os.Getenv("SKYFORGE_SROS_LICENSE_IDENTITY_MODE")))
+	}
+}
+
+func kubeVirtSrosLicenseSourceMode() string {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv("SKYFORGE_SROS_LICENSE_SOURCE_MODE"))) {
+	case "", "auto":
+		return "auto"
+	case "tftp", "secret", "secret-tftp":
+		return "secret-tftp"
+	case "image", "image-local", "embedded", "cf3":
+		return "image-local"
+	default:
+		return strings.ToLower(strings.TrimSpace(os.Getenv("SKYFORGE_SROS_LICENSE_SOURCE_MODE")))
+	}
+}
+
+func kubeVirtSrosLicenseRawPayload() (string, bool) {
+	raw := strings.TrimSpace(os.Getenv("SKYFORGE_SROS_LICENSE_B64"))
+	if raw != "" {
+		return raw, true
+	}
+	path := strings.TrimSpace(os.Getenv("SKYFORGE_SROS_LICENSE_B64_FILE"))
+	if path == "" {
+		path = "/skyforge-secrets/sros-license.b64"
+	}
+	if data, err := os.ReadFile(path); err == nil {
+		raw = strings.TrimSpace(string(data))
+	}
+	return raw, raw != ""
+}
+
+func kubeVirtSrosResolvedLicenseSource() string {
+	mode := kubeVirtSrosLicenseSourceMode()
+	if mode != "auto" {
+		return mode
+	}
+	if _, ok := kubeVirtSrosLicenseRawPayload(); ok {
+		return "secret-tftp"
+	}
+	return "image-local"
+}
+
+func kubeVirtSrosImageLocalLicenseClockBase() time.Time {
+	raw := strings.TrimSpace(os.Getenv("SKYFORGE_SROS_IMAGE_LICENSE_CLOCK_BASE"))
+	if raw != "" {
+		if t, err := time.Parse(time.RFC3339, raw); err == nil {
+			return t.UTC()
+		}
+		if t, err := time.Parse("2006-01-02", raw); err == nil {
+			return t.UTC()
+		}
+	}
+	return time.Date(2024, time.March, 12, 0, 0, 0, 0, time.UTC)
+}
+
+func kubeVirtSrosImageLocalMachineUUID() string {
+	raw := strings.ToLower(strings.TrimSpace(os.Getenv("SKYFORGE_SROS_IMAGE_LICENSE_MACHINE_UUID")))
+	if raw == "" {
+		return kubeVirtSrosPlaceholderUUID
+	}
+	if kubeVirtIsCanonicalUUID(raw) {
+		return raw
+	}
+	return kubeVirtSrosPlaceholderUUID
+}
+
+func kubeVirtIsPlaceholderSrosLicenseData(data string) bool {
+	data = strings.TrimSpace(data)
+	if data == "" {
+		return true
+	}
+	if strings.Contains(strings.ToLower(data), "placeholder") {
+		return true
+	}
+	fields := strings.Fields(data)
+	if len(fields) == 1 && fields[0] == kubeVirtSrosPlaceholderUUID {
+		return true
+	}
+	if len(fields) > 0 && fields[0] == kubeVirtSrosPlaceholderUUID && !kubeVirtHasOpaqueSrosLicenseToken(fields[1:]) {
+		return true
+	}
+	return false
+}
+
+func kubeVirtHasOpaqueSrosLicenseToken(fields []string) bool {
+	for _, field := range fields {
+		if len(field) < 32 {
+			continue
+		}
+		decoded, err := base64.StdEncoding.DecodeString(field)
+		if err != nil {
+			continue
+		}
+		if strings.TrimSpace(string(decoded)) != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func kubeVirtBootstrapTFTPLicenseData(model string) (string, error) {
+	if !kubeVirtIsSros(model) {
+		return "", nil
+	}
+	if kubeVirtSrosResolvedLicenseSource() == "image-local" {
+		return "", nil
+	}
+	raw, _ := kubeVirtSrosLicenseRawPayload()
+	if raw == "" {
+		return "", fmt.Errorf("SROS license payload is not configured")
+	}
+	decoded, err := base64.StdEncoding.DecodeString(raw)
+	if err != nil {
+		return "", fmt.Errorf("invalid SROS license payload")
+	}
+	// Validate a normalized view, but return the decoded artifact unchanged.
+	// SR OS license files are opaque inputs; even a trailing newline can be
+	// part of the artifact contract between the secret and the TFTP server.
+	licenseData := string(decoded)
+	if err := kubeVirtValidateSrosLicenseData(licenseData); err != nil {
+		return "", err
+	}
+	return licenseData, nil
+}
+
+func kubeVirtSrosLicenseClockBase(data string) (time.Time, error) {
+	fields := strings.Fields(strings.TrimSpace(data))
+	if len(fields) < 2 {
+		return time.Time{}, fmt.Errorf("SROS license payload does not include an opaque token")
+	}
+	decoded, err := base64.StdEncoding.DecodeString(fields[1])
+	if err != nil {
+		return time.Time{}, fmt.Errorf("invalid SROS license token")
+	}
+	var windowStart, windowEnd time.Time
+	for offset := 0; offset+6 <= len(decoded); offset++ {
+		if decoded[offset] != 0 || decoded[offset+1] != 0 || decoded[offset+2] != 0 || decoded[offset+3] != 5 {
+			continue
+		}
+		length := int(decoded[offset+4])<<8 | int(decoded[offset+5])
+		if length <= 0 || offset+6+length > len(decoded) {
+			continue
+		}
+		payload := decoded[offset+6 : offset+6+length]
+		var dates []time.Time
+		seen := map[int64]struct{}{}
+		for i := 0; i+4 <= len(payload); i++ {
+			epoch := int64(payload[i]) | int64(payload[i+1])<<8 | int64(payload[i+2])<<16 | int64(payload[i+3])<<24
+			if _, ok := seen[epoch]; ok {
+				continue
+			}
+			seen[epoch] = struct{}{}
+			t := time.Unix(epoch, 0).UTC()
+			if t.Before(time.Date(2020, time.January, 1, 0, 0, 0, 0, time.UTC)) || t.After(time.Date(2035, time.January, 1, 0, 0, 0, 0, time.UTC)) {
+				continue
+			}
+			if t.Hour() == 0 && t.Minute() == 0 && t.Second() == 0 {
+				dates = append(dates, t)
+			}
+		}
+		sort.Slice(dates, func(i, j int) bool { return dates[i].Before(dates[j]) })
+		if len(dates) >= 2 {
+			windowStart = dates[0]
+			windowEnd = dates[len(dates)-1]
+			break
+		}
+	}
+	if windowStart.IsZero() || windowEnd.IsZero() || !windowEnd.After(windowStart) {
+		return time.Time{}, fmt.Errorf("SROS license validity window not found")
+	}
+	base := windowStart.Add(24 * time.Hour)
+	if !base.Before(windowEnd) {
+		base = windowStart.Add(windowEnd.Sub(windowStart) / 2)
+	}
+	return base.UTC(), nil
+}
+
+func kubeVirtBootstrapTFTPLicense(model string) (string, string, time.Time, error) {
+	licenseData, err := kubeVirtBootstrapTFTPLicenseData(model)
+	if err != nil || !kubeVirtIsSros(model) {
+		return licenseData, "", time.Time{}, err
+	}
+	if strings.TrimSpace(licenseData) == "" && kubeVirtSrosResolvedLicenseSource() == "image-local" {
+		return "", kubeVirtSrosImageLocalMachineUUID(), kubeVirtSrosImageLocalLicenseClockBase(), nil
+	}
+	clockBase, err := kubeVirtSrosLicenseClockBase(licenseData)
+	if err != nil {
+		return "", "", time.Time{}, err
+	}
+	machineUUID, err := kubeVirtSrosLicenseMachineUUID(licenseData)
+	if err != nil {
+		if kubeVirtSrosLicenseIdentityMode() == "zero-uuid" {
+			uuid, uuidErr := kubeVirtSrosLicenseUUID(licenseData)
+			if uuidErr == nil && uuid == kubeVirtSrosPlaceholderUUID {
+				return licenseData, kubeVirtSrosPlaceholderUUID, clockBase, nil
+			}
+		}
+		return "", "", time.Time{}, err
+	}
+	return licenseData, machineUUID, clockBase, nil
+}
+
+func kubeVirtPodInterfaceName(networkName string) string {
+	sum := sha256.Sum256([]byte(strings.TrimSpace(networkName)))
+	return "pod" + fmt.Sprintf("%x", sum[:])[:11]
+}
+
+func kubeVirtDataInterfaces(proto *tpb.Node) []string {
+	if proto == nil {
+		return nil
+	}
+	names := make([]string, 0, len(proto.Interfaces))
+	for name, intf := range proto.Interfaces {
+		if intf != nil && strings.TrimSpace(intf.IntName) != "" {
+			name = intf.IntName
+		}
+		name = strings.TrimSpace(name)
+		if name == "" {
+			continue
+		}
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func kubeVirtInterfaces(namespace string, proto *tpb.Node) []any {
+	managementMAC := kubeVirtDefaultMAC(namespace, proto.Name)
+	if kubeVirtIsF5(proto.Model) && proto.GetConfig() != nil {
+		managementMAC = strings.ToLower(strings.TrimSpace(proto.GetConfig().GetEnv()[kubeVirtF5ManagementMACEnv]))
+	}
+	defaultInterface := map[string]any{
+		"name":       "default",
+		"masquerade": map[string]any{},
+		"macAddress": managementMAC,
+		// Declare the management service ports EXPLICITLY on the masquerade interface.
+		// KubeVirt masquerade with an empty ports list is SUPPOSED to forward every port
+		// from the pod IP to the VM, but on this cluster's KubeVirt build that forward-all
+		// DNAT silently does not install, so the VM's mgmt services (sshd bound on mgmt0 at
+		// the masquerade-internal 10.0.2.2) are unreachable at the pod IP that netlab-initial
+		// SSH-probes and the collector collects against — the readiness gate times out even though
+		// SSH is up inside the guest. Enumerating the ports makes KubeVirt install a
+		// deterministic per-port DNAT (pod IP -> VM) for the NOS management plane:
+		//   22   SSH (netlab-initial readiness + config), 830 NETCONF, 443 RESTCONF/NX-API,
+		//   50051 gRPC/gNMI, 161 SNMP (the collector collection). masquerade is KEPT (pod-IP mgmt
+		//   isolation, no meshnet/data-plane interaction) — only the ports are made explicit.
+		// PLUS every inside port the node's own Services target (see
+		// kubeVirtMgmtMasqueradePorts): a Service port the DNAT does not carry is refused.
+		"ports": kubeVirtMgmtMasqueradePorts(proto),
+	}
+	if model := kubeVirtMgmtInterfaceModel(proto.Model); model != "" {
+		defaultInterface["model"] = model
+	}
+
+	interfaces := []any{defaultInterface}
+	for _, name := range kubeVirtDataInterfaces(proto) {
+		dataInterface := map[string]any{
+			"name":   name,
+			"bridge": map[string]any{},
+		}
+		if model := kubeVirtInterfaceModel(proto.Model); model != "" {
+			dataInterface["model"] = model
+		}
+		if mac := kubeVirtDataInterfaceMAC(proto, kubeVirtVendorInterfaceName(proto, name)); mac != "" {
+			dataInterface["macAddress"] = mac
+		}
+		interfaces = append(interfaces, dataInterface)
+	}
+	return interfaces
+}
+
+// kubeVirtVendorInterfaceName returns the vendor-specific interface name
+// (topo.Interface.Name, e.g. "ethernet1/1") for the KubeVirt/domain-XML
+// interface identifier kubeVirtDataInterfaces returned (e.g. "eth1"), or
+// that same identifier unchanged if no vendor name is declared. Needed
+// because proto.Interfaces is keyed -- and kubeVirtDataInterfaces resolves
+// its returned identifiers -- by the Linux-safe int_name/map key, never by
+// the vendor name a kne.env MAC pin is spelled against.
+func kubeVirtVendorInterfaceName(proto *tpb.Node, kubeVirtName string) string {
+	if intf := proto.GetInterfaces()[kubeVirtName]; intf != nil {
+		if vendorName := strings.TrimSpace(intf.GetName()); vendorName != "" {
+			return vendorName
+		}
+	}
+	return kubeVirtName
+}
+
+// kubeVirtDataInterfaceMAC returns the MAC pinned for a data interface via
+// kne.env, or "" for the default (unpinned, qemu-assigned) behaviour. The
+// env key is kubeVirtDataInterfaceMACEnvPrefix plus ifname -- the VENDOR
+// interface name (topo.Interface.Name, e.g. "ethernet1/1"; see
+// kubeVirtVendorInterfaceName), never the Linux-safe KubeVirt interface
+// identifier ("eth1") kubeVirtDataInterfaces resolves -- with every
+// non-alphanumeric byte turned into "_" and upper-cased, e.g.
+// "ethernet1/1" -> "SKYFORGE_DATA_MAC_ETHERNET1_1".
+func kubeVirtDataInterfaceMAC(proto *tpb.Node, ifname string) string {
+	if proto.GetConfig() == nil {
+		return ""
+	}
+	mac := strings.ToLower(strings.TrimSpace(proto.GetConfig().GetEnv()[kubeVirtDataInterfaceMACEnvName(ifname)]))
+	if mac == "" {
+		return ""
+	}
+	if _, err := net.ParseMAC(mac); err != nil {
+		return ""
+	}
+	return mac
+}
+
+func kubeVirtDataInterfaceMACEnvName(ifname string) string {
+	var b strings.Builder
+	for _, r := range strings.ToUpper(strings.TrimSpace(ifname)) {
+		if (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') {
+			b.WriteRune(r)
+		} else {
+			b.WriteByte('_')
+		}
+	}
+	return kubeVirtDataInterfaceMACEnvPrefix + b.String()
+}
+
+// kubeVirtMgmtMasqueradePorts is the NOS management-plane port set forwarded from the
+// pod IP to the VM over the masquerade interface. It is declared explicitly because the
+// KubeVirt "empty ports = forward all" behaviour does not install its DNAT on this
+// cluster's build (see kubeVirtInterfaces). Ports are the union across the VM NOS
+// families skyforge runs; a NOS that does not listen on one simply has no backend, which
+// is harmless (the DNAT just has nothing to answer it).
+//
+// THE NODE'S OWN SERVICES ARE ADDED TO THAT UNION. The kne Service for a node targets
+// the pod IP on each service's INSIDE port, and the masquerade DNAT is the only thing
+// that carries a pod-IP port on to the VM. A service port missing from this list is a
+// port the Service advertises and the pod REFUSES -- while the guest listens on it at
+// 10.0.2.2 the whole time. Measured 2026-09-30 on an SR OS pair (vr-sros 22.10,
+// _smoke/nos/sros/fabric): gRPC `oper-state up` inside the guest, 10.0.2.2:57400 open
+// from the virt-launcher, pod-IP:57400 refused (pod-IP:22 open), so netlab's gNMI
+// readiness probe retried until the lab timed out. The fixed union had 50051 (Cisco's
+// gNMI port) and not 57400 (Nokia's). Deriving from the Services makes the Service and
+// the DNAT agree by construction for every VM NOS, instead of by a hand-kept list.
+func kubeVirtMgmtMasqueradePorts(proto *tpb.Node) []any {
+	ports := []any{
+		map[string]any{"port": int64(22), "protocol": "TCP"},    // SSH (netlab-initial readiness + config apply)
+		map[string]any{"port": int64(443), "protocol": "TCP"},   // RESTCONF / NX-API / HTTPS mgmt
+		map[string]any{"port": int64(830), "protocol": "TCP"},   // NETCONF
+		map[string]any{"port": int64(50051), "protocol": "TCP"}, // gRPC / gNMI
+		map[string]any{"port": int64(161), "protocol": "UDP"},   // SNMP (the collector collection)
+	}
+	type portKey struct {
+		port     int64
+		protocol string
+	}
+	seen := map[portKey]bool{}
+	for _, p := range ports {
+		m := p.(map[string]any)
+		seen[portKey{m["port"].(int64), m["protocol"].(string)}] = true
+	}
+	var extra []portKey
+	for _, svc := range proto.GetServices() {
+		if svc == nil || svc.GetInside() == 0 || svc.GetInside() > 65535 {
+			continue
+		}
+		k := portKey{int64(svc.GetInside()), string(serviceProtocol(svc))}
+		if seen[k] {
+			continue
+		}
+		seen[k] = true
+		extra = append(extra, k)
+	}
+	// Services is a map: sort so the rendered VMI (and so its checksum) is stable.
+	sort.Slice(extra, func(i, j int) bool {
+		if extra[i].port != extra[j].port {
+			return extra[i].port < extra[j].port
+		}
+		return extra[i].protocol < extra[j].protocol
+	})
+	for _, k := range extra {
+		ports = append(ports, map[string]any{"port": k.port, "protocol": k.protocol})
+	}
+	return ports
+}
+
+// kubeVirtMgmtLivenessProbe renders the VMI livenessProbe for models that
+// declare MgmtLivenessTCPPort. Tuning is deliberately conservative: the probe
+// must never restart a VM that is merely booting or briefly cycling its sshd
+// during a commit. initialDelay 1800s clears the slowest observed vJunos boot
+// (~16 min to full readiness) with margin; failureThreshold 15 x period 60s
+// means only a management plane dead for a straight 15 minutes triggers the
+// restart -- the observed in-guest death lasted hours.
+func kubeVirtMgmtLivenessProbe(model string) map[string]any {
+	profile, ok := kubeVirtHardwareProfiles[model]
+	if !ok || profile.MgmtLivenessTCPPort <= 0 {
+		return nil
+	}
+	return map[string]any{
+		"tcpSocket":           map[string]any{"port": int64(profile.MgmtLivenessTCPPort)},
+		"initialDelaySeconds": int64(1800),
+		"periodSeconds":       int64(60),
+		"timeoutSeconds":      int64(10),
+		"failureThreshold":    int64(15),
+	}
+}
+
+func kubeVirtNetworks(proto *tpb.Node) []any {
+	networks := []any{
+		map[string]any{
+			"name": "default",
+			"pod":  map[string]any{},
+		},
+	}
+	for _, name := range kubeVirtDataInterfaces(proto) {
+		networks = append(networks, map[string]any{
+			"name": name,
+			"multus": map[string]any{
+				"networkName": "meshnet",
+			},
+		})
+	}
+	return networks
+}
