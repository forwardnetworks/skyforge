+			}
+			if diff := cmp.Diff(tt.readinessProbes, profile.ReadinessProbes); diff != "" {
+				t.Fatalf("ReadinessProbes mismatch (-want +got):\n%s", diff)
+			}
+			if len(profile.ContainerDisks) == 0 || profile.ContainerDisks[0].Bus != tt.firstDiskBus {
+				t.Fatalf("first disk bus got %#v, want %q", profile.ContainerDisks, tt.firstDiskBus)
+			}
+		})
