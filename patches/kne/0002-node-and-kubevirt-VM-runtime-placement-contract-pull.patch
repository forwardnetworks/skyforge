+func TestKubeVirtSrosHookAnnotations(t *testing.T) {
+	t.Setenv("SKYFORGE_SROS_LICENSE_SOURCE_MODE", "secret-tftp")
+	annotations := kubeVirtSrosHookAnnotations("sros1")
+	raw := annotations["hooks.kubevirt.io/hookSidecars"]
+	if raw == "" {
+		t.Fatalf("missing hook sidecar annotation: %#v", annotations)
+	}
+	var hooks []map[string]any
+	if err := json.Unmarshal([]byte(raw), &hooks); err != nil {
+		t.Fatalf("hook annotation is not valid JSON: %v", err)
+	}
+	if len(hooks) != 1 {
+		t.Fatalf("hook annotation got %d entries, want 1", len(hooks))
+	}
+	configMap, ok := hooks[0]["configMap"].(map[string]any)
+	if !ok {
+		t.Fatalf("hook configMap missing: %#v", hooks[0])
+	}
+	if got, want := configMap["key"], kubeVirtSrosSMBIOSHookKey; got != want {
+		t.Fatalf("hook key got %v, want %q", got, want)
+	}
+	if got, want := configMap["hookPath"], "/usr/bin/onDefineDomain"; got != want {
+		t.Fatalf("hookPath got %v, want %q", got, want)
+	}
+	hookScript := kubeVirtSrosSMBIOSHookScript("sros1", "10.43.1.2", true, srosDefaultTimosLine)
+	if strings.Contains(hookScript, "\t") {
+		t.Fatal("hook script must not contain tabs")
+	}
+	if !strings.Contains(hookScript, kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine)) {
+		t.Fatal("hook script does not include SR-OS SMBIOS product")
+	}
+	if strings.Contains(hookScript, `MACHINE_UUID`) {
+		t.Fatal("hook script must not inject SR-OS machine UUID through SMBIOS")
+	}
+	if strings.Contains(hookScript, `upsert_system_entry(system, "uuid"`) ||
+		strings.Contains(hookScript, `upsert_system_entry(system, "family"`) ||
+		strings.Contains(hookScript, `upsert_system_entry(system, "manufacturer"`) {
+		t.Fatal("hook script must keep stock vr-sros SMBIOS shape: product only")
+	}
+	if !strings.Contains(hookScript, `remove_system_entries(system, ("manufacturer", "serial", "family"))`) {
+		t.Fatal("hook script must remove KubeVirt default SMBIOS identity entries")
+	}
+	if strings.Contains(hookScript, "use_sros_virtio_nic_model") {
+		t.Fatal("hook script must not rewrite the SR-OS NIC model after the KubeVirt hardware profile has set it")
+	}
+	if strings.Contains(hookScript, `model.set("type", "virtio")`) {
+		t.Fatal("hook script must not force the SR-OS NIC model back to virtio")
+	}
+	if !strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "primary-config=tftp://10.43.1.2/config.txt") {
+		t.Fatal("SR-OS SMBIOS product does not point primary-config at the bootstrap TFTP service IP")
+	}
+	if !strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "license-file=tftp://10.43.1.2/license.txt") {
+		t.Fatal("SR-OS SMBIOS product does not point license-file at the bootstrap TFTP service IP")
+	}
+	if !strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "address=200::1/127@active") {
+		t.Fatal("SR-OS SMBIOS product does not include the upstream vr-sros IPv6 management address")
+	}
+	if strings.Index(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "license-file=") > strings.Index(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "primary-config=") {
+		t.Fatal("SR-OS SMBIOS product must keep upstream vr-sros order: license-file before primary-config")
+	}
+	if !strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "system-base-mac="+kubeVirtSrosSystemBaseMAC("sros1")) {
+		t.Fatal("SR-OS SMBIOS product does not use the node-stable upstream-style system base MAC")
+	}
+	if strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "system-base-mac=0C:00:00:00:00:00") {
+		t.Fatal("SR-OS SMBIOS product must not use the all-zero system base MAC")
+	}
+	if !strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), srosDefaultTimosLine) {
+		t.Fatal("SR-OS SMBIOS product does not use the default upstream vr-sros variant contract")
+	}
+	if strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "chassis=VSR-I") ||
+		strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "card=iom-v") ||
+		strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "card=cpm-v") {
+		t.Fatal("SR-OS SMBIOS product must not use legacy vsr-i variants")
+	}
+	if !strings.Contains(kubeVirtSrosSMBIOSProduct("sros1", "10.43.1.2", true, srosDefaultTimosLine), "static-route=0.0.0.0/0@10.0.2.1") {
+		t.Fatal("SR-OS SMBIOS product does not route BOF TFTP traffic through KubeVirt masquerade gateway")
+	}
+}
