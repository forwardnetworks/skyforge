+// kubeVirtSMBIOSHookScriptForModel builds the onDefineDomain script a model needs.
+// ok=false means the model carries no SMBIOS hook; a non-nil error means the model
+// WANTS one but its inputs are unusable (an unknown SR-OS variant), which must fail
+// the deploy rather than silently ship a VM with no hook.
+func (n *Impl) kubeVirtSMBIOSHookScriptForModel(labels map[string]string, tftpHost string, hasBootstrapConfig bool) (string, bool, error) {
+	model := n.Proto.Model
+	switch {
+	case kubeVirtIsSros(model):
+		variant := strings.TrimSpace(labels[kubeVirtSrosVariantLabelKey])
+		timosLine, err := kubeVirtSrosTimosLineForVariant(variant)
+		if err != nil {
+			return "", false, err
+		}
+		return kubeVirtSrosSMBIOSHookScript(n.Name(), tftpHost, hasBootstrapConfig, timosLine), true, nil
+	case kubeVirtVJunosNeedsVMXSMBIOS(model):
+		return kubeVirtVJunosSMBIOSHookScript(model), true, nil
+	}
+	return "", false, nil
+}
+
+func (n *Impl) ensureKubeVirtSMBIOSHook(ctx context.Context, labels map[string]string, tftpHost string, hasBootstrapConfig bool, machineUUID string) error {
+	if n == nil || n.Proto == nil {
+		return nil
+	}
+	name, ok := kubeVirtSMBIOSHookConfigMapNameForModel(n.Name(), n.Proto.Model)
+	if !ok {
+		return nil
+	}
+	script, ok, err := n.kubeVirtSMBIOSHookScriptForModel(labels, tftpHost, hasBootstrapConfig)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return nil
+	}
+	cm := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      name,
+			Namespace: n.Namespace,
+			Labels:    labels,
+		},
+		Data: map[string]string{
+			kubeVirtSMBIOSHookKey: script,
+		},
+	}
+	client := n.KubeClient.CoreV1().ConfigMaps(n.Namespace)
+	if _, err := client.Create(ctx, cm, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		current, err := client.Get(ctx, name, metav1.GetOptions{})
+		if err != nil {
+			return err
+		}
+		current.Labels = labels
+		current.Data = cm.Data
+		if _, err := client.Update(ctx, current, metav1.UpdateOptions{}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (n *Impl) kubeVirtLabels() map[string]string {
+	labelsMap := map[string]string{
+		"app":               n.Name(),
+		"topo":              n.Namespace,
+		"kne/topologyOwner": n.Namespace,
+		"kne/topologyNode":  n.Name(),
+	}
+	if n.Proto == nil {
+		return labelsMap
+	}
+	// Lets KNESameModelPodAntiAffinity's PodAffinityTerm.LabelSelector find
+	// every other VM of the same NOS model -- see kneVMModelLabel's own doc
+	// comment for why the label key and the selector key must never drift.
+	if model := strings.TrimSpace(n.Proto.GetModel()); model != "" && len(validation.IsValidLabelValue(model)) == 0 {
+		labelsMap[kneVMModelLabel] = model
+	}
+	for key, value := range n.Proto.GetLabels() {
+		if strings.TrimSpace(key) == "" || strings.TrimSpace(value) == "" {
+			continue
+		}
+		if len(validation.IsQualifiedName(key)) > 0 || len(validation.IsValidLabelValue(value)) > 0 {
+			continue
+		}
+		labelsMap[key] = value
+	}
+	return labelsMap
+}
