+func kubeVirtPanosBootstrapUserData(initCfg []byte) ([]byte, error) {
+	initCfg = bytes.TrimSpace(initCfg)
+	if len(initCfg) == 0 {
+		return nil, fmt.Errorf("panos bootstrap init-cfg.txt is empty")
+	}
+	initCfg = append(append([]byte{}, initCfg...), '\n')
+
+	var buf bytes.Buffer
+	gz := gzip.NewWriter(&buf)
+	tw := tar.NewWriter(gz)
+	for _, dir := range []string{"config/", "license/", "software/", "content/"} {
+		if err := tw.WriteHeader(&tar.Header{
+			Name:     dir,
+			Mode:     0o755,
+			Typeflag: tar.TypeDir,
+		}); err != nil {
+			return nil, err
+		}
+	}
+	if err := tw.WriteHeader(&tar.Header{
+		Name: "config/init-cfg.txt",
+		Mode: 0o644,
+		Size: int64(len(initCfg)),
+	}); err != nil {
+		return nil, err
+	}
+	if _, err := tw.Write(initCfg); err != nil {
+		return nil, err
+	}
+	if err := tw.Close(); err != nil {
+		return nil, err
+	}
+	if err := gz.Close(); err != nil {
+		return nil, err
+	}
+	return buf.Bytes(), nil
+}
+
+func kubeVirtPanosBootstrapDiskAndVolume(secretName string, initCfg []byte) (map[string]any, map[string]any, []byte, error) {
+	userData, err := kubeVirtPanosBootstrapUserData(initCfg)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	return map[string]any{
+			"name": kubeVirtPanosBootstrapDiskName,
+			"disk": map[string]any{
+				"bus": "virtio",
+			},
+		},
+		kubeVirtConfigDriveSecretVolume(kubeVirtPanosBootstrapDiskName, secretName),
+		userData,
+		nil
+}
+
+func isRetryableKubeVirtAdmissionError(err error) bool {
+	if err == nil {
+		return false
+	}
+	msg := strings.ToLower(err.Error())
+	retryableSignatures := []string{
+		`virtualmachines-mutator.kubevirt.io": context deadline exceeded`,
+		"failed to reserve sandbox name",
+		"is reserved for",
+		"rst_stream",
+		"deadlineexceeded",
+	}
+	for _, sig := range retryableSignatures {
+		if strings.Contains(msg, sig) {
+			return true
+		}
+	}
+	return false
+}
+
+func kubeVirtAdmissionRetryBackoff(attempt int) time.Duration {
+	if attempt < 1 {
+		attempt = 1
+	}
+	// Bounded linear backoff to avoid retry amplification under cluster load.
+	wait := time.Duration(attempt*3) * time.Second
+	if wait > 15*time.Second {
+		return 15 * time.Second
+	}
+	return wait
+}
