+func TestKubeVirtBootstrapTFTPAffinity(t *testing.T) {
+	affinity := kubeVirtBootstrapTFTPAffinity()
+	if affinity == nil || affinity.NodeAffinity == nil || affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution == nil {
+		t.Fatalf("TFTP bootstrap pod missing required node affinity: %#v", affinity)
+	}
+	terms := affinity.NodeAffinity.RequiredDuringSchedulingIgnoredDuringExecution.NodeSelectorTerms
+	if len(terms) != 1 {
+		t.Fatalf("TFTP bootstrap pod affinity should have one node selector term, got %#v", terms)
+	}
+	requirements := terms[0].MatchExpressions
+	required := map[string]string{}
+	for _, requirement := range requirements {
+		if requirement.Operator != corev1.NodeSelectorOpIn || len(requirement.Values) != 1 {
+			t.Fatalf("unexpected TFTP bootstrap pod node selector requirement: %#v", requirement)
+		}
+		required[requirement.Key] = requirement.Values[0]
+	}
+	if required["kubevirt.io/schedulable"] != "true" {
+		t.Fatalf("TFTP bootstrap pod should require KubeVirt schedulable nodes, got %#v", required)
+	}
+	if required["skyforge.example.com/labs"] != "true" {
+		t.Fatalf("TFTP bootstrap pod should require the platform lab nodes, got %#v", required)
+	}
+}
