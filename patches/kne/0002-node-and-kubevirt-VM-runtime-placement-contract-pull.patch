+func TestToResourceRequirementsCPUMemoryStayRequestsOnly(t *testing.T) {
+	got := ToResourceRequirements(map[string]string{"cpu": "1", "memory": "2Gi"})
+	if got.Requests.Cpu().String() != "1" || got.Requests.Memory().String() != "2Gi" {
+		t.Fatalf("ToResourceRequirements() requests = %#v, want cpu=1 memory=2Gi", got.Requests)
+	}
+	if got.Limits != nil {
+		t.Fatalf("ToResourceRequirements() limits = %#v, want nil without hugepages", got.Limits)
+	}
+}
+
+func TestToResourceRequirementsHugepagesBecomeRequestsAndLimits(t *testing.T) {
+	// Kubernetes mandates limits==requests for hugepages (not overcommittable);
+	// a requests-only declaration is rejected by apiserver validation. Both
+	// sides must carry the exact case-sensitive resource name.
+	got := ToResourceRequirements(map[string]string{
+		"cpu":           "1",
+		"memory":        "2Gi",
+		"hugepages-2Mi": "512Mi",
+	})
+	name := corev1.ResourceName("hugepages-2Mi")
+	req, ok := got.Requests[name]
+	if !ok || req.String() != "512Mi" {
+		t.Fatalf("ToResourceRequirements() requests[hugepages-2Mi] = %v (present=%v), want 512Mi", req.String(), ok)
+	}
+	lim, ok := got.Limits[name]
+	if !ok || lim.String() != "512Mi" {
+		t.Fatalf("ToResourceRequirements() limits[hugepages-2Mi] = %v (present=%v), want 512Mi", lim.String(), ok)
+	}
+	if req.Cmp(lim) != 0 {
+		t.Fatalf("hugepage request %v != limit %v; k8s rejects unequal hugepage request/limit", req.String(), lim.String())
+	}
+	// cpu/memory must stay requests-only even when hugepages ride along, and
+	// hugepages must not leak into cpu/memory limits.
+	if _, ok := got.Limits["cpu"]; ok {
+		t.Fatalf("ToResourceRequirements() unexpectedly set a cpu limit: %#v", got.Limits)
+	}
+	if _, ok := got.Limits["memory"]; ok {
+		t.Fatalf("ToResourceRequirements() unexpectedly set a memory limit: %#v", got.Limits)
+	}
+}
+
+func TestToResourceRequirementsIgnoresEmptyHugepageValue(t *testing.T) {
+	got := ToResourceRequirements(map[string]string{"cpu": "1", "hugepages-2Mi": ""})
+	if _, ok := got.Requests[corev1.ResourceName("hugepages-2Mi")]; ok {
+		t.Fatalf("ToResourceRequirements() must ignore an empty hugepage value: %#v", got.Requests)
+	}
+	if got.Limits != nil {
+		t.Fatalf("ToResourceRequirements() limits = %#v, want nil for empty hugepage value", got.Limits)
+	}
+}
