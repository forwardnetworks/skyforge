+func imageLooksLikeKubeVirtDisk(image string) bool {
+	image = strings.ToLower(strings.TrimSpace(image))
+	return strings.Contains(image, "/kubevirt/") ||
+		strings.Contains(image, "/kne/cisco_asav") ||
+		strings.Contains(image, "/skyforge/f5-bigip")
+}
+
+func (n *Impl) UsesKubeVirtVM() bool {
+	if n == nil || n.Proto == nil || n.Proto.Config == nil {
+		return false
+	}
+	if !imageLooksLikeKubeVirtDisk(n.Proto.Config.Image) {
+		return false
+	}
+	return kubeVirtModelSupportedByVendor(n.Proto.Vendor, n.Proto.Model)
+}
+
+func (n *Impl) serviceSelector() map[string]string {
+	if n.UsesKubeVirtVM() {
+		return map[string]string{
+			"vm.kubevirt.io/name": n.Name(),
+		}
+	}
+	return map[string]string{
+		"app": n.Name(),
+	}
+}
+
+func kubeVirtCPUCores(model string, constraints map[string]string) int64 {
+	minimum := kubeVirtHardwareProfileFor(model, "").MinimumCPU
+	if minimum < 1 {
+		minimum = 1
+	}
+	raw := strings.TrimSpace(strings.ToLower(constraints["cpu"]))
+	if raw == "" {
+		return minimum
+	}
+	milli := strings.HasSuffix(raw, "m")
+	if milli {
+		raw = strings.TrimSuffix(raw, "m")
+	}
+	if raw == "" {
+		return 1
+	}
+	var value int64
+	for _, ch := range raw {
+		if ch < '0' || ch > '9' {
+			return minimum
+		}
+		value = value*10 + int64(ch-'0')
+	}
+	if milli {
+		value = value / 1000
+	}
+	if value < minimum {
+		return minimum
+	}
+	return value
+}
