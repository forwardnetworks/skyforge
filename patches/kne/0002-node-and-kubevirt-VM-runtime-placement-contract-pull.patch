+// A10 vThunder does not consume KubeVirt startup config; its day-0 goes over
+// network_cli. A startup-config must therefore attach NO bootstrap disk and NO
+// bootstrap secret, rather than the generic NX-OS-style ISO the default
+// passthrough would build.
+func TestKubeVirtVMObjectA10AttachesNoBootstrapDisk(t *testing.T) {
+	n := &Impl{
+		Namespace: "test",
+		Proto: &topopb.Node{
+			Name:   "a101",
+			Vendor: topopb.Vendor_A10,
+			Model:  "a10",
+			Config: &topopb.Config{
+				Image: "registry.example.com/skyforge/kubevirt/a10_vthunder:5.2.0-kne-r1",
+				ConfigData: &topopb.Config_Data{
+					Data: []byte("hostname a10\n"),
+				},
+			},
+		},
+	}
+	vm, err := n.kubeVirtVMObject()
+	if err != nil {
+		t.Fatalf("kubeVirtVMObject() failed: %v", err)
+	}
+	disks, _, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "domain", "devices", "disks")
+	if err != nil {
+		t.Fatalf("failed to read A10 VM disks: %v", err)
+	}
+	volumes, _, err := unstructured.NestedSlice(vm.Object, "spec", "template", "spec", "volumes")
+	if err != nil {
+		t.Fatalf("failed to read A10 VM volumes: %v", err)
+	}
+	if containsNamedUnstructuredItem(disks, kubeVirtNxosBootstrapDiskName) || containsNamedUnstructuredItem(volumes, kubeVirtNxosBootstrapDiskName) {
+		t.Fatalf("A10 VM got a bootstrap disk %q; day-0 is applied over network_cli, not a disk: disks=%#v volumes=%#v", kubeVirtNxosBootstrapDiskName, disks, volumes)
+	}
+	secretName, secretData, err := n.kubeVirtBootstrapSecretData(context.Background())
+	if err != nil {
+		t.Fatalf("kubeVirtBootstrapSecretData() failed: %v", err)
+	}
+	if secretName != "" || len(secretData) != 0 {
+		t.Fatalf("A10 bootstrap secret = %q (%d bytes), want none", secretName, len(secretData))
+	}
+}
