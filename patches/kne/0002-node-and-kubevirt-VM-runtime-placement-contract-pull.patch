+		// (perf-profile request, ~250m) rounds to 0 cores here, so without a
+		// floor kubeVirtCPUCores() returns 1. Mirrors the a10/vThunder fix.
+		// Bumped 4->6: at 4 vCPU n9kv mgmt SSH still didn't converge in time.
+		MinimumCPU:    6,
+		MinimumMemory: "8Gi",
+		ConfigApplyRequires: []string{
+			"VMReady",
+			"ApplianceBootstrapAccepted",
+			"ManagementReady",
+		},
+		Firmware: map[string]any{
+			"bootloader": map[string]any{
