+	// The containerDisk is a plain qcow2 at /disk/disk.qcow2 built by
+	// scripts/build-kubevirt-containerdisk-from-vrnetlab.sh, which lifts the
+	// vendor qcow2 out of the vrnetlab image and drops every vrnetlab layer.
+	"vjunos-router": {
+		CPUModel:              "host-passthrough",
+		InterfaceModel:        "virtio",
+		MachineType:           "q35",
+		UseVirtioTransitional: true,
+		BootstrapTransport:    "config-drive",
+		IdentityInputs:        []string{"model"},
+		ReadinessProbes:       []string{"ssh", "ansible"},
+		MgmtLivenessTCPPort:   22,
+		ConfigApplyRequires: []string{
+			"VMReady",
+			"ApplianceBootstrapAccepted",
+			"ManagementReady",
+		},
+		// vJunos-router boots a nested VCP+VFP; Juniper's own floor for
+		// vJunos-router is 4 vCPU / 5Gi. Held at the vendor floor rather than
+		// guessed higher -- raise it only against a real convergence failure,
+		// the way the nxos/a10/versa floors were each raised.
+		MinimumCPU:    4,
+		MinimumMemory: "5Gi",
+		ContainerDisks: []kubeVirtContainerDiskSpec{{
+			Name: "containerdisk",
+			Bus:  "virtio",
+			Path: "/disk/disk.qcow2",
+		}},
+	},
+	// vSRX 3.0.
+	//
+	// Day-0 is the Junos CD-ROM path shared with vJunos: an iso9660 secret-disk
+	// carrying a single "juniper.conf" at the root. NOT PROVEN on a live vSRX
+	// yet -- verify the device reads it back before trusting any certification,
+	// because a config that looks correct at every layer can still leave the
+	// device on factory config.
+	//
+	// Sizing held at Juniper's published vSRX 3.0 floor (2 vCPU / 4Gi) rather
+	// than guessed higher; raise only against a real convergence failure.
+	"vsrx": {
+		CPUModel:              "host-passthrough",
+		InterfaceModel:        "virtio",
+		MachineType:           "q35",
+		UseVirtioTransitional: true,
+		BootstrapTransport:    "config-drive",
+		IdentityInputs:        []string{"model"},
+		ReadinessProbes:       []string{"ssh", "ansible"},
+		MgmtLivenessTCPPort:   22,
+		ConfigApplyRequires: []string{
+			"VMReady",
+			"ApplianceBootstrapAccepted",
+			"ManagementReady",
+		},
+		MinimumCPU:    2,
+		MinimumMemory: "4Gi",
+		ContainerDisks: []kubeVirtContainerDiskSpec{{
+			Name: "containerdisk",
+			Bus:  "virtio",
+			Path: "/disk/disk.qcow2",
+		}},
+	},
+	"vjunos-switch": {
+		CPUModel:              "host-passthrough",
+		InterfaceModel:        "virtio",
+		MachineType:           "q35",
+		UseVirtioTransitional: true,
+		BootstrapTransport:    "config-drive",
+		IdentityInputs:        []string{"model"},
+		ReadinessProbes:       []string{"ssh", "ansible"},
+		ConfigApplyRequires: []string{
+			"VMReady",
+			"ApplianceBootstrapAccepted",
+			"ManagementReady",
+		},
+		MinimumCPU:    4,
+		MinimumMemory: "5Gi",
+		ContainerDisks: []kubeVirtContainerDiskSpec{{
+			Name: "containerdisk",
+			Bus:  "virtio",
+			Path: "/disk/disk.qcow2",
+		}},
+	},
+	"nxos": {
+		InterfaceModel:     "e1000",
+		BootstrapTransport: "config-drive",
+		IdentityInputs:     []string{"model", "efi"},
+		ReadinessProbes:    []string{"ssh", "ansible"},
+		// n9kv (Nexus 9000v) needs >=4 vCPU / 8Gi: on 1 vCPU the NX-OS control
+		// plane saturates during boot and SSH never comes up inside the 900s
