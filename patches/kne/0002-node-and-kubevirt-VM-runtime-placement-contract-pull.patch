+type kubeVirtContainerDiskSpec struct {
+	Name string
+	Bus  string
+	Path string
+}
+
+// kubeVirtEmptyDiskSpec is a blank, VM-lifetime scratch volume KubeVirt creates
+// at boot. It exists so an appliance that REQUIRES a second disk does not have
+// to ship one inside its containerDisk image.
+//
+// vManage is the case that forced it: its image carried a 100GiB empty
+// virtiob.qcow2 alongside the real disk, and KubeVirt refuses a containerDisk
+// whose /disk holds more than one file ("only one disk is allowed"). Declaring
+// the blank volume here is both smaller and honest -- the capacity is a fact
+// about the appliance, not a payload to move through a registry.
+//
+// emptyDisk is EPHEMERAL: it does not survive a VM restart. That matches lab
+// semantics. An appliance needing durable state would want a PVC instead.
+type kubeVirtEmptyDiskSpec struct {
+	Name     string
+	Bus      string
+	Capacity string
+}
+
+const (
+	kubeVirtFortiosBootstrapDiskName = "fortios-bootstrap"
+	kubeVirtPanosBootstrapDiskName   = "panos-bootstrap"
+	kubeVirtF5BootstrapDiskName      = "f5-config-drive"
+	kubeVirtNxosBootstrapDiskName    = "nxos-bootstrap"
+	kubeVirtSrosBootstrapDiskName    = "sros-bootstrap"
+	kubeVirtASAvBootstrapDiskName    = "asav-bootstrap"
+	kubeVirtViptelaBootstrapDiskName = "viptela-bootstrap"
+	kubeVirtVJunosBootstrapDiskName  = "vjunos-bootstrap"
+	// Every NOS SMBIOS hook ships its onDefineDomain script under the SAME
+	// ConfigMap key: the key is a property of the KubeVirt sidecar contract,
+	// not of the NOS. kubeVirtSrosSMBIOSHookKey stays as the SR-OS-facing
+	// spelling so the SR-OS contract tests keep naming what they assert.
+	kubeVirtSMBIOSHookKey          = "onDefineDomain.py"
+	kubeVirtSrosSMBIOSHookKey      = kubeVirtSMBIOSHookKey
+	kubeVirtBootstrapSecretDataKey = "userdata"
+	// CVAC (Cisco Virtual Appliance Configuration): n9kv/nxos scans attached CD-ROMs
+	// at first boot for a plaintext file named EXACTLY "nxos_config.txt", applies it as
+	// the startup-config, and suppresses POAP. So the nxos bootstrap secret uses this as
+	// its data KEY (KubeVirt renders a secret-disk as an iso9660 with each key->file),
+	// and the disk is a plain secret-disk (NOT cloudInitConfigDrive, which would write
+	// openstack/latest/user_data — a path n9kv's CVAC never reads).
+	kubeVirtNxosCvacFileName       = "nxos_config.txt"
+	kubeVirtIOSXEBootstrapDiskName = "iosxe-bootstrap"
+	kubeVirtIOSXECvacFileName      = "iosxe_config.txt"
+	// kubeVirtIOSXESDWANBootstrapFileName is the ONLY name under which a
+	// Catalyst 8000V reads a controller-mode (SD-WAN) bootstrap. Cisco's
+	// onboarding guide: a virtual platform boots into controller mode when
+	// ciscosdwan_cloud_init.cfg is present on bootflash, USB, CDROM0 or CDROM1
+	// at first boot; iosxe_config.txt is CVAC's AUTONOMOUS day-0 and cannot
+	// change the mode. Same SATA cdrom, same Secret -- only the key differs.
+	kubeVirtIOSXESDWANBootstrapFileName = "ciscosdwan_cloud_init.cfg"
+	kubeVirtASAvDay0FileName       = "day0-config"
+	// vJunos (router/switch) day-0: the guest's own /home/pfe/riot/rc.juniper
+	// mounts /dev/sr0 on first boot and copies a file named EXACTLY
+	// "juniper.conf" from the ISO ROOT into the Junos config dir:
+	//     if [ "${Azure}" == "no" ] && [ -e /dev/sr0 ]; then
+	//         mount /dev/sr0 /mnt/cdiso
+	//         if [ -f /mnt/cdiso/juniper.conf ]; then
+	//             cp /mnt/cdiso/juniper.conf ${METAROOT}/juniper.conf
+	// so a plain secret-disk (iso9660, key->file at root) presented as a CD-ROM
+	// is the NATIVE day-0 path -- same mechanism as nxos CVAC, different filename.
+	//
+	// This is deliberately NOT the vmm-data/vmm-config.tgz path that vrnetlab's
+	// launch.py drives. That path needs a VFAT disk LABELLED "vmm-data" holding a
+	// tarball, which KubeVirt cannot synthesize from a Secret (it only ever emits
+	// iso9660). The cdrom path above is read by the same rc.juniper a few lines
+	// earlier, needs no label, no tarball, and no nested-qemu wrapper.
+	kubeVirtVJunosDay0FileName      = "juniper.conf"
+	kubeVirtBootstrapTFTPConfigKey  = "config.txt"
+	kubeVirtBootstrapTFTPLicenseKey = "license.txt"
+	kubeVirtBootstrapTFTPServerKey  = "tftp-server.py"
+	kubeVirtSrosVariantLabelKey     = "kne/sros-variant"
+	kubeVirtF5SlotUUIDEnv           = "SKYFORGE_F5_SLOT_UUID"
+	kubeVirtF5ManagementMACEnv      = "SKYFORGE_F5_SLOT_MANAGEMENT_MAC"
+	kubeVirtF5RootPVCEnv            = "SKYFORGE_F5_SLOT_ROOT_PVC"
