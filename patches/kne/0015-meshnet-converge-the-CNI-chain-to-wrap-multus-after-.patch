 	bytes, err := json.MarshalIndent(m, "", "\t")
 	if err != nil {
 		return err
 	}
-	return ioutil.WriteFile(meshnetCNIPath, bytes, os.FileMode(06444))
+	// Write-then-rename: the CRI reads this file on every sandbox, and a reader
+	// that lands mid-write sees truncated JSON and skips the file.
+	tmp := path + ".tmp"
+	if err := ioutil.WriteFile(tmp, bytes, os.FileMode(06444)); err != nil {
