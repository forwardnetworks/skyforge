 func saveInterNodeLinkConf() error {
@@ -128,7 +138,7 @@ func Init(ctx context.Context) error {
 	defer ticker.Stop()
 
 	for attempts := 0; ; attempts++ {
-		conf, err = loadConfList()
+		conf, err = buildMeshnetConf(defaultNetDir)
 		if err == nil {
 			break
 		}
@@ -142,7 +152,24 @@ func Init(ctx context.Context) error {
 		}
 	}
 
-	// We can safely access and type-cast since all of the checks have already been done in the `loadConfList()`
