+// loadConfListFrom picks the base CNI config in dir: the first valid,
+// non-meshnet file in sorted order. This is borrowed from https://tinyurl.com/khjhf9xd
+// Sorting is the whole game: 00-multus sorts before 05-cilium, so a node where
+// multus has written its conf gets multus as the base, and one where it has not
+// gets cilium alone (see WatchMultusWrap).
+func loadConfListFrom(dir string) (map[string]interface{}, error) {
+	files, err := libcni.ConfFiles(dir, []string{".conf", ".conflist", ".json"})
 	switch {
 	case err != nil:
 		return nil, err
 	case len(files) == 0:
-		return nil, libcni.NoConfigsFoundError{Dir: defaultNetDir}
+		return nil, libcni.NoConfigsFoundError{Dir: dir}
 	}
 
 	// Ignore any existing meshnet config files
@@ -90,15 +94,21 @@ func loadConfList() (map[string]interface{}, error) {
 		return conf, err
 	}
 
-	return nil, fmt.Errorf("no valid network configurations found in %q", defaultNetDir)
+	return nil, fmt.Errorf("no valid network configurations found in %q", dir)
 }
 
-func saveConfList(m map[string]interface{}) error {
