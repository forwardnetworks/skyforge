new file mode 100644
index 0000000..90c7ade
--- /dev/null
+++ b/topo/node/forward/f5_test.go
@@ -0,0 +1,39 @@
+package forward
+
+import (
+	"testing"
+
+	topopb "github.com/openconfig/kne/proto/topo"
+)
+
+func TestF5Defaults(t *testing.T) {
+	got := defaults(&topopb.Node{
+		Name:   "f5-slot-001",
+		Vendor: topopb.Vendor_F5,
+		Model:  "f5-bigip",
+		Config: &topopb.Config{},
+	})
+	if got.GetConstraints()["cpu"] != "4000m" || got.GetConstraints()["memory"] != "12Gi" {
+		t.Fatalf("F5 constraints = %#v, want 4000m/12Gi", got.GetConstraints())
+	}
+	for port, name := range map[uint32]string{22: "ssh", 161: "snmp", 443: "https"} {
+		service, ok := got.GetServices()[port]
+		if !ok || service.GetInside() != port || service.GetName() != name {
+			t.Fatalf("F5 service %d = %#v, want %q", port, service, name)
+		}
+	}
+}
+
+func TestF5DefaultsPreserveExplicitResources(t *testing.T) {
+	got := defaults(&topopb.Node{
+		Model: "f5-bigip",
+		Constraints: map[string]string{
+			"cpu":    "8000m",
+			"memory": "16Gi",
+		},
+		Config: &topopb.Config{},
+	})
+	if got.GetConstraints()["cpu"] != "8000m" || got.GetConstraints()["memory"] != "16Gi" {
+		t.Fatalf("explicit F5 constraints changed: %#v", got.GetConstraints())
+	}
+}
