+		}
+		ensureF5ManagementServices(pb)
+	}
 	return pb
 }
 
+func ensureSNMPService(pb *tpb.Node) {
+	if pb.Services == nil {
+		pb.Services = map[uint32]*tpb.Service{}
+	}
+	for port, service := range pb.Services {
+		if port == 161 || strings.EqualFold(service.GetName(), "snmp") {
+			return
+		}
+		for _, name := range service.GetNames() {
+			if strings.EqualFold(strings.TrimSpace(name), "snmp") {
+				return
+			}
+		}
+	}
+	pb.Services[161] = &tpb.Service{
+		Name:   "snmp",
+		Names:  []string{"snmp"},
+		Inside: 161,
+	}
+}
+
+func ensureF5ManagementServices(pb *tpb.Node) {
+	if pb.Services == nil {
+		pb.Services = map[uint32]*tpb.Service{}
+	}
+	for port, name := range map[uint32]string{22: "ssh", 443: "https"} {
+		if _, ok := pb.Services[port]; ok {
+			continue
+		}
+		pb.Services[port] = &tpb.Service{
+			Name:   name,
+			Names:  []string{name},
+			Inside: port,
+		}
+	}
+	ensureSNMPService(pb)
+}
