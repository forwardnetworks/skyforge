+// recreateFn is `kne topology recreate <topology> <device>`: rebuild ONE node.
+// The topology file is loaded so the node's Create sees the same proto (and
+// config file path, relative to the topology file) it was first created from.
+func recreateFn(cmd *cobra.Command, args []string) error {
+	if len(args) != 2 {
+		return fmt.Errorf("%s: missing args (need <topology> <device>)", cmd.Use)
+	}
+	topopb, err := topo.Load(args[0])
+	if err != nil {
+		return fmt.Errorf("%s: %w", cmd.Use, err)
+	}
+	bp, err := fileRelative(args[0])
+	if err != nil {
+		return fmt.Errorf("%s: %w", cmd.Use, err)
+	}
+	tOpts := append(opts, topo.WithKubecfg(viper.GetString("kubecfg")), topo.WithBasePath(bp))
+	tm, err := newRecreateManager(topopb, tOpts...)
+	if err != nil {
+		return fmt.Errorf("%s: %w", cmd.Use, err)
+	}
+	if err := tm.RecreateNode(cmd.Context(), args[1]); err != nil {
+		return fmt.Errorf("%s: %w", cmd.Use, err)
+	}
+	timeout, _ := cmd.Flags().GetDuration("timeout")
+	if timeout <= 0 {
+		return nil
+	}
+	return tm.WaitNodeAdmission(cmd.Context(), args[1], timeout)
+}
+
+// RecreateManager is the slice of the topology manager `recreate` needs; a
+// variable so the command's argument handling can be tested without a cluster.
+type RecreateManager interface {
+	RecreateNode(ctx context.Context, nodeName string) error
+	WaitNodeAdmission(ctx context.Context, nodeName string, timeout time.Duration) error
+}
+
+var newRecreateManager = func(topopb *tpb.Topology, opts ...topo.Option) (RecreateManager, error) {
+	return topo.New(topopb, opts...)
+}
+
 var newTopologyManager = func(topopb *tpb.Topology, opts ...topo.Option) (TopologyManager, error) {
 	return topo.New(topopb, opts...)
 }
diff --git a/cmd/topology/topology_test.go b/cmd/topology/topology_test.go
index 0c16399..df2c8df 100644
--- a/cmd/topology/topology_test.go
+++ b/cmd/topology/topology_test.go
@@ -9,6 +9,7 @@ import (
 	"os"
 	"path/filepath"
 	"testing"
+	"time"
 
 	"github.com/google/go-cmp/cmp"
 	"github.com/openconfig/gnmi/errdiff"
@@ -637,3 +638,81 @@ func TestPush(t *testing.T) {
 		})
 	}
 }
+
+type fakeRecreateManager struct {
+	recreated []string
+	waited    []string
+	rErr      string
+}
+
+func (f *fakeRecreateManager) RecreateNode(_ context.Context, name string) error {
+	f.recreated = append(f.recreated, name)
+	if f.rErr != "" {
+		return fmt.Errorf("%s", f.rErr)
+	}
+	return nil
+}
+
+func (f *fakeRecreateManager) WaitNodeAdmission(_ context.Context, name string, _ time.Duration) error {
+	f.waited = append(f.waited, name)
+	return nil
+}
+
+func TestRecreate(t *testing.T) {
+	topoFile := filepath.Join(t.TempDir(), "topo.pb.txt")
+	if err := os.WriteFile(topoFile, []byte(`name: "t"
+nodes: { name: "iol1" vendor: CISCO model: "iol" }
+`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		desc          string
+		args          []string
+		mgr           *fakeRecreateManager
+		wantErr       string
+		wantRecreated []string
+		wantWaited    []string
+	}{{
+		desc:    "missing device",
+		args:    []string{"recreate", topoFile},
+		mgr:     &fakeRecreateManager{},
+		wantErr: "missing args",
+	}, {
+		desc:          "recreates the named node and does not wait by default",
+		args:          []string{"recreate", topoFile, "iol1"},
+		mgr:           &fakeRecreateManager{},
+		wantRecreated: []string{"iol1"},
+	}, {
+		desc:          "waits for admission when asked",
+		args:          []string{"recreate", topoFile, "iol1", "--timeout", "30s"},
+		mgr:           &fakeRecreateManager{},
+		wantRecreated: []string{"iol1"},
+		wantWaited:    []string{"iol1"},
+	}, {
+		desc:          "manager refusal is the command's error",
+		args:          []string{"recreate", topoFile, "vsrx1"},
+		mgr:           &fakeRecreateManager{rErr: "KubeVirt-backed"},
+		wantErr:       "KubeVirt-backed",
+		wantRecreated: []string{"vsrx1"},
+	}}
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			orig := newRecreateManager
+			newRecreateManager = func(_ *tpb.Topology, _ ...topo.Option) (RecreateManager, error) { return tt.mgr, nil }
+			defer func() { newRecreateManager = orig }()
+			cmd := New()
+			cmd.SetOut(bytes.NewBuffer(nil))
+			cmd.SetArgs(tt.args)
+			err := cmd.ExecuteContext(context.Background())
+			if s := errdiff.Substring(err, tt.wantErr); s != "" {
+				t.Fatalf("recreate %v: %s", tt.args, s)
+			}
+			if diff := cmp.Diff(tt.wantRecreated, tt.mgr.recreated); diff != "" {
+				t.Fatalf("recreated diff (-want +got):\n%s", diff)
+			}
+			if diff := cmp.Diff(tt.wantWaited, tt.mgr.waited); diff != "" {
+				t.Fatalf("waited diff (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
