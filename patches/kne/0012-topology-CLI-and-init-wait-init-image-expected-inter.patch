diff --git a/init_wait/entrypoint.sh b/init_wait/entrypoint.sh
index 61abadd..45d1f10 100755
--- a/init_wait/entrypoint.sh
+++ b/init_wait/entrypoint.sh
@@ -16,12 +16,144 @@
 INTFS=${1:-1}
 SLEEP=${2:-0}
 DISABLE_IPV6=${3:-0}
+POD_NAME=${POD_NAME:-${HOSTNAME:-}}
+POD_NAMESPACE=""
+
+if [ -r /var/run/secrets/kubernetes.io/serviceaccount/namespace ]; then
+    POD_NAMESPACE="$(cat /var/run/secrets/kubernetes.io/serviceaccount/namespace 2>/dev/null || true)"
+fi
+
+api_expected_interfaces () {
+    if [ -z "$POD_NAME" ] || [ -z "$POD_NAMESPACE" ] || [ ! -r /var/run/secrets/kubernetes.io/serviceaccount/token ]; then
+        printf '%s\n' "$INTFS"
+        return 0
+    fi
+    if ! command -v python3 >/dev/null 2>&1; then
+        printf '%s\n' "$INTFS"
+        return 0
+    fi
+    python3 - "$POD_NAME" "$POD_NAMESPACE" "$INTFS" <<'PY'
+import json
+import os
+import ssl
+import sys
+import urllib.error
+import urllib.request
+
+pod_name = sys.argv[1].strip()
+namespace = sys.argv[2].strip()
+fallback = sys.argv[3].strip()
+
+def emit(value):
+    try:
+        ivalue = int(value)
+    except Exception:
+        ivalue = 0
+    if ivalue <= 0:
+        ivalue = int(fallback)
+    print(ivalue)
+
+if not pod_name or not namespace:
+    emit(fallback)
+    sys.exit(0)
+
+token_path = "/var/run/secrets/kubernetes.io/serviceaccount/token"
+ca_path = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
+try:
+    with open(token_path, "r", encoding="utf-8") as f:
+        token = f.read().strip()
+except Exception:
+    emit(fallback)
+    sys.exit(0)
+
+url = f"https://kubernetes.default.svc/apis/networkop.co.uk/v1beta1/namespaces/{namespace}/topologies/{pod_name}"
+headers = {"Authorization": f"Bearer {token}"}
+req = urllib.request.Request(url, headers=headers)
+ctx = ssl.create_default_context(cafile=ca_path if os.path.exists(ca_path) else None)
+try:
+    with urllib.request.urlopen(req, context=ctx, timeout=2) as resp:
+        topo = json.load(resp)
+except Exception:
+    emit(fallback)
+    sys.exit(0)
+
+spec_links = topo.get("spec", {}).get("links", []) or []
+if not spec_links:
+    emit(fallback)
+    sys.exit(0)
+
+skipped = topo.get("status", {}).get("skipped", []) or []
+if skipped:
+    summary = []
+    for item in skipped:
+        if isinstance(item, dict):
+            summary.append(f"{item.get('link_id')}:{item.get('pod_name')}")
+    if summary:
+        print(
+            "init-wait: topology status contains skipped links; still waiting for all declared interfaces: "
+            + ",".join(summary),
+            file=sys.stderr,
+        )
+
+active = 0
+names = []
+for link in spec_links:
+    if not isinstance(link, dict):
+        continue
+    ifname = str(link.get("local_intf", "")).strip()
+    if ifname == "" or ifname == "eth0":
+        continue
+    # A link naming a peer_namespace is wired to a pod OUTSIDE this lab's
+    # topology namespace (a Sandbox attach -- meshnet-cni 0023). Its peer can
+    # come and go independently of the lab (the sandbox pod restarting, or not
+    # attached yet), so it must never block THIS pod's init-wait the way a
+    # normal lab-internal link does.
+    if str(link.get("peer_namespace", "")).strip():
+        continue
+    active += 1
+    if ifname not in names:
+        names.append(ifname)
+
+emit(str(active + 1))
+# Second line: the declared interface NAMES, so the wait can check presence by
+# name rather than by count. Count alone is satisfied by anything that matches
+# the grep; a name is satisfied only by the wire meshnet actually declared.
+print(" ".join(names))
+PY
+}
+
+# expected_names_present -- 0 when every name in EXPECTED_NAMES exists in
+# /sys/class/net, 1 otherwise. With no names known (API unavailable) it defers
+# to the count, which is the pre-2026-09-15 behaviour.
+expected_names_present () {
+    if [ -z "$EXPECTED_NAMES" ]; then
+        [ "$MYINT" -ge "$EXPECTED_INTFS" ]
+        return $?
+    fi
+    for n in $EXPECTED_NAMES; do
+        [ -e "/sys/class/net/$n" ] || return 1
+    done
+    return 0
+}
+
+# read_expected -- refresh EXPECTED_INTFS / EXPECTED_NAMES from the API output
+# (line 1 = count, line 2 = names); a malformed count leaves the old value.
+read_expected () {
+    _out=$(api_expected_interfaces)
+    _count=$(printf '%s\n' "$_out" | sed -n '1p')
+    _names=$(printf '%s\n' "$_out" | sed -n '2p')
+    case "$_count" in
+        ''|*[!0-9]*) : ;;
+        *) EXPECTED_INTFS="$_count" ;;
+    esac
+    EXPECTED_NAMES="$_names"
+}
 
 int_calc () 
 {
     index=0
     # shellcheck disable=2010
-    for i in $(ls -1v /sys/class/net/ | grep 'eth\|ens\|eno\|^e[0-9]'); do
+    for i in $(ls -1v /sys/class/net/ | grep 'eth\|et\|ens\|eno\|^e[0-9]'); do
       # shellcheck disable=3039
       let index=index+1
     done
@@ -29,18 +161,54 @@ int_calc ()
 }
 
 int_calc
+EXPECTED_INTFS="$INTFS"
+EXPECTED_NAMES=""
+read_expected
+
+# STABLE_SECONDS: how long every declared interface must be CONTINUOUSLY
+# present before the NOS is allowed to boot. "Reached the count once" is not a
+# wiring contract. Measured 2026-09-15 (demo-lab r11, and r8 x3 before
+# it): a KubeVirt peer whose sandbox kubelet keeps tearing down and retrying
+# (its other peers not yet admitted by the heavy lane) makes meshnet create and
+# delete this pod's eth4/eth5 every few seconds, ~1s wide. init-wait saw the
+# count touch N during one flash, exited, and cEOS -- which enumerates its
+# interfaces once at boot and never hot-plugs -- came up with Ethernet1-3 and
+# no Ethernet4/5, permanently, no matter how long anyone waited afterwards.
+# A settle window that resets on any regression can only be satisfied once
+# the peer's sandbox has actually stabilized. Default 20s; override with the
+# INIT_WAIT_STABLE_SECONDS env for a lab that needs it, never below 1.
+STABLE_SECONDS=${INIT_WAIT_STABLE_SECONDS:-20}
+case "$STABLE_SECONDS" in ''|*[!0-9]*|0) STABLE_SECONDS=20 ;; esac
 
-echo "Waiting for all $INTFS interfaces to be connected"
-while [ "$MYINT" -lt "$INTFS" ]; do
-  echo "Connected $MYINT interfaces out of $INTFS"
+echo "Waiting for all $EXPECTED_INTFS interfaces to be connected (names: ${EXPECTED_NAMES:-unknown, using count}) and stable for ${STABLE_SECONDS}s"
+stable=0
+was_ready=0
+while :; do
+  if expected_names_present; then
+    stable=$((stable + 1))
+    if [ "$was_ready" -eq 0 ]; then
+      echo "All $EXPECTED_INTFS interfaces present ($MYINT seen); holding for ${STABLE_SECONDS}s of stability"
+      was_ready=1
+    fi
+    [ "$stable" -ge "$STABLE_SECONDS" ] && break
+  else
+    if [ "$was_ready" -eq 1 ]; then
+      echo "init-wait: interfaces REGRESSED after being complete (now $MYINT of $EXPECTED_INTFS present) -- a peer is flapping its side of a link; restarting the stability window"
+    fi
+    stable=0
+    was_ready=0
+    echo "Connected $MYINT interfaces out of $EXPECTED_INTFS"
+  fi
   sleep 1
   int_calc
+  read_expected
 done
+echo "All $EXPECTED_INTFS interfaces present and stable for ${STABLE_SECONDS}s"
 
 if [ "$DISABLE_IPV6" -ne 0 ]; then
     # shellcheck disable=2010
     # Remove eth0 from disable list
-    for i in $(ls -1v /sys/class/net/ | grep 'eth\|ens\|eno\|^e[0-9]' | grep -v '^eth0'); do
+    for i in $(ls -1v /sys/class/net/ | grep 'eth\|et\|ens\|eno\|^e[0-9]' | grep -v '^eth0'); do
       sysctl net.ipv6.conf."$i".disable_ipv6=1
       ip link set dev "$i" arp off
     done
