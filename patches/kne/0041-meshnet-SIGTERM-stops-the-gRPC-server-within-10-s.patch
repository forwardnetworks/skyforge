From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:21:18 -0500
Subject: [PATCH 41/41] meshnet: SIGTERM stops the gRPC server within 10 s

---
diff --git a/third_party/meshnet/daemon/main.go b/third_party/meshnet/daemon/main.go
index 28b7f1f..899c326 100644
--- a/third_party/meshnet/daemon/main.go
+++ b/third_party/meshnet/daemon/main.go
@@ -72,12 +72,35 @@ func main() {
 	orphanInterval, orphanNeed := orphanKnobs()
 	go m.RunOrphanReconciler(ctx, orphanInterval, orphanNeed)
 
+	// SIGTERM (kubelet delete, rollout) must stop the gRPC server. Serve never
+	// returns on its own, and kubelet SIGKILLs after terminationGracePeriodSeconds,
+	// so the stop is bounded here and the process exits with it. os.Exit skips
+	// the deferred cni.Cleanup: a restart keeps the CNI chain, as a SIGKILL does.
+	go func() {
+		<-ctx.Done()
+		log.Info("stop signal: stopping gRPC within the shutdown budget")
+		if !m.StopWithin(shutdownBudget) {
+			log.Warnf("stop signal: in-flight RPCs were closed after %v", shutdownBudget)
+		}
+		os.Exit(0)
+	}()
+
 	if err := m.Serve(); err != nil {
 		log.Errorf("daemon exited badly: %v", err)
 		os.Exit(1)
 	}
+	if ctx.Err() != nil {
+		// Serve returned because of the stop signal. The goroutine above
+		// ends the process. Block here so main cannot return and run defers.
+		select {}
+	}
 }
 
+// shutdownBudget bounds the gRPC stop on SIGTERM. It is well under the
+// DaemonSet's terminationGracePeriodSeconds (15), so the process exits itself
+// before kubelet sends SIGKILL.
+const shutdownBudget = 10 * time.Second
+
 // orphanKnobs reads the orphan reconciler's interval and confirmation count.
 // Defaults: 5 minutes and 2 passes. Invalid values are logged and the default
 // is used, so a typo cannot disable the reconciler silently.
diff --git a/third_party/meshnet/daemon/meshnet/meshnet.go b/third_party/meshnet/daemon/meshnet/meshnet.go
index 5deffc6..ade33c5 100644
--- a/third_party/meshnet/daemon/meshnet/meshnet.go
+++ b/third_party/meshnet/daemon/meshnet/meshnet.go
@@ -181,6 +181,26 @@ func (m *Meshnet) Stop() {
 	m.s.Stop()
 }
 
+// StopWithin stops the gRPC server: it waits up to d for in-flight RPCs, then
+// closes the rest. It returns true when the graceful stop finished in time.
+// Serve returns once it has stopped. Without a bound, a long-lived stream
+// (grpcwire) keeps the daemon alive until kubelet's SIGKILL.
+func (m *Meshnet) StopWithin(d time.Duration) bool {
+	done := make(chan struct{})
+	go func() {
+		m.s.GracefulStop()
+		close(done)
+	}()
+	select {
+	case <-done:
+		return true
+	case <-time.After(d):
+		m.s.Stop()
+		<-done
+		return false
+	}
+}
+
 func interceptorLogger(l log.FieldLogger) logging.Logger {
 	return logging.LoggerFunc(func(_ context.Context, lvl logging.Level, msg string, fields ...any) {
 		f := make(map[string]any, len(fields)/2)
diff --git a/third_party/meshnet/daemon/meshnet/stop_test.go b/third_party/meshnet/daemon/meshnet/stop_test.go
new file mode 100644
index 0000000..a148b60
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/stop_test.go
@@ -0,0 +1,100 @@
+package meshnet
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/health"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+)
+
+// startHeldServer runs a gRPC server whose health Check RPC blocks until
+// release is closed, so an RPC is in flight when the stop starts. It returns
+// the server's Meshnet wrapper, a channel that receives when the RPC has
+// entered the handler, and a client connection.
+func startHeldServer(t *testing.T, release <-chan struct{}) (*Meshnet, <-chan struct{}, *grpc.ClientConn) {
+	t.Helper()
+	entered := make(chan struct{}, 1)
+	s := grpc.NewServer(grpc.UnaryInterceptor(func(ctx context.Context, req any, _ *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+		select {
+		case entered <- struct{}{}:
+		default:
+		}
+		select {
+		case <-release:
+		case <-ctx.Done():
+		}
+		return handler(ctx, req)
+	}))
+	healthpb.RegisterHealthServer(s, health.NewServer())
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	go s.Serve(lis)
+	conn, err := grpc.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	return &Meshnet{s: s, lis: lis}, entered, conn
+}
+
+// A held RPC must not keep StopWithin past its bound. Before the fix, Serve
+// was never stopped on SIGTERM, so a stream like this kept the daemon up
+// until kubelet's SIGKILL.
+func TestStopWithinBoundsAHeldRPC(t *testing.T) {
+	release := make(chan struct{})
+	defer close(release)
+	m, entered, conn := startHeldServer(t, release)
+	defer conn.Close()
+
+	rpcErr := make(chan error, 1)
+	go func() {
+		_, err := healthpb.NewHealthClient(conn).Check(context.Background(), &healthpb.HealthCheckRequest{})
+		rpcErr <- err
+	}()
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		t.Fatal("RPC never reached the handler")
+	}
+
+	start := time.Now()
+	graceful := m.StopWithin(200 * time.Millisecond)
+	elapsed := time.Since(start)
+
+	if graceful {
+		t.Errorf("StopWithin reported a graceful stop with an RPC still held")
+	}
+	if elapsed > 3*time.Second {
+		t.Errorf("StopWithin took %v with a 200ms budget", elapsed)
+	}
+	select {
+	case err := <-rpcErr:
+		if err == nil {
+			t.Errorf("held RPC returned success after the server was stopped")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("held RPC was not closed by the stop")
+	}
+}
+
+// With nothing in flight, StopWithin stops at once and reports graceful.
+func TestStopWithinIdleIsGraceful(t *testing.T) {
+	release := make(chan struct{})
+	defer close(release)
+	m, _, conn := startHeldServer(t, release)
+	defer conn.Close()
+
+	start := time.Now()
+	if !m.StopWithin(5 * time.Second) {
+		t.Errorf("StopWithin with no RPC in flight did not report graceful")
+	}
+	if elapsed := time.Since(start); elapsed > 2*time.Second {
+		t.Errorf("idle stop took %v", elapsed)
+	}
+}
