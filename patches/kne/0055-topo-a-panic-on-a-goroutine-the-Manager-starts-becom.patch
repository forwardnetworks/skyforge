diff --git a/topo/goroutine_panic.go b/topo/goroutine_panic.go
new file mode 100644
index 0000000..5fbd5ef
--- /dev/null
+++ b/topo/goroutine_panic.go
@@ -0,0 +1,33 @@
+package topo
+
+import (
+	"fmt"
+	"runtime/debug"
+)
+
+// PanicError is a panic recovered on a goroutine the Manager started itself (an errgroup worker of Create, the
+// per-node status / services / resources goroutines). Such a goroutine cannot be recovered by the caller of
+// Create / Show / Resources: an unrecovered panic there ends the whole process, which is acceptable for the
+// kne CLI and not for a server that embeds the Manager. The panic is returned through the error the goroutine's
+// caller already returns, so a vendor node implementation that panics fails that one operation.
+type PanicError struct {
+	// Where names the goroutine.
+	Where string
+	// Value is the recovered value.
+	Value any
+	// Stack is debug.Stack() at the panic (taken inside the deferred recover, so it shows the panicking frames).
+	Stack []byte
+}
+
+func (e *PanicError) Error() string { return fmt.Sprintf("panic in %s: %v", e.Where, e.Value) }
+
+// Unwrap returns the recovered value when it is an error (a runtime.Error, for example).
+func (e *PanicError) Unwrap() error {
+	err, _ := e.Value.(error)
+	return err
+}
+
+// newPanicError must be called from the deferred function that recovered r.
+func newPanicError(where string, r any) error {
+	return &PanicError{Where: where, Value: r, Stack: debug.Stack()}
+}
diff --git a/topo/goroutine_panic_test.go b/topo/goroutine_panic_test.go
new file mode 100644
index 0000000..f2d1668
--- /dev/null
+++ b/topo/goroutine_panic_test.go
@@ -0,0 +1,156 @@
+package topo
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/client-go/dynamic"
+	dfake "k8s.io/client-go/dynamic/fake"
+
+	topologyv1 "github.com/openconfig/kne/third_party/meshnet/api/types/v1beta1"
+)
+
+// panickingNode is a vendor node implementation that panics in the method named by `in`. Every other method is the
+// embedded nil node.Node (a call on it would itself panic, so GetProto and the methods the goroutines reach first are
+// overridden).
+type panickingNode struct {
+	node.Node
+	pb *tpb.Node
+	in string
+}
+
+func (n *panickingNode) boom(where string) {
+	if n.in == where {
+		panic("vendor node bug in " + where)
+	}
+}
+
+func (n *panickingNode) Name() string                 { return n.pb.GetName() }
+func (n *panickingNode) String() string               { return n.pb.GetName() }
+func (n *panickingNode) GetProto() *tpb.Node          { n.boom("GetProto"); return n.pb }
+func (n *panickingNode) Create(context.Context) error { n.boom("Create"); return nil }
+func (n *panickingNode) Pods(context.Context) ([]*corev1.Pod, error) {
+	n.boom("Pods")
+	return []*corev1.Pod{{}}, nil
+}
+func (n *panickingNode) Services(context.Context) ([]*corev1.Service, error) {
+	n.boom("Services")
+	return nil, nil
+}
+func (n *panickingNode) Status(context.Context) (node.Status, error) {
+	n.boom("Status")
+	return node.StatusRunning, nil
+}
+
+func newPanickingManager(in string, withService bool) (*Manager, *panickingNode) {
+	pb := &tpb.Node{Name: "r1"}
+	if withService {
+		pb.Services = map[uint32]*tpb.Service{22: {Name: "ssh", Inside: 22}}
+	}
+	n := &panickingNode{pb: pb, in: in}
+	return &Manager{nodes: map[string]node.Node{"r1": n}, topo: &tpb.Topology{Name: "lab", Nodes: []*tpb.Node{pb}},
+		dClient: dfake.NewSimpleDynamicClient(topologyv1.Scheme)}, n
+}
+
+// run fails the test (instead of letting the process die) if f does not return in time; a panic that escapes a
+// goroutine kills the test binary, which is exactly the failure these tests exist to show.
+func within(t *testing.T, f func()) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() { defer close(done); f() }()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("did not return")
+	}
+}
+
+func wantPanicError(t *testing.T, err error, in string) {
+	t.Helper()
+	var pe *PanicError
+	if !errors.As(err, &pe) {
+		t.Fatalf("err = %v, want a *PanicError", err)
+	}
+	if !strings.Contains(err.Error(), "vendor node bug in "+in) {
+		t.Fatalf("err = %v, want the panic value", err)
+	}
+	if !strings.Contains(string(pe.Stack), "goroutine_panic_test.go") {
+		t.Fatalf("the stack must show the panicking frame:\n%s", pe.Stack)
+	}
+}
+
+func TestResourcesTurnsANodePanicIntoAnError(t *testing.T) {
+	m, _ := newPanickingManager("Pods", false)
+	within(t, func() {
+		_, err := m.Resources(context.Background())
+		wantPanicError(t, err, "Pods")
+	})
+}
+
+func TestShowTurnsAStatusPanicIntoAnError(t *testing.T) {
+	m, _ := newPanickingManager("Status", false)
+	within(t, func() {
+		resp, err := m.Show(context.Background())
+		wantPanicError(t, err, "Status")
+		if resp != nil {
+			t.Fatalf("Show returned a response with a failed node status: %v", resp)
+		}
+	})
+}
+
+func TestCheckServiceStatusTurnsAServicesPanicIntoAnError(t *testing.T) {
+	m, _ := newPanickingManager("Services", true)
+	within(t, func() {
+		wantPanicError(t, m.checkServiceStatus(context.Background(), time.Second), "Services")
+	})
+}
+
+func TestCreateNodeResourcesTurnsACreatePanicIntoAnError(t *testing.T) {
+	for _, in := range []string{"Create", "GetProto"} {
+		m, n := newPanickingManager(in, false)
+		within(t, func() {
+			wantPanicError(t, m.createNodeResources(context.Background(), []node.Node{n}, 2), in)
+		})
+	}
+}
+
+func TestAdmissionGroupsTurnAPanicIntoAnError(t *testing.T) {
+	m, n := newPanickingManager("GetProto", false)
+	within(t, func() {
+		err := m.admitNodeGroupsAndGenerateCerts(context.Background(), []nodeAdmissionGroup{{name: "g", nodes: []node.Node{n}, parallelism: 1}})
+		wantPanicError(t, err, "GetProto")
+	})
+}
+
+type panickingProbeRunner struct{}
+
+func (panickingProbeRunner) Run(context.Context, *tpb.ReadinessProbe, node.Node) error {
+	panic("vendor node bug in probe")
+}
+
+func TestLifecycleProbeRunnerPanicBecomesAnError(t *testing.T) {
+	m, _ := newPanickingManager("", false)
+	m.lifecycleProbeRunner = panickingProbeRunner{}
+	within(t, func() {
+		err := m.runLifecyclePhaseProbes(context.Background(), &tpb.LifecyclePhase{Probes: []*tpb.ReadinessProbe{{Name: "p", Node: "r1", Timeout: "1s"}}})
+		wantPanicError(t, err, "probe")
+	})
+}
+
+func TestMeshnetCreateGoroutinePanicBecomesAnError(t *testing.T) {
+	m, _ := newPanickingManager("", false)
+	m.dClient = struct{ dynamic.Interface }{} // any call on the nil embedded client panics
+	within(t, func() {
+		err := m.createMeshnetTopologiesWithLimit(context.Background(), []*topologyv1.Topology{{}})
+		var pe *PanicError
+		if !errors.As(err, &pe) {
+			t.Fatalf("err = %v, want a *PanicError", err)
+		}
+	})
+}
