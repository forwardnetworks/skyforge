Subject: [PATCH 18/35] meshnet: converge log names the multus conf that was
 found, not the conflist name

---
diff --git a/third_party/meshnet/daemon/cni/cni.go b/third_party/meshnet/daemon/cni/cni.go
index 02c4a48..885764c 100644
--- a/third_party/meshnet/daemon/cni/cni.go
+++ b/third_party/meshnet/daemon/cni/cni.go
@@ -294,7 +294,7 @@ func WatchMultusWrap(ctx context.Context) {
 			continue
 		}
 		if rewrote {
-			log.Infof("re-installed %s to wrap multus: %s appeared after meshnet's first install", meshnetCNIPath, multusConfName)
+			log.Infof("re-installed %s to wrap multus: a multus conf appeared after meshnet's first install", meshnetCNIPath)
 		}
 	}
 }
