 					if err := vxlan.CreateOrUpdate(remotePod); err != nil {
@@ -408,6 +410,9 @@ func (m *Meshnet) reconcilePodLinksInternal(ctx context.Context, topo *unstructu
 	if err := runLinkJobs(vxlanJobs, linkConcurrency); err != nil {
 		return err
 	}
+	// M1: the peer may have come up before our end existed, and its daemon
+	// may not repair its own end for minutes. Ask it once per peer epoch (peer_repair.go).
+	m.nudgePeerEnds(ctx, peerEnds)
 
 	// 2. Process gRPC peer batches in chunks (default 50 items per RPC) to allow pipelined processing
 	batchSize := wireutil.GetEnvInt("WIRE_BATCH_SIZE", 50)
