 	googleFindDefaultCredentials = google.FindDefaultCredentials
 	clusterKindNameRE            = regexp.MustCompile("kind-(.*)")
+
+	// currentContext returns the kubeconfig current-context. It is a variable so tests can stub it.
+	currentContext = kubeconfigCurrentContext
 )
 
+// kubeconfigCurrentContext is `kubectl config current-context` without kubectl: the same merged kubeconfig
+// (KUBECONFIG list, else ~/.kube/config, via client-go's default loading rules, which is what kubectl uses) and
+// the same failure when no current-context is set (kubectl: "error: current-context is not set").
+func kubeconfigCurrentContext() (string, error) {
+	cfg, err := clientcmd.NewDefaultClientConfigLoadingRules().Load()
+	if err != nil {
+		return "", err
+	}
+	if cfg.CurrentContext == "" {
+		return "", errors.New("current-context is not set")
+	}
+	return cfg.CurrentContext, nil
+}
+
 func ClusterIsKind() (bool, error) {
 	name, err := clusterName()
 	if err != nil {
@@ -38,11 +57,11 @@ func ClusterIsKind() (bool, error) {
 }
 
 func clusterName() (string, error) {
-	b, err := run.OutCommand("kubectl", "config", "current-context")
+	name, err := currentContext()
 	if err != nil {
 		return "", fmt.Errorf("unable to determine cluster information: %v", err)
 	}
-	return string(b), nil
+	return name, nil
 }
 
 func clusterKindName() (string, error) {
