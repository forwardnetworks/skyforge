+package kind
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func writeKubeconfig(t *testing.T, dir, name, current string) string {
+	t.Helper()
+	p := filepath.Join(dir, name)
+	cfg := "apiVersion: v1\nkind: Config\nclusters:\n- name: c\n  cluster: {server: 'https://127.0.0.1:1'}\n" +
+		"users:\n- name: u\n  user: {token: x}\ncontexts:\n- name: kind-kne\n  context: {cluster: c, user: u}\n" +
+		"- name: prod\n  context: {cluster: c, user: u}\n"
+	if current != "" {
+		cfg += "current-context: " + current + "\n"
+	}
+	if err := os.WriteFile(p, []byte(cfg), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// TestClusterIsKindFromKubeconfig runs the real (unstubbed) seam against kubeconfig files: no kubectl, no PATH.
+func TestClusterIsKindFromKubeconfig(t *testing.T) {
+	t.Setenv("PATH", "") // any attempt to exec kubectl would fail loudly
+	dir := t.TempDir()
+	tests := []struct {
+		desc      string
+		kubecfg   string // KUBECONFIG value; empty = file does not exist
+		want      bool
+		wantErr   bool
+		wantKName string
+	}{
+		{desc: "kind context", kubecfg: writeKubeconfig(t, dir, "kind", "kind-kne"), want: true, wantKName: "kne"},
+		{desc: "other context", kubecfg: writeKubeconfig(t, dir, "prod", "prod")},
+		{desc: "no current-context", kubecfg: writeKubeconfig(t, dir, "none", ""), wantErr: true},
+		{desc: "no kubeconfig (in-cluster)", kubecfg: filepath.Join(dir, "absent"), wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			t.Setenv("KUBECONFIG", tt.kubecfg)
+			got, err := ClusterIsKind()
+			if (err != nil) != tt.wantErr || got != tt.want {
+				t.Fatalf("ClusterIsKind() = %v, %v; want %v (err %v)", got, err, tt.want, tt.wantErr)
+			}
+			if tt.wantKName != "" {
+				if n, err := clusterKindName(); err != nil || n != tt.wantKName {
+					t.Fatalf("clusterKindName() = %q, %v; want %q", n, err, tt.wantKName)
+				}
+			}
+		})
+	}
+}
