+// stubCurrentContext serves the leading `kubectl config current-context` response of a table row from the
+// currentContext seam (the code no longer runs kubectl) and returns the remaining responses for the fake exec.
+func stubCurrentContext(t *testing.T, resp []fexec.Response) []fexec.Response {
+	t.Helper()
+	orig := currentContext
+	t.Cleanup(func() { currentContext = orig })
+	currentContext = func() (string, error) { return "", errors.New("current-context is not set") }
+	var rest []fexec.Response
+	for _, r := range resp {
+		if r.Cmd == "kubectl" && len(r.Args) == 2 && r.Args[0] == "config" && r.Args[1] == "current-context" {
+			currentContext = func() (string, error) {
+				if r.Err != nil {
+					return "", errors.New("failed to get name")
+				}
+				return r.Stdout, nil
+			}
+			continue
+		}
+		rest = append(rest, r)
+	}
+	return rest
+}
