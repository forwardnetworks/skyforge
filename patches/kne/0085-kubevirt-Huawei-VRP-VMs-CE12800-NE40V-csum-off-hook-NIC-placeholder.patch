+package node
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	topopb "github.com/openconfig/kne/proto/topo"
+)
+
+func huaweiNode(model string, ethNumbers ...int) *topopb.Node {
+	ifs := map[string]*topopb.Interface{}
+	for _, n := range ethNumbers {
+		name := fmt.Sprintf("eth%d", n)
+		ifs[name] = &topopb.Interface{Name: fmt.Sprintf("GE1/0/%d", n-1), IntName: name}
+	}
+	return &topopb.Node{Name: "sw1", Vendor: topopb.Vendor_HUAWEI, Model: model, Interfaces: ifs}
+}
+
+func ifaceNames(list []any) []string {
+	var out []string
+	for _, i := range list {
+		out = append(out, i.(map[string]any)["name"].(string))
+	}
+	return out
+}
+
+// Measured 2026-11-19: GE1/0/0 (CE) and Ethernet1/0/0 (NE) sit on NIC index 2; NIC index 1 is
+// a placeholder VRP never maps. So the rendered order must be mgmt, placeholder, eth1, eth2...
+func TestKubeVirtHuaweiPlaceholderThenEthN(t *testing.T) {
+	for _, model := range []string{"ce12800", "ne40v"} {
+		got := ifaceNames(kubeVirtInterfaces("ns", huaweiNode(model, 1, 2, 3)))
+		want := []string{"default", "vrp-placeholder", "eth1", "eth2", "eth3"}
+		if strings.Join(got, ",") != strings.Join(want, ",") {
+			t.Errorf("%s interfaces = %v, want %v", model, got, want)
+		}
+	}
+}
+
+// eth10 must come after eth9 (lexicographic order would put it after eth1), and a sparse
+// topology must keep ethN on slot N: eth4 alone still takes NIC index 5 (port 3).
+func TestKubeVirtHuaweiGapsAndNumericOrder(t *testing.T) {
+	got := ifaceNames(kubeVirtInterfaces("ns", huaweiNode("ce12800", 1, 4)))
+	want := []string{"default", "vrp-placeholder", "eth1", "vrp-gap2", "vrp-gap3", "eth4"}
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Errorf("sparse interfaces = %v, want %v", got, want)
+	}
+	all := []int{}
+	for i := 1; i <= 10; i++ {
+		all = append(all, i)
+	}
+	got = ifaceNames(kubeVirtInterfaces("ns", huaweiNode("ne40v", all...)))
+	if got[len(got)-1] != "eth10" || got[len(got)-2] != "eth9" {
+		t.Errorf("ten data NICs end %v, want ... eth9 eth10", got[len(got)-2:])
+	}
+	if len(got) != 12 {
+		t.Errorf("got %d NICs, want 12 (mgmt + placeholder + 10)", len(got))
+	}
+}
+
+func TestKubeVirtHuaweiNetworksMatchInterfaces(t *testing.T) {
+	n := huaweiNode("ce12800", 1, 3)
+	ifs := ifaceNames(kubeVirtInterfaces("ns", n))
+	nets := kubeVirtNetworks(n)
+	if len(nets) != len(ifs) {
+		t.Fatalf("%d networks for %d interfaces", len(nets), len(ifs))
+	}
+	wantNet := map[string]string{"vrp-placeholder": "vrp-placeholder", "vrp-gap2": "vrp-placeholder", "eth1": "meshnet", "eth3": "meshnet"}
+	for i, raw := range nets {
+		m := raw.(map[string]any)
+		if m["name"] != ifs[i] {
+			t.Errorf("network %d name %v != interface %v", i, m["name"], ifs[i])
+		}
+		if i == 0 {
+			continue
+		}
+		if got := m["multus"].(map[string]any)["networkName"]; got != wantNet[ifs[i]] {
+			t.Errorf("%s attached to %v, want %s", ifs[i], got, wantNet[ifs[i]])
+		}
+	}
+}
+
+func TestKubeVirtHuaweiHookAndProfile(t *testing.T) {
+	for _, model := range []string{"ce12800", "ne40v"} {
+		ann := kubeVirtSMBIOSHookAnnotationsForModel("sw1", model)
+		if !strings.Contains(ann["hooks.kubevirt.io/hookSidecars"], "huawei-vrp-nic-hook") {
+			t.Errorf("%s: no Huawei NIC hook annotation: %v", model, ann)
+		}
+		if name, ok := kubeVirtSMBIOSHookConfigMapNameForModel("sw1", model); !ok || name != "sw1-huawei-vrp-nic-hook" {
+			t.Errorf("%s: hook configmap name %q ok=%v", model, name, ok)
+		}
+		if got := kubeVirtInterfaceModel(model); got != "virtio" {
+			t.Errorf("%s: interface model %q, want virtio (e1000 never transmits on VRP)", model, got)
+		}
+		p := kubeVirtHardwareProfileFor(model, "")
+		if p.MachineType != "q35" || p.CPUModel != "host-passthrough" {
+			t.Errorf("%s: machine %q cpu %q", model, p.MachineType, p.CPUModel)
+		}
+	}
+	if kubeVirtHardwareProfileFor("ce12800", "").MinimumCPU != 4 || kubeVirtHardwareProfileFor("ne40v", "").MinimumCPU != 2 {
+		t.Errorf("minimum CPU: ce12800 %d (want 4), ne40v %d (want 2)", kubeVirtHardwareProfileFor("ce12800", "").MinimumCPU, kubeVirtHardwareProfileFor("ne40v", "").MinimumCPU)
+	}
+	if !strings.Contains(kubeVirtHuaweiNICHookScript, `"csum": "off"`) {
+		t.Error("hook script does not turn guest csum off")
+	}
+	if !kubeVirtModelSupportedByVendor(topopb.Vendor_HUAWEI, "ce12800") || !kubeVirtModelSupportedByVendor(topopb.Vendor_HUAWEI, "ne40v") {
+		t.Error("HUAWEI vendor does not list ce12800 and ne40v")
+	}
+}
+
+// Every other model renders exactly as before: no placeholder, no hook.
+func TestKubeVirtNonHuaweiUnchanged(t *testing.T) {
+	for _, model := range []string{"nxos", "a10", "fortios", "panos", "cat8000v", "sros", "vjunos-router"} {
+		n := &topopb.Node{Name: "n1", Model: model, Interfaces: map[string]*topopb.Interface{"eth1": {IntName: "eth1"}, "eth2": {IntName: "eth2"}}}
+		got := ifaceNames(kubeVirtInterfaces("ns", n))
+		if strings.Join(got, ",") != "default,eth1,eth2" {
+			t.Errorf("%s interfaces = %v", model, got)
+		}
+		if _, ok := kubeVirtSMBIOSHookConfigMapNameForModel("n1", model); ok && !strings.Contains("sros vjunos-router", model) {
+			t.Errorf("%s gained a hook", model)
+		}
+	}
+}
