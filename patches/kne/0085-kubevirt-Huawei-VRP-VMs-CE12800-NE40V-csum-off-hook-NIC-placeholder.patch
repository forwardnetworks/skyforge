diff --git a/topo/node/kubevirt_huawei.go b/topo/node/kubevirt_huawei.go
new file mode 100644
index 0000000..4bfe2cd
--- /dev/null
+++ b/topo/node/kubevirt_huawei.go
@@ -0,0 +1,238 @@
+package node
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"sort"
+	"strconv"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/client-go/dynamic"
+)
+
+// Huawei VRP (CE12800 switch, NE40E router) on KubeVirt. PLATFORM-SPECIFIC, patch 0085.
+//
+// Two things the generic KubeVirt path cannot do for these guests, both measured on
+// the real images on 2026-11-19 (see the "ce12800" profile comment for the evidence):
+//
+//  1. The guest must not negotiate virtio-net checksum/TSO offload, or SSH (inbound
+//     TCP) never reaches VRP's TCP stack. kubeVirtHuaweiNICHookScript is the
+//     onDefineDomain hook that turns it off; it rides the same sidecar-shim +
+//     per-node ConfigMap machinery SR-OS and vJunos already use.
+//  2. NIC index 1 is a placeholder VRP does not map to a port, so data NICs start
+//     at index 2. kubeVirtHuaweiNICSlots renders it, and fills holes in the ethN
+//     numbering so ethN always lands on port N-1 (eth1 = GE1/0/0 = Ethernet1/0/0).
+
+const (
+	kubeVirtHuaweiPlaceholderName = "vrp-placeholder"
+	kubeVirtHuaweiGapPrefix       = "vrp-gap"
+	kubeVirtHuaweiPlaceholderNAD  = "vrp-placeholder"
+)
+
+// kubeVirtHuaweiNICHookScript is the libvirt onDefineDomain hook: every virtio NIC
+// gets <driver><guest csum='off' tso4='off' tso6='off' ecn='off' ufo='off'/></driver>
+// so the guest never receives CHECKSUM_PARTIAL segments (VRP's TCP stack drops them).
+const kubeVirtHuaweiNICHookScript = `#!/usr/bin/env python3
+import argparse
+import sys
+import xml.etree.ElementTree as ET
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--vmi", required=False)
+    parser.add_argument("--domain", required=True)
+    args, _ = parser.parse_known_args()
+    root = ET.fromstring(args.domain)
+    for iface in root.findall("./devices/interface"):
+        model = iface.find("model")
+        if model is None or not model.attrib.get("type", "").startswith("virtio"):
+            continue
+        for old in iface.findall("driver"):
+            iface.remove(old)
+        driver = ET.SubElement(iface, "driver")
+        ET.SubElement(driver, "guest", {"csum": "off", "tso4": "off", "tso6": "off", "ecn": "off", "ufo": "off"})
+    sys.stdout.write(ET.tostring(root, encoding="unicode"))
+
+
+if __name__ == "__main__":
+    main()
+`
+
+func kubeVirtIsHuaweiVRP(model string) bool {
+	switch normalizeKubeVirtModel(model) {
+	case "ce12800", "ne40v":
+		return true
+	}
+	return false
+}
+
+func kubeVirtHuaweiNICHookConfigMapName(nodeName string) string {
+	return kubeVirtSMBIOSHookConfigMapName(nodeName, "huawei-vrp-nic-hook")
+}
+
+var kubeVirtHuaweiEthRe = regexp.MustCompile(`^eth([0-9]+)$`)
+
+// kubeVirtHuaweiNICSlots returns the KubeVirt interface names for NIC index 1, 2, ...
+// (index 0 is the masquerade management NIC). Index 1 is the placeholder; index
+// N+1 is ethN, with undeclared numbers filled by a placeholder so a sparse topology
+// (eth1 and eth4 only) still puts eth4 on port 3. A declared name that is not ethN
+// disables gap filling and falls back to a natural-number sort of what is declared.
+// real[name] is true for the slots that carry a meshnet link.
+func kubeVirtHuaweiNICSlots(proto *tpb.Node) (slots []string, real map[string]bool) {
+	declared := kubeVirtDataInterfaces(proto)
+	real = map[string]bool{}
+	slots = []string{kubeVirtHuaweiPlaceholderName}
+	max := 0
+	nums := map[int]string{}
+	regular := true
+	for _, name := range declared {
+		m := kubeVirtHuaweiEthRe.FindStringSubmatch(name)
+		if m == nil {
+			regular = false
+			break
+		}
+		n, _ := strconv.Atoi(m[1])
+		if n < 1 || n > 64 {
+			regular = false
+			break
+		}
+		nums[n] = name
+		if n > max {
+			max = n
+		}
+	}
+	if !regular {
+		sorted := append([]string(nil), declared...)
+		sort.SliceStable(sorted, func(i, j int) bool { return kubeVirtNaturalLess(sorted[i], sorted[j]) })
+		for _, name := range sorted {
+			slots = append(slots, name)
+			real[name] = true
+		}
+		return slots, real
+	}
+	for n := 1; n <= max; n++ {
+		if name, ok := nums[n]; ok {
+			slots = append(slots, name)
+			real[name] = true
+			continue
+		}
+		slots = append(slots, fmt.Sprintf("%s%d", kubeVirtHuaweiGapPrefix, n))
+	}
+	return slots, real
+}
+
+// kubeVirtNaturalLess orders "eth2" before "eth10".
+func kubeVirtNaturalLess(a, b string) bool {
+	split := func(s string) (string, int, bool) {
+		i := len(s)
+		for i > 0 && s[i-1] >= '0' && s[i-1] <= '9' {
+			i--
+		}
+		if i == len(s) {
+			return s, 0, false
+		}
+		n, _ := strconv.Atoi(s[i:])
+		return s[:i], n, true
+	}
+	pa, na, oka := split(a)
+	pb, nb, okb := split(b)
+	if oka && okb && pa == pb {
+		return na < nb
+	}
+	return a < b
+}
+
+func kubeVirtHuaweiInterfaces(proto *tpb.Node, interfaces []any) []any {
+	slots, real := kubeVirtHuaweiNICSlots(proto)
+	for _, name := range slots {
+		nic := map[string]any{
+			"name":   name,
+			"bridge": map[string]any{},
+		}
+		if model := kubeVirtInterfaceModel(proto.Model); model != "" {
+			nic["model"] = model
+		}
+		if real[name] {
+			if mac := kubeVirtDataInterfaceMAC(proto, kubeVirtVendorInterfaceName(proto, name)); mac != "" {
+				nic["macAddress"] = mac
+			}
+		}
+		interfaces = append(interfaces, nic)
+	}
+	return interfaces
+}
+
+func kubeVirtHuaweiNetworks(proto *tpb.Node, networks []any) []any {
+	slots, real := kubeVirtHuaweiNICSlots(proto)
+	for _, name := range slots {
+		network := kubeVirtHuaweiPlaceholderNAD
+		if real[name] {
+			network = "meshnet"
+		}
+		networks = append(networks, map[string]any{
+			"name": name,
+			"multus": map[string]any{
+				"networkName": network,
+			},
+		})
+	}
+	return networks
+}
+
+// kubeVirtHuaweiPlaceholderNADConfig is a plain bridge CNI attachment for the
+// placeholder NICs. meshnet cannot serve them: its secondary ADD fails closed on an
+// interface with no topology link. Nothing is ever linked to or transmitted on it.
+func kubeVirtHuaweiPlaceholderNADConfig() map[string]any {
+	return map[string]any{
+		"cniVersion": "0.3.1",
+		"name":       kubeVirtHuaweiPlaceholderNAD,
+		"type":       "bridge",
+		"bridge":     "vrpph0",
+		"ipam":       map[string]any{},
+	}
+}
+
+func (n *Impl) ensureKubeVirtHuaweiPlaceholderNAD(ctx context.Context, dc dynamic.Interface) error {
+	config, err := json.Marshal(kubeVirtHuaweiPlaceholderNADConfig())
+	if err != nil {
+		return err
+	}
+	nad := &unstructured.Unstructured{
+		Object: map[string]any{
+			"apiVersion": "k8s.cni.cncf.io/v1",
+			"kind":       "NetworkAttachmentDefinition",
+			"metadata": map[string]any{
+				"name":      kubeVirtHuaweiPlaceholderNAD,
+				"namespace": n.Namespace,
+				"labels":    map[string]any{"kne/topologyOwner": n.Namespace},
+			},
+			"spec": map[string]any{"config": string(config)},
+		},
+	}
+	resource := dc.Resource(networkAttachmentDefinitionGVR).Namespace(n.Namespace)
+	if _, err := resource.Create(ctx, nad, metav1.CreateOptions{}); err != nil {
+		if !apierrors.IsAlreadyExists(err) {
+			return err
+		}
+		existing, getErr := resource.Get(ctx, kubeVirtHuaweiPlaceholderNAD, metav1.GetOptions{})
+		if getErr != nil {
+			return getErr
+		}
+		if current, _, _ := unstructured.NestedString(existing.Object, "spec", "config"); current == string(config) {
+			return nil
+		}
+		if err := unstructured.SetNestedField(existing.Object, string(config), "spec", "config"); err != nil {
+			return err
+		}
+		if _, err := resource.Update(ctx, existing, metav1.UpdateOptions{}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/topo/node/kubevirt_huawei_test.go b/topo/node/kubevirt_huawei_test.go
