+
+// checkCrossNamespaceLinks refuses a cross-namespace link on gRPC inter-node
+// wires. The gRPC wire is keyed by pod name, so a peer in another namespace
+// cannot be addressed by it. VXLAN carries these links (patches/meshnet-cni
+// 0023 has the same refusal).
+func checkCrossNamespaceLinks(localNs string, links []*mpb.Link, linkType string) error {
+	if linkType != wireutil.INTER_NODE_LINK_GRPC {
+		return nil
+	}
+	for _, link := range links {
+		if peerNs := wireutil.PeerNamespace(localNs, link.GetPeerNamespace()); peerNs != localNs {
+			return fmt.Errorf("link %d (%s): cross-namespace link to %s/%s needs VXLAN inter-node links, not GRPC", link.GetUid(), link.GetLocalIntf(), peerNs, link.GetPeerPod())
+		}
+	}
+	return nil
+}
diff --git a/third_party/meshnet/plugin/peer_namespace_test.go b/third_party/meshnet/plugin/peer_namespace_test.go
new file mode 100644
index 0000000..faddadf
--- /dev/null
+++ b/third_party/meshnet/plugin/peer_namespace_test.go
@@ -0,0 +1,34 @@
+package main
+
+import (
+	"testing"
+
+	mpb "github.com/openconfig/kne/third_party/meshnet/daemon/proto/meshnet/v1beta1"
+	"github.com/openconfig/kne/third_party/meshnet/utils/wireutil"
+)
+
+// The requirement: a cross-namespace link is accepted on VXLAN inter-node
+// links and refused on gRPC inter-node links. A same-namespace link is never
+// refused.
+func TestCheckCrossNamespaceLinks(t *testing.T) {
+	cross := []*mpb.Link{{Uid: 1, PeerPod: "b", LocalIntf: "eth1", PeerNamespace: "sandbox-x"}}
+	same := []*mpb.Link{{Uid: 2, PeerPod: "c", LocalIntf: "eth2"}}
+	cases := []struct {
+		name     string
+		links    []*mpb.Link
+		linkType string
+		wantErr  bool
+	}{
+		{name: "cross-ns on VXLAN is allowed", links: cross, linkType: wireutil.INTER_NODE_LINK_VXLAN},
+		{name: "cross-ns on GRPC is refused", links: cross, linkType: wireutil.INTER_NODE_LINK_GRPC, wantErr: true},
+		{name: "same-ns on GRPC is allowed", links: same, linkType: wireutil.INTER_NODE_LINK_GRPC},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			err := checkCrossNamespaceLinks("lab-a", tc.links, tc.linkType)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("checkCrossNamespaceLinks = %v, wantErr=%v", err, tc.wantErr)
+			}
+		})
+	}
+}
diff --git a/third_party/meshnet/utils/wireutil/peer_namespace.go b/third_party/meshnet/utils/wireutil/peer_namespace.go
new file mode 100644
index 0000000..6360f5c
--- /dev/null
+++ b/third_party/meshnet/utils/wireutil/peer_namespace.go
@@ -0,0 +1,27 @@
+package wireutil
+
+// PeerNamespace is the namespace the link's peer Topology lives in: the
+// declared peer namespace, or the local one when none is declared. Every link
+// KNE generates is same-namespace, so for those this is the local namespace.
+func PeerNamespace(localNs, declaredPeerNs string) string {
+	if declaredPeerNs == "" {
+		return localNs
+	}
+	return declaredPeerNs
+}
+
+// LinkKeyNamespace is the namespace string both ends of a link feed into the
+// VNI. For a same-namespace link it is that namespace, so every existing wire
+// keeps its VNI. A cross-namespace link is declared once in each namespace,
+// and each end only knows its own side, so the key is the ordered pair. Both
+// ends then derive the same VNI without coordinating.
+func LinkKeyNamespace(localNs, declaredPeerNs string) string {
+	peerNs := PeerNamespace(localNs, declaredPeerNs)
+	if peerNs == localNs {
+		return localNs
+	}
+	if peerNs < localNs {
+		return peerNs + "/" + localNs
+	}
+	return localNs + "/" + peerNs
+}
diff --git a/third_party/meshnet/utils/wireutil/peer_namespace_test.go b/third_party/meshnet/utils/wireutil/peer_namespace_test.go
new file mode 100644
index 0000000..bed443c
--- /dev/null
+++ b/third_party/meshnet/utils/wireutil/peer_namespace_test.go
@@ -0,0 +1,26 @@
+package wireutil
+
+import "testing"
+
+// The requirement: a same-namespace link keeps its namespace as the VNI key
+// (existing wires do not move), and a cross-namespace link gets the same key
+// from either end.
+func TestPeerNamespaceAndLinkKey(t *testing.T) {
+	if got := PeerNamespace("lab-a", ""); got != "lab-a" {
+		t.Fatalf("undeclared peer ns = %q, want the local ns", got)
+	}
+	if got := PeerNamespace("lab-a", "sandbox-x"); got != "sandbox-x" {
+		t.Fatalf("declared peer ns = %q", got)
+	}
+	if got := LinkKeyNamespace("lab-a", ""); got != "lab-a" {
+		t.Fatalf("same-ns key = %q, want lab-a unchanged", got)
+	}
+	ab := LinkKeyNamespace("lab-a", "sandbox-x")
+	ba := LinkKeyNamespace("sandbox-x", "lab-a")
+	if ab != ba {
+		t.Fatalf("the two ends derive different keys: %q vs %q", ab, ba)
+	}
+	if ab == "lab-a" || ab == "sandbox-x" {
+		t.Fatalf("cross-ns key %q collapses to one namespace", ab)
+	}
+}
