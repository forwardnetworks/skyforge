diff --git a/third_party/meshnet/daemon/meshnet/node_identity.go b/third_party/meshnet/daemon/meshnet/node_identity.go
new file mode 100644
index 0000000..568df08
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/node_identity.go
@@ -0,0 +1,19 @@
+package meshnet
+
+import "context"
+
+// adoptNodeIdentity sets this daemon's VTEP identity from the node's declaration:
+// nodeIP is the address the plugin writes into status.src_ip for this node, and
+// nodeIntf is the declared underlay interface (empty on an unlabelled node).
+// Both are read by reconcilePodLinksInternal, which skips every pod whose
+// status.src_ip differs from nodeIP. Called once from New, before the reconcile
+// loop starts. A labelled node that cannot be read fails the daemon start.
+func (m *Meshnet) adoptNodeIdentity(ctx context.Context) error {
+	id, intf, err := m.resolveNodeIdentity(ctx)
+	if err != nil {
+		return err
+	}
+	m.nodeIP = id
+	m.nodeIntf = intf
+	return nil
+}
diff --git a/third_party/meshnet/daemon/meshnet/node_identity_test.go b/third_party/meshnet/daemon/meshnet/node_identity_test.go
new file mode 100644
index 0000000..ef8ff8d
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/node_identity_test.go
@@ -0,0 +1,47 @@
+package meshnet
+
+import (
+	"context"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes/fake"
+)
+
+// A labelled node's daemon must adopt the labelled interface's address as its
+// nodeIP, because the plugin writes that address into status.src_ip. Before this
+// was wired, nodeIP stayed HOST_IP and every reconcile skipped every pod.
+func TestAdoptNodeIdentityLabelledUsesDeclaredInterface(t *testing.T) {
+	InitLogger()
+	t.Setenv("NODE_NAME", "n1")
+	t.Setenv("HOST_IP", "172.18.0.11")
+	t.Setenv("MESHNET_FABRIC_MTU", "8950")
+	node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n1", Labels: map[string]string{
+		fabricMTULabel:         "8950",
+		underlayInterfaceLabel: "lo", // present on every host; its IPv4 is 127.0.0.1 and MTU is above 9000
+	}}}
+	m := &Meshnet{kClient: fake.NewSimpleClientset(node)}
+	if err := m.adoptNodeIdentity(context.Background()); err != nil {
+		t.Fatalf("adoptNodeIdentity: %v", err)
+	}
+	if m.nodeIP != "127.0.0.1" || m.nodeIntf != "lo" {
+		t.Fatalf("labelled identity = (%q, %q), want (127.0.0.1, lo): HOST_IP would be 172.18.0.11", m.nodeIP, m.nodeIntf)
+	}
+}
+
+func TestAdoptNodeIdentityUnlabelledKeepsHostIP(t *testing.T) {
+	InitLogger()
+	t.Setenv("NODE_NAME", "n2")
+	t.Setenv("HOST_IP", "172.18.0.12")
+	t.Setenv("HOST_INTF", "")
+	t.Setenv("MESHNET_FABRIC_MTU", "8950")
+	node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n2"}}
+	m := &Meshnet{kClient: fake.NewSimpleClientset(node)}
+	if err := m.adoptNodeIdentity(context.Background()); err != nil {
+		t.Fatalf("adoptNodeIdentity: %v", err)
+	}
+	if m.nodeIP != "172.18.0.12" || m.nodeIntf != "" {
+		t.Fatalf("unlabelled identity = (%q, %q), want (172.18.0.12, \"\")", m.nodeIP, m.nodeIntf)
+	}
+}
diff --git a/third_party/meshnet/daemon/meshnet/status_retry.go b/third_party/meshnet/daemon/meshnet/status_retry.go
new file mode 100644
index 0000000..97abeeb
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/status_retry.go
@@ -0,0 +1,33 @@
+package meshnet
+
+import (
+	"time"
+
+	"k8s.io/apimachinery/pkg/util/wait"
+	"k8s.io/client-go/util/retry"
+)
+
+// statusWriteBackoff bounds the retry of every Topology status write: SetAlive,
+// Skip, SkipReverse, clearPodAliveStatus and updatePlumbingErrorStatus. Each of
+// these reads the Topology, changes it and updates it, so a write that loses the
+// race to another writer of the same Topology (its peer's daemon, the plugin's
+// DEL, or this daemon's own reconcile) gets a 409 Conflict.
+//
+// retry.DefaultRetry allows 5 attempts 10ms apart. Under churn (pods force-deleted
+// and re-created in a loop) that is exhausted: a 10-pod, 3-round churn on a
+// three-node kind cluster produced 3034 Conflicts in 3169 Topology writes and 343
+// failed SetAlive calls, and each failed SetAlive fails the pod's CNI ADD. This
+// policy allows 12 attempts with growing, jittered waits (about 0.9s worst case
+// without jitter) so contended writes converge.
+var statusWriteBackoff = wait.Backoff{
+	Steps:    12,
+	Duration: 5 * time.Millisecond,
+	Factor:   1.6,
+	Jitter:   0.5,
+}
+
+// retryStatusWrite runs fn with statusWriteBackoff, retrying while it returns a
+// Conflict.
+func retryStatusWrite(fn func() error) error {
+	return retry.RetryOnConflict(statusWriteBackoff, fn)
+}
diff --git a/third_party/meshnet/daemon/meshnet/status_retry_test.go b/third_party/meshnet/daemon/meshnet/status_retry_test.go
new file mode 100644
index 0000000..86217aa
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/status_retry_test.go
@@ -0,0 +1,68 @@
+package meshnet
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+
+	toplogyv1client "github.com/openconfig/kne/third_party/meshnet/api/clientset/v1beta1"
+	topologyv1 "github.com/openconfig/kne/third_party/meshnet/api/types/v1beta1"
+	mpb "github.com/openconfig/kne/third_party/meshnet/daemon/proto/meshnet/v1beta1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	dfake "k8s.io/client-go/dynamic/fake"
+	"k8s.io/client-go/rest"
+	clienttesting "k8s.io/client-go/testing"
+)
+
+// conflictFirst makes the first n Topology updates fail with 409 Conflict, the
+// way a write that loses the race to another writer of the same Topology does.
+func conflictFirst(t *testing.T, n int32) (*Meshnet, *int32) {
+	InitLogger()
+	t.Helper()
+	cs, err := toplogyv1client.NewForConfig(&rest.Config{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	topo := &topologyv1.Topology{ObjectMeta: metav1.ObjectMeta{Name: "p1", Namespace: "default"}}
+	dc := dfake.NewSimpleDynamicClient(topologyv1.Scheme, topo)
+	var updates int32
+	dc.PrependReactor("update", "topologies", func(a clienttesting.Action) (bool, runtime.Object, error) {
+		if atomic.AddInt32(&updates, 1) <= n {
+			return true, nil, apierrors.NewConflict(schema.GroupResource{Group: "networkop.co.uk", Resource: "topologies"}, "p1", errors.New("the object has been modified"))
+		}
+		return false, nil, nil
+	})
+	cs.SetDynamicClient(dc.Resource(toplogyv1client.GVR()))
+	m := &Meshnet{tClient: cs, reconcileQueue: NewReconcileQueue(0)}
+	return m, &updates
+}
+
+// A SetAlive that loses six consecutive races must still land. retry.DefaultRetry
+// (5 attempts) gives up on the sixth, which the churn measurement reproduced as
+// failed pod ADDs.
+func TestSetAliveSurvivesSixConsecutiveConflicts(t *testing.T) {
+	m, updates := conflictFirst(t, 6)
+	resp, err := m.SetAlive(context.Background(), &mpb.Pod{Name: "p1", KubeNs: "default", SrcIp: "10.0.0.1", NetNs: "/var/run/netns/x", ContainerId: "c"})
+	if err != nil || resp == nil || !resp.Response {
+		t.Fatalf("SetAlive after 6 conflicts: resp=%v err=%v (updates attempted=%d)", resp, err, atomic.LoadInt32(updates))
+	}
+	if got := atomic.LoadInt32(updates); got != 7 {
+		t.Fatalf("update attempts = %d, want 7 (6 conflicts then 1 success)", got)
+	}
+}
+
+// The policy is bounded: a writer that never wins gets an error, not a spin.
+func TestSetAliveGivesUpAfterBoundedConflicts(t *testing.T) {
+	m, updates := conflictFirst(t, 1000)
+	resp, err := m.SetAlive(context.Background(), &mpb.Pod{Name: "p1", KubeNs: "default", SrcIp: "10.0.0.1", NetNs: "/var/run/netns/x", ContainerId: "c"})
+	if err == nil || (resp != nil && resp.Response) {
+		t.Fatalf("SetAlive with unbounded conflicts: resp=%v err=%v, want an error", resp, err)
+	}
+	if got := atomic.LoadInt32(updates); got != int32(statusWriteBackoff.Steps) {
+		t.Fatalf("update attempts = %d, want %d (the policy's steps)", got, statusWriteBackoff.Steps)
+	}
+}
