From: Craig Johnson <1545411+captainpacket@users.noreply.github.com>
Date: Mon, 2 Nov 2026 09:50:05 -0600
Subject: [PATCH] service: the per-node lab Service is ClusterIP, not
 LoadBalancer

SKYFORGE-SPECIFIC: platform behaviour; not for upstream.

---
diff --git a/topo/node/node.go b/topo/node/node.go
index 4ebe83b..0a78bbc 100644
--- a/topo/node/node.go
+++ b/topo/node/node.go
@@ -1272,6 +1272,10 @@ func k8sServiceType(t tpb.Service_Type) corev1.ServiceType {
 	}
 }
 
+// nodeServiceType is the Kubernetes type of the per-node service-<node> Service: the group that
+// k8sServiceType maps to LoadBalancer (an unset type or LOAD_BALANCER). SKYFORGE-SPECIFIC: see CreateService.
+const nodeServiceType = corev1.ServiceTypeClusterIP
+
 func serviceNameForType(nodeName string, svcType corev1.ServiceType) string {
 	switch svcType {
 	case corev1.ServiceTypeNodePort:
@@ -1378,12 +1382,22 @@ func (n *Impl) CreateService(ctx context.Context) (rErr error) {
 			},
 		}
 		if st == corev1.ServiceTypeLoadBalancer {
-			// Do not allocate a NodePort for this LoadBalancer. MetalLB
-			// or the equivalent load balancer should handle exposing this service.
-			// Large topologies may try to allocate more NodePorts than are
-			// supported in default clusters.
-			// https://kubernetes.io/docs/concepts/services-networking/service/#load-balancer-nodeport-allocation
-			s.Spec.AllocateLoadBalancerNodePorts = pointer.Bool(false)
+			// SKYFORGE-SPECIFIC: the per-node service-<node> Service is ClusterIP, not LoadBalancer.
+			// Lab nodes are reached only from inside the cluster (the netlab runtime, napalm/scrapligo,
+			// the the collector collector over management, the portal proxies), always as
+			// service-<node>.<ns>.svc or its ClusterIP; jump servers cover reach from outside. No
+			// LoadBalancer IP pool matches lab Services, so a LoadBalancer here never got an address
+			// (cilium.io/IPAMRequestSatisfied=False no_pool on every lab Service, measured 2026-11-02),
+			// and checkServiceStatus waited for one that never came. The name, the kne-service label,
+			// the ClusterIP and the ports are unchanged, so every consumer reads the same Service.
+			s.Spec.Type = nodeServiceType
+			for i := range s.Spec.Ports {
+				if s.Spec.Ports[i].NodePort != 0 {
+					log.Warningf("Node %s: dropping node_port %d on service port %d; service-%s is ClusterIP (declare type NODE_PORT for a NodePort)",
+						n.Name(), s.Spec.Ports[i].NodePort, s.Spec.Ports[i].Port, n.Name())
+					s.Spec.Ports[i].NodePort = 0
+				}
+			}
 			s.Labels["kne-service"] = "true"
 		}
 		sS, err := n.KubeClient.CoreV1().Services(n.Namespace).Create(ctx, s, metav1.CreateOptions{})
