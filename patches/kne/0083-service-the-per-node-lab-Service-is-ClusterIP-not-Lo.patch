@@ -1,12 +1,57 @@
 package topo
 
 import (
+	"context"
 	"testing"
 	"time"
 
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
 	corev1 "k8s.io/api/core/v1"
+	kfake "k8s.io/client-go/kubernetes/fake"
+	"k8s.io/client-go/rest"
 )
 
+// SKYFORGE-SPECIFIC: the per-node Service that CreateService builds must count as ready without a
+// LoadBalancer ingress. No IP pool serves lab Services on this platform, so while it was a LoadBalancer,
+// checkServiceStatus could never see it ready and held kne create for the rest of its timeout.
+func TestCreatedNodeServiceIsReadyWithoutLoadBalancerIngress(t *testing.T) {
+	ctx := context.Background()
+	n := &node.Impl{
+		Namespace:  "test",
+		KubeClient: kfake.NewSimpleClientset(),
+		RestConfig: &rest.Config{},
+		Proto: &tpb.Node{
+			Name:   "r1",
+			Vendor: tpb.Vendor(1001),
+			Services: map[uint32]*tpb.Service{
+				22:  {Name: "ssh", Inside: 22},
+				161: {Name: "snmp", Inside: 161},
+			},
+		},
+	}
+	if err := n.CreateService(ctx); err != nil {
+		t.Fatalf("CreateService() failed: %v", err)
+	}
+	svcs, err := n.Services(ctx)
+	if err != nil {
+		t.Fatalf("Services() failed: %v", err)
+	}
+	if len(svcs) != 1 || svcs[0].Name != "service-r1" {
+		t.Fatalf("want exactly service-r1, got %d service(s): %v", len(svcs), svcs)
+	}
+	if !isServiceReady(svcs[0]) {
+		t.Fatalf("service-r1 (type %s, no load balancer ingress) is not ready; kne create would wait for an address that never comes", svcs[0].Spec.Type)
+	}
+	m := map[uint32]*tpb.Service{}
+	if err := populateServiceMap(svcs[0], m); err != nil {
+		t.Fatalf("populateServiceMap() (kne show) failed on service-r1: %v", err)
+	}
+	if got := m[22].GetType(); got != tpb.Service_CLUSTER_IP {
+		t.Fatalf("kne show reports service-r1 port 22 as %v, want CLUSTER_IP", got)
+	}
+}
