diff --git a/third_party/meshnet/daemon/meshnet/underlay_contract.go b/third_party/meshnet/daemon/meshnet/underlay_contract.go
new file mode 100644
index 0000000..707881d
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/underlay_contract.go
@@ -0,0 +1,103 @@
+package meshnet
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/openconfig/kne/third_party/meshnet/utils/wireutil"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+// Node underlay contract (M0012, patches/meshnet-cni 0012).
+//
+// A node that advertises a jumbo fabric through two labels sources its VXLAN
+// endpoint from the labelled interface, and fails closed if that interface
+// cannot carry the fabric. Nodes without the labels keep HOST_INTF and HOST_IP.
+// Production uses the labels: the bootstrap patches label the jumbo nodes
+// (deploy/bootstrap/00-talos/patches/meshnet-jumbo-*.yaml), and the server's
+// placement counts the labelled nodes (kne_vxlan_deterministic.go).
+const (
+	fabricMTULabel         = "skyforge.example.com/meshnet-fabric-mtu"
+	underlayInterfaceLabel = "skyforge.example.com/meshnet-underlay-interface"
+	vxlanIPv4Overhead      = 50
+)
+
+// declaredUnderlayContract returns the interface and the minimum interface MTU
+// a node's labels require. advertised is false for an unlabelled node. An error
+// means the labels are present but wrong, and the caller must fail closed.
+func declaredUnderlayContract(labels map[string]string, configuredMTU int) (intf string, requiredMTU int, advertised bool, err error) {
+	rawMTU := strings.TrimSpace(labels[fabricMTULabel])
+	if rawMTU == "" {
+		return "", 0, false, nil
+	}
+	declared, convErr := strconv.Atoi(rawMTU)
+	if convErr != nil || declared <= wireutil.DefaultFabricMTU {
+		return "", 0, true, fmt.Errorf("node label %s=%q is not a jumbo fabric MTU greater than %d", fabricMTULabel, rawMTU, wireutil.DefaultFabricMTU)
+	}
+	if declared < configuredMTU {
+		return "", 0, true, fmt.Errorf("node advertises meshnet fabric MTU %d below configured MTU %d", declared, configuredMTU)
+	}
+	nodeIntf := strings.TrimSpace(labels[underlayInterfaceLabel])
+	if nodeIntf == "" {
+		return "", 0, true, fmt.Errorf("node advertising %s=%d must also set %s", fabricMTULabel, declared, underlayInterfaceLabel)
+	}
+	return nodeIntf, declared + vxlanIPv4Overhead, true, nil
+}
+
+// nodeSourceForCurrentNode returns the VTEP source IP and interface for this
+// node. Labels win when present; otherwise HOST_IP and HOST_INTF are used as
+// before.
+func (m *Meshnet) nodeSourceForCurrentNode(ctx context.Context) (string, string, error) {
+	legacyIP := os.Getenv("HOST_IP")
+	legacyIntf := os.Getenv("HOST_INTF")
+	nodeName := strings.TrimSpace(os.Getenv("NODE_NAME"))
+	if nodeName == "" || m == nil || m.kClient == nil {
+		return legacyIP, legacyIntf, nil
+	}
+	node, err := m.kClient.CoreV1().Nodes().Get(ctx, nodeName, metav1.GetOptions{})
+	if err != nil {
+		return "", "", fmt.Errorf("read meshnet underlay declaration for node %q: %w", nodeName, err)
+	}
+	fabricMTU, err := wireutil.FabricMTUFromEnv()
+	if err != nil {
+		return "", "", err
+	}
+	nodeIntf, requiredMTU, advertised, err := declaredUnderlayContract(node.Labels, fabricMTU)
+	if err != nil {
+		return "", "", fmt.Errorf("node %q meshnet underlay contract: %w", nodeName, err)
+	}
+	if !advertised {
+		return legacyIP, legacyIntf, nil
+	}
+	iface, err := net.InterfaceByName(nodeIntf)
+	if err != nil {
+		return "", "", fmt.Errorf("node %q advertised meshnet underlay interface %q: %w", nodeName, nodeIntf, err)
+	}
+	if iface.MTU < requiredMTU {
+		return "", "", fmt.Errorf("node %q advertised meshnet underlay interface %q has MTU %d, need at least %d", nodeName, nodeIntf, iface.MTU, requiredMTU)
+	}
+	sourceIP, err := nodeSourceFromInterface(iface)
+	if err != nil {
+		return "", "", fmt.Errorf("node %q advertised meshnet underlay interface %q: %w", nodeName, nodeIntf, err)
+	}
+	mnetdLogger.Infof("Using declared meshnet underlay for node %s: interface=%s source_ip=%s", nodeName, nodeIntf, sourceIP)
+	return sourceIP, nodeIntf, nil
+}
+
+// nodeSourceFromInterface returns the first IPv4 address of the interface.
+func nodeSourceFromInterface(iface *net.Interface) (string, error) {
+	addrs, err := iface.Addrs()
+	if err != nil {
+		return "", err
+	}
+	for _, a := range addrs {
+		if ipn, ok := a.(*net.IPNet); ok && ipn.IP.To4() != nil {
+			return ipn.IP.To4().String(), nil
+		}
+	}
+	return "", fmt.Errorf("interface %s has no IPv4 address", iface.Name)
+}
diff --git a/third_party/meshnet/daemon/meshnet/underlay_contract_test.go b/third_party/meshnet/daemon/meshnet/underlay_contract_test.go
new file mode 100644
index 0000000..2763b1b
--- /dev/null
+++ b/third_party/meshnet/daemon/meshnet/underlay_contract_test.go
@@ -0,0 +1,74 @@
+package meshnet
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	fakekube "k8s.io/client-go/kubernetes/fake"
+)
+
+// The contract (M0012): no labels is the legacy path; a jumbo declaration with
+// its interface is advertised at declared+50; a bad or under-configured
+// declaration is an error (fail closed).
+func TestDeclaredUnderlayContract(t *testing.T) {
+	cases := []struct {
+		name       string
+		labels     map[string]string
+		configured int
+		wantIntf   string
+		wantMTU    int
+		advertised bool
+		wantErr    bool
+	}{
+		{name: "unlabelled node is legacy", labels: map[string]string{}, configured: 8950, advertised: false},
+		{name: "jumbo with interface is advertised", labels: map[string]string{fabricMTULabel: "8950", underlayInterfaceLabel: "bond0"}, configured: 8950, wantIntf: "bond0", wantMTU: 9000, advertised: true},
+		{name: "fabric label without interface is an error", labels: map[string]string{fabricMTULabel: "8950"}, configured: 8950, advertised: true, wantErr: true},
+		{name: "non-jumbo label is an error", labels: map[string]string{fabricMTULabel: "1450", underlayInterfaceLabel: "bond0"}, configured: 1450, advertised: true, wantErr: true},
+		{name: "label below configured fabric MTU is an error", labels: map[string]string{fabricMTULabel: "8000", underlayInterfaceLabel: "bond0"}, configured: 8950, advertised: true, wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			intf, mtu, adv, err := declaredUnderlayContract(tc.labels, tc.configured)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("err = %v, wantErr %v", err, tc.wantErr)
+			}
+			if adv != tc.advertised {
+				t.Fatalf("advertised = %v, want %v", adv, tc.advertised)
+			}
+			if !tc.wantErr && tc.advertised && (intf != tc.wantIntf || mtu != tc.wantMTU) {
+				t.Fatalf("(intf, mtu) = (%q, %d), want (%q, %d)", intf, mtu, tc.wantIntf, tc.wantMTU)
+			}
+		})
+	}
+}
+
+// Fail closed in practice: a labelled node whose interface does not exist on
+// this host must make the lookup fail, not fall back to HOST_INTF.
+func TestNodeSourceFailsClosedOnMissingDeclaredInterface(t *testing.T) {
+	t.Setenv("NODE_NAME", "n1")
+	t.Setenv("HOST_INTF", "eth0")
+	node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n1", Labels: map[string]string{
+		fabricMTULabel: "8950", underlayInterfaceLabel: "no-such-iface9",
+	}}}
+	m := &Meshnet{kClient: fakekube.NewSimpleClientset(node)}
+	_, _, err := m.nodeSourceForCurrentNode(context.Background())
+	if err == nil || !strings.Contains(err.Error(), "no-such-iface9") {
+		t.Fatalf("nodeSourceForCurrentNode err = %v, want a failure naming the declared interface", err)
+	}
+}
+
+// An unlabelled node keeps HOST_IP/HOST_INTF.
+func TestNodeSourceUnlabelledKeepsLegacyEnv(t *testing.T) {
+	t.Setenv("NODE_NAME", "n2")
+	t.Setenv("HOST_IP", "172.18.0.9")
+	t.Setenv("HOST_INTF", "eth0")
+	node := &corev1.Node{ObjectMeta: metav1.ObjectMeta{Name: "n2"}}
+	m := &Meshnet{kClient: fakekube.NewSimpleClientset(node)}
+	ip, intf, err := m.nodeSourceForCurrentNode(context.Background())
+	if err != nil || ip != "172.18.0.9" || intf != "eth0" {
+		t.Fatalf("legacy source = %q %q %v", ip, intf, err)
+	}
+}
