+// xrdSharedMemoryVolumeName is the pod-unique name of the memory-backed volume
+// mounted at /dev/shmem for XRd nodes.
+func xrdSharedMemoryVolumeName(topologyName string) string {
+	return fmt.Sprintf("%s-shmem-mount", topologyName)
+}
+
+// attachXRdSharedMemory mounts a memory-backed emptyDir at /dev/shmem.
+//
+// WHY. XR keeps its shared memory under /dev/shmem, and Cisco's
+// /pkg/etc/ds_startup.sh is what is supposed to put that somewhere with room:
+//
+//	# Create /dev/shmem if it doesn't exist yet.
+//	ln -nsf /dev/shm /dev/shmem
+//
+// That line only works if nothing has created /dev/shmem yet. XR's own
+// libraries reach for /dev/shmem while the node boots -- libbag_schema writes
+// bagschema.0, the ltrace infrastructure creates a subdirectory per process --
+// and when one of them gets there first, /dev/shmem already exists as a real
+// directory. `ln -nsf` cannot replace a directory with a symlink, so it drops
+// a nested /dev/shmem/shm -> /dev/shm INSIDE it and returns success. The real
+// shared memory stays where it landed: on /dev.
+//
+// /dev is the 64 MiB tmpfs the OCI runtime gives every container. bagschema.0
+// alone is 22 MiB and ltrace holds hundreds of subdirectories, so /dev reaches
+// 100% in about thirty seconds and every shared-memory fault after that is
+// SIGBUS. processmgr respawns and dies roughly twice a second, fills the disk
+// with core dumps, and the node never reaches runtime-ready -- while the pod
+// still reports Running, which is why this reads as a hang rather than a crash.
+//
+// MEASURED on node-a, 2026-08-14, a pod that lost the race:
+//
+//	/dev/shmem      drwxrwxrwx   <- real directory, not a symlink
+//	/dev/shmem/shm  -> /dev/shm  <- the nested link the `ln` left behind
+//	/dev            64M   64M  0  100%
+//	/dev/shm        756G  580M     1%   <- the space XR should have been using
+//	xr_cli "show version"  ->  Bus error (core dumped), exit 135
+//
+// and, on the same node and image digest, six pods that won it: /dev/shmem ->
+// /dev/shm, /dev at 1%, xr_cli exit 0.
+//
+// WHAT THIS DOES. Mounting the volume removes the race rather than trying to
+// win it. The kubelet establishes the mount before the container's first
+// instruction, so /dev/shmem is a large tmpfs no matter which XR library gets
+// there first, and no startup ordering can change that. Cisco's `ln` still runs
+// and still leaves the harmless nested /dev/shmem/shm behind; what changes is
+// that the bytes land on a tmpfs sized by the pod instead of on the 64 MiB /dev.
+//
+// WHY NOT ENLARGE /dev INSTEAD. /dev's size comes from the OCI runtime spec --
+// runc hardcodes size=65536k -- and neither Kubernetes nor containerd exposes a
+// per-pod knob for it. Raising it means a node-level containerd/Talos change
+// that widens the tmpfs for every container on every node, which is a
+// cluster-wide blast radius to fix one NOS. It also would not fix the defect:
+// XR's shared memory would still be on the wrong filesystem, still capped by a
+// number somebody guessed, and the same failure would return with a larger
+// topology. This keeps the change inside the pod that has the problem.
+func attachXRdSharedMemory(spec *corev1.PodSpec, topologyName string) {
+	if spec == nil {
+		return
+	}
+	name := xrdSharedMemoryVolumeName(topologyName)
+	for _, volume := range spec.Volumes {
+		if volume.Name == name {
+			return
+		}
+	}
+	spec.Volumes = append(spec.Volumes, corev1.Volume{
+		Name: name,
+		VolumeSource: corev1.VolumeSource{
+			EmptyDir: &corev1.EmptyDirVolumeSource{Medium: corev1.StorageMediumMemory},
+		},
+	})
+	for i := range spec.Containers {
+		spec.Containers[i].VolumeMounts = append(spec.Containers[i].VolumeMounts, corev1.VolumeMount{
+			Name:      name,
+			ReadOnly:  false,
+			MountPath: xrdSharedMemoryPath,
+		})
+	}
+}
+
+func attachIOLReadinessProbes(container *corev1.Container) {
+	if container == nil {
+		return
+	}
+	healthCommand := []string{
+		"/bin/sh",
+		"-c",
+		"IOL_READY_MIN_SECONDS=5 IOL_READY_REQUIRE_RELAY=true IOL_READY_REQUIRE_MGMT_PING=false IOL_READY_REQUIRE_MGMT_SSH=false IOL_READY_REQUIRE_PROXY=false /usr/local/bin/iol-ready-check",
+	}
+	readinessCommand := []string{
+		"/bin/sh",
+		"-c",
+		"IOL_READY_MIN_SECONDS=30 IOL_READY_REQUIRE_RELAY=true IOL_READY_REQUIRE_MGMT_PING=true IOL_READY_REQUIRE_MGMT_SSH=false IOL_READY_REQUIRE_PROXY=false /usr/local/bin/iol-ready-check",
+	}
+	livenessCommand := []string{
+		"/bin/sh",
+		"-c",
+		"IOL_READY_MIN_SECONDS=0 IOL_READY_REQUIRE_RELAY=true IOL_READY_REQUIRE_MGMT_PING=false IOL_READY_REQUIRE_MGMT_SSH=false IOL_READY_REQUIRE_PROXY=false /usr/local/bin/iol-ready-check",
+	}
+	container.StartupProbe = iolProbe(healthCommand, 0, 10, 45, 60)
+	container.ReadinessProbe = iolProbe(readinessCommand, 0, 10, 45, 3)
+	// EXPERIMENTAL (2026-09-20): the ongoing SSH/proxy checks on readiness and
+	// liveness were dropped entirely to test whether the readiness/liveness
+	// probes' continuous SSH connects to IOS's own live control plane
+	// (169.254.100.2:22 + the local proxy's second forked connect, every 10s
+	// readiness / every 30s liveness, indefinitely for the pod's whole life)
+	// are causing the periodic self-inflicted BGP TCP resets on demo-lab's
+	// LHR site. The doc's own stated intent (components/docs/kne-iol-image.md)
+	// was to guard the BOOT-TIME iouyap/relay management-veth race, not to
+	// keep hammering a live control plane forever -- this is a targeted
+	// regression test of that theory, not the final design. If it fixes the
+	// flap, the SSH/proxy check needs to come back scoped to an actual
+	// startup window (a one-shot verification, or a much longer period after
+	// first success), not as a perpetual 10s/30s liveness/readiness gate.
+	container.LivenessProbe = iolProbe(livenessCommand, 0, 30, 45, 6)
+}
