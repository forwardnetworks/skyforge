+	xrdProxyBootstrap   = `#!/bin/bash
+set -eu
+# --- skyforge: XRd VRF-netns L3VPN control-plane permit (the XRd analog of the
+# arista-ceoslab-operator 0010 fix). XRd's control-plane image realizes every routing
+# VRF as a Linux network namespace: the global table is "global-vrf", management is
+# "vrf-management", and each configured L3VPN VRF becomes its OWN netns holding that
+# VRF's data interfaces. XR keeps a control-plane firewall in each netns whose INPUT
+# policy DROPs traffic arriving on the VRF data interfaces, so CE<->PE VRF eBGP / VRF
+# OSPF / VRF ICMP is dropped before XR ever sees it (the netns IpInReceives counter
+# climbs while IpInDelivers stays 0 — a netfilter drop, not a checksum/offload problem;
+# the on-wire L4 checksums are correct). The KNE-injected port-proxy below only reaches
+# loopback ports INSIDE vrf-management/global-vrf and never clears this data-plane wall.
+# Mirror the trusted-fabric permit into EVERY netns: global-vrf clears plain (non-VRF)
+# fabric eBGP too, and each vrf-* clears its L3VPN CE<->PE sessions. Enumerate the data
+# interfaces from WITHIN each netns (ip -o link show is netns-correct) and re-assert in a
+# retry loop, because the VRF netns appear only after XR finishes processing the VRF
+# config — slightly after the fabric interfaces are wired. Delete-then-insert keeps
+# exactly one ACCEPT per interface ahead of the DROP.
+apply_vrf_dataplane_permits() {
+  for _ns in $(ip netns list 2>/dev/null | sed 's/ .*//'); do
+    [ -n "${_ns}" ] || continue
+    for _ifc in $(ip netns exec "${_ns}" ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | sed 's/@.*//'); do
+      case "${_ifc}" in ""|lo) continue ;; esac
+      ip netns exec "${_ns}" iptables -D INPUT -i "${_ifc}" -j ACCEPT 2>/dev/null || true
+      ip netns exec "${_ns}" iptables -I INPUT 1 -i "${_ifc}" -j ACCEPT 2>/dev/null || true
+    done
+  done
+}
+vrfpidfile=/run/kne-xrd-vrf-permit.pid
+if ! { [ -s "$vrfpidfile" ] && kill -0 "$(cat "$vrfpidfile")" 2>/dev/null; }; then
+  printf 'vrf-permit launch: pid=%s netns=%s\n' "$$" "$(readlink /proc/$$/ns/net 2>/dev/null || true)" >> /run/kne-xrd-vrf-permit.log
+  (
+    i=0
+    max=${SKYFORGE_XRD_VRF_PERMIT_RETRIES:-180}
+    interval=${SKYFORGE_XRD_VRF_PERMIT_INTERVAL:-5}
+    while [ "$i" -lt "$max" ]; do
+      apply_vrf_dataplane_permits
+      i=$((i + 1))
+      sleep "$interval"
+    done
+  ) >> /run/kne-xrd-vrf-permit.log 2>&1 &
+  echo $! > "$vrfpidfile"
+fi
+pidfile=` + xrdProxyPIDFile + `
+if [ -s "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
+  printf 'proxy already running: pid=%s netns=%s\n' "$(cat "$pidfile")" "$(readlink /proc/$$/ns/net 2>/dev/null || true)" >> ` + xrdProxyLogFile + `
+  exit 0
+fi
+printf 'proxy launch: pid=%s netns=%s\n' "$$" "$(readlink /proc/$$/ns/net 2>/dev/null || true)" >> ` + xrdProxyLogFile + `
+nohup python3 - <<'PY' >>` + xrdProxyLogFile + ` 2>&1 &
+import os
+import socket
+import subprocess
+import threading
+import time
+import traceback
+
+TARGET_NAMESPACES = ("vrf-management", "global-vrf")
+TCP_TARGET_PORTS = (22, 57400)
+UDP_TARGET_PORTS = (161,)
+
+
+def log(message):
+    print(message, flush=True)
+
+
+def wait_namespace(port, protocol):
+    while True:
+        for ns in TARGET_NAMESPACES:
+            if protocol == "tcp":
+                rc = subprocess.run(
+                    ["ip", "netns", "exec", ns, "nc", "-z", "-w", "1", "127.0.0.1", str(port)],
+                    stdout=subprocess.DEVNULL,
+                    stderr=subprocess.DEVNULL,
+                    check=False,
+                ).returncode
+                if rc == 0:
+                    log(f"proxy target ready: namespace={ns} port={port} protocol={protocol}")
+                    return ns
+            else:
+                probe = subprocess.run(
+                    ["ip", "netns", "exec", ns, "ss", "-lun"],
+                    stdout=subprocess.PIPE,
+                    stderr=subprocess.DEVNULL,
+                    check=False,
+                    text=True,
+                )
+                if probe.returncode == 0 and f":{port}" in probe.stdout:
+                    log(f"proxy target ready: namespace={ns} port={port} protocol={protocol}")
+                    return ns
+        time.sleep(1)
+
+
+def pipe_sock_to_proc(sock, proc):
+    try:
+        while True:
+            data = sock.recv(65536)
+            if not data:
+                break
+            if proc.stdin is None:
+                break
+            os.write(proc.stdin.fileno(), data)
+    except Exception:
+        pass
+    finally:
+        if proc.stdin is not None:
+            try:
+                proc.stdin.close()
+            except Exception:
+                pass
+
+
+def pipe_proc_to_sock(proc, sock):
+    try:
+        if proc.stdout is None:
+            return
+        while True:
+            data = os.read(proc.stdout.fileno(), 65536)
+            if not data:
+                break
+            sock.sendall(data)
+    except Exception:
+        pass
+    finally:
+        try:
+            sock.close()
+        except Exception:
+            pass
+
+
+def serve(port):
+    ns = wait_namespace(port, "tcp")
+    listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    try:
+        listener.bind(("0.0.0.0", port))
+    except OSError as exc:
+        log(f"bind failed: port={port} error={exc}")
+        return
+    listener.listen(32)
+    log(f"proxy listener ready: port={port} namespace={ns} protocol=tcp")
+    while True:
+        conn, _ = listener.accept()
+        proc = subprocess.Popen(
+            ["ip", "netns", "exec", ns, "nc", "127.0.0.1", str(port)],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            bufsize=0,
+        )
+        threading.Thread(target=pipe_sock_to_proc, args=(conn, proc), daemon=True).start()
+        threading.Thread(target=pipe_proc_to_sock, args=(proc, conn), daemon=True).start()
+
+
+UDP_PROXY = r"""
+import socket
+import sys
+
+port = int(sys.argv[1])
+payload = sys.stdin.buffer.read()
+s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+s.settimeout(3)
+s.sendto(payload, ("127.0.0.1", port))
+try:
+    data, _ = s.recvfrom(65535)
+    sys.stdout.buffer.write(data)
+except Exception:
+    pass
+"""
+
+
+def serve_udp(port):
+    ns = wait_namespace(port, "udp")
+    listener = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+    try:
+        listener.bind(("0.0.0.0", port))
+    except OSError as exc:
+        log(f"bind failed: port={port} protocol=udp error={exc}")
+        return
+    log(f"proxy listener ready: port={port} namespace={ns} protocol=udp")
+    while True:
+        payload, addr = listener.recvfrom(65535)
+        proc = subprocess.Popen(
+            ["ip", "netns", "exec", ns, "python3", "-c", UDP_PROXY, str(port)],
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            bufsize=0,
+        )
+        try:
+            response, _ = proc.communicate(payload, timeout=4)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+            continue
+        if response:
+            listener.sendto(response, addr)
+
+
+for target_port in TCP_TARGET_PORTS:
+    threading.Thread(target=serve, args=(target_port,), daemon=True).start()
+for target_port in UDP_TARGET_PORTS:
+    threading.Thread(target=serve_udp, args=(target_port,), daemon=True).start()
+
+try:
+    while True:
+        time.sleep(3600)
+except Exception:
+    traceback.print_exc()
+    raise
+PY
