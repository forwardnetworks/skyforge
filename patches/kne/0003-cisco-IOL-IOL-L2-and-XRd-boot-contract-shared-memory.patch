+func (n *Node) createXRDRelayScript(ctx context.Context) (*corev1.Volume, *corev1.VolumeMount, error) {
+	cm := &corev1.ConfigMap{
+		ObjectMeta: metav1.ObjectMeta{
+			Name: fmt.Sprintf("%s-xrd-script", n.Proto.Name),
+		},
+		Data: map[string]string{
+			xrdProxyScriptFile: xrdProxyBootstrap,
+		},
+	}
+	if _, err := n.KubeClient.CoreV1().ConfigMaps(n.Namespace).Create(ctx, cm, metav1.CreateOptions{}); err != nil {
+		return nil, nil, err
+	}
+	vol := &corev1.Volume{
+		Name: xrdProxyVolumeName,
+		VolumeSource: corev1.VolumeSource{
+			ConfigMap: &corev1.ConfigMapVolumeSource{
+				LocalObjectReference: corev1.LocalObjectReference{
+					Name: cm.Name,
+				},
+				DefaultMode: pointer.Int32(0o755),
+			},
+		},
+	}
+	vm := &corev1.VolumeMount{
+		Name:      xrdProxyVolumeName,
+		MountPath: xrdEveryBootScript,
+		SubPath:   xrdProxyScriptFile,
+		ReadOnly:  true,
+	}
+	return vol, vm, nil
+}
