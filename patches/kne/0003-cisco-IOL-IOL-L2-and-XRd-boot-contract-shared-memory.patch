+// TestXRDBootstrapAppliesVRFPermits asserts that the XRd every-boot relay script the
+// cisco node injects also clears the VRF-netns L3VPN control-plane wall. XRd realizes
+// each routing VRF as a Linux network namespace (global-vrf, vrf-management, and one
+// per configured L3VPN VRF), each with an INPUT-policy DROP in front of its data
+// interfaces that silently drops CE<->PE VRF eBGP/OSPF/ICMP. The port-proxy only reaches
+// loopback ports inside the netns; the trusted-fabric permit must be mirrored into every
+// netns (the XRd analog of arista-ceoslab-operator patch 0010).
+func TestXRDBootstrapAppliesVRFPermits(t *testing.T) {
+	for _, want := range []string{
+		"apply_vrf_dataplane_permits",
+		"ip netns list",
+		`ip netns exec "${_ns}" ip -o link show`,
+		`ip netns exec "${_ns}" iptables -I INPUT 1 -i "${_ifc}" -j ACCEPT`,
+		"/run/kne-xrd-vrf-permit.pid",
+	} {
+		if !strings.Contains(xrdProxyBootstrap, want) {
+			t.Fatalf("xrd every-boot bootstrap missing %q; VRF-netns L3VPN permit not applied:\n%s", want, xrdProxyBootstrap)
+		}
+	}
+}
