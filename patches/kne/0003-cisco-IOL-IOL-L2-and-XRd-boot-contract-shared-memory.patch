@@ -0,0 +1,35 @@
+package cisco
+
+import (
+	"context"
+	"testing"
+
+	tpb "github.com/openconfig/kne/proto/topo"
+	"github.com/openconfig/kne/topo/node"
+	"k8s.io/client-go/kubernetes/fake"
+	"k8s.io/client-go/rest"
+)
+
+func TestStatusPendingWithoutKubeVirtLauncherPod(t *testing.T) {
+	n := &Node{
+		Impl: &node.Impl{
+			Namespace:  "test",
+			KubeClient: fake.NewSimpleClientset(),
+			RestConfig: &rest.Config{},
+			Proto: &tpb.Node{
+				Name:   "n1",
+				Vendor: tpb.Vendor_CISCO,
+				Model:  ModelNXOS,
+				Config: &tpb.Config{Image: "registry.example.com/skyforge/kubevirt/nxos:9.3.8"},
+			},
+		},
+	}
+
+	got, err := n.Status(context.Background())
+	if err != nil {
+		t.Fatalf("Status() failed: %v", err)
+	}
+	if got != node.StatusPending {
+		t.Fatalf("Status() got %v, want %v", got, node.StatusPending)
+	}
+}
diff --git a/topo/node/cisco/xrd_default_route_test.go b/topo/node/cisco/xrd_default_route_test.go
new file mode 100644
index 0000000..0099ac0
--- /dev/null
+++ b/topo/node/cisco/xrd_default_route_test.go
@@ -0,0 +1,120 @@
+package cisco
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+)
+
+// TestXRDDefaultRouteScriptExecution runs the real init script with a fake `ip` that reports a
+// default gateway, the same contract upstream's TestXRDInitScriptExecution used. The routes must be
+// appended to the copied first-boot config.
+func TestXRDDefaultRouteScriptExecution(t *testing.T) {
+	tmpDir := t.TempDir()
+	srcDir := filepath.Join(tmpDir, "config-src")
+	dstDir := filepath.Join(tmpDir, "config-dst")
+	binDir := filepath.Join(tmpDir, "bin")
+	for _, d := range []string{srcDir, binDir} {
+		if err := os.MkdirAll(d, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	const configFile = "startup.cfg"
+	if err := os.WriteFile(filepath.Join(srcDir, configFile), []byte("hostname xrd\n"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	ipScript := `#!/bin/sh
+if [ "$1" = "-4" ] && [ "$2" = "route" ]; then
+  echo "default via 10.244.0.1 dev eth0"
+elif [ "$1" = "-6" ] && [ "$2" = "route" ]; then
+  echo "default via 2001:db8::1 dev eth0"
+fi
+`
+	if err := os.WriteFile(filepath.Join(binDir, "ip"), []byte(ipScript), 0755); err != nil {
+		t.Fatal(err)
+	}
+
+	cmd := exec.Command("/bin/sh", "-c", xrdDefaultRouteScript(srcDir, dstDir, configFile))
+	cmd.Env = append(os.Environ(), "PATH="+binDir+":"+os.Getenv("PATH"))
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("script execution failed: %v, output: %s", err, out)
+	}
+	content, err := os.ReadFile(filepath.Join(dstDir, configFile))
+	if err != nil {
+		t.Fatalf("failed to read generated config: %v", err)
+	}
+	got := string(content)
+	for _, want := range []string{
+		"hostname xrd",
+		"router static\n address-family ipv4 unicast\n  0.0.0.0/0 10.244.0.1\n !\n!\n",
+		"router static\n address-family ipv6 unicast\n  ::/0 2001:db8::1\n !\n!\n",
+	} {
+		if !strings.Contains(got, want) {
+			t.Errorf("generated config missing %q; got:\n%s", want, got)
+		}
+	}
+}
+
+// TestAttachXRdDefaultRouteWiresSeedThroughInit checks the pod wiring: the XR container must read the
+// first-boot file from the emptyDir the init container fills, and the init container must read the
+// seed volume.
+func TestAttachXRdDefaultRouteWiresSeedThroughInit(t *testing.T) {
+	pod := &corev1.Pod{Spec: corev1.PodSpec{
+		Volumes: []corev1.Volume{{Name: "startup-config-volume"}},
+		Containers: []corev1.Container{{
+			Name: "xrd",
+			VolumeMounts: []corev1.VolumeMount{{
+				Name: "startup-config-volume", MountPath: xrdFirstBootConfig, SubPath: "startup.cfg", ReadOnly: true,
+			}},
+		}},
+	}}
+	if err := attachXRdDefaultRoute(pod, "init:test", "startup.cfg"); err != nil {
+		t.Fatalf("attachXRdDefaultRoute() failed: %v", err)
+	}
+	if len(pod.Spec.InitContainers) != 1 || pod.Spec.InitContainers[0].Name != "xrd-default-route" {
+		t.Fatalf("init containers = %#v, want xrd-default-route", pod.Spec.InitContainers)
+	}
+	init := pod.Spec.InitContainers[0]
+	if init.Image != "init:test" || len(init.VolumeMounts) != 2 ||
+		init.VolumeMounts[0].Name != "startup-config-volume" || init.VolumeMounts[0].MountPath != xrdDefaultRouteSrcDir ||
+		init.VolumeMounts[1].Name != xrdDefaultRouteVolumeName || init.VolumeMounts[1].MountPath != xrdDefaultRouteDstDir {
+		t.Fatalf("init container wiring = %#v", init)
+	}
+	if !strings.Contains(init.Args[0], "/config-dst/startup.cfg") || !strings.Contains(init.Args[0], "0.0.0.0/0") {
+		t.Fatalf("init script does not write the routed config: %s", init.Args[0])
+	}
+	xr := pod.Spec.Containers[0].VolumeMounts[0]
+	if xr.Name != xrdDefaultRouteVolumeName || xr.MountPath != xrdFirstBootConfig || xr.SubPath != "startup.cfg" {
+		t.Fatalf("XR first-boot mount = %#v, want the emptyDir subPath", xr)
+	}
+	foundVol := false
+	for _, v := range pod.Spec.Volumes {
+		if v.Name == xrdDefaultRouteVolumeName && v.EmptyDir != nil {
+			foundVol = true
+		}
+	}
+	if !foundVol {
+		t.Fatalf("pod volumes = %#v, want emptyDir %s", pod.Spec.Volumes, xrdDefaultRouteVolumeName)
+	}
+}
+
+// TestAttachXRdDefaultRouteNoSeedWritesRoutesOnly covers the no-config path: upstream still wrote a
+// routes-only first-boot file, so the init container gets only the /config-dst mount and XR mounts it.
+func TestAttachXRdDefaultRouteNoSeedWritesRoutesOnly(t *testing.T) {
+	pod := &corev1.Pod{Spec: corev1.PodSpec{Containers: []corev1.Container{{Name: "xrd"}}}}
+	if err := attachXRdDefaultRoute(pod, "init:test", "startup.cfg"); err != nil {
+		t.Fatalf("attachXRdDefaultRoute() failed: %v", err)
+	}
+	if len(pod.Spec.InitContainers) != 1 || len(pod.Spec.InitContainers[0].VolumeMounts) != 1 ||
+		pod.Spec.InitContainers[0].VolumeMounts[0].MountPath != xrdDefaultRouteDstDir {
+		t.Fatalf("init container = %#v, want one /config-dst mount", pod.Spec.InitContainers)
+	}
+	if len(pod.Spec.Containers[0].VolumeMounts) != 1 || pod.Spec.Containers[0].VolumeMounts[0].MountPath != xrdFirstBootConfig ||
+		pod.Spec.Containers[0].VolumeMounts[0].SubPath != "startup.cfg" {
+		t.Fatalf("XR mounts = %#v, want the routes-only file at %s", pod.Spec.Containers[0].VolumeMounts, xrdFirstBootConfig)
+	}
+}
