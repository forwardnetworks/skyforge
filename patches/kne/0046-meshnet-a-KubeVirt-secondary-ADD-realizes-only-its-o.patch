diff --git a/third_party/meshnet/plugin/kubevirt_slot_test.go b/third_party/meshnet/plugin/kubevirt_slot_test.go
new file mode 100644
index 0000000..ce07233
--- /dev/null
+++ b/third_party/meshnet/plugin/kubevirt_slot_test.go
@@ -0,0 +1,39 @@
+package main
+
+import (
+	"testing"
+
+	mpb "github.com/openconfig/kne/third_party/meshnet/daemon/proto/meshnet/v1beta1"
+)
+
+// Requirement: a KubeVirt secondary ADD for slot B must carry only slot B, so
+// the daemon does not create slot A (which Multus would then find occupied by
+// the sibling ADD). The NAD asks for pod24bf8ab8fca.
+func TestKubeVirtSlotLinksPicksOnlyRequestedSlot(t *testing.T) {
+	links := []*mpb.Link{
+		{LocalIntf: "pod151b6d47576", PeerPod: "h1"},
+		{LocalIntf: "pod24bf8ab8fca", PeerPod: "h2"},
+	}
+	got, err := kubeVirtSlotLinks(links, "pod24bf8ab8fca")
+	if err != nil {
+		t.Fatalf("kubeVirtSlotLinks: %v", err)
+	}
+	if len(got) != 1 || got[0].LocalIntf != "pod24bf8ab8fca" || got[0].PeerPod != "h2" {
+		t.Fatalf("want only slot pod24bf8ab8fca (peer h2), got %+v", got)
+	}
+}
+
+// Requirement: a NAD that names a slot the topology does not declare fails
+// closed rather than realizing every link.
+func TestKubeVirtSlotLinksFailsClosedWithoutMatch(t *testing.T) {
+	links := []*mpb.Link{{LocalIntf: "pod151b6d47576"}}
+	if _, err := kubeVirtSlotLinks(links, "pod99999999999"); err == nil {
+		t.Fatalf("want an error for an unmatched requested interface")
+	}
+}
+
+func TestKubeVirtSlotLinksRequiresRequestedInterface(t *testing.T) {
+	if _, err := kubeVirtSlotLinks([]*mpb.Link{{LocalIntf: "pod151b6d47576"}}, "  "); err == nil {
+		t.Fatalf("want an error when the requested interface is empty")
+	}
+}
diff --git a/third_party/meshnet/plugin/meshnet.go b/third_party/meshnet/plugin/meshnet.go
index d47df24..d6c8a4d 100644
--- a/third_party/meshnet/plugin/meshnet.go
+++ b/third_party/meshnet/plugin/meshnet.go
@@ -81,6 +81,29 @@ func alignResultInterfaceName(result *types100.Result, ifName string) {
 	result.Interfaces[len(result.Interfaces)-1].Name = ifName
 }
 
+// kubeVirtSlotLinks returns the one meshnet link a KubeVirt secondary ADD
+// requests: the link whose LocalIntf is the requested interface. The ADD
+// realizes and waits for that slot only. Sibling slots stay unrealized until
+// their own ADDs, because Multus fails an ADD whose interface already exists.
+// No matching link is an error (fail closed), as the NAD names a slot the
+// topology does not declare.
+func kubeVirtSlotLinks(links []*mpb.Link, ifName string) ([]*mpb.Link, error) {
+	ifName = strings.TrimSpace(ifName)
+	if ifName == "" {
+		return nil, fmt.Errorf("kubevirt secondary ADD has no requested interface")
+	}
