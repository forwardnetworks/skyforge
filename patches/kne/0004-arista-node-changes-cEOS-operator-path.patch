@@ -237,6 +256,26 @@ func (n *Node) CreateCRD(ctx context.Context) error {
 	if linksLen > math.MaxInt32 {
 		return fmt.Errorf("links count %d out of range (max: %d)", linksLen, math.MaxInt32)
 	}
+	env := map[string]string{}
+	for k, v := range config.GetEnv() {
+		env[k] = v
+	}
+	for _, key := range []string{
+		"SKYFORGE_KNE_NODE_SELECTOR_JSON",
+		"KNE_NODE_SELECTOR_HOSTNAME",
+		"SKYFORGE_KNE_ALLOW_TAINTED_NODES",
+		"SKYFORGE_KNE_TAINT_KEY",
