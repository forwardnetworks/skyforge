+		"SKYFORGE_KNE_TAINT_EFFECT",
+		"SKYFORGE_KNE_PRIORITY_CLASS_NAME",
+	} {
+		if value := strings.TrimSpace(os.Getenv(key)); value != "" {
+			env[key] = value
+		}
+	}
