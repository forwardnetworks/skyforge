+func TestVethEndpointLockKeysAreSymmetricAndOverlapSafe(t *testing.T) {
+	a := VEth{NsName: "/var/run/netns/a", LinkName: "eth1"}
+	b := VEth{NsName: "/var/run/netns/b", LinkName: "eth2"}
+	c := VEth{NsName: "/var/run/netns/c", LinkName: "eth3"}
+
+	forward := vethEndpointLockKeys(a, b)
+	reverse := vethEndpointLockKeys(b, a)
+	if !reflect.DeepEqual(forward, reverse) {
+		t.Fatalf("opposite wire directions lock different keys: %q vs %q", forward, reverse)
+	}
+
+	overlap := vethEndpointLockKeys(a, c)
+	shared := false
+	for _, left := range forward {
+		for _, right := range overlap {
+			if left == right {
+				shared = true
+			}
+		}
+	}
+	if !shared {
+		t.Fatalf("wires sharing endpoint %v do not share a lock: %q vs %q", a, forward, overlap)
+	}
+}
+
+func TestVethWireCreateLockSerializesOverlapOnly(t *testing.T) {
+	t.Setenv("KOKO_VETH_LOCK_DIR", t.TempDir())
+	a := VEth{NsName: "/var/run/netns/a", LinkName: "eth1"}
+	b := VEth{NsName: "/var/run/netns/b", LinkName: "eth2"}
+	c := VEth{NsName: "/var/run/netns/c", LinkName: "eth3"}
+	d := VEth{NsName: "/var/run/netns/d", LinkName: "eth4"}
+
+	unlockFirst := acquireVethWireCreateLock(a, b)
+	firstHeld := true
+	defer func() {
+		if firstHeld {
+			unlockFirst()
+		}
+	}()
+	acquiredOverlap := make(chan struct{})
+	go func() {
+		unlock := acquireVethWireCreateLock(b, c)
+		unlock()
+		close(acquiredOverlap)
+	}()
+	acquiredDisjoint := make(chan struct{})
+	go func() {
+		unlock := acquireVethWireCreateLock(c, d)
+		unlock()
+		close(acquiredDisjoint)
+	}()
+
+	select {
+	case <-acquiredDisjoint:
+	case <-time.After(time.Second):
+		t.Fatal("disjoint wire was blocked by another wire's endpoint locks")
+	}
+	select {
+	case <-acquiredOverlap:
+		t.Fatal("overlapping wire acquired while the shared endpoint was locked")
+	case <-time.After(100 * time.Millisecond):
+	}
+
+	unlockFirst()
+	firstHeld = false
+	select {
+	case <-acquiredOverlap:
+	case <-time.After(time.Second):
+		t.Fatal("overlapping wire did not acquire after the shared endpoint was unlocked")
+	}
+}
+
