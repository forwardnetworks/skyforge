 api/koko_kubevirt_adopt_test.go |   2 +-
 api/koko_vxlan_underlay.go      | 213 ++++++++++++++++++++++++++
 api/koko_vxlan_underlay_test.go | 256 ++++++++++++++++++++++++++++++++
 4 files changed, 499 insertions(+), 26 deletions(-)
 create mode 100644 api/koko_vxlan_underlay.go
