+func TestKernelUnboundOccupantIsSeenByTheConflictScan(t *testing.T) {
+	requireThrowawayNetNS(t)
+	kernelUnderlay(t)
+	// An unbound wire (the new form) already holds VNI 4244.
+	occupant := &netlink.Vxlan{LinkAttrs: netlink.LinkAttrs{Name: "kokovx2"}, VxlanId: 4244,
+		SrcAddr: net.ParseIP("10.99.0.1"), Group: net.ParseIP("10.99.0.3"), Port: 4789}
+	if err := netlink.LinkAdd(occupant); err != nil {
+		t.Fatal(err)
+	}
+	defer netlink.LinkDel(occupant)
+	// The kernel refuses the same VNI again, bound or not...
+	err := AddVxLanInterface(VxLan{ParentIF: "kokoul0", ID: 4244, IPAddr: net.ParseIP("10.98.0.2"), MTU: 8950}, "kokovx3")
+	if err == nil {
+		if l, e := netlink.LinkByName("kokovx3"); e == nil {
+			_ = netlink.LinkDel(l)
+		}
+		t.Fatalf("kernel accepted a bound vxlan reusing an unbound vxlan's VNI; the conflict model is wrong")
+	}
+	t.Logf("kernel: %v", err)
+	// ...so the scan that decides whether koko may clean it up must see it.
+	got, scanErr := hostVxLanConflicts(VxLan{ParentIF: "kokoul0", ID: 4244, IPAddr: net.ParseIP("10.99.0.2")}, "kokovx3")
+	if scanErr != nil || len(got) != 1 || got[0].Attrs().Name != "kokovx2" {
+		t.Fatalf("conflict scan must name the unbound occupant, got %d (%v)", len(got), scanErr)
+	}
+}
