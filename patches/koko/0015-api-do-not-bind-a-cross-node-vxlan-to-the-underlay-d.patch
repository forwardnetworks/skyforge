+func TestMTUToSetNeverLowersAnOwnerRaisedMTU(t *testing.T) {
+	cases := []struct {
+		current, want, set int
+		change             bool
+	}{
+		{1450, 8950, 8950, true}, // stale low: heal upward
+		{1500, 8950, 8950, true}, // kernel default: heal upward
+		{8950, 8950, 0, false},   // already right
+		{10240, 8950, 0, false},  // NOS raised: leave it
+		{8950, 0, 0, false},      // caller asked for the default (1450): do not lower
+		{1400, 0, 1450, true},    // below the default: raise to it
+	}
+	for _, c := range cases {
+		set, change := mtuToSet(c.current, c.want)
+		if set != c.set || change != c.change {
+			t.Errorf("mtuToSet(%d,%d) = (%d,%v), want (%d,%v)", c.current, c.want, set, change, c.set, c.change)
+		}
+	}
+}
