+func TestSameVxLanSpecAdoptsBothFormsSoRolloutRebuildsNothing(t *testing.T) {
+	desired := VxLan{ParentIF: "eno1", ID: 12345, IPAddr: net.ParseIP("192.0.2.10"), MTU: 8950}
+	legacy := &netlink.Vxlan{LinkAttrs: netlink.LinkAttrs{MTU: 8950}, VxlanId: 12345, VtepDevIndex: 7, Group: net.ParseIP("192.0.2.10")}
