+func TestKernelUnprovenPathKeepsTheBoundForm(t *testing.T) {
+	requireThrowawayNetNS(t)
+	kernelUnderlay(t)
+	// 10.98.0.2 has no route at all: the path cannot be proven.
+	vx := VxLan{ParentIF: "kokoul0", ID: 4243, IPAddr: net.ParseIP("10.98.0.2"), MTU: 8950}
+	if err := AddVxLanInterface(vx, "kokovx1"); err != nil {
