+func TestIsConflictingHostVxLanSeesAnUnboundOccupant(t *testing.T) {
+	// The kernel rejects a second IPv4 vxlan with the same VNI+port whether or
+	// not either is bound (vxlan_vni_in_use ignores the lower device), so an
+	// unbound occupant is a conflict for a bound request and vice versa.
+	unbound := &netlink.Vxlan{LinkAttrs: netlink.LinkAttrs{Name: "left"}, VxlanId: 12345, Port: 4789}
+	if !isConflictingHostVxLan(unbound, 12345, 7, 4789, "koko-new") {
+		t.Fatalf("an unbound vxlan holding the VNI must be seen as the conflict it is")
+	}
+	if isConflictingHostVxLan(unbound, 12346, 7, 4789, "koko-new") {
+		t.Fatalf("a different VNI is not a conflict")
+	}
+}
