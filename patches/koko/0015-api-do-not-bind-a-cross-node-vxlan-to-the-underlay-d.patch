+// --- kernel positive control ----------------------------------------------
+//
+// Runs only with CAP_NET_ADMIN in a THROWAWAY netns; run it as
+//
+//	unshare -rn go test ./api -run TestKernel -v
+//
+// It creates a 9000-MTU dummy underlay and asks koko for a wire at 8950,
+// then does what cEOS does: raise the wire to 10240. Before this change
+// koko built the wire bound to the underlay and the raise failed EINVAL.
+
+func requireThrowawayNetNS(t *testing.T) {
+	t.Helper()
+	if os.Getenv("KOKO_KERNEL_TESTS") != "1" {
+		t.Skip("kernel test: set KOKO_KERNEL_TESTS=1 and run under `unshare -rn` (it creates links in the current netns)")
+	}
+}
+
+func kernelUnderlay(t *testing.T) netlink.Link {
+	t.Helper()
+	runtime.LockOSThread()
+	ul := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: "kokoul0", MTU: 9000}}
+	if err := netlink.LinkAdd(ul); err != nil {
+		t.Fatalf("add underlay: %v", err)
+	}
+	link, _ := netlink.LinkByName("kokoul0")
+	addr, _ := netlink.ParseAddr("10.99.0.1/24")
+	if err := netlink.AddrAdd(link, addr); err != nil {
+		t.Fatalf("addr: %v", err)
+	}
+	if err := netlink.LinkSetUp(link); err != nil {
+		t.Fatalf("up: %v", err)
+	}
+	t.Cleanup(func() { _ = netlink.LinkDel(link) })
+	return link
+}
+
+func TestKernelUnboundWireAcceptsANOSRaisedMTU(t *testing.T) {
+	requireThrowawayNetNS(t)
+	kernelUnderlay(t)
+	vx := VxLan{ParentIF: "kokoul0", ID: 4242, IPAddr: net.ParseIP("10.99.0.2"), MTU: 8950}
+	if err := AddVxLanInterface(vx, "kokovx0"); err != nil {
+		t.Fatalf("create: %v", err)
+	}
+	link, err := netlink.LinkByName("kokovx0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer netlink.LinkDel(link)
+	v := link.(*netlink.Vxlan)
+	t.Logf("created: mtu=%d vtepdev=%d local=%v", v.MTU, v.VtepDevIndex, v.SrcAddr)
+	if v.MTU != 8950 {
+		t.Fatalf("wire must come up at the fabric MTU 8950, got %d", v.MTU)
+	}
+	if err := netlink.LinkSetMTU(link, 10240); err != nil {
+		t.Fatalf("NOS raise to 10240 refused (this is the sjc wanleaf VRF failure): %v", err)
+	}
+}
