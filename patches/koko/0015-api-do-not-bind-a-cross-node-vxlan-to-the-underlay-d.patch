+	}
+	link, _ := netlink.LinkByName("kokovx1")
+	defer netlink.LinkDel(link)
+	v := link.(*netlink.Vxlan)
+	ul, _ := netlink.LinkByName("kokoul0")
+	if v.VtepDevIndex != ul.Attrs().Index || v.MTU != 8950 {
+		t.Fatalf("want legacy bound form at 8950, got vtepdev=%d mtu=%d", v.VtepDevIndex, v.MTU)
+	}
+}
