+func hashParts(parts ...string) uint64 {
+	h := fnv.New64a()
+	for _, part := range parts {
+		_, _ = h.Write([]byte(part))
+		_, _ = h.Write([]byte{0})
+	}
+	return h.Sum64()
+}
+
+func vxlanOwnerKey(veth VEth) string {
+	return fmt.Sprintf("%016x", hashParts(veth.NsName, veth.LinkName))
+}
+
+func vxlanSpecKey(vxlan VxLan) string {
+	return fmt.Sprintf("%016x", hashParts(
+		vxlan.ParentIF,
+		fmt.Sprintf("%d", vxlan.ID),
+		vxlan.IPAddr.String(),
+		fmt.Sprintf("%d", normalizedVXLANPort(vxlan.UDPPort)),
+		fmt.Sprintf("%d", vxlan.MTU),
+	))
+}
+
+func vxlanOwnerAlias(veth VEth, vxlan VxLan) string {
+	return fmt.Sprintf("koko:vxlan:%s:%s", vxlanOwnerKey(veth), vxlanSpecKey(vxlan))
+}
+
+func vxlanAliasMatchesOwner(alias, ownerKey string) bool {
+	return strings.HasPrefix(alias, "koko:vxlan:"+ownerKey+":")
+}
+
+func legacyVxlanOwnerAlias(veth VEth, vxlan VxLan) string {
+	return fmt.Sprintf("koko:vxlan:%016x", hashParts(
+		veth.NsName,
+		veth.LinkName,
+		vxlan.ParentIF,
+		fmt.Sprintf("%d", vxlan.ID),
+		vxlan.IPAddr.String(),
+		fmt.Sprintf("%d", normalizedVXLANPort(vxlan.UDPPort)),
+	))
+}
