+func normalizedVXLANPort(port int) int {
+	if port == 0 {
+		return 4789
+	}
+	return port
+}
+
+func sameIP(a, b net.IP) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	return a.Equal(b)
+}
+
+func sameVxLanSpec(existing *netlink.Vxlan, vxlan VxLan, parentIndex int) bool {
+	if existing == nil || existing.Attrs() == nil {
+		return false
+	}
+	if existing.VxlanId != vxlan.ID {
+		return false
+	}
+	if parentIndex > 0 && existing.VtepDevIndex > 0 && existing.VtepDevIndex != parentIndex {
+		return false
+	}
+	if normalizedVXLANPort(existing.Port) != normalizedVXLANPort(vxlan.UDPPort) {
+		return false
+	}
+	if !sameIP(existing.Group, vxlan.IPAddr) {
+		return false
+	}
+	if vxlan.MTU != 0 && existing.Attrs().MTU != 0 && existing.Attrs().MTU != vxlan.MTU {
+		return false
+	}
+	return true
+}
+
+func linkByNameInNS(nsName, linkName string) (netlink.Link, error) {
+	var vethNs ns.NetNS
+	var err error
+	if nsName == "" {
+		if vethNs, err = ns.GetCurrentNS(); err != nil {
+			return nil, err
+		}
+	} else {
+		if vethNs, err = ns.GetNS(nsName); err != nil {
+			return nil, err
+		}
+	}
+	defer vethNs.Close()
+
+	var link netlink.Link
+	err = vethNs.Do(func(_ ns.NetNS) error {
+		link, err = netlink.LinkByName(linkName)
+		return err
+	})
+	return link, err
+}
+
+func ensureExistingVxLan(veth VEth, vxlan VxLan, parentIndex int, ownerKey string) (bool, error) {
+	link, err := linkByNameInNS(veth.NsName, veth.LinkName)
+	if err != nil {
+		if _, notFound := err.(netlink.LinkNotFoundError); notFound {
+			return false, nil
+		}
+		return false, err
+	}
+	existing, ok := link.(*netlink.Vxlan)
+	if !ok {
+		return false, fmt.Errorf("target link %s exists in %s but is not desired vxlan: type=%T", veth.LinkName, veth.NsName, link)
+	}
+	if !sameVxLanSpec(existing, vxlan, parentIndex) {
+		alias := ""
+		if existing.Attrs() != nil {
+			alias = existing.Attrs().Alias
+		}
+		if vxlanAliasMatchesOwner(alias, ownerKey) || alias == legacyVxlanOwnerAlias(veth, vxlan) {
+			logger.Warnf("koko: deleting owned stale vxlan %s in %s alias=%s owner=%s", veth.LinkName, veth.NsName, alias, ownerKey)
+			if err := removeLinkInNSIfExists(veth.NsName, veth.LinkName); err != nil {
+				return false, err
+			}
+			return false, nil
+		}
+		return false, fmt.Errorf("target link %s exists in %s but vxlan tuple does not match desired owner=%s alias=%s", veth.LinkName, veth.NsName, ownerKey, alias)
+	}
+	if err := configureLinkInNS(veth); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func configureLinkInNS(veth VEth) error {
+	var vethNs ns.NetNS
+	var err error
+	if veth.NsName == "" {
+		if vethNs, err = ns.GetCurrentNS(); err != nil {
+			return err
+		}
+	} else {
+		if vethNs, err = ns.GetNS(veth.NsName); err != nil {
+			return err
+		}
+	}
+	defer vethNs.Close()
+
+	return vethNs.Do(func(_ ns.NetNS) error {
+		link, err := netlink.LinkByName(veth.LinkName)
+		if err != nil {
+			return err
+		}
+		if err := netlink.LinkSetUp(link); err != nil {
+			return err
+		}
+		for i := 0; i < len(veth.IPAddr); i++ {
+			addr := &netlink.Addr{IPNet: &veth.IPAddr[i], Label: ""}
+			if err := netlink.AddrAdd(link, addr); err != nil {
+				if errors.Is(err, syscall.EEXIST) || strings.Contains(err.Error(), "file exists") {
+					continue
+				}
+				return err
+			}
+		}
+		return nil
+	})
+}
+
+func hostVxLanConflicts(vxlan VxLan, requestedName string) ([]*netlink.Vxlan, error) {
+	parentIF, err := netlink.LinkByName(vxlan.ParentIF)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get %s: %w", vxlan.ParentIF, err)
+	}
+	udpPort := normalizedVXLANPort(vxlan.UDPPort)
+	links, err := netlink.LinkList()
+	if err != nil {
+		return nil, err
+	}
+	conflicts := []*netlink.Vxlan{}
+	for _, link := range links {
+		existing, _ := link.(*netlink.Vxlan)
+		if !isConflictingHostVxLan(existing, vxlan.ID, parentIF.Attrs().Index, udpPort, requestedName) {
+			continue
+		}
+		conflicts = append(conflicts, existing)
+	}
+	return conflicts, nil
+}
+
+func removeOwnedConflictingVxLanIfExists(vxlan VxLan, requestedName, ownerKey string) (bool, error) {
+	conflicts, err := hostVxLanConflicts(vxlan, requestedName)
+	if err != nil {
+		return false, err
+	}
+	for _, existing := range conflicts {
+		if existing == nil || existing.Attrs() == nil || !vxlanAliasMatchesOwner(existing.Attrs().Alias, ownerKey) {
+			continue
+		}
+		logger.Warnf(
+			"koko: deleting owned conflicting host vxlan link %s with id=%d parent=%s requested_name=%s requested_peer=%s existing_peer=%s owner=%s alias=%s",
+			existing.Attrs().Name,
+			vxlan.ID,
+			vxlan.ParentIF,
+			requestedName,
+			vxlan.IPAddr.String(),
+			existing.Group.String(),
+			ownerKey,
+			existing.Attrs().Alias,
+		)
+		return true, netlink.LinkDel(existing)
+	}
+	return false, nil
+}
+
+func describeHostVxLanConflicts(vxlan VxLan, requestedName string) string {
+	conflicts, err := hostVxLanConflicts(vxlan, requestedName)
+	if err != nil {
+		return fmt.Sprintf("conflict_scan_error=%v", err)
+	}
+	if len(conflicts) == 0 {
+		return "conflicts=[]"
+	}
+	parts := make([]string, 0, len(conflicts))
+	for _, existing := range conflicts {
+		if existing == nil || existing.Attrs() == nil {
+			continue
+		}
+		parts = append(parts, fmt.Sprintf(
+			"name=%s alias=%s vni=%d parentIndex=%d port=%d peer=%s",
+			existing.Attrs().Name,
+			existing.Attrs().Alias,
+			existing.VxlanId,
+			existing.VtepDevIndex,
+			normalizedVXLANPort(existing.Port),
+			existing.Group.String(),
+		))
+	}
+	return "conflicts=[" + strings.Join(parts, ";") + "]"
+}
+
+func isConflictingHostVxLan(existing *netlink.Vxlan, vni, parentIndex, udpPort int, requestedName string) bool {
+	if existing == nil || existing.Attrs() == nil {
+		return false
+	}
+	if requestedName != "" && existing.Attrs().Name == requestedName {
+		return true
+	}
+	if existing.VxlanId != vni {
+		return false
+	}
+	if existing.VtepDevIndex != parentIndex {
+		return false
+	}
+	if normalizedVXLANPort(existing.Port) != normalizedVXLANPort(udpPort) {
+		return false
+	}
+
+	// Linux rejects duplicate host VXLANs for the same VNI/lower device/port.
+	// Treat that tuple as the ownership key, not the transient staging name.
+	return true
+}
+
+func vxlanLockPaths() []string {
+	if path := strings.TrimSpace(os.Getenv("KOKO_VXLAN_LOCK")); path != "" {
+		return []string{path}
+	}
+	// /opt/cni/bin is a hostPath mounted into meshnetd and is also the host path
+	// used by kubelet when it executes the CNI plugin. /run is container-local
+	// for meshnetd, so it cannot coordinate plugin/daemon VXLAN staging.
+	return []string{"/opt/cni/bin/.koko-vxlan-create.lock", "/var/run/netns/.koko-vxlan-create.lock", "/run/koko-vxlan-create.lock"}
+}
+
+func acquireVXLANCreateLock() func() {
+	vxlanCreateMu.Lock()
+	var lastErr error
+	for _, path := range vxlanLockPaths() {
+		lockFile, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0600)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		if err := syscall.Flock(int(lockFile.Fd()), syscall.LOCK_EX); err != nil {
+			lastErr = err
+			_ = lockFile.Close()
+			continue
+		}
+		return func() {
+			_ = syscall.Flock(int(lockFile.Fd()), syscall.LOCK_UN)
+			_ = lockFile.Close()
+			vxlanCreateMu.Unlock()
+		}
+	}
+	logger.Warnf("koko: continuing without vxlan create file lock: %+v", lastErr)
+	return func() {
+		vxlanCreateMu.Unlock()
+	}
+}
