+package api
+
+import (
+	"net"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+func TestIsConflictingHostVxLanMatchesKernelOwnershipTuple(t *testing.T) {
+	link := &netlink.Vxlan{
+		LinkAttrs:    netlink.LinkAttrs{Name: "meshnet-leftover"},
+		VxlanId:      12345,
+		VtepDevIndex: 7,
+		Port:         4789,
+	}
+
+	if !isConflictingHostVxLan(link, 12345, 7, 4789, "koko-new") {
+		t.Fatalf("expected VXLAN with same VNI, parent and UDP port to conflict regardless of name")
+	}
+}
+
+func TestIsConflictingHostVxLanNormalizesDefaultUDPPort(t *testing.T) {
+	link := &netlink.Vxlan{
+		LinkAttrs:    netlink.LinkAttrs{Name: "meshnet-leftover"},
+		VxlanId:      12345,
+		VtepDevIndex: 7,
+		Port:         0,
+	}
+
+	if !isConflictingHostVxLan(link, 12345, 7, 4789, "koko-new") {
+		t.Fatalf("expected zero existing UDP port to normalize to the VXLAN default port")
+	}
+}
+
+func TestIsConflictingHostVxLanMatchesRequestedStagingName(t *testing.T) {
+	link := &netlink.Vxlan{
+		LinkAttrs:    netlink.LinkAttrs{Name: "koko123"},
+		VxlanId:      1,
+		VtepDevIndex: 2,
+		Port:         4789,
+	}
+
+	if !isConflictingHostVxLan(link, 999, 9, 9999, "koko123") {
+		t.Fatalf("expected requested staging-name collision to conflict")
+	}
+}
+
+func TestIsConflictingHostVxLanIgnoresDifferentTuple(t *testing.T) {
+	link := &netlink.Vxlan{
+		LinkAttrs:    netlink.LinkAttrs{Name: "meshnet-other"},
+		VxlanId:      12345,
+		VtepDevIndex: 7,
+		Port:         4789,
+	}
+
+	if isConflictingHostVxLan(link, 12345, 8, 4789, "koko-new") {
+		t.Fatalf("different parent must not conflict")
+	}
+	if isConflictingHostVxLan(link, 12345, 7, 4790, "koko-new") {
+		t.Fatalf("different UDP port must not conflict")
+	}
+}
+
+func TestSameVxLanSpecMatchesDesiredTuple(t *testing.T) {
+	link := &netlink.Vxlan{
+		LinkAttrs:    netlink.LinkAttrs{Name: "eth1", MTU: 1450},
+		VxlanId:      12345,
+		VtepDevIndex: 7,
+		Port:         0,
+		Group:        net.ParseIP("192.0.2.10"),
+	}
+	desired := VxLan{
+		ParentIF: "breth2",
+		ID:       12345,
+		IPAddr:   net.ParseIP("192.0.2.10"),
+		UDPPort:  4789,
+		MTU:      1450,
+	}
+
+	if !sameVxLanSpec(link, desired, 7) {
+		t.Fatalf("expected VXLAN with same VNI, parent, normalized port, peer, and MTU to match")
+	}
+}
+
+func TestSameVxLanSpecRejectsDifferentPeer(t *testing.T) {
+	link := &netlink.Vxlan{
+		LinkAttrs:    netlink.LinkAttrs{Name: "eth1"},
+		VxlanId:      12345,
+		VtepDevIndex: 7,
+		Port:         4789,
+		Group:        net.ParseIP("192.0.2.10"),
+	}
+	desired := VxLan{
+		ParentIF: "breth2",
+		ID:       12345,
+		IPAddr:   net.ParseIP("192.0.2.11"),
