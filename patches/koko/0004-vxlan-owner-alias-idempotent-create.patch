+func TestVxlanOwnerAliasStableAndSpecific(t *testing.T) {
+	veth := VEth{NsName: "/var/run/netns/cni-a", LinkName: "eth1"}
+	vxlan := VxLan{ParentIF: "breth2", ID: 12345, IPAddr: net.ParseIP("192.0.2.10"), UDPPort: 4789}
+
+	first := vxlanOwnerAlias(veth, vxlan)
+	second := vxlanOwnerAlias(veth, vxlan)
+	if first == "" || first != second {
+		t.Fatalf("owner alias should be stable, got %q and %q", first, second)
+	}
+	ownerKey := vxlanOwnerKey(veth)
+	if !vxlanAliasMatchesOwner(first, ownerKey) {
+		t.Fatalf("owner alias %q should match owner key %q", first, ownerKey)
+	}
+
+	vxlan.IPAddr = net.ParseIP("192.0.2.11")
+	changed := vxlanOwnerAlias(veth, vxlan)
+	if first == changed {
+		t.Fatalf("owner alias must change when desired VXLAN tuple changes")
+	}
+	if !vxlanAliasMatchesOwner(changed, ownerKey) {
+		t.Fatalf("changed spec alias %q should still match owner key %q", changed, ownerKey)
+	}
+}
