 (
   i=0
   max="${SKYFORGE_MGMT_RETURN_ROUTE_RETRIES:-60}"
   interval="${SKYFORGE_MGMT_RETURN_ROUTE_INTERVAL:-5}"
   while [ "${i}" -lt "${max}" ]; do
-    apply_routes
     apply_permits
     i=$((i + 1))
     sleep "${interval}"
   done
-) >/tmp/skyforge-mgmt-return-routes.log 2>&1 &
+) >/tmp/skyforge-mgmt-permits.log 2>&1 &
 `)},
 			},
