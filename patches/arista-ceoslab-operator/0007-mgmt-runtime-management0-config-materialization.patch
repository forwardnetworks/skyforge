+// Faithful-translator boundary: no eth0->ManagementN mapping in the CR means no
+// runtime materialization — the operator must not invent management intent.
+func TestGetPodSeedInitFaithfulWithoutMgmtMapping(t *testing.T) {
+	for name, spec := range map[string]ceoslabv1alpha1.CEosLabDeviceSpec{
+		"no mapping at all": {},
+		"fabric-only mapping": {
+			IntfMapping: map[string]string{"eth1": "Ethernet1"},
+		},
+		"eth0 mapped as fabric": {
+			IntfMapping: map[string]string{"eth0": "Ethernet1"},
+		},
+		"mgmt mapped from non-eth0 device": {
+			// status.podIP belongs to eth0; a Management mapping on another
+			// kernel device is not something the operator can bind the pod IP to.
+			IntfMapping: map[string]string{"eth5": "Management1"},
+		},
+		"kill switch": {
+			IntfMapping: map[string]string{"eth0": "Management0"},
+			EnvVar:      map[string]string{"SKYFORGE_MGMT_RUNTIME_CONFIG": "off"},
+		},
+	} {
+		device := &ceoslabv1alpha1.CEosLabDevice{
+			ObjectMeta: metav1.ObjectMeta{Name: "leaf1", Namespace: "demo"},
+			Spec:       spec,
+		}
+		secretsAndConfigMaps := map[string]client.Object{
+			startupConfigName(device.Name): &corev1.ConfigMap{
+				ObjectMeta: metav1.ObjectMeta{Name: startupConfigName(device.Name)},
+				Data:       map[string]string{"startup-config": "hostname leaf1\n"},
+			},
+		}
+		pod := &corev1.Pod{}
+		if err := getPod(pod, device, secretsAndConfigMaps, true); err != nil {
+			t.Fatalf("%s: getPod() failed: %v", name, err)
+		}
+		seed := pod.Spec.InitContainers[1]
+		for _, e := range seed.Env {
+			if e.Name == "SKYFORGE_MGMT_EOS_INTF" || e.Name == "SKYFORGE_POD_IP" {
+				t.Fatalf("%s: seed container unexpectedly carries mgmt runtime env %q: %#v", name, e.Name, seed.Env)
+			}
+		}
+	}
+}
+
+func TestMgmtRuntimeIntf(t *testing.T) {
+	for want, mapping := range map[string]map[string]string{
+		"Management0": {"eth0": "Management0"},
+		"Management1": {"eth0": "Management1", "eth1": "Ethernet1"},
+	} {
+		device := &ceoslabv1alpha1.CEosLabDevice{Spec: ceoslabv1alpha1.CEosLabDeviceSpec{IntfMapping: mapping}}
+		if got := mgmtRuntimeIntf(device); got != want {
+			t.Fatalf("mgmtRuntimeIntf(%v) = %q, want %q", mapping, got, want)
+		}
+	}
+	for _, mapping := range []map[string]string{
+		nil,
+		{"eth1": "Ethernet1"},
+		{"eth0": "Ethernet0"},
+		{"eth5": "Management0"},
+	} {
+		device := &ceoslabv1alpha1.CEosLabDevice{Spec: ceoslabv1alpha1.CEosLabDeviceSpec{IntfMapping: mapping}}
+		if got := mgmtRuntimeIntf(device); got != "" {
+			t.Fatalf("mgmtRuntimeIntf(%v) = %q, want empty", mapping, got)
+		}
+	}
 }
 
