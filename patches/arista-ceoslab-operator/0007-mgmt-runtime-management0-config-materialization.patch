-func getStartupSeedInitContainer(device *ceoslabv1alpha1.CEosLabDevice) corev1.Container {
+// mgmtRuntimeIntf returns the EOS management interface the CR maps the pod's
+// primary kernel interface (eth0 — the interface that carries status.podIP) to,
+// or "" when the CR does not claim eth0 as a management interface. This is the
+// netlab-authored intent switch: the operator never synthesizes the mapping
+// (see the faithful-translation tests for getJsonIntfMapping); it only
+// materializes runtime facts for a mapping the topology author declared.
+func mgmtRuntimeIntf(device *ceoslabv1alpha1.CEosLabDevice) string {
+	name := device.Spec.IntfMapping["eth0"]
+	if mgmtIntfRe.MatchString(name) {
+		return name
+	}
+	return ""
+}
+
+// mgmtRuntimeConfigEnabled reports whether the startup-config-seed init
+// container should materialize the pod's runtime management identity (pod IP,
+// interface routes, observed MTU) into the persisted startup-config. Requires
+// the CR to map eth0 to a ManagementN interface; per-device kill switch via
+// spec.envvars SKYFORGE_MGMT_RUNTIME_CONFIG=off (no CRD schema change).
+func mgmtRuntimeConfigEnabled(device *ceoslabv1alpha1.CEosLabDevice, envVarsMap map[string]string) bool {
+	if strings.EqualFold(strings.TrimSpace(envVarsMap["SKYFORGE_MGMT_RUNTIME_CONFIG"]), "off") {
+		return false
+	}
+	return mgmtRuntimeIntf(device) != ""
+}
+
+// startupSeedScript is the startup-config-seed init container program. Two jobs:
+//
+//  1. Seed: copy the KNE-rendered startup-config from the configmap into the
+//     per-device PVC once (first boot only) — runtime `write memory` state
+//     persists across pod restarts (patch: startup-config PVC persistence).
+//
+//  2. Materialize runtime management identity (only when the CR maps eth0 to an
+//     EOS management interface — SKYFORGE_MGMT_EOS_INTF set): cEOS treats the
+//     startup-config as authoritative for a claimed management interface and
+//     ENFORCES it at config apply — with no Management0 stanza it strips the
+//     CNI-assigned pod IP and every kernel route, leaving the device dark. The
+//     pod IP only exists at sandbox creation, AFTER the operator rendered this
+//     pod, so the only honest place to bind it into config is here, at pod
+//     start, from the downward API. Append it BETWEEN markers, refreshed every
+//     start (strip-then-append) so a rescheduled pod with a new IP converges
+//     instead of duplicating. Interface-form routes ("ip route <pfx> <MgmtIntf>",
+//     valid EOS grammar: destinations treated as directly connected, resolved by
+//     ARP — which the CNI answers) deliberately embed NO gateway address, so a
+//     stale copy absorbed into the body by `write memory` stays harmless: route
+//     lines are IP-free (set-semantics dedupe) and a later `ip address` replaces
+//     an earlier one on replay. The block is appended LAST so EOS installing the
+//     address/routes also witnesses that the entire seeded config replayed.
+//
+// Address prefix length (canary br1, cEOS 4.34.2f, 2026-07-18): EOS REJECTS a
+// /32 interface address ("% Prefix length must be less than 32") — and a
+// rejected line would abort config replay. The prefix is therefore derived at
+// pod start as the prefix length of the FIRST return CIDR (SKYFORGE_MGMT_RETURN_CIDRS,
+// in order) that CONTAINS the pod IP — e.g. 198.18.0.132 in 198.18.0.0/15 ->
+// "ip address 198.18.0.132/15" (live-validated: accepted, kernel gets
+// "default dev eth0 proto gated scope link src <ip>", SSH/eAPI reachable
+// through the KNE Service). The matched CIDR becomes a CONNECTED subnet once
+// the address is up, so no static twin is emitted for it (avoids
+// static-vs-connected ambiguity); statics are still emitted for the default
+// route and every OTHER return CIDR. If no return CIDR contains the pod IP the
+// fallback is /16 (never /32), with a note on stderr. Containment is pure
+// POSIX/busybox sh: dotted quads to integers, then (ip XOR base) >> (32-plen).
+const startupSeedScript = `set -eu
+active="${SKYFORGE_SEED_ACTIVE_FILE:-/var/run/ceos/startup-active/startup-config}"
+seed="${SKYFORGE_SEED_SOURCE_FILE:-/var/run/ceos/startup-seed/startup-config}"
+mkdir -p "$(dirname "${active}")"
+if [ ! -f "${active}" ]; then cp "${seed}" "${active}"; fi
+if [ -n "${SKYFORGE_MGMT_EOS_INTF:-}" ]; then
+  ip="${SKYFORGE_POD_IP:-}"
+  case "${ip}" in
+  ''|*:*)
+    echo "skyforge-mgmt-runtime: no usable IPv4 pod IP (got '${ip}'); startup-config left untouched" >&2
+    ;;
+  *)
+    mtu="$(cat /sys/class/net/eth0/mtu 2>/dev/null || true)"
+    case "${mtu}" in ''|*[!0-9]*) mtu='' ;; esac
+    if [ -n "${mtu}" ] && [ "${mtu}" -gt 9214 ]; then mtu=9214; fi
+    if [ -n "${mtu}" ] && [ "${mtu}" -lt 68 ]; then mtu=''; fi
+    ip4_to_int() {
+      _oldifs="${IFS}"; IFS=.
+      set -- $1
+      IFS="${_oldifs}"
+      if [ $# -ne 4 ]; then return 0; fi
+      for _o in "$1" "$2" "$3" "$4"; do
+        case "${_o}" in ''|*[!0-9]*) return 0 ;; 0) ;; 0*) return 0 ;; esac
+        if [ "${_o}" -gt 255 ]; then return 0; fi
+      done
+      echo $(( ($1 << 24) | ($2 << 16) | ($3 << 8) | $4 ))
+    }
+    pod_n="$(ip4_to_int "${ip}")"
+    pfx=''
+    addr_cidr=''
+    if [ -n "${pod_n}" ]; then
+      _oldifs="${IFS}"; IFS=','
+      for cidr in ${SKYFORGE_MGMT_RETURN_CIDRS:-}; do
+        cidr="$(printf '%s' "${cidr}" | tr -d '[:space:]')"
+        case "${cidr}" in */*) ;; *) continue ;; esac
+        plen="${cidr#*/}"
+        case "${plen}" in ''|*[!0-9]*) continue ;; esac
+        if [ "${plen}" -lt 1 ] || [ "${plen}" -ge 32 ]; then continue; fi
+        base_n="$(ip4_to_int "${cidr%/*}")"
+        if [ -z "${base_n}" ]; then continue; fi
+        if [ $(( (pod_n ^ base_n) >> (32 - plen) )) -eq 0 ]; then
+          pfx="${plen}"
+          addr_cidr="${cidr}"
+          break
+        fi
+      done
+      IFS="${_oldifs}"
+    fi
+    if [ -z "${pfx}" ]; then
+      pfx=16
+      echo "skyforge-mgmt-runtime: no return CIDR contains pod IP ${ip}; falling back to /${pfx}" >&2
+    fi
+    tmp="${active}.skyforge.$$"
+    awk 'index($0,"! SKYFORGE-RUNTIME-MGMT BEGIN")==1{drop=1;next} index($0,"! SKYFORGE-RUNTIME-MGMT END")==1{drop=0;next} !drop' "${active}" >"${tmp}"
+    {
+      printf '%s\n' '! SKYFORGE-RUNTIME-MGMT BEGIN (operator-rendered; regenerated every pod start; do not edit)'
+      printf 'interface %s\n' "${SKYFORGE_MGMT_EOS_INTF}"
+      if [ -n "${mtu}" ]; then printf '   mtu %s\n' "${mtu}"; fi
+      printf '   ip address %s/%s\n' "${ip}" "${pfx}"
+      printf 'ip route 0.0.0.0/0 %s\n' "${SKYFORGE_MGMT_EOS_INTF}"
+      _oldifs="${IFS}"
+      IFS=','
+      for cidr in ${SKYFORGE_MGMT_RETURN_CIDRS:-}; do
+        cidr="$(printf '%s' "${cidr}" | tr -d '[:space:]')"
+        if [ -z "${cidr}" ]; then continue; fi
+        if [ "${cidr}" = "${addr_cidr}" ]; then continue; fi
+        printf 'ip route %s %s\n' "${cidr}" "${SKYFORGE_MGMT_EOS_INTF}"
+      done
+      IFS="${_oldifs}"
+      printf '%s\n' '! SKYFORGE-RUNTIME-MGMT END'
+    } >>"${tmp}"
+    mv "${tmp}" "${active}"
+    ;;
+  esac
+fi
+`
+
+func getStartupSeedInitContainer(device *ceoslabv1alpha1.CEosLabDevice, envVarsMap map[string]string) corev1.Container {
 	seedFile := startupPersistenceSeedDir + "/startup-config"
-	activeFile := startupPersistenceActiveDir + "/startup-config"
+	var env []corev1.EnvVar
+	if mgmtRuntimeConfigEnabled(device, envVarsMap) {
+		env = []corev1.EnvVar{
+			{Name: "SKYFORGE_MGMT_EOS_INTF", Value: mgmtRuntimeIntf(device)},
+			{Name: "SKYFORGE_MGMT_RETURN_CIDRS", Value: envVarsMap["SKYFORGE_MGMT_RETURN_CIDRS"]},
+			{
+				// The pod IP exists only at sandbox creation — after the
+				// operator rendered this pod — so it can only be observed
+				// from inside, via the downward API. Deliberately on this
+				// init container ONLY: the reconciler's env drift check
+				// compares the ceos container's literal env values, and a
+				// valueFrom var there would read back empty and force a
+				// delete/recreate loop.
+				Name: "SKYFORGE_POD_IP",
+				ValueFrom: &corev1.EnvVarSource{
+					FieldRef: &corev1.ObjectFieldSelector{FieldPath: "status.podIP"},
+				},
+			},
+		}
+	}
 	return corev1.Container{
 		Name:            "startup-config-seed",
 		Image:           DEFAULT_STARTUP_SEED_IMAGE,
 		ImagePullPolicy: "IfNotPresent",
 		Command:         []string{"/bin/sh", "-lc"},
-		Args: []string{fmt.Sprintf(
-			"set -eu; mkdir -p %q; if [ ! -f %q ]; then cp %q %q; fi",
-			startupPersistenceActiveDir,
-			activeFile,
-			seedFile,
-			activeFile,
-		)},
+		Args:            []string{startupSeedScript},
+		Env:             env,
 		VolumeMounts: []corev1.VolumeMount{
 			{
 				Name:      volumeName(startupConfigName(device.Name)),
diff --git a/controllers/ceoslabdevice_controller_unit_test.go b/controllers/ceoslabdevice_controller_unit_test.go
