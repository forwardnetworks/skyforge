+
+// The startup-config-seed init container is where the pod's runtime management
+// identity is materialized into the persisted startup-config: the pod IP exists
+// only at sandbox creation (after the operator renders the pod), so it must be
+// observed from inside via the downward API and bound into config before EOS
+// starts. EOS's config enforcement then INSTALLS it instead of stripping the
+// CNI state (config-as-truth).
+func TestGetPodSeedInitMaterializesMgmtRuntime(t *testing.T) {
+	device := &ceoslabv1alpha1.CEosLabDevice{
+		ObjectMeta: metav1.ObjectMeta{Name: "leaf1", Namespace: "demo"},
+		Spec: ceoslabv1alpha1.CEosLabDeviceSpec{
+			IntfMapping: map[string]string{
+				"eth0": "Management0",
+				"eth1": "Ethernet1",
+			},
+			EnvVar: map[string]string{
+				"SKYFORGE_MGMT_RETURN_CIDRS": "100.64.0.0/10,198.18.0.0/15",
+			},
+		},
+	}
+	secretsAndConfigMaps := map[string]client.Object{
+		startupConfigName(device.Name): &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{Name: startupConfigName(device.Name)},
+			Data:       map[string]string{"startup-config": "hostname leaf1\n"},
+		},
+	}
+	pod := &corev1.Pod{}
+	if err := getPod(pod, device, secretsAndConfigMaps, true); err != nil {
+		t.Fatalf("getPod() failed: %v", err)
+	}
+	if len(pod.Spec.InitContainers) != 2 {
+		t.Fatalf("getPod() initContainers len = %d, want 2", len(pod.Spec.InitContainers))
+	}
+	seed := pod.Spec.InitContainers[1]
+	env := map[string]corev1.EnvVar{}
+	for _, e := range seed.Env {
+		env[e.Name] = e
+	}
+	if got := env["SKYFORGE_MGMT_EOS_INTF"].Value; got != "Management0" {
+		t.Fatalf("SKYFORGE_MGMT_EOS_INTF = %q, want Management0 (%#v)", got, seed.Env)
+	}
+	if got := env["SKYFORGE_MGMT_RETURN_CIDRS"].Value; got != "100.64.0.0/10,198.18.0.0/15" {
+		t.Fatalf("SKYFORGE_MGMT_RETURN_CIDRS = %q (%#v)", got, seed.Env)
+	}
+	podIP, ok := env["SKYFORGE_POD_IP"]
+	if !ok || podIP.ValueFrom == nil || podIP.ValueFrom.FieldRef == nil || podIP.ValueFrom.FieldRef.FieldPath != "status.podIP" {
+		t.Fatalf("SKYFORGE_POD_IP must be a downward-API ref to status.podIP: %#v", seed.Env)
+	}
+	if len(seed.Args) != 1 {
+		t.Fatalf("seed args = %#v, want single script", seed.Args)
+	}
+	script := seed.Args[0]
+	for _, want := range []string{
+		// seed-once semantics preserved (write memory state survives restarts)
+		"if [ ! -f \"${active}\" ]; then cp \"${seed}\" \"${active}\"; fi",
+		// refresh-not-duplicate: previous runtime block stripped before append
+		"! SKYFORGE-RUNTIME-MGMT BEGIN",
+		"! SKYFORGE-RUNTIME-MGMT END",
+		// config-as-truth: address EOS will install; prefix derived from the
+		// return CIDR containing the pod IP (canary br1 2026-07-18: EOS
+		// rejects /32 with "% Prefix length must be less than 32")
+		"ip address %s/%s",
+		"ip4_to_int",
+		">> (32 - plen)",
+		// bounded fallback when no return CIDR contains the pod IP: /16, never /32
+		"pfx=16",
+		// the matched CIDR is CONNECTED once the address is up — no static twin
+		"if [ \"${cidr}\" = \"${addr_cidr}\" ]; then continue; fi",
+		// interface-form routes: no gateway to embed, EOS ARPs per destination
+		"ip route 0.0.0.0/0 %s",
+		// observed-MTU materialization (runtime truth, like the IP)
+		"/sys/class/net/eth0/mtu",
+	} {
+		if !strings.Contains(script, want) {
+			t.Fatalf("seed script missing %q: %s", want, script)
+		}
+	}
+	if strings.Contains(script, " via ") {
+		t.Fatalf("seed script must not render gateway-form routes: %s", script)
+	}
+	if strings.Contains(script, "ip address %s/32") {
+		t.Fatalf("seed script must never render a /32 management address (EOS rejects it): %s", script)
+	}
+}
+
+// Execute the seed script for real (POSIX sh; the pod runs it under busybox
+// ash) and check the CIDR-containment math, the connected-CIDR static
+// suppression, and refresh idempotency across a pod-IP change. The file paths
+// are overridable via env precisely so this test can drive the script without
+// /var/run or /sys (no MTU line is rendered when /sys/class/net/eth0/mtu is
+// unreadable, which is also the correct pod-side degradation).
+func TestStartupSeedScriptCIDRMath(t *testing.T) {
+	shPath, err := exec.LookPath("sh")
+	if err != nil {
+		t.Skip("no sh on PATH")
+	}
+	dir := t.TempDir()
+	seedFile := dir + "/seed-startup-config"
+	activeFile := dir + "/active/startup-config"
+	if err := os.WriteFile(seedFile, []byte("hostname leaf1\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	run := func(podIP string) string {
+		t.Helper()
+		cmd := exec.Command(shPath, "-c", startupSeedScript)
+		cmd.Env = append(os.Environ(),
+			"SKYFORGE_SEED_ACTIVE_FILE="+activeFile,
+			"SKYFORGE_SEED_SOURCE_FILE="+seedFile,
+			"SKYFORGE_MGMT_EOS_INTF=Management0",
+			"SKYFORGE_MGMT_RETURN_CIDRS=100.64.0.0/10,198.18.0.0/15",
+			"SKYFORGE_POD_IP="+podIP,
+		)
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			t.Fatalf("seed script failed for pod IP %s: %v\n%s", podIP, err, out)
+		}
+		data, err := os.ReadFile(activeFile)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return string(data)
+	}
+
+	// Pod IP inside 198.18.0.0/15: /15 address, no static twin for it, static
+	// for the OTHER return CIDR, interface-form default.
+	got := run("198.18.0.132")
+	for _, want := range []string{
+		"hostname leaf1\n",
+		"   ip address 198.18.0.132/15\n",
+		"ip route 0.0.0.0/0 Management0\n",
+		"ip route 100.64.0.0/10 Management0\n",
+	} {
+		if !strings.Contains(got, want) {
+			t.Fatalf("active config missing %q:\n%s", want, got)
+		}
+	}
+	if strings.Contains(got, "ip route 198.18.0.0/15") {
+		t.Fatalf("connected CIDR must not get a static twin:\n%s", got)
+	}
+
+	// Rescheduled pod, new IP in the FIRST CIDR: refresh replaces the block
+	// (no duplicates), /10 address, static twin flips to the other CIDR.
+	got = run("100.64.3.7")
+	if n := strings.Count(got, "! SKYFORGE-RUNTIME-MGMT BEGIN"); n != 1 {
+		t.Fatalf("runtime block count = %d, want exactly 1 after refresh:\n%s", n, got)
+	}
+	if !strings.Contains(got, "   ip address 100.64.3.7/10\n") {
+		t.Fatalf("refreshed address missing:\n%s", got)
+	}
+	if strings.Contains(got, "198.18.0.132") {
+		t.Fatalf("stale pod IP survived refresh:\n%s", got)
+	}
+	if !strings.Contains(got, "ip route 198.18.0.0/15 Management0\n") || strings.Contains(got, "ip route 100.64.0.0/10") {
+		t.Fatalf("static/connected split wrong after refresh:\n%s", got)
+	}
+
+	// No containing CIDR: bounded /16 fallback (never /32).
+	got = run("203.0.113.9")
+	if !strings.Contains(got, "   ip address 203.0.113.9/16\n") {
+		t.Fatalf("fallback /16 address missing:\n%s", got)
+	}
+	if !strings.Contains(got, "ip route 100.64.0.0/10 Management0\n") || !strings.Contains(got, "ip route 198.18.0.0/15 Management0\n") {
+		t.Fatalf("all return CIDRs must be statics when none is connected:\n%s", got)
+	}
+}
