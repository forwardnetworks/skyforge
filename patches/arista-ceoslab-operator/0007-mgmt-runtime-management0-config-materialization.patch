+# never survive that claim anyway: after EOS strips the CNI routes there is no
+# gateway left to discover.
 apply_permits() {
   old_ifs="${IFS}"
   IFS=","
@@ -1059,19 +1050,17 @@ apply_permits() {
   done
   IFS="${old_ifs}"
 }
-apply_routes
