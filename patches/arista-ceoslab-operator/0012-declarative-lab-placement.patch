+func TestGetPodSkyforgePlacement(t *testing.T) {
+	device := &ceoslabv1alpha1.CEosLabDevice{
+		Spec: ceoslabv1alpha1.CEosLabDeviceSpec{EnvVar: map[string]string{
+			"SKYFORGE_KNE_NODE_SELECTOR_JSON":  `{"skyforge.example.com/meshnet-fabric-mtu":"8950"}`,
+			"KNE_NODE_SELECTOR_HOSTNAME":       "worker-a",
+			"SKYFORGE_KNE_ALLOW_TAINTED_NODES": "true",
+			"SKYFORGE_KNE_PRIORITY_CLASS_NAME": "skyforge-lab",
+		}},
+	}
+	pod := &corev1.Pod{}
+	if err := getPod(pod, device, nil, false); err != nil {
+		t.Fatalf("getPod() failed: %v", err)
+	}
+	if pod.Spec.NodeSelector["kubernetes.io/hostname"] != "worker-a" || pod.Spec.NodeSelector["skyforge.example.com/meshnet-fabric-mtu"] != "8950" {
+		t.Fatalf("node selector = %#v", pod.Spec.NodeSelector)
+	}
+	if pod.Spec.PriorityClassName != "skyforge-lab" {
+		t.Fatalf("priority class = %q", pod.Spec.PriorityClassName)
+	}
+	if len(pod.Spec.Tolerations) != 1 || pod.Spec.Tolerations[0].Key != "skyforge.example.com/release-track" || pod.Spec.Tolerations[0].Operator != corev1.TolerationOpEqual {
+		t.Fatalf("tolerations = %#v", pod.Spec.Tolerations)
+	}
