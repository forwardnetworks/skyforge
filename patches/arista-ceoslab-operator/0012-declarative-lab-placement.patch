+func TestMaxConcurrentBringupClampsUnsafeOverride(t *testing.T) {
+	t.Setenv("SKYFORGE_MAX_CONCURRENT_BRINGUP", "500")
+	if got := maxConcurrentBringup(); got != maxSafeConcurrentBringup {
+		t.Fatalf("maxConcurrentBringup() = %d, want safety ceiling %d", got, maxSafeConcurrentBringup)
+	}
+}
+
+func TestBringupReservationsBoundParallelAdmission(t *testing.T) {
+	reservations := bringupAdmissionReservations{pods: map[types.NamespacedName]struct{}{}}
+	observation := bringupObservation{visiblePods: map[string]struct{}{}}
+	for index := 0; index < maxSafeConcurrentBringup; index++ {
+		key := types.NamespacedName{Namespace: "lab", Name: fmt.Sprintf("ceos-%d", index)}
+		reserved, effective := reservations.reserve(key, observation, maxSafeConcurrentBringup)
+		if !reserved || effective != index {
+			t.Fatalf("reservation %d = (%v, %d), want (true, %d)", index, reserved, effective, index)
+		}
+	}
+	reserved, effective := reservations.reserve(
+		types.NamespacedName{Namespace: "lab", Name: "one-too-many"},
+		observation,
+		maxSafeConcurrentBringup,
+	)
+	if reserved || effective != maxSafeConcurrentBringup {
+		t.Fatalf("overflow reservation = (%v, %d), want (false, %d)", reserved, effective, maxSafeConcurrentBringup)
+	}
+
+	// Once an admitted pod is visible, its reservation is replaced by the live
+	// observation instead of double-counted.
+	visible := bringupObservation{inflight: 1, visiblePods: map[string]struct{}{"ceos-0": {}}}
+	reserved, effective = reservations.reserve(
+		types.NamespacedName{Namespace: "lab", Name: "replacement"},
+		visible,
+		maxSafeConcurrentBringup,
+	)
+	if reserved || effective != maxSafeConcurrentBringup {
+		t.Fatalf("visible replacement = (%v, %d), want bounded effective count %d", reserved, effective, maxSafeConcurrentBringup)
+	}
+}
