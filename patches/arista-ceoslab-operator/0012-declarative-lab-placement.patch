 	mgmtIntfRe = regexp.MustCompile(`^Management\d+(?:/\d+)?$`)
 
-	// The throttle decision and pod creation form one admission transaction.
-	// Without this lock, concurrent reconciles can all observe inflight below
-	// the ceiling and collectively overshoot it before any pod is visible.
-	bringupAdmissionMu sync.Mutex
+	// API observations may lag a successful pod create. Reservations bridge that
+	// visibility window without serializing independent reconciles or pod creates.
+	bringupAdmissions = bringupAdmissionReservations{pods: map[types.NamespacedName]struct{}{}}
 )
 
+type bringupAdmissionReservations struct {
+	mu   sync.Mutex
+	pods map[types.NamespacedName]struct{}
+}
+
 // CEosLabDeviceReconciler reconciles a CEosLabDevice object
 type CEosLabDeviceReconciler struct {
 	client.Client
@@ -315,19 +320,11 @@ func (r *CEosLabDeviceReconciler) Reconcile(ctx context.Context, req ctrl.Reques
 	// EOS ssdinit, stalling Sysdb past the startup-probe budget (task #77).
 	startupPersistenceEnabled := startupConfigResourceVersion != nil
 
-	// Adaptive bringup pacing: serialize only the admission decision plus pod
-	// create, not pod startup. This makes the count-and-create transaction
-	// atomic while admitted pods still initialize concurrently.
-	bringupAdmissionMu.Lock()
-	admissionHeld := true
-	releaseBringupAdmission := func() {
-		if admissionHeld {
-			bringupAdmissionMu.Unlock()
-			admissionHeld = false
-		}
-	}
-	defer releaseBringupAdmission()
-	if throttled, reason, err := r.bringupThrottled(ctx, device); err != nil {
+	// Adaptive bringup pacing: observe the namespace concurrently, then reserve
+	// the short API-visibility gap atomically. The 48-pod Multus safety boundary
+	// remains enforced without holding a global mutex across API reads/creates.
+	reserved, throttled, reason, err := r.reserveBringup(ctx, device)
+	if err != nil {
 		return noRequeue, err
 	} else if throttled {
 		r.updateDeviceReconciling(ctx, device, reason)
@@ -352,10 +349,12 @@ func (r *CEosLabDeviceReconciler) Reconcile(ctx context.Context, req ctrl.Reques
 		}
 		err := r.getOrCreateObject(ctx, device, podName, createPodObject, devicePod)
 		if err != nil {
+			if reserved {
+				bringupAdmissions.release(types.NamespacedName{Name: device.Name, Namespace: device.Namespace})
+			}
 			return noRequeue, err
 		}
 	}
-	releaseBringupAdmission()
 
 	// Services
 
@@ -743,12 +742,55 @@ func (r *CEosLabDeviceReconciler) getOrCreateObject(ctx context.Context, device
 func maxConcurrentBringup() int {
 	if v := strings.TrimSpace(os.Getenv("SKYFORGE_MAX_CONCURRENT_BRINGUP")); v != "" {
 		if n, err := strconv.Atoi(v); err == nil && n > 0 {
-			return n
+			if n < maxSafeConcurrentBringup {
+				return n
+			}
+			return maxSafeConcurrentBringup
 		}
 	}
 	return defaultMaxConcurrentBringup
 }
 
+type bringupObservation struct {
+	podExists   bool
+	inflight    int
+	stuck       int
+	visiblePods map[string]struct{}
+}
+
+func (a *bringupAdmissionReservations) release(key types.NamespacedName) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	delete(a.pods, key)
+}
+
+func (a *bringupAdmissionReservations) reserve(key types.NamespacedName, observation bringupObservation, ceiling int) (bool, int) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	for reserved := range a.pods {
+		if reserved.Namespace == key.Namespace {
+			if _, visible := observation.visiblePods[reserved.Name]; visible {
+				delete(a.pods, reserved)
+			}
+		}
+	}
+	if observation.podExists {
+		return false, observation.inflight
+	}
+	reserved := 0
+	for candidate := range a.pods {
+		if candidate.Namespace == key.Namespace {
+			reserved++
+		}
+	}
+	effective := observation.inflight + reserved
+	if effective >= ceiling {
+		return false, effective
+	}
+	a.pods[key] = struct{}{}
+	return true, effective
+}
+
 // maxConcurrentReconciles keeps the upstream CPU-derived worker count but
 // floors it at the configured adaptive bringup ceiling. By default, a
 // controller scheduled on a small node can therefore keep all 16 safe
@@ -807,7 +849,8 @@ func ownedByCEosLabDevice(p *corev1.Pod) bool {
 // and boot underway), so the gate is readiness-driven, not timer-driven — there is no
 // stale timeout because there is no host-pod miscount left to deadlock on. Returns a
 // human-readable reason when throttling.
-func (r *CEosLabDeviceReconciler) bringupThrottled(ctx context.Context, device *ceoslabv1alpha1.CEosLabDevice) (bool, string, error) {
+func (r *CEosLabDeviceReconciler) observeBringup(ctx context.Context, device *ceoslabv1alpha1.CEosLabDevice) (bringupObservation, error) {
+	observation := bringupObservation{visiblePods: map[string]struct{}{}}
 	reader := r.APIReader
 	if reader == nil {
 		// Unit tests and embedders that do not provide an uncached reader keep
@@ -818,36 +861,67 @@ func (r *CEosLabDeviceReconciler) bringupThrottled(ctx context.Context, device *
 	existing := &corev1.Pod{}
 	err := reader.Get(ctx, types.NamespacedName{Name: device.Name, Namespace: device.Namespace}, existing)
 	if err == nil {
-		return false, "", nil // pod already exists; never throttle
+		observation.podExists = true
 	}
-	if !errors.IsNotFound(err) {
-		return false, "", err
+	if err != nil && !errors.IsNotFound(err) {
+		return observation, err
 	}
 	podList := &corev1.PodList{}
 	if err := reader.List(ctx, podList, client.InNamespace(device.Namespace)); err != nil {
-		return false, "", err
+		return observation, err
 	}
-	inflight, stuckCreating := 0, 0
 	for i := range podList.Items {
 		p := &podList.Items[i]
 		if !ownedByCEosLabDevice(p) {
 			continue // only pace the cEOS pods we own; never count the host pods gated on us
 		}
+		observation.visiblePods[p.Name] = struct{}{}
 		if p.Status.Phase != corev1.PodPending {
 			continue // a cEOS pod that has left Pending has cleared the sandbox/init window
 		}
-		inflight++
+		observation.inflight++
 		if time.Since(p.CreationTimestamp.Time) > bringupSandboxDeadline && !podSandboxStarted(p) {
-			stuckCreating++ // still in the CNI/sandbox window past the deadline => backpressure
+			observation.stuck++ // still in the CNI/sandbox window past the deadline => backpressure
 		}
 	}
-	if stuckCreating > 0 {
-		return true, fmt.Sprintf("node is backing up on sandbox creation (%d cEOS pod(s) stuck in ContainerCreating in namespace %s); deferring pod creation", stuckCreating, device.Namespace), nil
+	return observation, nil
+}
+
+func bringupThrottleReason(observation bringupObservation, effectiveInflight int, namespace string) (bool, string) {
+	if observation.podExists {
+		return false, ""
 	}
-	if inflight >= maxConcurrentBringup() {
-		return true, fmt.Sprintf("bringup ceiling reached (%d cEOS pods still initializing in namespace %s); deferring pod creation", inflight, device.Namespace), nil
+	if observation.stuck > 0 {
+		return true, fmt.Sprintf("node is backing up on sandbox creation (%d cEOS pod(s) stuck in ContainerCreating in namespace %s); deferring pod creation", observation.stuck, namespace)
 	}
-	return false, "", nil
+	if effectiveInflight >= maxConcurrentBringup() {
+		return true, fmt.Sprintf("bringup ceiling reached (%d cEOS pods still initializing or admission-reserved in namespace %s); deferring pod creation", effectiveInflight, namespace)
+	}
+	return false, ""
+}
+
+func (r *CEosLabDeviceReconciler) bringupThrottled(ctx context.Context, device *ceoslabv1alpha1.CEosLabDevice) (bool, string, error) {
+	observation, err := r.observeBringup(ctx, device)
+	if err != nil {
+		return false, "", err
+	}
+	throttled, reason := bringupThrottleReason(observation, observation.inflight, device.Namespace)
+	return throttled, reason, nil
+}
+
+func (r *CEosLabDeviceReconciler) reserveBringup(ctx context.Context, device *ceoslabv1alpha1.CEosLabDevice) (bool, bool, string, error) {
+	observation, err := r.observeBringup(ctx, device)
+	if err != nil {
+		return false, false, "", err
+	}
+	if observation.stuck > 0 || observation.podExists {
+		throttled, reason := bringupThrottleReason(observation, observation.inflight, device.Namespace)
+		return false, throttled, reason, nil
+	}
+	key := types.NamespacedName{Name: device.Name, Namespace: device.Namespace}
+	reserved, effective := bringupAdmissions.reserve(key, observation, maxConcurrentBringup())
+	throttled, reason := bringupThrottleReason(observation, effective, device.Namespace)
+	return reserved, throttled, reason, nil
 }
 
