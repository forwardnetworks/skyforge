+func getSkyforgePlacement(env map[string]string) (map[string]string, []corev1.Toleration, string, error) {
+	selector := map[string]string{}
+	if raw := strings.TrimSpace(env["SKYFORGE_KNE_NODE_SELECTOR_JSON"]); raw != "" {
+		if err := json.Unmarshal([]byte(raw), &selector); err != nil {
+			return nil, nil, "", fmt.Errorf("invalid SKYFORGE_KNE_NODE_SELECTOR_JSON: %w", err)
+		}
+	}
+	if hostname := strings.TrimSpace(env["KNE_NODE_SELECTOR_HOSTNAME"]); hostname != "" {
+		selector["kubernetes.io/hostname"] = hostname
+	}
+	var tolerations []corev1.Toleration
+	allowTainted, _ := strconv.ParseBool(strings.TrimSpace(env["SKYFORGE_KNE_ALLOW_TAINTED_NODES"]))
+	if allowTainted {
+		key := strings.TrimSpace(env["SKYFORGE_KNE_TAINT_KEY"])
+		if key == "" {
+			key = "skyforge.example.com/release-track"
+		}
+		value := strings.TrimSpace(env["SKYFORGE_KNE_TAINT_VALUE"])
+		if value == "" {
+			value = "stable-release"
+		}
+		effect := corev1.TaintEffect(strings.TrimSpace(env["SKYFORGE_KNE_TAINT_EFFECT"]))
+		if effect == "" {
+			effect = corev1.TaintEffectNoSchedule
+		}
+		tolerations = []corev1.Toleration{{Key: key, Operator: corev1.TolerationOpEqual, Value: value, Effect: effect}}
+	}
+	return selector, tolerations, strings.TrimSpace(env["SKYFORGE_KNE_PRIORITY_CLASS_NAME"]), nil
+}
