 	device := &ceoslabv1alpha1.CEosLabDevice{
 		ObjectMeta: metav1.ObjectMeta{
@@ -760,6 +785,45 @@ func TestMaxConcurrentReconcilesFeedsBringupCeiling(t *testing.T) {
