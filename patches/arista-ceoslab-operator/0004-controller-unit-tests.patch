+func TestGetPodAddsManagementReturnRouteLifecycle(t *testing.T) {
+	device := &ceoslabv1alpha1.CEosLabDevice{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "leaf1",
+			Namespace: "demo",
+		},
+		Spec: ceoslabv1alpha1.CEosLabDeviceSpec{
+			EnvVar: map[string]string{
+				"SKYFORGE_MGMT_RETURN_CIDRS": "100.64.0.0/10,198.18.0.0/15",
+				"SKYFORGE_MGMT_RETURN_MTU":   "1370",
+			},
+		},
+	}
+	pod := &corev1.Pod{}
+	if err := getPod(pod, device, nil, false); err != nil {
+		t.Fatalf("getPod() failed: %v", err)
+	}
+	lifecycle := pod.Spec.Containers[0].Lifecycle
+	if lifecycle == nil || lifecycle.PostStart == nil || lifecycle.PostStart.Exec == nil {
+		t.Fatalf("getPod() did not add management return-route lifecycle: %#v", pod.Spec.Containers[0])
+	}
+	command := lifecycle.PostStart.Exec.Command
+	if len(command) != 3 || command[0] != "/bin/sh" || command[1] != "-ceu" {
+		t.Fatalf("unexpected lifecycle command: %#v", command)
+	}
+	script := command[2]
+	for _, want := range []string{
+		"SKYFORGE_MGMT_RETURN_CIDRS",
+		"ip -4 route show dev eth0 scope link",
+		"ip route replace",
+		// The EOS control-plane firewall drops inbound management traffic
+		// unless each source CIDR is explicitly permitted (see getLifecycleAPI).
+		"apply_permits",
+		"iptables -D INPUT -s",
+		"iptables -I INPUT 1 -s",
+		"SKYFORGE_MGMT_RETURN_MTU",
+		"SKYFORGE_MGMT_RETURN_ROUTE_RETRIES",
+		"/tmp/skyforge-mgmt-return-routes.log",
+	} {
+		if !strings.Contains(script, want) {
+			t.Fatalf("lifecycle script missing %q: %s", want, script)
+		}
+	}
+}
