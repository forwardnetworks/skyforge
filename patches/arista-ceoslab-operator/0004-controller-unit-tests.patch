+func TestGetPodStartupPersistence(t *testing.T) {
+	device := &ceoslabv1alpha1.CEosLabDevice{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:      "leaf1",
+			Namespace: "demo",
+		},
+		Spec: ceoslabv1alpha1.CEosLabDeviceSpec{
+			NumInterfaces: 2,
+		},
+	}
+	secretsAndConfigMaps := map[string]client.Object{
+		startupConfigName(device.Name): &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{Name: startupConfigName(device.Name)},
+			Data:       map[string]string{"startup-config": "hostname leaf1\n"},
+		},
+		"configmap-rceos-leaf1": &corev1.ConfigMap{
+			ObjectMeta: metav1.ObjectMeta{Name: "configmap-rceos-leaf1"},
+			BinaryData: map[string][]byte{"rc.eos": []byte("#!/bin/bash\n")},
+		},
+	}
+	pod := &corev1.Pod{}
+	if err := getPod(pod, device, secretsAndConfigMaps, true); err != nil {
+		t.Fatalf("getPod() failed: %v", err)
+	}
+	if len(pod.Spec.InitContainers) != 2 {
+		t.Fatalf("getPod() initContainers len = %d, want 2", len(pod.Spec.InitContainers))
+	}
+	if pod.Spec.InitContainers[1].Name != "startup-config-seed" {
+		t.Fatalf("getPod() second init container = %q, want startup-config-seed", pod.Spec.InitContainers[1].Name)
+	}
+	foundFlashMount := false
+	foundRCMount := false
+	foundDirectStartupMount := false
+	for _, mount := range pod.Spec.Containers[0].VolumeMounts {
+		if mount.Name == startupPersistenceVolumeName && mount.MountPath == "/mnt/flash" {
+			foundFlashMount = true
+		}
+		if mount.MountPath == "/mnt/flash/rc.eos" {
+			foundRCMount = true
+		}
+		if mount.Name == volumeName(startupConfigName(device.Name)) && mount.MountPath == "/mnt/flash/startup-config" {
+			foundDirectStartupMount = true
+		}
+	}
+	if !foundFlashMount {
+		t.Fatalf("getPod() did not mount persistent flash volume: %#v", pod.Spec.Containers[0].VolumeMounts)
+	}
+	if !foundRCMount {
+		t.Fatalf("getPod() dropped rc.eos mount: %#v", pod.Spec.Containers[0].VolumeMounts)
+	}
+	if foundDirectStartupMount {
+		t.Fatalf("getPod() still mounted startup-config directly into the main container")
+	}
+}
