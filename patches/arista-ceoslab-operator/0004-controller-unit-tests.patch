+func TestBringupThrottledAdaptive(t *testing.T) {
+	scheme := runtime.NewScheme()
+	if err := corev1.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	if err := ceoslabv1alpha1.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	device := &ceoslabv1alpha1.CEosLabDevice{ObjectMeta: metav1.ObjectMeta{Name: "newdev", Namespace: "demo"}}
+	ctx := context.Background()
+
+	// pendingPod models a cEOS pod the operator PACES: it carries the CEosLabDevice owner
+	// ref SetControllerReference stamps, so bringupThrottled counts it.
+	pendingPod := func(name string, ageSecs int, sandboxStarted bool) *corev1.Pod {
+		p := &corev1.Pod{
+			ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "demo",
+				OwnerReferences:   []metav1.OwnerReference{{Kind: ceosLabDeviceKind, Name: name}},
+				CreationTimestamp: metav1.NewTime(time.Now().Add(-time.Duration(ageSecs) * time.Second))},
+			Status: corev1.PodStatus{Phase: corev1.PodPending},
+		}
+		if sandboxStarted {
+			p.Status.InitContainerStatuses = []corev1.ContainerStatus{
+				{Name: "init", State: corev1.ContainerState{Running: &corev1.ContainerStateRunning{}}}}
+		}
+		return p
+	}
+	// hostPod models a meshnet-gated linux host pod (brNhN / app): NO CEosLabDevice owner
+	// ref. It is Pending (Init:0/N) because its cEOS peer does not exist yet. The throttle
+	// must NOT count these — counting them is the deadlock this fix removes (task#79).
+	hostPod := func(name string, ageSecs int) *corev1.Pod {
+		return &corev1.Pod{
+			ObjectMeta: metav1.ObjectMeta{Name: name, Namespace: "demo",
+				CreationTimestamp: metav1.NewTime(time.Now().Add(-time.Duration(ageSecs) * time.Second))},
+			Status: corev1.PodStatus{Phase: corev1.PodPending},
+		}
+	}
+	mk := func(objs ...client.Object) *CEosLabDeviceReconciler {
+		return &CEosLabDeviceReconciler{
+			Client: fake.NewClientBuilder().WithScheme(scheme).WithObjects(objs...).Build(),
+			Scheme: scheme,
+		}
+	}
+	assert := func(t *testing.T, r *CEosLabDeviceReconciler, wantThrottle bool, wantReason string) {
+		t.Helper()
+		th, reason, err := r.bringupThrottled(ctx, device)
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		if th != wantThrottle {
+			t.Fatalf("throttled=%v, want %v (reason=%q)", th, wantThrottle, reason)
+		}
+		if wantReason != "" && !strings.Contains(reason, wantReason) {
+			t.Fatalf("reason %q does not contain %q", reason, wantReason)
+		}
+	}
+
+	// A couple of young Pending cEOS pods: high ceiling, no backpressure -> allow.
+	assert(t, mk(pendingPod("a", 5, false), pendingPod("b", 5, false)), false, "")
+	// A cEOS pod stuck in sandbox creation (old, no container started) -> back off.
+	assert(t, mk(pendingPod("a", 5, false), pendingPod("stuck", 60, false)), true, "backing up")
+	// Old, but its sandbox has started (init running) -> not backpressure, allow.
+	assert(t, mk(pendingPod("a", 5, false), pendingPod("initrun", 60, true)), false, "")
+	// REGRESSION (task#79): meshnet-gated host pods are Pending because their cEOS peers
+	// don't exist yet. They must NOT count — a swarm of them, even old ones with no sandbox,
+	// must never throttle cEOS creation (that miscount was the deadlock).
+	hosts := make([]client.Object, 0, defaultMaxConcurrentBringup*3)
+	for i := 0; i < defaultMaxConcurrentBringup*3; i++ {
+		hosts = append(hosts, hostPod(fmt.Sprintf("br%dh1", i), 90))
+	}
+	assert(t, mk(hosts...), false, "")
+	// The device's own pod already exists -> never throttle, even amid backpressure.
+	devPod := &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Name: device.Name, Namespace: device.Namespace},
+		Status: corev1.PodStatus{Phase: corev1.PodPending}}
+	assert(t, mk(devPod, pendingPod("stuck", 60, false)), false, "")
+	// Ceiling backstop: defaultMaxConcurrentBringup young cEOS pods -> throttle on the count.
+	// Interleaved host pods must not shift the count.
+	many := make([]client.Object, 0, defaultMaxConcurrentBringup*2)
+	for i := 0; i < defaultMaxConcurrentBringup; i++ {
+		many = append(many, pendingPod(fmt.Sprintf("y%d", i), 5, false), hostPod(fmt.Sprintf("y%dh1", i), 5))
+	}
+	assert(t, mk(many...), true, "ceiling")
+}
