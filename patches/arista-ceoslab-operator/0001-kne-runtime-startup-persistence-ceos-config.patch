+func (r *CEosLabDeviceReconciler) ensureCEosConfigMap(ctx context.Context, device *ceoslabv1alpha1.CEosLabDevice, name string, data string, configMap *corev1.ConfigMap) error {
+	log := kLog.FromContext(ctx)
+	desired := map[string]string{"ceos-config": data}
+	err := r.Get(ctx, types.NamespacedName{Name: name, Namespace: device.Namespace}, configMap)
+	if err != nil && errors.IsNotFound(err) {
+		log.Info(fmt.Sprintf("Creating %s for CEosLabDevice %s", name, device.Name))
+		configMap.ObjectMeta = metav1.ObjectMeta{Name: name, Namespace: device.Namespace}
+		configMap.Data = desired
+		ctrl.SetControllerReference(device, configMap, r.Scheme)
+		if err = r.Create(ctx, configMap); err != nil {
+			errMsg := fmt.Sprintf("Failed to create %s for CEosLabDevice %s", name, device.Name)
+			log.Error(err, errMsg)
+			r.updateDeviceFail(ctx, device, errMsg)
+			return err
+		}
+		return nil
+	} else if err != nil {
+		errMsg := fmt.Sprintf("Failed to get %s for CEosLabDevice %s", name, device.Name)
+		log.Error(err, errMsg)
+		r.updateDeviceFail(ctx, device, errMsg)
+		return err
+	}
+	if !reflect.DeepEqual(configMap.Data, desired) {
+		configMap.Data = desired
+		if err = r.Update(ctx, configMap); err != nil {
+			errMsg := fmt.Sprintf("Failed to update %s for CEosLabDevice %s", name, device.Name)
+			log.Error(err, errMsg)
+			r.updateDeviceFail(ctx, device, errMsg)
+			return err
+		}
+	}
+	return nil
+}
