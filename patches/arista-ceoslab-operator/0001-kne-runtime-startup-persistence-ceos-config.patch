+func getCEosConfigData(env map[string]string) string {
+	lines := []string{}
+	if serial := strings.TrimSpace(env["SERIALNUMBER"]); serial != "" {
+		lines = append(lines, "SERIALNUMBER="+serial)
+	}
+	if mac := strings.TrimSpace(env["SYSTEMMACADDR"]); mac != "" {
+		lines = append(lines, "SYSTEMMACADDR="+mac)
+	}
+	if len(lines) == 0 {
+		return ""
+	}
+	return strings.Join(lines, "\n") + "\n"
+}
